GOOGLE_API_KEY=your_google_api_key_here
# Toggle Google backend routing:
# - ambient: follow config/models.yaml as-is
# - gemini_direct: force Gemini Developer API
# - vertex_ai: force Vertex AI
GEULDOBI_PROVIDER_MODE=ambient

# Vertex AI (used when GEULDOBI_PROVIDER_MODE=vertex_ai, or ambient + models.yaml points to vertex)
VERTEX_API_KEY=your_vertex_api_key_here
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=us-central1

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/workspace/webhook

# ClickUp queue visualization sync
# Recommended location for ClickUp-only secrets:
# - secrets/clickup.env
# Or set CLICKUP_ENV_FILE to another path.
# Personal token example: pk_xxx
CLICKUP_API_TOKEN=pk_your_clickup_personal_token_here
CLICKUP_LIST_ID=your_clickup_list_id_here
CLICKUP_ENV_FILE=secrets/clickup.env
# Optional JSON override if your List uses different status names.
# Example:
# CLICKUP_STATUS_MAP_JSON={"Ready":"To Do","Realizing":"In Progress","Proof Pending":"Review","Blocked":"Blocked","Parked":"Backlog","Closed":"Done"}
CLICKUP_STATUS_MAP_JSON=

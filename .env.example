GOOGLE_API_KEY=your_google_api_key_here
# Toggle Google backend routing:
# - ambient: follow config/models.yaml as-is
# - gemini_direct: force Gemini Developer API
# - vertex_ai: force Vertex AI
GEULDOBI_PROVIDER_MODE=ambient

# Vertex AI (used when GEULDOBI_PROVIDER_MODE=vertex_ai, or ambient + models.yaml points to vertex)
VERTEX_API_KEY=your_vertex_api_key_here
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=us-central1

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/workspace/webhook

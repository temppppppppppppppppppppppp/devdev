{
  "contract_id": "control-plane-approval-provenance-ssot-v1",
  "status": "active",
  "primary_sources": [
    "modules/api/bridge_server.py",
    "modules/api/risk_approval.py",
    "modules/api/process_runner.py",
    "modules/core/metrics_collector.py",
    "geuldobi-desktop/src/main.js"
  ],
  "control_plane_role": {
    "desktop_backend_relationship": "desktop and backend form a CLI menu protocol wrapper, not an independent domain workflow",
    "desktop_forward_surface": "bridge:run -> POST /run",
    "backend_accept_surface": "POST /run -> RiskApprovalGate -> ProcessRunner.start"
  },
  "approval_source_of_truth": {
    "owner": "RiskApprovalGate",
    "record_type": "ApprovalRecord",
    "live_log_path": "logs/risk-approval-log.jsonl",
    "authoritative_key": "approval_id",
    "notes": [
      "approval_id is authoritative only for the risk gate decision phase",
      "risk approval audit log is distinct from desktop transport and subprocess runtime logs"
    ]
  },
  "success_provenance_bridge": {
    "owner": "bridge_server._write_control_plane_provenance",
    "log_path": "logs/control-plane-provenance.jsonl",
    "join_keys": [
      "approval_id",
      "run_id",
      "key"
    ],
    "success_only": true,
    "notes": [
      "successful /run requests bridge approval_id to run_id",
      "approval failures remain in risk-approval-log.jsonl and do not create run provenance rows"
    ]
  },
  "runtime_execution_keys": {
    "backend_transport_key": "run_id",
    "desktop_ui_key": "run_id",
    "engine_env_key": "GEULDOBI_RUN_ID",
    "metrics_session_key": "session_id",
    "session_id_binding_rule": "MetricsCollector.session_id uses GEULDOBI_RUN_ID when present"
  },
  "key_flow": [
    {
      "phase": "desktop_request",
      "surface": "geuldobi-desktop/src/main.js ipcMain.handle('bridge:run')",
      "keys": [
        "approval_id",
        "key",
        "sub_key"
      ]
    },
    {
      "phase": "approval_gate",
      "surface": "modules/api/risk_approval.py RiskApprovalGate.validate",
      "keys": [
        "approval_id",
        "key"
      ]
    },
    {
      "phase": "backend_run_accept",
      "surface": "modules/api/bridge_server.py POST /run",
      "keys": [
        "run_id",
        "approval_id",
        "key"
      ]
    },
    {
      "phase": "subprocess_env",
      "surface": "modules/api/process_runner.py ProcessRunner._build_env",
      "keys": [
        "GEULDOBI_RUN_ID"
      ]
    },
    {
      "phase": "engine_metrics_and_db",
      "surface": "modules/core/metrics_collector.py + resolve_logging_session_id(...) consumers",
      "keys": [
        "session_id"
      ],
      "binding": "session_id == run_id when GEULDOBI_RUN_ID exists"
    }
  ],
  "failure_boundary": {
    "approval_failure_namespace": [
      "RISK_APPROVAL_REQUIRED",
      "RISK_APPROVAL_EXPIRED",
      "RISK_APPROVAL_DUAL_CONTROL_REQUIRED"
    ],
    "desktop_transport_namespace": [
      "HTTP_<status_code>",
      "NETWORK_ERROR"
    ],
    "separation_rule": "approval failures use backend ErrorEnvelope.code; desktop transport failures use desktop bridge transport namespace"
  }
}

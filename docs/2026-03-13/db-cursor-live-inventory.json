    "new_or_modified_code_rule": "do_not_add_new_shared_cursor_usage"
  },
  "source_scan_rules": {
    "shared_cursor_token": "self.cursor.execute|self.cursor.executemany|self.cursor.fetchone|self.cursor.fetchall",

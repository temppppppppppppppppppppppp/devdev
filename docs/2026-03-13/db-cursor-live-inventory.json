{
  "contract_id": "db-cursor-live-inventory-v1",
  "status": "active",
  "primary_source": "modules/core/db_manager.py",
  "policy": {
    "lock_model": "threading.RLock",
    "preferred_pattern": "with self._lock: cur = self.conn.cursor()",
    "legacy_pattern": "self.cursor.execute(...)",

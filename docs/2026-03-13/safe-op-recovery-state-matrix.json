{
  "contract_id": "safe-op-recovery-state-matrix-v1",
  "status": "active",
  "primary_source": "modules/core/services/project_service.py",
  "destructive_result_model": {
    "type": "DestructiveOpResult",
    "fields": [
      "operation",
      "target_ep",
      "db_committed",
      "partial_failures"
    ],
    "derived_state_vector": [
      "status",
      "runtime_restore_ok",
      "cache_invalidation_required"
    ],
    "status_enum": [
      "aborted",
      "partial_restore_failed",
      "success"
    ],
    "status_rules": {
      "aborted": "db_committed=false",
      "partial_restore_failed": "db_committed=true and partial_failures not empty",
      "success": "db_committed=true and partial_failures empty"
    }
  },
  "runtime_restore_pipeline": {
    "owner": "ProjectService._restore_runtime_state",
    "durable_vs_runtime_split": {
      "durable_truth": "DB commit and anchor/table mutation",
      "runtime_truth": "project reload + tracker/service rollback + cache invalidation",
      "operator_surface": "ProjectService._log_destructive_outcome"
    },
    "restore_steps": [
      "project.load_from_db",
      "state_tracker.invalidate",
      "world_state.rollback_to",
      "fact_ledger.rollback_to",
      "emotion_history.rollback_to",
      "state_delta_tracker.rollback_to",
      "preset_registry.restore",
      "base_agent.context_cache_clear"
    ],
    "fallback_trim_steps": [
      "emotion_history.rollback_to -> emotion_history.trim_history",
      "state_delta_tracker.rollback_to -> state_delta_tracker.trim_history"
    ],
    "post_restore_invariant_steps": [
      "emotion_history.invariant",
      "state_delta_tracker.invariant"
    ]
  },
  "safe_ops": {
    "reset_stage_2": {
      "service_method": "ProjectService.reset_stage_2",
      "wrapper_method": "SovereignApp._reset_stage_2",
      "target_ep_policy": "fixed_to_1",
      "durable_commit_gate": "project.db.reset_after(1, commit=false) + stage2 metadata/anchor deletion + safe_commit",
      "bool_return_semantics": "True iff db_committed",
      "wrapper_post_success": {
        "null_app_caches": [
          "state_tracker",
          "_cumulative_state_cache",
          "_cumulative_state_cache_key",
          "_narrative_summaries_cache"
        ],
        "invalidate_prompt_builder": true,
        "invalidate_agent_caches": [
          "state_extractor.invalidate_cache",
          "writer.invalidate_manuscript_cache",
          "director.invalidate_caches"
        ],
        "foreshadow_sync": "clear_then_save_to_db"
      }
    },
    "rewind_stage_2": {
      "service_method": "ProjectService.rewind_stage_2",
      "wrapper_method": "SovereignApp._rewind_stage_2",
      "target_ep_policy": "derived_from_removed_arc_start_episode",
      "durable_commit_gate": "project.db.reset_after(target_ep, commit=false) + stage2 metadata/anchor trim + arcs save_anchor + safe_commit",
      "bool_return_semantics": "True iff db_committed",
      "wrapper_post_success": {
        "null_app_caches": [
          "state_tracker",
          "_cumulative_state_cache",
          "_cumulative_state_cache_key",
          "_narrative_summaries_cache"
        ],
        "invalidate_prompt_builder": true,
        "invalidate_agent_caches": [
          "state_extractor.invalidate_cache",
          "writer.invalidate_manuscript_cache",
          "director.invalidate_caches"
        ],
        "foreshadow_sync": "load_from_db_or_clear_fallback"
      }
    },
    "rollback_episode": {
      "service_method": "ProjectService.rollback_episode",
      "wrapper_method": "SovereignApp._rollback_episode",
      "target_ep_policy": "operator_selected_episode",
      "durable_commit_gate": "project.db.reset_after(target_ep, commit=false) + narrative summary trim + seeds update + optional bible save_anchor + safe_commit",
      "bool_return_semantics": "True iff db_committed",
      "wrapper_post_success": {
        "null_app_caches": [
          "state_tracker",
          "_cumulative_state_cache",
          "_cumulative_state_cache_key",
          "_narrative_summaries_cache"
        ],
        "invalidate_prompt_builder": true,
        "invalidate_agent_caches": [
          "writer.invalidate_manuscript_cache",
          "director.invalidate_caches"
        ],
        "foreshadow_sync": "load_from_db_or_clear_fallback"
      }
    },
    "wipe_production_data": {
      "service_method": "ProjectService.wipe_production_data",
      "wrapper_method": "SovereignApp._wipe_production_data",
      "target_ep_policy": "fixed_to_1",
      "durable_commit_gate": "project.db.reset_after(1, commit=false) + narrative summary deletion + seeds reset + safe_commit",
      "bool_return_semantics": "True iff db_committed",
      "wrapper_post_success": {
        "null_app_caches": [
          "state_tracker",
          "_cumulative_state_cache",
          "_cumulative_state_cache_key",
          "_narrative_summaries_cache"
        ],
        "invalidate_prompt_builder": true,
        "invalidate_agent_caches": [
          "state_extractor.invalidate_cache",
          "writer.invalidate_manuscript_cache",
          "director.invalidate_caches"
        ],
        "foreshadow_sync": "clear_then_save_to_db"
      }
    }
  },
  "operator_surface": {
    "success_path": "result.status == success -> success message only",
    "partial_path": "result.status == partial_restore_failed -> [Partial] operation committed + per-step reason logs",
    "abort_path": "db_committed=false -> bool False and operation-specific commit/exception log"
  },
  "project_switch_semantics": {
    "owner": "SovereignApp._reload_project_environment",
    "classification": "project_switch_not_safe_op",
    "trigger": "project-local .env exists and GOOGLE_API_KEY resolves",
    "effects": [
      "StudioSystem api_client rebind",
      "BaseAgent._keys_initialized = false",
      "BaseAgent._current_key_idx = 0",
      "BaseAgent._context_caches.clear()",
      "BaseAgent._init_api_keys()"
    ],
    "uses_destructive_result_model": false,
    "notes": [
      "No DestructiveOpResult is recorded during project switch.",
      "Project switch cache invalidation is environment-rebind semantics, not rollback/restore semantics."
    ]
  }
}

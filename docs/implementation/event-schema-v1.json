{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Geuldobi WS Event v1",
  "type": "object",
  "required": ["event_version", "seq", "run_id", "type", "ts", "payload"],
  "properties": {
    "event_version": {
      "type": "string",
      "const": "v1"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "run_id": {
      "type": "string"
    },
      "type": {
        "type": "string",
        "enum": [
          "run_started",
          "stdout",
          "prompt_request",
          "prompt_resolved",
          "prompt_timeout",
        "run_completed",
        "run_failed",
        "run_stopped"
      ]
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "prompt_request"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "prompt_id",
              "step_id",
              "input_type",
              "default",
              "timeout_sec"
            ],
            "properties": {
              "prompt_id": {
                "type": "string"
              },
              "step_id": {
                "type": "string"
              },
              "input_type": {
                "type": "string",
                "enum": ["enum", "int", "string", "bool", "enter", "multiline"]
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["key", "label"],
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    }
                  }
                }
              },
              "default": {},
              "prompt_text": {
                "type": "string"
              },
              "timeout_sec": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run_started"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["key"],
            "properties": {
              "key": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "stdout"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["text"],
            "properties": {
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "prompt_resolved"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["prompt_id", "value", "source"],
            "properties": {
              "prompt_id": {
                "type": "string"
              },
              "value": {},
              "source": {
                "type": "string",
                "enum": ["user", "default"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": ["run_completed", "run_failed"]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["returncode"],
            "properties": {
              "returncode": {
                "type": "integer"
              },
              "key": {
                "type": ["string", "null"]
              },
              "sub_key": {
                "type": ["string", "null"]
              },
              "mode": {
                "type": ["string", "null"]
              },
              "started_at": {
                "type": ["string", "null"]
              },
              "duration_ms": {
                "type": ["integer", "null"],
                "minimum": 0
              },
              "last_prompt_step": {
                "type": ["string", "null"]
              },
              "stdout_tail": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "stderr_tail": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "stderr_authoritative": {
                "type": "boolean"
              },
              "stderr_decode_policy": {
                "type": ["string", "null"]
              },
              "failure_phase": {
                "type": ["string", "null"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run_stopped"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "prompt_timeout"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["prompt_id", "applied_default"],
            "properties": {
              "prompt_id": {
                "type": "string"
              },
              "applied_default": {}
            }
          }
        }
      }
    }
  ]
}

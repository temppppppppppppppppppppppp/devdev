{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 7620,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "두 번째 주제는 아주 재밌는 얘기예요"
    } ]
  }, {
    "tStartMs": 10210,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "제가 아주 좋아하는 얘기인데"
    } ]
  }, {
    "tStartMs": 11710,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "새롭게 뜨는 고기가 있다"
    } ]
  }, {
    "tStartMs": 13950,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "미트, 미트"
    } ]
  }, {
    "tStartMs": 15130,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "물고기 말고"
    } ]
  }, {
    "tStartMs": 15740,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "피쉬 말고 미트입니다"
    } ]
  }, {
    "tStartMs": 17560,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "어떤 고기가 과연 새롭게 뜰까요?"
    } ]
  }, {
    "tStartMs": 20360,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "내가 최근에 이 고기를 먹어봤다"
    } ]
  }, {
    "tStartMs": 21900,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "여러분은 트렌드에 굉장히 빠른 분이에요"
    } ]
  }, {
    "tStartMs": 24050,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "얼리 어덥터"
    } ]
  }, {
    "tStartMs": 25000,
    "dDurationMs": 350,
    "segs": [ {
      "utf8": "그건 뭐냐?"
    } ]
  }, {
    "tStartMs": 25350,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "2월 24일 농림축산부는"
    } ]
  }, {
    "tStartMs": 27100,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "2월 24일 농림축산부는"
    } ]
  }, {
    "tStartMs": 29280,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "염소 산업화 로드맵을 발표했습니다"
    } ]
  }, {
    "tStartMs": 33430,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "정답은 염소예요"
    } ]
  }, {
    "tStartMs": 34830,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "참고로 염소 고기 먹어보신 분?"
    } ]
  }, {
    "tStartMs": 38830,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "트렌드에 느리세요"
    } ]
  }, {
    "tStartMs": 40280,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "안타깝습니다"
    } ]
  }, {
    "tStartMs": 41690,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "그렇게 트렌드에 느려서 어떻게 되겠어요?"
    } ]
  }, {
    "tStartMs": 44480,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "우리 동네 사람들은 다 염소 먹는데"
    } ]
  }, {
    "tStartMs": 47750,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "먹어보신 분 계시는구나"
    } ]
  }, {
    "tStartMs": 49380,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "안 먹어보신 분은"
    } ]
  }, {
    "tStartMs": 50220,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "트렌드에 느린 거예요"
    } ]
  }, {
    "tStartMs": 51380,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "요즘 현생도 좀 살고 그래요"
    } ]
  }, {
    "tStartMs": 53560,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "다들 먹고 있는데"
    } ]
  }, {
    "tStartMs": 55430,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "농림축산식품부는 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 57950,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "틈새 축종에서"
    } ]
  }, {
    "tStartMs": 59120,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "그러니까 틈새 염소가 틈새 고기였잖아요"
    } ]
  }, {
    "tStartMs": 61830,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "축산 주력 산업으로 전환을 하겠다라고"
    } ]
  }, {
    "tStartMs": 64030,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "로드맵을 발표한 겁니다"
    } ]
  }, {
    "tStartMs": 66610,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "그러면 듣다 보면"
    } ]
  }, {
    "tStartMs": 67500,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "갑자기 무슨 소, 돼지도 아니고"
    } ]
  }, {
    "tStartMs": 71060,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "염소를 왜 축산 주력 산업으로 만들겠다는 거냐"
    } ]
  }, {
    "tStartMs": 75020,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "30개의 세부과제도 지금 나왔습니다"
    } ]
  }, {
    "tStartMs": 78040,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "염소 산업의 인프라 구축을 추진한다고 해요"
    } ]
  }, {
    "tStartMs": 80350,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "갑자기 왜?"
    } ]
  }, {
    "tStartMs": 82170,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "당연히 첫째 이유가"
    } ]
  }, {
    "tStartMs": 84060,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "국내 염소 소비량이 급증해서 그렇습니다"
    } ]
  }, {
    "tStartMs": 87870,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "나는 못 먹어봤는데"
    } ]
  }, {
    "tStartMs": 89430,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "트렌드 트렌드 트렌드 트렌드를 좀 생각하고"
    } ]
  }, {
    "tStartMs": 92670,
    "dDurationMs": 490,
    "segs": [ {
      "utf8": "그렇죠?"
    } ]
  }, {
    "tStartMs": 93160,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "트렌드에 맞게 학교 가서 그래요"
    } ]
  }, {
    "tStartMs": 95960,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "아니 선생님 급식에 염소가 나와야지"
    } ]
  }, {
    "tStartMs": 98300,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "요즘에 슈카월드 보니까"
    } ]
  }, {
    "tStartMs": 99270,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "뜨는 고기라고 그러던데"
    } ]
  }, {
    "tStartMs": 100370,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "어떻게 소나 돼지밖에 없습니까?"
    } ]
  }, {
    "tStartMs": 102230,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "염소도 나와야지"
    } ]
  }, {
    "tStartMs": 103240,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "라고 주장하는 트렌드 있는 학생에 대한 기원합니다"
    } ]
  }, {
    "tStartMs": 106730,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "국내 염소 소비량이"
    } ]
  }, {
    "tStartMs": 108340,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "YoY 24.5%가 증가했습니다"
    } ]
  }, {
    "tStartMs": 111260,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "오?"
    } ]
  }, {
    "tStartMs": 112220,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "20% 넘게 증가하는 건"
    } ]
  }, {
    "tStartMs": 113840,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "굉장히 이례적인 일입니다"
    } ]
  }, {
    "tStartMs": 115970,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "그래서 소비량이 이렇게 늘다 보니까"
    } ]
  }, {
    "tStartMs": 117920,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "염소 가격이 2024년 기준으로 한우를 넘었어요"
    } ]
  }, {
    "tStartMs": 122820,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "한우보다 비싼 염소고기"
    } ]
  }, {
    "tStartMs": 124880,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "누가 옆에서 염소를 먹는다 그러면 여러분들이 꼭 얘기해 주셔야 됩니다"
    } ]
  }, {
    "tStartMs": 127700,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "우와 너 잘 사나 보다"
    } ]
  }, {
    "tStartMs": 129310,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "야 너 돈 좀 벌었냐?"
    } ]
  }, {
    "tStartMs": 131590,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "코스피에서 뭐 됐구나 네가"
    } ]
  }, {
    "tStartMs": 133370,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "와 드디어 나 염소 먹는 남자야"
    } ]
  }, {
    "tStartMs": 136230,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "이걸 할 수 있잖아요"
    } ]
  }, {
    "tStartMs": 137120,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "한우보다 비싼 고기가 되었고요"
    } ]
  }, {
    "tStartMs": 139520,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "킬로그램에 18,000원이"
    } ]
  }, {
    "tStartMs": 141180,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "도매가로 나왔다고 하는데"
    } ]
  }, {
    "tStartMs": 142560,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "물론 이게 오래가진 못했습니다"
    } ]
  }, {
    "tStartMs": 143920,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "왜냐하면 염소 가격이 크게 오르다 보니까"
    } ]
  }, {
    "tStartMs": 145800,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "염소 수입량이 급등했는데"
    } ]
  }, {
    "tStartMs": 147900,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "얼마나 늘었냐?"
    } ]
  }, {
    "tStartMs": 148960,
    "dDurationMs": 5210,
    "segs": [ {
      "utf8": "2021년에서 2025년까지 염소고기 수입이 5배가 늘었어요"
    } ]
  }, {
    "tStartMs": 154170,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "5배가 늘었어요"
    } ]
  }, {
    "tStartMs": 156250,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "정말 말도 안 되죠?"
    } ]
  }, {
    "tStartMs": 157400,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "잘 팔리고 가격이 오르니까"
    } ]
  }, {
    "tStartMs": 159040,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "수입량이 엄청나게 늘었다는 겁니다"
    } ]
  }, {
    "tStartMs": 161530,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "그리고 돈이 된다는 말이 나오니까"
    } ]
  }, {
    "tStartMs": 163720,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "국내 염소 사육 규모도 크게 늘었어요"
    } ]
  }, {
    "tStartMs": 166780,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "한 1만 가구가 하던 게"
    } ]
  }, {
    "tStartMs": 168080,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "지금 1만 1,400가구 사육 두수도 10% 이상 늘었다는 건데"
    } ]
  }, {
    "tStartMs": 172340,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "이렇게 염소가 인기가 있다 보니까"
    } ]
  }, {
    "tStartMs": 173790,
    "dDurationMs": 5330,
    "segs": [ {
      "utf8": "염소 거래량은 2023년 대비 2025년에 6배"
    } ]
  }, {
    "tStartMs": 179120,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "말도 안 되는 겁니다"
    } ]
  }, {
    "tStartMs": 179970,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "2023년에 7,500두 정도가 거래가 됐는데"
    } ]
  }, {
    "tStartMs": 182700,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "2025년에 4만 7,000두가 거래가 됐어요"
    } ]
  }, {
    "tStartMs": 185950,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "가축시장에서 거래량이 이렇게 늘었다는 건"
    } ]
  }, {
    "tStartMs": 188870,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "한마디로 염소가 인기가 굉장히 좋아졌다는 말이죠"
    } ]
  }, {
    "tStartMs": 192050,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "물론 아까 한우보다 비싼 거는 잠깐이었고"
    } ]
  }, {
    "tStartMs": 194850,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "공급이 늘었기 때문에"
    } ]
  }, {
    "tStartMs": 196120,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "염소 가격은 다시 반토막이 됐습니다"
    } ]
  }, {
    "tStartMs": 198300,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "싸졌어"
    } ]
  }, {
    "tStartMs": 198990,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "지금이야"
    } ]
  }, {
    "tStartMs": 199750,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "드실 때는 지금입니다"
    } ]
  }, {
    "tStartMs": 200660,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "저가 매수는 지금이지 않을까 생각을 하고요"
    } ]
  }, {
    "tStartMs": 203330,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "물론 옛날보다 크게 올랐다가"
    } ]
  }, {
    "tStartMs": 204520,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "이 정도 내려온 거긴 한데"
    } ]
  }, {
    "tStartMs": 205450,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "완전 코스피네"
    } ]
  }, {
    "tStartMs": 207490,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "지금이 저가 매수할 때가 아닌가 생각이 됩니다"
    } ]
  }, {
    "tStartMs": 210740,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "8,900원대까지 내려왔어요"
    } ]
  }, {
    "tStartMs": 213370,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "그래서 이렇게 인기가 단기간에 크게 오르다 보니까"
    } ]
  }, {
    "tStartMs": 216350,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "농림축산부가 제도화를 하겠다"
    } ]
  }, {
    "tStartMs": 218450,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "이런 얘기를 하는 겁니다"
    } ]
  }, {
    "tStartMs": 219500,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "왜냐하면 기존에는 염소산업이 너무 작다 보니까"
    } ]
  }, {
    "tStartMs": 222000,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "자가도축을 하는 비율이 높다 농가에서"
    } ]
  }, {
    "tStartMs": 225670,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "아유 뭐 이거 한 마리 갖고 어디를 가서"
    } ]
  }, {
    "tStartMs": 227610,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "도축을 해 그냥 잡자 이래 갖고 잡는 자가"
    } ]
  }, {
    "tStartMs": 230110,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "도축 비율이 높았다는 거죠"
    } ]
  }, {
    "tStartMs": 231540,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "또 이력제가 시행이 안 된다든지"
    } ]
  }, {
    "tStartMs": 233280,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "뭐 규표 같은 게 있어서 이력이 쫙 나와야 되는데"
    } ]
  }, {
    "tStartMs": 235350,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "그런 게 잘 안 되고 시장이 작았으니까"
    } ]
  }, {
    "tStartMs": 237410,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "몇 마리 있지도 않고"
    } ]
  }, {
    "tStartMs": 238530,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "미등록 농가 비율 예전에"
    } ]
  }, {
    "tStartMs": 240780,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "저희 할머니 제가 어렸을 때"
    } ]
  }, {
    "tStartMs": 241960,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "그러니까 37년 전에"
    } ]
  }, {
    "tStartMs": 243780,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "저희 할머니께서 돌아가셨는데"
    } ]
  }, {
    "tStartMs": 245500,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "염소 키우셨어요"
    } ]
  }, {
    "tStartMs": 247010,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "갑자기 기억이 나네 많이 키우셨어요"
    } ]
  }, {
    "tStartMs": 248920,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "그러니까 많이 낳아요 3마리?"
    } ]
  }, {
    "tStartMs": 250440,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "새끼 낳아서 5마리?"
    } ]
  }, {
    "tStartMs": 251440,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "여기까지 늘었는데"
    } ]
  }, {
    "tStartMs": 252610,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "사람들이 못된 게 염소가 풀을 뜯어 먹으니까"
    } ]
  }, {
    "tStartMs": 256690,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "우리 할머니가 풀이 많은 데다가"
    } ]
  }, {
    "tStartMs": 258650,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "염소를 끌고 가서"
    } ]
  }, {
    "tStartMs": 259660,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "목줄을 한 다음에 이거 꽂아놓잖아요"
    } ]
  }, {
    "tStartMs": 261700,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "꽂아놓고 농촌이니까"
    } ]
  }, {
    "tStartMs": 263840,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "완전 시골이니까 꽂아놓고 집에 가 계셨는데"
    } ]
  }, {
    "tStartMs": 266390,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "나중에 뽑으러 갔는데"
    } ]
  }, {
    "tStartMs": 267280,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "그걸 누가 집어 갔어"
    } ]
  }, {
    "tStartMs": 269180,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "트럭 같은 게 와서"
    } ]
  }, {
    "tStartMs": 269780,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "그걸 훔치고 도망간 거죠"
    } ]
  }, {
    "tStartMs": 270960,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "도둑질을 당해서"
    } ]
  }, {
    "tStartMs": 272580,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "저희 할머니가 마음이 상해져서"
    } ]
  }, {
    "tStartMs": 274270,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "다시는 염소를 안 키웠습니다"
    } ]
  }, {
    "tStartMs": 276580,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "그다음에 토끼 키우셨어요"
    } ]
  }, {
    "tStartMs": 277930,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "토끼 키우셨어"
    } ]
  }, {
    "tStartMs": 279300,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "그래서 제가 토끼 고기도 먹어봤는데"
    } ]
  }, {
    "tStartMs": 281500,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "하여튼 그게 나쁜 놈들"
    } ]
  }, {
    "tStartMs": 282580,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "지금 생각해도 하여튼 그래요"
    } ]
  }, {
    "tStartMs": 283810,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "그래서 미등록 농가 비율이 많고"
    } ]
  }, {
    "tStartMs": 285820,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "몇 마리 소규모를 키우는 경우가"
    } ]
  }, {
    "tStartMs": 287680,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "염소가 굉장히 많았다는 거죠"
    } ]
  }, {
    "tStartMs": 289780,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "그런데 우리나라여서 그렇지"
    } ]
  }, {
    "tStartMs": 291800,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "염소는 놀랍게도"
    } ]
  }, {
    "tStartMs": 293630,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "이거 아마 모르셨을 겁니다"
    } ]
  }, {
    "tStartMs": 295170,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "세계적으로 돼지와 비슷하거나"
    } ]
  }, {
    "tStartMs": 298140,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "또는 돼지보다 키우는 마리 수가 많은 가축입니다"
    } ]
  }, {
    "tStartMs": 302120,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "이 빨간 게 염소예요"
    } ]
  }, {
    "tStartMs": 303650,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "최근에 급증해서 돼지를 능가했어"
    } ]
  }, {
    "tStartMs": 306690,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "닭이 물론 1등이고요"
    } ]
  }, {
    "tStartMs": 308330,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "지금 2024년 기준인데"
    } ]
  }, {
    "tStartMs": 309290,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "지금도 거의 비슷합니다"
    } ]
  }, {
    "tStartMs": 310590,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "소가 2등이고 양이 3등이고"
    } ]
  }, {
    "tStartMs": 312720,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "염소가 4등이야"
    } ]
  }, {
    "tStartMs": 313620,
    "dDurationMs": 650,
    "segs": [ {
      "utf8": "돼지가 적어"
    } ]
  }, {
    "tStartMs": 314270,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "양은 미쳤네"
    } ]
  }, {
    "tStartMs": 314960,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "양은 미쳤는데"
    } ]
  }, {
    "tStartMs": 316430,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "양과 염소가 돼지보다 많이 키워"
    } ]
  }, {
    "tStartMs": 319170,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "글로벌적으로도 수요가 보장돼"
    } ]
  }, {
    "tStartMs": 321280,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "다만 우리나라는 아니죠"
    } ]
  }, {
    "tStartMs": 323130,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "우리나라에서 인지도가 굉장히 낮은데"
    } ]
  }, {
    "tStartMs": 325040,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "우리나라에서는 돼지에 비해서"
    } ]
  }, {
    "tStartMs": 327020,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "사육 두수가 20분의 1입니다"
    } ]
  }, {
    "tStartMs": 329270,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "20분의 1. 5%"
    } ]
  }, {
    "tStartMs": 330970,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "뭐 우리는 사실 염소 고기라는 게 익숙하지 않잖아요"
    } ]
  }, {
    "tStartMs": 333400,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "못 드셔보셨죠?"
    } ]
  }, {
    "tStartMs": 334710,
    "dDurationMs": 540,
    "segs": [ {
      "utf8": "염소"
    } ]
  }, {
    "tStartMs": 335250,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "형님들 뭘로 드셔보셨습니까?"
    } ]
  }, {
    "tStartMs": 337430,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "염소 드셔보신 분"
    } ]
  }, {
    "tStartMs": 338850,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "뭘로 드셔보셨어요?"
    } ]
  }, {
    "tStartMs": 340440,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "수육"
    } ]
  }, {
    "tStartMs": 341000,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "아 형님 연세가 있군요"
    } ]
  }, {
    "tStartMs": 342720,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "수육 대단하다"
    } ]
  }, {
    "tStartMs": 344070,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "대부분 뭘로 드십니까?"
    } ]
  }, {
    "tStartMs": 345230,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "자 여러분 나오죠?"
    } ]
  }, {
    "tStartMs": 346940,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "탕, 즙"
    } ]
  }, {
    "tStartMs": 348020,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "무슨 말입니까?"
    } ]
  }, {
    "tStartMs": 348660,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "우리나라에선 염소가 주로 고기보다는 진액"
    } ]
  }, {
    "tStartMs": 352650,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "뭔가 보양식으로 더 많이 쓰인다는 거죠"
    } ]
  }, {
    "tStartMs": 356170,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "고기나 젖을 위해서"
    } ]
  }, {
    "tStartMs": 357790,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "염소를 키우는 경우가 좀 적죠"
    } ]
  }, {
    "tStartMs": 359740,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "젖은 우리는 우유"
    } ]
  }, {
    "tStartMs": 360890,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "그다음에 고기는 소, 돼지, 닭"
    } ]
  }, {
    "tStartMs": 362560,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "뭐 이 정도가 굉장히 우리까지 주력이라고 볼 수 있습니다"
    } ]
  }, {
    "tStartMs": 366080,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "그래서 결론적으로 농림축산식품부는"
    } ]
  }, {
    "tStartMs": 368710,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "염소고기 수요가 느는데"
    } ]
  }, {
    "tStartMs": 370140,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "국내 산업 경쟁력이 따라가지 못하고 있으니까"
    } ]
  }, {
    "tStartMs": 372200,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "이걸 잘 키우면"
    } ]
  }, {
    "tStartMs": 373390,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "염소도 세계적으로 그렇게 많이 하는 거니까"
    } ]
  }, {
    "tStartMs": 375550,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "외국산 수입이 많이 되는데"
    } ]
  }, {
    "tStartMs": 376540,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "이걸 좀 대체할 수 있지 않겠냐"
    } ]
  }, {
    "tStartMs": 378950,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "국내 염소 사업의 도약을 이뤄보자"
    } ]
  }, {
    "tStartMs": 381930,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "라는 게 계획의 핵심이라고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 385410,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "그런데 여기까지는 계획이죠"
    } ]
  }, {
    "tStartMs": 387080,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "우리가 알았고"
    } ]
  }, {
    "tStartMs": 387890,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "우리가 염소 선진국이 되면 되는 건데"
    } ]
  }, {
    "tStartMs": 390360,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "궁금한 게 생기죠"
    } ]
  }, {
    "tStartMs": 391610,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "왜 갑자기 염소고기가 인기냐"
    } ]
  }, {
    "tStartMs": 394070,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "무슨 수입이 5배 6배가 늘고 그렇죠?"
    } ]
  }, {
    "tStartMs": 396640,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "염소고기 소비량이 왜 느냐?"
    } ]
  }, {
    "tStartMs": 398300,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "이거는 여러 가지가 이유가 있는데"
    } ]
  }, {
    "tStartMs": 400170,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "가장 큰 이유를 꼽히는 거는"
    } ]
  }, {
    "tStartMs": 401620,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "정말 안타깝게 염소를 먹는 이유가"
    } ]
  }, {
    "tStartMs": 405300,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "아까 뭐라고요?"
    } ]
  }, {
    "tStartMs": 406100,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "고기보다는 보통 즙, 탕"
    } ]
  }, {
    "tStartMs": 409010,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "뭐 이런 식으로 보양을 위해 많이 먹잖아요"
    } ]
  }, {
    "tStartMs": 412180,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "지난 2024년에"
    } ]
  }, {
    "tStartMs": 413560,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "우리나라는 개 식용을 종식하는 특별법이 개정됐습니다"
    } ]
  }, {
    "tStartMs": 417520,
    "dDurationMs": 4370,
    "segs": [ {
      "utf8": "2027년부터 우리나라에서는 개 식용이 안 돼요"
    } ]
  }, {
    "tStartMs": 421890,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "내용을 보면 이렇습니다"
    } ]
  }, {
    "tStartMs": 423740,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "공포한 즉시 식용 목적 개의 사육농장이나"
    } ]
  }, {
    "tStartMs": 426860,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "도살이 금지됐어요"
    } ]
  }, {
    "tStartMs": 428350,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "공포 후 3년부터"
    } ]
  }, {
    "tStartMs": 429950,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "2024년에 공포했으니까"
    } ]
  }, {
    "tStartMs": 431680,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "2017년부터는 개를 식용목적으로 사육, 도살, 유통, 판매가 안됩니다"
    } ]
  }, {
    "tStartMs": 436460,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "그러니까 그동안 개를 보양식으로 먹거나"
    } ]
  }, {
    "tStartMs": 440660,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "건강식으로 먹던 사람들이"
    } ]
  }, {
    "tStartMs": 442670,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "대체제로 염소로 많이 간다는 거죠"
    } ]
  }, {
    "tStartMs": 445420,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "약용 효과를 위해서"
    } ]
  }, {
    "tStartMs": 447560,
    "dDurationMs": 5820,
    "segs": [ {
      "utf8": "건강식품, 보양식, 흑염소즙 이런 게 뜨다 보니까"
    } ]
  }, {
    "tStartMs": 453380,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "고기 먹거리 이런 것보다는"
    } ]
  }, {
    "tStartMs": 455300,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "건강식 쪽으로 예전에 뭐라 그랬죠?"
    } ]
  }, {
    "tStartMs": 457760,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "보신탕, 사철탕"
    } ]
  }, {
    "tStartMs": 458970,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "이런 표현 썼잖아요"
    } ]
  }, {
    "tStartMs": 460210,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "그거 대체제로 염소가 뜨고 있다는 거고"
    } ]
  }, {
    "tStartMs": 463310,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "실제로 염소의 주요 소비 행태를 보면"
    } ]
  }, {
    "tStartMs": 466250,
    "dDurationMs": 3410,
    "segs": [ {
      "utf8": "아직까지는 엑기스와 건강원이 많이 등장을 합니다"
    } ]
  }, {
    "tStartMs": 469660,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "하지만 앞으로 장기적으로는"
    } ]
  }, {
    "tStartMs": 471300,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "아마 식당도 좀 늘어나지 않을까?"
    } ]
  }, {
    "tStartMs": 473810,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "점점점 더?"
    } ]
  }, {
    "tStartMs": 475150,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "그러니까 보양식품으로 인식하고 있지만"
    } ]
  }, {
    "tStartMs": 477340,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "고기에 익숙해지다 보면"
    } ]
  }, {
    "tStartMs": 478500,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "우리나라 한국인들이 염소가 익숙하지 않은데"
    } ]
  }, {
    "tStartMs": 480540,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "염소고기가 익숙해지다 보면"
    } ]
  }, {
    "tStartMs": 482300,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "고기를 위한 소비 행태도 늘어나지 않을까"
    } ]
  }, {
    "tStartMs": 485380,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "하지만 지금까지는 엑기스, 건강원"
    } ]
  }, {
    "tStartMs": 488900,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "건강원 얘기를 잠깐 드리면"
    } ]
  }, {
    "tStartMs": 490660,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "제가 어렸을 때"
    } ]
  }, {
    "tStartMs": 491870,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "이런 얘기를 왜 하는지 모르겠지만"
    } ]
  }, {
    "tStartMs": 493470,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "저희 아버지가 낚시를 좋아하셨어요"
    } ]
  }, {
    "tStartMs": 495140,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "저도 어렸을 때부터"
    } ]
  }, {
    "tStartMs": 496100,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "중학생 때부터 아빠 낚시 따라갔는데"
    } ]
  }, {
    "tStartMs": 498770,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "낚시에 가면 잡힌 게 있습니다"
    } ]
  }, {
    "tStartMs": 500590,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "그럼 그 물고기의 처리가 곤란해져요"
    } ]
  }, {
    "tStartMs": 503190,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "집으로 갖고 오면 되지 않냐"
    } ]
  }, {
    "tStartMs": 505150,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "한 이만한 거, 잉어 이런 것도 있으니까"
    } ]
  }, {
    "tStartMs": 508060,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "향어도 있고 40cm, 50cm짜리"
    } ]
  }, {
    "tStartMs": 509640,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "한 10마리를 집에 들고 가면 쫓겨나죠"
    } ]
  }, {
    "tStartMs": 512290,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "쫓겨났단 말이에요"
    } ]
  }, {
    "tStartMs": 513710,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "야, 이걸 어떡하라고"
    } ]
  }, {
    "tStartMs": 515750,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "한 이틀 세고 하루 밤 잡고 하니까"
    } ]
  }, {
    "tStartMs": 517700,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "적게 잡으면 5마리"
    } ]
  }, {
    "tStartMs": 518690,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "많이 잡으면 10마리 들고 가면 쫓겨나"
    } ]
  }, {
    "tStartMs": 520180,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "그걸 건강원에 가져가요"
    } ]
  }, {
    "tStartMs": 521810,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "그래서 보통 그냥 드려"
    } ]
  }, {
    "tStartMs": 523330,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "붕어 같은 거, 붕어즙 뭐 어쩌고 드려"
    } ]
  }, {
    "tStartMs": 525270,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "그냥 공짜로 그냥 이거 하세요라고 드리는데"
    } ]
  }, {
    "tStartMs": 527720,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "당시에 동네 가게들하고 친하게 지냈으니까"
    } ]
  }, {
    "tStartMs": 530380,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "그때 아직 기억나는 게"
    } ]
  }, {
    "tStartMs": 531440,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "저희 아버지가 웬일로 한 70cm 정도 되는"
    } ]
  }, {
    "tStartMs": 534790,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "엄청 큰 잉어를 잡아줬어요"
    } ]
  }, {
    "tStartMs": 536950,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "그거를 건강원에 주기보다"
    } ]
  }, {
    "tStartMs": 538450,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "야 우리가 한번 또 잉어집이 건강에 좋다는 이런 소리 하시면서"
    } ]
  }, {
    "tStartMs": 542560,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "한번 그 즙을 뽑아보자"
    } ]
  }, {
    "tStartMs": 544550,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "근데 저희 아버지가"
    } ]
  }, {
    "tStartMs": 545720,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "언제나 문제를 좀 잘 일으키시는 분이에요"
    } ]
  }, {
    "tStartMs": 548380,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "그러니까 뭘 잘 벌려 저랑 똑같죠"
    } ]
  }, {
    "tStartMs": 551180,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "일단 대책 없이 해봐"
    } ]
  }, {
    "tStartMs": 552420,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "자 잉어즙을 만들자"
    } ]
  }, {
    "tStartMs": 553560,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "석재야 그래서 예 아버지 어떻게 만들어요?"
    } ]
  }, {
    "tStartMs": 555140,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "그랬더니 저를 쳐다보면서"
    } ]
  }, {
    "tStartMs": 556390,
    "dDurationMs": 570,
    "segs": [ {
      "utf8": "난 모르지"
    } ]
  }, {
    "tStartMs": 556960,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "네가 만들어야지 엄마하고"
    } ]
  }, {
    "tStartMs": 559040,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "주고 가셔서"
    } ]
  }, {
    "tStartMs": 560390,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "지금 어머니하고 잉어 즙을 어떻게 만드는 거냐"
    } ]
  }, {
    "tStartMs": 563450,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "그때 이제 인터넷 유튜브가 없으니까"
    } ]
  }, {
    "tStartMs": 565520,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "잉어즙"
    } ]
  }, {
    "tStartMs": 566950,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "그래서 아 이걸 배를 가르고"
    } ]
  }, {
    "tStartMs": 569500,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "뭐 해서 손질한 다음에 넣어야 되나?"
    } ]
  }, {
    "tStartMs": 571010,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "근데 즙이니까 다 넣어야 되는 거 아닌가?"
    } ]
  }, {
    "tStartMs": 573450,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "그래서 잉어를 커다란"
    } ]
  }, {
    "tStartMs": 574920,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "이런 진짜 커다란 스테인리스 냄비에"
    } ]
  }, {
    "tStartMs": 577760,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "커다란 진짜 커다란 거"
    } ]
  }, {
    "tStartMs": 578720,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "70cm, 80cm 짜리"
    } ]
  }, {
    "tStartMs": 579700,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "들어가야 되니까"
    } ]
  }, {
    "tStartMs": 580620,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "그걸 거기 넣은 다음에 물을 살짝 넣고"
    } ]
  }, {
    "tStartMs": 582510,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "자박자박 끓인 다음에 살아있는 잉어를"
    } ]
  }, {
    "tStartMs": 584660,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "그게 35년 전이에요"
    } ]
  }, {
    "tStartMs": 585770,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "어떻게 할지 모르니까"
    } ]
  }, {
    "tStartMs": 586750,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "어떻게 할지 모르니까"
    } ]
  }, {
    "tStartMs": 587970,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "손질해서 넣을까 하다가"
    } ]
  }, {
    "tStartMs": 589410,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "지내기면 다 넣어야 되는 거 아니야?"
    } ]
  }, {
    "tStartMs": 591010,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "이런 의견이 나왔어요"
    } ]
  }, {
    "tStartMs": 591720,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "지금 생각하면 말도 안 되지"
    } ]
  }, {
    "tStartMs": 592890,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "그래 그렇게 넣어"
    } ]
  }, {
    "tStartMs": 593900,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "이게 손질한다고 해야 되는데 몰랐지"
    } ]
  }, {
    "tStartMs": 595720,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "그래서 그걸 넣으니까"
    } ]
  }, {
    "tStartMs": 596710,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "잉어가 가만히 있나?"
    } ]
  }, {
    "tStartMs": 598750,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "팔 딱 뛰어서 나오는 순간에"
    } ]
  }, {
    "tStartMs": 600930,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "그 스테인리스 이게 뒤집어지면서"
    } ]
  }, {
    "tStartMs": 604800,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "아직도 생각납니다"
    } ]
  }, {
    "tStartMs": 608140,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "우리 부엌에서 했었거든요"
    } ]
  }, {
    "tStartMs": 609780,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "잉어가 펄쩍펄쩍 뛰면서"
    } ]
  }, {
    "tStartMs": 611680,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "그걸 사방에다가 날려갖고"
    } ]
  }, {
    "tStartMs": 613980,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "엄청 뜨겁잖아"
    } ]
  }, {
    "tStartMs": 614750,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "옆에 있는데"
    } ]
  }, {
    "tStartMs": 615450,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "뜨거운 게 확 오니까 놀래가고"
    } ]
  }, {
    "tStartMs": 616990,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "혼비백산 옆으로 피하면서"
    } ]
  }, {
    "tStartMs": 619650,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "그 스테인리스가 이렇게 날라가고"
    } ]
  }, {
    "tStartMs": 621510,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "잉어 나는 거 못봤죠?"
    } ]
  }, {
    "tStartMs": 622730,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "촤아악 잉어가 날아가고"
    } ]
  }, {
    "tStartMs": 624420,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "농담 아닙니다x2"
    } ]
  }, {
    "tStartMs": 625670,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "그 만화같은 모습"
    } ]
  }, {
    "tStartMs": 626670,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "촤아악 그랬던 기억이 납니다"
    } ]
  }, {
    "tStartMs": 629570,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "그래서 결국에는 망했죠 망했는데"
    } ]
  }, {
    "tStartMs": 631940,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "결국에는 어떻게 어떻게 해서"
    } ]
  }, {
    "tStartMs": 633110,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "다시 뭐 제 트라이 삼 트라이해서 잉어집이 나왔는데"
    } ]
  }, {
    "tStartMs": 636460,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "한 모금을 못 마셨어요"
    } ]
  }, {
    "tStartMs": 637490,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "야 그렇게 하면 안되더만"
    } ]
  }, {
    "tStartMs": 638580,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "뭐 쓸게 빼고 뭐 빼고"
    } ]
  }, {
    "tStartMs": 639670,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "해야되는거 같애"
    } ]
  }, {
    "tStartMs": 640170,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "하나도 안 빼고 했더니"
    } ]
  }, {
    "tStartMs": 641700,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "으"
    } ]
  }, {
    "tStartMs": 643100,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "와 엄청 써"
    } ]
  }, {
    "tStartMs": 644220,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "뭐야 이거 그래갖고 다 버렸던 기억이"
    } ]
  }, {
    "tStartMs": 646620,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "죄송합니다"
    } ]
  }, {
    "tStartMs": 647310,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "쓸데없는 얘긴데 그런 기억이 납니다"
    } ]
  }, {
    "tStartMs": 649010,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "건강원 얘기를 하니까"
    } ]
  }, {
    "tStartMs": 650460,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "그래서인지 몰라도"
    } ]
  }, {
    "tStartMs": 651970,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "우리나라 염소는 대부분 어떻게 생겼어요"
    } ]
  }, {
    "tStartMs": 654310,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "한국의 염소는 아까 제가 보여드린 얘들은"
    } ]
  }, {
    "tStartMs": 657380,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "전형적인 한국 염소가 아니죠"
    } ]
  }, {
    "tStartMs": 659380,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "이거는 서양에서 많이 보는 애들이고"
    } ]
  }, {
    "tStartMs": 661680,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "우리나라 염소는 이렇게 생겼어요"
    } ]
  }, {
    "tStartMs": 664200,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "대개 흑염소가 많습니다"
    } ]
  }, {
    "tStartMs": 665790,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "갈색과 백색도 있긴 한데"
    } ]
  }, {
    "tStartMs": 667050,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "잘 없어 있긴 있어요"
    } ]
  }, {
    "tStartMs": 668370,
    "dDurationMs": 590,
    "segs": [ {
      "utf8": "잘 없어"
    } ]
  }, {
    "tStartMs": 668960,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "왜냐하면 흑염소가 약용 효과가 좋다는"
    } ]
  }, {
    "tStartMs": 672410,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "그렇게 불리죠"
    } ]
  }, {
    "tStartMs": 673500,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "그게 사실인지 아닌지는"
    } ]
  }, {
    "tStartMs": 674870,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "저는 잘 모르겠는데 그렇겠죠"
    } ]
  }, {
    "tStartMs": 676610,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "아무래도 그러니까 흑염소"
    } ]
  }, {
    "tStartMs": 677830,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "즉 이런 거였지 백염소"
    } ]
  }, {
    "tStartMs": 679470,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "즉 이런 거 잘 없잖아"
    } ]
  }, {
    "tStartMs": 680750,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "흑염소를 그러다 보니까"
    } ]
  }, {
    "tStartMs": 682760,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "주로 많이 키우는데"
    } ]
  }, {
    "tStartMs": 684050,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "참고로 우리나라 흑염소는 놀랍게도"
    } ]
  }, {
    "tStartMs": 686320,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "우리나라 고유 품종입니다"
    } ]
  }, {
    "tStartMs": 688390,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "백염소 이런 건 들어온 것들이 많아요 대부분"
    } ]
  }, {
    "tStartMs": 691120,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "고기 먹고 젖자고 하는 염소들은"
    } ]
  }, {
    "tStartMs": 692830,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "다 들어온 거예요"
    } ]
  }, {
    "tStartMs": 694160,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "우리나라 소도 다 들어온 거잖아"
    } ]
  }, {
    "tStartMs": 695590,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "돼지도 다 들어온 거고"
    } ]
  }, {
    "tStartMs": 696420,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "닭도 들어온 거고"
    } ]
  }, {
    "tStartMs": 697600,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "흑염소는 우리나라 고유품종이에요"
    } ]
  }, {
    "tStartMs": 699810,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "유엔식량농업기구에도 등재되어 있다고 합니다"
    } ]
  }, {
    "tStartMs": 702820,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "놀랍게도 우리나라 재래의 흑염소는"
    } ]
  }, {
    "tStartMs": 704970,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "세 종류가 있대"
    } ]
  }, {
    "tStartMs": 706320,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "혹시 아십니까?"
    } ]
  }, {
    "tStartMs": 707230,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "세 계통이 있대"
    } ]
  }, {
    "tStartMs": 707930,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "저도 이번에 알았어요"
    } ]
  }, {
    "tStartMs": 709090,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "저는 모르겠는데요?"
    } ]
  }, {
    "tStartMs": 710350,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "당연히 모르죠"
    } ]
  }, {
    "tStartMs": 711130,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "왜냐하면 일반인은 알 수 없습니다"
    } ]
  }, {
    "tStartMs": 714670,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "당진, 장수, 통영 계통이 있다고 그러는데"
    } ]
  }, {
    "tStartMs": 717440,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "이걸 어떻게 알아?"
    } ]
  }, {
    "tStartMs": 719400,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "그냥 흑염소구만"
    } ]
  }, {
    "tStartMs": 720540,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "털이 기냐?"
    } ]
  }, {
    "tStartMs": 721920,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "털이 짭냐?"
    } ]
  }, {
    "tStartMs": 723420,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "등치가 약간 작냐 등등등으로 계통이 나뉜다고 합니다"
    } ]
  }, {
    "tStartMs": 726870,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "이거 뭐 강아지 계통 물리하고 비슷하구만"
    } ]
  }, {
    "tStartMs": 728740,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "어디는 진돗개고"
    } ]
  }, {
    "tStartMs": 730090,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "어디는 시고르자브종이고"
    } ]
  }, {
    "tStartMs": 731680,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "뭐 그렇죠"
    } ]
  }, {
    "tStartMs": 732460,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "약간의 차이가 있는데"
    } ]
  }, {
    "tStartMs": 733920,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "그래서 뭐 모르는 게 당연하지만"
    } ]
  }, {
    "tStartMs": 735210,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "하여튼 크게 이제 3계통이 있다고 합니다"
    } ]
  }, {
    "tStartMs": 737760,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "방금 얘기 드렸지만"
    } ]
  }, {
    "tStartMs": 738750,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "우리나라의 흑염소가 대세인 건"
    } ]
  }, {
    "tStartMs": 740360,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "아무래도 고기보다는"
    } ]
  }, {
    "tStartMs": 741740,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "보양식 문화 차이가 있고"
    } ]
  }, {
    "tStartMs": 743330,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "그리고 산악지대와 추위에 잘 견디는 종"
    } ]
  }, {
    "tStartMs": 745820,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "한반도에서는 어지간히 잘 견디지 않는 애들은"
    } ]
  }, {
    "tStartMs": 748780,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "이미 다 도태되죠"
    } ]
  }, {
    "tStartMs": 749990,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "어이 좀 추워 못 살겠어요"
    } ]
  }, {
    "tStartMs": 751440,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "그럼 못 사는 거예요"
    } ]
  }, {
    "tStartMs": 752770,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "먹을 풀이 없는데요?"
    } ]
  }, {
    "tStartMs": 754110,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "적당히 먹어서 살아야 돼"
    } ]
  }, {
    "tStartMs": 755050,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "아니면 죽는 거야"
    } ]
  }, {
    "tStartMs": 756570,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "그리고 산악지대도 잘 다녀야 돼"
    } ]
  }, {
    "tStartMs": 758140,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "넓은 데만 다닐래요?"
    } ]
  }, {
    "tStartMs": 759160,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "그럼 요즘은 아니지만"
    } ]
  }, {
    "tStartMs": 759960,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "예전에는 타이거 형님들이 떼찌 떼찌 했기 때문에"
    } ]
  }, {
    "tStartMs": 763030,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "살아남기 힘들었어"
    } ]
  }, {
    "tStartMs": 764340,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "그래서 고려시대, 조선시대에서 살아남으려면"
    } ]
  }, {
    "tStartMs": 766930,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "레오파드 형님과 타이거 형님들을 피해 다녀야 되기 때문에"
    } ]
  }, {
    "tStartMs": 770020,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "생존력이 강한 놈"
    } ]
  }, {
    "tStartMs": 771060,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "아니면 살아남지 못했던 게"
    } ]
  }, {
    "tStartMs": 773110,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "한반도라고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 774630,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "물론 저런 흑염소가 대세인 거는"
    } ]
  }, {
    "tStartMs": 776360,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "우리나라만의 일이죠"
    } ]
  }, {
    "tStartMs": 777490,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "대부분의 나라에서 염소라고 하면"
    } ]
  }, {
    "tStartMs": 779370,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "이렇게 생겼어요"
    } ]
  }, {
    "tStartMs": 780800,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "이게 염소입니까? 개입니까?"
    } ]
  }, {
    "tStartMs": 782290,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "라고 문이 있던데"
    } ]
  }, {
    "tStartMs": 783660,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "염소입니다"
    } ]
  }, {
    "tStartMs": 784550,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "우리 자료 만드는 친구가 개 아니냐고"
    } ]
  }, {
    "tStartMs": 786780,
    "dDurationMs": 670,
    "segs": [ {
      "utf8": "염소예요"
    } ]
  }, {
    "tStartMs": 787450,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "이게 세계에서 가장 유명한 염소종이에요"
    } ]
  }, {
    "tStartMs": 790500,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "뭔 개여"
    } ]
  }, {
    "tStartMs": 791420,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "염소야"
    } ]
  }, {
    "tStartMs": 792330,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "이 종이 보호종이라고 그럽니다"
    } ]
  }, {
    "tStartMs": 794250,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "고기, 육용"
    } ]
  }, {
    "tStartMs": 795550,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "이게 되게 일찍 큰데"
    } ]
  }, {
    "tStartMs": 796620,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "등치도 크고 몸이 희고 머리가 갈색이고 빠른 성장"
    } ]
  }, {
    "tStartMs": 800520,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "이 염소가 되게 유명하다고"
    } ]
  }, {
    "tStartMs": 801630,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "그러고 우리 염소 하면 흰색"
    } ]
  }, {
    "tStartMs": 803480,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "아 그거는 고기도 고기인데"
    } ]
  }, {
    "tStartMs": 805240,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "젖을 위한 염소가 또 많다고 그럽니다"
    } ]
  }, {
    "tStartMs": 807090,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "종류가 되게 많아요"
    } ]
  }, {
    "tStartMs": 807890,
    "dDurationMs": 670,
    "segs": [ {
      "utf8": "열몇 가지가 있는데"
    } ]
  }, {
    "tStartMs": 808560,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "몇 개 갖고 오면"
    } ]
  }, {
    "tStartMs": 809280,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "자생종이라 그런데"
    } ]
  }, {
    "tStartMs": 810670,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "염소계의 홀스타인 소다"
    } ]
  }, {
    "tStartMs": 812690,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "젖 생산 능력이 미쳤다"
    } ]
  }, {
    "tStartMs": 813980,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "염소, 우유"
    } ]
  }, {
    "tStartMs": 814950,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "염소 젖 생산 능력이 미쳤다"
    } ]
  }, {
    "tStartMs": 816530,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "털이 희고 온순하고"
    } ]
  }, {
    "tStartMs": 818150,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "스위스 고산이 될까"
    } ]
  }, {
    "tStartMs": 819130,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "우리가 흔히 유럽 모시기 모시기 보면"
    } ]
  }, {
    "tStartMs": 821270,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "많이 나오는 애들"
    } ]
  }, {
    "tStartMs": 822410,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "그런 애들이 이런 종이라고 합니다"
    } ]
  }, {
    "tStartMs": 825010,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "그러면 우리나라가 염소 수입이 약간 늘었다며요"
    } ]
  }, {
    "tStartMs": 827930,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "우리나라가 수입하는 염소는"
    } ]
  }, {
    "tStartMs": 829290,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "주로 어디서 수입하는 거냐 스위스냐"
    } ]
  }, {
    "tStartMs": 831680,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "아닙니다"
    } ]
  }, {
    "tStartMs": 832500,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "우리나라가 수입하는 염소는"
    } ]
  }, {
    "tStartMs": 835260,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "99%가 호주산이에요"
    } ]
  }, {
    "tStartMs": 836740,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "흑염소냐 백염소냐"
    } ]
  }, {
    "tStartMs": 838550,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "좀 섞여있어요"
    } ]
  }, {
    "tStartMs": 839760,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "갈색염소가 많습니다"
    } ]
  }, {
    "tStartMs": 841290,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "왜 그런가 이제 제가 보여드릴게요"
    } ]
  }, {
    "tStartMs": 842890,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "거의 90% 호주산이고"
    } ]
  }, {
    "tStartMs": 844900,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "뉴질랜드가 요즘 조금 늘어서 섞여 들어옵니다"
    } ]
  }, {
    "tStartMs": 847770,
    "dDurationMs": 5690,
    "segs": [ {
      "utf8": "그러면 호주가 염소 대국인가요? 99% 호주산이니까"
    } ]
  }, {
    "tStartMs": 853460,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "호주는 전세계에서"
    } ]
  }, {
    "tStartMs": 854830,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "염소 생산량이 우리나라보다 많지만"
    } ]
  }, {
    "tStartMs": 857880,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "굉장히 작은 나라 중에 하나예요 0.5%"
    } ]
  }, {
    "tStartMs": 860790,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "대부분의 염소는 중국과 인도가 과반수입니다"
    } ]
  }, {
    "tStartMs": 863560,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "거의 50% 이상을 차지해요"
    } ]
  }, {
    "tStartMs": 865410,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "그럼 호주가 0.5%밖에 생산 안 하는데"
    } ]
  }, {
    "tStartMs": 867170,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "왜 호주에 수입하냐?"
    } ]
  }, {
    "tStartMs": 868660,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "다른 나라들은 보통 자기들이 먹습니다"
    } ]
  }, {
    "tStartMs": 871320,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "내수 목적이 많아"
    } ]
  }, {
    "tStartMs": 872460,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "수출할 고기가 없어"
    } ]
  }, {
    "tStartMs": 873910,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "근데 호주는 염소를 잘 안 먹어요"
    } ]
  }, {
    "tStartMs": 876530,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "저렇게 땅도 넓고 먹을 게 많은데"
    } ]
  }, {
    "tStartMs": 877990,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "염소를 먹겠습니까? 호주가?"
    } ]
  }, {
    "tStartMs": 879540,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "스테이크하우스가 널린 나라인데"
    } ]
  }, {
    "tStartMs": 881180,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "아웃백이 있는 나라인데"
    } ]
  }, {
    "tStartMs": 883010,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "그래서 염소를 다 수출해"
    } ]
  }, {
    "tStartMs": 885270,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "이 큰 내수예요"
    } ]
  }, {
    "tStartMs": 886690,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "싹 수출합니다"
    } ]
  }, {
    "tStartMs": 887900,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "그러다 보니까"
    } ]
  }, {
    "tStartMs": 889060,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "호주가 전 세계에서"
    } ]
  }, {
    "tStartMs": 890640,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "염소 수출 1위 국가입니다 40%"
    } ]
  }, {
    "tStartMs": 893400,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "후반대에서 많을 때는"
    } ]
  }, {
    "tStartMs": 894780,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "50%까지 호주가 다 수출해요"
    } ]
  }, {
    "tStartMs": 896380,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "2위가 케냐라고 합니다"
    } ]
  }, {
    "tStartMs": 898480,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "그럼 호주가 염소를 키워서 수출하는 거냐?"
    } ]
  }, {
    "tStartMs": 901720,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "아니, 그 질문 이전에"
    } ]
  }, {
    "tStartMs": 903300,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "호주에 염소가 있나요?"
    } ]
  }, {
    "tStartMs": 905310,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "있었나?"
    } ]
  }, {
    "tStartMs": 906780,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "호주는 원래, 오스트리아는 염소가 없던 대륙이었어요"
    } ]
  }, {
    "tStartMs": 910940,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "보통 이 대륙엔 뭐가 없죠?"
    } ]
  }, {
    "tStartMs": 912960,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "뭐가 없었는데"
    } ]
  }, {
    "tStartMs": 913830,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "보통 누가 데리고 와서 대륙이"
    } ]
  }, {
    "tStartMs": 916340,
    "dDurationMs": 580,
    "segs": [ {
      "utf8": "죄송한 표현인데"
    } ]
  }, {
    "tStartMs": 916920,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "골로 가잖아요"
    } ]
  }, {
    "tStartMs": 917950,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "외래 침입종으로 맛이 가는데"
    } ]
  }, {
    "tStartMs": 920010,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "염소도 비슷한 놈들입니다"
    } ]
  }, {
    "tStartMs": 921730,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "염소가 없었는데"
    } ]
  }, {
    "tStartMs": 923170,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "18세기 이 오스트레일리아에 왔던 어떤 나라가"
    } ]
  }, {
    "tStartMs": 926430,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "고기 용도로 염소를 데리고 들어왔어요"
    } ]
  }, {
    "tStartMs": 929170,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "무슨 뭐 캡틴 쿡이라는 둥 하면서"
    } ]
  }, {
    "tStartMs": 931830,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "저 영국이라는 나라가 이제 들어왔는데"
    } ]
  }, {
    "tStartMs": 934310,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "문제는 쟤네들 데려왔으면 빨리빨리 먹어야 되는데"
    } ]
  }, {
    "tStartMs": 936380,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "그걸 키웠죠"
    } ]
  }, {
    "tStartMs": 937440,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "키웠다가 호주의 광활한 아웃백으로"
    } ]
  }, {
    "tStartMs": 940370,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "염소들이 나가는 순간에 컨트롤이 안 돼"
    } ]
  }, {
    "tStartMs": 943210,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "컨트롤이 안 돼"
    } ]
  }, {
    "tStartMs": 943890,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "컨트롤이 안 돼"
    } ]
  }, {
    "tStartMs": 944600,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "그 사람도 컨트롤이 안 되지"
    } ]
  }, {
    "tStartMs": 945700,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "어떻게 컨트롤이 되겠어"
    } ]
  }, {
    "tStartMs": 946680,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "그 넓은 호주 대륙에"
    } ]
  }, {
    "tStartMs": 948140,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "게다가 염소는 물이 없어도 잘 버팁니다"
    } ]
  }, {
    "tStartMs": 950820,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "건조하고 먹을 게 없어서 잘 버텨요"
    } ]
  }, {
    "tStartMs": 952910,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "지표 식물을 싹 먹어치워"
    } ]
  }, {
    "tStartMs": 955040,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "게다가 쭉쭉쭉쭉 물을 빠니까"
    } ]
  }, {
    "tStartMs": 956230,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "물 부족 현상도 심해져"
    } ]
  }, {
    "tStartMs": 958220,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "게다가 원래 있던 기존 생물에게"
    } ]
  }, {
    "tStartMs": 961140,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "굉장히 안 좋은 영향을 미쳤죠"
    } ]
  }, {
    "tStartMs": 962950,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "그래서 지금도 호주 염소는"
    } ]
  }, {
    "tStartMs": 964930,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "외래 침입종을 관리되고 있습니다"
    } ]
  }, {
    "tStartMs": 966870,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "최악의 침입종 중 하나로 꼽힌 토끼, 염소, 여우"
    } ]
  }, {
    "tStartMs": 970680,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "하여튼 저기도 뭐만 들어가면"
    } ]
  }, {
    "tStartMs": 972290,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "보통 최악의 침입종이 됩니다"
    } ]
  }, {
    "tStartMs": 974400,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "고양이, 뭐 이런들이 있죠, 호주에는"
    } ]
  }, {
    "tStartMs": 976220,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "그러다 보니까"
    } ]
  }, {
    "tStartMs": 977320,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "호주가 묘수를 찾은 거예요"
    } ]
  }, {
    "tStartMs": 978650,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "야, 이거 어떡하냐"
    } ]
  }, {
    "tStartMs": 980130,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "그렇다고 잡아서"
    } ]
  }, {
    "tStartMs": 981460,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "자국민들 먹이려고 했더니"
    } ]
  }, {
    "tStartMs": 982710,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "안 먹어"
    } ]
  }, {
    "tStartMs": 983840,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "야 우리는 뭐 소가 있고"
    } ]
  }, {
    "tStartMs": 984960,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "스테이크가 있는데"
    } ]
  }, {
    "tStartMs": 985520,
    "dDurationMs": 470,
    "segs": [ {
      "utf8": "이걸 왜 먹어?"
    } ]
  }, {
    "tStartMs": 985990,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "잘 안 먹어"
    } ]
  }, {
    "tStartMs": 987170,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "그러니까 잡아다가 이걸 어떡하냐?"
    } ]
  }, {
    "tStartMs": 988860,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "근데 이거 야생염소잖아요"
    } ]
  }, {
    "tStartMs": 990260,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "키우던 것도 아니고"
    } ]
  }, {
    "tStartMs": 991520,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "뭐 방법이 없나?"
    } ]
  }, {
    "tStartMs": 992410,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "그래서 잡아서 얼려서"
    } ]
  }, {
    "tStartMs": 995490,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "대충 냉동육으로 수출한 게"
    } ]
  }, {
    "tStartMs": 997870,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "호주 염소 수출의 시작입니다"
    } ]
  }, {
    "tStartMs": 999840,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "이거 키워서 수출한 게 아니야"
    } ]
  }, {
    "tStartMs": 1001730,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "너무 많으니까"
    } ]
  }, {
    "tStartMs": 1002650,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "야 뭐야 이거 야생에서 몇만 마리씩 잡는 거야"
    } ]
  }, {
    "tStartMs": 1005400,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "이거 어떻게 하냐"
    } ]
  }, {
    "tStartMs": 1006600,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "이러다 보니까"
    } ]
  }, {
    "tStartMs": 1007870,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "대충 썰어갖고 얼려갖고"
    } ]
  }, {
    "tStartMs": 1009710,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "냉동육으로 하자"
    } ]
  }, {
    "tStartMs": 1010780,
    "dDurationMs": 3410,
    "segs": [ {
      "utf8": "그래갖고 호주가 세계 최대 염소 수출국이 된다는 거죠"
    } ]
  }, {
    "tStartMs": 1014190,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "근데 막 팔다 보니까"
    } ]
  }, {
    "tStartMs": 1015980,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "돈이 되는 거죠"
    } ]
  }, {
    "tStartMs": 1017330,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "야생 염소는 지금 호주 서부에 많이 있다 그러던데"
    } ]
  }, {
    "tStartMs": 1019880,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "2020년에 490만 마리"
    } ]
  }, {
    "tStartMs": 1021480,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "이제는 관리하고 있습니다"
    } ]
  }, {
    "tStartMs": 1023230,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "이제는 토지 소유자들과 협력하여"
    } ]
  }, {
    "tStartMs": 1025510,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "다양한 생물적인 개체수를 유지하면서"
    } ]
  }, {
    "tStartMs": 1027700,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "염소 방목도 적당히 할 수 있게"
    } ]
  }, {
    "tStartMs": 1030140,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "먹어서 이기는 거죠"
    } ]
  }, {
    "tStartMs": 1031180,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "썰어서 이겼습니다"
    } ]
  }, {
    "tStartMs": 1032460,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "우리나라 청개처럼"
    } ]
  }, {
    "tStartMs": 1033570,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "아직은 침입적이긴 하지만"
    } ]
  }, {
    "tStartMs": 1036060,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "잘 관리하고 유지하고 있고요"
    } ]
  }, {
    "tStartMs": 1038420,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "그리고 호주는 지금도"
    } ]
  }, {
    "tStartMs": 1040140,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "염소를 야생 목초지에서 키운다고 합니다"
    } ]
  }, {
    "tStartMs": 1042480,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "아직도 방목이야"
    } ]
  }, {
    "tStartMs": 1043660,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "그러다 보니까"
    } ]
  }, {
    "tStartMs": 1044390,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "호주 염소가 가격이 미쳤는데"
    } ]
  }, {
    "tStartMs": 1046430,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "왜냐면 자기들이 잘 먹지도 않고"
    } ]
  }, {
    "tStartMs": 1048480,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "말이 이렇게 나오고 있어요"
    } ]
  }, {
    "tStartMs": 1049910,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "염소는 건조한 환경에서 잘 적응하고"
    } ]
  }, {
    "tStartMs": 1052320,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "사육에 인위적인 화학 먹이가 필요하지 않다"
    } ]
  }, {
    "tStartMs": 1055040,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "이게 우리나라에선 잘 이해가 안 되겠지만"
    } ]
  }, {
    "tStartMs": 1056990,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "대충 풀어놓으면 대충 먹는다는 거죠"
    } ]
  }, {
    "tStartMs": 1059460,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "대충 자라고"
    } ]
  }, {
    "tStartMs": 1060380,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "아 들어와라 하면 배부르게 먹은 애가 들어오니까"
    } ]
  }, {
    "tStartMs": 1062960,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "뭐 별로 돈이 안 들어"
    } ]
  }, {
    "tStartMs": 1064470,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "심지어 귀 표식도 안 단다 그래요"
    } ]
  }, {
    "tStartMs": 1066460,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "어차피 야생인 애들인데"
    } ]
  }, {
    "tStartMs": 1068010,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "대충 잡아서"
    } ]
  }, {
    "tStartMs": 1068880,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "대충 도축장으로 보내면"
    } ]
  }, {
    "tStartMs": 1070460,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "귀표를 달 필요가 없다"
    } ]
  }, {
    "tStartMs": 1071640,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "아니 너무 관리 안 하는 거 아닙니까?"
    } ]
  }, {
    "tStartMs": 1073320,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "물론 관리하고 사육한 애들도 있는데"
    } ]
  }, {
    "tStartMs": 1075870,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "성수기 때 우리 농장에서 만 마리를 잡습니다"
    } ]
  }, {
    "tStartMs": 1078430,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "근데 언제 하나하나 귀표를 달아요"
    } ]
  }, {
    "tStartMs": 1080740,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "염소 키우는데 비용이 나요"
    } ]
  }, {
    "tStartMs": 1081680,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "대충 염소 가격이 떨어져도"
    } ]
  }, {
    "tStartMs": 1083430,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "충분히 수익이 나는 게"
    } ]
  }, {
    "tStartMs": 1084480,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "호주 염소라고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 1086750,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "게다가 염소고기는 장점이 하나 있는데"
    } ]
  }, {
    "tStartMs": 1089290,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "대부분의 나라에서 금기가 없다고 합니다"
    } ]
  }, {
    "tStartMs": 1091950,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "돼지 금기 있죠"
    } ]
  }, {
    "tStartMs": 1093200,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "이슬람 안 먹잖아"
    } ]
  }, {
    "tStartMs": 1094310,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "소도 금기 있어요"
    } ]
  }, {
    "tStartMs": 1095390,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "힌두교 안 먹잖아"
    } ]
  }, {
    "tStartMs": 1096510,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "이렇게 뭔가 금기가 있는데"
    } ]
  }, {
    "tStartMs": 1097850,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "염소는 금기가 잘 없어요"
    } ]
  }, {
    "tStartMs": 1099790,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "금기는 없는데"
    } ]
  }, {
    "tStartMs": 1101490,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "지역별 소비 방법이"
    } ]
  }, {
    "tStartMs": 1102590,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "대단히 많이 다른 특징이 있다고 합니다"
    } ]
  }, {
    "tStartMs": 1104700,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "조리법, 요리, 음식 문화가"
    } ]
  }, {
    "tStartMs": 1106680,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "예를 들면"
    } ]
  }, {
    "tStartMs": 1107480,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "호주인들이 전혀"
    } ]
  }, {
    "tStartMs": 1108640,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "저희 인터뷰도 봤습니다"
    } ]
  }, {
    "tStartMs": 1109850,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "전혀 이해하지 못한다는 거"
    } ]
  }, {
    "tStartMs": 1111500,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "흑염소즙"
    } ]
  }, {
    "tStartMs": 1113040,
    "dDurationMs": 530,
    "segs": [ {
      "utf8": "ㅎㅎㅎㅎㅎ"
    } ]
  }, {
    "tStartMs": 1113570,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "제 생각에도 너희는 이해 못할 것 같아"
    } ]
  }, {
    "tStartMs": 1116740,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "먹어봐야 알아요 먹어봐야"
    } ]
  }, {
    "tStartMs": 1118650,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "아 그거 안 드셔보셨으니"
    } ]
  }, {
    "tStartMs": 1120470,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "그런 생각을 하는 거예요"
    } ]
  }, {
    "tStartMs": 1121940,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "왜 그걸 즙으로 먹냐"
    } ]
  }, {
    "tStartMs": 1123670,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "이게 드링크? 음료?"
    } ]
  }, {
    "tStartMs": 1125570,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "뭐 이렇게 얘기하는데"
    } ]
  }, {
    "tStartMs": 1126820,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "그게 음료가 아니라"
    } ]
  }, {
    "tStartMs": 1128250,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "아 답답하네 답답해"
    } ]
  }, {
    "tStartMs": 1129760,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "그걸 어떻게 먹여줄 수도 없고"
    } ]
  }, {
    "tStartMs": 1131490,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "먹어보면 알아 먹고"
    } ]
  }, {
    "tStartMs": 1132680,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "그 다음날 아침에 땀 한번 쫙 빼면"
    } ]
  }, {
    "tStartMs": 1134520,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "야 땀이 미끌미끌하다"
    } ]
  }, {
    "tStartMs": 1136070,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "그거 한번 느껴보면 장난 아닌데"
    } ]
  }, {
    "tStartMs": 1138080,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "이거를 잘 이해를 못한다는 거죠"
    } ]
  }, {
    "tStartMs": 1140700,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "호주 같은 경우에는"
    } ]
  }, {
    "tStartMs": 1141520,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "자국민들이 먹지 않고"
    } ]
  }, {
    "tStartMs": 1142770,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "거의 90배 수출하기 때문에"
    } ]
  }, {
    "tStartMs": 1144530,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "주요 시장 관리를 많이 한대요"
    } ]
  }, {
    "tStartMs": 1146520,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "우리나라가 요즘에 수입을 많이 하잖아요"
    } ]
  }, {
    "tStartMs": 1148150,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "한국이 관찰을 많이 한다 그럽니다"
    } ]
  }, {
    "tStartMs": 1150430,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "유심히 관찰한다"
    } ]
  }, {
    "tStartMs": 1152000,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "거의 만 톤 가까이 수입을 하니까"
    } ]
  }, {
    "tStartMs": 1153250,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "갑자기 다섯 배, 여섯 배"
    } ]
  }, {
    "tStartMs": 1155010,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "얘들은 뭘로 먹나?"
    } ]
  }, {
    "tStartMs": 1155810,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "우리가 그걸 수출해야지 보니까"
    } ]
  }, {
    "tStartMs": 1157640,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "흑염소를 즙으로 짜먹는다"
    } ]
  }, {
    "tStartMs": 1160010,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "그 말을 듣고"
    } ]
  }, {
    "tStartMs": 1160720,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "아마 처음에 깜짝 놀랐을 거예요"
    } ]
  }, {
    "tStartMs": 1162790,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "흑염소를 어떻게 즙으로 먹어요?"
    } ]
  }, {
    "tStartMs": 1164930,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "방법이 다 있는데"
    } ]
  }, {
    "tStartMs": 1166130,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "건강원 한번 데려가 보면은"
    } ]
  }, {
    "tStartMs": 1168290,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "그래서 이제 호주가 좀 당황했지만"
    } ]
  }, {
    "tStartMs": 1171040,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "지금은 굉장히 잘 안다고 하고"
    } ]
  }, {
    "tStartMs": 1173010,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "그리고 이게 농담이 아닌 게"
    } ]
  }, {
    "tStartMs": 1174690,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "호주가 가장 많이 염소를 수출하는 나라는"
    } ]
  }, {
    "tStartMs": 1177150,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "1등이 미국이고"
    } ]
  }, {
    "tStartMs": 1178350,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "2등이 어딘지 아십니까?"
    } ]
  }, {
    "tStartMs": 1179390,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "한국이에요"
    } ]
  }, {
    "tStartMs": 1181230,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "관심이 높아질 수밖에 없어"
    } ]
  }, {
    "tStartMs": 1182480,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "제가 지금까지 호들갑 떤 거 아니에요 진짜라니까"
    } ]
  }, {
    "tStartMs": 1185610,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "호들갑 떤 게 아니야"
    } ]
  }, {
    "tStartMs": 1186560,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "얘네가 흑염소 집에 관심이 있을 수밖에 없어"
    } ]
  }, {
    "tStartMs": 1189190,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "흑염소 탕을 모르면"
    } ]
  }, {
    "tStartMs": 1190390,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "호주에서 염소 농사하면 안 돼"
    } ]
  }, {
    "tStartMs": 1192500,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "호주 염소 농가들은 다 알아"
    } ]
  }, {
    "tStartMs": 1193880,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "이게 넘버 투라니까"
    } ]
  }, {
    "tStartMs": 1195120,
    "dDurationMs": 4370,
    "segs": [ {
      "utf8": "자기들이 가장 많이 수출하는 국가 2등이 어떻게 먹는지를 모를 수가 있나"
    } ]
  }, {
    "tStartMs": 1199490,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "1등은 당연히 미국이지만"
    } ]
  }, {
    "tStartMs": 1201140,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "중국보다 더 많이 수입한 게"
    } ]
  }, {
    "tStartMs": 1203190,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "최근에 한국이 많이 늘어서"
    } ]
  }, {
    "tStartMs": 1205110,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "그래서 가서 보세요"
    } ]
  }, {
    "tStartMs": 1206200,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "이런 글자가 나와요"
    } ]
  }, {
    "tStartMs": 1207580,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "삼복이 뭐예요? 복날 복날"
    } ]
  }, {
    "tStartMs": 1211750,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "복날에 왜 염소를 많이 먹어요?"
    } ]
  }, {
    "tStartMs": 1213820,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "땡스기빙데인가? 칠면조처럼?"
    } ]
  }, {
    "tStartMs": 1216770,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "복날 염소탕"
    } ]
  }, {
    "tStartMs": 1218930,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "이렇게 씁니다"
    } ]
  }, {
    "tStartMs": 1221160,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "제가 이거 그냥 적은 거 아니에요"
    } ]
  }, {
    "tStartMs": 1222250,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "거기에 나온 말 다 적은 겁니다"
    } ]
  }, {
    "tStartMs": 1223840,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "다 지금 호주가 열심히"
    } ]
  }, {
    "tStartMs": 1225310,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "한국의 염소 문화를 지금 공부하고 있다"
    } ]
  }, {
    "tStartMs": 1227830,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "그래야 너희들도 살아남을 수 있는 거야"
    } ]
  }, {
    "tStartMs": 1229790,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "복날에 같이 땀 한 번 쫙 빼고"
    } ]
  }, {
    "tStartMs": 1231770,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "한 번 먹어봐야"
    } ]
  }, {
    "tStartMs": 1233010,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "매우 자세히 분석하고 있다고 합니다"
    } ]
  }, {
    "tStartMs": 1235460,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "그래서 아직까지는 호주가"
    } ]
  }, {
    "tStartMs": 1237670,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "그래도 우리한테 수입 출한 지가 많이 안 돼서"
    } ]
  }, {
    "tStartMs": 1239710,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "잘 모를 테니까"
    } ]
  }, {
    "tStartMs": 1240830,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "고기로 싸우면"
    } ]
  }, {
    "tStartMs": 1241700,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "제가 보기에는 우리나라는 답이 없는 것 같아"
    } ]
  }, {
    "tStartMs": 1243940,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "무슨 야생에 풀어놓고 키우고"
    } ]
  }, {
    "tStartMs": 1245570,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "야생 염소 잡아다가 고기를 얼려갖고 판다는 나라에서"
    } ]
  }, {
    "tStartMs": 1249200,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "이건 힘들 것 같고"
    } ]
  }, {
    "tStartMs": 1250530,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "건강식, 보양식 아직 모를 때"
    } ]
  }, {
    "tStartMs": 1252690,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "이걸 조금 고급화시켜서"
    } ]
  }, {
    "tStartMs": 1254240,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "사회적 격렬이 있지 않을까 생각을 합니다"
    } ]
  }, {
    "tStartMs": 1256380,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "이쯤에서 얘기는 다 끝났는데"
    } ]
  }, {
    "tStartMs": 1258490,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "제가 도저히 안 할 수 없는"
    } ]
  }, {
    "tStartMs": 1259770,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "곁다리 얘기가 있어서 하나 가져왔습니다"
    } ]
  }, {
    "tStartMs": 1262030,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "슈카월드 이거 안 할 수 없잖아요"
    } ]
  }, {
    "tStartMs": 1263760,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "그러면 궁금증이 들지 않습니까?"
    } ]
  }, {
    "tStartMs": 1265640,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "슈카월드를 오래 봤던 분이라면"
    } ]
  }, {
    "tStartMs": 1267310,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "이 질문이 안 나올 수가 없어요"
    } ]
  }, {
    "tStartMs": 1268800,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "무슨 질문이냐?"
    } ]
  }, {
    "tStartMs": 1270170,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "염소는 소냐?"
    } ]
  }, {
    "tStartMs": 1271710,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "자, 이거 어려운 문제입니다"
    } ]
  }, {
    "tStartMs": 1275010,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "염소는 소냐? 염소"
    } ]
  }, {
    "tStartMs": 1278170,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "염마 아니잖아요"
    } ]
  }, {
    "tStartMs": 1279720,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "염말 아니라니까"
    } ]
  }, {
    "tStartMs": 1280990,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "염소는 소냐?"
    } ]
  }, {
    "tStartMs": 1283390,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "우는 것도 비슷해"
    } ]
  }, {
    "tStartMs": 1284160,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "음머"
    } ]
  }, {
    "tStartMs": 1285470,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "음메니까"
    } ]
  }, {
    "tStartMs": 1286820,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "음 자 차이가 있는 거죠"
    } ]
  }, {
    "tStartMs": 1288030,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "음 자만 넣으면 비슷합니다"
    } ]
  }, {
    "tStartMs": 1289860,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "비슷하기 때문에"
    } ]
  }, {
    "tStartMs": 1290860,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "염소는 소냐"
    } ]
  }, {
    "tStartMs": 1293280,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "제가 이거 하기 위해서 빌드업 한 거예요"
    } ]
  }, {
    "tStartMs": 1295650,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "주요 주제는 이겁니다"
    } ]
  }, {
    "tStartMs": 1297890,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "앞에는 대충 들으시면 돼요"
    } ]
  }, {
    "tStartMs": 1300050,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "염소는 소냐"
    } ]
  }, {
    "tStartMs": 1301500,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "아닙니까?"
    } ]
  }, {
    "tStartMs": 1302400,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "아 이거 맞히기 어려워 힌트드리겠습니다"
    } ]
  }, {
    "tStartMs": 1304400,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "조선시대에는 염소를 뭐라고 불렀냐면"
    } ]
  }, {
    "tStartMs": 1306620,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "염우라고 불렀다고 합니다"
    } ]
  }, {
    "tStartMs": 1308930,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "수염 있는 소"
    } ]
  }, {
    "tStartMs": 1309760,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "수염 있죠"
    } ]
  }, {
    "tStartMs": 1310780,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "조선시대에는 염우 소라고 불렀어요"
    } ]
  }, {
    "tStartMs": 1313520,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "염이 구렛나루시죠"
    } ]
  }, {
    "tStartMs": 1314970,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "자 그러면 어떻습니까?"
    } ]
  }, {
    "tStartMs": 1316970,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "염소는 소냐?"
    } ]
  }, {
    "tStartMs": 1317660,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "힌트까지 드렸어요 아니다"
    } ]
  }, {
    "tStartMs": 1320130,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "아니다 1번"
    } ]
  }, {
    "tStartMs": 1321620,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "노우 1번"
    } ]
  }, {
    "tStartMs": 1322480,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "맞다 2번"
    } ]
  }, {
    "tStartMs": 1323550,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "이건 노우고 2번은 예스입니다"
    } ]
  }, {
    "tStartMs": 1325760,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "한번 볼까요?"
    } ]
  }, {
    "tStartMs": 1326980,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "노우가 아니다 1번"
    } ]
  }, {
    "tStartMs": 1328720,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "맞다 2번"
    } ]
  }, {
    "tStartMs": 1330220,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "나를 뭘로 보고"
    } ]
  }, {
    "tStartMs": 1332540,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "이런 문제를 내냐?"
    } ]
  }, {
    "tStartMs": 1333320,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "당연히 아니다"
    } ]
  }, {
    "tStartMs": 1334040,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "압도적인 1번이네요 대단하세요"
    } ]
  }, {
    "tStartMs": 1337330,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "역시 정답은 놀랍게도"
    } ]
  }, {
    "tStartMs": 1340200,
    "dDurationMs": 5910,
    "segs": [ {
      "utf8": "염소는 소과 동물입니다 염소"
    } ]
  }, {
    "tStartMs": 1346110,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "정답을 알려줘도 써있잖아요 써있어"
    } ]
  }, {
    "tStartMs": 1348640,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "아니 그런 수능 볼 때"
    } ]
  }, {
    "tStartMs": 1350000,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "문제를 잘 읽어요"
    } ]
  }, {
    "tStartMs": 1350820,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "문제 답이 있다니까"
    } ]
  }, {
    "tStartMs": 1352310,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "문제를 다 읽으면 반은 맞춰 염소 써있네"
    } ]
  }, {
    "tStartMs": 1356690,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "여기 소라고 써있잖아요 소라고"
    } ]
  }, {
    "tStartMs": 1357780,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "아니 항상 선생님이 그렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 1360120,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "아니 어떻게 너는 써있는데 틀리냐"
    } ]
  }, {
    "tStartMs": 1362390,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "아니 염소 우제목입니다"
    } ]
  }, {
    "tStartMs": 1365140,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "소과에 들어가요"
    } ]
  }, {
    "tStartMs": 1366090,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "염소 들소 물소 소과"
    } ]
  }, {
    "tStartMs": 1368450,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "소 소 소 소"
    } ]
  }, {
    "tStartMs": 1369700,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "소잖아"
    } ]
  }, {
    "tStartMs": 1370720,
    "dDurationMs": 540,
    "segs": [ {
      "utf8": "소네?"
    } ]
  }, {
    "tStartMs": 1371260,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "그래서 염소를 사실은"
    } ]
  }, {
    "tStartMs": 1373490,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "눈썹에 있는 분들은 뭐만 봐도 맞힐 수 있었냐"
    } ]
  }, {
    "tStartMs": 1375570,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "요거만 봐도 맞힐 수 있어요"
    } ]
  }, {
    "tStartMs": 1377170,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "발굽이 어떻게 돼 있어요?"
    } ]
  }, {
    "tStartMs": 1378610,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "갈라져 있죠"
    } ]
  }, {
    "tStartMs": 1379880,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "말은 어떻게 돼요 발굽이?"
    } ]
  }, {
    "tStartMs": 1381280,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "하나잖아 그래서 우제목, 기제목 그러죠"
    } ]
  }, {
    "tStartMs": 1383100,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "우제목이 발굽이 갈라진 거"
    } ]
  }, {
    "tStartMs": 1384740,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "기제목은 하나인 거죠"
    } ]
  }, {
    "tStartMs": 1385560,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "그래서 소와 마찬가지로"
    } ]
  }, {
    "tStartMs": 1387360,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "염소의 발도 발굽이 두 개입니다"
    } ]
  }, {
    "tStartMs": 1389800,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "기제목은 아까 발굽이 하나라고 그랬죠"
    } ]
  }, {
    "tStartMs": 1391840,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "말코프스는 하나예요"
    } ]
  }, {
    "tStartMs": 1393170,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "말은 이렇게 해서 하나잖아"
    } ]
  }, {
    "tStartMs": 1394910,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "하나 얘는 두 개입니다"
    } ]
  }, {
    "tStartMs": 1396740,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "자 그래서 소라고 할 수 있죠"
    } ]
  }, {
    "tStartMs": 1398800,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "자 정리를 해보도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 1400400,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "자 코뿔소는 자 소는 우제목이고"
    } ]
  }, {
    "tStartMs": 1402850,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "말은 기제목 물론 소 말 정확히 하면 안 되지만"
    } ]
  }, {
    "tStartMs": 1405490,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "자 우제목, 기제목 하면 어려우니까"
    } ]
  }, {
    "tStartMs": 1406500,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "대충 이렇게 쓸게요"
    } ]
  }, {
    "tStartMs": 1407100,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "소과 말과 자 코뿔소는 소가 아니고"
    } ]
  }, {
    "tStartMs": 1409890,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "하마는 말이 아니죠"
    } ]
  }, {
    "tStartMs": 1411920,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "염소는 소입니다"
    } ]
  }, {
    "tStartMs": 1413570,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "야 이거 수능에 내면 기가 막히네"
    } ]
  }, {
    "tStartMs": 1416890,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "코뿔소 아"
    } ]
  }, {
    "tStartMs": 1417990,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "슈카형이 써있는 거 맞다 그랬다"
    } ]
  }, {
    "tStartMs": 1419910,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "그럼 소과 우제목 틀렸습니다"
    } ]
  }, {
    "tStartMs": 1422250,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "요거 말과 기제목 하마 말인가?"
    } ]
  }, {
    "tStartMs": 1425540,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "말아닙니다"
    } ]
  }, {
    "tStartMs": 1426670,
    "dDurationMs": 520,
    "segs": [ {
      "utf8": "염소?"
    } ]
  }, {
    "tStartMs": 1427190,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "아이 그럼 소 아니구만"
    } ]
  }, {
    "tStartMs": 1428840,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "소입니다"
    } ]
  }, {
    "tStartMs": 1429630,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "소기 때문에 소과 소과"
    } ]
  }, {
    "tStartMs": 1431810,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "아 쉬워요"
    } ]
  }, {
    "tStartMs": 1432450,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "자 이렇게 이해하시면 되고요"
    } ]
  }, {
    "tStartMs": 1435120,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "물론 그렇게 얘기하면"
    } ]
  }, {
    "tStartMs": 1436020,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "뭐 이렇게 과학적이지 않고"
    } ]
  }, {
    "tStartMs": 1439330,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "표현이 소다 말이다"
    } ]
  }, {
    "tStartMs": 1440510,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "그래서 그렇지 뭐 과로 보시면 됩니다"
    } ]
  }, {
    "tStartMs": 1442720,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "대충 여기가 소과라고 하는데"
    } ]
  }, {
    "tStartMs": 1444900,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "그 아래 소과가 있고 양과가 있어요"
    } ]
  }, {
    "tStartMs": 1447370,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "크게 이렇게 이렇게 있다고 합니다"
    } ]
  }, {
    "tStartMs": 1448810,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "저도 이번에 알았어요"
    } ]
  }, {
    "tStartMs": 1449690,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "그래서 염소와 양이 이쪽에 있고"
    } ]
  }, {
    "tStartMs": 1451710,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "소가 이쪽에 있습니다"
    } ]
  }, {
    "tStartMs": 1452410,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "그러니까 넓게 보면"
    } ]
  }, {
    "tStartMs": 1453940,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "이제 같다는 거죠"
    } ]
  }, {
    "tStartMs": 1455000,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "발굽이 두 개의 대들"
    } ]
  }, {
    "tStartMs": 1456110,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "그렇기 때문에 굳이 얘기하자면"
    } ]
  }, {
    "tStartMs": 1457850,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "염소는 소보다는"
    } ]
  }, {
    "tStartMs": 1459630,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "양에 가까운 동물을 많이 얘기하죠"
    } ]
  }, {
    "tStartMs": 1461650,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "속과, 양과"
    } ]
  }, {
    "tStartMs": 1463080,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "생애 같은 거 비슷하잖아요"
    } ]
  }, {
    "tStartMs": 1464210,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "양이 좀 더 가깝긴 하다"
    } ]
  }, {
    "tStartMs": 1466870,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "그런데 방금 전에"
    } ]
  }, {
    "tStartMs": 1467850,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "제가 잠깐 보여드린 대로"
    } ]
  }, {
    "tStartMs": 1468900,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "눈썰미 좋은 분들 아마 그걸 보셨을 거예요"
    } ]
  }, {
    "tStartMs": 1471660,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "아니 다 좋은데"
    } ]
  }, {
    "tStartMs": 1472870,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "염소, 양, 소 다 좋은데"
    } ]
  }, {
    "tStartMs": 1474900,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "이쪽에 커다랗게 속과라고 한다고 하니까"
    } ]
  }, {
    "tStartMs": 1477720,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "모래는 뭐냐"
    } ]
  }, {
    "tStartMs": 1479620,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "고래는 뭐냐?"
    } ]
  }, {
    "tStartMs": 1480620,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "고래가 왜 여기 있냐?"
    } ]
  }, {
    "tStartMs": 1482160,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "아니 무슨 염소, 양, 기린 나타나는데"
    } ]
  }, {
    "tStartMs": 1484070,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "고래가 왜 나와 있냐?"
    } ]
  }, {
    "tStartMs": 1485210,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "고래?"
    } ]
  }, {
    "tStartMs": 1486300,
    "dDurationMs": 4330,
    "segs": [ {
      "utf8": "그거는 고래가 우제목과 관련이 있어 그렇습니다"
    } ]
  }, {
    "tStartMs": 1490630,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "고래는 소와 가까워요"
    } ]
  }, {
    "tStartMs": 1492740,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "특히 하마와 가깝다고 그럽니다"
    } ]
  }, {
    "tStartMs": 1495720,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "그래서 앞으로는 고래가 아니라 고소"
    } ]
  }, {
    "tStartMs": 1498940,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "고소 고소하지요?"
    } ]
  }, {
    "tStartMs": 1500730,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "하마가 아니라 하소"
    } ]
  }, {
    "tStartMs": 1502540,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "뭐 이렇게 부르는 게"
    } ]
  }, {
    "tStartMs": 1503410,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "조금 더 이해를 쉬울 수 있어요"
    } ]
  }, {
    "tStartMs": 1505860,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "앞으로 물에 다니는 소"
    } ]
  }, {
    "tStartMs": 1508130,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "고소 고소 아이고 좋습니다"
    } ]
  }, {
    "tStartMs": 1510580,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "좋은 거 배웠죠?"
    } ]
  }, {
    "tStartMs": 1511340,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "그래서 고래는 우정과 관련이 있다"
    } ]
  }, {
    "tStartMs": 1513760,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "말과 관련이 있지 않고"
    } ]
  }, {
    "tStartMs": 1515130,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "소와 조금 더 관련이 있는 놈"
    } ]
  }, {
    "tStartMs": 1517220,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "특히 하마와 올해들어 5천만 년 전에"
    } ]
  }, {
    "tStartMs": 1519640,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "조상아 같다 그럽니다"
    } ]
  }, {
    "tStartMs": 1520830,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "둘 다 하소 고소 이렇게 부르면 됩니다"
    } ]
  }, {
    "tStartMs": 1523730,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "연결하면 고소하소 그렇죠?"
    } ]
  }, {
    "tStartMs": 1525820,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "이렇게 외우면 돼요 고소하소"
    } ]
  }, {
    "tStartMs": 1527520,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "그래서 여러분들이 고소하시다 보면"
    } ]
  }, {
    "tStartMs": 1530000,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "생물 공부도 할 수 있고요"
    } ]
  }, {
    "tStartMs": 1531440,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "이렇게 외우는 거죠"
    } ]
  }, {
    "tStartMs": 1532420,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "그래야 수능을 잘 볼 수 있어요"
    } ]
  }, {
    "tStartMs": 1534290,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "그러면서 또 드는 궁금증이 있죠?"
    } ]
  }, {
    "tStartMs": 1536260,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "양과 염소는 그럼 교배가 가능하냐"
    } ]
  }, {
    "tStartMs": 1538910,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "서로 다른 종입니다"
    } ]
  }, {
    "tStartMs": 1540420,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "이종관이긴 한데"
    } ]
  }, {
    "tStartMs": 1541500,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "비슷하다며 친척관이라며"
    } ]
  }, {
    "tStartMs": 1542960,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "교배가 가능하냐"
    } ]
  }, {
    "tStartMs": 1544150,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "불가능합니다 일반적으로는"
    } ]
  }, {
    "tStartMs": 1545410,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "염색체 숫자도 달라요"
    } ]
  }, {
    "tStartMs": 1546980,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "임신을 할 수도 있대"
    } ]
  }, {
    "tStartMs": 1549020,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "대부분 사산됩니다"
    } ]
  }, {
    "tStartMs": 1550710,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "그런데 하다보면 간혹 새끼가 태어나기도 한답니다"
    } ]
  }, {
    "tStartMs": 1555810,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "그래서 양과 염소의 잡종"
    } ]
  }, {
    "tStartMs": 1558490,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "Goat와 Sheep의 잡종"
    } ]
  }, {
    "tStartMs": 1560540,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "그래서 Geep"
    } ]
  }, {
    "tStartMs": 1562340,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "Geep이라고 부른대요"
    } ]
  }, {
    "tStartMs": 1563520,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "고트와 쉽의 잡종에서 깁"
    } ]
  }, {
    "tStartMs": 1566130,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "이름을 참 잘 지은 것 같아요"
    } ]
  }, {
    "tStartMs": 1568030,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "고트 쉽이니까 깁"
    } ]
  }, {
    "tStartMs": 1570580,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "잘못 졌으면 쉽을 하면 팁"
    } ]
  }, {
    "tStartMs": 1574210,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "이렇게 되는 거죠"
    } ]
  }, {
    "tStartMs": 1574830,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "팁 이렇게 될 수도 있고"
    } ]
  }, {
    "tStartMs": 1576650,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "대부분 생산력이 없고"
    } ]
  }, {
    "tStartMs": 1578000,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "사실상 없는 종이라고 하는데"
    } ]
  }, {
    "tStartMs": 1579830,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "정말 가끔 정말 가끔 나왔다는 말이 있대요"
    } ]
  }, {
    "tStartMs": 1583190,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "대부분 생산력이 없습니다"
    } ]
  }, {
    "tStartMs": 1585080,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "그러면 다 끝났는데"
    } ]
  }, {
    "tStartMs": 1586350,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "마지막 문제 또 하나 드리도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 1588920,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "산양 있죠 산양"
    } ]
  }, {
    "tStartMs": 1590460,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "산양은 양입니까? 염소입니까?"
    } ]
  }, {
    "tStartMs": 1593200,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "요거 예 야 난이도 있습니다 산양"
    } ]
  }, {
    "tStartMs": 1596640,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "야 쉽다"
    } ]
  }, {
    "tStartMs": 1597460,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "문제의 답이"
    } ]
  }, {
    "tStartMs": 1598160,
    "dDurationMs": 4310,
    "segs": [ {
      "utf8": "산양은 양입니까? 염소입니까?"
    } ]
  }, {
    "tStartMs": 1602470,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "산에 있는 양이니까 양 아니냐?"
    } ]
  }, {
    "tStartMs": 1605330,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "그런 식으로 치면"
    } ]
  }, {
    "tStartMs": 1606070,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "코뿔소는 소가 아니었으니까 염소일 것이다"
    } ]
  }, {
    "tStartMs": 1608840,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "아 이거 어렵습니다"
    } ]
  }, {
    "tStartMs": 1611300,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "참고로 산양은 양도 염소도 아닙니다"
    } ]
  }, {
    "tStartMs": 1614080,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "이게 우리가 이름을 산양으로 지어서 그래요"
    } ]
  }, {
    "tStartMs": 1617180,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "goral이죠 goral"
    } ]
  }, {
    "tStartMs": 1618040,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "그러니까 산양이에요"
    } ]
  }, {
    "tStartMs": 1620000,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "그게 뭔 소리냐?"
    } ]
  }, {
    "tStartMs": 1620620,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "아니, 이게 양과 염소가 아니라니까"
    } ]
  }, {
    "tStartMs": 1623020,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "이게 그냥 산양이야"
    } ]
  }, {
    "tStartMs": 1624560,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "우리나라말로 산양이어서 그런데"
    } ]
  }, {
    "tStartMs": 1626340,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "고롤, 이렇게 하면 고롤인 거야"
    } ]
  }, {
    "tStartMs": 1628930,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "우리가 얘를 산양으로 부르는 거야"
    } ]
  }, {
    "tStartMs": 1631890,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "이번에 알아보니까"
    } ]
  }, {
    "tStartMs": 1632930,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "한국에서만 얘를 양으로 부른다고 합니다"
    } ]
  }, {
    "tStartMs": 1635420,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "저도 이번에 알았어요 그래?"
    } ]
  }, {
    "tStartMs": 1636860,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "우리나라에서만 얘를 산에 있는 양으로 부르는구먼"
    } ]
  }, {
    "tStartMs": 1639880,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "만약에 우리가 얘를 산소 불렀으면"
    } ]
  }, {
    "tStartMs": 1642670,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "산소 같은 동물일 수 있었어요"
    } ]
  }, {
    "tStartMs": 1644720,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "거의 이영애 씨가 떠오르는 동물일 수 있었죠"
    } ]
  }, {
    "tStartMs": 1646290,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "산돼지 그러면?"
    } ]
  }, {
    "tStartMs": 1648100,
    "dDurationMs": 570,
    "segs": [ {
      "utf8": "돼지일 수도 있어"
    } ]
  }, {
    "tStartMs": 1648670,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "근데 우리는 그걸 사냥 이렇게 불렀다는 거고"
    } ]
  }, {
    "tStartMs": 1651470,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "양도 아니고 염소도 아닙니다"
    } ]
  }, {
    "tStartMs": 1654210,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "그거는 동물학적 분류고"
    } ]
  }, {
    "tStartMs": 1655940,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "동양적인 관점에서는"
    } ]
  }, {
    "tStartMs": 1657580,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "염소나 양이나 옛날에는 다 양이었다고 합니다"
    } ]
  }, {
    "tStartMs": 1660760,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "비스무리하게 생겼네"
    } ]
  }, {
    "tStartMs": 1662150,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "지금이야 염색체 따지고"
    } ]
  }, {
    "tStartMs": 1663490,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "무슨 발굽 개수 따지고"
    } ]
  }, {
    "tStartMs": 1664660,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "그런 거 하는 거지"
    } ]
  }, {
    "tStartMs": 1665600,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "옛날에 비스무리하게 생기면"
    } ]
  }, {
    "tStartMs": 1666910,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "다 양"
    } ]
  }, {
    "tStartMs": 1667960,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "이런 양은 없었죠"
    } ]
  }, {
    "tStartMs": 1668830,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "옛날에 동양에"
    } ]
  }, {
    "tStartMs": 1669770,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "이건 나중에 들어온 거고"
    } ]
  }, {
    "tStartMs": 1670930,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "몇 양이 그래서 얘가 양으로 들어온 다음에"
    } ]
  }, {
    "tStartMs": 1674200,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "기존의 사냥 같은 애들을 뭐 따르게 불렀다고 하는데"
    } ]
  }, {
    "tStartMs": 1678000,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "그리고 또 이것도 마지막으로 서구에서는"
    } ]
  }, {
    "tStartMs": 1680330,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "양과 염소의 이미지가 완전히 다르죠"
    } ]
  }, {
    "tStartMs": 1682550,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "놀랍게도 가까운 친척인데"
    } ]
  }, {
    "tStartMs": 1684510,
    "dDurationMs": 4490,
    "segs": [ {
      "utf8": "양 그러면 왠지 순종적인 어린 양 하느님의 자식"
    } ]
  }, {
    "tStartMs": 1689000,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "어린 양 신자"
    } ]
  }, {
    "tStartMs": 1690690,
    "dDurationMs": 570,
    "segs": [ {
      "utf8": "뭐 이런 거고"
    } ]
  }, {
    "tStartMs": 1691260,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "염소 그러면 왠지 좀 불순종하는 죄인"
    } ]
  }, {
    "tStartMs": 1694160,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "심지어 악마의 상징"
    } ]
  }, {
    "tStartMs": 1695510,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "이런 걸로 많이 쓰이죠"
    } ]
  }, {
    "tStartMs": 1696630,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "염소 입장에선 너무나 억울하지 않을까 생각합니다"
    } ]
  }, {
    "tStartMs": 1698720,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "둘이 비슷한 그건데"
    } ]
  }, {
    "tStartMs": 1700610,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "일단 양 하면은"
    } ]
  }, {
    "tStartMs": 1701670,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "우리가 흔히 많이 하는"
    } ]
  }, {
    "tStartMs": 1702710,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "예수 그리스도의"
    } ]
  }, {
    "tStartMs": 1703680,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "어린 양 어린 양을 구하기 위해서"
    } ]
  }, {
    "tStartMs": 1706640,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "예수 그리스도가 광야에 가서 찾아오고"
    } ]
  }, {
    "tStartMs": 1708580,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "마지막 남은 양 한 마리까지 데려오고 이러시잖아요"
    } ]
  }, {
    "tStartMs": 1711520,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "순종적이고 구원받고"
    } ]
  }, {
    "tStartMs": 1713000,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "갸냘프고 쓰다듬어주고"
    } ]
  }, {
    "tStartMs": 1714460,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "죄없고 희생양이고 하는데"
    } ]
  }, {
    "tStartMs": 1717420,
    "dDurationMs": 5610,
    "segs": [ {
      "utf8": "비슷한 종인 염소는 악마, 우상의 상진, 바포메트,"
    } ]
  }, {
    "tStartMs": 1723030,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "만화에서 보면"
    } ]
  }, {
    "tStartMs": 1724140,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "정욕의 화신 이런 걸로 주로 등장을 해요"
    } ]
  }, {
    "tStartMs": 1727090,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "머리에 이상한 벌받고 딱 하고"
    } ]
  }, {
    "tStartMs": 1729090,
    "dDurationMs": 3770,
    "segs": [ {
      "utf8": "이래갖고 괴물 악마 이쪽으로 등장을 하니까 신기하죠"
    } ]
  }, {
    "tStartMs": 1732860,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "그래서 아마 개인적으로는 역시 그 동물들도"
    } ]
  }, {
    "tStartMs": 1735980,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "조금 예쁘게 생겨야 된다"
    } ]
  }, {
    "tStartMs": 1737840,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "이 외모가 염소는 양과 동물들이 눈이다"
    } ]
  }, {
    "tStartMs": 1740630,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "이렇게는 한데"
    } ]
  }, {
    "tStartMs": 1741660,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "뭔가 조금 미안한데"
    } ]
  }, {
    "tStartMs": 1743900,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "좀 그렇긴 해"
    } ]
  }, {
    "tStartMs": 1745020,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "그렇긴 해"
    } ]
  }, {
    "tStartMs": 1745710,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "우리 염소하고 비교해 봤을 때"
    } ]
  }, {
    "tStartMs": 1747920,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "조금만 더 이쁘게 생겼으면"
    } ]
  }, {
    "tStartMs": 1749960,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "우리 펜다 아저씨들처럼 잘 먹고 자랄 수 있었는데"
    } ]
  }, {
    "tStartMs": 1752820,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "아마 좀 개인적으로 여행을 미쳤지 않았을까"
    } ]
  }, {
    "tStartMs": 1755780,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "물론 주로 원인은 다르게 있겠지만"
    } ]
  }, {
    "tStartMs": 1757490,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "생각을 합니다"
    } ]
  } ]
}

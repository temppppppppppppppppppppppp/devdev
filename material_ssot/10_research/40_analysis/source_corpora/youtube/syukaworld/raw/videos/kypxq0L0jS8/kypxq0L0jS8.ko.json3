{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 7580,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "또 오늘의 메인 주제 중에 하나"
    } ]
  }, {
    "tStartMs": 8920,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "이건 얘기 안 할 수 없죠"
    } ]
  }, {
    "tStartMs": 9810,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "약간 걱정돼서 갖고 온 주제인데"
    } ]
  }, {
    "tStartMs": 11360,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "자 이란 전쟁과 유가"
    } ]
  }, {
    "tStartMs": 13450,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "석유 가격 얘기를 지금 안 할 수 없습니다"
    } ]
  }, {
    "tStartMs": 15820,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "물론 내일이면 또 어떻게 될지 몰라요"
    } ]
  }, {
    "tStartMs": 18180,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "정말 이번 전쟁처럼"
    } ]
  }, {
    "tStartMs": 19810,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "손바닥 뒤집듯이"
    } ]
  }, {
    "tStartMs": 21020,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "언제 끝날지 모르는 전쟁은"
    } ]
  }, {
    "tStartMs": 22470,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "처음 본 것 같아요"
    } ]
  }, {
    "tStartMs": 23860,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "내일 끝날 수도 있어요"
    } ]
  }, {
    "tStartMs": 24880,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "왜냐하면 트럼프 대통령이"
    } ]
  }, {
    "tStartMs": 26160,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "우리가 이겼다! 끝!"
    } ]
  }, {
    "tStartMs": 27200,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "하면 내일 끝나는 거야"
    } ]
  }, {
    "tStartMs": 28390,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "요즘 분위기는 그렇던데"
    } ]
  }, {
    "tStartMs": 29840,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "이란이 우리 아직 항복 안 했는데요"
    } ]
  }, {
    "tStartMs": 31820,
    "dDurationMs": 510,
    "segs": [ {
      "utf8": "아, 됐어"
    } ]
  }, {
    "tStartMs": 32330,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "우리가 이겼어 끝! 하고"
    } ]
  }, {
    "tStartMs": 33360,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "미군 빼면 전쟁 끝"
    } ]
  }, {
    "tStartMs": 34960,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "그러면 이란은"
    } ]
  }, {
    "tStartMs": 35910,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "무기 들고 있다가 뭐야?"
    } ]
  }, {
    "tStartMs": 37500,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "집에 갔잖아"
    } ]
  }, {
    "tStartMs": 38360,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "그러면 끝났냐?"
    } ]
  }, {
    "tStartMs": 39460,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "야, 우리도 안 졌는데?"
    } ]
  }, {
    "tStartMs": 41140,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "그러니까 너희도 안 졌고"
    } ]
  }, {
    "tStartMs": 42630,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "미국은 이겼고"
    } ]
  }, {
    "tStartMs": 43630,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "자, 그래서"
    } ]
  }, {
    "tStartMs": 45100,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "이렇게 전쟁이 끝날 수도 있기 때문에"
    } ]
  }, {
    "tStartMs": 47530,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "정말 알기 힘든 게"
    } ]
  }, {
    "tStartMs": 48700,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "이란 전쟁이라고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 50130,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "내용을 좀 보면"
    } ]
  }, {
    "tStartMs": 51310,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "미국 이란 전쟁이 일어난 지도"
    } ]
  }, {
    "tStartMs": 52980,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "벌써 3주째가 되고 있습니다"
    } ]
  }, {
    "tStartMs": 55580,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "시간 빠르죠"
    } ]
  }, {
    "tStartMs": 56470,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "2월 28일이니까"
    } ]
  }, {
    "tStartMs": 57860,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "지금 이 방송이 3월 15일인데"
    } ]
  }, {
    "tStartMs": 59730,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "이미 2주가 훨씬 넘었고"
    } ]
  }, {
    "tStartMs": 61590,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "3주차로 들어가는 거죠"
    } ]
  }, {
    "tStartMs": 63390,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "벌써 뭐 며칠 내로 끝날 거라는"
    } ]
  }, {
    "tStartMs": 65910,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "그런 기대감은 이미 많이 사라진 것 같고"
    } ]
  }, {
    "tStartMs": 68110,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "물론 내일이라도 끝날 수 있지만"
    } ]
  }, {
    "tStartMs": 69950,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "장기화 우려까지 나오고 있죠"
    } ]
  }, {
    "tStartMs": 71640,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "전쟁이 이렇게 길어지면서"
    } ]
  }, {
    "tStartMs": 73040,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "일단 시장의 최대 관심사는 승패도 승패지만"
    } ]
  }, {
    "tStartMs": 75550,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "역시 호르무즈 해협으로 몰리고 있습니다"
    } ]
  }, {
    "tStartMs": 78110,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "일단 우리나라부터 그렇죠"
    } ]
  }, {
    "tStartMs": 79690,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "전쟁의 승패 이런 걸 떠나서"
    } ]
  }, {
    "tStartMs": 81630,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "호르무즈 해협 운송이 중단이 되면"
    } ]
  }, {
    "tStartMs": 84160,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "원유 수송이 어렵잖아요"
    } ]
  }, {
    "tStartMs": 85920,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "이미 3주 차래"
    } ]
  }, {
    "tStartMs": 87230,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "지난 2주간은"
    } ]
  }, {
    "tStartMs": 88150,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "호르무즈 해협의 운송이"
    } ]
  }, {
    "tStartMs": 89050,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "사실상 중단이 돼 있었죠"
    } ]
  }, {
    "tStartMs": 91000,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "그리고 해협만 막힌 게 아니라"
    } ]
  }, {
    "tStartMs": 93070,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "전쟁이 길어지니까"
    } ]
  }, {
    "tStartMs": 94390,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "이 해협 부근에 있는 정유시설들도"
    } ]
  }, {
    "tStartMs": 96700,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "서로 드론을 날리면서"
    } ]
  }, {
    "tStartMs": 98190,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "폭격을 하고 있습니다"
    } ]
  }, {
    "tStartMs": 99960,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "지나가던 유조선들도 공격을 받았죠"
    } ]
  }, {
    "tStartMs": 102080,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "16척인가?"
    } ]
  }, {
    "tStartMs": 103710,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "17척이 지금 공격을 받았어요"
    } ]
  }, {
    "tStartMs": 105470,
    "dDurationMs": 4070,
    "segs": [ {
      "utf8": "여기 해안가에 있는 정유시설들도 피해를 보고"
    } ]
  }, {
    "tStartMs": 109540,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "유조선도 통과를 못한다"
    } ]
  }, {
    "tStartMs": 111550,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "호르무즈 해협은"
    } ]
  }, {
    "tStartMs": 112260,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "여러분들 다들 잘 아시겠지만"
    } ]
  }, {
    "tStartMs": 114120,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "전세계 원유, 휘발유, 경유의"
    } ]
  }, {
    "tStartMs": 116420,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "5분의 1이 지나가는 곳입니다"
    } ]
  }, {
    "tStartMs": 118940,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "전세계 원유 수송의"
    } ]
  }, {
    "tStartMs": 119930,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "약 5분의 1인"
    } ]
  }, {
    "tStartMs": 120490,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "2천만 배럴의 공급이"
    } ]
  }, {
    "tStartMs": 121630,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "시장에서 없어졌다고 보시면 돼요"
    } ]
  }, {
    "tStartMs": 123910,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "말이 5분의 1이지"
    } ]
  }, {
    "tStartMs": 125550,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "저기를 통과하는"
    } ]
  }, {
    "tStartMs": 126470,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "대부분의 원유들은"
    } ]
  }, {
    "tStartMs": 127720,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "아시아로 가죠"
    } ]
  }, {
    "tStartMs": 129150,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "호르무즈 해협의 방향을 봐요, 방향을"
    } ]
  }, {
    "tStartMs": 131580,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "유럽으로 간 해협이 아니잖아요"
    } ]
  }, {
    "tStartMs": 133520,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "나와서 이쪽이 아시아잖아요"
    } ]
  }, {
    "tStartMs": 135470,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "뭐 이쪽은 인도양이고"
    } ]
  }, {
    "tStartMs": 136760,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "당연히 아시아로 가는 입구라고 보면 됩니다"
    } ]
  }, {
    "tStartMs": 139550,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "여기서 나와서"
    } ]
  }, {
    "tStartMs": 140150,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "미국으로 가는 일은 잘 없겠죠"
    } ]
  }, {
    "tStartMs": 141750,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "미국이 그 먼 거를"
    } ]
  }, {
    "tStartMs": 142820,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "잘 쓰지도 않을 테고"
    } ]
  }, {
    "tStartMs": 144030,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "그러다 보니까"
    } ]
  }, {
    "tStartMs": 145030,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "대부분의 아시아 국가들이"
    } ]
  }, {
    "tStartMs": 146300,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "저 해협을 통해서"
    } ]
  }, {
    "tStartMs": 147190,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "중동상 원유와 천연가스에 의존하는데"
    } ]
  }, {
    "tStartMs": 149270,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "일본은 무려 90%를"
    } ]
  }, {
    "tStartMs": 151320,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "중동에 의존한다고 하고요"
    } ]
  }, {
    "tStartMs": 153010,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "우리도 높아요"
    } ]
  }, {
    "tStartMs": 153870,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "우리도 거의 70%에 가깝습니다"
    } ]
  }, {
    "tStartMs": 155850,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "이게 다른 중동 국가들이고"
    } ]
  }, {
    "tStartMs": 157200,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "중국은 한 50%?"
    } ]
  }, {
    "tStartMs": 158330,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "중국은 러시아 같은 데서 많이 봤죠"
    } ]
  }, {
    "tStartMs": 159950,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "아시아 국가들은 러시아가 끊겨서"
    } ]
  }, {
    "tStartMs": 161670,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "비중이 더 올라갔다고 하는데"
    } ]
  }, {
    "tStartMs": 163090,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "그러면 전쟁이 이렇게 길어지고 있는데"
    } ]
  }, {
    "tStartMs": 165820,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "우리 원유는 얼마나 남았냐"
    } ]
  }, {
    "tStartMs": 168540,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "원유 재고"
    } ]
  }, {
    "tStartMs": 169650,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "일단 국내 정유사들의"
    } ]
  }, {
    "tStartMs": 171570,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "중동산 원유 수입은"
    } ]
  }, {
    "tStartMs": 173260,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "곧 중단될 예정이라고 합니다"
    } ]
  }, {
    "tStartMs": 175090,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "이게 무슨 말이냐"
    } ]
  }, {
    "tStartMs": 176140,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "호르무즈 해협을"
    } ]
  }, {
    "tStartMs": 177050,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "마지막에 잽싸게 피해서 살았죠?"
    } ]
  }, {
    "tStartMs": 180080,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "하면서 통과한 마지막 배가"
    } ]
  }, {
    "tStartMs": 182730,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "한국에 들어오는 날이"
    } ]
  }, {
    "tStartMs": 183930,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "3월 24일에서 3월 30일 사이라고 해요"
    } ]
  }, {
    "tStartMs": 187450,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "저 날이 지나면"
    } ]
  }, {
    "tStartMs": 188360,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "그 다음 배가 없는 거죠"
    } ]
  }, {
    "tStartMs": 190060,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "해협에서 우리나라까지 이렇게 오르면"
    } ]
  }, {
    "tStartMs": 191470,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "시간이 걸릴 테니까"
    } ]
  }, {
    "tStartMs": 192690,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "마지막 배가 3월 24일"
    } ]
  }, {
    "tStartMs": 194220,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "부근에 도착을 할 것 같다"
    } ]
  }, {
    "tStartMs": 195800,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "그럼 그 뒤는 이제 없는 거예요"
    } ]
  }, {
    "tStartMs": 198020,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "새로운 원유가 안 들어오는 거죠"
    } ]
  }, {
    "tStartMs": 199490,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "호르무즈 해협으로 오는 원유는"
    } ]
  }, {
    "tStartMs": 201380,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "정유사들의 원유 재고가"
    } ]
  }, {
    "tStartMs": 202800,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "보통 4~5주를 얘기한다고 합니다"
    } ]
  }, {
    "tStartMs": 204960,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "우리나라의"
    } ]
  }, {
    "tStartMs": 205910,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "원유 비상 비축일수가 한 200일이에요"
    } ]
  }, {
    "tStartMs": 208350,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "200일이라는 거는 굉장히 아껴 쓰는 겁니다"
    } ]
  }, {
    "tStartMs": 211390,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "예를 들면 5부제도 아니죠"
    } ]
  }, {
    "tStartMs": 213550,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "짝수, 홀수제 이런 거 해야 돼요"
    } ]
  }, {
    "tStartMs": 215090,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "자동차 운영하는 걸 막고"
    } ]
  }, {
    "tStartMs": 216990,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "가급적 가로등도 안 켜고"
    } ]
  }, {
    "tStartMs": 219070,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "원유를 아끼고 아끼고"
    } ]
  }, {
    "tStartMs": 220170,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "아꼈을 때 한 200일 정도를"
    } ]
  }, {
    "tStartMs": 222480,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "예상을 한다고 해요"
    } ]
  }, {
    "tStartMs": 223900,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "200일이면 6개월은 되니까"
    } ]
  }, {
    "tStartMs": 225920,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "아직은 좀 시간이 있긴 하지만"
    } ]
  }, {
    "tStartMs": 227460,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "정유사들의 원유 재고가 4에서 5주면"
    } ]
  }, {
    "tStartMs": 229270,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "앞으로 전쟁이 2주에서 3주 정도가"
    } ]
  }, {
    "tStartMs": 232200,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "더 길어지면"
    } ]
  }, {
    "tStartMs": 233200,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "원유 재고 압박을 굉장히 강하게 느끼겠죠"
    } ]
  }, {
    "tStartMs": 235870,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "특히 요즘에 가장 많이 얘기가 되는 게"
    } ]
  }, {
    "tStartMs": 237880,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "여러분도 언론에서 많이 보셨을 텐데"
    } ]
  }, {
    "tStartMs": 239730,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "석화 산업, 석유화학 산업이"
    } ]
  }, {
    "tStartMs": 241540,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "굉장히 문제가 심각해지고 있습니다"
    } ]
  }, {
    "tStartMs": 244140,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "석유화학산업은"
    } ]
  }, {
    "tStartMs": 245410,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "라프타, 이거 다 아시죠?"
    } ]
  }, {
    "tStartMs": 247180,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "원유에서 정제한 그 액체 있잖아요"
    } ]
  }, {
    "tStartMs": 248480,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "라프타 액체"
    } ]
  }, {
    "tStartMs": 249400,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "이걸로 플라스틱도 만들고"
    } ]
  }, {
    "tStartMs": 251760,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "합성섬유도 만들고"
    } ]
  }, {
    "tStartMs": 253020,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "이렇게 산업의 쌀이라고 말하는"
    } ]
  }, {
    "tStartMs": 254740,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "녹여서 만들 수 있는"
    } ]
  }, {
    "tStartMs": 255810,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "납사 같은 거 만들잖아요"
    } ]
  }, {
    "tStartMs": 257370,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "예를 들면"
    } ]
  }, {
    "tStartMs": 258370,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "마우스도 이런 걸로 만들고"
    } ]
  }, {
    "tStartMs": 259790,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "신발로 섬유도"
    } ]
  }, {
    "tStartMs": 261480,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "플라스틱 섬유 같은 거 다 만드는"
    } ]
  }, {
    "tStartMs": 262920,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "원재료가 나프타인데"
    } ]
  }, {
    "tStartMs": 265140,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "문제는 저기가 막혀버리니까"
    } ]
  }, {
    "tStartMs": 266690,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "나프타가 들어오질 않죠"
    } ]
  }, {
    "tStartMs": 268230,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "그럼 석화가 멈춥니다"
    } ]
  }, {
    "tStartMs": 270420,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "지금 현재 국내 주요 석유화학 기업들은"
    } ]
  }, {
    "tStartMs": 272790,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "이미 공급 불가를 뜻하는"
    } ]
  }, {
    "tStartMs": 274610,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "불가항력을 선언한 기업도 있어요"
    } ]
  }, {
    "tStartMs": 277380,
    "dDurationMs": 490,
    "segs": [ {
      "utf8": "무슨 말이냐?"
    } ]
  }, {
    "tStartMs": 277870,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "계약상 100만 톤을 보내야 돼"
    } ]
  }, {
    "tStartMs": 280130,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "근데 원재료가 안 들어와"
    } ]
  }, {
    "tStartMs": 281210,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "그래서 우리는 계약을 이행하지 못하겠다"
    } ]
  }, {
    "tStartMs": 283420,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "우리는 더 이상 생산할 수 없다"
    } ]
  }, {
    "tStartMs": 285280,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "예를 들면 국내 최대 에틸렌 생산기지"
    } ]
  }, {
    "tStartMs": 287650,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "여천 NCC"
    } ]
  }, {
    "tStartMs": 288660,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "굉장히 큰 데죠"
    } ]
  }, {
    "tStartMs": 289700,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "이번에 이미 공급 불가를 뜻하는"
    } ]
  }, {
    "tStartMs": 291070,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "불가항력을 선언했다고 합니다"
    } ]
  }, {
    "tStartMs": 292840,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "롯데케미칼, LG화학 한화솔루션"
    } ]
  }, {
    "tStartMs": 294900,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "지금 이런 업체들도"
    } ]
  }, {
    "tStartMs": 295990,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "바로 엊그제"
    } ]
  }, {
    "tStartMs": 297290,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "이제 우리도 불가항력하게"
    } ]
  }, {
    "tStartMs": 298960,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "공급을 할 수 없을 가능성이 있다"
    } ]
  }, {
    "tStartMs": 300500,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "라고 고객사에 통보했다가 나오고 있어요"
    } ]
  }, {
    "tStartMs": 302400,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "대부분의 생산업체들이"
    } ]
  }, {
    "tStartMs": 303860,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "가동률을 쭉 낮추고 있습니다"
    } ]
  }, {
    "tStartMs": 305570,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "60%까지"
    } ]
  }, {
    "tStartMs": 306540,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "오래 버텨야 되니까"
    } ]
  }, {
    "tStartMs": 307990,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "그러면 우리나라 석화업체들의 나프타 재고는 얼마가 되냐?"
    } ]
  }, {
    "tStartMs": 312310,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "한 2주 얘기하는 것 같아요"
    } ]
  }, {
    "tStartMs": 314160,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "이건 뭐 FT에 나왔나?"
    } ]
  }, {
    "tStartMs": 315810,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "해외 언론의 기사이긴 한데"
    } ]
  }, {
    "tStartMs": 317280,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "한 2주 정도가 아닐까?"
    } ]
  }, {
    "tStartMs": 318890,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "일본도 한 2, 3주?"
    } ]
  }, {
    "tStartMs": 320380,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "게다가 그럼 나프타가 안 들어와"
    } ]
  }, {
    "tStartMs": 322190,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "그럼 석화를 만들 수 없어"
    } ]
  }, {
    "tStartMs": 323830,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "에틸렌 같은 걸 만들 수 없어"
    } ]
  }, {
    "tStartMs": 325060,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "플라스틱을 만들 수 없어"
    } ]
  }, {
    "tStartMs": 326690,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "그러면 다른 데서 들어와야 되는데"
    } ]
  }, {
    "tStartMs": 328140,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "지금 대안이 잘 없죠"
    } ]
  }, {
    "tStartMs": 330050,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "과거에는 러시아가 어떻게 했는데"
    } ]
  }, {
    "tStartMs": 332500,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "지금 러시아 우크라이나 전쟁이고"
    } ]
  }, {
    "tStartMs": 334000,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "러시아하고 관계상으로도"
    } ]
  }, {
    "tStartMs": 335890,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "쉽지 않을 것 같고"
    } ]
  }, {
    "tStartMs": 336990,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "캐나다 뭐 이런 데들은"
    } ]
  }, {
    "tStartMs": 337970,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "지금 당연히 미국도 급하니까"
    } ]
  }, {
    "tStartMs": 339650,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "미국적으로 우선적으로 넣을 것이고"
    } ]
  }, {
    "tStartMs": 341680,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "그럼 우리는 답이 있냐"
    } ]
  }, {
    "tStartMs": 344590,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "그리고 만약에 석유화학 산업이 어려워져서"
    } ]
  }, {
    "tStartMs": 346800,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "나프타가 안 나오고"
    } ]
  }, {
    "tStartMs": 347560,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "에틸렌이 안 나오면"
    } ]
  }, {
    "tStartMs": 348550,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "당연히 전방위적으로"
    } ]
  }, {
    "tStartMs": 349440,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "물가가 오를 위험도 있습니다"
    } ]
  }, {
    "tStartMs": 351690,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "만드는 거에"
    } ]
  }, {
    "tStartMs": 352290,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "안 들어가는 게 어디 있겠어요"
    } ]
  }, {
    "tStartMs": 353440,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "대부분 다 들어가는데"
    } ]
  }, {
    "tStartMs": 354430,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "거의 모든 전자제품이나"
    } ]
  }, {
    "tStartMs": 355650,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "어지간한 건 다 들어가죠"
    } ]
  }, {
    "tStartMs": 357020,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "그리고 특히"
    } ]
  }, {
    "tStartMs": 357890,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "석유화학 업계에는 치명타가 될 수 있죠"
    } ]
  }, {
    "tStartMs": 360880,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "우리나라 석화산업은 안 그래도 구조조정 중입니다"
    } ]
  }, {
    "tStartMs": 363540,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "굉장히 강력한 구조조정을 하는데"
    } ]
  }, {
    "tStartMs": 365380,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "중국발 가격 경쟁 때문에"
    } ]
  }, {
    "tStartMs": 367320,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "우리가 어려움을 겪잖아요"
    } ]
  }, {
    "tStartMs": 368290,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "문제는 강력한 경쟁자인"
    } ]
  }, {
    "tStartMs": 370290,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "중국도 어려움을 겪으면"
    } ]
  }, {
    "tStartMs": 371380,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "그래도 괜찮은데"
    } ]
  }, {
    "tStartMs": 372170,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "중국은 러시아와 이란에서"
    } ]
  }, {
    "tStartMs": 373570,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "꾸준한 공급을 받아요"
    } ]
  }, {
    "tStartMs": 375800,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "오히려 웃고 있을 수도 있습니다"
    } ]
  }, {
    "tStartMs": 379020,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "우리가 죽어서"
    } ]
  }, {
    "tStartMs": 380560,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "러시아로 받고 이란으로 받고 하니까"
    } ]
  }, {
    "tStartMs": 382820,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "우리의 석화업계만"
    } ]
  }, {
    "tStartMs": 385070,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "굉장히 어려움을 겪을 수 있고"
    } ]
  }, {
    "tStartMs": 387090,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "게다가 이란 전쟁으로"
    } ]
  }, {
    "tStartMs": 388890,
    "dDurationMs": 630,
    "segs": [ {
      "utf8": "글로벌 유가는"
    } ]
  }, {
    "tStartMs": 389520,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "100달러에 도달했죠"
    } ]
  }, {
    "tStartMs": 391280,
    "dDurationMs": 550,
    "segs": [ {
      "utf8": "100달러입니다"
    } ]
  }, {
    "tStartMs": 391830,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "왔다 갔다 하고 있는데"
    } ]
  }, {
    "tStartMs": 393080,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "유가를 좀 낮춰야 되니까"
    } ]
  }, {
    "tStartMs": 394530,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "IEA 국제에너지기구는 이번에"
    } ]
  }, {
    "tStartMs": 396210,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "비축유 방출을 결정했습니다"
    } ]
  }, {
    "tStartMs": 397980,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "4억 배럴의"
    } ]
  }, {
    "tStartMs": 398760,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "비축유를 방출하기로 합의를 했는데"
    } ]
  }, {
    "tStartMs": 401040,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "많은 분들이 이걸 국제에너지기구가"
    } ]
  }, {
    "tStartMs": 403330,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "나눠준다고 생각하더라고요"
    } ]
  }, {
    "tStartMs": 404640,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "그거 나눠주는 거 아닙니다"
    } ]
  }, {
    "tStartMs": 406110,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "국제에너지기구가 무슨 돈이 있어서"
    } ]
  }, {
    "tStartMs": 407560,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "4억 배럴에 비축유가 있겠어요"
    } ]
  }, {
    "tStartMs": 409310,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "그 뜻이 아니에요"
    } ]
  }, {
    "tStartMs": 409990,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "이건 무슨 뜻이냐"
    } ]
  }, {
    "tStartMs": 411100,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "국제에너지기구라는 거는"
    } ]
  }, {
    "tStartMs": 413130,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "OECD 산하의 에너지협력기구인데"
    } ]
  }, {
    "tStartMs": 415210,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "회원국들은 알아서"
    } ]
  }, {
    "tStartMs": 416760,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "90분의 비축유를 유지하세요"
    } ]
  }, {
    "tStartMs": 418800,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "라는 의무를 지어놓은 국제기구예요"
    } ]
  }, {
    "tStartMs": 420910,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "90일, 90일, 90일"
    } ]
  }, {
    "tStartMs": 422560,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "비축유는 꼭 갖고 계세요"
    } ]
  }, {
    "tStartMs": 424020,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "그러다가 유가가 파악 오르면"
    } ]
  }, {
    "tStartMs": 425620,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "자, 지금이요 쓰세요"
    } ]
  }, {
    "tStartMs": 426860,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "이렇게 하는 거예요"
    } ]
  }, {
    "tStartMs": 428880,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "그 전에는 90일은 갖고 있어야지"
    } ]
  }, {
    "tStartMs": 430430,
    "dDurationMs": 570,
    "segs": [ {
      "utf8": "90일은 갖고 있어야지"
    } ]
  }, {
    "tStartMs": 431000,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "왜 팔아?"
    } ]
  }, {
    "tStartMs": 431500,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "지금 쓰세요"
    } ]
  }, {
    "tStartMs": 432560,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "그래서 우리나라도 IEA에 속해 있으니까"
    } ]
  }, {
    "tStartMs": 436030,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "우리나라가 갖고 있는 거"
    } ]
  }, {
    "tStartMs": 437000,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "쓰세요 하니까 오케이 쓰겠습니다"
    } ]
  }, {
    "tStartMs": 439210,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "해서 우리나라가 갖고 있는"
    } ]
  }, {
    "tStartMs": 440540,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "비축유 2,246만 배럴을"
    } ]
  }, {
    "tStartMs": 443110,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "방출하는 걸 결정한 겁니다"
    } ]
  }, {
    "tStartMs": 445040,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "여기 속해 있는 국가들이"
    } ]
  }, {
    "tStartMs": 447100,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "전체 4억 배럴을 들고 있는데"
    } ]
  }, {
    "tStartMs": 448820,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "그중에 5.6%"
    } ]
  }, {
    "tStartMs": 450140,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "우리나라는 갖고 있는 것 중에"
    } ]
  }, {
    "tStartMs": 451480,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "4억 배럴을 방출하는데"
    } ]
  }, {
    "tStartMs": 453350,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "대한민국의 방출 물량은 2,246만 배럴입니다"
    } ]
  }, {
    "tStartMs": 456810,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "4억 배럴 중에 5.6%"
    } ]
  }, {
    "tStartMs": 458820,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "이 정도만 해도"
    } ]
  }, {
    "tStartMs": 459560,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "1990년 걸프전 당시 배출한 것보다"
    } ]
  }, {
    "tStartMs": 462140,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "거의 4배"
    } ]
  }, {
    "tStartMs": 463300,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "역대 최대 규모의 비축유를"
    } ]
  }, {
    "tStartMs": 464950,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "이번에 그래서 방출하게 되는 겁니다"
    } ]
  }, {
    "tStartMs": 467530,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "우리나라 갖고 있는 비축유는"
    } ]
  }, {
    "tStartMs": 468980,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "한 1억 배럴 정도로 알려져 있어요"
    } ]
  }, {
    "tStartMs": 470460,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "이 중에 23%를"
    } ]
  }, {
    "tStartMs": 472030,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "이번에 배출한다고 보시면 되고요"
    } ]
  }, {
    "tStartMs": 474090,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "우리나라 일일 소비량이 왔다 갔다 하는데"
    } ]
  }, {
    "tStartMs": 475920,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "200만에서 200만 후반까지"
    } ]
  }, {
    "tStartMs": 477760,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "한 열흘?"
    } ]
  }, {
    "tStartMs": 478850,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "열흘치 정도를 이번에 방출한다고 보시면 됩니다"
    } ]
  }, {
    "tStartMs": 481380,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "IEA 입장에서도 4억 배럴 방출 결정은"
    } ]
  }, {
    "tStartMs": 484000,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "사상 최대 규모입니다"
    } ]
  }, {
    "tStartMs": 485690,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "러시아 우크라이나 전쟁 때보다도"
    } ]
  }, {
    "tStartMs": 487640,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "2배 이상 많은 물량을"
    } ]
  }, {
    "tStartMs": 488720,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "이번에 방출하라고 결정을 한 거죠"
    } ]
  }, {
    "tStartMs": 492030,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "IEA 사무총장이 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 493840,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "지금 현재 전 세계의 석유 시장은"
    } ]
  }, {
    "tStartMs": 495990,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "전례 없는 어려움의 뒷면에 있다"
    } ]
  }, {
    "tStartMs": 498660,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "전례 없는 규모다"
    } ]
  }, {
    "tStartMs": 500110,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "그래서 굉장히 많은 비축유를"
    } ]
  }, {
    "tStartMs": 501830,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "방출한다고 발표를 했고"
    } ]
  }, {
    "tStartMs": 503440,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "이때 석유 가격이 쭉 내려갔죠"
    } ]
  }, {
    "tStartMs": 504930,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "물론 다시 쭉 올라갔습니다"
    } ]
  }, {
    "tStartMs": 506420,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "다시 쭉 올라가서"
    } ]
  }, {
    "tStartMs": 507340,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "다시 100달러에 왔는데"
    } ]
  }, {
    "tStartMs": 509130,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "이것만으로도 안 되기 때문에"
    } ]
  }, {
    "tStartMs": 510400,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "일단 우리나라의 대응을 먼저 보여드리면"
    } ]
  }, {
    "tStartMs": 512190,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "우리나라는 3월 13일 기준으로"
    } ]
  }, {
    "tStartMs": 514340,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "석유 최고 가격제를 시행하기로 결정했어요"
    } ]
  }, {
    "tStartMs": 517560,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "공급가를 기준으로"
    } ]
  }, {
    "tStartMs": 518900,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "리터당 보통 유발료가 1724원이 상한입니다"
    } ]
  }, {
    "tStartMs": 522160,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "소매가격은 아니고 공급가 기준입니다"
    } ]
  }, {
    "tStartMs": 524740,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "그리고 자동차 경유도 1713원이에요"
    } ]
  }, {
    "tStartMs": 527290,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "그리고 유류세 인하도 폭을"
    } ]
  }, {
    "tStartMs": 529030,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "확대한다고 결정했습니다"
    } ]
  }, {
    "tStartMs": 530590,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "이번에 결정한 석유 최고 가격제는"
    } ]
  }, {
    "tStartMs": 532830,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "리터당 100원에서"
    } ]
  }, {
    "tStartMs": 534380,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "등유는 한 400원까지"
    } ]
  }, {
    "tStartMs": 536010,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "내려갈 수 있는"
    } ]
  }, {
    "tStartMs": 537090,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "가격 절감 효과가 있는 결정이라고 할 수 있는데"
    } ]
  }, {
    "tStartMs": 539840,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "문제는 이게 언제까지"
    } ]
  }, {
    "tStartMs": 542030,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "유지할 수 있는 건 아니잖아요"
    } ]
  }, {
    "tStartMs": 543770,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "지금 당장은 급하니까"
    } ]
  }, {
    "tStartMs": 545830,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "공급 가격 최고가 캡을 만들었는데"
    } ]
  }, {
    "tStartMs": 547940,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "물량이 안 들어오면"
    } ]
  }, {
    "tStartMs": 549210,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "정유사들 입장에서도"
    } ]
  }, {
    "tStartMs": 550280,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "어쩔 수 없는 때가 오기 때문에"
    } ]
  }, {
    "tStartMs": 552150,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "이 가격은 2주간 유지됩니다"
    } ]
  }, {
    "tStartMs": 555030,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "2주 뒤에는 어떻게 되냐?"
    } ]
  }, {
    "tStartMs": 556160,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "그때는 다시 조정해야 돼요"
    } ]
  }, {
    "tStartMs": 557820,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "유가가 올라가면"
    } ]
  }, {
    "tStartMs": 558510,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "그때는 뭐 다시 어쩔 수 없이 올리는"
    } ]
  }, {
    "tStartMs": 560370,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "그런 일이 일어나겠죠"
    } ]
  }, {
    "tStartMs": 562330,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "그리고 우리는 이것만으로도 안 되기 때문에"
    } ]
  }, {
    "tStartMs": 564350,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "최근에 나오는 거"
    } ]
  }, {
    "tStartMs": 565560,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "조기 추경 얘기도 나오고 있습니다"
    } ]
  }, {
    "tStartMs": 567720,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "결국 추경 편성을 하지 않을 수가 없는데"
    } ]
  }, {
    "tStartMs": 569530,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "최대한 신속하게 추경을 편성해달라"
    } ]
  }, {
    "tStartMs": 572040,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "추경 얘기도 나오고 있고요"
    } ]
  }, {
    "tStartMs": 573430,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "3월 10일에는"
    } ]
  }, {
    "tStartMs": 574670,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "한국은행의 국고채 단순 매입"
    } ]
  }, {
    "tStartMs": 576210,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "3조 원도 했습니다"
    } ]
  }, {
    "tStartMs": 577650,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "물론 이건 금리 변동성 확대"
    } ]
  }, {
    "tStartMs": 578990,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "금리 상승을 막고자 한 건데"
    } ]
  }, {
    "tStartMs": 581020,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "결국 뭐 비슷한 거죠"
    } ]
  }, {
    "tStartMs": 582110,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "불안 때문에 금리가 올라가고 하니까"
    } ]
  }, {
    "tStartMs": 583990,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "국고채에도 3조 원 매입하면서"
    } ]
  }, {
    "tStartMs": 586020,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "시장의 안정과"
    } ]
  }, {
    "tStartMs": 587230,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "금리 안정을 노렸다고 보시면 되고요"
    } ]
  }, {
    "tStartMs": 589470,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "이렇게 급하지만"
    } ]
  }, {
    "tStartMs": 590410,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "웃고 있는 나라도 있습니다"
    } ]
  }, {
    "tStartMs": 591510,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "웃고 있는 나라는 어디냐?"
    } ]
  }, {
    "tStartMs": 593450,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "당연히 러시아입니다"
    } ]
  }, {
    "tStartMs": 595820,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "러시아는 일단"
    } ]
  }, {
    "tStartMs": 597110,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "유가가 더블로 뛰었어요"
    } ]
  }, {
    "tStartMs": 598640,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "60달러 하던 게 100달러가 넘었어요"
    } ]
  }, {
    "tStartMs": 600740,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "게다가 많은 나라들이"
    } ]
  }, {
    "tStartMs": 602040,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "러시아한테 아쉬운 소리를 해야죠"
    } ]
  }, {
    "tStartMs": 604290,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "우리 좀 주면 안 될까?"
    } ]
  }, {
    "tStartMs": 606080,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "지금 제재 중인"
    } ]
  }, {
    "tStartMs": 606870,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "트럼프 행정부가 좀 풀어준다고 하니까"
    } ]
  }, {
    "tStartMs": 608500,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "미안한데 그동안 잘 못했다"
    } ]
  }, {
    "tStartMs": 610620,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "잘해보자!"
    } ]
  }, {
    "tStartMs": 611680,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "아니 우리가 뭐 그렇게 아쉬운 사이도 아니고"
    } ]
  }, {
    "tStartMs": 614270,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "라는 얘기를 해야 되니까"
    } ]
  }, {
    "tStartMs": 616120,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "당연히 러시아는 개꿀이죠"
    } ]
  }, {
    "tStartMs": 617960,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "러시아는 현재 유가가 올라서"
    } ]
  }, {
    "tStartMs": 619500,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "석유 판매로 하루에만"
    } ]
  }, {
    "tStartMs": 620680,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "최대 1억 5천만 달러 이상의"
    } ]
  }, {
    "tStartMs": 622910,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "추가 수입을 올리는 걸로 알려져 있고요"
    } ]
  }, {
    "tStartMs": 624950,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "현재 중동 분쟁의 최대 수혜국이 어디냐?"
    } ]
  }, {
    "tStartMs": 627360,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "그럼 러시아를 가장 많이 뽑습니다"
    } ]
  }, {
    "tStartMs": 629840,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "게다가 트럼프 행정부는"
    } ]
  }, {
    "tStartMs": 631460,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "30일간 러시아 원유 제재 완화도 발표했어요"
    } ]
  }, {
    "tStartMs": 634540,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "우크라이나가 강력하게 반대했지만"
    } ]
  }, {
    "tStartMs": 636180,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "뭐 그런 거 없죠"
    } ]
  }, {
    "tStartMs": 636950,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "그런 거 없고..."
    } ]
  }, {
    "tStartMs": 638240,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "30일간은 러시아산 원유를"
    } ]
  }, {
    "tStartMs": 639690,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "누구나 살 수 있습니다"
    } ]
  }, {
    "tStartMs": 641210,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "일시적이라고 얘기를 하지만"
    } ]
  }, {
    "tStartMs": 642300,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "어쨌건 제재 완화를 했고요"
    } ]
  }, {
    "tStartMs": 644730,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "그리고 현재 이란 호르무즈 해협이 막혔지만"
    } ]
  }, {
    "tStartMs": 647360,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "유일하게 안 막힌 나라가 어딥니까?"
    } ]
  }, {
    "tStartMs": 649180,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "중국입니다"
    } ]
  }, {
    "tStartMs": 650400,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "이란은 전쟁 중에도"
    } ]
  }, {
    "tStartMs": 651410,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "호르무즈 해협을 통해"
    } ]
  }, {
    "tStartMs": 652070,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "대량의 원유를 중국으로 계속 보내고 있다"
    } ]
  }, {
    "tStartMs": 654650,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "자국 유조선은 공격하지 않을 테니까"
    } ]
  }, {
    "tStartMs": 656690,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "현재 1170만 배럴의 원유를 수송했는데"
    } ]
  }, {
    "tStartMs": 658880,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "모두 중국으로 향했다"
    } ]
  }, {
    "tStartMs": 660930,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "중국도 나쁘지 않다"
    } ]
  }, {
    "tStartMs": 662580,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "다른 나라들이"
    } ]
  }, {
    "tStartMs": 663710,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "한국 석화 이런 데 어려움을 겪고"
    } ]
  }, {
    "tStartMs": 665270,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "어려움을 겪는데"
    } ]
  }, {
    "tStartMs": 665960,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "자기들은 올 수 있으면"
    } ]
  }, {
    "tStartMs": 668450,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "나쁘지 않을 수 있다"
    } ]
  }, {
    "tStartMs": 669250,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "러시아는 웃고 있고"
    } ]
  }, {
    "tStartMs": 670370,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "그러면 동맹들만 죽어나가고 있는데"
    } ]
  }, {
    "tStartMs": 673350,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "아니 미국은 비축유 많잖아요"
    } ]
  }, {
    "tStartMs": 675720,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "팍팍 풀어주면 안 됩니까?"
    } ]
  }, {
    "tStartMs": 677350,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "미국 에너지부 장관이"
    } ]
  }, {
    "tStartMs": 678570,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "미국의 전략비축유 1억 7천 2백만"
    } ]
  }, {
    "tStartMs": 680820,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "배럴을 방출한다고 얘기했어요"
    } ]
  }, {
    "tStartMs": 682720,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "방출할게"
    } ]
  }, {
    "tStartMs": 683600,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "오? 그러면 되는 거 아니냐"
    } ]
  }, {
    "tStartMs": 685370,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "문제는 미국의"
    } ]
  }, {
    "tStartMs": 687420,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "하루 최대 방출 능력이"
    } ]
  }, {
    "tStartMs": 689290,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "440만 배럴이라고 합니다"
    } ]
  }, {
    "tStartMs": 691100,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "1억 7천만 배럴을 다 방출하려면"
    } ]
  }, {
    "tStartMs": 693580,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "석 달이 걸려요"
    } ]
  }, {
    "tStartMs": 694830,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "그래서 앞으로"
    } ]
  }, {
    "tStartMs": 696460,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "천천히 나올 생각이 있는데"
    } ]
  }, {
    "tStartMs": 697600,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "저게 이제 우리까지 순번이 될래나"
    } ]
  }, {
    "tStartMs": 701470,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "그런 생각이 있고"
    } ]
  }, {
    "tStartMs": 702230,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "본인들 그리고 급하니까"
    } ]
  }, {
    "tStartMs": 704070,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "그런 데 쓰지 않을까 생각이 되고요"
    } ]
  }, {
    "tStartMs": 705980,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "그래서 이 전쟁이 만약에 길어지면"
    } ]
  }, {
    "tStartMs": 708040,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "2주에 3주 정도가 더 가게 되면"
    } ]
  }, {
    "tStartMs": 710480,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "아마 좀 문제들이"
    } ]
  }, {
    "tStartMs": 712250,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "물가라든지 유가 관련된 게"
    } ]
  }, {
    "tStartMs": 714130,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "굉장히 심각하지 않을까라는"
    } ]
  }, {
    "tStartMs": 715270,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "우려가 많이 드는 상황인데"
    } ]
  }, {
    "tStartMs": 716960,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "그럼 전쟁이 빨리 끝나야겠죠"
    } ]
  }, {
    "tStartMs": 718130,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "빨리 끝나면 되는데"
    } ]
  }, {
    "tStartMs": 719360,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "이란은 이번에 새로 최고"
    } ]
  }, {
    "tStartMs": 721200,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "지도자가 선출이 됐습니다"
    } ]
  }, {
    "tStartMs": 722800,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "하메네이 아들이라고 부르죠"
    } ]
  }, {
    "tStartMs": 724480,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "이번에 이란 최고 지도자가 성명을 발표했는데"
    } ]
  }, {
    "tStartMs": 726620,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 727510,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "호르무즈 해협 봉쇄는 반드시 계속되어야 된다"
    } ]
  }, {
    "tStartMs": 730710,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "우리는 이거를 계속 이용해야 된다"
    } ]
  }, {
    "tStartMs": 734070,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "풀 생각은 없는 것 같고"
    } ]
  }, {
    "tStartMs": 736230,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "성명에는 이런 내용도 나옵니다"
    } ]
  }, {
    "tStartMs": 738190,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "우리는 순교자들의 피에 대한"
    } ]
  }, {
    "tStartMs": 740160,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "복수를 주저하지 않을 것이다"
    } ]
  }, {
    "tStartMs": 741960,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "특히 제가 이 성명을 다 가져오지 않았는데"
    } ]
  }, {
    "tStartMs": 744010,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "특히 아이들의 피에 대해서는"
    } ]
  }, {
    "tStartMs": 746020,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "가장 강력한 수단으로 복수하겠다"
    } ]
  }, {
    "tStartMs": 748670,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "라고 선언을 했고요"
    } ]
  }, {
    "tStartMs": 750530,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "이런 얘기도 했습니다"
    } ]
  }, {
    "tStartMs": 751570,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "이란은 상대적으로 적의 경험이 적고"
    } ]
  }, {
    "tStartMs": 753870,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "취약한 곳에"
    } ]
  }, {
    "tStartMs": 754850,
    "dDurationMs": 4950,
    "segs": [ {
      "utf8": "제2의 전선을 형성할 가능성을 검토해왔다"
    } ]
  }, {
    "tStartMs": 759800,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "제2의 전선을 형성할 가능성"
    } ]
  }, {
    "tStartMs": 763010,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "이러면 안 되겠죠"
    } ]
  }, {
    "tStartMs": 763620,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "이러면 확전입니다, 확전인데"
    } ]
  }, {
    "tStartMs": 765350,
    "dDurationMs": 630,
    "segs": [ {
      "utf8": "늘어나는 거죠"
    } ]
  }, {
    "tStartMs": 765980,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "주변으로 전선을 넓히면"
    } ]
  }, {
    "tStartMs": 767950,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "이러면 안 되고요"
    } ]
  }, {
    "tStartMs": 768830,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "이러면 안 되고"
    } ]
  }, {
    "tStartMs": 769760,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "그만하고 적당히"
    } ]
  }, {
    "tStartMs": 771780,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "전쟁의 포화가 멈춰야 되는데"
    } ]
  }, {
    "tStartMs": 773720,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "물론"
    } ]
  }, {
    "tStartMs": 774530,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "저런 성명을 발표한 지도자의 안위는"
    } ]
  }, {
    "tStartMs": 776580,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "현재 정확하게 알려지지는 않고 있습니다"
    } ]
  }, {
    "tStartMs": 778650,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "영상이나 공개석상에 모습을 드러내지 않고 있어요"
    } ]
  }, {
    "tStartMs": 781100,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "그래서 굉장히 심각하게 다쳤다,"
    } ]
  }, {
    "tStartMs": 782910,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "사실 죽은 거 아니냐는"
    } ]
  }, {
    "tStartMs": 784760,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "내용부터 온갖 음모론이 있는데"
    } ]
  }, {
    "tStartMs": 786100,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "어쨌건 성명은 발표가 됐습니다"
    } ]
  }, {
    "tStartMs": 788580,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "상황은 이런 상황이기 때문에"
    } ]
  }, {
    "tStartMs": 790320,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "여러분 다 들어보셨겠지만"
    } ]
  }, {
    "tStartMs": 791630,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "지금 현재 호르무즈 해협을 통과하다가"
    } ]
  }, {
    "tStartMs": 793680,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "또는 정박했다가"
    } ]
  }, {
    "tStartMs": 794890,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "공격을 받은 민간 선박이 무려 16척입니다"
    } ]
  }, {
    "tStartMs": 798570,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "공격을 받아서"
    } ]
  }, {
    "tStartMs": 799600,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "그냥 조금 피해를 본 게 아니라"
    } ]
  }, {
    "tStartMs": 801770,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "이렇게 됐어요"
    } ]
  }, {
    "tStartMs": 803170,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "정박해 있거나 통과거나"
    } ]
  }, {
    "tStartMs": 805110,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "대함 미사일, 드론, 무인 수상함"
    } ]
  }, {
    "tStartMs": 807440,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "심지어 해상 기뢰"
    } ]
  }, {
    "tStartMs": 809090,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "16척인데 실시간으로 늘어나고 있기 때문에"
    } ]
  }, {
    "tStartMs": 811420,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "앞으로도 더 늘어날 가능성이 있고요"
    } ]
  }, {
    "tStartMs": 813600,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "왜 더 늘어날 가능성이 있냐?"
    } ]
  }, {
    "tStartMs": 815130,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "상황이 다급하니까"
    } ]
  }, {
    "tStartMs": 816740,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "일부 유조선들이 강행돌파를 하는"
    } ]
  }, {
    "tStartMs": 819170,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "경우가 있다고 합니다 여기를,"
    } ]
  }, {
    "tStartMs": 821500,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "이 호르무즈 해협을 강행돌파를 한대요"
    } ]
  }, {
    "tStartMs": 824670,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "한국을 보고 배우는 것 같은데"
    } ]
  }, {
    "tStartMs": 826260,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "야, 그거 아무나 하는 거 아닌데"
    } ]
  }, {
    "tStartMs": 827420,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "야, 그거 한국이"
    } ]
  }, {
    "tStartMs": 828820,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "휘로록!!  살았죠?"
    } ]
  }, {
    "tStartMs": 830060,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "하고 가는 걸 봤는지 몰라도"
    } ]
  }, {
    "tStartMs": 832100,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "그리스도 얼마 전에"
    } ]
  }, {
    "tStartMs": 833030,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "뉴스가 두 번 떴는데"
    } ]
  }, {
    "tStartMs": 833950,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "무려 두 번이나 호르무즈 해협을"
    } ]
  }, {
    "tStartMs": 835770,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "강행돌파했다고 합니다"
    } ]
  }, {
    "tStartMs": 837420,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "선박 자동식별장치도 끄고"
    } ]
  }, {
    "tStartMs": 840440,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "조용히 이렇게 강행돌파를 했다"
    } ]
  }, {
    "tStartMs": 843260,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "한 척도 아니래요"
    } ]
  }, {
    "tStartMs": 844610,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "거의 10척 가까이가"
    } ]
  }, {
    "tStartMs": 845800,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "이거를 강행돌파한다는 내용들이 나오는데"
    } ]
  }, {
    "tStartMs": 848540,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "돌파가 되면 좋은데"
    } ]
  }, {
    "tStartMs": 849720,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "이거 잘못하면 진짜 공격을 받을 수가 있으니까"
    } ]
  }, {
    "tStartMs": 852970,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "그럼 더 큰 충격이 되겠죠"
    } ]
  }, {
    "tStartMs": 854270,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "그래서 저기를 통과를 못하니까"
    } ]
  }, {
    "tStartMs": 856570,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "유조사를 운영하는 기업들이"
    } ]
  }, {
    "tStartMs": 858140,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "미군에 선박 호위를 해주면 안 돼요?"
    } ]
  }, {
    "tStartMs": 860800,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "라고 물어본다고 합니다"
    } ]
  }, {
    "tStartMs": 862160,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "미 해군은 해군업계로부터"
    } ]
  }, {
    "tStartMs": 863670,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "거의 매일 보디가드 해달라고"
    } ]
  }, {
    "tStartMs": 866030,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "군사 호위 요청이 들어온다고 해요"
    } ]
  }, {
    "tStartMs": 867670,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "지금까지는 거절하고 있습니다"
    } ]
  }, {
    "tStartMs": 869750,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "왜냐면 공격하기에 더 바쁘니까"
    } ]
  }, {
    "tStartMs": 871550,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "지금 이란을 더 먼저 공격할 때지"
    } ]
  }, {
    "tStartMs": 873140,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "선박 호위할 뭐 그 정도의 여력은 없다"
    } ]
  }, {
    "tStartMs": 875340,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "그래서 거절했다고 알려져 있었는데"
    } ]
  }, {
    "tStartMs": 877090,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "얼마 전에 미 에너지부 장관이"
    } ]
  }, {
    "tStartMs": 879470,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "SNS에 글 하나를 올렸습니다"
    } ]
  }, {
    "tStartMs": 881280,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "제가 이걸 갖고 온 이유는"
    } ]
  }, {
    "tStartMs": 882570,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "이것 때문에 유가가 엄청나게 빠졌었어요"
    } ]
  }, {
    "tStartMs": 884510,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "이렇게 올렸습니다"
    } ]
  }, {
    "tStartMs": 885620,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "미 해군은"
    } ]
  }, {
    "tStartMs": 886480,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "석유가 세계 시장으로"
    } ]
  }, {
    "tStartMs": 887650,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "계속 흐를 수 있도록"
    } ]
  }, {
    "tStartMs": 888400,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "보장하기 위해서"
    } ]
  }, {
    "tStartMs": 889570,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "호르무즈 해협을 통과한 유조선을"
    } ]
  }, {
    "tStartMs": 891130,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "성공적으로 호위했다"
    } ]
  }, {
    "tStartMs": 892740,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "앞으로 호위할 것 같다"
    } ]
  }, {
    "tStartMs": 894030,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "뭐 이런 어투죠"
    } ]
  }, {
    "tStartMs": 895330,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "저게 딱 발표된 다음에"
    } ]
  }, {
    "tStartMs": 897090,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "유가가 19%가"
    } ]
  }, {
    "tStartMs": 898170,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "순간 급락하는 일이 있었습니다"
    } ]
  }, {
    "tStartMs": 899780,
    "dDurationMs": 410,
    "segs": [ {
      "utf8": "쫙!"
    } ]
  }, {
    "tStartMs": 900190,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "오 이제 드디어 미군이 저기를 호위하나 보다"
    } ]
  }, {
    "tStartMs": 903930,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "조금 있다가"
    } ]
  }, {
    "tStartMs": 905820,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "어?"
    } ]
  }, {
    "tStartMs": 907170,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "조금 있다가"
    } ]
  }, {
    "tStartMs": 908340,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "봤어요 제가 없는데"
    } ]
  }, {
    "tStartMs": 909380,
    "dDurationMs": 450,
    "segs": [ {
      "utf8": "봤어요"
    } ]
  }, {
    "tStartMs": 909830,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "다시 가서 보니까 삭제됐다"
    } ]
  }, {
    "tStartMs": 912260,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "그래서 어?"
    } ]
  }, {
    "tStartMs": 913670,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "글을 올렸다가"
    } ]
  }, {
    "tStartMs": 915880,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "지워졌다는 거죠"
    } ]
  }, {
    "tStartMs": 917520,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "왜 영상 갑자기 내리셨다는 건데"
    } ]
  }, {
    "tStartMs": 920160,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "왜 내리셨나요?"
    } ]
  }, {
    "tStartMs": 922250,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "라고 물어봤더니 이렇게 떴습니다"
    } ]
  }, {
    "tStartMs": 923910,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "아, 그게 직원의 자막 기재 오류가 확인되어서"
    } ]
  }, {
    "tStartMs": 927410,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "공식 계정에서 삭제했다"
    } ]
  }, {
    "tStartMs": 928730,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "뭐 약간의 그 자막에 글에 오류가 있어서"
    } ]
  }, {
    "tStartMs": 930810,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "약간 삭제했습니다"
    } ]
  }, {
    "tStartMs": 931750,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "라고 넘어갔죠"
    } ]
  }, {
    "tStartMs": 933940,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "에너지부 장관이 얘기한 거니까"
    } ]
  }, {
    "tStartMs": 935590,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "그날 백악관 기자회견에 기자들이 물어봤어요"
    } ]
  }, {
    "tStartMs": 938180,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "그 호르무즈 해협 통과하는"
    } ]
  }, {
    "tStartMs": 939800,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "유조선 선박 미군이 호위했다고 하는데"
    } ]
  }, {
    "tStartMs": 942390,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "아니면 호위한다고 하는데 할 겁니까?"
    } ]
  }, {
    "tStartMs": 944610,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "그랬더니 백악관 대변인은 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 946510,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "일반 선박을 아직"
    } ]
  }, {
    "tStartMs": 948000,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "호위하고 있지는 않다"
    } ]
  }, {
    "tStartMs": 948960,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "아니었고요, 아니었고요"
    } ]
  }, {
    "tStartMs": 951990,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "공식적으로 아니라고 했고요"
    } ]
  }, {
    "tStartMs": 953730,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "다만 검토는 해볼게"
    } ]
  }, {
    "tStartMs": 955400,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "검토는"
    } ]
  }, {
    "tStartMs": 956100,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "그냥 검토는 해본다고 합니다"
    } ]
  }, {
    "tStartMs": 957990,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "아직은 아니라고 하고요"
    } ]
  }, {
    "tStartMs": 960410,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "그리고 엎친 데 덮친 격으로 뉴스도 보셨겠지만"
    } ]
  }, {
    "tStartMs": 962810,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "이란이 호르무즈 해협에"
    } ]
  }, {
    "tStartMs": 964410,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "기뢰 설치 얘기가 나오고 있어요"
    } ]
  }, {
    "tStartMs": 967120,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "생각보다 심각한 뉴스입니다"
    } ]
  }, {
    "tStartMs": 968940,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "기뢰는 설치하면 안 돼"
    } ]
  }, {
    "tStartMs": 970660,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "왜냐하면 기뢰를 만약에 엄청나게 깔면"
    } ]
  }, {
    "tStartMs": 973630,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "전쟁이 내일 끝나더라도"
    } ]
  }, {
    "tStartMs": 975230,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "정상화되는데"
    } ]
  }, {
    "tStartMs": 975870,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "시간이 오래 걸립니다"
    } ]
  }, {
    "tStartMs": 977740,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "왜냐하면 기뢰가 바퀴가 있는 것도 아니고"
    } ]
  }, {
    "tStartMs": 979890,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "스크류가 있는 것도 아니고"
    } ]
  }, {
    "tStartMs": 980870,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "저거를 설치를 하면"
    } ]
  }, {
    "tStartMs": 982360,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "일단 누군가 해체를 해야 될 거 아니에요"
    } ]
  }, {
    "tStartMs": 984230,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "전쟁이 끝났다고 하더라도"
    } ]
  }, {
    "tStartMs": 985590,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "그게 오래 걸리기 때문에"
    } ]
  }, {
    "tStartMs": 987020,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "게다가 이란은 현재"
    } ]
  }, {
    "tStartMs": 989070,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "최대 6천 발의 기뢰를"
    } ]
  }, {
    "tStartMs": 990640,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "갖고 있는 걸로 알려져 있습니다"
    } ]
  }, {
    "tStartMs": 992590,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "6천 개를 만약에 다 설치했다"
    } ]
  }, {
    "tStartMs": 994550,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "이게 하루에 몇 개를 제거할 수 있냐"
    } ]
  }, {
    "tStartMs": 997080,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "보통 배 한 척이 기뢰를 한 개에서"
    } ]
  }, {
    "tStartMs": 1000080,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "두 개를 하루에"
    } ]
  }, {
    "tStartMs": 1001630,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "제거 할 수 있다고 써있더라고요"
    } ]
  }, {
    "tStartMs": 1003000,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "뉴욕타임스 같은 데 보면"
    } ]
  }, {
    "tStartMs": 1004220,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "한 척에 하나를 하면"
    } ]
  }, {
    "tStartMs": 1005420,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "열 척이 뛰어들어도"
    } ]
  }, {
    "tStartMs": 1007020,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "이거 연 단위가 걸리잖아"
    } ]
  }, {
    "tStartMs": 1008930,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "두 세 개를 한다 그래도"
    } ]
  }, {
    "tStartMs": 1010380,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "수십 척이 한다"
    } ]
  }, {
    "tStartMs": 1011200,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "그래도 몇 개월에서 길면"
    } ]
  }, {
    "tStartMs": 1013160,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "1년 이상이 걸릴 수 있기 때문에"
    } ]
  }, {
    "tStartMs": 1014810,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "물론 이거를 다 설치는 못하겠지만"
    } ]
  }, {
    "tStartMs": 1016690,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "기뢰를 많이 설치하면"
    } ]
  }, {
    "tStartMs": 1017700,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "많이 설치할수록"
    } ]
  }, {
    "tStartMs": 1018530,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "호르무즈 해협이 막히는 건"
    } ]
  }, {
    "tStartMs": 1019990,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "더 오래 걸릴 수 있다는 거고"
    } ]
  }, {
    "tStartMs": 1022180,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "그리고 이란이 아마 제 생각에는"
    } ]
  }, {
    "tStartMs": 1023730,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "이렇게까지는 안 할 거예요"
    } ]
  }, {
    "tStartMs": 1025220,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "본인들도 수출을 해야 되는데"
    } ]
  }, {
    "tStartMs": 1027000,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "기뢰 깔았다가"
    } ]
  }, {
    "tStartMs": 1028350,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "기뢰에 눈 달린 것도 아니고"
    } ]
  }, {
    "tStartMs": 1029360,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "물론 본인들이 어디 깔았는지 알겠지만"
    } ]
  }, {
    "tStartMs": 1031200,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "그래도 자국 유조선들도"
    } ]
  }, {
    "tStartMs": 1033250,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "피해를 볼 수 있기 때문에"
    } ]
  }, {
    "tStartMs": 1034560,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "이렇게까지는 안 하지 않을까?"
    } ]
  }, {
    "tStartMs": 1035960,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "라고 기대를 하는데"
    } ]
  }, {
    "tStartMs": 1036950,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "또 이란도 급하면"
    } ]
  }, {
    "tStartMs": 1037720,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "자국 가까운 데 빼고는"
    } ]
  }, {
    "tStartMs": 1039420,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "설치를 할 수 있겠죠"
    } ]
  }, {
    "tStartMs": 1040850,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "그래서 얼마 전에"
    } ]
  }, {
    "tStartMs": 1041580,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "미국 중부사령부가"
    } ]
  }, {
    "tStartMs": 1042910,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "이란의 기뢰부설함 16척을 격침했다"
    } ]
  }, {
    "tStartMs": 1045420,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "걱정하지 마라"
    } ]
  }, {
    "tStartMs": 1046370,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "라고 발표를 하고"
    } ]
  }, {
    "tStartMs": 1047030,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "사진도 공개했습니다"
    } ]
  }, {
    "tStartMs": 1048620,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "이란의 기뢰부설함이라고"
    } ]
  }, {
    "tStartMs": 1050880,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "찍은 사진들을 보면"
    } ]
  }, {
    "tStartMs": 1052030,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "좀 낚싯배 같다는 생각이"
    } ]
  }, {
    "tStartMs": 1055270,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "조금 작은데"
    } ]
  }, {
    "tStartMs": 1056790,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "이건 좀 낫네"
    } ]
  }, {
    "tStartMs": 1058060,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "이것도 약간 보트 같고"
    } ]
  }, {
    "tStartMs": 1060620,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "우리나라 기뢰부설함 사진도 있는데"
    } ]
  }, {
    "tStartMs": 1062120,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "굉장히 큽니다 나름"
    } ]
  }, {
    "tStartMs": 1063240,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "이렇게 큰데"
    } ]
  }, {
    "tStartMs": 1064480,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "물론 이란이니까"
    } ]
  }, {
    "tStartMs": 1065630,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "굉장히 작은 보트 같은 것들을"
    } ]
  }, {
    "tStartMs": 1067360,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "격침했다고 발표를 했고요"
    } ]
  }, {
    "tStartMs": 1068820,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "트럼프 대통령도 기뢰에 대해서 한마디 했습니다"
    } ]
  }, {
    "tStartMs": 1071150,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "이란은 기뢰를 빠르게 제거하는 것이 좋을 것이다"
    } ]
  }, {
    "tStartMs": 1074390,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "만약에 기뢰를 제거 안 하면"
    } ]
  }, {
    "tStartMs": 1076240,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "미국은 엄청나게 화가 날 거고"
    } ]
  }, {
    "tStartMs": 1077790,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "그래서 무려 20배 강한"
    } ]
  }, {
    "tStartMs": 1079870,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "슈퍼 슈퍼 울트라 슈퍼 초강력"
    } ]
  }, {
    "tStartMs": 1081970,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "슈퍼 펀치를 날릴 것이다"
    } ]
  }, {
    "tStartMs": 1083660,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "라고 얘기를 했어요"
    } ]
  }, {
    "tStartMs": 1084580,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "이란이 만약에 기뢰 같은 걸 깔아서"
    } ]
  }, {
    "tStartMs": 1086350,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "호르무즈 해협 내 석유를 막으면"
    } ]
  }, {
    "tStartMs": 1087760,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "지금보다 20배 더 강력한"
    } ]
  }, {
    "tStartMs": 1089740,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "공격을 가할 것이다"
    } ]
  }, {
    "tStartMs": 1091040,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "그러니까 지금까지는 맛보기였다는 거죠"
    } ]
  }, {
    "tStartMs": 1093260,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "강한 거"
    } ]
  }, {
    "tStartMs": 1093950,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "위에 강한 거"
    } ]
  }, {
    "tStartMs": 1094800,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "위에 강한 거 위에 강한 거"
    } ]
  }, {
    "tStartMs": 1096210,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "위에 강한 거니까"
    } ]
  }, {
    "tStartMs": 1097520,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "20배 더 강력한 공격"
    } ]
  }, {
    "tStartMs": 1099320,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "뭐가 있을지 모르겠지만"
    } ]
  }, {
    "tStartMs": 1100750,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "그걸 가한다고 그러고"
    } ]
  }, {
    "tStartMs": 1101410,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "그리고 만약에 너희들이 그렇게 하면은"
    } ]
  }, {
    "tStartMs": 1103660,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "앞으로 미국은 이란이 국가로서"
    } ]
  }, {
    "tStartMs": 1105270,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "다시는 재건될 수 없도록"
    } ]
  }, {
    "tStartMs": 1106850,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "가능한 모든 목표를 제거할 수도 있다"
    } ]
  }, {
    "tStartMs": 1109140,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "이 말인즉슨"
    } ]
  }, {
    "tStartMs": 1110030,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "구석기 시대로 보내버릴 수도 있다"
    } ]
  }, {
    "tStartMs": 1112170,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "알아서 조심하라는 거죠"
    } ]
  }, {
    "tStartMs": 1113560,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "만약 그렇게 되면"
    } ]
  }, {
    "tStartMs": 1114560,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "죽음과 불"
    } ]
  }, {
    "tStartMs": 1115470,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "그리고 분노가 너희들을 덮칠 것이다"
    } ]
  }, {
    "tStartMs": 1118390,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "와 이거 엄청나게"
    } ]
  }, {
    "tStartMs": 1120320,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "무서운 말인데"
    } ]
  }, {
    "tStartMs": 1121450,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "데스 파이어 앤드 퓨리가"
    } ]
  }, {
    "tStartMs": 1124000,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "너희들을 그대로 덮칠 것이고"
    } ]
  }, {
    "tStartMs": 1126170,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "그러면 이란은 국가로서"
    } ]
  }, {
    "tStartMs": 1127590,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "다시는 재건될 수 없을 수도 있다"
    } ]
  }, {
    "tStartMs": 1130240,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "이 정도면 거의 뭐 뭐가 있을까요"
    } ]
  }, {
    "tStartMs": 1131770,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "거의 핵무기급의 위협이라고 보는데"
    } ]
  }, {
    "tStartMs": 1133820,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "하지만!"
    } ]
  }, {
    "tStartMs": 1134690,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "트럼프 대통령은 평화를 사랑하기 때문에"
    } ]
  }, {
    "tStartMs": 1136600,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "그런 일이 일어나는 것을 바라지 않는다"
    } ]
  }, {
    "tStartMs": 1138800,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "그러니까 조심해라"
    } ]
  }, {
    "tStartMs": 1140320,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "이렇게 SNS에 올렸죠"
    } ]
  }, {
    "tStartMs": 1141710,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "그런데 마지막에 이런 글도 올렸습니다"
    } ]
  }, {
    "tStartMs": 1143310,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "동일한 SNS에 이렇게 올렸어요"
    } ]
  }, {
    "tStartMs": 1145790,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "이렇게 호르무즈 해협의 유조선을 통과하는 것을"
    } ]
  }, {
    "tStartMs": 1148200,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "미국이 강하게 지키는 것은 선물이야"
    } ]
  }, {
    "tStartMs": 1151030,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "누구에 대한 선물이냐면"
    } ]
  }, {
    "tStartMs": 1152030,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "미국이 중국을 비롯한 호르무즈 해협을"
    } ]
  }, {
    "tStartMs": 1154830,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "자주 이용하는 국가들에게 주는 선물이야"
    } ]
  }, {
    "tStartMs": 1157150,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "부디 그들이"
    } ]
  }, {
    "tStartMs": 1158120,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "미국에 아니면 트럼프 대통령에게"
    } ]
  }, {
    "tStartMs": 1159810,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "크게 감사하길 바란다"
    } ]
  }, {
    "tStartMs": 1161660,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "라고 올려주셨는데"
    } ]
  }, {
    "tStartMs": 1163310,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "저기... 대통령님"
    } ]
  }, {
    "tStartMs": 1164710,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "중국은 중국은"
    } ]
  }, {
    "tStartMs": 1166310,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "중국은 알아서 받는 거 같은데"
    } ]
  }, {
    "tStartMs": 1167830,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "이란 거"
    } ]
  }, {
    "tStartMs": 1168790,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "못 받는 건 우리고"
    } ]
  }, {
    "tStartMs": 1170210,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "중국은 잘 받고 있어요"
    } ]
  }, {
    "tStartMs": 1171770,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "이란하고 거시기 거시기해서 가는 거 같은데"
    } ]
  }, {
    "tStartMs": 1174010,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "감사... 거기에 선물을 주고"
    } ]
  }, {
    "tStartMs": 1176700,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "통과해 드리면"
    } ]
  }, {
    "tStartMs": 1177690,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "감사하게 생각하고"
    } ]
  }, {
    "tStartMs": 1178640,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "베리베리 어프리시트긴한데"
    } ]
  }, {
    "tStartMs": 1180990,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "우리도 좀"
    } ]
  }, {
    "tStartMs": 1182980,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "호르무즈 해협을 통과할 수 있도록"
    } ]
  }, {
    "tStartMs": 1185350,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "미군이 좀 강하게 좀 해주면 안 됩니까"
    } ]
  }, {
    "tStartMs": 1187300,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "우리도 감사할 수 있도록"
    } ]
  }, {
    "tStartMs": 1188360,
    "dDurationMs": 290,
    "segs": [ {
      "utf8": "그랬더니"
    } ]
  }, {
    "tStartMs": 1188650,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "트럼프 대통령이 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1189900,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "이거 어제 나온 거죠"
    } ]
  }, {
    "tStartMs": 1191360,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "이렇게 하면 된다"
    } ]
  }, {
    "tStartMs": 1192500,
    "dDurationMs": 590,
    "segs": [ {
      "utf8": "아!"
    } ]
  }, {
    "tStartMs": 1193090,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "너희가 이란 때문에 고통을 받고 있어"
    } ]
  }, {
    "tStartMs": 1195250,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "그러면 너희들이 힘을 합쳐서"
    } ]
  }, {
    "tStartMs": 1197390,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "군대를 보내면 어떨까?"
    } ]
  }, {
    "tStartMs": 1199980,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "그럼 너희들이 고통받고 있으니까"
    } ]
  }, {
    "tStartMs": 1201580,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "너희들이 스스로 군함을 보내서 지켜보면 어떨까?"
    } ]
  }, {
    "tStartMs": 1205240,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "우리는 지금 이란하고 싸우고 있어요"
    } ]
  }, {
    "tStartMs": 1206810,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "이란을 거의 100% 이겼어"
    } ]
  }, {
    "tStartMs": 1208680,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "다 군사력을 없앴어"
    } ]
  }, {
    "tStartMs": 1209910,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "그럼 우리 싸우는 데 바쁘니까"
    } ]
  }, {
    "tStartMs": 1211870,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "그렇게 고통을 받는다면"
    } ]
  }, {
    "tStartMs": 1213130,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "너희들이 스스로 하면 되겠네"
    } ]
  }, {
    "tStartMs": 1215570,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "좋은 아이디어죠?"
    } ]
  }, {
    "tStartMs": 1216570,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "그래서 이란이 해역 폐쇄를 해서"
    } ]
  }, {
    "tStartMs": 1218930,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "너무나 피해를 입은 국가들이 많다"
    } ]
  }, {
    "tStartMs": 1220370,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "그 국가들이 모여서"
    } ]
  }, {
    "tStartMs": 1222110,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "호르무즈 해협을 안전하게 개방하고"
    } ]
  }, {
    "tStartMs": 1224110,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "안전하게 유지하면 얼마나 좋겠냐"
    } ]
  }, {
    "tStartMs": 1225840,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "그러니까 알아서"
    } ]
  }, {
    "tStartMs": 1227020,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "군함들 보내세요"
    } ]
  }, {
    "tStartMs": 1227960,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "중국, 프랑스, 일본, 한국, 영국 좋습니다"
    } ]
  }, {
    "tStartMs": 1232880,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "이런 국가들을 와서 군함을 보내서"
    } ]
  }, {
    "tStartMs": 1234510,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "안전하게 유조선 호위하면 되잖아"
    } ]
  }, {
    "tStartMs": 1236490,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "너희들이 석유값 고민하고"
    } ]
  }, {
    "tStartMs": 1238070,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "석화 어렵고 와서"
    } ]
  }, {
    "tStartMs": 1239310,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "군함을 보내서 호위를 해가라"
    } ]
  }, {
    "tStartMs": 1240980,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "라고 얘기를 했는데"
    } ]
  }, {
    "tStartMs": 1243220,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "갑자기 우리 보고"
    } ]
  }, {
    "tStartMs": 1245200,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "군함을 보내라고 호위니까"
    } ]
  }, {
    "tStartMs": 1248320,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "전쟁에 참여라는 건 호위니까 음..."
    } ]
  }, {
    "tStartMs": 1251200,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "물론 그 중국, 프랑스, 일본, 한국, 영국"
    } ]
  }, {
    "tStartMs": 1255100,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "왠지 그 세계에서"
    } ]
  }, {
    "tStartMs": 1256030,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "가장 강력한 5개 국가라고 얘기해도"
    } ]
  }, {
    "tStartMs": 1258340,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "별로 밀릴 것 같지 않은"
    } ]
  }, {
    "tStartMs": 1259300,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "그 사이에 이제 우리가 들어가서"
    } ]
  }, {
    "tStartMs": 1261410,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "영국, 프랑스, 중국 사이에 들어간 것은"
    } ]
  }, {
    "tStartMs": 1263730,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "좀 나쁘지 않아 보이는데"
    } ]
  }, {
    "tStartMs": 1265620,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "일본은 빼고"
    } ]
  }, {
    "tStartMs": 1267100,
    "dDurationMs": 380,
    "segs": [ {
      "utf8": "그쵸"
    } ]
  }, {
    "tStartMs": 1267480,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "요정도 위상은 나쁘진 않는데"
    } ]
  }, {
    "tStartMs": 1269480,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "거기에 딱 껴준 거니까"
    } ]
  }, {
    "tStartMs": 1271210,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "나쁘진 않는데"
    } ]
  }, {
    "tStartMs": 1271890,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "인정해 준 건 나쁘지 않지만"
    } ]
  }, {
    "tStartMs": 1274560,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "전쟁을 일으켜놓고..."
    } ]
  }, {
    "tStartMs": 1275570,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "아니 죄송합니다"
    } ]
  }, {
    "tStartMs": 1276410,
    "dDurationMs": 5540,
    "segs": [ {
      "utf8": "아니 그래서 우리 군함 갔다가 공격 받으면 어떡해"
    } ]
  }, {
    "tStartMs": 1281950,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "이란이 또 우리 타겟으로 삼으면 어떡해"
    } ]
  }, {
    "tStartMs": 1284800,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "했더니 트럼프 대통령이 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1286250,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "아, 걱정하지 마"
    } ]
  }, {
    "tStartMs": 1287650,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "이란의 군사력은 이미 100% 파괴했어"
    } ]
  }, {
    "tStartMs": 1290110,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "없어, 걔네 없어"
    } ]
  }, {
    "tStartMs": 1291200,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "미군이 이미 이겼어, 이미 이겼다니까"
    } ]
  }, {
    "tStartMs": 1293820,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "이란 군사력 없어"
    } ]
  }, {
    "tStartMs": 1295420,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "걔네 지금 지도자가 누군지도 모른다"
    } ]
  }, {
    "tStartMs": 1297090,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "참모 총장이 누군지, 자문이 누군지 다 없어"
    } ]
  }, {
    "tStartMs": 1299090,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "아무도 없고, 이란은 그저"
    } ]
  }, {
    "tStartMs": 1300700,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "드론 한 두대 깔까?"
    } ]
  }, {
    "tStartMs": 1302860,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "그저 기뢰나"
    } ]
  }, {
    "tStartMs": 1304290,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "그냥 몇 개 설치하고"
    } ]
  }, {
    "tStartMs": 1305590,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "6천 대 있다고"
    } ]
  }, {
    "tStartMs": 1306740,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "허장성세 부리는 거지"
    } ]
  }, {
    "tStartMs": 1307780,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "없어 없어"
    } ]
  }, {
    "tStartMs": 1308390,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "근거리 미사일"
    } ]
  }, {
    "tStartMs": 1309100,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "뭐 이런 거나 날라오고"
    } ]
  }, {
    "tStartMs": 1310400,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "군사력은 우리가 다 파괴했기 때문에"
    } ]
  }, {
    "tStartMs": 1312050,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "코리아야 걱정하지 마"
    } ]
  }, {
    "tStartMs": 1313560,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "걱정하지 말고"
    } ]
  }, {
    "tStartMs": 1314490,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "니들 유조선 호위해서 가면 되잖아"
    } ]
  }, {
    "tStartMs": 1316860,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "아무 걱정할 필요가 없다"
    } ]
  }, {
    "tStartMs": 1318540,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "라고 얘기를 하셨죠"
    } ]
  }, {
    "tStartMs": 1320780,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "우리나라 정부는"
    } ]
  }, {
    "tStartMs": 1322660,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "갑자기 뜬금"
    } ]
  }, {
    "tStartMs": 1323920,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "아마 주말에 어?"
    } ]
  }, {
    "tStartMs": 1324720,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "이거 뭐야?"
    } ]
  }, {
    "tStartMs": 1326280,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "군함 파견 요구가 나왔기 때문에"
    } ]
  }, {
    "tStartMs": 1328290,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "일단 신중하고 원론적인 답변"
    } ]
  }, {
    "tStartMs": 1330290,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "한미 간 긴밀하게 소통해서"
    } ]
  }, {
    "tStartMs": 1332130,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "신중히 검토해서 판단하겠다"
    } ]
  }, {
    "tStartMs": 1334000,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "우리 국민 보호와 에너지 수송도"
    } ]
  }, {
    "tStartMs": 1335220,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "안전 확보를 위한 방안을"
    } ]
  }, {
    "tStartMs": 1336550,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "종합적으로 고려하고"
    } ]
  }, {
    "tStartMs": 1337720,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "다각적으로 모색하고 있다라고 답변을 했습니다"
    } ]
  }, {
    "tStartMs": 1341600,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "호르무즈 해협이 저렇게 또 위협을 받으니까"
    } ]
  }, {
    "tStartMs": 1343650,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "트럼프 대통령이 또 한마디도 했어요"
    } ]
  }, {
    "tStartMs": 1345030,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "이번에 새로운 전략을 제시했습니다"
    } ]
  }, {
    "tStartMs": 1347210,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "이것 때문에 또 굉장히 또 파장이 커지고 있는데"
    } ]
  }, {
    "tStartMs": 1349870,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "이건 뭐냐"
    } ]
  }, {
    "tStartMs": 1350980,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "이란이 이런 식으로 거기를 막고"
    } ]
  }, {
    "tStartMs": 1353810,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "세계 원유 가격에 영향을 주고"
    } ]
  }, {
    "tStartMs": 1355650,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "유가 급등을 획책을 하면"
    } ]
  }, {
    "tStartMs": 1357920,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "미국도 가만히 있지 않겠다"
    } ]
  }, {
    "tStartMs": 1359900,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "이란 석유 허브를"
    } ]
  }, {
    "tStartMs": 1361670,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "공격할 수도 있다"
    } ]
  }, {
    "tStartMs": 1363990,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "되게 센 말인데"
    } ]
  }, {
    "tStartMs": 1365320,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "지금까지 미국은 이란의 군사시설을 폭격하고"
    } ]
  }, {
    "tStartMs": 1368770,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "어떤 지휘자들을 폭격하고"
    } ]
  }, {
    "tStartMs": 1370160,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "암살하고 했지만"
    } ]
  }, {
    "tStartMs": 1371540,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "이란의 석유 생산 기지를 공격하지는 않았어요"
    } ]
  }, {
    "tStartMs": 1374740,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "이란의 원전"
    } ]
  }, {
    "tStartMs": 1375740,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "아니면 이란의 석유 수송로에서 모아두는 데"
    } ]
  }, {
    "tStartMs": 1378540,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "유전 탱크, 이란의 유조선"
    } ]
  }, {
    "tStartMs": 1380690,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "이런 석유 관련 시설을 공격하지는 않았습니다"
    } ]
  }, {
    "tStartMs": 1383340,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "만약에"
    } ]
  }, {
    "tStartMs": 1384520,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "만약에 공격하면 어떻게 될까?"
    } ]
  }, {
    "tStartMs": 1386530,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "이 얘기를 한 이유는"
    } ]
  }, {
    "tStartMs": 1387300,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "미국이 지난 금요일 밤에"
    } ]
  }, {
    "tStartMs": 1388460,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "하르그 섬이라고 불리는"
    } ]
  }, {
    "tStartMs": 1389800,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "여기가 어디냐면은"
    } ]
  }, {
    "tStartMs": 1390850,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "이란의 석유 집결지라고 보면 돼요"
    } ]
  }, {
    "tStartMs": 1393760,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "배에 싣고 나갈 석유를 집결하는 데입니다"
    } ]
  }, {
    "tStartMs": 1395760,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "이렇게 파이프 연결이 돼 있어요"
    } ]
  }, {
    "tStartMs": 1397380,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "여기를 폭격했습니다"
    } ]
  }, {
    "tStartMs": 1399060,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "폭격하면서 트럼프 대통령이 이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 1401430,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "내가 너무나 도덕적이기 때문에"
    } ]
  }, {
    "tStartMs": 1403530,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "섬의 석유 시설은 아직 파괴하지 않았다"
    } ]
  }, {
    "tStartMs": 1406000,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "잘 생각해라"
    } ]
  }, {
    "tStartMs": 1407590,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "공격할 수 있다는 거죠"
    } ]
  }, {
    "tStartMs": 1408830,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "카르그 섬이라는 데는"
    } ]
  }, {
    "tStartMs": 1410540,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "이란 왼쪽 위에 있는 섬입니다"
    } ]
  }, {
    "tStartMs": 1411960,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "여기 해협에 있는 섬이 아니라"
    } ]
  }, {
    "tStartMs": 1413500,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "저 위쪽에 있는데"
    } ]
  }, {
    "tStartMs": 1414720,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "여기에 이제 이란 석유 수출양의"
    } ]
  }, {
    "tStartMs": 1416830,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "90%가 모이는 곳으로 알려져 있어요"
    } ]
  }, {
    "tStartMs": 1419140,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "여기서 이제 뭐 배로 한다든지"
    } ]
  }, {
    "tStartMs": 1420960,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "이렇게 나르겠죠"
    } ]
  }, {
    "tStartMs": 1422110,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "여기를 만약에 공격을 하게 되거나"
    } ]
  }, {
    "tStartMs": 1425130,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "아니면 이란 내부에 있는 유전"
    } ]
  }, {
    "tStartMs": 1427030,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "이란 내부에 있는"
    } ]
  }, {
    "tStartMs": 1428020,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "또 석유 집결지"
    } ]
  }, {
    "tStartMs": 1429150,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "이런 데를 미국과 이스라엘이 마음 먹고"
    } ]
  }, {
    "tStartMs": 1431550,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "타격을 날리면"
    } ]
  }, {
    "tStartMs": 1433180,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "유가는 더 올라가겠죠"
    } ]
  }, {
    "tStartMs": 1434570,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "유가는 더 올라가고"
    } ]
  }, {
    "tStartMs": 1436480,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "진짜 세계적인 난리가 날 것 같은데"
    } ]
  }, {
    "tStartMs": 1438770,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "왜냐하면 이란도 이렇게 얘기했거든요"
    } ]
  }, {
    "tStartMs": 1440770,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "미국이 만약에 이란 내 석유시설을 공격하면"
    } ]
  }, {
    "tStartMs": 1443970,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "자기들도 미국과 협력하는 지역 내"
    } ]
  }, {
    "tStartMs": 1446520,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "모든 석유 회사에"
    } ]
  }, {
    "tStartMs": 1448310,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "석유 및 에너지 시설을 즉시 공격할 것이다"
    } ]
  }, {
    "tStartMs": 1451600,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "그들을 잿더미로 만들 것이다"
    } ]
  }, {
    "tStartMs": 1453460,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "라고 또 협박을 하고 있습니다"
    } ]
  }, {
    "tStartMs": 1455300,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "그 말인즉슨 만약에"
    } ]
  }, {
    "tStartMs": 1456970,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "미국이 본인들의 석유 시설을 공격하면"
    } ]
  }, {
    "tStartMs": 1460120,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "이란도 여기, 여기, 여기"
    } ]
  }, {
    "tStartMs": 1463460,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "여기, 여기, 이런 데 있는"
    } ]
  }, {
    "tStartMs": 1465680,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "사우디아라비아, 카타르, 아랍에미리트"
    } ]
  }, {
    "tStartMs": 1468820,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "바레인 이런 데 있는 데를"
    } ]
  }, {
    "tStartMs": 1470250,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "이라크"
    } ]
  }, {
    "tStartMs": 1471360,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "이라크는 친하니까 모르겠네"
    } ]
  }, {
    "tStartMs": 1473350,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "이라크는 뺄까요?"
    } ]
  }, {
    "tStartMs": 1474650,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "이런 석유시설을 공격할 수 있다는 거죠"
    } ]
  }, {
    "tStartMs": 1476990,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "여기를 막는 거는 당연하고"
    } ]
  }, {
    "tStartMs": 1479390,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "이렇게 되면 진짜 200달러입니다"
    } ]
  }, {
    "tStartMs": 1481060,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "여기 공격받으면"
    } ]
  }, {
    "tStartMs": 1482460,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "여기 저것도 있어요"
    } ]
  }, {
    "tStartMs": 1483620,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "파이프라인도 있어요"
    } ]
  }, {
    "tStartMs": 1484730,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "사우디 석유로 가는 송류관들도 있기 때문에"
    } ]
  }, {
    "tStartMs": 1487200,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "물론 방어를 하겠지만"
    } ]
  }, {
    "tStartMs": 1488730,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "이란이 공격할 능력이 얼마나 되는지 모르겠지만"
    } ]
  }, {
    "tStartMs": 1491200,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "저기를 공격해서 불이 나고"
    } ]
  }, {
    "tStartMs": 1493500,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "사우디에 어디가 터지고"
    } ]
  }, {
    "tStartMs": 1495440,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "그러면 난리 나겠죠"
    } ]
  }, {
    "tStartMs": 1497270,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "게다가 카르그섬 위협을 한 다음에"
    } ]
  }, {
    "tStartMs": 1499740,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "새로운 뉴스도 떴는데"
    } ]
  }, {
    "tStartMs": 1500930,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "이것도 되게 의미심장한 뉴스였죠"
    } ]
  }, {
    "tStartMs": 1503190,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "주일 미군에 있던 미국 해병대가"
    } ]
  }, {
    "tStartMs": 1504990,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "중동으로 이동한다는 뉴스가 떴습니다"
    } ]
  }, {
    "tStartMs": 1507010,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "일본 오키나와에 있던 미 해병대가"
    } ]
  }, {
    "tStartMs": 1509090,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "해군 함정을 이용해서"
    } ]
  }, {
    "tStartMs": 1510020,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "중동으로 이동해서 배치가 됐다"
    } ]
  }, {
    "tStartMs": 1512180,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "이 부대는 2,200명 이상의"
    } ]
  }, {
    "tStartMs": 1513500,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "해병대원으로 구성되며"
    } ]
  }, {
    "tStartMs": 1515330,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "2,000명 이상의 해군 병력도"
    } ]
  }, {
    "tStartMs": 1516580,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "추가될 거라고 얘기를 했는데"
    } ]
  }, {
    "tStartMs": 1518480,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "해병대를 보냈다"
    } ]
  }, {
    "tStartMs": 1520830,
    "dDurationMs": 3730,
    "segs": [ {
      "utf8": "해병대는 보통 상륙작전 같은 거 하잖아요"
    } ]
  }, {
    "tStartMs": 1524560,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "아 그래서 아 물론 그냥 뭐"
    } ]
  }, {
    "tStartMs": 1526720,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "호르무즈 해협을 지키거나 할 때도"
    } ]
  }, {
    "tStartMs": 1527850,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "해병대가 필요하죠"
    } ]
  }, {
    "tStartMs": 1529070,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "배 같은 거 호위하고 할 때"
    } ]
  }, {
    "tStartMs": 1530060,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "그럴 때 썼을 거라고 생각은 하는데"
    } ]
  }, {
    "tStartMs": 1533920,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "해병대 갔다니까"
    } ]
  }, {
    "tStartMs": 1535080,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "또 괜히 확전 우려가 또 있는 거고"
    } ]
  }, {
    "tStartMs": 1537250,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "일본에 있던 주일미군도 이동을 시키는 거고"
    } ]
  }, {
    "tStartMs": 1539410,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "우리나라에서도 뭐 사드 같은 거 이동했다"
    } ]
  }, {
    "tStartMs": 1541640,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "그런 얘기가 나오니까"
    } ]
  }, {
    "tStartMs": 1542950,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "아시아에 배치돼 있던 미군 전력들이"
    } ]
  }, {
    "tStartMs": 1544990,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "또 이동하는 거 아니냐"
    } ]
  }, {
    "tStartMs": 1545790,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "이런 우려도 많이 나오죠"
    } ]
  }, {
    "tStartMs": 1547350,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "그래서 사람들은 물어봤습니다"
    } ]
  }, {
    "tStartMs": 1548980,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "야 전쟁이 잘못하면"
    } ]
  }, {
    "tStartMs": 1550330,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "해병대원도 가고"
    } ]
  }, {
    "tStartMs": 1551910,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "거기 뭐 저 카르그선"
    } ]
  }, {
    "tStartMs": 1553310,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "만약 이런 데"
    } ]
  }, {
    "tStartMs": 1554200,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "미국 해병대가 내려버리면"
    } ]
  }, {
    "tStartMs": 1555880,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "상륙작전을 하면"
    } ]
  }, {
    "tStartMs": 1557490,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "그래서 이란이 사우디로"
    } ]
  }, {
    "tStartMs": 1558560,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "미사일을 대거 날리고"
    } ]
  }, {
    "tStartMs": 1559660,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "유전으로 막 드론 날리고"
    } ]
  }, {
    "tStartMs": 1561510,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "이러면 전쟁이 더 확전되는 거 아니냐"
    } ]
  }, {
    "tStartMs": 1563960,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "언제 끝나냐"
    } ]
  }, {
    "tStartMs": 1565080,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "트럼프 대통령은 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1566880,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "언제 끝나냐는 걸 고민할 필요 없어요"
    } ]
  }, {
    "tStartMs": 1569590,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "왜냐하면 이미 이겼거든요"
    } ]
  }, {
    "tStartMs": 1572040,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "이미 이겼어"
    } ]
  }, {
    "tStartMs": 1573470,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "아니 우린 이겼다니까"
    } ]
  }, {
    "tStartMs": 1574650,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "개전 1시간 만에 헤드를 날렸잖아"
    } ]
  }, {
    "tStartMs": 1577110,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "포스를 날리고 지금 이겼어"
    } ]
  }, {
    "tStartMs": 1579260,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "이란은 거의 100% 망했어"
    } ]
  }, {
    "tStartMs": 1581630,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "군사력이 남아있는 게 없어"
    } ]
  }, {
    "tStartMs": 1582920,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "그냥 간헐적으로 덤빌 뿐이지"
    } ]
  }, {
    "tStartMs": 1584520,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "사실상 이겼기 때문에"
    } ]
  }, {
    "tStartMs": 1586350,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "너무 걱정할 필요가 없다"
    } ]
  }, {
    "tStartMs": 1587940,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "그리고 며칠 전에는"
    } ]
  }, {
    "tStartMs": 1589180,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "유가 너무 오르는 거 아닙니까?"
    } ]
  }, {
    "tStartMs": 1590370,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "그랬더니 그것도 걱정할 필요 없다"
    } ]
  }, {
    "tStartMs": 1592190,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "왜냐하면"
    } ]
  }, {
    "tStartMs": 1593020,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "미국은 세계 최대의 산유국이고"
    } ]
  }, {
    "tStartMs": 1595160,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "격차도 매우 커요"
    } ]
  }, {
    "tStartMs": 1596100,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "우리가 1등이야"
    } ]
  }, {
    "tStartMs": 1597090,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "유가가 오르면"
    } ]
  }, {
    "tStartMs": 1598090,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "우리는 많은 돈을 벌어요"
    } ]
  }, {
    "tStartMs": 1600100,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "그래요"
    } ]
  }, {
    "tStartMs": 1601250,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "뭐 그럴 수도 있죠"
    } ]
  }, {
    "tStartMs": 1602160,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "세계 최대의 산유국이니까"
    } ]
  }, {
    "tStartMs": 1603440,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "근데 많은 돈을 번다기보단"
    } ]
  }, {
    "tStartMs": 1605560,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "막 수출하는 건 아니니까"
    } ]
  }, {
    "tStartMs": 1607300,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "좀 유리할 수는 있죠"
    } ]
  }, {
    "tStartMs": 1608830,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "우리는 수입해야 되는 거고"
    } ]
  }, {
    "tStartMs": 1610270,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "근데 그렇게 생각하시면"
    } ]
  }, {
    "tStartMs": 1612100,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "아, 알아요"
    } ]
  }, {
    "tStartMs": 1612990,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "그래서 내가"
    } ]
  }, {
    "tStartMs": 1613960,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "그렇게는 안 생각해"
    } ]
  }, {
    "tStartMs": 1615230,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "돈만 바라면은 그럴 수 있지만"
    } ]
  }, {
    "tStartMs": 1616900,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "난 그런 사람 아니죠"
    } ]
  }, {
    "tStartMs": 1618320,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "나는 그냥 평화"
    } ]
  }, {
    "tStartMs": 1620000,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "이런 게 더 중요한 사람이니까"
    } ]
  }, {
    "tStartMs": 1621510,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "나에게 더 큰 관심사고"
    } ]
  }, {
    "tStartMs": 1622770,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "더 중요한 일은"
    } ]
  }, {
    "tStartMs": 1623800,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "악의 제국인 이란이"
    } ]
  }, {
    "tStartMs": 1625330,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "핵무기를 못 갖게 하고"
    } ]
  }, {
    "tStartMs": 1626760,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "세계를 파괴하는 걸 막는 거기 때문에"
    } ]
  }, {
    "tStartMs": 1628800,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "돈은 생각하지 않아"
    } ]
  }, {
    "tStartMs": 1630090,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "돈만 생각하면"
    } ]
  }, {
    "tStartMs": 1630810,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "뭐 유가만 더 올리고 그렇겠지만"
    } ]
  }, {
    "tStartMs": 1632370,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "나는 그렇지 않고"
    } ]
  }, {
    "tStartMs": 1633340,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "오히려 그런 일이 벌어지도록"
    } ]
  }, {
    "tStartMs": 1634960,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "가만히 놔두지는 않을 것이다"
    } ]
  }, {
    "tStartMs": 1636550,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "라고 얘기를 하면서"
    } ]
  }, {
    "tStartMs": 1638110,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "높은 석유가격 어떻게 합니까?"
    } ]
  }, {
    "tStartMs": 1639580,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "그랬더니 요것도"
    } ]
  }, {
    "tStartMs": 1640520,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "JD 벤스 부통령이 뭐라고 그랬습니까?"
    } ]
  }, {
    "tStartMs": 1642060,
    "dDurationMs": 670,
    "segs": [ {
      "utf8": "아, 그거?"
    } ]
  }, {
    "tStartMs": 1642730,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "그건 바이든 때문이다"
    } ]
  }, {
    "tStartMs": 1646750,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "이건 또 왜 바이든 휘발유"
    } ]
  }, {
    "tStartMs": 1649360,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "바이든 아저씨가 휘발유 많이 쓰시나?"
    } ]
  }, {
    "tStartMs": 1651960,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "봤더니 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1653270,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "오늘 휘발유 가격이 이렇게"
    } ]
  }, {
    "tStartMs": 1654430,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "높은 건 잘 생각해봐요"
    } ]
  }, {
    "tStartMs": 1656140,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "옛날에 바이든이 엄청나게"
    } ]
  }, {
    "tStartMs": 1658120,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "높은 휘발유 가격을 만들어서"
    } ]
  }, {
    "tStartMs": 1660810,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "그래서 트럼프 대통령이 낮추려고"
    } ]
  }, {
    "tStartMs": 1662120,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "노력을 했어 이렇게"
    } ]
  }, {
    "tStartMs": 1663700,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "그렇기 때문에 바이든 때문이지"
    } ]
  }, {
    "tStartMs": 1664860,
    "dDurationMs": 650,
    "segs": [ {
      "utf8": "지금 올라갔는데"
    } ]
  }, {
    "tStartMs": 1665510,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "그거는 조금 어려운 거지"
    } ]
  }, {
    "tStartMs": 1667580,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "옛날 바이든 때 봐요"
    } ]
  }, {
    "tStartMs": 1668340,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "바이든 엄청 높았어요 엄청"
    } ]
  }, {
    "tStartMs": 1669820,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "고점 안왔다  그때"
    } ]
  }, {
    "tStartMs": 1670840,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "그때 고점 엄청 높았는데"
    } ]
  }, {
    "tStartMs": 1672090,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "트럼프 대통령이 계속 노력을 했어"
    } ]
  }, {
    "tStartMs": 1674090,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "그렇기 때문에 바이든 시절에"
    } ]
  }, {
    "tStartMs": 1675200,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "터무니없이 생각한 걸 보면"
    } ]
  }, {
    "tStartMs": 1676620,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "우리가 이런 상황에서"
    } ]
  }, {
    "tStartMs": 1677950,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "정권을 받았기 때문에"
    } ]
  }, {
    "tStartMs": 1679440,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "노력을 해서 조금 낮추고"
    } ]
  }, {
    "tStartMs": 1680630,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "요즘에 조금 오른 것 뿐이지"
    } ]
  }, {
    "tStartMs": 1681670,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "그래서 오른 건 누구 때문이다?"
    } ]
  }, {
    "tStartMs": 1683030,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "바이든 때문이다"
    } ]
  }, {
    "tStartMs": 1684090,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "이건 내려간 거야"
    } ]
  }, {
    "tStartMs": 1685410,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "낮춰서 이 정도이기 때문이니까"
    } ]
  }, {
    "tStartMs": 1687320,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "바이든이 역시 문제가 아닐까라고 생각합니다"
    } ]
  }, {
    "tStartMs": 1689540,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "라고 얘기를 했고요"
    } ]
  }, {
    "tStartMs": 1690720,
    "dDurationMs": 670,
    "segs": [ {
      "utf8": "많은 언론에서"
    } ]
  }, {
    "tStartMs": 1691390,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "아, 이게 말이 됩니까?"
    } ]
  }, {
    "tStartMs": 1692440,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "그게 어떻게 바이든 때문입니까?"
    } ]
  }, {
    "tStartMs": 1693660,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "전쟁하고 그래서 그런 거 아니에요"
    } ]
  }, {
    "tStartMs": 1695520,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "그때 트럼프 대통령이"
    } ]
  }, {
    "tStartMs": 1696220,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1697160,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "에헤이!"
    } ]
  }, {
    "tStartMs": 1697980,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "언론 좀 믿지마"
    } ]
  }, {
    "tStartMs": 1699320,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "그런 쓰레기 같은 언론을 자꾸 믿으니까"
    } ]
  }, {
    "tStartMs": 1702200,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "그런 망해가는 뉴욕 뭐?"
    } ]
  }, {
    "tStartMs": 1704310,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "페일링 뉴욕타임스"
    } ]
  }, {
    "tStartMs": 1705700,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "아유 걔네 맨날 뭐 쓰는 거"
    } ]
  }, {
    "tStartMs": 1707410,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "괴발개발 쓰는데"
    } ]
  }, {
    "tStartMs": 1708770,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "그런 거 자꾸 믿으니까"
    } ]
  }, {
    "tStartMs": 1709820,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "가짜뉴스에 속는 겁니다"
    } ]
  }, {
    "tStartMs": 1711380,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "우리가 이기고 있어요"
    } ]
  }, {
    "tStartMs": 1712970,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "뉴욕타임스를 읽으면"
    } ]
  }, {
    "tStartMs": 1713820,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "자꾸 우리가 지는 것처럼 얘기하고"
    } ]
  }, {
    "tStartMs": 1715200,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "유가 맨날 오르는 것처럼 얘기하죠"
    } ]
  }, {
    "tStartMs": 1716480,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "가짜뉴스야"
    } ]
  }, {
    "tStartMs": 1717500,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "그런 거 믿지마"
    } ]
  }, {
    "tStartMs": 1718310,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "우리가 이기고 있어요"
    } ]
  }, {
    "tStartMs": 1719540,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "라고 본인 엑스에 올리셨고요"
    } ]
  }, {
    "tStartMs": 1721420,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "이걸 딱 엑스에 올린 다음에"
    } ]
  }, {
    "tStartMs": 1723070,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "미국의 연방통신위원회 위원장"
    } ]
  }, {
    "tStartMs": 1725490,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "우리 우리로 뭐 방미통위"
    } ]
  }, {
    "tStartMs": 1726790,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "이런 데라고 보면 되죠"
    } ]
  }, {
    "tStartMs": 1727860,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "거기 위원장 브랜더 카라고 있습니다"
    } ]
  }, {
    "tStartMs": 1729890,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "굉장히 강력한 인물이죠"
    } ]
  }, {
    "tStartMs": 1731090,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "강성 인물로 유명한 사람인데"
    } ]
  }, {
    "tStartMs": 1733050,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "이분도 SNS에 올렸어요"
    } ]
  }, {
    "tStartMs": 1734720,
    "dDurationMs": 490,
    "segs": [ {
      "utf8": "뭐라고 올렸냐"
    } ]
  }, {
    "tStartMs": 1735210,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1736290,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "트럼프 대통령의 그 SNS를"
    } ]
  }, {
    "tStartMs": 1737790,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "아래다가 리트윗을 했어요"
    } ]
  }, {
    "tStartMs": 1739230,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "그러면서 이런 말을 했어요"
    } ]
  }, {
    "tStartMs": 1740420,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "뉴욕타임스죠 여기선"
    } ]
  }, {
    "tStartMs": 1741890,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "뉴욕타임스처럼"
    } ]
  }, {
    "tStartMs": 1743060,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "가짜 뉴스, 허위 사실 유포"
    } ]
  }, {
    "tStartMs": 1744890,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "뉴스 왜곡"
    } ]
  }, {
    "tStartMs": 1746030,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "이런 걸 일삼는 방송사들은"
    } ]
  }, {
    "tStartMs": 1748110,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "면허 갱신 전에"
    } ]
  }, {
    "tStartMs": 1749430,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "방향을 바로잡을 기회를 주겠다"
    } ]
  }, {
    "tStartMs": 1752350,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "무슨 말입니까?"
    } ]
  }, {
    "tStartMs": 1753260,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "가짜뉴스나 허위사실을 유포하는 언론사들은"
    } ]
  }, {
    "tStartMs": 1756050,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "이번이 마지막 기회인지 알아라"
    } ]
  }, {
    "tStartMs": 1758240,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "만약에 전쟁이 불리하다든지"
    } ]
  }, {
    "tStartMs": 1760350,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "전쟁이 잘못되고 있다든지"
    } ]
  }, {
    "tStartMs": 1761650,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "이런 거 가짜죠?"
    } ]
  }, {
    "tStartMs": 1762360,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "사실 이겼는데"
    } ]
  }, {
    "tStartMs": 1763720,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "전쟁에 비판적인 보도를 한"
    } ]
  }, {
    "tStartMs": 1765240,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "언론사는 면허를 잃게 될 수 있다"
    } ]
  }, {
    "tStartMs": 1768050,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "뉴욕타임스가 언론사 면허를"
    } ]
  }, {
    "tStartMs": 1770490,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "잃을 수도 있습니다"
    } ]
  }, {
    "tStartMs": 1772470,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "그래서 언론의 자유를 통제하는 법은"
    } ]
  }, {
    "tStartMs": 1774540,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "저는 굉장히 위험하다고 봅니다"
    } ]
  }, {
    "tStartMs": 1775920,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "뭐가 가짜뉴스입니까?"
    } ]
  }, {
    "tStartMs": 1777730,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "알기 힘든 거예요"
    } ]
  }, {
    "tStartMs": 1779010,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "뭐가 허위사실이냐?"
    } ]
  }, {
    "tStartMs": 1780580,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "물론 정말 전형적인 가짜 뉴스들이 있죠 있지만"
    } ]
  }, {
    "tStartMs": 1783880,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "어쨌건 정권이 권력을 잡으면"
    } ]
  }, {
    "tStartMs": 1785880,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "지금 뉴욕타임스를 얘기를 하는 거니까"
    } ]
  }, {
    "tStartMs": 1788970,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "이렇게 얘기합니다"
    } ]
  }, {
    "tStartMs": 1789630,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "방송사는 공익을 위해 운영해야 되며"
    } ]
  }, {
    "tStartMs": 1791810,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "그렇지 않을 경우"
    } ]
  }, {
    "tStartMs": 1792590,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "면허를 잃게 됩니다"
    } ]
  }, {
    "tStartMs": 1793550,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "여기서 말하는 공익은"
    } ]
  }, {
    "tStartMs": 1794910,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "미국이 승리하고"
    } ]
  }, {
    "tStartMs": 1796330,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "위대한 미국이 이란을 어떻게 하고 있고"
    } ]
  }, {
    "tStartMs": 1798270,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "트럼프 대통령이 잘하고 있고"
    } ]
  }, {
    "tStartMs": 1799590,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "뭐 이런 걸 얘기하는 거겠죠"
    } ]
  }, {
    "tStartMs": 1800950,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "그렇지 않을 경우에"
    } ]
  }, {
    "tStartMs": 1802210,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "면허를 잃게 될 수 있다"
    } ]
  }, {
    "tStartMs": 1803950,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "라고 위원장이"
    } ]
  }, {
    "tStartMs": 1804860,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "본인 SNS에 올렸다고 보시면 되고요"
    } ]
  }, {
    "tStartMs": 1807680,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1809120,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "연방통신위원회 위원장인데"
    } ]
  }, {
    "tStartMs": 1810930,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "위원장이 이런 얘기를 했어요"
    } ]
  }, {
    "tStartMs": 1812100,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "한 정치후보가 허위사실과"
    } ]
  }, {
    "tStartMs": 1814290,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "왜곡된 정보에도 불구하고"
    } ]
  }, {
    "tStartMs": 1815750,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "압도적인 표차로 선거에서 이겼잖아요"
    } ]
  }, {
    "tStartMs": 1818500,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "근데 언론에서는 맨날 진대"
    } ]
  }, {
    "tStartMs": 1820150,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "언론에서는 맨날 허위사실을 얘기하고"
    } ]
  }, {
    "tStartMs": 1821480,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "맨날 왜곡된 정보를 이야기해"
    } ]
  }, {
    "tStartMs": 1823140,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "근데 선거하면 이겨"
    } ]
  }, {
    "tStartMs": 1824760,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "누구라고 얘기 안 하지만"
    } ]
  }, {
    "tStartMs": 1825910,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "이 정치후보 그 대통령도 됐어"
    } ]
  }, {
    "tStartMs": 1827950,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "그럼 뭡니까?"
    } ]
  }, {
    "tStartMs": 1828990,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "그동안 허위사실과 왜곡된 정보를 했던"
    } ]
  }, {
    "tStartMs": 1831050,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "그 언론들이 무엇인가"
    } ]
  }, {
    "tStartMs": 1832290,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "심각하게 잘못된 거죠"
    } ]
  }, {
    "tStartMs": 1834130,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "뭐 해리스 어쩌고"
    } ]
  }, {
    "tStartMs": 1835000,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "애들은 잘못된 거야"
    } ]
  }, {
    "tStartMs": 1835690,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "이긴다 뭐 어떻게 잘못된 거야"
    } ]
  }, {
    "tStartMs": 1837340,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "허위 사실을 공표한 거야"
    } ]
  }, {
    "tStartMs": 1838740,
    "dDurationMs": 630,
    "segs": [ {
      "utf8": "뭡니까?"
    } ]
  }, {
    "tStartMs": 1839370,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "언론은 신뢰를 잃었죠"
    } ]
  }, {
    "tStartMs": 1841120,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "지금이 변화가 필요한 때입니다"
    } ]
  }, {
    "tStartMs": 1842500,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "기회 한 번 줄게 잘해라 잘해라"
    } ]
  }, {
    "tStartMs": 1844990,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "잘하지 않으면은"
    } ]
  }, {
    "tStartMs": 1846300,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "면허를 잃을 수도 있다"
    } ]
  }, {
    "tStartMs": 1848110,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "물론 협박이겠지만"
    } ]
  }, {
    "tStartMs": 1849910,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "실제로 언론사 면허를 뭐 박탈하진 않겠지만"
    } ]
  }, {
    "tStartMs": 1853200,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "어쨌든 공개적으로 위협하는 일도 있었습니다"
    } ]
  }, {
    "tStartMs": 1856160,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "상당히 그래서 언론의 자유나"
    } ]
  }, {
    "tStartMs": 1857610,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "표현의 자유를 제약하는 법은"
    } ]
  }, {
    "tStartMs": 1859470,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "굉장히 위험할 수 있다라고"
    } ]
  }, {
    "tStartMs": 1860830,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "개인적으로 정말 생각을 하고"
    } ]
  }, {
    "tStartMs": 1862290,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "트럼프는 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1863580,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "자, 앞으로"
    } ]
  }, {
    "tStartMs": 1864300,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "이란에 무슨 일이 일어날지 똑똑히 보십시오"
    } ]
  }, {
    "tStartMs": 1867780,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "여기 보면은"
    } ]
  }, {
    "tStartMs": 1869310,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "굉장히 강한 단어가 있는데"
    } ]
  }, {
    "tStartMs": 1870910,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "얘기하면은 제가 잘릴 것 같은 단어"
    } ]
  }, {
    "tStartMs": 1873090,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "오늘 이 미친 인간"
    } ]
  }, {
    "tStartMs": 1876750,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "이게 얼마나 강한지"
    } ]
  }, {
    "tStartMs": 1878250,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "제가 AI에 물어보니까"
    } ]
  }, {
    "tStartMs": 1879610,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "거의 F 워드래 이 정도면은"
    } ]
  }, {
    "tStartMs": 1881280,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "이란, 이 미친놈들아"
    } ]
  }, {
    "tStartMs": 1883490,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "이런 애들한테 무슨 일이 날지"
    } ]
  }, {
    "tStartMs": 1884840,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "한번 지켜봐라 라고"
    } ]
  }, {
    "tStartMs": 1885660,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "굉장히 격렬하게 얘기를 하셨고"
    } ]
  }, {
    "tStartMs": 1888800,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "한번 두고 봐라"
    } ]
  }, {
    "tStartMs": 1890570,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "이렇게 강하게 얘기를 하면"
    } ]
  }, {
    "tStartMs": 1891950,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "진짜 강한 공격이 일어나면"
    } ]
  }, {
    "tStartMs": 1893900,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "확전이니까"
    } ]
  }, {
    "tStartMs": 1895230,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "유전 공격을 하든지"
    } ]
  }, {
    "tStartMs": 1895990,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "아니면 사망자가 많다든지"
    } ]
  }, {
    "tStartMs": 1897480,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "우려가 굉장히 많이 되죠"
    } ]
  }, {
    "tStartMs": 1898450,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "또 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1899640,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "이란은 47년 동안"
    } ]
  }, {
    "tStartMs": 1900750,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "전 세계에서 무고한 이들을 죽여왔는데"
    } ]
  }, {
    "tStartMs": 1902670,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "이제 미국의 제47대 대통령인"
    } ]
  }, {
    "tStartMs": 1905260,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "제가 그들을 죽이고 있습니다"
    } ]
  }, {
    "tStartMs": 1908060,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "굉장히 세죠"
    } ]
  }, {
    "tStartMs": 1910050,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "이란의 47년의 학살을"
    } ]
  }, {
    "tStartMs": 1912220,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "47대 대통령인 내가"
    } ]
  }, {
    "tStartMs": 1914570,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "그들을 죽이면서 응징하고 있다"
    } ]
  }, {
    "tStartMs": 1917130,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "그러면서 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1918210,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "이건 얼마나 큰 영광이냐"
    } ]
  }, {
    "tStartMs": 1920990,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "이란을 죽이고 있으니까"
    } ]
  }, {
    "tStartMs": 1922130,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "이제 영광이다"
    } ]
  }, {
    "tStartMs": 1923330,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "이렇게 얘기했는데"
    } ]
  }, {
    "tStartMs": 1924600,
    "dDurationMs": 570,
    "segs": [ {
      "utf8": "그래요"
    } ]
  }, {
    "tStartMs": 1925170,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "이것만 보면 전쟁이 쉽게"
    } ]
  }, {
    "tStartMs": 1926910,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "끝나지 않을 것 같기도 하고"
    } ]
  }, {
    "tStartMs": 1929780,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "종교전쟁으로 가면 안 되는데"
    } ]
  }, {
    "tStartMs": 1931550,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "영광 이런 얘기가 나오니까"
    } ]
  }, {
    "tStartMs": 1933150,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "무시무시하죠"
    } ]
  }, {
    "tStartMs": 1934590,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "물론 쉽게 끝날 수 있습니다"
    } ]
  }, {
    "tStartMs": 1936510,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "아까 처음에 얘기해드렸지만"
    } ]
  }, {
    "tStartMs": 1937920,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "쉽게 끝날 수 있어요"
    } ]
  }, {
    "tStartMs": 1939210,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "왜냐면 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1940200,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "언제 끝납니까?"
    } ]
  }, {
    "tStartMs": 1940860,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "전쟁이 언제 끝날지는"
    } ]
  }, {
    "tStartMs": 1941900,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "오직 저만 알 수 있습니다"
    } ]
  }, {
    "tStartMs": 1943810,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "왜요?"
    } ]
  }, {
    "tStartMs": 1944710,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "이란 전쟁은 내 뼛속 깊이"
    } ]
  }, {
    "tStartMs": 1947010,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "전쟁이 끝날 것 같은 느낌이 들 때"
    } ]
  }, {
    "tStartMs": 1948960,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "끝날 겁니다"
    } ]
  }, {
    "tStartMs": 1949730,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "내가 자다가 일어났는데"
    } ]
  }, {
    "tStartMs": 1951000,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "오! 뼛속 깊이 전쟁이 끝날 것 같아"
    } ]
  }, {
    "tStartMs": 1952950,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "그럼 끝난 거야"
    } ]
  }, {
    "tStartMs": 1953830,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "우리가 이겼죠? 이겼잖아"
    } ]
  }, {
    "tStartMs": 1955640,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "딱 보니까"
    } ]
  }, {
    "tStartMs": 1956440,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "내 뼛속 깊이 전쟁이 이겼어, 이미"
    } ]
  }, {
    "tStartMs": 1958460,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "그날이 되면 갑자기"
    } ]
  }, {
    "tStartMs": 1960450,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "여기까지 할까?"
    } ]
  }, {
    "tStartMs": 1961330,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "그럼 끝난다는 거죠"
    } ]
  }, {
    "tStartMs": 1962760,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "물론 이란 입장은 안 들어보잖아"
    } ]
  }, {
    "tStartMs": 1964550,
    "dDurationMs": 630,
    "segs": [ {
      "utf8": "왜 들어봐 이걸"
    } ]
  }, {
    "tStartMs": 1965180,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "이란 입장 들어봐서 뭐하게"
    } ]
  }, {
    "tStartMs": 1966690,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "하든가"
    } ]
  }, {
    "tStartMs": 1967700,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "거기서 하든가"
    } ]
  }, {
    "tStartMs": 1968720,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "미국은 저기 대륙 건너편에 있으니까"
    } ]
  }, {
    "tStartMs": 1970670,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "하든가 말든가지만"
    } ]
  }, {
    "tStartMs": 1971790,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "어쨌건"
    } ]
  }, {
    "tStartMs": 1972390,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "전쟁이 끝날 수 있기 때문에"
    } ]
  }, {
    "tStartMs": 1973980,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "굉장히 이번 전쟁처럼"
    } ]
  }, {
    "tStartMs": 1976150,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "내일 끝날 수도 있고"
    } ]
  }, {
    "tStartMs": 1976910,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "길어질 수도 있고"
    } ]
  }, {
    "tStartMs": 1978430,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "하여튼 이게 좀..."
    } ]
  }, {
    "tStartMs": 1979490,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "왔다 갔다 하는 전쟁도"
    } ]
  }, {
    "tStartMs": 1981160,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "또 처음 보지 않나 생각합니다"
    } ]
  }, {
    "tStartMs": 1982720,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "하지만 뭐 전쟁이라는 게"
    } ]
  }, {
    "tStartMs": 1984420,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "어쨌든 좀 빨리 끝나고"
    } ]
  }, {
    "tStartMs": 1985550,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "모든 혼란이 빨리 마무리되면 좋지 않을까"
    } ]
  }, {
    "tStartMs": 1988150,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "생각을 합니다"
    } ]
  } ]
}

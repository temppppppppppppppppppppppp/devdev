  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 7820,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "두 번째 주제, 아 이거 좋아요"
    } ]
  }, {
    "tStartMs": 9110,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "아주 좋아하는 주제입니다"
    } ]
  }, {
    "tStartMs": 10460,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "동계올림픽을 뒤흔든 루머"
    } ]
  }, {
    "tStartMs": 12750,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "아 이거 뜨겁습니다"
    } ]
  }, {
    "tStartMs": 14010,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "한번 얘기해보도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 15520,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "게이트가 터졌어요"
    } ]
  }, {
    "tStartMs": 16630,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "동계올림픽의 게이트"
    } ]
  }, {
    "tStartMs": 18220,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "놀랍게도 밀라노 코르티나담페초 동계올림픽이"
    } ]
  }, {
    "tStartMs": 21390,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "어느덧 폐회를 앞두고 있습니다"
    } ]
  }, {
    "tStartMs": 23030,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "오늘 끝날 거예요"
    } ]
  }, {
    "tStartMs": 24160,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "22일까지니까"
    } ]
  }, {
    "tStartMs": 25490,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "93개국 3,500명의 선수들이"
    } ]
  }, {
    "tStartMs": 27910,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "동계올림픽 메달을 향해서 열심히"
    } ]
  }, {
    "tStartMs": 30110,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "재미있는 경기들을 많이 보여줬죠"
    } ]
  }, {
    "tStartMs": 31420,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "물론 패럴림픽이 남아있지만"
    } ]
  }, {
    "tStartMs": 32970,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "벌써 끝났다고 보시면 되는데"
    } ]
  }, {
    "tStartMs": 34790,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "이번 동계올림픽은 여러분들도 느끼지만"
    } ]
  }, {
    "tStartMs": 37430,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "시작했는지도 몰랐다는 사람들이 많죠"
    } ]
  }, {
    "tStartMs": 40320,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "했냐?"
    } ]
  }, {
    "tStartMs": 41150,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "갑자기 금메달 그러면 오 그래 그러다가"
    } ]
  }, {
    "tStartMs": 44520,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "근데 무슨 금메달?"
    } ]
  }, {
    "tStartMs": 45920,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "지금 뭐 하는데?"
    } ]
  }, {
    "tStartMs": 47200,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "라는 게 요즘입니다 라는 게"
    } ]
  }, {
    "tStartMs": 49250,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "동계올림픽 그럼"
    } ]
  }, {
    "tStartMs": 50240,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "했어? 라고 하는 게 요즘인데"
    } ]
  }, {
    "tStartMs": 52600,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "시작했는지 몰랐다"
    } ]
  }, {
    "tStartMs": 54570,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "언제 시작했어?"
    } ]
  }, {
    "tStartMs": 55970,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "금메달밖에 기억이 안 나지"
    } ]
  }, {
    "tStartMs": 57120,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "이런 분들이 많죠"
    } ]
  }, {
    "tStartMs": 57740,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "이게 왜냐하면"
    } ]
  }, {
    "tStartMs": 58690,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "이건 다 아시지만"
    } ]
  }, {
    "tStartMs": 59770,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "이번 동계올림픽은 62년 만에"
    } ]
  }, {
    "tStartMs": 61980,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "JTBC에서 단독 중계했습니다"
    } ]
  }, {
    "tStartMs": 64380,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "지상파 3사에서 안 했어요"
    } ]
  }, {
    "tStartMs": 66980,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "KBS, MBC, SBS에서 안 했어"
    } ]
  }, {
    "tStartMs": 69860,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "안 해서 거기서 안 하니까"
    } ]
  }, {
    "tStartMs": 71170,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "평상시에 스포츠에 관심이 있거나"
    } ]
  }, {
    "tStartMs": 73930,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "아니면 JTBC나 네이버 치지직 같은 걸 많이 보신 분들이라면 보는데"
    } ]
  }, {
    "tStartMs": 77490,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "그렇지 않은 사람들이 모른 거죠"
    } ]
  }, {
    "tStartMs": 78950,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "어르신들은 모르고 넘어가는 경우도 많고"
    } ]
  }, {
    "tStartMs": 80660,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "젊은 친구들도 그렇고"
    } ]
  }, {
    "tStartMs": 82050,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "과거에는 이런 지상파 3사가"
    } ]
  }, {
    "tStartMs": 83660,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "이런 국제적인 대회, 올림픽, 월드컵 이런 거 있으면"
    } ]
  }, {
    "tStartMs": 87010,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "코리아 풀이라고 공동 입찰했는데"
    } ]
  }, {
    "tStartMs": 89070,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "이번에는 JTBC가 경쟁 입찰을 들어갔죠"
    } ]
  }, {
    "tStartMs": 91300,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "더 높은 가격으로 코리아 풀을 제치고"
    } ]
  }, {
    "tStartMs": 93480,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "입찰권을 획득했습니다"
    } ]
  }, {
    "tStartMs": 94980,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "여기까지는 경쟁하는 거니까"
    } ]
  }, {
    "tStartMs": 96590,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "비싼 가격으로 해서 자기가 따온 거죠"
    } ]
  }, {
    "tStartMs": 99000,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "그런데 이 후에 약간 안타까운 건"
    } ]
  }, {
    "tStartMs": 100830,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "지상파에 일부 권리를 재판매"
    } ]
  }, {
    "tStartMs": 102690,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "JTBC도 방송하고"
    } ]
  }, {
    "tStartMs": 104000,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "지상파도 방송하고"
    } ]
  }, {
    "tStartMs": 104970,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "물론 메인은 JTBC가 하겠지만"
    } ]
  }, {
    "tStartMs": 106930,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "이런 협상을 했는데"
    } ]
  }, {
    "tStartMs": 108020,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "이 협상이 최종 결렬이 됐어요"
    } ]
  }, {
    "tStartMs": 109830,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "그래서 지상파 3사가"
    } ]
  }, {
    "tStartMs": 111020,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "이번에는 중계를 못했죠"
    } ]
  }, {
    "tStartMs": 112800,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "그런데 이번 동계올림픽만 그런 거냐"
    } ]
  }, {
    "tStartMs": 116000,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "JTBC가 확보한 독점 중계권을 보면"
    } ]
  }, {
    "tStartMs": 119320,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "일단 밀라노 동계올림픽 이번 거"
    } ]
  }, {
    "tStartMs": 121710,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "근데 올해 6월에 뭐가 있냐"
    } ]
  }, {
    "tStartMs": 124280,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "북중미 월드컵이 있습니다"
    } ]
  }, {
    "tStartMs": 126050,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "어떻게 될지 모르지만"
    } ]
  }, {
    "tStartMs": 126900,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "현재까지는 JTBC가 독점 중계권을 가지고 있어요"
    } ]
  }, {
    "tStartMs": 129920,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "2028년 LA 하계올림픽"
    } ]
  }, {
    "tStartMs": 131230,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "말 그대로 올림픽 LA올림픽도 독점 중계권이 있습니다"
    } ]
  }, {
    "tStartMs": 134340,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "2030년 프랑스 동계올림픽"
    } ]
  }, {
    "tStartMs": 135950,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "역시 독점 중계권을 가지고 있어요"
    } ]
  }, {
    "tStartMs": 138080,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "2032년 브리즈번 하계올림픽"
    } ]
  }, {
    "tStartMs": 139920,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "올림픽 역시 독점 중계권을 가지고 있습니다"
    } ]
  }, {
    "tStartMs": 143300,
    "dDurationMs": 4450,
    "segs": [ {
      "utf8": "그 외에도 2030년 스페인, 포르투갈, 모로코 월드컵 100주년 월드컵입니다"
    } ]
  }, {
    "tStartMs": 147750,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "이 100주년 월드컵도 독점 중계권을 가지고 있습니다"
    } ]
  }, {
    "tStartMs": 151140,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "그 사이에는 U-20, U-17"
    } ]
  }, {
    "tStartMs": 153030,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "2027 여자 월드컵 등등 다 가지고 있는데"
    } ]
  }, {
    "tStartMs": 155490,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "한마디로 2032년까지 어지간한 월드컵과"
    } ]
  }, {
    "tStartMs": 159130,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "올림픽 같은 큰 글로벌 대회의 중계권을"
    } ]
  }, {
    "tStartMs": 162440,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "독점적으로 가지고 있다고 보시면 됩니다"
    } ]
  }, {
    "tStartMs": 164450,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "자 그러면 지상파 3사가"
    } ]
  }, {
    "tStartMs": 166430,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "이걸 다 못하냐?"
    } ]
  }, {
    "tStartMs": 169290,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "그런 생각이 들죠"
    } ]
  }, {
    "tStartMs": 171190,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "과연 다 못하는 거냐"
    } ]
  }, {
    "tStartMs": 172660,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "이걸 천천히 알아봐야 되는데"
    } ]
  }, {
    "tStartMs": 174240,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "일단 JTBC 대단하다"
    } ]
  }, {
    "tStartMs": 175710,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "어떻게 저걸 다 땄냐"
    } ]
  }, {
    "tStartMs": 177780,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "4번의 올림픽, 2번의 월드컵에"
    } ]
  }, {
    "tStartMs": 179800,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "JTBC가 쓴 돈이"
    } ]
  }, {
    "tStartMs": 181600,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "이건 공식적으로는 몰라요"
    } ]
  }, {
    "tStartMs": 183310,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "얘기를 안 해서"
    } ]
  }, {
    "tStartMs": 183930,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "이게 비밀인데"
    } ]
  }, {
    "tStartMs": 184990,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "언론에 따르면"
    } ]
  }, {
    "tStartMs": 185670,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "5억 달러라는 말이 나오고 있어요"
    } ]
  }, {
    "tStartMs": 187990,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "5천억이라는 말도 있고"
    } ]
  }, {
    "tStartMs": 189250,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "7천억이라는 말도 있고"
    } ]
  }, {
    "tStartMs": 190620,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "이 사이 어딘 것 같아"
    } ]
  }, {
    "tStartMs": 192070,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "넘는다는 쪽도 있고"
    } ]
  }, {
    "tStartMs": 193130,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "하여튼 5천억, 7천억 어딘 것 같은데"
    } ]
  }, {
    "tStartMs": 194900,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "대외비입니다 대외비"
    } ]
  }, {
    "tStartMs": 195890,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "공식적으로는 아닌데"
    } ]
  }, {
    "tStartMs": 196730,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "굉장히 큰 값이죠"
    } ]
  }, {
    "tStartMs": 197860,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "굉장히 큰 돈을 썼다라고 보면 되고"
    } ]
  }, {
    "tStartMs": 200610,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "그러면 JTBC는 왜 이렇게 큰 돈을 투자했냐"
    } ]
  }, {
    "tStartMs": 203130,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "뭐 5천억이건 7천억이건 수천억이니까"
    } ]
  }, {
    "tStartMs": 205360,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "엄청난 돈이잖아요"
    } ]
  }, {
    "tStartMs": 206500,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "물론 앞으로 2032년까지"
    } ]
  }, {
    "tStartMs": 208160,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "저걸 모두 다 단독 중계할 수 있지만"
    } ]
  }, {
    "tStartMs": 211450,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "일단 JTBC 입장은 저도 잘 모르지만"
    } ]
  }, {
    "tStartMs": 214150,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "제 개인 생각에"
    } ]
  }, {
    "tStartMs": 215390,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "JTBC 공식 입장이 아닙니다"
    } ]
  }, {
    "tStartMs": 216730,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "제가 보면 아무래도"
    } ]
  }, {
    "tStartMs": 218200,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "JTBC 채널의 위상을"
    } ]
  }, {
    "tStartMs": 219360,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "지상파 수준으로 올리겠다는"
    } ]
  }, {
    "tStartMs": 220790,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "뭐 이거 당연히 1번이겠죠"
    } ]
  }, {
    "tStartMs": 222590,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "채널의 가치와 채널의 위상을 올리겠다"
    } ]
  }, {
    "tStartMs": 224790,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "JTBC는 전신이 있습니다"
    } ]
  }, {
    "tStartMs": 226880,
    "dDurationMs": 4270,
    "segs": [ {
      "utf8": "1964년 개국했던 동양방송"
    } ]
  }, {
    "tStartMs": 231150,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "옛날에 삼성에서 했었던 TBC 이게 전신이에요"
    } ]
  }, {
    "tStartMs": 234720,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "동양방송 모르겠는데요? 모르시죠?"
    } ]
  }, {
    "tStartMs": 236550,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "왜냐하면 1980년대 신군부가 언론 통폐합을 강행합니다"
    } ]
  }, {
    "tStartMs": 241250,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "이때 민영방송국이 마음에 안 들죠"
    } ]
  }, {
    "tStartMs": 243920,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "내가 독재해야 되는데"
    } ]
  }, {
    "tStartMs": 245090,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "너희들이 뭐라고 거기서 민영방송국"
    } ]
  }, {
    "tStartMs": 247070,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "해서 국영으로 흡수합니다"
    } ]
  }, {
    "tStartMs": 249920,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "그래서 이 채널이"
    } ]
  }, {
    "tStartMs": 251470,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "KBS2 TV"
    } ]
  }, {
    "tStartMs": 252240,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "그때 당시 몇 번이었죠? 7번인가?"
    } ]
  }, {
    "tStartMs": 254850,
    "dDurationMs": 320,
    "segs": [ {
      "utf8": "헷갈리네"
    } ]
  }, {
    "tStartMs": 255170,
    "dDurationMs": 290,
    "segs": [ {
      "utf8": "KBS 2TV가"
    } ]
  }, {
    "tStartMs": 255460,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "1TV가 9번이고 7번이고 헷갈리는데"
    } ]
  }, {
    "tStartMs": 258020,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "KBS 2TV로 채널을 넘기게 돼요"
    } ]
  }, {
    "tStartMs": 260400,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "그리고 없어졌는데"
    } ]
  }, {
    "tStartMs": 261380,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "2011년 중앙그룹이 TBC를 전신으로 하는"
    } ]
  }, {
    "tStartMs": 264280,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "J중앙TBC를 개국합니다"
    } ]
  }, {
    "tStartMs": 266900,
    "dDurationMs": 3790,
    "segs": [ {
      "utf8": "그래서 2011년에 다시 JTBC가 개국이 됩니다"
    } ]
  }, {
    "tStartMs": 270690,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "아마 과거의 영광"
    } ]
  }, {
    "tStartMs": 272050,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "당시의 동양방송은 민영방송 1위였어요"
    } ]
  }, {
    "tStartMs": 274700,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "제가 1964년도에는 태어나지 못해봐서"
    } ]
  }, {
    "tStartMs": 277710,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "그 인기는 잘 모르겠는데"
    } ]
  }, {
    "tStartMs": 279390,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "인기가 굉장히 좋았던 방송이라고 합니다"
    } ]
  }, {
    "tStartMs": 281330,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "지상파 싸대기를 때리는"
    } ]
  }, {
    "tStartMs": 282610,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "민영방송 1위 방송이었다고 하는데"
    } ]
  }, {
    "tStartMs": 284470,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "그때 위상을 아마"
    } ]
  }, {
    "tStartMs": 285760,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "다시 찾고자 하는 이게 있지 않나 생각이 되고"
    } ]
  }, {
    "tStartMs": 288160,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "또 OTT도 있죠"
    } ]
  }, {
    "tStartMs": 289360,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "예를 들면 티빙"
    } ]
  }, {
    "tStartMs": 290380,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "티빙에서 볼 수 있습니다"
    } ]
  }, {
    "tStartMs": 291520,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "JTBC가 주요 주주인"
    } ]
  }, {
    "tStartMs": 292980,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "CJ E\u0026M이 대주주이긴 한데"
    } ]
  }, {
    "tStartMs": 294560,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "JTBC가 주요 투자자이기 때문에"
    } ]
  }, {
    "tStartMs": 296120,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "독점 중계하는 모든 올림픽, 월드컵도 지금 티빙으로"
    } ]
  }, {
    "tStartMs": 298820,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "티빙을 좀 활성화하고 키우고자 하는"
    } ]
  }, {
    "tStartMs": 300820,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "콘텐츠 비용으로 삼은 것도 있죠"
    } ]
  }, {
    "tStartMs": 303100,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "그런데 이런 상황에서"
    } ]
  }, {
    "tStartMs": 304690,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "당연히 지상파들은 이렇게 주장을 합니다"
    } ]
  }, {
    "tStartMs": 307440,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "JTBC가 보편적 시청권을 침해했다"
    } ]
  }, {
    "tStartMs": 310750,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "주장하는 정도가 아니라"
    } ]
  }, {
    "tStartMs": 312120,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "작년에 지상파 3사가"
    } ]
  }, {
    "tStartMs": 314190,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "JTBC의 올림픽, 월드컵 중계권 입찰을 중지해달라며"
    } ]
  }, {
    "tStartMs": 317480,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "가처분 신청을 했어요"
    } ]
  }, {
    "tStartMs": 319200,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "법원에 냈어요"
    } ]
  }, {
    "tStartMs": 320180,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "법원 판결까지 나왔어요"
    } ]
  }, {
    "tStartMs": 321570,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "그때 뭐라고 주장했냐면"
    } ]
  }, {
    "tStartMs": 322600,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "지상파 3사가 이렇게 얘기를 했습니다"
    } ]
  }, {
    "tStartMs": 324440,
    "dDurationMs": 4010,
    "segs": [ {
      "utf8": "올림픽과 월드컵은 방송법상 보편적 시청권의 대상인데"
    } ]
  }, {
    "tStartMs": 328450,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "JTBC가 중계권을 공정하고"
    } ]
  }, {
    "tStartMs": 330340,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "합리적인 가격으로 제공할 의무가 있어"
    } ]
  }, {
    "tStartMs": 332980,
    "dDurationMs": 3530,
    "segs": [ {
      "utf8": "그리고 JTBC는 정당한 사유 없이 판매를 거부하면 안 돼"
    } ]
  }, {
    "tStartMs": 336510,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "근데 이렇게 안 하네?"
    } ]
  }, {
    "tStartMs": 338110,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "이거를 그래서 JTBC의 중계권 입찰을 중재해달라"
    } ]
  }, {
    "tStartMs": 341300,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "라고 법원에 가처분 신청을 냈습니다 작년이에요"
    } ]
  }, {
    "tStartMs": 344590,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "저 지상파 3사가 주장하는 게 뭐냐"
    } ]
  }, {
    "tStartMs": 346400,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "현행 방송법에는 방송의 공적 책임과"
    } ]
  }, {
    "tStartMs": 349250,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "보편적 접근 가능성을 법으로 규정하고 있습니다"
    } ]
  }, {
    "tStartMs": 352670,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "무슨 소리냐?"
    } ]
  }, {
    "tStartMs": 353560,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "올림픽과 월드컵처럼"
    } ]
  }, {
    "tStartMs": 354790,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "이런 국민 전체가 관심 있는"
    } ]
  }, {
    "tStartMs": 356960,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "이런 대회를 만약 슈카가 돈이 1조가 생겼어"
    } ]
  }, {
    "tStartMs": 359710,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "갑자기 머스크 형이 야 써라 하고 용돈으로 줬어"
    } ]
  }, {
    "tStartMs": 363550,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "1조를 딱 받더니"
    } ]
  }, {
    "tStartMs": 364960,
    "dDurationMs": 570,
    "segs": [ {
      "utf8": "에라 모르겠다"
    } ]
  }, {
    "tStartMs": 365530,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "앞으로 10년간 올림픽, 월드컵 슈카월드 다 방송할래요"
    } ]
  }, {
    "tStartMs": 368190,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "슈카월드에서만 한다 라고 살 수 있냐"
    } ]
  }, {
    "tStartMs": 370520,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "1조 콜 하면서"
    } ]
  }, {
    "tStartMs": 372180,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "안 됩니다"
    } ]
  }, {
    "tStartMs": 373420,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "법으로 금지되어 있어요"
    } ]
  }, {
    "tStartMs": 374780,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "안 돼요"
    } ]
  }, {
    "tStartMs": 375280,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "농담이 아니라 안 됩니다"
    } ]
  }, {
    "tStartMs": 376520,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "국민 전체 가구수의 90% 이상이 실청할 수 있는 방송수단을 확보해야 돼요"
    } ]
  }, {
    "tStartMs": 381280,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "슈카월드 구독자 수가 4천만 정도 되면 가능할 거야"
    } ]
  }, {
    "tStartMs": 385640,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "우리나라 전체 가구수의 90%가 슈카월드를 봅니다"
    } ]
  }, {
    "tStartMs": 388290,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "이거 충분한 거 아닙니까"
    } ]
  }, {
    "tStartMs": 389700,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "라고 하면 가능할 수 있죠"
    } ]
  }, {
    "tStartMs": 390910,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "가능할 수 있습니다 좋아요"
    } ]
  }, {
    "tStartMs": 392640,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "4,500만 되겠구나"
    } ]
  }, {
    "tStartMs": 394020,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "완전 어린애들은 안 보니까"
    } ]
  }, {
    "tStartMs": 396230,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "전체 가구수의 90%를 확보해야 돼요"
    } ]
  }, {
    "tStartMs": 398740,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "그렇지 않으면 못합니다"
    } ]
  }, {
    "tStartMs": 400150,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "몇 십조를 줘도 못해요"
    } ]
  }, {
    "tStartMs": 401390,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "그리고 실시간 방송 의무가 있습니다"
    } ]
  }, {
    "tStartMs": 404600,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "슈카월드가 4,500만을 해서 90%를 채웠는데"
    } ]
  }, {
    "tStartMs": 407250,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "귀찮아"
    } ]
  }, {
    "tStartMs": 408450,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "그냥 일요일 날 보자, 한 번에"
    } ]
  }, {
    "tStartMs": 410580,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "일요일 날 보고"
    } ]
  }, {
    "tStartMs": 411660,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "그 금메달 딴 거는"
    } ]
  }, {
    "tStartMs": 412450,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "내가 월요일부터 금요일까지"
    } ]
  }, {
    "tStartMs": 413560,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "하루에 하나씩 올려줄게"
    } ]
  }, {
    "tStartMs": 415230,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "월요일은 쇼트트랙"
    } ]
  }, {
    "tStartMs": 416460,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "화요일은 스노보드"
    } ]
  }, {
    "tStartMs": 418050,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "수요일은 스키"
    } ]
  }, {
    "tStartMs": 418970,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "오케이, 콜"
    } ]
  }, {
    "tStartMs": 419710,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "이러면 안 돼요"
    } ]
  }, {
    "tStartMs": 420900,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "실시간 해야 돼"
    } ]
  }, {
    "tStartMs": 421950,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "야, 그 딴 게 어디 있어"
    } ]
  }, {
    "tStartMs": 423010,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "내가 1조 썼는데"
    } ]
  }, {
    "tStartMs": 423760,
    "dDurationMs": 450,
    "segs": [ {
      "utf8": "내 마음이지"
    } ]
  }, {
    "tStartMs": 424210,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "안 됩니다"
    } ]
  }, {
    "tStartMs": 425150,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "이거 법에 있어요"
    } ]
  }, {
    "tStartMs": 426110,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "그런 거 안 되고요"
    } ]
  }, {
    "tStartMs": 426900,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "판매 거부도 안 돼요"
    } ]
  }, {
    "tStartMs": 428430,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "정당한 사유가 없이"
    } ]
  }, {
    "tStartMs": 429840,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "나 혼자 할 거야, 이게"
    } ]
  }, {
    "tStartMs": 431240,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "물론 뭐 합의를 해야겠지만"
    } ]
  }, {
    "tStartMs": 432830,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "이런 게 이제 법에 있다는 거죠"
    } ]
  }, {
    "tStartMs": 435010,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "그래서 이걸 갖고"
    } ]
  }, {
    "tStartMs": 435840,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "법원에 가서 가처분 신청을 걸었는데"
    } ]
  }, {
    "tStartMs": 438160,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "법원은 지상파 3사의 가처분 신청을 기각했습니다"
    } ]
  }, {
    "tStartMs": 442450,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "왜 기각했냐?"
    } ]
  }, {
    "tStartMs": 443520,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "1번, JTBC는 이렇게 항변했어요"
    } ]
  }, {
    "tStartMs": 445340,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "전체 가구수의 96.8%에 이르는"
    } ]
  }, {
    "tStartMs": 447770,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "가시청 가구를 확보하고 있다"
    } ]
  }, {
    "tStartMs": 450020,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "티빙이라든지 본인들 채널이라든지 유튜브라든지"
    } ]
  }, {
    "tStartMs": 452110,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "이런 거 합친 거겠죠"
    } ]
  }, {
    "tStartMs": 453110,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "확보하고 있기 때문에"
    } ]
  }, {
    "tStartMs": 453870,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "90%를 넘었다"
    } ]
  }, {
    "tStartMs": 454930,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "그리고 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 456350,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "보편적 시청권의 향유 주체는 국민이지"
    } ]
  }, {
    "tStartMs": 458600,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "지상파 3사가 아니다"
    } ]
  }, {
    "tStartMs": 460540,
    "dDurationMs": 390,
    "segs": [ {
      "utf8": "돈을 써"
    } ]
  }, {
    "tStartMs": 460930,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "돈을 안 써서 안 됐잖아"
    } ]
  }, {
    "tStartMs": 462810,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "약간 이 말과 비슷하죠"
    } ]
  }, {
    "tStartMs": 464490,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "방송업자들의 경쟁 제한을 규제하는 게 아니다"
    } ]
  }, {
    "tStartMs": 467150,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "경쟁을 해서 돈을 더 쓴 사람이 가져가는 거는"
    } ]
  }, {
    "tStartMs": 469720,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "법으로 막는 게 아니고"
    } ]
  }, {
    "tStartMs": 470940,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "일반 국민의 알 권리 내지 정보 접근권을 충족시키기 위한 건데"
    } ]
  }, {
    "tStartMs": 474600,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "JTBC 정도 되면"
    } ]
  }, {
    "tStartMs": 475790,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "일반 국민의 정보 접근권을 충족시키는 게 아니냐"
    } ]
  }, {
    "tStartMs": 478270,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "라고 판단하면서"
    } ]
  }, {
    "tStartMs": 479190,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "가처분 신청이 기각이 됐어요"
    } ]
  }, {
    "tStartMs": 481280,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "그런데 이번 동계올림픽을 보니까"
    } ]
  }, {
    "tStartMs": 483620,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "좀 조용해"
    } ]
  }, {
    "tStartMs": 484640,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "하는지 안 하는지도 몰라"
    } ]
  }, {
    "tStartMs": 485730,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "JTBC는 화를 내죠"
    } ]
  }, {
    "tStartMs": 487730,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "지상파가 보도를 확 줄인 거 아니냐"
    } ]
  }, {
    "tStartMs": 490370,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "지상파가"
    } ]
  }, {
    "tStartMs": 491520,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "이렇게 화를 냈습니다"
    } ]
  }, {
    "tStartMs": 492550,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "올림픽 지상파 독점 깨지자 보도 확 줄여"
    } ]
  }, {
    "tStartMs": 495220,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "뉴스권도 거부해"
    } ]
  }, {
    "tStartMs": 496070,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "물론 지상파 3사는 무슨 소리?"
    } ]
  }, {
    "tStartMs": 498090,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "니들이 뭐 안 줬잖아"
    } ]
  }, {
    "tStartMs": 499120,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "가격을 어떻게 했잖아"
    } ]
  }, {
    "tStartMs": 500060,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "라고 지금 양쪽이 갈등이 있는 게 지금이라고 하고요"
    } ]
  }, {
    "tStartMs": 503300,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "서로서로 얘기합니다"
    } ]
  }, {
    "tStartMs": 504070,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "JTBC는 비싸게 계약한 거 아니다"
    } ]
  }, {
    "tStartMs": 505970,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "이전 때와 비슷하거나"
    } ]
  }, {
    "tStartMs": 506860,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "물가 상승률 정도만 올랐다"
    } ]
  }, {
    "tStartMs": 508750,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "과도한 금액 아니다"
    } ]
  }, {
    "tStartMs": 509700,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "그리고 너희들이 우리가 합리적인 가격을 해줬는데"
    } ]
  }, {
    "tStartMs": 512290,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "니들이 안 했잖아"
    } ]
  }, {
    "tStartMs": 513010,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "지상파는 무슨 소리?"
    } ]
  }, {
    "tStartMs": 514210,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "비싸게 해줬잖아"
    } ]
  }, {
    "tStartMs": 515020,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "라고 지금 갈등을 싸우고 있어요"
    } ]
  }, {
    "tStartMs": 517700,
    "dDurationMs": 650,
    "segs": [ {
      "utf8": "싸우고 있는데"
    } ]
  }, {
    "tStartMs": 518350,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "문제는 이번 동계올림픽 끝났으니까 할 수 없는데"
    } ]
  }, {
    "tStartMs": 521350,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "당장 올해 6월에 뭐가 있다고요?"
    } ]
  }, {
    "tStartMs": 523810,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "북중미 월드컵이 있습니다"
    } ]
  }, {
    "tStartMs": 525970,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "북중미 월드컵이 있어요"
    } ]
  }, {
    "tStartMs": 527740,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "월드컵도 JTBC 단독 중계로 볼 수 있어요"
    } ]
  }, {
    "tStartMs": 531140,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "티빙이나 치지직이나 JTBC에서만 봐야 될 수 있어요"
    } ]
  }, {
    "tStartMs": 535640,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "예를 들면 유튜브 채널을 통해서는"
    } ]
  }, {
    "tStartMs": 538160,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "누구 슈우웃 하다가"
    } ]
  }, {
    "tStartMs": 540820,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "거기까지"
    } ]
  }, {
    "tStartMs": 541820,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "거기까지 나오면서"
    } ]
  }, {
    "tStartMs": 542950,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "더 보고 싶으시면"
    } ]
  }, {
    "tStartMs": 544680,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "뭐 JTBC로 가세요"
    } ]
  }, {
    "tStartMs": 545930,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "더 보고 싶으시면 티빙으로 가셔야 할 수도 있습니다"
    } ]
  }, {
    "tStartMs": 548420,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "야 이거 뭐야 왜 슛 하다가 잘라"
    } ]
  }, {
    "tStartMs": 550390,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "거기까지 갈 수도 있습니다"
    } ]
  }, {
    "tStartMs": 552090,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "돈을 뭐 얼마 냈는데"
    } ]
  }, {
    "tStartMs": 553480,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "저거 7천억 냈는데 뽑아야 될 거 아니야"
    } ]
  }, {
    "tStartMs": 555580,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "뭐 그럴 수도 있기 때문에"
    } ]
  }, {
    "tStartMs": 556570,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "아니면 또 관심이 굉장히 지금처럼"
    } ]
  }, {
    "tStartMs": 558500,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "물론 월드컵은 그렇지 않겠지만"
    } ]
  }, {
    "tStartMs": 559920,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "이제 내려갈 위기가 있죠"
    } ]
  }, {
    "tStartMs": 561440,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "지상파 3사와 협상을 하고 있어요"
    } ]
  }, {
    "tStartMs": 563840,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "아직 끝난 거 아닙니다"
    } ]
  }, {
    "tStartMs": 565230,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "협상이 만약에 무산되면"
    } ]
  }, {
    "tStartMs": 566410,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "단독 중계 가능성도 있습니다"
    } ]
  }, {
    "tStartMs": 568100,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "무산되면 협상이 뭐 잘 돼서"
    } ]
  }, {
    "tStartMs": 570160,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "적정한 비용을 치뤄서"
    } ]
  }, {
    "tStartMs": 571490,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "다 같이 뭐 방송하는 게 베스트가 아닐까 생각이 되는데"
    } ]
  }, {
    "tStartMs": 574530,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "현재까지는 그렇습니다"
    } ]
  }, {
    "tStartMs": 576170,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "현재 방송미디어 통신위원회 방미통에서는"
    } ]
  }, {
    "tStartMs": 579640,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "법 개정 얘기도 하고 있어요"
    } ]
  }, {
    "tStartMs": 581510,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "동계올림픽이라는 국민적 관심도가 높은 사안에서"
    } ]
  }, {
    "tStartMs": 583650,
    "dDurationMs": 3770,
    "segs": [ {
      "utf8": "국민들의 시청권이 제한적으로 이루어진 게 유감이다라고"
    } ]
  }, {
    "tStartMs": 587420,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "얼마 전에 무슨 어디 위원회에 나오셔서"
    } ]
  }, {
    "tStartMs": 589560,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "이렇게 얘기했기 때문에"
    } ]
  }, {
    "tStartMs": 590990,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "현행법상 방송사 간의 중계권 협상을 강제할 수 있는"
    } ]
  }, {
    "tStartMs": 593840,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "법적인 근거가 대단히 미약하다"
    } ]
  }, {
    "tStartMs": 596060,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "이를 해소하기 위해 법 개정을 준비 중이라고 밝혔는데"
    } ]
  }, {
    "tStartMs": 599120,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "무슨 법이 나올지 모르겠습니다"
    } ]
  }, {
    "tStartMs": 600320,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "무슨 법이 나올지 모르겠지만"
    } ]
  }, {
    "tStartMs": 601640,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "하여튼 어떻게든 간에"
    } ]
  }, {
    "tStartMs": 602920,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "지상파 3사와 JTBC가 잘 좋게 협상을 해서"
    } ]
  }, {
    "tStartMs": 606230,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "협상이 잘 되는 게"
    } ]
  }, {
    "tStartMs": 607330,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "베스트가 아닐까 생각이 됩니다"
    } ]
  }, {
    "tStartMs": 608650,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "현재 그런 상황이죠"
    } ]
  }, {
    "tStartMs": 610080,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "자 이거는 중계에 대한 내용이고"
    } ]
  }, {
    "tStartMs": 611810,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "동계올림픽으로 돌아오면"
    } ]
  }, {
    "tStartMs": 613210,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "동계올림픽은 대한민국의 금3 은4 동3"
    } ]
  }, {
    "tStartMs": 616800,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "그래서 올림픽에 사실"
    } ]
  }, {
    "tStartMs": 617680,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "국가 간 순위는 별로 중요하지 않지만"
    } ]
  }, {
    "tStartMs": 619810,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "13위에 랭크되어 있습니다"
    } ]
  }, {
    "tStartMs": 621520,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "쫙 보시면 금메달 은메달 동메달"
    } ]
  }, {
    "tStartMs": 623160,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "여러분들 굉장히 재밌게 보신 스노보드"
    } ]
  }, {
    "tStartMs": 625630,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "여자 쇼트트랙"
    } ]
  }, {
    "tStartMs": 626330,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "남자 쇼트트랙"
    } ]
  }, {
    "tStartMs": 627680,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "스노보드하고 쇼트트랙 이번에 굉장히 잘했네요"
    } ]
  }, {
    "tStartMs": 631160,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "스노보드에서도 금, 은, 동이 다 나왔고"
    } ]
  }, {
    "tStartMs": 633660,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "쇼트트랙은 명실공히"
    } ]
  }, {
    "tStartMs": 635370,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "우리나라 메달 맛있죠"
    } ]
  }, {
    "tStartMs": 636920,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "그래서 총 10개의 메달을 따면서"
    } ]
  }, {
    "tStartMs": 639510,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "지금 13위로 마감을 할 예정입니다"
    } ]
  }, {
    "tStartMs": 642140,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "그래서 우리는 이렇게 선전을 했는데"
    } ]
  }, {
    "tStartMs": 644670,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "하지만 우리나라 말고"
    } ]
  }, {
    "tStartMs": 646110,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "해외에서 굉장히 이슈가 된 게 있습니다"
    } ]
  }, {
    "tStartMs": 648800,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "바로 땡땡땡 게이트입니다"
    } ]
  }, {
    "tStartMs": 652240,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "아 좋습니다"
    } ]
  }, {
    "tStartMs": 653200,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "슈카월드도 이런 거 한번 써봤는데요"
    } ]
  }, {
    "tStartMs": 654780,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "이런 걸 해야 조회수가 올라간다고 하더라고요"
    } ]
  }, {
    "tStartMs": 656640,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "올림픽은 과연 무슨 얘기를 멈추지 못하고 있을까?"
    } ]
  }, {
    "tStartMs": 660150,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "이게 옛날에 스타킹인가?"
    } ]
  }, {
    "tStartMs": 662160,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "뭐 거기서 항상 이랬는데"
    } ]
  }, {
    "tStartMs": 663210,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "땡땡땡 얘기를 멈추지 못하고 있다"
    } ]
  }, {
    "tStartMs": 665420,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "땡땡땡은 무엇일까요?"
    } ]
  }, {
    "tStartMs": 666750,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "뭐 이런 거 했었거든요"
    } ]
  }, {
    "tStartMs": 669210,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "스타킹 아닌가? 헷갈리네"
    } ]
  }, {
    "tStartMs": 670620,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "아 스펀지"
    } ]
  }, {
    "tStartMs": 673440,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "스타킹 아니구나 스펀지구나"
    } ]
  }, {
    "tStartMs": 674940,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "죄송합니다 헷갈렸어"
    } ]
  }, {
    "tStartMs": 676270,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "야 같은 스 씨잖아"
    } ]
  }, {
    "tStartMs": 677540,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "야 같은 스 씨잖아"
    } ]
  }, {
    "tStartMs": 678490,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "헷갈릴 수도 있지"
    } ]
  }, {
    "tStartMs": 679770,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "야 같은 스 씨니까 헷갈렸다"
    } ]
  }, {
    "tStartMs": 681970,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "헷갈렸다"
    } ]
  }, {
    "tStartMs": 682580,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "야 스펀지다 스펀지 그래"
    } ]
  }, {
    "tStartMs": 683740,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "오래돼서 그래요 오래돼서"
    } ]
  }, {
    "tStartMs": 685570,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "오래되면 그럴 수 있지"
    } ]
  }, {
    "tStartMs": 686480,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "아 그러네"
    } ]
  }, {
    "tStartMs": 688510,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "어째 스까지만 기억나더라"
    } ]
  }, {
    "tStartMs": 689670,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "아니 변태가 아니라 헷갈리잖아요 여러분도"
    } ]
  }, {
    "tStartMs": 692550,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "스타킹이라는 프로가 없었나?"
    } ]
  }, {
    "tStartMs": 694910,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "헷갈리네x2"
    } ]
  }, {
    "tStartMs": 696430,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "자 스펀지입니다 스펀지"
    } ]
  }, {
    "tStartMs": 698090,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "스펀지에서도 이런 식으로 했었는데"
    } ]
  }, {
    "tStartMs": 700640,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "그 편집자 님"
    } ]
  }, {
    "tStartMs": 702530,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "요렇게 잘 편집해주시면"
    } ]
  }, {
    "tStartMs": 704690,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "오케이x3"
    } ]
  }, {
    "tStartMs": 706660,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "무난히 스펀지 얘기를 한 걸로 좋습니다"
    } ]
  }, {
    "tStartMs": 709290,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "스펀지에서 그렇게 얘기를 했었죠"
    } ]
  }, {
    "tStartMs": 711590,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "그러면 이 네모 땡땡땡은 뭐냐?"
    } ]
  }, {
    "tStartMs": 713880,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "늙기 싫다니요"
    } ]
  }, {
    "tStartMs": 715280,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "늙어서 그런 거 아니에요"
    } ]
  }, {
    "tStartMs": 716520,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "헷갈릴 수도 있죠"
    } ]
  }, {
    "tStartMs": 717300,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "얘기하다 보면"
    } ]
  }, {
    "tStartMs": 718150,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "늙기 싫다니 늙어서 얘기하는 거 아닙니다"
    } ]
  }, {
    "tStartMs": 720640,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "하여튼 그래요"
    } ]
  }, {
    "tStartMs": 721670,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "그렇기 때문에 강호동의 스타킹?"
    } ]
  }, {
    "tStartMs": 724320,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "그렇죠 있었죠"
    } ]
  }, {
    "tStartMs": 725120,
    "dDurationMs": 510,
    "segs": [ {
      "utf8": "있었잖아요"
    } ]
  }, {
    "tStartMs": 725630,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "그래 있었잖아요"
    } ]
  }, {
    "tStartMs": 726550,
    "dDurationMs": 180,
    "segs": [ {
      "utf8": "그래"
    } ]
  }, {
    "tStartMs": 726730,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "있었어x2"
    } ]
  }, {
    "tStartMs": 727680,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "헷갈려서 그렇습니다"
    } ]
  }, {
    "tStartMs": 728860,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "다시 돌아오면 뭐냐?"
    } ]
  }, {
    "tStartMs": 730060,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "이 땡땡땡 게이트는 바로"
    } ]
  }, {
    "tStartMs": 733090,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "약간 얘기하기 좀 그렇긴 한데"
    } ]
  }, {
    "tStartMs": 735200,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "월스트리트저널도 쓴 단어니까"
    } ]
  }, {
    "tStartMs": 737270,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "월스트리트저널"
    } ]
  }, {
    "tStartMs": 737830,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "바로 페니스 게이트입니다"
    } ]
  }, {
    "tStartMs": 741020,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "이거...이거 ㅎㅎ"
    } ]
  }, {
    "tStartMs": 742080,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "잠깐만 영상 못 올릴 수도 있겠는데"
    } ]
  }, {
    "tStartMs": 744380,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "제가 쓴 게 아니라 서구 언론들이 쓴 단어예요"
    } ]
  }, {
    "tStartMs": 747110,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "페니스 게이트"
    } ]
  }, {
    "tStartMs": 747970,
    "dDurationMs": 670,
    "segs": [ {
      "utf8": "여기  있잖아요"
    } ]
  }, {
    "tStartMs": 748640,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "월스트리트저널이"
    } ]
  }, {
    "tStartMs": 750010,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "그럼 갑자기 페니스 게이트가 뭐냐"
    } ]
  }, {
    "tStartMs": 752290,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "이건 월스트리트저널뿐만 아니라"
    } ]
  }, {
    "tStartMs": 753960,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "세계 유수의 언론들이 다 냈어요 다 냈어"
    } ]
  }, {
    "tStartMs": 756340,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "가서 보십시오"
    } ]
  }, {
    "tStartMs": 757660,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "저 게이트는 이겁니다"
    } ]
  }, {
    "tStartMs": 759100,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "스키점프 선수들이"
    } ]
  }, {
    "tStartMs": 761110,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "거기에 주사를 맞는다라는 황당무계한 소문이"
    } ]
  }, {
    "tStartMs": 765650,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "지금 밀라노에 퍼졌습니다"
    } ]
  }, {
    "tStartMs": 767700,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "스키점프 선수들이 경기력 향상을 위해서"
    } ]
  }, {
    "tStartMs": 770750,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "거기에 주사를 맞는다라는 루머인데"
    } ]
  }, {
    "tStartMs": 773640,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "루머를 조금 더 여기를 보면"
    } ]
  }, {
    "tStartMs": 776460,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "거기에 히알루론산이라는 주사를 놓아서"
    } ]
  }, {
    "tStartMs": 780280,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "사이즈를 키운다라는 괴루머입니다 괴루머"
    } ]
  }, {
    "tStartMs": 783310,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "이렇게"
    } ]
  }, {
    "tStartMs": 784220,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "그러면 이걸 왜 키우냐?"
    } ]
  }, {
    "tStartMs": 786320,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "이걸 왜 키우냐?"
    } ]
  }, {
    "tStartMs": 787550,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "이게 영구적으로 키우는 게 아니라"
    } ]
  }, {
    "tStartMs": 789240,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "필러 같은 건가 봐요"
    } ]
  }, {
    "tStartMs": 790580,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "말로만 들었을 땐"
    } ]
  }, {
    "tStartMs": 791810,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "그걸 왜 키우냐?"
    } ]
  }, {
    "tStartMs": 792490,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "거기서 아니 올림픽 하러 가서 그걸 왜 키워?"
    } ]
  }, {
    "tStartMs": 795260,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "처음 들으면 혹시 저 같은 사람은 그렇게 생각 안 하는데"
    } ]
  }, {
    "tStartMs": 799180,
    "dDurationMs": 3910,
    "segs": [ {
      "utf8": "머리에 19금 음란마귀가 들어가신 분들이 있으면"
    } ]
  }, {
    "tStartMs": 803090,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "그게 그걸 키워서"
    } ]
  }, {
    "tStartMs": 805950,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "그런 생각 하실 수도 있죠"
    } ]
  }, {
    "tStartMs": 807960,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "저는 전혀 그렇게 생각 안 하는데"
    } ]
  }, {
    "tStartMs": 809550,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "가끔 그런 생각 하시는 분들이 있을까 봐"
    } ]
  }, {
    "tStartMs": 811120,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "제가 그걸 체크해봤는데"
    } ]
  }, {
    "tStartMs": 812900,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "예를 들면 개막 3일 만에"
    } ]
  }, {
    "tStartMs": 814860,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "올림픽 선수촌에서"
    } ]
  }, {
    "tStartMs": 816330,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "콘돔의 품절 사태가 발생했다"
    } ]
  }, {
    "tStartMs": 819000,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "이번 동계올림픽입니다"
    } ]
  }, {
    "tStartMs": 820450,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "3일 만에"
    } ]
  }, {
    "tStartMs": 822030,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "도대체 이걸 콘돔을 몇 개 준비했길래"
    } ]
  }, {
    "tStartMs": 824330,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "3일 만에 품절이냐?"
    } ]
  }, {
    "tStartMs": 826240,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "가서 봤더니 만 개를 준비했다"
    } ]
  }, {
    "tStartMs": 829660,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "되게 작죠?"
    } ]
  }, {
    "tStartMs": 830720,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "파리올림픽 때는 30만 개를 준비했습니다"
    } ]
  }, {
    "tStartMs": 833110,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "물론 선수가 훨씬 많지만"
    } ]
  }, {
    "tStartMs": 834500,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "여긴 만 명 단위가 선수가 오고"
    } ]
  }, {
    "tStartMs": 836220,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "동계올림픽은 3천 명밖에 안 되긴 하지만"
    } ]
  }, {
    "tStartMs": 838290,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "어쨌건 양이 적었어요"
    } ]
  }, {
    "tStartMs": 840190,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "동계올림픽 참가 선수가 3천 명입니다"
    } ]
  }, {
    "tStartMs": 842530,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "만 개라고 하면"
    } ]
  }, {
    "tStartMs": 843290,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "1인당 3개잖아"
    } ]
  }, {
    "tStartMs": 844410,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "근데 3일 만에 1인당 3개를 다 썼다는 거죠"
    } ]
  }, {
    "tStartMs": 847760,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "운동을 하고"
    } ]
  }, {
    "tStartMs": 848480,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "아니 잠깐만"
    } ]
  }, {
    "tStartMs": 849610,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "훈련을 하고 운동을 하고"
    } ]
  }, {
    "tStartMs": 850890,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "경기를 가야지"
    } ]
  }, {
    "tStartMs": 853130,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "뭐 운동이긴 하네"
    } ]
  }, {
    "tStartMs": 854230,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "하여튼 아니 경기력 향상의 그 말이야"
    } ]
  }, {
    "tStartMs": 857340,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "그거 가서 그거 해야지"
    } ]
  }, {
    "tStartMs": 859900,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "그 엉뚱한 관심이 있으니"
    } ]
  }, {
    "tStartMs": 862370,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "물론 선수들이 자기 경기를 마치고"
    } ]
  }, {
    "tStartMs": 865890,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "추운 겨울에서 사랑이 꽃 피는 건 나쁘진 않은데"
    } ]
  }, {
    "tStartMs": 868200,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "3일 만에 1인당 3개는"
    } ]
  }, {
    "tStartMs": 870900,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "아니면 사재기한 사람도 있나? 확 해서"
    } ]
  }, {
    "tStartMs": 873630,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "그래서 이게 좀 문제가 돼서"
    } ]
  }, {
    "tStartMs": 875070,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "뉴스까지 나왔는데"
    } ]
  }, {
    "tStartMs": 876370,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "물론 이탈리아잖아요"
    } ]
  }, {
    "tStartMs": 877520,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "밀라노니까"
    } ]
  }, {
    "tStartMs": 878160,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "이탈리아 사람들은 역시 이렇게 생각합니다"
    } ]
  }, {
    "tStartMs": 880290,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "그건 부끄러운 일이 아니다"
    } ]
  }, {
    "tStartMs": 881530,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "역시 사랑이 넘치는 이탈리아죠"
    } ]
  }, {
    "tStartMs": 884700,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "이상하게 보인다면"
    } ]
  }, {
    "tStartMs": 885570,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "여러분들은 올림픽의 관행을 모르는 거예요"
    } ]
  }, {
    "tStartMs": 888170,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "왜냐하면 사람들이 항의를 했어요"
    } ]
  }, {
    "tStartMs": 890400,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "1번 왜 올림픽에 콘돔을 뿌리냐"
    } ]
  }, {
    "tStartMs": 892690,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "2번 어떤 사람들은 왜 만 개밖에 안 뿌리냐"
    } ]
  }, {
    "tStartMs": 894960,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "두 개로 나뉘었는데"
    } ]
  }, {
    "tStartMs": 896220,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "이탈리아 주지사가 그렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 898530,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "이걸 이상하게 보면 안 돼"
    } ]
  }, {
    "tStartMs": 900080,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "이건 1988년 서울올림픽에서 시작됐어"
    } ]
  }, {
    "tStartMs": 904190,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "그래요?"
    } ]
  }, {
    "tStartMs": 906120,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "잠깐만"
    } ]
  }, {
    "tStartMs": 907330,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "동방예의지국이자 유교에 있어서는"
    } ]
  }, {
    "tStartMs": 909580,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "어느 나라 뺨도 때릴 수 있는 우리나라에서"
    } ]
  }, {
    "tStartMs": 912520,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "이걸 먼저 이렇게 줬다고?"
    } ]
  }, {
    "tStartMs": 915030,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "우린 예의지국이니까"
    } ]
  }, {
    "tStartMs": 916360,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "여기까지 와서 또 예의 없이"
    } ]
  }, {
    "tStartMs": 917660,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "또 그렇게 그런 사람이 있을까 봐"
    } ]
  }, {
    "tStartMs": 920680,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "어쩔 수 없는 건데"
    } ]
  }, {
    "tStartMs": 921760,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "선수들과 젊은이들에게 성병 예방"
    } ]
  }, {
    "tStartMs": 924160,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "아니면 임신 이런 거에 대한 인식을 높이기 위한 거지"
    } ]
  }, {
    "tStartMs": 927710,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "부끄러운 일이 아니다"
    } ]
  }, {
    "tStartMs": 928920,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "라고 역시 사랑이 넘치는"
    } ]
  }, {
    "tStartMs": 930440,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "이탈리아 주지사께서 일갈을 하셨죠"
    } ]
  }, {
    "tStartMs": 933150,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "그래서 아 그래서 거기에"
    } ]
  }, {
    "tStartMs": 934880,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "히알 뭐 무슨 산을 맞으면서"
    } ]
  }, {
    "tStartMs": 936630,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "이렇게 크기를 거시기 한건가 라고 생각을 했는데"
    } ]
  }, {
    "tStartMs": 940990,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "선수들이 주사를 맞은 이유는"
    } ]
  }, {
    "tStartMs": 942500,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "안타깝게도 사랑이 아니었어요"
    } ]
  }, {
    "tStartMs": 944930,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "차라리 사랑이면 봐줄 수 있는데"
    } ]
  }, {
    "tStartMs": 947010,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "차라리 사랑이면 안타깝습니다"
    } ]
  }, {
    "tStartMs": 948990,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "뭐 사랑 때문에 주사를 맞았다"
    } ]
  }, {
    "tStartMs": 950860,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "그러면은 그래 힘내라 할 수 있는데"
    } ]
  }, {
    "tStartMs": 952650,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "그게 아니라 그런 시술을 한 거는"
    } ]
  }, {
    "tStartMs": 955090,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "놀랍게도 공기역학"
    } ]
  }, {
    "tStartMs": 957420,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "경기력 향상과 관련이 있었습니다"
    } ]
  }, {
    "tStartMs": 960550,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "왜냐하면 이번에 의문이 제기된 종목이"
    } ]
  }, {
    "tStartMs": 962910,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "무슨 종목입니까?"
    } ]
  }, {
    "tStartMs": 964230,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "스키점프예요"
    } ]
  }, {
    "tStartMs": 966350,
    "dDurationMs": 4890,
    "segs": [ {
      "utf8": "그러면 스키점프와 거기에 주사가 무슨 상관이 있냐"
    } ]
  }, {
    "tStartMs": 971240,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "아니 그게 그렇다고 해서"
    } ]
  }, {
    "tStartMs": 973520,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "이게 그렇게 멀리 갈 것 같지는 않은데"
    } ]
  }, {
    "tStartMs": 975350,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "아니... 무슨 뭐"
    } ]
  }, {
    "tStartMs": 976290,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "여기다가 뭐 날개를 등에 뭐 그쵸?"
    } ]
  }, {
    "tStartMs": 978020,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "뭐 달던가 뭐 레드불 날개를 달아줘도 아니고"
    } ]
  }, {
    "tStartMs": 980380,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "그거 조금 맞는다고"
    } ]
  }, {
    "tStartMs": 981600,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "그게 뭐 그렇게 큰 영향이 있냐?"
    } ]
  }, {
    "tStartMs": 984300,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "자 일단 스키점프에서 굉장히 중요한 규칙이 있는데"
    } ]
  }, {
    "tStartMs": 987800,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "저도 이번에 알았습니다"
    } ]
  }, {
    "tStartMs": 989050,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "스키점프 선수들의 유니폼은 엄격히 규제된다고 합니다"
    } ]
  }, {
    "tStartMs": 992530,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "유니폼의 두께도 규정이 있고요"
    } ]
  }, {
    "tStartMs": 994380,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "소재도 규정이 있고"
    } ]
  }, {
    "tStartMs": 995780,
    "dDurationMs": 3650,
    "segs": [ {
      "utf8": "슈트의 치수가 딱 몸에 자기 몸에 딱 붙은 거에서"
    } ]
  }, {
    "tStartMs": 999430,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "최소 2cm 최대 4cm의 오차범위 내에 부합해야 된다고 합니다"
    } ]
  }, {
    "tStartMs": 1003490,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "규정에서 벗어난 유니폼은 바로 실격이에요"
    } ]
  }, {
    "tStartMs": 1005930,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "그래서 가끔 보시면"
    } ]
  }, {
    "tStartMs": 1006770,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "스키점프 대회 중에"
    } ]
  }, {
    "tStartMs": 1007990,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "선수를 이렇게 실격하는 경우가 있어요"
    } ]
  }, {
    "tStartMs": 1009950,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "왜냐하면 유니폼이 정해진 거를 넘은 거야"
    } ]
  }, {
    "tStartMs": 1012990,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "그러면 실격된다고 합니다"
    } ]
  }, {
    "tStartMs": 1014660,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "근데 당연하겠지만"
    } ]
  }, {
    "tStartMs": 1016130,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "유니폼이 몸에서 펑퍼짐한 거 입으면"
    } ]
  }, {
    "tStartMs": 1017900,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "더 멀리 갈 거 아니에요"
    } ]
  }, {
    "tStartMs": 1019740,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "날다람쥐 같은 거 입고 오면 어떡해"
    } ]
  }, {
    "tStartMs": 1021470,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "그러면 안 되기 때문에"
    } ]
  }, {
    "tStartMs": 1022260,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "유니폼이 굉장히 엄격히 규제된다고 합니다"
    } ]
  }, {
    "tStartMs": 1025450,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "우리가 얼핏 생각해도"
    } ]
  }, {
    "tStartMs": 1026830,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "슈트가 크고 점프복이 크고 헐렁하면"
    } ]
  }, {
    "tStartMs": 1029340,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "멀리 가겠죠"
    } ]
  }, {
    "tStartMs": 1030720,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "공기 저항이 굉장히 중요하니까"
    } ]
  }, {
    "tStartMs": 1032380,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "기록이 더 좋아질 수 있고"
    } ]
  }, {
    "tStartMs": 1033260,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "금메달, 은메달이 여기서 갈릴 수 있는데"
    } ]
  }, {
    "tStartMs": 1034860,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "약간의 차이가 있더라도"
    } ]
  }, {
    "tStartMs": 1036370,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "그래서 굉장히 점프복이 규제가 크다는 거죠"
    } ]
  }, {
    "tStartMs": 1039690,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "그래서 선수들은 슈트의 크기, 점프복의 크기에 대해서"
    } ]
  }, {
    "tStartMs": 1043270,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "굉장히 예민하다고 하는데"
    } ]
  }, {
    "tStartMs": 1044720,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "올림픽에서 엄격하게 체크됩니다"
    } ]
  }, {
    "tStartMs": 1046590,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "선수들의 신체가 3D 스캐너로 측정이 된다고 하고요"
    } ]
  }, {
    "tStartMs": 1049530,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "유니폼 내부에 옛날에"
    } ]
  }, {
    "tStartMs": 1051310,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "이게 옛날에 사건이 있었대요"
    } ]
  }, {
    "tStartMs": 1052800,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "이 슈트를 검사를 받은 다음에"
    } ]
  }, {
    "tStartMs": 1054450,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "그걸 안 입고"
    } ]
  }, {
    "tStartMs": 1055220,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "다른 조작된 옷을 입고"
    } ]
  }, {
    "tStartMs": 1057060,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "출전한 선수가 있었다고 합니다"
    } ]
  }, {
    "tStartMs": 1058630,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "그래서 이제는 유니폼 내부에 칩도 넣어"
    } ]
  }, {
    "tStartMs": 1061380,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "NFC 칩을 넣어"
    } ]
  }, {
    "tStartMs": 1062360,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "유니폼을 바꾸지 못하게"
    } ]
  }, {
    "tStartMs": 1064240,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "몰래 교체"
    } ]
  }, {
    "tStartMs": 1065330,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "수선 방지"
    } ]
  }, {
    "tStartMs": 1066560,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "칩도 넣습니다"
    } ]
  }, {
    "tStartMs": 1067850,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "수선도 안 돼"
    } ]
  }, {
    "tStartMs": 1069210,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "공정한 대회를 추구하는 거죠"
    } ]
  }, {
    "tStartMs": 1071490,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "자 그럼 이제 얼핏 생각하기에"
    } ]
  }, {
    "tStartMs": 1072790,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "아 그래요?"
    } ]
  }, {
    "tStartMs": 1073730,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "여기가 넓으면 부양력이 세져서"
    } ]
  }, {
    "tStartMs": 1076050,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "더 멀리 갈 수 있다고요?"
    } ]
  }, {
    "tStartMs": 1077010,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "그러면 옷을 늘리지 말고"
    } ]
  }, {
    "tStartMs": 1079570,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "선수의 몸을 불리면 되는 거 아니냐?"
    } ]
  }, {
    "tStartMs": 1082180,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "유민상을 스키점프 시키면"
    } ]
  }, {
    "tStartMs": 1083730,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "한 200m는 날아가는 거 아니냐?"
    } ]
  }, {
    "tStartMs": 1086010,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "어..."
    } ]
  }, {
    "tStartMs": 1087080,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "당연하겠지만 아닙니다"
    } ]
  }, {
    "tStartMs": 1089470,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "당연히 아니지"
    } ]
  }, {
    "tStartMs": 1090460,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "물리 법칙을 뭘로 보고"
    } ]
  }, {
    "tStartMs": 1092060,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "무거우면 멀리 가지 못해요"
    } ]
  }, {
    "tStartMs": 1094010,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "한 2m가겠다"
    } ]
  }, {
    "tStartMs": 1095170,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "점프가 안 되지"
    } ]
  }, {
    "tStartMs": 1096730,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "무거우면 멀리 날아가지 못하고"
    } ]
  }, {
    "tStartMs": 1098370,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "당연히 가벼워야 멀리 날아갑니다"
    } ]
  }, {
    "tStartMs": 1100150,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "그러니까 무슨 말이야"
    } ]
  }, {
    "tStartMs": 1101410,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "무게가 최대한 가벼운 상태에서 표면적이 넓어야죠"
    } ]
  }, {
    "tStartMs": 1104590,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "표면적이 넓어봐야 무거우면 안 돼 그렇죠?"
    } ]
  }, {
    "tStartMs": 1107400,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "동시에 돼야죠"
    } ]
  }, {
    "tStartMs": 1108390,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "가벼우면서 동일한 무게면"
    } ]
  }, {
    "tStartMs": 1110130,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "표면적이 넓어야 돼요"
    } ]
  }, {
    "tStartMs": 1111140,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "그래서 스키점프 선수들의 몸을 보면 어때요?"
    } ]
  }, {
    "tStartMs": 1113810,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "경마 선수 같죠?"
    } ]
  }, {
    "tStartMs": 1115490,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "경마 기수, 기수분들"
    } ]
  }, {
    "tStartMs": 1117150,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "몸이 얇고"
    } ]
  }, {
    "tStartMs": 1118200,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "최대한 좀 어떻게 보면 약간 왜소할 정도로 작고 말랐고"
    } ]
  }, {
    "tStartMs": 1121740,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "말라야 돼"
    } ]
  }, {
    "tStartMs": 1122830,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "가벼워야 멀리 날아가니까"
    } ]
  }, {
    "tStartMs": 1124180,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "살을 빼는 게 굉장히 중요하죠"
    } ]
  }, {
    "tStartMs": 1125830,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "그래서 스키점프 선수들은"
    } ]
  }, {
    "tStartMs": 1127100,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "BMI 규정도 있다고 합니다"
    } ]
  }, {
    "tStartMs": 1129400,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "스키점프 선수들이 비만 규정이잖아요"
    } ]
  }, {
    "tStartMs": 1132170,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "살 규정이 왜 있습니까?"
    } ]
  }, {
    "tStartMs": 1133650,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "너무 찌우는 걸 막는 거 아닙니다"
    } ]
  }, {
    "tStartMs": 1135830,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "너무 빼는 걸 막는 거예요"
    } ]
  }, {
    "tStartMs": 1137820,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "경마에도 비슷한 게 있죠"
    } ]
  }, {
    "tStartMs": 1138750,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "몸무게 규정이 있잖아요"
    } ]
  }, {
    "tStartMs": 1140280,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "선수들이 너무 빼면 건강을 해치니까"
    } ]
  }, {
    "tStartMs": 1142290,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "그걸 막기 위해서"
    } ]
  }, {
    "tStartMs": 1143460,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "BMI 21을 기준으로"
    } ]
  }, {
    "tStartMs": 1145110,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "그걸 내려가면 더 짧은 스키를 사용해야 돼요"
    } ]
  }, {
    "tStartMs": 1147710,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "BMI가 낮으면 이걸 넘겨야 됩니다"
    } ]
  }, {
    "tStartMs": 1150140,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "선수 키의 145%"
    } ]
  }, {
    "tStartMs": 1151970,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "스키 길이도 굉장히 관련이 있다고 합니다"
    } ]
  }, {
    "tStartMs": 1153960,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "이게 되게 엄격한 스포츠가 스키 점프다"
    } ]
  }, {
    "tStartMs": 1157330,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "방금 얘기 드렸지만"
    } ]
  }, {
    "tStartMs": 1158420,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "날다람쥐면 막 날아다니겠죠"
    } ]
  }, {
    "tStartMs": 1160740,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "선수들은 조금이라도 어떻게 됐건"
    } ]
  }, {
    "tStartMs": 1163070,
    "dDurationMs": 670,
    "segs": [ {
      "utf8": "내 몸무게에 비해서"
    } ]
  }, {
    "tStartMs": 1163740,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "몸을 이렇게 좀"
    } ]
  }, {
    "tStartMs": 1164900,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "이렇게 이렇게 조금이라도 넓히는 게"
    } ]
  }, {
    "tStartMs": 1167820,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "유혹이 되는 그런 스포츠라고 합니다"
    } ]
  }, {
    "tStartMs": 1169800,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "그래서 말만 들으면"
    } ]
  }, {
    "tStartMs": 1170800,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "아 알겠어"
    } ]
  }, {
    "tStartMs": 1172100,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "그럼 거기에 좀 이상한 표현이긴 한데"
    } ]
  }, {
    "tStartMs": 1174720,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "이 주사를 맞아서"
    } ]
  }, {
    "tStartMs": 1176210,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "거기가 커지면 표면적이 넓어지니까"
    } ]
  }, {
    "tStartMs": 1178470,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "좀 더 멀리 날아갈 수 있다고"
    } ]
  }, {
    "tStartMs": 1179440,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "이런 걸로 들리잖아요"
    } ]
  }, {
    "tStartMs": 1180820,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "그런데 처음 들으면"
    } ]
  }, {
    "tStartMs": 1182270,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "아니 아무리 그래도 그거 좀 키웠다고"
    } ]
  }, {
    "tStartMs": 1185210,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "그게 얼마나 더 가냐"
    } ]
  }, {
    "tStartMs": 1186830,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "도대체 얼마나 키웠길래"
    } ]
  }, {
    "tStartMs": 1188500,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "그게 날아가는데 도움을 줄 정도냐"
    } ]
  }, {
    "tStartMs": 1190620,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "아니 이게 무게가 중요한 게 아니라"
    } ]
  }, {
    "tStartMs": 1192550,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "면적이잖아요 면적"
    } ]
  }, {
    "tStartMs": 1193690,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "표면적을 도대체 얼마나 키워야"
    } ]
  }, {
    "tStartMs": 1195500,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "그게 점프하는데 도움을 주겠냐"
    } ]
  }, {
    "tStartMs": 1197330,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "우리 이런 생각하잖아요"
    } ]
  }, {
    "tStartMs": 1198760,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "놀랍게도 이게 연구자료가 있습니다"
    } ]
  }, {
    "tStartMs": 1200700,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "어떤 과학자분이 이걸 연구를 했어요"
    } ]
  }, {
    "tStartMs": 1202400,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "물론 거기에 놓은 주사 크기를 연구한 게 아니라"
    } ]
  }, {
    "tStartMs": 1205320,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "점프할 때 점프복을 크기를 늘리면"
    } ]
  }, {
    "tStartMs": 1207880,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "얼마나 멀리 갈 수 있냐"
    } ]
  }, {
    "tStartMs": 1209380,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "점프복이 4분의 3인치"
    } ]
  }, {
    "tStartMs": 1211380,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "한 2cm"
    } ]
  }, {
    "tStartMs": 1212600,
    "dDurationMs": 440,
    "segs": [ {
      "utf8": "여기"
    } ]
  }, {
    "tStartMs": 1213040,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "여기 2cm, 여기 2cm"
    } ]
  }, {
    "tStartMs": 1214250,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "이런 식으로 늘리면"
    } ]
  }, {
    "tStartMs": 1215390,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "양력이 5% 증가하고"
    } ]
  }, {
    "tStartMs": 1216580,
    "dDurationMs": 5380,
    "segs": [ {
      "utf8": "점프 거리가 최대 4.9m, 5m가 더 갈 수 있다고 합니다"
    } ]
  }, {
    "tStartMs": 1221960,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "2cm, 2cm, 2cm의 차이로도"
    } ]
  }, {
    "tStartMs": 1224020,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "굉장히 점프가 늘어날 수 있다는 거죠"
    } ]
  }, {
    "tStartMs": 1226620,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "와, 이거 진짠가?"
    } ]
  }, {
    "tStartMs": 1227810,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "물론 이게 여기 2cm만으로는 안 될 것 같고"
    } ]
  }, {
    "tStartMs": 1229980,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "전반적으로 2cm가 늘어났겠죠"
    } ]
  }, {
    "tStartMs": 1231480,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "그러니까 표면적은 더 많이 늘었을지 않을까 생각하는데"
    } ]
  }, {
    "tStartMs": 1234140,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "약간의 차이만으로도 게다가 세계적인 선수들이잖아요"
    } ]
  }, {
    "tStartMs": 1237150,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "선수들 간에 실력 차이가 별로 없잖아요"
    } ]
  }, {
    "tStartMs": 1238640,
    "dDurationMs": 3970,
    "segs": [ {
      "utf8": "조금만 더 가도 금메달, 은메달 순위가 바뀌기 때문에"
    } ]
  }, {
    "tStartMs": 1242610,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "조금만 키우는 것도"
    } ]
  }, {
    "tStartMs": 1243820,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "굉장히 큰 차이를 가져올 수 있다"
    } ]
  }, {
    "tStartMs": 1245960,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "게다가 올림픽에서 엄격하게 검사는 하는데"
    } ]
  }, {
    "tStartMs": 1249440,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "그거는 신체와 옷의 관계지, 점프의 관계지"
    } ]
  }, {
    "tStartMs": 1253520,
    "dDurationMs": 6010,
    "segs": [ {
      "utf8": "신체를 그거를 그 체크하지는 않을 거 아니냐"
    } ]
  }, {
    "tStartMs": 1259530,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "거기다가 그게 그러니까 원래 큰지"
    } ]
  }, {
    "tStartMs": 1262820,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "이걸 넣어서 큰지를 체크를 안 할 거 아니냐라고 생각을 한다는 거죠"
    } ]
  }, {
    "tStartMs": 1265910,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "설마 그걸 체크할까"
    } ]
  }, {
    "tStartMs": 1267810,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "이게 원래 당신의 크기입니까"
    } ]
  }, {
    "tStartMs": 1269500,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "이걸 좀 그러니까 지금까지 점프복에 내용물을"
    } ]
  }, {
    "tStartMs": 1273490,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "와 진짜 아이디어 기가 막히네 기가 막혀"
    } ]
  }, {
    "tStartMs": 1276300,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "이 내용물을 조작하겠다는 발상을 못했다는 거죠"
    } ]
  }, {
    "tStartMs": 1278780,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "그전까지는 이 옷만 체크했는데 옷만"
    } ]
  }, {
    "tStartMs": 1281260,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "이 살과 옷의 뭐 이"
    } ]
  }, {
    "tStartMs": 1283410,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "그쵸 벌어진 간격을 체크했는데"
    } ]
  }, {
    "tStartMs": 1285380,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "그 살 안에 거시기할지는"
    } ]
  }, {
    "tStartMs": 1287200,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "이제 예상을 못했다"
    } ]
  }, {
    "tStartMs": 1289180,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "물론 지금까지 얘기한 건"
    } ]
  }, {
    "tStartMs": 1290740,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "루머가 쫙 퍼져서"
    } ]
  }, {
    "tStartMs": 1291950,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "요게 그 게이트까지 갔는데"
    } ]
  }, {
    "tStartMs": 1293880,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "이번 올림픽에서 그걸로 걸린 선수는 없습니다"
    } ]
  }, {
    "tStartMs": 1297000,
    "dDurationMs": 3910,
    "segs": [ {
      "utf8": "그 히알루론산 주사를 맞은 선수가 없어요"
    } ]
  }, {
    "tStartMs": 1300910,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "그럼 이게 왜 퍼졌냐?"
    } ]
  }, {
    "tStartMs": 1301920,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "한 타블로이드 신문에 루머 기사가 퍼진 겁니다"
    } ]
  }, {
    "tStartMs": 1305280,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "그럼 뭐야 말짱 꽝이잖아"
    } ]
  }, {
    "tStartMs": 1306690,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "아예 그런 게 없어?"
    } ]
  }, {
    "tStartMs": 1307650,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "그건 또 아니에요"
    } ]
  }, {
    "tStartMs": 1309420,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "그게 무슨 말이냐?"
    } ]
  }, {
    "tStartMs": 1310820,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "이게 아무런 이유 없이 퍼진 건 아닙니다"
    } ]
  }, {
    "tStartMs": 1313540,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "지난해 작년에 비슷한 사건이 있었어요"
    } ]
  }, {
    "tStartMs": 1317400,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "동계올림픽의 강국 노르웨이 대표팀이"
    } ]
  }, {
    "tStartMs": 1320480,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "장비 담당자가 장비가 통과했죠"
    } ]
  }, {
    "tStartMs": 1322860,
    "dDurationMs": 3890,
    "segs": [ {
      "utf8": "그 다음에 점프복을 불법적으로 다시 손보는 장면이"
    } ]
  }, {
    "tStartMs": 1326750,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "몰래 촬영돼서 공개된 사건이 있었습니다"
    } ]
  }, {
    "tStartMs": 1328780,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "작년에 이게 있었대요"
    } ]
  }, {
    "tStartMs": 1330320,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "제보를 받은 조사관들이 현장을 덮쳤다"
    } ]
  }, {
    "tStartMs": 1333180,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "이놈들이 어디를 몰래 불법적으로 손보냐?"
    } ]
  }, {
    "tStartMs": 1336170,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "라고 보니까"
    } ]
  }, {
    "tStartMs": 1337950,
    "dDurationMs": 4070,
    "segs": [ {
      "utf8": "사타구니 거시기 한 대를 이렇게 손을 보고 있더라"
    } ]
  }, {
    "tStartMs": 1342020,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "키워서 늘려서"
    } ]
  }, {
    "tStartMs": 1343550,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "한마디로 노르웨이가 이건 실제 있었던 사건입니다"
    } ]
  }, {
    "tStartMs": 1346970,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "점프복의 사타구니 부근에 보강재를 넣어서"
    } ]
  }, {
    "tStartMs": 1350900,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "헐렁하게 만들었다"
    } ]
  }, {
    "tStartMs": 1352810,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "몸과 밀착되지 않도록"
    } ]
  }, {
    "tStartMs": 1354070,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "거기다가 뭔가"
    } ]
  }, {
    "tStartMs": 1356160,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "아 지금 뭐야 잠깐만 이거를 이만한데"
    } ]
  }, {
    "tStartMs": 1358750,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "이렇게 적절히 생각하세요"
    } ]
  }, {
    "tStartMs": 1361240,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "거기다가 보강재를 넣어서"
    } ]
  }, {
    "tStartMs": 1363260,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "이게 되게 널널한 것처럼 헐렁하게 만든 거죠"
    } ]
  }, {
    "tStartMs": 1366590,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "큰 것처럼 해서"
    } ]
  }, {
    "tStartMs": 1367550,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "헐렁하게 만들어서 이게 걸렸어요"
    } ]
  }, {
    "tStartMs": 1369410,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "1월 15일 날 코치 및 장비 담당자 3명이"
    } ]
  }, {
    "tStartMs": 1372380,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "18개월 간 출전 정지 징계를 먹었습니다"
    } ]
  }, {
    "tStartMs": 1375770,
    "dDurationMs": 3610,
    "segs": [ {
      "utf8": "이게 소위 사타구니 게이트예요"
    } ]
  }, {
    "tStartMs": 1379380,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "거시기 게이트인데"
    } ]
  }, {
    "tStartMs": 1380580,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "이 게이트 때문에"
    } ]
  }, {
    "tStartMs": 1381620,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "노르웨이가 국가적인 개망신을 당했습니다"
    } ]
  }, {
    "tStartMs": 1384840,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "왜 개망신이냐?"
    } ]
  }, {
    "tStartMs": 1386190,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "무슨 무슨 게이트는 할 수 있는데"
    } ]
  }, {
    "tStartMs": 1387890,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "하필 게이트 이름이 그쵸?"
    } ]
  }, {
    "tStartMs": 1390450,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "거기 게이트여서 이름 자체로도 벌써 망신 중에 망신이야"
    } ]
  }, {
    "tStartMs": 1394920,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "노르웨이 보면은 넣었냐?"
    } ]
  }, {
    "tStartMs": 1396870,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "이렇게 얘기를 하니까"
    } ]
  }, {
    "tStartMs": 1397680,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "이렇게 갑자기 위를 보다가"
    } ]
  }, {
    "tStartMs": 1399260,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "시선을 좀 낮추더니"
    } ]
  }, {
    "tStartMs": 1401510,
    "dDurationMs": 110,
    "segs": [ {
      "utf8": "야야야"
    } ]
  }, {
    "tStartMs": 1401620,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "오 야 넣은겨?"
    } ]
  }, {
    "tStartMs": 1404480,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "뭐 이렇게 물어보고 하니까"
    } ]
  }, {
    "tStartMs": 1405860,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "국가적 개망신을 당했고"
    } ]
  }, {
    "tStartMs": 1408150,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "게다가 노르웨이가 동계올림픽에 존재감이 없는 나라면 모르겠는데"
    } ]
  }, {
    "tStartMs": 1411440,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "이번 동계올림픽에서도 압도적인 성적"
    } ]
  }, {
    "tStartMs": 1413230,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "금메달 18개야 18개"
    } ]
  }, {
    "tStartMs": 1414860,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "2위가 미국인데"
    } ]
  }, {
    "tStartMs": 1415800,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "미국 11개입니다"
    } ]
  }, {
    "tStartMs": 1416810,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "압도적인 성적으로 종합 1위를 하는"
    } ]
  }, {
    "tStartMs": 1418550,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "말 그대로 동계올림픽 그 자체인 나라"
    } ]
  }, {
    "tStartMs": 1420890,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "근데 게이트에 걸렸는데"
    } ]
  }, {
    "tStartMs": 1422900,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "거기 게이트 이게 되다 보니까"
    } ]
  }, {
    "tStartMs": 1425500,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "그래서 이거 걸린 코치가"
    } ]
  }, {
    "tStartMs": 1427520,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "정말 눈물의 사과를 날렸습니다"
    } ]
  }, {
    "tStartMs": 1430350,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "정말 죄송합니다"
    } ]
  }, {
    "tStartMs": 1431540,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "우리는 정말 개처럼 후회하고 있습니다"
    } ]
  }, {
    "tStartMs": 1434020,
    "dDurationMs": 540,
    "segs": [ {
      "utf8": "제가 한 말이 아니라"
    } ]
  }, {
    "tStartMs": 1434560,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "여기 있습니다"
    } ]
  }, {
    "tStartMs": 1435170,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "정말 like dogs니까"
    } ]
  }, {
    "tStartMs": 1436920,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "우리말로 하면 뭡니까?"
    } ]
  }, {
    "tStartMs": 1438170,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "미친 듯이 후회하고 있어요"
    } ]
  }, {
    "tStartMs": 1439730,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "내가 왜 그랬을까요?"
    } ]
  }, {
    "tStartMs": 1440940,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "정말 죄송합니다"
    } ]
  }, {
    "tStartMs": 1442240,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "뭐 어떻게 할까요?"
    } ]
  }, {
    "tStartMs": 1442960,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "라고 말 그대로 머리를 콱 박은 국가적 치욕"
    } ]
  }, {
    "tStartMs": 1446640,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "부끄러운 국가적 소동"
    } ]
  }, {
    "tStartMs": 1448580,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "노르웨이 하면은 갑자기 그 사타구니 게이트가 떠오르는"
    } ]
  }, {
    "tStartMs": 1452120,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "뭐 넣었냐 자꾸 이런 얘기를 하니까"
    } ]
  }, {
    "tStartMs": 1453880,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "같은 반칙이라도 말이야"
    } ]
  }, {
    "tStartMs": 1455590,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "조금 멋있는 게 있는데"
    } ]
  }, {
    "tStartMs": 1457280,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "그런 게 아니라 그렇게 돼서"
    } ]
  }, {
    "tStartMs": 1458560,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "굉장히 좀 후회하고"
    } ]
  }, {
    "tStartMs": 1460310,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "그랬다는 뉴스가 많이 나왔어요"
    } ]
  }, {
    "tStartMs": 1462300,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "그런데 그건 노르웨이 얘기잖아"
    } ]
  }, {
    "tStartMs": 1464220,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "어쨌건 국가적으로 후회하고"
    } ]
  }, {
    "tStartMs": 1465750,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "옆에 있는 나라들이 보기에는"
    } ]
  }, {
    "tStartMs": 1467330,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "쟤네 걸렸단다 걸렸대"
    } ]
  }, {
    "tStartMs": 1469640,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "뭐가 걸렸는데"
    } ]
  }, {
    "tStartMs": 1470660,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "거기 사타구니가 걸렸다"
    } ]
  }, {
    "tStartMs": 1473240,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "이러니까 옆에 있는 나라들이"
    } ]
  }, {
    "tStartMs": 1474550,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "자꾸 낄낄대는 거죠"
    } ]
  }, {
    "tStartMs": 1475970,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "그러면서 이 몹쓸"
    } ]
  }, {
    "tStartMs": 1477200,
    "dDurationMs": 6300,
    "segs": [ {
      "utf8": "또 몹쓸 이 독일 신문이 빌트지가 뭐라고 이번에 기사를 냈냐"
    } ]
  }, {
    "tStartMs": 1483500,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "노르웨이 놈들 하는 걸 보니까"
    } ]
  }, {
    "tStartMs": 1485530,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "거기다가 자꾸 뭘 넣잖아"
    } ]
  }, {
    "tStartMs": 1486750,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "지난 번에 옷에 넣어서 걸렸지"
    } ]
  }, {
    "tStartMs": 1488490,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "혹시 거기에는 안 넣을까?"
    } ]
  }, {
    "tStartMs": 1491870,
    "dDurationMs": 3610,
    "segs": [ {
      "utf8": "라는 이런 몹쓸 의혹을 제기한 겁니다"
    } ]
  }, {
    "tStartMs": 1495480,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "타블로이드지가"
    } ]
  }, {
    "tStartMs": 1496730,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "거기는 혹시 조사해봤어요?"
    } ]
  }, {
    "tStartMs": 1498310,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "라고 얘기한 거죠"
    } ]
  }, {
    "tStartMs": 1499470,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "아니 일부 선수들이"
    } ]
  }, {
    "tStartMs": 1502310,
    "dDurationMs": 4030,
    "segs": [ {
      "utf8": "거기 옷에다가 넣어서 걸린 거를 확대를 하면서"
    } ]
  }, {
    "tStartMs": 1506340,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "주사 가능성도 있지 않냐"
    } ]
  }, {
    "tStartMs": 1508600,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "걸린 게 아니라"
    } ]
  }, {
    "tStartMs": 1509730,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "그런 얘기를 하면서 루머가 커졌고"
    } ]
  }, {
    "tStartMs": 1511790,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "그리고 아까 얘기했던"
    } ]
  }, {
    "tStartMs": 1512790,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "페니스 게이트"
    } ]
  }, {
    "tStartMs": 1513520,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "이 이름도 아주 적절하죠"
    } ]
  }, {
    "tStartMs": 1515500,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "당연히 노르웨이가 지은 게 아니죠"
    } ]
  }, {
    "tStartMs": 1517950,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "당연히 노르웨이가 저거를 그렇게 지었겠습니까 이름을"
    } ]
  }, {
    "tStartMs": 1520740,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "옆 나라 독일에서"
    } ]
  }, {
    "tStartMs": 1522640,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "이게 손가락 가리키면서 적절해"
    } ]
  }, {
    "tStartMs": 1525210,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "저 나라는 페니스 게이트구만 해서"
    } ]
  }, {
    "tStartMs": 1527940,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "그 이름이 붙어서"
    } ]
  }, {
    "tStartMs": 1528770,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "전 세계로 퍼지게 됐고요"
    } ]
  }, {
    "tStartMs": 1530730,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "또 이거 재밌으니까"
    } ]
  }, {
    "tStartMs": 1532260,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "전 세계 언론들이 다 물어 갖고"
    } ]
  }, {
    "tStartMs": 1533830,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "심지어 슈카월드까지 물어 갖고 하고 있지 않습니까?"
    } ]
  }, {
    "tStartMs": 1536780,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "이게 또 재밌거든"
    } ]
  }, {
    "tStartMs": 1538000,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "그래서 아주 널리 퍼졌고요"
    } ]
  }, {
    "tStartMs": 1539390,
    "dDurationMs": 3890,
    "segs": [ {
      "utf8": "덕분에 노르웨이가 극대노했죠 극대노"
    } ]
  }, {
    "tStartMs": 1543280,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "진짜 극대노했습니다"
    } ]
  }, {
    "tStartMs": 1544540,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "있지도 않은 사실을 꼭 있는 것처럼"
    } ]
  }, {
    "tStartMs": 1546490,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "그렇게 확대 재생산하면 어떡하냐?"
    } ]
  }, {
    "tStartMs": 1548510,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "전 세계 언론들이 이걸 다 퍼가고"
    } ]
  }, {
    "tStartMs": 1550070,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "심지어 AP에도 뜨고"
    } ]
  }, {
    "tStartMs": 1551460,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "로이터에도 뜨고"
    } ]
  }, {
    "tStartMs": 1552450,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "야 이게 말이 되냐?"
    } ]
  }, {
    "tStartMs": 1553340,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "외국 언론들이 저 몹쓸 독일놈들 저놈들이"
    } ]
  }, {
    "tStartMs": 1556150,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "혼란을 틈타가 이득을 취하고 있다"
    } ]
  }, {
    "tStartMs": 1558120,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "라고 극대노하고 있는 게 지금의 모습"
    } ]
  }, {
    "tStartMs": 1561140,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "저는 진실을 알려드렸어요"
    } ]
  }, {
    "tStartMs": 1562540,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "노르웨이는 죄가 없는 건 아니지만"
    } ]
  }, {
    "tStartMs": 1564480,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "이번 사건에 대해서는 죄가 없다"
    } ]
  }, {
    "tStartMs": 1566620,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "거기에 맞은 건 아니다 그랬는데"
    } ]
  }, {
    "tStartMs": 1569900,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "그냥 타블로이드 신문에서 이렇게 넘어갔으면 됐는데"
    } ]
  }, {
    "tStartMs": 1573120,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "문제는 이번에 공식 기자회견 장소에서"
    } ]
  }, {
    "tStartMs": 1576670,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "세계 반도핑 당국 WADA"
    } ]
  }, {
    "tStartMs": 1578940,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "다 아시죠? WADA"
    } ]
  }, {
    "tStartMs": 1580660,
    "dDurationMs": 3850,
    "segs": [ {
      "utf8": "여기가 참석한 공식 회견에서 기자가 물어봤어요"
    } ]
  }, {
    "tStartMs": 1584510,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "그래서 더 크게 뉴스가 됐습니다"
    } ]
  }, {
    "tStartMs": 1585700,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "기자가 뭐라고 물어봤냐"
    } ]
  }, {
    "tStartMs": 1586440,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "WADA 반도핑 당국이"
    } ]
  }, {
    "tStartMs": 1588570,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "우리가 이번에 특별히 스테로이드가 어떻고"
    } ]
  }, {
    "tStartMs": 1591850,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "무슨 약물이 어떻고"
    } ]
  }, {
    "tStartMs": 1593080,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "약물 검사를 우리가 철저하게 하고"
    } ]
  }, {
    "tStartMs": 1595200,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "그랬더니 기자가 듣더니 그래요"
    } ]
  }, {
    "tStartMs": 1596500,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "약물 검사 철저하게 하겠습니다"
    } ]
  }, {
    "tStartMs": 1597940,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "그런데 혹시 거기는 조사해보셨습니까?"
    } ]
  }, {
    "tStartMs": 1600500,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "라고 실제로 질문을 했습니다"
    } ]
  }, {
    "tStartMs": 1602340,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "WADA가 막 대답하다가"
    } ]
  }, {
    "tStartMs": 1604200,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "뭐요?"
    } ]
  }, {
    "tStartMs": 1605210,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "이번에 신문 안 보셨어요?"
    } ]
  }, {
    "tStartMs": 1606730,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "거기다가 놨다던데 혹시 조사해보셨어요?"
    } ]
  }, {
    "tStartMs": 1610030,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "물론 WADA에서는 거기에 대한 대응은"
    } ]
  }, {
    "tStartMs": 1612760,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "준비를 안 했기 때문에"
    } ]
  }, {
    "tStartMs": 1615400,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "갑자기 말이 멈췄고"
    } ]
  }, {
    "tStartMs": 1617520,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "진행자가 이렇게 얘기했다고 합니다"
    } ]
  }, {
    "tStartMs": 1619550,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "어? 선생님들? 답하셔야죠"
    } ]
  }, {
    "tStartMs": 1622060,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "어? 모르세요?"
    } ]
  }, {
    "tStartMs": 1623040,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "답하실 분 안 계세요?"
    } ]
  }, {
    "tStartMs": 1624100,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "거기 확인 안 해봤어요? 넣었어요? 안 넣었어요?"
    } ]
  }, {
    "tStartMs": 1626910,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "이렇게 얘기하니까"
    } ]
  }, {
    "tStartMs": 1627910,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "조용한 적막이 흐르면서"
    } ]
  }, {
    "tStartMs": 1630940,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "이거를 어떻게 해야 되냐"
    } ]
  }, {
    "tStartMs": 1633110,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "확인을 했다 그래야 되냐"
    } ]
  }, {
    "tStartMs": 1634450,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "안 했다 그래야 되냐"
    } ]
  }, {
    "tStartMs": 1635540,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "그리고 1번은 그거고"
    } ]
  }, {
    "tStartMs": 1636720,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "2번은 이게 도핑 기구가 책임질 문제냐?"
    } ]
  }, {
    "tStartMs": 1640470,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "도핑이냐 아니냐"
    } ]
  }, {
    "tStartMs": 1642240,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "아 애매합니다"
    } ]
  }, {
    "tStartMs": 1643110,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "도핑입니까? 아닙니까? 그거"
    } ]
  }, {
    "tStartMs": 1645700,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "이게 이제 애매하죠"
    } ]
  }, {
    "tStartMs": 1647070,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "그러다 보니까"
    } ]
  }, {
    "tStartMs": 1648460,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "그럼 아무도 검사하는 게 아니냐"
    } ]
  }, {
    "tStartMs": 1650220,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "이런 불신이 퍼지게 됐고"
    } ]
  }, {
    "tStartMs": 1651760,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "그래서 WADA 사무총장이 공식적으로 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1655250,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "제가 꼼꼼하게 살펴보겠습니다"
    } ]
  }, {
    "tStartMs": 1657430,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "모든 형태의 도핑을 조사하겠습니다"
    } ]
  }, {
    "tStartMs": 1660600,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "모든 형태라는 말을 넣은 게"
    } ]
  }, {
    "tStartMs": 1662910,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "아까 얘기했던 그거 거기에 주사 놓는 거"
    } ]
  }, {
    "tStartMs": 1665560,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "그게 도핑이냐 아니냐는 말을 만드니까"
    } ]
  }, {
    "tStartMs": 1667450,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "우리는 빼지 않고 모든 형태를 조사하겠다"
    } ]
  }, {
    "tStartMs": 1670430,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "제가 꼭 조사하겠다고 약속하겠습니다"
    } ]
  }, {
    "tStartMs": 1672900,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "라고 얘기를 했는데"
    } ]
  }, {
    "tStartMs": 1673920,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "그러다 보니까 또 많은 사람들이"
    } ]
  }, {
    "tStartMs": 1676440,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "몹쓸 사람들이 많아요"
    } ]
  }, {
    "tStartMs": 1677440,
    "dDurationMs": 3650,
    "segs": [ {
      "utf8": "그 조사를 어떻게"
    } ]
  }, {
    "tStartMs": 1681090,
    "dDurationMs": 4490,
    "segs": [ {
      "utf8": "원래 지금은 3D 스캐너로 신체 길이만 측정하는데"
    } ]
  }, {
    "tStartMs": 1685580,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "그니까 옷하고 이렇게 몸을 측정하는데"
    } ]
  }, {
    "tStartMs": 1688380,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "거기 넣는지를 어떻게"
    } ]
  }, {
    "tStartMs": 1690640,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "이게 필러인데"
    } ]
  }, {
    "tStartMs": 1691800,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "뭐 이런 걸 또 이제 물어와서"
    } ]
  }, {
    "tStartMs": 1693600,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "음 뭐 결론적으로는 아직 해본 적은 없으니까"
    } ]
  }, {
    "tStartMs": 1697140,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "누가 알겠어요"
    } ]
  }, {
    "tStartMs": 1697830,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "그거 어떻게 할지"
    } ]
  }, {
    "tStartMs": 1698570,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "그게 뭐 필러가 찍어서 나오는지도 모르겠는데"
    } ]
  }, {
    "tStartMs": 1700650,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "조용했다라는 게 이번 사건이고요"
    } ]
  }, {
    "tStartMs": 1703680,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "그러다 보니까"
    } ]
  }, {
    "tStartMs": 1704180,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "또 사람들이 또 의구심을 갖는 게"
    } ]
  }, {
    "tStartMs": 1706250,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "미용 목적으로 넣은 필러도 부정행위냐"
    } ]
  }, {
    "tStartMs": 1708990,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "꼭 거기가 아니더라도"
    } ]
  }, {
    "tStartMs": 1710550,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "뭐 뺨에도 넣고"
    } ]
  }, {
    "tStartMs": 1711840,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "여기 뭐 여기도 넣잖아요"
    } ]
  }, {
    "tStartMs": 1712700,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "여기도 넣고"
    } ]
  }, {
    "tStartMs": 1713590,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "주름 없애려고 이렇게 필러 많이 넣는데"
    } ]
  }, {
    "tStartMs": 1716030,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "그런 거는 여기 넣었을 수도 있지 어깨나"
    } ]
  }, {
    "tStartMs": 1718730,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "뭐 이런데 아니면 부정행위입니까?"
    } ]
  }, {
    "tStartMs": 1721130,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "라고 또 해서"
    } ]
  }, {
    "tStartMs": 1722500,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "굉장히 또 이슈가 됐던 사건이라고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 1725600,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "그래서 이제 밀라노 동계올림픽은 끝났는데"
    } ]
  }, {
    "tStartMs": 1728520,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "다음은 어디입니까?"
    } ]
  }, {
    "tStartMs": 1730040,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "다음은 동계 아시안게임이 있습니다"
    } ]
  }, {
    "tStartMs": 1732750,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "동계 아시안게임 어디서 합니까?"
    } ]
  }, {
    "tStartMs": 1733800,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "2029년 카자흐스탄 알마티에서 해요"
    } ]
  }, {
    "tStartMs": 1736740,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "어?"
    } ]
  }, {
    "tStartMs": 1737700,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "기억력 좋으신 분들은"
    } ]
  }, {
    "tStartMs": 1738780,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "사우디에서 한다고 하지 않았나요?"
    } ]
  }, {
    "tStartMs": 1740530,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "사우디 네옴, 네옴시"
    } ]
  }, {
    "tStartMs": 1741940,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "2029 동계 아시안게임"
    } ]
  }, {
    "tStartMs": 1743200,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "엄청난 돈을 들여서 최고의 아시안게임을 만들겠다"
    } ]
  }, {
    "tStartMs": 1746720,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "그거 어떻게 됐냐면"
    } ]
  }, {
    "tStartMs": 1749020,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "포기했습니다"
    } ]
  }, {
    "tStartMs": 1749720,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "포기했어요"
    } ]
  }, {
    "tStartMs": 1751140,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "대신할 사람?해서"
    } ]
  }, {
    "tStartMs": 1752280,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "우리나라에도 개최 의사가 왔다 그래요"
    } ]
  }, {
    "tStartMs": 1754600,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "한국아 대신할래?"
    } ]
  }, {
    "tStartMs": 1756480,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "우리는 아 동계 아시안게임 좀..."
    } ]
  }, {
    "tStartMs": 1758860,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "그래서 이제 카자흐스탄이 개최권을 가져갔다라고 하고요"
    } ]
  }, {
    "tStartMs": 1762980,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "예전에 기억이 나시겠지만"
    } ]
  }, {
    "tStartMs": 1764090,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "사우디가 돈을 엄청나게 써서"
    } ]
  }, {
    "tStartMs": 1765680,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "이 사진 기억나시죠?"
    } ]
  }, {
    "tStartMs": 1766700,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "트로제나, 네옴 시티의 산악 관광지"
    } ]
  }, {
    "tStartMs": 1769360,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "슬로프 길이가 36km 미쳤다"
    } ]
  }, {
    "tStartMs": 1771700,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "고급 레스토랑, 럭셔리 스파"
    } ]
  }, {
    "tStartMs": 1773430,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "말 그대로 우주선을 만든 것 같은 거를"
    } ]
  }, {
    "tStartMs": 1775590,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "열사의 나라지만"
    } ]
  }, {
    "tStartMs": 1776380,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "저 높은 산 꼭대기에 뭘 짓겠다"
    } ]
  }, {
    "tStartMs": 1779260,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "지었다가 아니라 지을 생각이었다"
    } ]
  }, {
    "tStartMs": 1781860,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "또는 짓겠다"
    } ]
  }, {
    "tStartMs": 1783150,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "인공 눈으로 다 덮겠다"
    } ]
  }, {
    "tStartMs": 1785190,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "괄호 열고 안 할 수도 있죠"
    } ]
  }, {
    "tStartMs": 1786890,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "그래서 안 하는 걸로 결정이 됐습니다"
    } ]
  }, {
    "tStartMs": 1789820,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "안 할 수도 있었기 때문에"
    } ]
  }, {
    "tStartMs": 1791110,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "안 하게 됐고요"
    } ]
  }, {
    "tStartMs": 1792550,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "안 한 이유는"
    } ]
  }, {
    "tStartMs": 1793150,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "여러 가지 이야기가 있지만"
    } ]
  }, {
    "tStartMs": 1794530,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "결국 국제 유가도 있고"
    } ]
  }, {
    "tStartMs": 1796520,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "돈이 너무 많이 드니까"
    } ]
  }, {
    "tStartMs": 1798350,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "사우디가 포기한 것처럼 보이고"
    } ]
  }, {
    "tStartMs": 1799970,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "사우디는 참고로"
    } ]
  }, {
    "tStartMs": 1801180,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "옛날에 유명했던 더 라인"
    } ]
  }, {
    "tStartMs": 1802660,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "170km짜리 벽으로 된 거의 엄청난 건물을 지어서"
    } ]
  }, {
    "tStartMs": 1806540,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "여기에 몇 백만 명을 살게 해야겠다"
    } ]
  }, {
    "tStartMs": 1808450,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "라는 그 계획이 현재 170이 아니라"
    } ]
  }, {
    "tStartMs": 1811120,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "2.4km로 줄었다 그럽니다"
    } ]
  }, {
    "tStartMs": 1813220,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "이것도 어떻게 되는지는 모르겠어요"
    } ]
  }, {
    "tStartMs": 1814760,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "재설계 중이라고 합니다"
    } ]
  }, {
    "tStartMs": 1816400,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "그리고 옛날에 슈카월드에 나왔던"
    } ]
  }, {
    "tStartMs": 1817970,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "더 큐브"
    } ]
  }, {
    "tStartMs": 1818930,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "가로 세로 400m 규모의 정육면체"
    } ]
  }, {
    "tStartMs": 1821800,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "엄청난 규모의 무카브라고 불리는 건물이 있습니다"
    } ]
  }, {
    "tStartMs": 1825390,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "엠파이어 스테이트 빌딩 20개가 들어가는 말도 안 되죠"
    } ]
  }, {
    "tStartMs": 1827880,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "400, 400, 400"
    } ]
  }, {
    "tStartMs": 1829070,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "이거 중단됐고요"
    } ]
  }, {
    "tStartMs": 1830860,
    "dDurationMs": 550,
    "segs": [ {
      "utf8": "그렇습니다"
    } ]
  }, {
    "tStartMs": 1831410,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "사우디 비전 2030 이 프로젝트들이"
    } ]
  }, {
    "tStartMs": 1833820,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "지금 현재 대부분 재정비되고 있는"
    } ]
  }, {
    "tStartMs": 1835970,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "그런 상태라고 보시면 되고"
    } ]
  }, {
    "tStartMs": 1837730,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "모든 게 재정비는 아닙니다"
    } ]
  }, {
    "tStartMs": 1839120,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "아직 남은 거 있습니다"
    } ]
  }, {
    "tStartMs": 1840220,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "2030년 사우디 리야드 엑스포"
    } ]
  }, {
    "tStartMs": 1842910,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "안 할 거면 우리 주지"
    } ]
  }, {
    "tStartMs": 1845450,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "굳이"
    } ]
  }, {
    "tStartMs": 1846530,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "이거"
    } ]
  }, {
    "tStartMs": 1848110,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "넘기면"
    } ]
  }, {
    "tStartMs": 1849550,
    "dDurationMs": 410,
    "segs": [ {
      "utf8": "넘기면"
    } ]
  }, {
    "tStartMs": 1849960,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "우리 부산에서 다시 한번 생각해 볼 의향이 있습니다"
    } ]
  }, {
    "tStartMs": 1852070,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "아까 전에 동계 아시안게임 그거 말고"
    } ]
  }, {
    "tStartMs": 1854430,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "리야드 엑스포도 넘기면"
    } ]
  }, {
    "tStartMs": 1856020,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "한번 고려해 볼게요"
    } ]
  }, {
    "tStartMs": 1857340,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "적당히 생각해 주시고"
    } ]
  }, {
    "tStartMs": 1858880,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "2034년 월드컵도 있는데"
    } ]
  }, {
    "tStartMs": 1860640,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "아마 이거까지는 하지 않을까 생각이 됩니다"
    } ]
  } ]
}

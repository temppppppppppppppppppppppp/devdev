  } ],
  "events": [ {
    "tStartMs": 7780,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "마지막 주제는 세계 1위 주식시장"
    } ]
  }, {
    "tStartMs": 10000,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "이 얘기를 안 할 수 없죠"
    } ]
  }, {
    "tStartMs": 11230,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "세계 1위 주식시장이 어디냐"
    } ]
  }, {
    "tStartMs": 12760,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "당연히 대한민국의 코스피죠"
    } ]
  }, {
    "tStartMs": 15920,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "왜냐하면 연초 4200"
    } ]
  }, {
    "tStartMs": 17600,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "3월 초 6347"
    } ]
  }, {
    "tStartMs": 19560,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "2100포인트를 올렸죠"
    } ]
  }, {
    "tStartMs": 21090,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "연초 이후 상승률 50%"
    } ]
  }, {
    "tStartMs": 22480,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "압도적인 세계 1위"
    } ]
  }, {
    "tStartMs": 24280,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "코스피 좋습니다"
    } ]
  }, {
    "tStartMs": 25610,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "세계 1위 주식시장은"
    } ]
  }, {
    "tStartMs": 26470,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "당연히 코스피고요"
    } ]
  }, {
    "tStartMs": 28220,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "또 1위 하나 또 있어요"
    } ]
  }, {
    "tStartMs": 29620,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "그건 뭐냐?"
    } ]
  }, {
    "tStartMs": 31190,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "이틀간 떨어진 거"
    } ]
  }, {
    "tStartMs": 32360,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "7.24%, 12% 합쳐서 대충 20%"
    } ]
  }, {
    "tStartMs": 35620,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "하락률도 압도적인"
    } ]
  }, {
    "tStartMs": 37630,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "이거 하면 안 되는구나"
    } ]
  }, {
    "tStartMs": 39540,
    "dDurationMs": 5240,
    "segs": [ {
      "utf8": "하락률도 있냐 하락률도"
    } ]
  }, {
    "tStartMs": 44780,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "이 12% 수요일 날 빠진 날"
    } ]
  }, {
    "tStartMs": 48000,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "저 2일간 빠진 게"
    } ]
  }, {
    "tStartMs": 50110,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "1150%가 빠졌거든요"
    } ]
  }, {
    "tStartMs": 52280,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "3월 4일 수요일 날"
    } ]
  }, {
    "tStartMs": 53910,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "698포인트가 빠졌어요"
    } ]
  }, {
    "tStartMs": 57470,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "무슨 지수가 12%가 빠져"
    } ]
  }, {
    "tStartMs": 59220,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "아니 이게 좀"
    } ]
  }, {
    "tStartMs": 61240,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "형님들 너무 화끈하신 거 아닌가"
    } ]
  }, {
    "tStartMs": 62870,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "7%도 화끈했는데"
    } ]
  }, {
    "tStartMs": 64300,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "12%는"
    } ]
  }, {
    "tStartMs": 65330,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "와... 커뮤니티 같은데"
    } ]
  }, {
    "tStartMs": 67400,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "많이 돌던 짤이죠"
    } ]
  }, {
    "tStartMs": 68510,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "외신들이 넋이 나갔다"
    } ]
  }, {
    "tStartMs": 70210,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "니케이 -3.6%"
    } ]
  }, {
    "tStartMs": 72010,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "중국 -1% , -2%"
    } ]
  }, {
    "tStartMs": 73980,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "한국은 -12%"
    } ]
  }, {
    "tStartMs": 76390,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "이게 뭐냐"
    } ]
  }, {
    "tStartMs": 78090,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "한국 시장이 멜트다운하고 있어요"
    } ]
  }, {
    "tStartMs": 80590,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "녹아내리고 있습니다"
    } ]
  }, {
    "tStartMs": 82610,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "한 리서치 대표가"
    } ]
  }, {
    "tStartMs": 83870,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "개인 포스팅한 것도"
    } ]
  }, {
    "tStartMs": 84840,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "우리나라 언론들이 많이 가지고 오셨는데"
    } ]
  }, {
    "tStartMs": 86480,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "이게 내용이 이렇게 나옵니다"
    } ]
  }, {
    "tStartMs": 88210,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "한국증시는 심약한 이들에겐"
    } ]
  }, {
    "tStartMs": 90320,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "부적절한 곳입니다"
    } ]
  }, {
    "tStartMs": 91910,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "초보는 발을 들이면 안 되는 서버예요"
    } ]
  }, {
    "tStartMs": 94300,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "한국 서버는"
    } ]
  }, {
    "tStartMs": 95370,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "어지간한 초보자들은 들어오면"
    } ]
  }, {
    "tStartMs": 96930,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "심장박동수가 너무 늘어나기 때문에"
    } ]
  }, {
    "tStartMs": 99950,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "좀 부적절할 수 있어요"
    } ]
  }, {
    "tStartMs": 101250,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "한마디로 우리는 다 고수만 있다는 거죠"
    } ]
  }, {
    "tStartMs": 103620,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "여러분들 한국증시 하시잖아요"
    } ]
  }, {
    "tStartMs": 105070,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "우리는 다 고수입니다"
    } ]
  }, {
    "tStartMs": 106480,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "초보는 오지 못한다"
    } ]
  }, {
    "tStartMs": 108660,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "전 초보인데요"
    } ]
  }, {
    "tStartMs": 109260,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "알고 있어요"
    } ]
  }, {
    "tStartMs": 110380,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "우리는 28년째"
    } ]
  }, {
    "tStartMs": 113020,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "초보를 찾는 나라죠"
    } ]
  }, {
    "tStartMs": 114740,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "옛날에는 헌터 초보만"
    } ]
  }, {
    "tStartMs": 116240,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "요즘에는 투혼 초보만"
    } ]
  }, {
    "tStartMs": 118050,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "아직도 초보를 찾는 곳이기 때문에"
    } ]
  }, {
    "tStartMs": 120750,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "여러분들이 초보인 건 알고 있어"
    } ]
  }, {
    "tStartMs": 122800,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "한국 초보는 프로게이머도 가끔 이깁니다"
    } ]
  }, {
    "tStartMs": 125570,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "여기는 은둔 고수의 나라"
    } ]
  }, {
    "tStartMs": 129490,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "어줍지 않은 애들은 안 돼요"
    } ]
  }, {
    "tStartMs": 131150,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "어줍지 않은 사람들 오지 마"
    } ]
  }, {
    "tStartMs": 132970,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "그냥 즐기는 사람 오면 안 돼"
    } ]
  }, {
    "tStartMs": 134520,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "여기는 심약한 이들은 발을 들여놓으면"
    } ]
  }, {
    "tStartMs": 137540,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "안 되는 곳이라고 할 수 있고요"
    } ]
  }, {
    "tStartMs": 139180,
    "dDurationMs": 3710,
    "segs": [ {
      "utf8": "온갖 걸로 희롱을 당할 수 있는 서버입니다"
    } ]
  }, {
    "tStartMs": 142890,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "무슨 뭐 파일런으로 이름 써놓고 막 그래"
    } ]
  }, {
    "tStartMs": 144930,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "애들이 그냥 이기지 않고"
    } ]
  }, {
    "tStartMs": 146850,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "별별 험한 꼴을 볼 수 있기 때문에"
    } ]
  }, {
    "tStartMs": 150130,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "조심해야 되는 서버라고 할 수 있고"
    } ]
  }, {
    "tStartMs": 151650,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "한국 서버를 좀 보면"
    } ]
  }, {
    "tStartMs": 153400,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "저 아까 이스라엘 대표가 쓴 글이에요"
    } ]
  }, {
    "tStartMs": 155810,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "한국 시장은 개인 투자자 중심이다"
    } ]
  }, {
    "tStartMs": 158610,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "거래량의 최대 70%가"
    } ]
  }, {
    "tStartMs": 160230,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "개인 투자자에 의해 이루어진다"
    } ]
  }, {
    "tStartMs": 162480,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "미국과는 달라"
    } ]
  }, {
    "tStartMs": 163610,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "미국은 개인 투자자의 비중이"
    } ]
  }, {
    "tStartMs": 165190,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "20%에 불과해"
    } ]
  }, {
    "tStartMs": 166610,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "기관들끼리 뭐라 하는 곳인데"
    } ]
  }, {
    "tStartMs": 168350,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "한국은 안되지"
    } ]
  }, {
    "tStartMs": 170050,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "한국은 기관, 프로게이머?"
    } ]
  }, {
    "tStartMs": 172860,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "안돼 안돼 안돼"
    } ]
  }, {
    "tStartMs": 174450,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "져"
    } ]
  }, {
    "tStartMs": 176100,
    "dDurationMs": 140,
    "segs": [ {
      "utf8": "져"
    } ]
  }, {
    "tStartMs": 176240,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "이기긴 하는데"
    } ]
  }, {
    "tStartMs": 177590,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "질 수 있어 질 수 있어"
    } ]
  }, {
    "tStartMs": 178940,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "기관이고 프로게이머고 나발이고"
    } ]
  }, {
    "tStartMs": 181390,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "와봐야 투혼 초보에게 져"
    } ]
  }, {
    "tStartMs": 183710,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "놀랍죠?"
    } ]
  }, {
    "tStartMs": 185090,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "저는 이 게임을 한 지"
    } ]
  }, {
    "tStartMs": 186080,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "두 달밖에 안 됐어요 하는 애가"
    } ]
  }, {
    "tStartMs": 187890,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "APM이 400이 나오는 서버예요"
    } ]
  }, {
    "tStartMs": 189560,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "자, 그렇기 때문에"
    } ]
  }, {
    "tStartMs": 190850,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "함부로 하면 안 돼요"
    } ]
  }, {
    "tStartMs": 192230,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "초보를 빙자한 괴물을 들일 수 있기 때문에"
    } ]
  }, {
    "tStartMs": 194620,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "함부로 하면 안 되고"
    } ]
  }, {
    "tStartMs": 195900,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "그리고 한국에서 주로 거래량을 일으킨다는"
    } ]
  }, {
    "tStartMs": 198710,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "70%의 개인 투자자들의 성향은"
    } ]
  }, {
    "tStartMs": 201170,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "제가 보기엔 거의"
    } ]
  }, {
    "tStartMs": 202230,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "미친나라입니다 미친나라"
    } ]
  }, {
    "tStartMs": 203550,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "왜냐면"
    } ]
  }, {
    "tStartMs": 204570,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "이게 아주 유명한 건데"
    } ]
  }, {
    "tStartMs": 205950,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "수년간 한국은 계약 거래량 기준으로"
    } ]
  }, {
    "tStartMs": 208190,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "미국보다 큰 세계 최대의 옵션 시장이었어요"
    } ]
  }, {
    "tStartMs": 211570,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "주식 옵션"
    } ]
  }, {
    "tStartMs": 212470,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "옵션을 미국보다 더 많이 하는 나라예요"
    } ]
  }, {
    "tStartMs": 214110,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "물론 저 리서치 대표가 한 말은"
    } ]
  }, {
    "tStartMs": 216720,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "약간 한국 시장을 몰라서 그래요"
    } ]
  }, {
    "tStartMs": 218180,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "이거는 몇몇 기관들이"
    } ]
  }, {
    "tStartMs": 220030,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "옛날에 한 10년 전에"
    } ]
  }, {
    "tStartMs": 221470,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "거래량을 엄청 돌리던 때가 있었어요"
    } ]
  }, {
    "tStartMs": 223530,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "혼자서 몇 조 이상을 하던"
    } ]
  }, {
    "tStartMs": 225380,
    "dDurationMs": 1550,
    "segs": [ {

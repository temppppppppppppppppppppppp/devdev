  }, {
    "tStartMs": 279720,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "초보는 오시지 마시고"
    } ]
  }, {
    "tStartMs": 281240,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "한국은 랠리하지 않고 급등하고요"

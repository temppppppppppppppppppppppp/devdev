{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 7780,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "자 여러분 안녕하세요 자 오늘의 주제는"
    } ]
  }, {
    "tStartMs": 10380,
    "dDurationMs": 4090,
    "segs": [ {
      "utf8": "삼성그룹 올해부터 국내 해외 법인 간 문서도 영어만 쓴다"
    } ]
  }, {
    "tStartMs": 14470,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "라는 가슴 떨리는 주제를 가져왔습니다"
    } ]
  }, {
    "tStartMs": 17660,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "국내 해외 법인 간 문서에서"
    } ]
  }, {
    "tStartMs": 19090,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "한글을 안 쓰고 영어만 쓴다는 거죠"
    } ]
  }, {
    "tStartMs": 21380,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "와 저는 요즘 같으면"
    } ]
  }, {
    "tStartMs": 23770,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "대기업 진짜 들어가기 정말 어려워졌구나 하는 생각이 드는 그런 주제입니다"
    } ]
  }, {
    "tStartMs": 27810,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "자 일단 그 얘기를 하기 전에"
    } ]
  }, {
    "tStartMs": 28960,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "시계를 조금만 돌려서"
    } ]
  }, {
    "tStartMs": 30400,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "지난 2025년 12월"
    } ]
  }, {
    "tStartMs": 32140,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "우리나라 한국교육평가위원장이 사임하는 일이 있었습니다"
    } ]
  }, {
    "tStartMs": 35880,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "무슨 일로 갑자기 교육평가위원장이 사임했냐?"
    } ]
  }, {
    "tStartMs": 37910,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "그 옆에 이유가 나와있죠"
    } ]
  }, {
    "tStartMs": 39840,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "딱 보시면 수능 영어 영역의 출제가"
    } ]
  }, {
    "tStartMs": 42590,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "절대평가 취지에 부합하지 못해"
    } ]
  }, {
    "tStartMs": 44640,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "수험생과 학부모님들께 심려를 끼쳐드린 점"
    } ]
  }, {
    "tStartMs": 47530,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "다시 한번 무거운 책임을 통감합니다"
    } ]
  }, {
    "tStartMs": 49780,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "하고 사임을 하셨는데"
    } ]
  }, {
    "tStartMs": 51410,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "어 이게 무슨 일이냐?"
    } ]
  }, {
    "tStartMs": 53320,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "다들 이제 수능을 보신지 오래되셔서"
    } ]
  }, {
    "tStartMs": 55490,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "요즘 수능의 이슈가 어떤 게 있는지 잘 모르시겠지만"
    } ]
  }, {
    "tStartMs": 58450,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "불과 몇 달 전"
    } ]
  }, {
    "tStartMs": 59620,
    "dDurationMs": 4090,
    "segs": [ {
      "utf8": "2026학년도 수능에서 영어 영역이"
    } ]
  }, {
    "tStartMs": 63710,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "역대 최고의 불영어라는 평가를 받았습니다"
    } ]
  }, {
    "tStartMs": 67030,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "역대 가장 어려운 영어 중에 하나였다"
    } ]
  }, {
    "tStartMs": 70190,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "이때 영어 영역 1등급 비율이 불과 3.11%였다고 합니다"
    } ]
  }, {
    "tStartMs": 75130,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "절대평가가 도입된 2018학년 이후에"
    } ]
  }, {
    "tStartMs": 77890,
    "dDurationMs": 3410,
    "segs": [ {
      "utf8": "1등급 비율이 가장 낮았다 3.11%"
    } ]
  }, {
    "tStartMs": 81300,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "자 그래서 평가위원장이"
    } ]
  }, {
    "tStartMs": 83330,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "수능 영어 난이도 조절 실패 때문에 사임을 했던 거죠"
    } ]
  }, {
    "tStartMs": 88030,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "그런데 아마 많은 분들이"
    } ]
  }, {
    "tStartMs": 89340,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "잠깐만 수능은 상대평가 아닙니까?"
    } ]
  }, {
    "tStartMs": 92140,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "라고 생각하시는 분 계실 거예요 맞습니다"
    } ]
  }, {
    "tStartMs": 94000,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "분명히 제가 기억하기에도 수능은 상대평가였거든요"
    } ]
  }, {
    "tStartMs": 97470,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "물론 제가 수능 봤을 때 좀 다르지만"
    } ]
  }, {
    "tStartMs": 99460,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "요즘 수능은 국어나 수학, 탐구 영역"
    } ]
  }, {
    "tStartMs": 101810,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "모두 다 상위 4%가 1등급입니다"
    } ]
  }, {
    "tStartMs": 104410,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "4% 1등급으로 정해져 있어요"
    } ]
  }, {
    "tStartMs": 106940,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "그 다음 2등급은 4에서 7%"
    } ]
  }, {
    "tStartMs": 108960,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "누적 11%까지가 2등급"
    } ]
  }, {
    "tStartMs": 110980,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "그 다음 12% 한마디로"
    } ]
  }, {
    "tStartMs": 112050,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "누적 23%까지는 3등급입니다"
    } ]
  }, {
    "tStartMs": 115170,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "한마디로 상대평가니까"
    } ]
  }, {
    "tStartMs": 116380,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "등급이 다 정해져 있는 거잖아요"
    } ]
  }, {
    "tStartMs": 117750,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "4%가 1등급"
    } ]
  }, {
    "tStartMs": 119260,
    "dDurationMs": 4450,
    "segs": [ {
      "utf8": "그런데 왜 작년 수능 영어는 3.11%가 1등급이었냐?"
    } ]
  }, {
    "tStartMs": 123710,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "그거는 아시는 분도 계시겠지만"
    } ]
  }, {
    "tStartMs": 126500,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "2018년도에 수능 영어를 절대평가로 변경했습니다"
    } ]
  }, {
    "tStartMs": 130800,
    "dDurationMs": 570,
    "segs": [ {
      "utf8": "나오죠?"
    } ]
  }, {
    "tStartMs": 131370,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "영어를 절대평가로 변경한다"
    } ]
  }, {
    "tStartMs": 133860,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "이때 영어가 9등급 절대평가로 바뀝니다"
    } ]
  }, {
    "tStartMs": 136800,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "100점 만점에 원점수 기준 90점 이상이면 무조건 1등급"
    } ]
  }, {
    "tStartMs": 140860,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "80점 이상이면 무조건 2등급"
    } ]
  }, {
    "tStartMs": 142400,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "이런 식으로 나눈 거죠"
    } ]
  }, {
    "tStartMs": 144060,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "10점 단위로 등급을 나눠서"
    } ]
  }, {
    "tStartMs": 145480,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "절대평가로 바꾼 일이 있었습니다"
    } ]
  }, {
    "tStartMs": 148000,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "그럼 왜 상대평가에서 절대평가로 바꿨냐?"
    } ]
  }, {
    "tStartMs": 150610,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "그 당시 이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 151940,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "영어 절대평가가 도입되면"
    } ]
  }, {
    "tStartMs": 153930,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "불필요한 경쟁이 줄 거야"
    } ]
  }, {
    "tStartMs": 155890,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "너무 사교육이 많고"
    } ]
  }, {
    "tStartMs": 156980,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "영어 어렵다는 평가를 많이 들으니까"
    } ]
  }, {
    "tStartMs": 159150,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "영어 교육 정상화를 위해서"
    } ]
  }, {
    "tStartMs": 160660,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "상대평가를 절대평가로 바꾸겠다"
    } ]
  }, {
    "tStartMs": 162870,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "당시 교육부 장관이 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 165010,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "글로벌 사회에 필요한 의사소통 능력을 키울 수 있도록 하는"
    } ]
  }, {
    "tStartMs": 168220,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "영어 수업으로의 변화를 유도하기 위해서는"
    } ]
  }, {
    "tStartMs": 170560,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "절대평가로의 개선이 불가피했다 하면서"
    } ]
  }, {
    "tStartMs": 173440,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "절대평가로 바꾼 거죠"
    } ]
  }, {
    "tStartMs": 175310,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "영어 시험의 난이도를 좀 낮추고"
    } ]
  }, {
    "tStartMs": 177170,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "사교육을 안 받더라도"
    } ]
  }, {
    "tStartMs": 178330,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "비교적 쉽게 1등급을 받게 만들겠다라는"
    } ]
  }, {
    "tStartMs": 180950,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "그런 취지가 있던 걸로 보시면 됩니다"
    } ]
  }, {
    "tStartMs": 183100,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "자 그런데 작년에 있었던 2026학년도 수능 영어에서"
    } ]
  }, {
    "tStartMs": 186910,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "영어 90점 이상이"
    } ]
  }, {
    "tStartMs": 188200,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "불과 3.11%가 나왔다는 뜻입니다"
    } ]
  }, {
    "tStartMs": 190990,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "상대평가로 가만히 뒀으면"
    } ]
  }, {
    "tStartMs": 192890,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "4%가 1등급인데"
    } ]
  }, {
    "tStartMs": 194570,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "절대평가로 바꾼 바람에"
    } ]
  }, {
    "tStartMs": 196050,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "90점 넘는 사람이 별로 없어서"
    } ]
  }, {
    "tStartMs": 198370,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "3.11%가 1등급이 된 거죠"
    } ]
  }, {
    "tStartMs": 201240,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "영어 공부 부담을 덜어주려고"
    } ]
  }, {
    "tStartMs": 202980,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "제도를 바꿨는데"
    } ]
  }, {
    "tStartMs": 203830,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "오히려 더 어려워져버렸다"
    } ]
  }, {
    "tStartMs": 206100,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "라는 어떻게 보면"
    } ]
  }, {
    "tStartMs": 207260,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "슬픈 결과가 나왔다고 볼 수 있습니다"
    } ]
  }, {
    "tStartMs": 209750,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "물론 이번 문제에 대해서"
    } ]
  }, {
    "tStartMs": 211250,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "평가원장은 한 6에서 10% 정도를 1등급을 맞는 걸 목표로 삼았다"
    } ]
  }, {
    "tStartMs": 215610,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "라고 얘기했지만"
    } ]
  }, {
    "tStartMs": 216560,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "결국 난이도 조절에 실패하면서"
    } ]
  }, {
    "tStartMs": 218560,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "3.11%밖에 1등급이 안 나온 거죠"
    } ]
  }, {
    "tStartMs": 221210,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "수능 영어가 절대평가로 바뀐 다음에"
    } ]
  }, {
    "tStartMs": 223620,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "1등급 비율을 보면"
    } ]
  }, {
    "tStartMs": 224630,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "그동안은 10%, 12%"
    } ]
  }, {
    "tStartMs": 226690,
    "dDurationMs": 670,
    "segs": [ {
      "utf8": "높게는"
    } ]
  }, {
    "tStartMs": 227360,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "낮아도 한 6%, 7% 정도가 나왔습니다"
    } ]
  }, {
    "tStartMs": 230210,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "지난 9년간 평균이 7%였어요"
    } ]
  }, {
    "tStartMs": 232550,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "그런데 2026학년도 수능에서는"
    } ]
  }, {
    "tStartMs": 235020,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "난이도가 올라가서"
    } ]
  }, {
    "tStartMs": 236290,
    "dDurationMs": 3650,
    "segs": [ {
      "utf8": "3.11%밖에 1등급을 못 받게 됐다는 겁니다"
    } ]
  }, {
    "tStartMs": 239940,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "그래서 난이도 조절에 실패해서"
    } ]
  }, {
    "tStartMs": 241760,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "평가위원장이 사임을 한 건데"
    } ]
  }, {
    "tStartMs": 243550,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "그런데 이렇게 생각할 수 있습니다"
    } ]
  }, {
    "tStartMs": 244800,
    "dDurationMs": 5020,
    "segs": [ {
      "utf8": "아니, 1등급 비중이 3.11% 된 게 뭐가 문제냐?"
    } ]
  }, {
    "tStartMs": 249820,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "어차피 줄을 쫙 세워서 점수를 주는 건데"
    } ]
  }, {
    "tStartMs": 252960,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "그렇다고 2등급 받던 애가"
    } ]
  }, {
    "tStartMs": 254210,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "1등급으로 간 것도 아닌데"
    } ]
  }, {
    "tStartMs": 255480,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "뭐가 문제냐?"
    } ]
  }, {
    "tStartMs": 256420,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "문제가 있죠"
    } ]
  }, {
    "tStartMs": 257760,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "어떤 문제가 있냐면"
    } ]
  }, {
    "tStartMs": 259200,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "우리나라 입시에서는 수시라는 게 있습니다"
    } ]
  }, {
    "tStartMs": 261470,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "수시가 뭡니까?"
    } ]
  }, {
    "tStartMs": 262370,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "수능을 보기 전에"
    } ]
  }, {
    "tStartMs": 263010,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "합격해 주는 거"
    } ]
  }, {
    "tStartMs": 263940,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "요즘도 그렇겠죠"
    } ]
  }, {
    "tStartMs": 264700,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "저 때는 그랬으니까"
    } ]
  }, {
    "tStartMs": 265830,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "이게 수시인데"
    } ]
  }, {
    "tStartMs": 266770,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "다만 수시에서는 조건이 있습니다"
    } ]
  }, {
    "tStartMs": 268520,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "바로 수능을 봐서"
    } ]
  }, {
    "tStartMs": 269730,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "최저학력 기준을 맞춰라"
    } ]
  }, {
    "tStartMs": 271350,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "그럼 너는 합격이야"
    } ]
  }, {
    "tStartMs": 272500,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "라는 게 수시지 않습니까?"
    } ]
  }, {
    "tStartMs": 273980,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "그런데 대부분의 점수가 높은 학교에서는"
    } ]
  }, {
    "tStartMs": 276810,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "수능 1등급을 최저학력 기준으로 삼았다는 거죠"
    } ]
  }, {
    "tStartMs": 280770,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "나는 수시에 붙었어"
    } ]
  }, {
    "tStartMs": 282040,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "그런데 영어를 보니까"
    } ]
  }, {
    "tStartMs": 282950,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "영어가 너무 어려워"
    } ]
  }, {
    "tStartMs": 283970,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "그래서 1등급에 못 들어가서"
    } ]
  }, {
    "tStartMs": 286500,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "수시 합격이 취소된 사람들이"
    } ]
  }, {
    "tStartMs": 288430,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "굉장히 늘어났다는 겁니다"
    } ]
  }, {
    "tStartMs": 290410,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "평상시 같으면 한 10%, 적어도 7%가"
    } ]
  }, {
    "tStartMs": 293570,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "1등급이어서 무난하니 수시가 합격인 줄 알았는데"
    } ]
  }, {
    "tStartMs": 296580,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "1등급 비중이 영어"
    } ]
  }, {
    "tStartMs": 297730,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "특히 수능 영어 1등급 비중이"
    } ]
  }, {
    "tStartMs": 299360,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "3.11% 내려가다 보니까"
    } ]
  }, {
    "tStartMs": 301410,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "예상치도 못하게"
    } ]
  }, {
    "tStartMs": 302810,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "내가 수시에 불합격한 일이 너무나 많아졌고"
    } ]
  }, {
    "tStartMs": 305190,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "그래서 그냥 불꽃 같은 항의가 오다 보니까"
    } ]
  }, {
    "tStartMs": 308160,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "이런 일이 발생했다는 거죠"
    } ]
  }, {
    "tStartMs": 310230,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "영어 쉽게 내준다고 해서 안심했는데"
    } ]
  }, {
    "tStartMs": 312100,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "영어가 당락을 가르는 핵심 과목이 되고 말았다"
    } ]
  }, {
    "tStartMs": 314980,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "이런 평가를 받았다는 겁니다"
    } ]
  }, {
    "tStartMs": 317090,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "그러면 왜 작년 영어가 절대평가로 바뀐 이후에는"
    } ]
  }, {
    "tStartMs": 320850,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "역대 최고의 불영어로 불리는가?"
    } ]
  }, {
    "tStartMs": 323140,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "왜 영어 난이도 조절에 실패했냐?"
    } ]
  }, {
    "tStartMs": 325660,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "살짝 보니까 영어 선생님들이 이런 말을 하더라고요"
    } ]
  }, {
    "tStartMs": 328750,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "첫 번째, 진짜 어려웠다"
    } ]
  }, {
    "tStartMs": 330240,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "진짜 좀 어려웠나 봅니다 진짜로"
    } ]
  }, {
    "tStartMs": 332520,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "지문도 그렇고 진짜로 어려웠고"
    } ]
  }, {
    "tStartMs": 334620,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "그리고 두 번째 문제를 내시는 분들이 살짝 고려하지 못한 점이 있다고 합니다"
    } ]
  }, {
    "tStartMs": 337780,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "바로 영어 지문의 길이가 길어지면"
    } ]
  }, {
    "tStartMs": 340650,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "학생들이 대단히 어려워한다"
    } ]
  }, {
    "tStartMs": 342840,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "이게 무슨 말입니까?"
    } ]
  }, {
    "tStartMs": 343940,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "요즘 학생들이 문해력 저하가 있다"
    } ]
  }, {
    "tStartMs": 345600,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "이런 말 많이 하죠"
    } ]
  }, {
    "tStartMs": 346400,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "스마트폰 보다 보니까"
    } ]
  }, {
    "tStartMs": 347440,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "문해력이 좀 약해져요"
    } ]
  }, {
    "tStartMs": 348820,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "긴 글을 못 읽어, 긴 글을"
    } ]
  }, {
    "tStartMs": 350700,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "한국말로 된 긴 글도 못 읽는데"
    } ]
  }, {
    "tStartMs": 352900,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "영어로 문장이 길다 보니까"
    } ]
  }, {
    "tStartMs": 354720,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "굉장히 어려움을 많이 느꼈다는 겁니다"
    } ]
  }, {
    "tStartMs": 357460,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "마치 한국말로 써놨어도"
    } ]
  }, {
    "tStartMs": 359750,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "아마 문제 맞히기가 쉽지 않았을까 생각하는데"
    } ]
  }, {
    "tStartMs": 362910,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "영어 지문 길이를 좀 짧게 해줬어야 되는데"
    } ]
  }, {
    "tStartMs": 365670,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "이제 그 점을 고려하지 못하다 보니까"
    } ]
  }, {
    "tStartMs": 367370,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "학생들이 굉장히 어렵게 느꼈다"
    } ]
  }, {
    "tStartMs": 369480,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "라는 평가들이 많이 있더라고요"
    } ]
  }, {
    "tStartMs": 371650,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "그래서 이 사태에 대해서"
    } ]
  }, {
    "tStartMs": 373740,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "영국의 BBC도 한마디 했습니다"
    } ]
  }, {
    "tStartMs": 375650,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "BBC 방송이 실제 가서"
    } ]
  }, {
    "tStartMs": 377070,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "우리나라 한국 2026년도 수능 영어를 갖고"
    } ]
  }, {
    "tStartMs": 379800,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "자기들이 풀어본 결과"
    } ]
  }, {
    "tStartMs": 381280,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "이런 말을 했어요"
    } ]
  }, {
    "tStartMs": 382870,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "한국의 악명 높은 대학 입학 시험 수능"
    } ]
  }, {
    "tStartMs": 385580,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "그 중에서 영어 영역은 이번에 난이도가 매우 매우 높았다는 평가를 받는다"
    } ]
  }, {
    "tStartMs": 389330,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "자기들이 보니까"
    } ]
  }, {
    "tStartMs": 390720,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "고대의 문자를 해독하는 것과 같았다"
    } ]
  }, {
    "tStartMs": 395330,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "영국 언론입니다 영국 언론"
    } ]
  }, {
    "tStartMs": 396980,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "영국 언론이 한국의 수능 영어 영역을 보더니"
    } ]
  }, {
    "tStartMs": 400120,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "고대의 문자를 해독하는 것 같았다"
    } ]
  }, {
    "tStartMs": 403000,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "학생들을 인터뷰하니까"
    } ]
  }, {
    "tStartMs": 404080,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "학생들은 insane"
    } ]
  }, {
    "tStartMs": 405600,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "미친듯이 어려웠다"
    } ]
  }, {
    "tStartMs": 407320,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "라고 얘기를 했다는 거죠"
    } ]
  }, {
    "tStartMs": 408990,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "그럼 왜 고대의 문자를 해독하는 것 같았냐"
    } ]
  }, {
    "tStartMs": 412740,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "BBC는 이렇게 말했습니다"
    } ]
  }, {
    "tStartMs": 414840,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "대한민국의 영어 시험에서"
    } ]
  }, {
    "tStartMs": 417170,
    "dDurationMs": 5610,
    "segs": [ {
      "utf8": "무려 임마누엘 칸트의 법철학에 대한 관련 문제가 있었다"
    } ]
  }, {
    "tStartMs": 422780,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "영어를 주로 쓰지 않는 나라인데도 불구하고"
    } ]
  }, {
    "tStartMs": 425730,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "무려 임마누엘 칸트의 법철학"
    } ]
  }, {
    "tStartMs": 428600,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "philosophy of law"
    } ]
  }, {
    "tStartMs": 430310,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "저도 잘 모르는 학문인데"
    } ]
  }, {
    "tStartMs": 431990,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "무지하게 어려운 학문에 대한 지문을 문제로 냈다는 거죠"
    } ]
  }, {
    "tStartMs": 436290,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "한마디로 영국인들이 풀어도"
    } ]
  }, {
    "tStartMs": 438170,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "이게 고대 문자를 해독하는 듯한"
    } ]
  }, {
    "tStartMs": 440700,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "그런 느낌을 받았다는 겁니다"
    } ]
  }, {
    "tStartMs": 443220,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "게다가 학생들에게는 45문항에 70분"
    } ]
  }, {
    "tStartMs": 446050,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "한 문제당 1분 30초 정도 주어진 거죠"
    } ]
  }, {
    "tStartMs": 448510,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "1분 30초 만에"
    } ]
  }, {
    "tStartMs": 449730,
    "dDurationMs": 4890,
    "segs": [ {
      "utf8": "임마누엘 칸트의 법철학에 대한 영어 지문을 읽고 답을 해야 된다"
    } ]
  }, {
    "tStartMs": 454620,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "그렇다 보니까"
    } ]
  }, {
    "tStartMs": 455690,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "굉장한 어려움을 줬다는 겁니다"
    } ]
  }, {
    "tStartMs": 457780,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "그래서 제가 임마누엘 칸트"
    } ]
  }, {
    "tStartMs": 459450,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "BBC가 지적했던 이 문제"
    } ]
  }, {
    "tStartMs": 461020,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "제가 직접 가서 봤어요"
    } ]
  }, {
    "tStartMs": 462260,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "여러분들한테도 보여드리겠습니다"
    } ]
  }, {
    "tStartMs": 463790,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "영어로 보여주냐? 아니요"
    } ]
  }, {
    "tStartMs": 465090,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "영어로 보여주면"
    } ]
  }, {
    "tStartMs": 466030,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "어차피 우리가 너무 복잡할 테니까"
    } ]
  }, {
    "tStartMs": 467830,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "국어로 보여드리겠습니다"
    } ]
  }, {
    "tStartMs": 469730,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "이 문제입니다"
    } ]
  }, {
    "tStartMs": 470610,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "자 이게 문제냐?"
    } ]
  }, {
    "tStartMs": 471530,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "이건 지문이고요"
    } ]
  }, {
    "tStartMs": 472350,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "이걸 읽고 문제에 답하시면 됩니다"
    } ]
  }, {
    "tStartMs": 475140,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "제가 문제는 안 갖고 왔어요"
    } ]
  }, {
    "tStartMs": 476690,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "그냥 지문만 한번 읽어보도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 478880,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "칸트는 법치주의를 안보와 평화뿐 아니라"
    } ]
  }, {
    "tStartMs": 481510,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "자유의 궁극적인 보장으로 강력하게 옹호했다"
    } ]
  }, {
    "tStartMs": 484440,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "그는 인간사회가 효과적이고"
    } ]
  }, {
    "tStartMs": 486290,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "구속력 있는 법적 틀에 의해 규율되는"
    } ]
  }, {
    "tStartMs": 489310,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "더욱 합리적인 형태로 나아가고 있다고 믿었는데"
    } ]
  }, {
    "tStartMs": 492480,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "그런 틀만이 사람들이 더 번영하고 협력했다고 생각을 하고"
    } ]
  }, {
    "tStartMs": 496050,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "그래서 칸트가 인간 본성에 대해서 얘기를 했는데"
    } ]
  }, {
    "tStartMs": 499260,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "하여튼 뭐 그런 겁니다"
    } ]
  }, {
    "tStartMs": 500050,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "자비심이나 호의에는 의존할 수 없지만"
    } ]
  }, {
    "tStartMs": 502230,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "모든 시민을 동등하게 구속하는 법체계가 있어야"
    } ]
  }, {
    "tStartMs": 505010,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "조화롭게 살 수 있다"
    } ]
  }, {
    "tStartMs": 506170,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "이게 칸트의 법철학이다"
    } ]
  }, {
    "tStartMs": 507550,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "뭐 이런 지문이라는 거죠"
    } ]
  }, {
    "tStartMs": 509330,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "아 좋습니다"
    } ]
  }, {
    "tStartMs": 510280,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "자 자 국어를 읽으니까 그래도 좀 되네요"
    } ]
  }, {
    "tStartMs": 512510,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "자 이걸 영어를 읽고 문제를 풀어야 되다 보니까"
    } ]
  }, {
    "tStartMs": 515000,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "고대 문자와 같았다"
    } ]
  }, {
    "tStartMs": 516260,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "이런 평가가 나오는 거죠"
    } ]
  }, {
    "tStartMs": 518260,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "참 안타깝다고 할 수 있고요"
    } ]
  }, {
    "tStartMs": 519680,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "그런데 제가 이야기를 이어가기 전에"
    } ]
  }, {
    "tStartMs": 521600,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "역대 최고의 불영어라 그러니까"
    } ]
  }, {
    "tStartMs": 523290,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "또 이 얘기를 안 할 수가 없더라고요"
    } ]
  }, {
    "tStartMs": 524690,
    "dDurationMs": 5330,
    "segs": [ {
      "utf8": "제가 봤던 역대 최고의 불수능 1997년도 수능이 갑자기 떠오릅니다"
    } ]
  }, {
    "tStartMs": 530020,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "음... 전 이걸 직접 봤죠"
    } ]
  }, {
    "tStartMs": 532960,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "잠깐만 그냥 재미로 말씀드리면"
    } ]
  }, {
    "tStartMs": 534940,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "당시에 당연히 만점자는 없었습니다"
    } ]
  }, {
    "tStartMs": 536660,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "당시 수능은 400점 만점이었어요"
    } ]
  }, {
    "tStartMs": 539360,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "자연계 수석이 373점"
    } ]
  }, {
    "tStartMs": 541340,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "인문계 수석이 370점이었는데"
    } ]
  }, {
    "tStartMs": 543340,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "거의 대부분의 학생들이"
    } ]
  }, {
    "tStartMs": 544930,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "300점을 못 넘는"
    } ]
  }, {
    "tStartMs": 546580,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "이렇게 완전히 찌그러져 눌러버린"
    } ]
  }, {
    "tStartMs": 549770,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "그런 피라미드 모양으로"
    } ]
  }, {
    "tStartMs": 551220,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "점수대가 분포됐던 그런 시험이라고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 554310,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "300점을 넘으면 서울대를 갈 수 있었고"
    } ]
  }, {
    "tStartMs": 556450,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "한 260점을 넘으면"
    } ]
  }, {
    "tStartMs": 557730,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "연고대를 갈 수 있었던 말"
    } ]
  }, {
    "tStartMs": 558860,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "말 그대로 미친 시험이라고 할 수 있는데"
    } ]
  }, {
    "tStartMs": 560960,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "그때 당시 평균 점수를 보면"
    } ]
  }, {
    "tStartMs": 562300,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "언어영역 평균 점수가 120점 만점에 64.7점 나왔답니다"
    } ]
  }, {
    "tStartMs": 566650,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "전체 점수의 54%가 평균 점수였다"
    } ]
  }, {
    "tStartMs": 570370,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "가장 기억나는 게 그때 수학이었거든요 수리1"
    } ]
  }, {
    "tStartMs": 573200,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "전설의 22.9점, 80점 만점입니다"
    } ]
  }, {
    "tStartMs": 576200,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "평균 점수가 22.9점 나왔어요"
    } ]
  }, {
    "tStartMs": 580130,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "근데 80점 만점이면 오지선다잖아"
    } ]
  }, {
    "tStartMs": 583000,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "주관식 점수 뺀다 그래도"
    } ]
  }, {
    "tStartMs": 584760,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "대충 찍어도 한 15점 나옵니다"
    } ]
  }, {
    "tStartMs": 587100,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "5분의 1이니까 그때 오지선다였죠?"
    } ]
  }, {
    "tStartMs": 589050,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "기억이 가물가물한데"
    } ]
  }, {
    "tStartMs": 590270,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "오지선다였을 거예요"
    } ]
  }, {
    "tStartMs": 591440,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "그러면은 뭐 주관식 점수"
    } ]
  }, {
    "tStartMs": 593240,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "한 15점 빼고 65점이라 그래요"
    } ]
  }, {
    "tStartMs": 594770,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "오지선다면 대충 찍어도 13점"
    } ]
  }, {
    "tStartMs": 596580,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "뭐 15점 나올 것 같은데"
    } ]
  }, {
    "tStartMs": 598430,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "평균이 22.9점이었습니다"
    } ]
  }, {
    "tStartMs": 601120,
    "dDurationMs": 3710,
    "segs": [ {
      "utf8": "100점 만점으로 치면 28점이 평균 점수였던"
    } ]
  }, {
    "tStartMs": 604830,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "28점만 맞으면"
    } ]
  }, {
    "tStartMs": 606400,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "나는 중간이었습니다"
    } ]
  }, {
    "tStartMs": 607640,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "100점 만점에 30점만 맞으면 잘했어"
    } ]
  }, {
    "tStartMs": 611130,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "40점 맞으면 거의 뭐 스카이를 가는"
    } ]
  }, {
    "tStartMs": 614140,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "그런 미친 시험이었다고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 616460,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "당시에 영어 평균 점수 35점이었어요"
    } ]
  }, {
    "tStartMs": 619110,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "80점 만점에"
    } ]
  }, {
    "tStartMs": 619980,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "말도 안 되죠?"
    } ]
  }, {
    "tStartMs": 620960,
    "dDurationMs": 3530,
    "segs": [ {
      "utf8": "수리탐구2 120점 만점에 평균이 48점이었습니다"
    } ]
  }, {
    "tStartMs": 624490,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "이걸 다 평균 내보면"
    } ]
  }, {
    "tStartMs": 625800,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "전체 평균이 100점 만점에 한 40 한 2, 3점?"
    } ]
  }, {
    "tStartMs": 628840,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "뭐 이 정도 나왔던"
    } ]
  }, {
    "tStartMs": 629840,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "정말 말도 안 되는 시험이죠"
    } ]
  }, {
    "tStartMs": 630940,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "난이도를 실패한 시험인데"
    } ]
  }, {
    "tStartMs": 632480,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "근데 왜 그랬냐?"
    } ]
  }, {
    "tStartMs": 633140,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "그때 당시에는 본고사라는 게 있었죠"
    } ]
  }, {
    "tStartMs": 636030,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "1996년에 본고사라는 게 있었는데"
    } ]
  }, {
    "tStartMs": 638450,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "그 본고사를 없애고"
    } ]
  }, {
    "tStartMs": 639680,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "본고사 대용으로 수능을 만들다 보니까"
    } ]
  }, {
    "tStartMs": 642500,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "작정하고 어렵게 냈죠"
    } ]
  }, {
    "tStartMs": 644140,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "너무 지나치게 어렵게 냈던"
    } ]
  }, {
    "tStartMs": 645560,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "그런 기억이 있는 1997년도 수능이 되겠습니다"
    } ]
  }, {
    "tStartMs": 649030,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "당시 아주 유명한 문제였죠"
    } ]
  }, {
    "tStartMs": 650620,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "전설의 수학 29번"
    } ]
  }, {
    "tStartMs": 652970,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "이게 아마 주관식 문제였을 거예요"
    } ]
  }, {
    "tStartMs": 654150,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "정답률이 0.08%입니다"
    } ]
  }, {
    "tStartMs": 656890,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "사실상 정답을 푸는 학생이 없다"
    } ]
  }, {
    "tStartMs": 659720,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "수학 올림피아드 나가는 학생들만"
    } ]
  }, {
    "tStartMs": 662120,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "정답을 풀었다고 해도 과언이 아닌데"
    } ]
  }, {
    "tStartMs": 664060,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "전 이 문제가 기억이 없어요"
    } ]
  }, {
    "tStartMs": 665350,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "이거 문이과 공통 문제였거든요"
    } ]
  }, {
    "tStartMs": 666930,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "왜 이 문제가 기억이 없냐"
    } ]
  }, {
    "tStartMs": 668110,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "너는 못 풀었냐 아니요"
    } ]
  }, {
    "tStartMs": 669770,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "저는 못 풀지 않았습니다"
    } ]
  }, {
    "tStartMs": 671300,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "무슨 말입니까?"
    } ]
  }, {
    "tStartMs": 672130,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "저는 이 문제까지 못 갔어요"
    } ]
  }, {
    "tStartMs": 674340,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "근데 대부분 이 문제까지 못 갔어"
    } ]
  }, {
    "tStartMs": 676810,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "주관식까지 그 시간 내에 간 학생이 거의 없어요"
    } ]
  }, {
    "tStartMs": 679780,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "객관식 풀다 보면 시간 끝났어"
    } ]
  }, {
    "tStartMs": 681730,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "주관식도 쉬운 거 앞에 1, 2, 3, 4만 잽싸게 풀고"
    } ]
  }, {
    "tStartMs": 684840,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "다시 객관식 하느라고"
    } ]
  }, {
    "tStartMs": 686280,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "이 문제까지 간 학생이 거의 없어요"
    } ]
  }, {
    "tStartMs": 688340,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "가도 못 풀고"
    } ]
  }, {
    "tStartMs": 689820,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "말도 안 되는 문제였기 때문에"
    } ]
  }, {
    "tStartMs": 690980,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "가도 못 풀기 때문에"
    } ]
  }, {
    "tStartMs": 692070,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "사실 거의 모든 학생들이"
    } ]
  }, {
    "tStartMs": 693900,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "이 문제까지 가지도 못했고"
    } ]
  }, {
    "tStartMs": 695790,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "게다가 주관식이잖아요"
    } ]
  }, {
    "tStartMs": 696730,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "보통 우린 주관식을 찍을 때"
    } ]
  }, {
    "tStartMs": 698220,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "0, 1, 100"
    } ]
  }, {
    "tStartMs": 699510,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "뭐 이런 걸 찍죠"
    } ]
  }, {
    "tStartMs": 700190,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "이게 문제가 답이 뭐 15인가 13인가 그랬을 텐데"
    } ]
  }, {
    "tStartMs": 702750,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "하여튼 말도 안 되는 그런 수능도 있었죠"
    } ]
  }, {
    "tStartMs": 705840,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "자 다시 돌아와서"
    } ]
  }, {
    "tStartMs": 707050,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "BBC는 그래서 이 한국의 고대 문자를 해석하는 듯한"
    } ]
  }, {
    "tStartMs": 710300,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "영어 시험을 보면서"
    } ]
  }, {
    "tStartMs": 711140,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 712470,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "문제 자체가 불가능한 건 아니지만"
    } ]
  }, {
    "tStartMs": 714930,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "뭐 읽다 보면 풀리긴 풀리죠"
    } ]
  }, {
    "tStartMs": 716660,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "정말 미치도록 혼란스러운 시험이다"
    } ]
  }, {
    "tStartMs": 719000,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "특히 가장 큰 문제는"
    } ]
  }, {
    "tStartMs": 720460,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "이게 실제 현장에서는"
    } ]
  }, {
    "tStartMs": 721820,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "전혀 쓸모가 없다는 것이다"
    } ]
  }, {
    "tStartMs": 724520,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "네가 고전 문학을 읽든지"
    } ]
  }, {
    "tStartMs": 726400,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "임마누엘 칸트의 법철학에 나오는 그런 문장을 읽고"
    } ]
  }, {
    "tStartMs": 730460,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "문제를 풀 수 있어서 뭐하냐?"
    } ]
  }, {
    "tStartMs": 732080,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "사실 영어시험이 아니죠"
    } ]
  }, {
    "tStartMs": 733690,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "영어시험이 아니라"
    } ]
  }, {
    "tStartMs": 734430,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "제가 보기에는 영어로 적은 국어시험이죠"
    } ]
  }, {
    "tStartMs": 737430,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "영어로 적은 언어시험입니다 언어시험"
    } ]
  }, {
    "tStartMs": 740090,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "그래서 제 생각이죠"
    } ]
  }, {
    "tStartMs": 741010,
    "dDurationMs": 520,
    "segs": [ {
      "utf8": "제 생각이죠"
    } ]
  }, {
    "tStartMs": 741530,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "우리나라 영어시험에 문제점이 있다라는 게"
    } ]
  }, {
    "tStartMs": 743970,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "누구나 다 알지만"
    } ]
  }, {
    "tStartMs": 745110,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "BBC까지 깜짝 놀라면서 했던"
    } ]
  }, {
    "tStartMs": 747860,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "그런 적이 있었습니다"
    } ]
  }, {
    "tStartMs": 749500,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "물론 어떤 분들이 그렇게 생각하실 수 있어요"
    } ]
  }, {
    "tStartMs": 751340,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "아니 요즘같이 AI 시대에 그냥 AI가 영어로 딸깍하면 번역해주는데"
    } ]
  }, {
    "tStartMs": 755260,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "영어 공부 뭐하려고 하냐"
    } ]
  }, {
    "tStartMs": 756580,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "그래서 오늘의 주제입니다"
    } ]
  }, {
    "tStartMs": 758110,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "얼마 전에 이런 가슴이 두근두근한 뉴스가 떴습니다"
    } ]
  }, {
    "tStartMs": 761330,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "삼성그룹이 올해부터 국내 해외 법인 간 문서에서도"
    } ]
  }, {
    "tStartMs": 765150,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "영어만 사용하기로 결정했다"
    } ]
  }, {
    "tStartMs": 767300,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "이제는 해외 법인에 문서를 하거나"
    } ]
  }, {
    "tStartMs": 769550,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "전화를 하거나 뭘 할 때"
    } ]
  }, {
    "tStartMs": 770860,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "상대가 한국인일지라도"
    } ]
  }, {
    "tStartMs": 772610,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "한국인일지라도"
    } ]
  }, {
    "tStartMs": 774060,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "영어로 보내야 된다는 겁니다"
    } ]
  }, {
    "tStartMs": 775580,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "삼성그룹에서는"
    } ]
  }, {
    "tStartMs": 776700,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "그동안은 저 법인에 한국 분이 꼭 계셨어요"
    } ]
  }, {
    "tStartMs": 779600,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "영어 한국 소통하는 분이 계셔서"
    } ]
  }, {
    "tStartMs": 781620,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "한국 분과 한글로 문서나 메일이나"
    } ]
  }, {
    "tStartMs": 784440,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "보고서를 보낼 수 있었다는 겁니다"
    } ]
  }, {
    "tStartMs": 786110,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "하지만 올해부터는 그게 안 된다는 거죠"
    } ]
  }, {
    "tStartMs": 788520,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "무조건 영어로 보고서를 보내거나"
    } ]
  }, {
    "tStartMs": 790310,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "아니면 영어로 대화를 해야 된다"
    } ]
  }, {
    "tStartMs": 792440,
    "dDurationMs": 4030,
    "segs": [ {
      "utf8": "내용을 보면 삼성전자, 삼성디스플레이, 삼성바이오로직스"
    } ]
  }, {
    "tStartMs": 796470,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "이런 3개사는 모든 문서를 영어로 작성하는 건 당연하고요"
    } ]
  }, {
    "tStartMs": 799700,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "순차적으로 다른 관계사에도 확대 적용할 지침이다"
    } ]
  }, {
    "tStartMs": 802790,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "특히 문서만 영어로 작성하면 되냐?"
    } ]
  }, {
    "tStartMs": 805130,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "나는 챗 gpt가 있으니까"
    } ]
  }, {
    "tStartMs": 806770,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "넣어서 해달라고 해야지?"
    } ]
  }, {
    "tStartMs": 808180,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "에이"
    } ]
  }, {
    "tStartMs": 808990,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "모든 회의에서도 영어를 사용한다고 합니다"
    } ]
  }, {
    "tStartMs": 812010,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "이제 줌 회의에서도 영어를 사용해요"
    } ]
  }, {
    "tStartMs": 814630,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "지난해부터 보고서와 회의 자료"
    } ]
  }, {
    "tStartMs": 816390,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "문서는 물론 회의에서도 영어를 사용하기로 결정했다"
    } ]
  }, {
    "tStartMs": 821140,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "그래서 약간..."
    } ]
  }, {
    "tStartMs": 822340,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "저는 요즘에 취업하라고 그러면"
    } ]
  }, {
    "tStartMs": 824220,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "대기업은 취업 못할 것 같아요"
    } ]
  }, {
    "tStartMs": 826050,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "야 이거 이거 어떻게..."
    } ]
  }, {
    "tStartMs": 828880,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "특히 삼성전자는 2025년 작년부터"
    } ]
  }, {
    "tStartMs": 831580,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "직원들의 외국어 회화 시험 비용을 지원했다고 합니다"
    } ]
  }, {
    "tStartMs": 834420,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "여기는 영어뿐만 아니라"
    } ]
  }, {
    "tStartMs": 835520,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "베트남, 러시아어 다 들어갔다"
    } ]
  }, {
    "tStartMs": 836610,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "7개 외국어의 회화 시험 응시료를 전액 지원한다"
    } ]
  }, {
    "tStartMs": 839340,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "회화 시험 응시가 꽤 비싸잖아요"
    } ]
  }, {
    "tStartMs": 840470,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "한 10몇만 원 하지 않나요? 회화는?"
    } ]
  }, {
    "tStartMs": 843300,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "토익 뭐 이제 그런 건 한 7만 원"
    } ]
  }, {
    "tStartMs": 845250,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "뭐 한 6만 원 할 것 같은데"
    } ]
  }, {
    "tStartMs": 846730,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "근데 너무 오래전에 봐서 기억이 안 나는데"
    } ]
  }, {
    "tStartMs": 848590,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "회화는 굉장히 비싸니까"
    } ]
  }, {
    "tStartMs": 850280,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "그것도 연 2회에 한해 전액 지원한다"
    } ]
  }, {
    "tStartMs": 852750,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "시험만 봐라"
    } ]
  }, {
    "tStartMs": 853790,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "제발 공부해서 영어, 외국어 시험만 봐라"
    } ]
  }, {
    "tStartMs": 856670,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "돈은 줄게 이렇게 결정을 했다는 거죠"
    } ]
  }, {
    "tStartMs": 859320,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "게다가 시험을 봐서"
    } ]
  }, {
    "tStartMs": 860860,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "점수가 높으면 현금으로 보상하겠다고 공지했다고 합니다"
    } ]
  }, {
    "tStartMs": 864340,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "한마디로 내부의 외국어 회화 능력 체계가 있는 모양이에요"
    } ]
  }, {
    "tStartMs": 867370,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "최상위 등급 3개 1+, 1++, S등급에는"
    } ]
  }, {
    "tStartMs": 870290,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "1++은 20만 원"
    } ]
  }, {
    "tStartMs": 871460,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "S등급 가면 50만원 상당을 상금을 지급하고"
    } ]
  }, {
    "tStartMs": 874340,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "S등급을 받으면"
    } ]
  }, {
    "tStartMs": 875140,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "누적적으로 100만원을 받을 수 있는"
    } ]
  }, {
    "tStartMs": 877440,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "이런 현금 보상안도 제시했다고 합니다"
    } ]
  }, {
    "tStartMs": 879940,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "영어를 하라는 거죠"
    } ]
  }, {
    "tStartMs": 881440,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "중국어, 일본어, 베트남어도 좋지만"
    } ]
  }, {
    "tStartMs": 883040,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "무조건 외국어를 해라"
    } ]
  }, {
    "tStartMs": 884980,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "그럼 왜 토익시험이 아니라"
    } ]
  }, {
    "tStartMs": 886030,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "영어 회화시험에 응시를 지원하냐?"
    } ]
  }, {
    "tStartMs": 888900,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "자 그건 당연하게도 뭐겠습니까?"
    } ]
  }, {
    "tStartMs": 890950,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "영어로 말을 해야 된다"
    } ]
  }, {
    "tStartMs": 893860,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "하..."
    } ]
  }, {
    "tStartMs": 894930,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "제가 영어로 말만 했어도 슈카월드가..."
    } ]
  }, {
    "tStartMs": 896690,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "제가 영어로 그냥 유창하게 말만 할 수 있었어도"
    } ]
  }, {
    "tStartMs": 898850,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "슈카월드가 아마 천만 구독자가 되지 않았을까 생각을 하는데"
    } ]
  }, {
    "tStartMs": 902370,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "그만큼 영어를 읽고 쓰고도 중요하지만"
    } ]
  }, {
    "tStartMs": 904700,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "읽는 건 또 요즘에 그래도 AI가 잘 되잖아요"
    } ]
  }, {
    "tStartMs": 907110,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "말하는 건 안 됩니다"
    } ]
  }, {
    "tStartMs": 908450,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "영어는 언어잖아요"
    } ]
  }, {
    "tStartMs": 909480,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "특히 회의에 참석하거나"
    } ]
  }, {
    "tStartMs": 911070,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "아니면 누구한테 누굴 만났을 때"
    } ]
  }, {
    "tStartMs": 912850,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "바이어를 만났을 때"
    } ]
  }, {
    "tStartMs": 914010,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "아니면 외국에 갔을 때"
    } ]
  }, {
    "tStartMs": 914720,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "영어로 말을 할 수 있냐 없냐는 거는"
    } ]
  }, {
    "tStartMs": 916770,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "전 너무나 뼈저리게 느끼고 있어요"
    } ]
  }, {
    "tStartMs": 918750,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "그 사람의 가치를 결정한다"
    } ]
  }, {
    "tStartMs": 921150,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "우리나라에서는 그래요"
    } ]
  }, {
    "tStartMs": 922790,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "영어를 할 수 있는 게"
    } ]
  }, {
    "tStartMs": 923630,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "그 사람의 굉장히 뛰어난 가치"
    } ]
  }, {
    "tStartMs": 926080,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "능력의 일부분을 차지합니다"
    } ]
  }, {
    "tStartMs": 928460,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "미국인이나 영국인들은 그렇지 않겠죠"
    } ]
  }, {
    "tStartMs": 930340,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "그 사람들은 더 리더십, 창의력, 혁신"
    } ]
  }, {
    "tStartMs": 933800,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "이런 게 능력이겠지만"
    } ]
  }, {
    "tStartMs": 935230,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "우리나라는 기본적으로 영어를 말할 수 있냐 없냐가"
    } ]
  }, {
    "tStartMs": 938420,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "맨 앞에 탁 들어가요"
    } ]
  }, {
    "tStartMs": 940130,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "나중에 보세요"
    } ]
  }, {
    "tStartMs": 940790,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "영어로 유창하게 말할 수 있다가"
    } ]
  }, {
    "tStartMs": 942400,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "그 사람의 능력이라고"
    } ]
  }, {
    "tStartMs": 943670,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "맨 앞에 써 있는 거를 볼 수 있습니다"
    } ]
  }, {
    "tStartMs": 946560,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "그래서 영어는 언어고 읽고 쓰는 것도 중요하지만"
    } ]
  }, {
    "tStartMs": 949590,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "결국 말을 할 수 있어야 된다는 거죠"
    } ]
  }, {
    "tStartMs": 951790,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "그래서 저는 이 고민을 100번 이해합니다"
    } ]
  }, {
    "tStartMs": 954740,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "우리나라 많은 엄마들이 하는 고민"
    } ]
  }, {
    "tStartMs": 956520,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "우리 아이 영어유치원 보낼까?"
    } ]
  }, {
    "tStartMs": 958820,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "우리 아이 영어유치원 보낼까?"
    } ]
  }, {
    "tStartMs": 960160,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "마음은 보내고 싶죠"
    } ]
  }, {
    "tStartMs": 961400,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "영어유치원 보내면 영어 발음이 좀이라도 좋아지고"
    } ]
  }, {
    "tStartMs": 963380,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "아이가 갑자기 뭐 스튜던트, 데스크"
    } ]
  }, {
    "tStartMs": 965520,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "이런 말을 쓰니까 보내고 싶은데"
    } ]
  }, {
    "tStartMs": 967330,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "문제는 가격이 문제죠"
    } ]
  }, {
    "tStartMs": 970320,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "교육부가 작년에 2024년 유아사교육비 시험조사라는 걸 했습니다"
    } ]
  }, {
    "tStartMs": 974300,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "여기 이런 내용이 나와요"
    } ]
  }, {
    "tStartMs": 975650,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "영어 유치원에 보낼 경우"
    } ]
  }, {
    "tStartMs": 977250,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "유아 1인당 월 평균 154만 원이 사교육비로 나간다"
    } ]
  }, {
    "tStartMs": 982230,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "야, 이거 정말 미친 금액입니다"
    } ]
  }, {
    "tStartMs": 984130,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "미친 금액"
    } ]
  }, {
    "tStartMs": 985340,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "영어 유치원에 보내면"
    } ]
  }, {
    "tStartMs": 986660,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "평균이 154만 원이에요"
    } ]
  }, {
    "tStartMs": 989260,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "그럼 좋은데 보내면"
    } ]
  }, {
    "tStartMs": 990210,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "200이 훌쩍이라는 소리입니다"
    } ]
  }, {
    "tStartMs": 992290,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "셔틀버스 이런 것도 다 들어가야 될 거 아니에요"
    } ]
  }, {
    "tStartMs": 994300,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "교재비가 들어가는지 모르겠는데"
    } ]
  }, {
    "tStartMs": 996020,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "엄청난 비용이라고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 998050,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "그러다 보니까 너무 비싸서"
    } ]
  }, {
    "tStartMs": 999880,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "영어 유치원에는 못 보내고"
    } ]
  }, {
    "tStartMs": 1001500,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "일반 유치원에서 영어 가르치고 그런 경우도 있잖아요"
    } ]
  }, {
    "tStartMs": 1003450,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "영어 학원 보내는 경우도 있고"
    } ]
  }, {
    "tStartMs": 1005290,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "그 아래도 교육부가 공개한 내용인데"
    } ]
  }, {
    "tStartMs": 1007110,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "사교육에 참여하는 유아 기준으로"
    } ]
  }, {
    "tStartMs": 1008860,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "그 어린애들이 영어 과목에 지출하는"
    } ]
  }, {
    "tStartMs": 1011180,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "월평균 사교육비가 41만 4천 원이 찍혔습니다"
    } ]
  }, {
    "tStartMs": 1015180,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "말도 안 되는 금액이죠"
    } ]
  }, {
    "tStartMs": 1016480,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "진짜 말도 안 돼"
    } ]
  }, {
    "tStartMs": 1017320,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "유치원에 보내는 아이들이"
    } ]
  }, {
    "tStartMs": 1018920,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "영어 사교육에 월평균 41만 원을 쓴다는 말입니다"
    } ]
  }, {
    "tStartMs": 1022460,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "이게 얼마나 높은 거냐면"
    } ]
  }, {
    "tStartMs": 1023920,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "지난해 고등학생의 월평균"
    } ]
  }, {
    "tStartMs": 1025820,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "영어 사교육비가 32만 원이에요"
    } ]
  }, {
    "tStartMs": 1027900,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "고등학생보다 유치원생들이"
    } ]
  }, {
    "tStartMs": 1030500,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "영어 과목에 사교육비를 더 많이 쓴다는 거죠"
    } ]
  }, {
    "tStartMs": 1034550,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "그만큼 어른이 돼서도 영어 공부 스트레스지만"
    } ]
  }, {
    "tStartMs": 1037300,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "우리 아이가 영어를 유창하게 하는 게"
    } ]
  }, {
    "tStartMs": 1039330,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "얼마나 많이 바라고"
    } ]
  }, {
    "tStartMs": 1041000,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "그게 또 큰 능력이라고 생각하는지"
    } ]
  }, {
    "tStartMs": 1042990,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "아마 너무 쉽게 알 수 있는 자료가 아닌가 생각이 됩니다"
    } ]
  }, {
    "tStartMs": 1045980,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "그래서인지 몰라도"
    } ]
  }, {
    "tStartMs": 1047000,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "아주 유명한 일이 있었죠"
    } ]
  }, {
    "tStartMs": 1048740,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "2023년에 삼성그룹 이재용 회장님이"
    } ]
  }, {
    "tStartMs": 1050890,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "이렇게 얘기한 일이 있었습니다"
    } ]
  }, {
    "tStartMs": 1052320,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "본인도 외국어 공부를 더 안 한 게 후회된다"
    } ]
  }, {
    "tStartMs": 1055160,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "삼성그룹 회장인데"
    } ]
  }, {
    "tStartMs": 1057090,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "외국어 공부를 더 안 한 게 후회된다"
    } ]
  }, {
    "tStartMs": 1059410,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "나는 그래도 영어와 일본어는 하는데"
    } ]
  }, {
    "tStartMs": 1062060,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "그것도 잊어버리지 않기 위해서 노력 중이다"
    } ]
  }, {
    "tStartMs": 1064760,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "그리고 여러분들은 꼭 외국어를 더 공부하길 바란다"
    } ]
  }, {
    "tStartMs": 1068180,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "라고 말하신 적이 있었어요"
    } ]
  }, {
    "tStartMs": 1070400,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "야 진짜 뭐 그룹의 회장도"
    } ]
  }, {
    "tStartMs": 1072220,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "이 언어를 잘하는 것에 대해서"
    } ]
  }, {
    "tStartMs": 1073500,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "얼마나 중요하게 생각하는지를"
    } ]
  }, {
    "tStartMs": 1075450,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "말하는 그런 일화가 아닌가 생각이 되고"
    } ]
  }, {
    "tStartMs": 1077110,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "삼성만 그랬냐?"
    } ]
  }, {
    "tStartMs": 1078140,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "아니요"
    } ]
  }, {
    "tStartMs": 1078880,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "요즘은 영어를 사용하는 게"
    } ]
  }, {
    "tStartMs": 1079880,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "많은 대기업에서 널리 퍼지고 있습니다"
    } ]
  }, {
    "tStartMs": 1082490,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "자 얼마 전에"
    } ]
  }, {
    "tStartMs": 1083440,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "현대차그룹도 본인들의 해외 법인과의 공식 의사소통 언어로"
    } ]
  }, {
    "tStartMs": 1087490,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "영어를 지정했습니다"
    } ]
  }, {
    "tStartMs": 1088810,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "해외 법인과 주고받는 문서나"
    } ]
  }, {
    "tStartMs": 1090490,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "아니면 회의는 영어로 하는 게"
    } ]
  }, {
    "tStartMs": 1092470,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "영문 작성이 관행이다"
    } ]
  }, {
    "tStartMs": 1094200,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "영어 소통이 기본 전제다"
    } ]
  }, {
    "tStartMs": 1096250,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "이런 얘기를 했습니다"
    } ]
  }, {
    "tStartMs": 1096970,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "이제 영어는 단순히 외국인 대응용이 아니라"
    } ]
  }, {
    "tStartMs": 1099310,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "내부 협업의 전제이자 업무 구조 개편의 수단이다"
    } ]
  }, {
    "tStartMs": 1102800,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "이거 무시무시한 얘기예요"
    } ]
  }, {
    "tStartMs": 1104260,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "회사를 다녀보면 압니다"
    } ]
  }, {
    "tStartMs": 1105790,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "업무 구조 개편의 수단이라는 게 무슨 말인지를"
    } ]
  }, {
    "tStartMs": 1108840,
    "dDurationMs": 4310,
    "segs": [ {
      "utf8": "영어를 잘하는 사람과 그렇지 못한 사람을 따로 구분해서"
    } ]
  }, {
    "tStartMs": 1113150,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "업무를 맡길 수도 있다"
    } ]
  }, {
    "tStartMs": 1114090,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "이런 뜻으로 들리는 거죠"
    } ]
  }, {
    "tStartMs": 1115610,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "많은 분들이 가고 싶어하는"
    } ]
  }, {
    "tStartMs": 1117000,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "미국 법인이나 해외 법인도"
    } ]
  }, {
    "tStartMs": 1118620,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "당연히 영어가 중요하겠고"
    } ]
  }, {
    "tStartMs": 1120480,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "해외 법인과 소통을 영어를 할 수 있냐 없냐로 결정하다 보면"
    } ]
  }, {
    "tStartMs": 1124680,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "본인이 가고 싶어하는 자리나"
    } ]
  }, {
    "tStartMs": 1126620,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "아니면 승진이나 이런 게"
    } ]
  }, {
    "tStartMs": 1128430,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "당연히 차이가 발생한다는 거죠"
    } ]
  }, {
    "tStartMs": 1130390,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "그리고 예전에 말씀드렸지만"
    } ]
  }, {
    "tStartMs": 1131950,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "저 같은 경우는"
    } ]
  }, {
    "tStartMs": 1132960,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "AI 때문에 영어 실력이"
    } ]
  }, {
    "tStartMs": 1134090,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "오히려 뒤로 간다고 생각합니다"
    } ]
  }, {
    "tStartMs": 1136020,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "이거 딸깍으로 되니까"
    } ]
  }, {
    "tStartMs": 1137510,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "이제 영어로 잘 읽지를 않아요"
    } ]
  }, {
    "tStartMs": 1139120,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "말하는 건 말할 필요도 없고"
    } ]
  }, {
    "tStartMs": 1140250,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "읽지도 않고"
    } ]
  }, {
    "tStartMs": 1141340,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "더 뒤로 가지 않나 생각이 되고"
    } ]
  }, {
    "tStartMs": 1143260,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "게다가 더 큰 문제가"
    } ]
  }, {
    "tStartMs": 1144580,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "젊은 사용자일수록 기술에 더 많이 의존하면서"
    } ]
  }, {
    "tStartMs": 1147640,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "젊은 사람들 사이에서 영어 실력이 더 빠르게 떨어진다"
    } ]
  }, {
    "tStartMs": 1150890,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "옛날 영상 보면 있습니다"
    } ]
  }, {
    "tStartMs": 1151910,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "놀랍게도 그렇다고 합니다"
    } ]
  }, {
    "tStartMs": 1153660,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "그래서 요즘은 젊은 사람들이 영어를 더 못하더라"
    } ]
  }, {
    "tStartMs": 1156890,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "심지어 최근 한국인들의 영어 유창성 점수가 점점 더 떨어진다더라"
    } ]
  }, {
    "tStartMs": 1161360,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "일본은 굉장히 많이 떨어졌다"
    } ]
  }, {
    "tStartMs": 1162900,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "예전에 한번 말씀드렸죠"
    } ]
  }, {
    "tStartMs": 1164330,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "영어는 더 중요해지는데"
    } ]
  }, {
    "tStartMs": 1165680,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "영어는 더 못하게 되는 게"
    } ]
  }, {
    "tStartMs": 1167290,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "지금 우리의 현실이라고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 1169920,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "물론 뭐 다 알죠"
    } ]
  }, {
    "tStartMs": 1170770,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "우리가 영어를 왜 잘 말 못하고"
    } ]
  }, {
    "tStartMs": 1172400,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "왜 영어 점수가 점점 더 떨어지냐?"
    } ]
  }, {
    "tStartMs": 1174200,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "당연히 영어로 대화할 기회가 없기 때문입니다"
    } ]
  }, {
    "tStartMs": 1178020,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "영어로 대화할 기회가 없어요"
    } ]
  }, {
    "tStartMs": 1180430,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "또는 충분하지 않죠"
    } ]
  }, {
    "tStartMs": 1181630,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "심지어 요즘은 외국 유튜브도"
    } ]
  }, {
    "tStartMs": 1183710,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "요즘에 AI를 번역해서 보기 때문에"
    } ]
  }, {
    "tStartMs": 1186770,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "진짜 어렵죠"
    } ]
  }, {
    "tStartMs": 1187480,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "그리고 당연히 압니다"
    } ]
  }, {
    "tStartMs": 1188770,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "당연히 언어를 배우기 위해서는"
    } ]
  }, {
    "tStartMs": 1190480,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "말을 많이 해봐야 된다는 건"
    } ]
  }, {
    "tStartMs": 1192100,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "너무나 쉽게 알 수 있어요"
    } ]
  }, {
    "tStartMs": 1193510,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "사실 많이 해보면 좀 되긴 되거든요"
    } ]
  }, {
    "tStartMs": 1196400,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "그게"
    } ]
  }, {
    "tStartMs": 1197290,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "제가 이걸 언제 느꼈냐면은"
    } ]
  }, {
    "tStartMs": 1198880,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "예전에 일본인 친구하고"
    } ]
  }, {
    "tStartMs": 1200030,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "뭐 어디를 같이 돌아다니는 일이 있었어요"
    } ]
  }, {
    "tStartMs": 1201770,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "제가 일본말을 못하니까"
    } ]
  }, {
    "tStartMs": 1202740,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "물론 일본인 친구도 한국말을 못하고"
    } ]
  }, {
    "tStartMs": 1204300,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "서로 영어로 하잖아요"
    } ]
  }, {
    "tStartMs": 1205790,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "근데 그 몇 시간 돌아다니면서"
    } ]
  }, {
    "tStartMs": 1207740,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "둘이 안 되는 영어로 떠듬떠듬떠듬 했다고"
    } ]
  }, {
    "tStartMs": 1210880,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "오 그 몇 시간 지나고 난 다음에는"
    } ]
  }, {
    "tStartMs": 1213080,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "오 그래도 영어가 약간 약간이지만"
    } ]
  }, {
    "tStartMs": 1215560,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "옛날 보다 잘 되는 느낌 그게 딱 들더라고요"
    } ]
  }, {
    "tStartMs": 1218450,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "많이 말을 하면은"
    } ]
  }, {
    "tStartMs": 1219990,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "우리도 어느 정도는 할 수 있는데"
    } ]
  }, {
    "tStartMs": 1222530,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "이게 잘 안 되죠"
    } ]
  }, {
    "tStartMs": 1223340,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "잘 쓰는 게 안 되니까"
    } ]
  }, {
    "tStartMs": 1224900,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "게다가 저는 이번에"
    } ]
  }, {
    "tStartMs": 1226460,
    "dDurationMs": 4030,
    "segs": [ {
      "utf8": "2026년 스페인 바르셀로나 MWC라는"
    } ]
  }, {
    "tStartMs": 1230490,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "굉장히 거대한 콘퍼런스에 참석하는 일정이 있습니다"
    } ]
  }, {
    "tStartMs": 1234080,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "거기에 참석을 하면"
    } ]
  }, {
    "tStartMs": 1235580,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "정말 많은 강연을 듣고"
    } ]
  }, {
    "tStartMs": 1236960,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "이런 데거든요"
    } ]
  }, {
    "tStartMs": 1238050,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "많은 강연을 듣고"
    } ]
  }, {
    "tStartMs": 1239550,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "많은 인터뷰를 해야 돼요"
    } ]
  }, {
    "tStartMs": 1241360,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "벌써 걱정이 되는 거죠"
    } ]
  }, {
    "tStartMs": 1243840,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "뭐라고 하는지는"
    } ]
  }, {
    "tStartMs": 1245430,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "대강 짬으로 알아들을 수 있는데"
    } ]
  }, {
    "tStartMs": 1247380,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "질문을 이거 어떻게 해야 되나"
    } ]
  }, {
    "tStartMs": 1250080,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "진작 영어 공부할 걸"
    } ]
  }, {
    "tStartMs": 1251670,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "그렇다고 안 갈 수도 없고"
    } ]
  }, {
    "tStartMs": 1253630,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "시간이 아직 좀 남았지만"
    } ]
  }, {
    "tStartMs": 1255020,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "걱정이 앞서는 거죠"
    } ]
  }, {
    "tStartMs": 1256320,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "저는 그래서 이번에 공부는 뭘로 할 거냐?"
    } ]
  }, {
    "tStartMs": 1258710,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "슈카가 모델을 했던 영어 학습 앱 스픽이 있습니다"
    } ]
  }, {
    "tStartMs": 1262180,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "스픽 아마 기억이 나실 거예요"
    } ]
  }, {
    "tStartMs": 1263410,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "오픈 AI와 기술 제휴를 맺고"
    } ]
  }, {
    "tStartMs": 1265340,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "오픈 AI가 투자한 기업입니다"
    } ]
  }, {
    "tStartMs": 1266780,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "2025년 포브스 선정"
    } ]
  }, {
    "tStartMs": 1268670,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "AI 50대 기업에 선정된 그런 기업이라고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 1271740,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "요즘에 AI 영어 교육 앱은 어떻게 나오냐?"
    } ]
  }, {
    "tStartMs": 1274320,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "바로 이렇게 나옵니다"
    } ]
  }, {
    "tStartMs": 1275900,
    "dDurationMs": 4490,
    "segs": [ {
      "utf8": "그냥 많은 문장을 무조건 얘기할 수 있게 만들어 준다"
    } ]
  }, {
    "tStartMs": 1280390,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "20분에 100문장"
    } ]
  }, {
    "tStartMs": 1281570,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "일주일에 1,000문장"
    } ]
  }, {
    "tStartMs": 1282560,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "왜냐하면 얘는 AI예요"
    } ]
  }, {
    "tStartMs": 1284160,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "저랑 영어로 대화를 하는 AI라고 보시면 됩니다"
    } ]
  }, {
    "tStartMs": 1287360,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "제가 말하는 것까지"
    } ]
  }, {
    "tStartMs": 1288200,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "쿵짝쿵짝 대화를 하면서"
    } ]
  }, {
    "tStartMs": 1289710,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "그때그때 말하는 게"
    } ]
  }, {
    "tStartMs": 1290490,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "당연히 계속 바뀌겠죠"
    } ]
  }, {
    "tStartMs": 1292020,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "요즘 AI는 그렇다고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 1294160,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "일주일에 1,000문장을 계속 말하기 시작하면"
    } ]
  }, {
    "tStartMs": 1297250,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "입이 조금씩 열리는 거죠"
    } ]
  }, {
    "tStartMs": 1299210,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "그냥 하면 재미가 없죠?"
    } ]
  }, {
    "tStartMs": 1300360,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "요즘에 어떻게 합니까?"
    } ]
  }, {
    "tStartMs": 1301100,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "바로 이렇게 합니다"
    } ]
  }, {
    "tStartMs": 1302740,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "마치 내가 진짜로 외국인과 대화하듯이"
    } ]
  }, {
    "tStartMs": 1305150,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "외국인 AI 모델이 나와요"
    } ]
  }, {
    "tStartMs": 1306560,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "그리고 제가 얘랑 대화하는 겁니다"
    } ]
  }, {
    "tStartMs": 1308570,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "이걸 프리톡 비주얼 모드라고 한다 그러는데"
    } ]
  }, {
    "tStartMs": 1311160,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "상황과 주제도 내가 설정한 걸로 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 1314170,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "예를 들면 약속 잡기"
    } ]
  }, {
    "tStartMs": 1315950,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "아니면 호텔에 가서 어떻게 할까?"
    } ]
  }, {
    "tStartMs": 1317530,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "공항에 가서 어떻게 할까?"
    } ]
  }, {
    "tStartMs": 1319050,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "여권 검사 받을 때"
    } ]
  }, {
    "tStartMs": 1320170,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "뭐라고 얘기를 할까?"
    } ]
  }, {
    "tStartMs": 1321380,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "이런 주제를 설정을 해서"
    } ]
  }, {
    "tStartMs": 1323020,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "AI와 그대로 대화를 할 수 있죠"
    } ]
  }, {
    "tStartMs": 1326020,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "예를 들면 이제 우리가 미국에 가면"
    } ]
  }, {
    "tStartMs": 1327770,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "가장 떨리는 거"
    } ]
  }, {
    "tStartMs": 1328640,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "바로 입국심사관과의 대화"
    } ]
  }, {
    "tStartMs": 1330570,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "이런 거 만들어서 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 1332020,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "매번 달라져요"
    } ]
  }, {
    "tStartMs": 1332820,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "요즘 AI가 그렇죠"
    } ]
  }, {
    "tStartMs": 1333710,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "내가 어떻게 대화하느냐에 따라서"
    } ]
  }, {
    "tStartMs": 1335300,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "AI의 답도 굉장히 달라진다고 할 수 있고"
    } ]
  }, {
    "tStartMs": 1337950,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "당연히 실시간 교정을 해주고요"
    } ]
  }, {
    "tStartMs": 1340040,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "잘 모르겠다 싶으면 힌트도 줘요"
    } ]
  }, {
    "tStartMs": 1341310,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "한번 생각해보라고"
    } ]
  }, {
    "tStartMs": 1343240,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "누구나 외국인과 대화하는 듯한 경험을 할 수 있죠"
    } ]
  }, {
    "tStartMs": 1346590,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "미국에 가서 음식을 어떻게 주문할까?"
    } ]
  }, {
    "tStartMs": 1348540,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "역시 AI를 통해서 연습할 수 있습니다"
    } ]
  }, {
    "tStartMs": 1351610,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "만약에 내가 당장 다음 주 또는 다음 달에 오픽 시험을 봐야 된다"
    } ]
  }, {
    "tStartMs": 1355270,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "말하기 시험을 봐야 된다"
    } ]
  }, {
    "tStartMs": 1356230,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "그럼 역시 내가 오픽 시험을 볼게"
    } ]
  }, {
    "tStartMs": 1358410,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "라고 AI한테 설정을 하면"
    } ]
  }, {
    "tStartMs": 1360240,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "오픽에서 나오는 주제들로 나하고 얘기를 해줍니다"
    } ]
  }, {
    "tStartMs": 1363200,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "무한 연습과 무한 암기하고"
    } ]
  }, {
    "tStartMs": 1364620,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "그걸 또 계속 얘기해주면"
    } ]
  }, {
    "tStartMs": 1365880,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "얘가 또 지적해주죠"
    } ]
  }, {
    "tStartMs": 1367070,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "사장님 그런 단어 아니에요"
    } ]
  }, {
    "tStartMs": 1369140,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "라고 지적을 해주기 때문에"
    } ]
  }, {
    "tStartMs": 1371580,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "내가 의지만 있고"
    } ]
  }, {
    "tStartMs": 1372280,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "내가 얘랑 계속 대화만 할 수 있다면"
    } ]
  }, {
    "tStartMs": 1374160,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "외국에 나가서 외국인과 대화하는 것과"
    } ]
  }, {
    "tStartMs": 1376400,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "비슷한 효과를 볼 수 있겠죠"
    } ]
  }, {
    "tStartMs": 1378480,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "아까 말씀드렸지만"
    } ]
  }, {
    "tStartMs": 1379360,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "스픽 같은 경우에는"
    } ]
  }, {
    "tStartMs": 1380290,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "작년 포브스가 선정한 AI 50 기업에 이름을 올렸죠"
    } ]
  }, {
    "tStartMs": 1383130,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "지금 약 천만 명이 스픽을 통해서"
    } ]
  }, {
    "tStartMs": 1385100,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "영어와 스페인어 같은"
    } ]
  }, {
    "tStartMs": 1386400,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "미국인들은 스페인어 학습을 또 한다고 하더라고요"
    } ]
  }, {
    "tStartMs": 1388950,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "스페인어 학습에 많이 사용한다고 합니다"
    } ]
  }, {
    "tStartMs": 1391870,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "그래서 제가 어떻게 하는지"
    } ]
  }, {
    "tStartMs": 1393490,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "잠깐 예시를 보여드리겠습니다"
    } ]
  }, {
    "tStartMs": 1395620,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "이렇게 설정을 하고 본인이 원하는 설정을 넣습니다"
    } ]
  }, {
    "tStartMs": 1398150,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "누구누구 할지 정할 수 있어요"
    } ]
  }, {
    "tStartMs": 1400000,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "나의 역할을 쳐요"
    } ]
  }, {
    "tStartMs": 1401170,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "뭐뭐를 할 거다"
    } ]
  }, {
    "tStartMs": 1401920,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "그리고 너는 뭐뭐를 해줘"
    } ]
  }, {
    "tStartMs": 1403390,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "나는 학생이야"
    } ]
  }, {
    "tStartMs": 1404410,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "너는 선생님이야"
    } ]
  }, {
    "tStartMs": 1405150,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "이렇게 치면"
    } ]
  }, {
    "tStartMs": 1406140,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "이렇게 나옵니다"
    } ]
  }, {
    "tStartMs": 1415620,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Welcome to our mobile booth"
    } ]
  }, {
    "tStartMs": 1417540,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "Are you interested in the new AI technology we have here?"
    } ]
  }, {
    "tStartMs": 1421830,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "좋아요"
    } ]
  }, {
    "tStartMs": 1422680,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "이렇게 이걸 계속하다 보면"
    } ]
  }, {
    "tStartMs": 1424320,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "저처럼 영어가 늘 수 있습니다"
    } ]
  }, {
    "tStartMs": 1425750,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "아 이거 반복적으로 해야 되는데"
    } ]
  }, {
    "tStartMs": 1428260,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "더 의지가 좀 따라줘야겠죠"
    } ]
  }, {
    "tStartMs": 1429850,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "아 뭐 힘들죠"
    } ]
  }, {
    "tStartMs": 1431060,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "하지만 왕도 없습니다"
    } ]
  }, {
    "tStartMs": 1432410,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "결국 틀리더라도 많이 말해야 되고요"
    } ]
  }, {
    "tStartMs": 1434930,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "자 스픽에서 선생님이 이렇게 얘기하더라고요"
    } ]
  }, {
    "tStartMs": 1436970,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "일주일에 1,000문장"
    } ]
  }, {
    "tStartMs": 1438300,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "20분 100문장을 얘기하면"
    } ]
  }, {
    "tStartMs": 1439970,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "저도 할 수 있다고 얘기해 주시더라고요"
    } ]
  }, {
    "tStartMs": 1441970,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "자 그래서 이걸 여러분들도 하실 수 있게 스픽에서"
    } ]
  }, {
    "tStartMs": 1444530,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "특별히 슈카월드 시청자들을 위한 혜택을 제공해 주신다고 합니다"
    } ]
  }, {
    "tStartMs": 1448470,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "자 아까 보신 비주얼 모드도 사용할 수 있고"
    } ]
  }, {
    "tStartMs": 1450770,
    "dDurationMs": 4010,
    "segs": [ {
      "utf8": "영어 표현 PDF도 2종까지 받아볼 수 있는 혜택을 드린다고 합니다"
    } ]
  }, {
    "tStartMs": 1454780,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "아래 더보기나 고정 댓글의 링크를 확인하시면 되겠습니다"
    } ]
  }, {
    "tStartMs": 1458200,
    "dDurationMs": 5130,
    "segs": [ {
      "utf8": "자 그래서 저도 스픽으로 열심히 연습하고 한번 출발해 보겠습니다"
    } ]
  }, {
    "tStartMs": 1463330,
    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "바로셀로나에 가서 MWC 2026 전세계 이동통신 최대 박람회인데"
    } ]
  }, {
    "tStartMs": 1468770,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "잘하고 오겠습니다"
    } ]
  }, {
    "tStartMs": 1470780,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "화이팅!"
    } ]
  } ]
}

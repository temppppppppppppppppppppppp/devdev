{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 7940,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "실리콘밸리에 불고 있는 땡땡 열풍을 갖고 왔습니다"
    } ]
  }, {
    "tStartMs": 11040,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "이거는 제 생각에"
    } ]
  }, {
    "tStartMs": 12390,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "여러분들이 굉장히 관심을 기울일 수 있는 주제예요"
    } ]
  }, {
    "tStartMs": 15820,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "2, 3년 전부터 사실 이 얘기가 나는데"
    } ]
  }, {
    "tStartMs": 17570,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "작년부터 이 열풍이 더 세지고 있다 그럽니다"
    } ]
  }, {
    "tStartMs": 20100,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "실리콘밸리에 굉장히 땡땡 열풍이 불고 있다"
    } ]
  }, {
    "tStartMs": 23010,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "대한민국엔 두쫀쿠가 있었고요"
    } ]
  }, {
    "tStartMs": 25130,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "실리콘밸리엔 땡땡 열풍이 있습니다"
    } ]
  }, {
    "tStartMs": 27030,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "자 그건 뭐냐?"
    } ]
  }, {
    "tStartMs": 27780,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "얼마 전 월스트리트저널이"
    } ]
  }, {
    "tStartMs": 29180,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "실리콘밸리에 부는 새로운 바람을 소개했습니다"
    } ]
  }, {
    "tStartMs": 31650,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "그 바람은 여러분들하고 아주 큰 관계가 있어요"
    } ]
  }, {
    "tStartMs": 34550,
    "dDurationMs": 490,
    "segs": [ {
      "utf8": "뭐냐?"
    } ]
  }, {
    "tStartMs": 36130,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "IT 업계의 남성들이 안면 성형"
    } ]
  }, {
    "tStartMs": 39670,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "얼굴 성형에 열을 올리고 있다"
    } ]
  }, {
    "tStartMs": 43170,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "라는 기사가 나왔습니다"
    } ]
  }, {
    "tStartMs": 45060,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "한 3, 4년도 더 됐어요"
    } ]
  }, {
    "tStartMs": 46640,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "코로나 이후에 이런 기사가 많이 나왔는데"
    } ]
  }, {
    "tStartMs": 48820,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "더 강화되고 있다는 거죠"
    } ]
  }, {
    "tStartMs": 50020,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "아니 IT 업계 남성들이"
    } ]
  }, {
    "tStartMs": 51170,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "갑자기 왜 성형이냐?"
    } ]
  }, {
    "tStartMs": 53250,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "여자도 아니고 남자들이"
    } ]
  }, {
    "tStartMs": 54940,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "실제로 월스트리트저널에 따르면 이런 내용이 나옵니다"
    } ]
  }, {
    "tStartMs": 57630,
    "dDurationMs": 4850,
    "segs": [ {
      "utf8": "IT 업계 남성들의 성형 수요가 지난 5년 동안 5배가 증가했다"
    } ]
  }, {
    "tStartMs": 62480,
    "dDurationMs": 4670,
    "segs": [ {
      "utf8": "쌍꺼풀 수술이 50%가 늘었고 안면 거상술이 25%가 늘었고"
    } ]
  }, {
    "tStartMs": 67150,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "작년 대비 크게 증가하고 있더라"
    } ]
  }, {
    "tStartMs": 70430,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "그런데 실리콘밸리에 있는 IT 업종에 종사하는 남성들이라면"
    } ]
  }, {
    "tStartMs": 75550,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "굉장히 잘 나가는 사람들이잖아요"
    } ]
  }, {
    "tStartMs": 77150,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "돈도 많이 벌고 부족할 게 없는데"
    } ]
  }, {
    "tStartMs": 79230,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "왜 갑자기 남성이, 여성도 아니고"
    } ]
  }, {
    "tStartMs": 80860,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "남성이 얼굴 성형에 붐이 있냐"
    } ]
  }, {
    "tStartMs": 83390,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "왜일까요?"
    } ]
  }, {
    "tStartMs": 84290,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "갑자기 서양 사람들이"
    } ]
  }, {
    "tStartMs": 85510,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "자기 얼굴에 불만을 느꼈을까요?"
    } ]
  }, {
    "tStartMs": 87410,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "이유가 뭐냐 하면"
    } ]
  }, {
    "tStartMs": 88490,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "음..."
    } ]
  }, {
    "tStartMs": 89800,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "좀 가슴 아픈 이유입니다"
    } ]
  }, {
    "tStartMs": 91600,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "경쟁이 치열한 취업시장에서"
    } ]
  }, {
    "tStartMs": 93670,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "특히 IT 시장에서"
    } ]
  }, {
    "tStartMs": 95680,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "젊은 외모를 유지해야 한다는 압박감이"
    } ]
  }, {
    "tStartMs": 98360,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "주요 원인으로 작용하고 있다"
    } ]
  }, {
    "tStartMs": 100710,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "아..."
    } ]
  }, {
    "tStartMs": 103200,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "그렇습니까?"
    } ]
  }, {
    "tStartMs": 103700,
    "dDurationMs": 4030,
    "segs": [ {
      "utf8": "취업시장에서 젊은 외모를 유지해야 되는 압박감이 있어요?"
    } ]
  }, {
    "tStartMs": 107730,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "이게 그럴 수밖에 없다고 그래요"
    } ]
  }, {
    "tStartMs": 109670,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "왜냐하면 방금 전에 뭐라고 했죠?"
    } ]
  }, {
    "tStartMs": 111060,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "실리콘밸리 IT 업계라고 했죠"
    } ]
  }, {
    "tStartMs": 113920,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "한 IT업계에 아주 유명한 사람인데"
    } ]
  }, {
    "tStartMs": 115890,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "이 임원의 인터뷰가"
    } ]
  }, {
    "tStartMs": 117110,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "이번에 월스트리트저널에 떴습니다"
    } ]
  }, {
    "tStartMs": 118910,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "이분이 이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 120540,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "IT업계는 젊은이들의 영역이다"
    } ]
  }, {
    "tStartMs": 123700,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "피터 틸은 자기한테 이렇게 얘기했대요"
    } ]
  }, {
    "tStartMs": 125660,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "30세 이상은 고용할 수 없다"
    } ]
  }, {
    "tStartMs": 128810,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "아유 배가 불러"
    } ]
  }, {
    "tStartMs": 130110,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "30세 이상을 고용하지"
    } ]
  }, {
    "tStartMs": 131300,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "우리나라는 평균 입사 연령이 30세가 넘어요"
    } ]
  }, {
    "tStartMs": 134070,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "평균 입사 연령이"
    } ]
  }, {
    "tStartMs": 135530,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "뭘 30세 이상을 고용하지"
    } ]
  }, {
    "tStartMs": 136750,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "아주 배가 그냥"
    } ]
  }, {
    "tStartMs": 138290,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "그렇다는 거고요"
    } ]
  }, {
    "tStartMs": 139090,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "다만 위에 있는 게 많이 와닿는 거죠"
    } ]
  }, {
    "tStartMs": 141140,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "IT업계는 젊은이들의 영역이다"
    } ]
  }, {
    "tStartMs": 143680,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "코딩하고 뭐하고"
    } ]
  }, {
    "tStartMs": 144490,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "실리콘밸리에 젊은 사람들이 너무 많다 보니까"
    } ]
  }, {
    "tStartMs": 146960,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "나이가 드는 얼굴"
    } ]
  }, {
    "tStartMs": 148790,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "자기가 나이가 들었다라는 게"
    } ]
  }, {
    "tStartMs": 151120,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "쓸모없는 사람처럼"
    } ]
  }, {
    "tStartMs": 152720,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "낙인이 찍히기 시작했다는 겁니다"
    } ]
  }, {
    "tStartMs": 154870,
    "dDurationMs": 4810,
    "segs": [ {
      "utf8": "예전보다 더 외모를 챙겨야 되는 분위기가 흐르게 됐다"
    } ]
  }, {
    "tStartMs": 159680,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "예전보다 더 어려보여야 됐다"
    } ]
  }, {
    "tStartMs": 161850,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "요번에 들어온 나랑 같이 일할 친구들을 보니까 32살이야"
    } ]
  }, {
    "tStartMs": 165250,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "어?"
    } ]
  }, {
    "tStartMs": 166630,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "나는 하고 거울을 보니까 42살이네"
    } ]
  }, {
    "tStartMs": 170500,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "뭐 이렇게 보인다는 거죠"
    } ]
  }, {
    "tStartMs": 171710,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "그러니까 이 나이가 들어 보이면"
    } ]
  }, {
    "tStartMs": 175020,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "쓸모없는 사람처럼 보이지 않을까"
    } ]
  }, {
    "tStartMs": 176620,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "이 마음속에 걱정이 있다는 거고요"
    } ]
  }, {
    "tStartMs": 178420,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "실제로 실리콘밸리에서 일하는"
    } ]
  }, {
    "tStartMs": 180670,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "조금 나이가 있는 분들이"
    } ]
  }, {
    "tStartMs": 182220,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "나이가 드는 것이 이제 고민이라고 합니다"
    } ]
  }, {
    "tStartMs": 185820,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "이렇게 나이가 들면"
    } ]
  }, {
    "tStartMs": 186510,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "난 뒤처지는 거 아닌가?"
    } ]
  }, {
    "tStartMs": 188020,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "회사에서 다른 사람들하고 어울리지 못하지 않을까?"
    } ]
  }, {
    "tStartMs": 190090,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "윗사람이 나를 쓸모없는 사람으로 보지 않을까?"
    } ]
  }, {
    "tStartMs": 192930,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "이런 고민이 생긴다는 거죠"
    } ]
  }, {
    "tStartMs": 194500,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "그러다 보니까 그런 고민을 해결해주는 방법으로"
    } ]
  }, {
    "tStartMs": 197020,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "미용 시술을 받고 있다는 건데"
    } ]
  }, {
    "tStartMs": 199180,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "게다가 여러분 생각해보면"
    } ]
  }, {
    "tStartMs": 201240,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "옛날에는 특히 남자들은 거울을 볼 일이 잘 없었습니다"
    } ]
  }, {
    "tStartMs": 205460,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "아침에나 보지"
    } ]
  }, {
    "tStartMs": 206430,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "아침에 세수할 때나 잠깐 보지"
    } ]
  }, {
    "tStartMs": 208580,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "거울을 언제 봐요?"
    } ]
  }, {
    "tStartMs": 209680,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "자기 얼굴을 잘 몰라"
    } ]
  }, {
    "tStartMs": 211620,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "제가 방송 일 처음 시작한 게 거의 10년 전인데"
    } ]
  }, {
    "tStartMs": 214230,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "그때 깨달은 게 있어요"
    } ]
  }, {
    "tStartMs": 215660,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "사람들은 자기 얼굴을 잘 모른다"
    } ]
  }, {
    "tStartMs": 217630,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "제가 어렸을 때는 심지어 스마트폰도 없었어요"
    } ]
  }, {
    "tStartMs": 220820,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "그 뭡니까?"
    } ]
  }, {
    "tStartMs": 221430,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "그 디카"
    } ]
  }, {
    "tStartMs": 222600,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "디카 시절도 한 25년 전이고"
    } ]
  }, {
    "tStartMs": 225060,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "더 어렸을 때는 필름"
    } ]
  }, {
    "tStartMs": 227080,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "아버지 필름 카메라 있습니다"
    } ]
  }, {
    "tStartMs": 228630,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "그 딱 둔 다음에"
    } ]
  }, {
    "tStartMs": 229800,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "도로록 도로록 하는 거"
    } ]
  }, {
    "tStartMs": 230850,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "아 이거 또 말씀을 드려야 되나?"
    } ]
  }, {
    "tStartMs": 232680,
    "dDurationMs": 3830,
    "segs": [ {
      "utf8": "이렇게 필름 이렇게 코닥 뭐 이런 거에서 도로록 도로록"
    } ]
  }, {
    "tStartMs": 236510,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "이거를 이렇게 앞에 넣어서 덜덜덜덜 감으면"
    } ]
  }, {
    "tStartMs": 239520,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "필름이 쏘옥 들어갑니다 여기로"
    } ]
  }, {
    "tStartMs": 242570,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "자기 얼굴을 볼 그게 별로 없었어요"
    } ]
  }, {
    "tStartMs": 244900,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "디카 시절에도 말이 디카지"
    } ]
  }, {
    "tStartMs": 247200,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "맨날 보지 않았단 말이엥"
    } ]
  }, {
    "tStartMs": 248610,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "그나마 스마트폰 시절부터 점점점점 사진이 늘어났는데"
    } ]
  }, {
    "tStartMs": 251390,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "요즘엔 더 늘어난다는 겁니다"
    } ]
  }, {
    "tStartMs": 253810,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "자기를 더 많이 보게 됐다"
    } ]
  }, {
    "tStartMs": 255670,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "과거에는 내 얼굴을 그렇게 오래 볼 일이 없었다"
    } ]
  }, {
    "tStartMs": 258820,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "그래서 방송 처음 한 사람들이"
    } ]
  }, {
    "tStartMs": 260750,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "항상 영상에 자기 얼굴이 나오면"
    } ]
  }, {
    "tStartMs": 263350,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "뭐라고 얘기하냐?"
    } ]
  }, {
    "tStartMs": 264300,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "이렇게 얘기합니다"
    } ]
  }, {
    "tStartMs": 265380,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "어? 내 얼굴이 뭔가 이상한데?"
    } ]
  }, {
    "tStartMs": 268370,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "어? 내 얼굴이 뭔가 다르게 나왔는데?"
    } ]
  }, {
    "tStartMs": 270370,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "제가 분명히 말씀드리는데"
    } ]
  }, {
    "tStartMs": 271890,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "다르게 나온 게 아니라"
    } ]
  }, {
    "tStartMs": 273190,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "여러분들의 머릿속에 있는 여러분들의 얼굴이 잘못된 거예요"
    } ]
  }, {
    "tStartMs": 277890,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "저도 그래요"
    } ]
  }, {
    "tStartMs": 278970,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "무슨 소리냐?"
    } ]
  }, {
    "tStartMs": 279880,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "여러분들의 머릿속에 있는"
    } ]
  }, {
    "tStartMs": 281220,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "내 얼굴은 약간 젊고"
    } ]
  }, {
    "tStartMs": 283680,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "약간 이상적인 모습으로 고정이 돼 있어요 신기하죠?"
    } ]
  }, {
    "tStartMs": 287620,
    "dDurationMs": 650,
    "segs": [ {
      "utf8": "신기하죠?"
    } ]
  }, {
    "tStartMs": 288270,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "진짜 그래"
    } ]
  }, {
    "tStartMs": 289200,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "특히 막 KBS, MBC"
    } ]
  }, {
    "tStartMs": 291100,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "이런 채널에 나가면 딱 보면"
    } ]
  }, {
    "tStartMs": 292660,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "보통 거의 90% 그래요"
    } ]
  }, {
    "tStartMs": 293800,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "처음 나온 사람은 뭐야?"
    } ]
  }, {
    "tStartMs": 294490,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "왜 이렇게 못 나왔어?"
    } ]
  }, {
    "tStartMs": 295690,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "못 나온 게 아니라"
    } ]
  }, {
    "tStartMs": 296970,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "그게 실제 얼굴인데"
    } ]
  }, {
    "tStartMs": 298300,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "자기 얼굴을 그렇게 오래 들여다볼 일이 없으니까"
    } ]
  }, {
    "tStartMs": 300650,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "내 머릿속에 있는 내 얼굴은"
    } ]
  }, {
    "tStartMs": 302090,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "좀 이상적인 모습으로 고정이 돼 있습니다"
    } ]
  }, {
    "tStartMs": 304510,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "가장 잘 나온 사진에서 봤던 내 얼굴이야"
    } ]
  }, {
    "tStartMs": 308110,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "예를 들면 가장 이런 거"
    } ]
  }, {
    "tStartMs": 309300,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "보통 사람들은 얼굴이 대칭이 아니에요"
    } ]
  }, {
    "tStartMs": 311370,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "약간 비대칭이거든?"
    } ]
  }, {
    "tStartMs": 312640,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "근데 처음 보면은 뭐야?"
    } ]
  }, {
    "tStartMs": 314200,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "내 얼굴이 왜 비대칭이야?"
    } ]
  }, {
    "tStartMs": 315330,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "이런 말 합니다"
    } ]
  }, {
    "tStartMs": 316540,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "저희 직원들"
    } ]
  }, {
    "tStartMs": 317650,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "제가 슈카친구들이잖아요"
    } ]
  }, {
    "tStartMs": 318790,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "직원들 처음에 이런 유튜버든"
    } ]
  }, {
    "tStartMs": 320570,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "이런 영상에 제가 데려와서 많이 데뷔를 시켰는데"
    } ]
  }, {
    "tStartMs": 323210,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "그 친구들이 딱 영상을 보자마자 하는 말이"
    } ]
  }, {
    "tStartMs": 324930,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "거의 90%가 그 말이에요"
    } ]
  }, {
    "tStartMs": 327350,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "내 얼굴이 이상해요"
    } ]
  }, {
    "tStartMs": 328060,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "아 이상한 게 아니야"
    } ]
  }, {
    "tStartMs": 328960,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "이상한 게 아니야"
    } ]
  }, {
    "tStartMs": 330080,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "네 얼굴이 이상한 게 아니라"
    } ]
  }, {
    "tStartMs": 331490,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "네 머릿속에 있는"
    } ]
  }, {
    "tStartMs": 332490,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "네 이미지가 이상한 거야"
    } ]
  }, {
    "tStartMs": 334270,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "넌 원래 그렇게 생겼어"
    } ]
  }, {
    "tStartMs": 335850,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "네가 그렇게 안 생각할 뿐이지"
    } ]
  }, {
    "tStartMs": 337670,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "원래 다 그래"
    } ]
  }, {
    "tStartMs": 338490,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "우리는 다 그렇기 때문에"
    } ]
  }, {
    "tStartMs": 339820,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "특히 남성들이 이게 심합니다"
    } ]
  }, {
    "tStartMs": 342060,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "자기 얼굴을 자세하게 오래 볼 일이 없었어요"
    } ]
  }, {
    "tStartMs": 344820,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "진짜 그렇습니다"
    } ]
  }, {
    "tStartMs": 345680,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "데려와서 얘기하면"
    } ]
  }, {
    "tStartMs": 346420,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "다 그 얘기를 해요"
    } ]
  }, {
    "tStartMs": 347420,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "여성분들도 다 이런 얘기를 해"
    } ]
  }, {
    "tStartMs": 348820,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "저희 직원 니모 양도 이런 얘기를 했고"
    } ]
  }, {
    "tStartMs": 351040,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "뭔가 편집 이상한 것 같다"
    } ]
  }, {
    "tStartMs": 353080,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "이런 얘기를 하는데 아니에요"
    } ]
  }, {
    "tStartMs": 353850,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "편집은 죄가 없어요"
    } ]
  }, {
    "tStartMs": 355120,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "카메라는 죄가 없다"
    } ]
  }, {
    "tStartMs": 356330,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "카메라 왜곡 얘기하던데 아니야"
    } ]
  }, {
    "tStartMs": 357860,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "그 정도 왜곡 아니야"
    } ]
  }, {
    "tStartMs": 358800,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "그게 아니라"
    } ]
  }, {
    "tStartMs": 359800,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "여러분들의 머릿속에"
    } ]
  }, {
    "tStartMs": 360540,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "너무 이상적인 모습이 있어서 그렇다는 거죠"
    } ]
  }, {
    "tStartMs": 363670,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "사람의 얼굴은 매일 바뀌는데"
    } ]
  }, {
    "tStartMs": 365420,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "매일 조금씩 바뀌는 거예요"
    } ]
  }, {
    "tStartMs": 367120,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "2년, 3년 마다 얼굴이 바뀌는데"
    } ]
  }, {
    "tStartMs": 368810,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "자기는 아직도 22살"
    } ]
  }, {
    "tStartMs": 370260,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "21살 아니면 가장 잘 나온 사진"
    } ]
  }, {
    "tStartMs": 372260,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "아니면 심지어 뽀샵 처리한 게"
    } ]
  }, {
    "tStartMs": 374190,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "나라고 생각하는 분들이 있어요"
    } ]
  }, {
    "tStartMs": 376030,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "이렇게 예쁘게 만들어서"
    } ]
  }, {
    "tStartMs": 376970,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "그렇기 때문에 요즘 어떻게 됩니까?"
    } ]
  }, {
    "tStartMs": 380100,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "SNS도 SNS인데"
    } ]
  }, {
    "tStartMs": 381330,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "화상회의도 많이 해요"
    } ]
  }, {
    "tStartMs": 383000,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "줌 화면으로 화상회의를 계속 켜놓고 있는 경우도 많습니다"
    } ]
  }, {
    "tStartMs": 385860,
    "dDurationMs": 3410,
    "segs": [ {
      "utf8": "자기도 모르게 자기 얼굴을 계속 보게 돼"
    } ]
  }, {
    "tStartMs": 389270,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "근데 옆에 뜨는 사람들은 다 젊어"
    } ]
  }, {
    "tStartMs": 391770,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "여기 다 젊네"
    } ]
  }, {
    "tStartMs": 392780,
    "dDurationMs": 6090,
    "segs": [ {
      "utf8": "28, 31, 27, 26, 새로 들어온 팀장이라는데 33"
    } ]
  }, {
    "tStartMs": 398870,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "어머!"
    } ]
  }, {
    "tStartMs": 400010,
    "dDurationMs": 3610,
    "segs": [ {
      "utf8": "라는 고민이 실리콘밸리에서 급증하고 있다는 겁니다"
    } ]
  }, {
    "tStartMs": 403620,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "특히 남자들을 대상으로"
    } ]
  }, {
    "tStartMs": 405790,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "IT 개발자들은 남성들이 되게 많으니까"
    } ]
  }, {
    "tStartMs": 407970,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "여성들은 평상시에 꾸미니까 꾸미고 하는 게 있었는데"
    } ]
  }, {
    "tStartMs": 410970,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "하나도 안 꾸미고 그러다가 이제 보니까"
    } ]
  }, {
    "tStartMs": 412860,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "약간 자신감도 떨어지고"
    } ]
  }, {
    "tStartMs": 414450,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "내가 좀 늙은 것 같고"
    } ]
  }, {
    "tStartMs": 416010,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "이거를 느낀다는 거죠"
    } ]
  }, {
    "tStartMs": 418080,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "그러다 보니까"
    } ]
  }, {
    "tStartMs": 419030,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "전반적인 수요 상승세가 촉발됐다는 거고요"
    } ]
  }, {
    "tStartMs": 421430,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "게다가 자기 외모에 대한 이걸 또 상승시키는 이유가 하나 있었는데"
    } ]
  }, {
    "tStartMs": 425670,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "그게 바로 체중 감량 물약의 등장입니다"
    } ]
  }, {
    "tStartMs": 428500,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "요즘에 나이살이 좀 붙은 것 같아"
    } ]
  }, {
    "tStartMs": 431620,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "살 좀 빼야겠어"
    } ]
  }, {
    "tStartMs": 432690,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "하고 체중 감량 물약을 먹어요"
    } ]
  }, {
    "tStartMs": 434400,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "오젬픽을 먹건 위고비를 먹건 하면서"
    } ]
  }, {
    "tStartMs": 436390,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "살이 빠져"
    } ]
  }, {
    "tStartMs": 437440,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "그래서 성형수술이 늘고 있다는 건데"
    } ]
  }, {
    "tStartMs": 439220,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "살이 빠지면 왜 성형수술이 늘겠습니까?"
    } ]
  }, {
    "tStartMs": 442370,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "이유는 두 개가 있어요"
    } ]
  }, {
    "tStartMs": 443460,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "첫 번째"
    } ]
  }, {
    "tStartMs": 444670,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "과거의 몸매로 돌아오면서"
    } ]
  }, {
    "tStartMs": 447810,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "얼굴만 안 돌아왔단 말이에요"
    } ]
  }, {
    "tStartMs": 449990,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "어, 몸매가 좀 과거의 몸매로 가"
    } ]
  }, {
    "tStartMs": 452480,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "근데 외모는 아니란 말이야"
    } ]
  }, {
    "tStartMs": 455360,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "그러다 보니까 얼굴만 어떻게 하면 좀 되겠는데?"
    } ]
  }, {
    "tStartMs": 458300,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "이런 생각을 하는 거죠"
    } ]
  }, {
    "tStartMs": 459580,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "다른 건 바뀌었는데"
    } ]
  }, {
    "tStartMs": 460430,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "이게 안 바뀌니까"
    } ]
  }, {
    "tStartMs": 461770,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "얼굴도 좀 바꿔볼까?"
    } ]
  }, {
    "tStartMs": 463340,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "이런 생각을 하게 되고"
    } ]
  }, {
    "tStartMs": 465700,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "오른쪽에 있는 사진"
    } ]
  }, {
    "tStartMs": 467250,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "어저께 찍은 제 사진이라고 보면 됩니다"
    } ]
  }, {
    "tStartMs": 469070,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "이거 어저께 찍었는데"
    } ]
  }, {
    "tStartMs": 469870,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "잘 안 나왔네"
    } ]
  }, {
    "tStartMs": 471420,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "조금 대피에 신경을 쓰다 보니까"
    } ]
  }, {
    "tStartMs": 473410,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "볼륨이 좀 적은데"
    } ]
  }, {
    "tStartMs": 474690,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "나중에 볼륨을 올린 사진으로"
    } ]
  }, {
    "tStartMs": 476520,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "다시 한번 올리도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 477820,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "게다가 체중 감량 약물을 먹잖아요"
    } ]
  }, {
    "tStartMs": 480640,
    "dDurationMs": 550,
    "segs": [ {
      "utf8": "나이가 들어서"
    } ]
  }, {
    "tStartMs": 481190,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "어떻게 되는지 아십니까?"
    } ]
  }, {
    "tStartMs": 483230,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "살이 많이 찐 분들은"
    } ]
  }, {
    "tStartMs": 484180,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "적게 찐 분들은 상관없는데"
    } ]
  }, {
    "tStartMs": 485890,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "피부가 처집니다"
    } ]
  }, {
    "tStartMs": 487870,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "급격하게 체중 감량을 하면"
    } ]
  }, {
    "tStartMs": 489660,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "피부가 처져요"
    } ]
  }, {
    "tStartMs": 491200,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "근데 뭐 배가 처지거나"
    } ]
  }, {
    "tStartMs": 492460,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "이런 건 어떻게 옷으로 되는데"
    } ]
  }, {
    "tStartMs": 494290,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "얼굴에 처지면 어떡해"
    } ]
  }, {
    "tStartMs": 496390,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "그래서 옛날에는 나이 들어 살 빼면 늙어 보인다"
    } ]
  }, {
    "tStartMs": 498750,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "이런 말을 많이 했어요"
    } ]
  }, {
    "tStartMs": 500040,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "그래서 제가 살을 안 빼"
    } ]
  }, {
    "tStartMs": 501570,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "뺄 수 있는데"
    } ]
  }, {
    "tStartMs": 502750,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "그래서 안 빼는 겁니다"
    } ]
  }, {
    "tStartMs": 504670,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "그래서 뚱카라고 누가 놀리던데"
    } ]
  }, {
    "tStartMs": 506930,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "에헤이 그게 아니라 그쵸?"
    } ]
  }, {
    "tStartMs": 509470,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "어쩔 수 없이 뺄 수 있음에도 불구하고"
    } ]
  }, {
    "tStartMs": 512700,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "처짐 이런 것 때문에"
    } ]
  }, {
    "tStartMs": 513730,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "이제 안 빼는 거라고 할 수 있어요"
    } ]
  }, {
    "tStartMs": 515700,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "약물을 먹어서 빼거나 하다 보니까"
    } ]
  }, {
    "tStartMs": 517590,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "피부가 처지게 느끼는 거죠"
    } ]
  }, {
    "tStartMs": 519140,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "팔자주름 이런 거 느끼고 자기가"
    } ]
  }, {
    "tStartMs": 521510,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "그래서 성형을 찾는 사람들이 늘어난다는 거죠"
    } ]
  }, {
    "tStartMs": 524380,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "그래서 요즘에 이런 표현을 씁니다"
    } ]
  }, {
    "tStartMs": 526220,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "IT 실리콘밸리에서도 테크 오빠룩에"
    } ]
  }, {
    "tStartMs": 529520,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "테크 오빠룩도 있습니까?"
    } ]
  }, {
    "tStartMs": 531520,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "테크 브로룩입니다"
    } ]
  }, {
    "tStartMs": 532780,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "ㅎㅎㅎㅎ"
    } ]
  }, {
    "tStartMs": 534400,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "새롭게 추가된 브랜드가 있으니"
    } ]
  }, {
    "tStartMs": 536370,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "보통은 옛날에는 이렇게 다녔는데"
    } ]
  }, {
    "tStartMs": 538370,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "아주 옛날에 15년 20년 전에"
    } ]
  }, {
    "tStartMs": 540660,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "이게 옛날에 테크 오빠룩이거든요"
    } ]
  }, {
    "tStartMs": 542400,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "새롭게 얼굴이라는 룩이 추가됐다"
    } ]
  }, {
    "tStartMs": 545720,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "아 쉽지 않은데"
    } ]
  }, {
    "tStartMs": 546830,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "모든 룩 중에 가장 어려운 룩이 하나 추가됐다는 거죠"
    } ]
  }, {
    "tStartMs": 550430,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "아 이거 쉽지 않습니다"
    } ]
  }, {
    "tStartMs": 552080,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "결론적으로 저 실리콘밸리의 테크 오빠들이"
    } ]
  }, {
    "tStartMs": 554900,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "이제는 자기 능력도 능력인데"
    } ]
  }, {
    "tStartMs": 556410,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "외모 경쟁력까지 어쩔 수 없이"
    } ]
  }, {
    "tStartMs": 558950,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "신경을 쓰기 시작했다"
    } ]
  }, {
    "tStartMs": 560220,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "IT 업계 남성들이"
    } ]
  }, {
    "tStartMs": 561180,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "아 내가 나이 들면서"
    } ]
  }, {
    "tStartMs": 562270,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "이 바닥에서 점점 쓸모없어진다는 불안감을 극복하기 위해서"
    } ]
  }, {
    "tStartMs": 565430,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "나도 다른 사람들처럼"
    } ]
  }, {
    "tStartMs": 566860,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "트렌드를 굉장히 빨리 얼리 어덥터고"
    } ]
  }, {
    "tStartMs": 569230,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "남들보다 잘할 수 있고"
    } ]
  }, {
    "tStartMs": 570250,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "이런 거를 이제는 젊어 보이는 외모까지 어필해야 되기 때문에"
    } ]
  }, {
    "tStartMs": 573700,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "안면, 목, 눈꺼풀"
    } ]
  }, {
    "tStartMs": 575650,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "이렇게 보이는데"
    } ]
  }, {
    "tStartMs": 576340,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "특히 줌으로 보이는데"
    } ]
  }, {
    "tStartMs": 578300,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "가서 사람 만나면 얼굴이 보이는"
    } ]
  }, {
    "tStartMs": 580580,
    "dDurationMs": 3830,
    "segs": [ {
      "utf8": "이런 안면 쪽 성형에 투자를 하기 시작했다는 거죠"
    } ]
  }, {
    "tStartMs": 584410,
    "dDurationMs": 3890,
    "segs": [ {
      "utf8": "그리고 역시 사람을 가장 많이 만나는 직종의 남성들에게서"
    } ]
  }, {
    "tStartMs": 588300,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "더 크게 증가하고 있다고 합니다"
    } ]
  }, {
    "tStartMs": 589720,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "예를 들면 벤처 캐피탈, VC도"
    } ]
  }, {
    "tStartMs": 592010,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "왜냐하면 투자하려면 투자들을 만나야 되죠"
    } ]
  }, {
    "tStartMs": 594050,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "사모펀도 마찬가지예요"
    } ]
  }, {
    "tStartMs": 595300,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "쩐주 만나야 되고"
    } ]
  }, {
    "tStartMs": 596650,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "업계 사람들 만나야 되고"
    } ]
  }, {
    "tStartMs": 598330,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "계속 이렇게 마케팅하거나"
    } ]
  }, {
    "tStartMs": 599980,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "회의를 많이 하는 직종에 있는 남성들일수록"
    } ]
  }, {
    "tStartMs": 602530,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "더욱더 안면 성형을 많이 하게 된다 그러고"
    } ]
  }, {
    "tStartMs": 605250,
    "dDurationMs": 3910,
    "segs": [ {
      "utf8": "게다가 실리콘밸리의 IT 기업 종사자들이면"
    } ]
  }, {
    "tStartMs": 609160,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "경제적으로 여유가 있습니다"
    } ]
  }, {
    "tStartMs": 610840,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "저기는 연봉 2, 3억이 기본인 데잖아요"
    } ]
  }, {
    "tStartMs": 613200,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "물론 물가도 그만큼 비싸지만"
    } ]
  }, {
    "tStartMs": 615110,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "연봉 3억 받는 사람들도"
    } ]
  }, {
    "tStartMs": 616630,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "컨테이너 박스에서 자는 게 실리콘밸리입니다"
    } ]
  }, {
    "tStartMs": 619720,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "제가 한번 가봤죠"
    } ]
  }, {
    "tStartMs": 620710,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "실리콘밸리에 갔는데"
    } ]
  }, {
    "tStartMs": 622180,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "그 돈 많다는 사람들이"
    } ]
  }, {
    "tStartMs": 623340,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "컨테이너 박스에서 자고 있어"
    } ]
  }, {
    "tStartMs": 625200,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "여러분들 행복한 겁니다"
    } ]
  }, {
    "tStartMs": 627060,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "진짜 농담이 아니라"
    } ]
  }, {
    "tStartMs": 628290,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "아침에 새벽에 이동하려고"
    } ]
  }, {
    "tStartMs": 629960,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "차를 타고 가는데"
    } ]
  }, {
    "tStartMs": 631060,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "컨테이너 박스 문이 드르륵 열리더니"
    } ]
  }, {
    "tStartMs": 633500,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "누가 칫솔 물고 이렇게 나와요"
    } ]
  }, {
    "tStartMs": 635300,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "저기 뭐야 노숙자들이에요 노숙자라니"
    } ]
  }, {
    "tStartMs": 638020,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "구글러입니다"
    } ]
  }, {
    "tStartMs": 639070,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "진짜 그랬어요 구글러라고"
    } ]
  }, {
    "tStartMs": 640500,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "저런 분들의 연봉이"
    } ]
  }, {
    "tStartMs": 642110,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "보통 더블 기준을 훌쩍 넘는다고"
    } ]
  }, {
    "tStartMs": 643980,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "오 저분이 한 연봉 4억이야?"
    } ]
  }, {
    "tStartMs": 645590,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "근데 드르륵 열리더니"
    } ]
  }, {
    "tStartMs": 647060,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "슬리퍼 질질 끌고"
    } ]
  }, {
    "tStartMs": 648720,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "저분은 샤워를 어디서 해요?"
    } ]
  }, {
    "tStartMs": 649720,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "제가 그것도 물어봤어요"
    } ]
  }, {
    "tStartMs": 651140,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "아니 저기 아무리 뭐 저 박스 집들이 좋다 그래도"
    } ]
  }, {
    "tStartMs": 654140,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "저 컨테이너 박스가 좋다 그래도"
    } ]
  }, {
    "tStartMs": 655810,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "샤워할 데는 없을 거 아니에요"
    } ]
  }, {
    "tStartMs": 657340,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "샤워는 어디서 합니까 그랬더니"
    } ]
  }, {
    "tStartMs": 658850,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "본사 가서 한대"
    } ]
  }, {
    "tStartMs": 660780,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "그러니까 구글러인데 샤워는? 했더니"
    } ]
  }, {
    "tStartMs": 663050,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "구글 본사에서 화장실에서 샤워한다 그러더라고요"
    } ]
  }, {
    "tStartMs": 666590,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "제가 구글 본사 내부까지는 안 들어가 봤는데"
    } ]
  }, {
    "tStartMs": 668510,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "샤워실이 있나 봅니다"
    } ]
  }, {
    "tStartMs": 670160,
    "dDurationMs": 3410,
    "segs": [ {
      "utf8": "거기 가서 샤워하는 삶을 산다라고 얘기를 했는데"
    } ]
  }, {
    "tStartMs": 673570,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "그럼에도 불구하고"
    } ]
  }, {
    "tStartMs": 674300,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "경제적으로 여유가 있는 남성들이죠"
    } ]
  }, {
    "tStartMs": 675980,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "그러다 보니까 비용 부담 없이 성형수술을 받는다는 건데"
    } ]
  }, {
    "tStartMs": 678880,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "실리콘밸리에서"
    } ]
  }, {
    "tStartMs": 680030,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "안면 리프팅 수술을 받는 비용이"
    } ]
  }, {
    "tStartMs": 682260,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "4만 달러에서 6만 5천 달러에 이른다"
    } ]
  }, {
    "tStartMs": 685890,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "6만 5천 달러"
    } ]
  }, {
    "tStartMs": 687330,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "1,500원 기준으로 1억이에요"
    } ]
  }, {
    "tStartMs": 689530,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "맞잖아 1억이잖아"
    } ]
  }, {
    "tStartMs": 690750,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "안면 리프팅 수술을 1억을 낸다고?"
    } ]
  }, {
    "tStartMs": 693380,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "물론 실리콘밸리라는 걸 생각하십시오"
    } ]
  }, {
    "tStartMs": 695080,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "미국의 실리콘밸리에서 그 비싼 미국의 성형수술을"
    } ]
  }, {
    "tStartMs": 699040,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "굉장히 좋은 데서 받겠죠"
    } ]
  }, {
    "tStartMs": 700700,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "그런다고 하더라도"
    } ]
  }, {
    "tStartMs": 701420,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "6,500만 원에서 1억 가까운 비용이 든다고 하고"
    } ]
  }, {
    "tStartMs": 704770,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "대신에 성형수술을 받기에"
    } ]
  }, {
    "tStartMs": 706160,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "또 유리한 점도 있대요"
    } ]
  }, {
    "tStartMs": 707330,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "이런 거"
    } ]
  }, {
    "tStartMs": 707970,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "하이브리드 근무 방식을 많이 하기 때문에"
    } ]
  }, {
    "tStartMs": 710080,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "회복 시간이 필요한 수술을 할 기회를 많이 얻을 수 있다"
    } ]
  }, {
    "tStartMs": 713600,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "재택근무가 많이 있다는 거죠"
    } ]
  }, {
    "tStartMs": 714800,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "줌으로 근무하거나"
    } ]
  }, {
    "tStartMs": 716010,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "음성으로만 참여하거나"
    } ]
  }, {
    "tStartMs": 717690,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "한 2, 3일이나 일주일 정도"
    } ]
  }, {
    "tStartMs": 719880,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "얼굴이 회복할 시간이 있어야 되는데"
    } ]
  }, {
    "tStartMs": 721840,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "그런 기회를 쉽게 받을 수 있다고 합니다"
    } ]
  }, {
    "tStartMs": 724100,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "그 내용을 보면 이렇게 나옵니다"
    } ]
  }, {
    "tStartMs": 725770,
    "dDurationMs": 3910,
    "segs": [ {
      "utf8": "실리콘밸리에서는 보톡스는 너무 흔해졌습니다"
    } ]
  }, {
    "tStartMs": 729680,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "보톡스처럼 비수술적인 시술은"
    } ]
  }, {
    "tStartMs": 732090,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "이제 실리콘밸리에서는 너무 흔해져서"
    } ]
  }, {
    "tStartMs": 733980,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "거의 구식처럼 느껴집니다"
    } ]
  }, {
    "tStartMs": 735970,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "이게 월스트리트저널 기사입니다"
    } ]
  }, {
    "tStartMs": 737690,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "이게 오래된 기사가 아니에요"
    } ]
  }, {
    "tStartMs": 739270,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "오... 아 그래요?"
    } ]
  }, {
    "tStartMs": 741300,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "이제는 보톡스가"
    } ]
  }, {
    "tStartMs": 742370,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "남성입니다 남성"
    } ]
  }, {
    "tStartMs": 743200,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "남성 기준으로 얘기하는 거예요"
    } ]
  }, {
    "tStartMs": 744540,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "이제는 구식이다"
    } ]
  }, {
    "tStartMs": 745910,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "왜 자신을 더 나아지게 하는 시술을 받지 않지?"
    } ]
  }, {
    "tStartMs": 748720,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "이런 의문을 가지게 된다는 건데"
    } ]
  }, {
    "tStartMs": 750600,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "그러면 보톡스 말고 뭘 합니까?"
    } ]
  }, {
    "tStartMs": 753410,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "30대는 일반적으로 보톡스나"
    } ]
  }, {
    "tStartMs": 755320,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "약간의 필러 같은 비수술적 시술로 만족을 하는데"
    } ]
  }, {
    "tStartMs": 758870,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "40대가 되면"
    } ]
  }, {
    "tStartMs": 760160,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "이제는 보톡스나 필러 말고"
    } ]
  }, {
    "tStartMs": 762400,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "수술적 시술을 받기 시작한다"
    } ]
  }, {
    "tStartMs": 764930,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "그러면서 예를 든 게"
    } ]
  }, {
    "tStartMs": 766270,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "미니 안면 거상술이에요"
    } ]
  }, {
    "tStartMs": 768550,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "미니 페이스 리프트"
    } ]
  }, {
    "tStartMs": 770620,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "미니 안면 거상술이 뭐냐?"
    } ]
  }, {
    "tStartMs": 772580,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "전 이번에 처음 들었는데"
    } ]
  }, {
    "tStartMs": 774560,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "저기 나온 게 뭐냐? 이겁니다"
    } ]
  }, {
    "tStartMs": 776510,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "이 주름이 많잖아요"
    } ]
  }, {
    "tStartMs": 777620,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "나이가 들면 팔자주름 생기고"
    } ]
  }, {
    "tStartMs": 779220,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "이렇게 피부가 처집니다"
    } ]
  }, {
    "tStartMs": 781120,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "점점점점 처져요"
    } ]
  }, {
    "tStartMs": 782390,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "온몸의 근육들이 다 팽팽함을 잃고"
    } ]
  }, {
    "tStartMs": 784540,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "처지기 시작하는데"
    } ]
  }, {
    "tStartMs": 785270,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "나이가 들면"
    } ]
  }, {
    "tStartMs": 786300,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "양쪽 귀 옆을 절개해서"
    } ]
  }, {
    "tStartMs": 789340,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "여기서 뭔가 이렇게 당겨주나 봐"
    } ]
  }, {
    "tStartMs": 791550,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "여기서 이렇게 됐잖아요"
    } ]
  }, {
    "tStartMs": 792520,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "이거를 땡겨서 주름 펴진 거 봐라 봤죠?"
    } ]
  }, {
    "tStartMs": 796260,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "이렇게 주름이 있는데"
    } ]
  }, {
    "tStartMs": 797250,
    "dDurationMs": 460,
    "segs": [ {
      "utf8": "이렇게 펴잖아"
    } ]
  }, {
    "tStartMs": 797710,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "그래서 양쪽 귀 옆을 절개해서"
    } ]
  }, {
    "tStartMs": 800710,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "얼굴을 팽팽하게 땡겨주면"
    } ]
  }, {
    "tStartMs": 803100,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "주름 개선 효과가 있다 그렇답니다"
    } ]
  }, {
    "tStartMs": 805770,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "이게 안면 거상술이라고 합니다"
    } ]
  }, {
    "tStartMs": 808070,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "저도 이번에 들었는데"
    } ]
  }, {
    "tStartMs": 809370,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "미니 안면 거상술은 뭐냐"
    } ]
  }, {
    "tStartMs": 811170,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "이 안면 거상술은"
    } ]
  }, {
    "tStartMs": 812770,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "비용도 많이 들고"
    } ]
  }, {
    "tStartMs": 813950,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "그리고 회복도 오래 걸리고"
    } ]
  }, {
    "tStartMs": 815790,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "그리고 너무 땡겨버리면"
    } ]
  }, {
    "tStartMs": 817440,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "쓸어낸 듯한 인상"
    } ]
  }, {
    "tStartMs": 819300,
    "dDurationMs": 3830,
    "segs": [ {
      "utf8": "너무 이렇게 뭔가 좀 인위적인 인상을 얻기 때문에"
    } ]
  }, {
    "tStartMs": 823130,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "요즘에는 미니 안면 거상술을 받는다고 그러는데"
    } ]
  }, {
    "tStartMs": 825950,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "실리콘밸리에서 그렇다고 합니다"
    } ]
  }, {
    "tStartMs": 827250,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "이게 뭔지 모르겠지만"
    } ]
  }, {
    "tStartMs": 828400,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "하여튼 그런 게 좀 더 인기라고 합니다"
    } ]
  }, {
    "tStartMs": 830680,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "빨리빨리 회복 바르고"
    } ]
  }, {
    "tStartMs": 832080,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "수술 받은 티도 적고 하니까"
    } ]
  }, {
    "tStartMs": 833710,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "15,000달러래요"
    } ]
  }, {
    "tStartMs": 834680,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "와"
    } ]
  }, {
    "tStartMs": 835520,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "2,250만원"
    } ]
  }, {
    "tStartMs": 837890,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "엄청납니다"
    } ]
  }, {
    "tStartMs": 839140,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "이런 얘기 하더라고요"
    } ]
  }, {
    "tStartMs": 840020,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "그런 안면 무슨 거상술 이런 거는"
    } ]
  }, {
    "tStartMs": 842180,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "예전에는 할아버지들이 하던 수술이었다"
    } ]
  }, {
    "tStartMs": 845160,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "미국 기준으로"
    } ]
  }, {
    "tStartMs": 846370,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "예전에는 60대나 70대가 되어서야"
    } ]
  }, {
    "tStartMs": 848880,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "그런 주름 펴는 수술 이런 걸 받았는데"
    } ]
  }, {
    "tStartMs": 851230,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "이제는 경쟁을 해야 되고"
    } ]
  }, {
    "tStartMs": 853200,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "젊어 보여야 된다는 압박감이 있으니까"
    } ]
  }, {
    "tStartMs": 855410,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "40대와 50대 남성들이"
    } ]
  }, {
    "tStartMs": 857270,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "저런 수술을 받아서"
    } ]
  }, {
    "tStartMs": 857950,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "문제를 해결하려고 한다"
    } ]
  }, {
    "tStartMs": 859560,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "나중에 보다 지금 미리 관리하는 거다라고 얘기를 하는데"
    } ]
  }, {
    "tStartMs": 862610,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "그만큼 굉장히 치열해졌다는 거죠"
    } ]
  }, {
    "tStartMs": 864900,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "제가 한번 실험을 해봤습니다"
    } ]
  }, {
    "tStartMs": 868160,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "무슨 안면 거상술을 받을 시간은 없고"
    } ]
  }, {
    "tStartMs": 870680,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "왼쪽이 제 어저께 사진이고요"
    } ]
  }, {
    "tStartMs": 873050,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "좀 땡겨봤어요"
    } ]
  }, {
    "tStartMs": 874340,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "땡겨봤는데 뭐 똑같은데?"
    } ]
  }, {
    "tStartMs": 876900,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "땡겨봤는데 ㅎㅎ"
    } ]
  }, {
    "tStartMs": 878460,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "귀 뒤를 어디를 절개해서 땡겨봤는데"
    } ]
  }, {
    "tStartMs": 881420,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "뭐 약간 주름이 없어진 정도? 약간?"
    } ]
  }, {
    "tStartMs": 884510,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "뭐 별로 뭐 약간 주름이 없어진 거 말고는"
    } ]
  }, {
    "tStartMs": 887190,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "거의 똑같았기 때문에"
    } ]
  }, {
    "tStartMs": 888940,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "제 머릿속에 제 모습은 이렇거든요"
    } ]
  }, {
    "tStartMs": 891180,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "물론 여러분들이 보는 모습은 이거죠"
    } ]
  }, {
    "tStartMs": 893060,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "아 이거는 메타버스예요"
    } ]
  }, {
    "tStartMs": 894630,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "이건 없는 얼굴이야"
    } ]
  }, {
    "tStartMs": 895610,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "이건 실제가 아닙니다"
    } ]
  }, {
    "tStartMs": 896700,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "실제는 이거예요"
    } ]
  }, {
    "tStartMs": 898750,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "실제 정의가 뭐야?"
    } ]
  }, {
    "tStartMs": 899950,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "여러분들이 보는 거는"
    } ]
  }, {
    "tStartMs": 901120,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "여러분들 머릿속에 데이터 쪼가릴 수가 있어요"
    } ]
  }, {
    "tStartMs": 903260,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "제 머릿속에 있는 데이터 쪼가리는 이겁니다"
    } ]
  }, {
    "tStartMs": 905660,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "그래서 앞으론 이거를 실제라고 하겠습니다"
    } ]
  }, {
    "tStartMs": 908120,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "좋습니다 좋아요"
    } ]
  }, {
    "tStartMs": 909560,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "각자의 세계가 있는 거지"
    } ]
  }, {
    "tStartMs": 911120,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "내 세계에서는 이게 실제이기 때문에"
    } ]
  }, {
    "tStartMs": 913270,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "거의 똑같은 모습이 아닐까 생각을 합니다"
    } ]
  }, {
    "tStartMs": 916030,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "그리고 남자들은 성형수술을 받을 때 특징이 있다 그럽니다"
    } ]
  }, {
    "tStartMs": 919120,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "뭘까요?"
    } ]
  }, {
    "tStartMs": 920120,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "제가 이거 듣고 너무나 공감했어"
    } ]
  }, {
    "tStartMs": 922250,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "남자들은 여성들과 다르게"
    } ]
  }, {
    "tStartMs": 924590,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "여성들도 약간 있지만"
    } ]
  }, {
    "tStartMs": 925760,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "굉장히 하나의 특징이 있다"
    } ]
  }, {
    "tStartMs": 926870,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "그건 바로 이겁니다"
    } ]
  }, {
    "tStartMs": 927830,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "남자들은 무조건 자연스럽고 티나지 않는 결과를 원한다"
    } ]
  }, {
    "tStartMs": 931460,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "왜?"
    } ]
  }, {
    "tStartMs": 932290,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "남자들은 여성들보다 시술을 받았다"
    } ]
  }, {
    "tStartMs": 935150,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "시술에 대해 이야기하는 걸 훨씬 더 꺼립니다"
    } ]
  }, {
    "tStartMs": 938780,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "이건 안 되지"
    } ]
  }, {
    "tStartMs": 941030,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "여성들끼리는 어머 언니 뭐 땡겼어?"
    } ]
  }, {
    "tStartMs": 943730,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "뭐 했어? 이거 했어 되는데"
    } ]
  }, {
    "tStartMs": 945040,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "남자들끼리는 어머 부장님 좀 깎으셨네요"
    } ]
  }, {
    "tStartMs": 947810,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "이런 얘기하면 사람들 많을 때 조심하십시오"
    } ]
  }, {
    "tStartMs": 951790,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "조심하십시오"
    } ]
  }, {
    "tStartMs": 952820,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "함부로 얘기하면 안 돼"
    } ]
  }, {
    "tStartMs": 954470,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "이게 남자들은"
    } ]
  }, {
    "tStartMs": 955800,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "에이 내가 뭐 그런 걸 왜 받아?"
    } ]
  }, {
    "tStartMs": 958020,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "나는 그런 거 안 받아도 돼"
    } ]
  }, {
    "tStartMs": 959300,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "아직 충분해"
    } ]
  }, {
    "tStartMs": 960550,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "이런 게 보통 남자들이에요"
    } ]
  }, {
    "tStartMs": 961840,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "이런 게 보통 남자들이기 때문에"
    } ]
  }, {
    "tStartMs": 963420,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "어머 부장님 좀 땡기셨네요"
    } ]
  }, {
    "tStartMs": 965170,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "이제 그러면 회식 자리에서 싸늘해질 수 있습니다"
    } ]
  }, {
    "tStartMs": 968890,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "그 다음에 승진하거나"
    } ]
  }, {
    "tStartMs": 970340,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "아주 치명적인 문제를 갖고 올 수 있기 때문에"
    } ]
  }, {
    "tStartMs": 972790,
    "dDurationMs": 670,
    "segs": [ {
      "utf8": "이걸 유의하셔야 돼요"
    } ]
  }, {
    "tStartMs": 973460,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "남성들은 받았다는 걸 얘기하는 걸"
    } ]
  }, {
    "tStartMs": 975450,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "훨씬 더 꺼린다"
    } ]
  }, {
    "tStartMs": 976560,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "그리고 부장님이 눈꺼풀 수술할 때도"
    } ]
  }, {
    "tStartMs": 979010,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "나는 미용때문에 하는게 아니라"
    } ]
  }, {
    "tStartMs": 981630,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "눈이 찔러서 찔러서"
    } ]
  }, {
    "tStartMs": 982760,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "야 무슨 안검하수인지 뭔지"
    } ]
  }, {
    "tStartMs": 984240,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "이렇게 눈이 찔러서 받는 거지"
    } ]
  }, {
    "tStartMs": 985870,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "그거 미용때문에 하는게 아니야"
    } ]
  }, {
    "tStartMs": 986950,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "우리 대부분 그렇게 얘기하는데"
    } ]
  }, {
    "tStartMs": 989160,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "글로벌 비슷하기 때문에"
    } ]
  }, {
    "tStartMs": 991030,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "그래서 예전에는 주로 한국인들"
    } ]
  }, {
    "tStartMs": 992980,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "아시아 사람들이 많이 받은 눈꺼풀 거상술"
    } ]
  }, {
    "tStartMs": 996130,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "거상이 이렇게 들어올린다는 뜻이겠죠"
    } ]
  }, {
    "tStartMs": 998480,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "이거를 기술 분야에 종사하는"
    } ]
  }, {
    "tStartMs": 1000490,
    "dDurationMs": 3770,
    "segs": [ {
      "utf8": "미국 실리콘밸리 남성들이 많이 받는다는 겁니다"
    } ]
  }, {
    "tStartMs": 1004260,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "이런 눈꺼풀 수술까지"
    } ]
  }, {
    "tStartMs": 1006020,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "저거는 또 왜"
    } ]
  }, {
    "tStartMs": 1007650,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "눈꺼풀 거상 수술"
    } ]
  }, {
    "tStartMs": 1008700,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "이거는 서양인들은 쌍꺼풀 있는데"
    } ]
  }, {
    "tStartMs": 1010680,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "받을 필요가 없지 않나요?"
    } ]
  }, {
    "tStartMs": 1011910,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "쌍꺼풀 수술과 비슷하지만"
    } ]
  }, {
    "tStartMs": 1013450,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "다른 수술이라고 합니다"
    } ]
  }, {
    "tStartMs": 1014780,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "나이가 들면"
    } ]
  }, {
    "tStartMs": 1015970,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "윗눈꺼풀이 이렇게 처져"
    } ]
  }, {
    "tStartMs": 1017890,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "그리고 여기 이렇게 볼록한 부분이 생깁니다"
    } ]
  }, {
    "tStartMs": 1020500,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "그거를 이렇게 들어 올려서 젊게 보이고"
    } ]
  }, {
    "tStartMs": 1023000,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "이 볼록한 부분도 제거해서"
    } ]
  }, {
    "tStartMs": 1024900,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "교정을 해서"
    } ]
  }, {
    "tStartMs": 1025960,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "약간 젊게 보이는 그런 수술이라고 합니다"
    } ]
  }, {
    "tStartMs": 1028980,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "이 수술도"
    } ]
  }, {
    "tStartMs": 1030110,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "이거 하다 보니까 광고 같네요"
    } ]
  }, {
    "tStartMs": 1031090,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "광고 아니고요"
    } ]
  }, {
    "tStartMs": 1031820,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "광고 아니고요"
    } ]
  }, {
    "tStartMs": 1033180,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "50대 분들이 요즘 실리콘밸리에서 많이 받는다는 거죠"
    } ]
  }, {
    "tStartMs": 1036320,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "그래서 저는 이제 50대가 아니지만"
    } ]
  }, {
    "tStartMs": 1038430,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "훨씬 젊지만"
    } ]
  }, {
    "tStartMs": 1039350,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "한 번 더 해봤습니다"
    } ]
  }, {
    "tStartMs": 1041180,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "쳤어요"
    } ]
  }, {
    "tStartMs": 1042270,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "왼쪽의 사진을"
    } ]
  }, {
    "tStartMs": 1043300,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "'안면 무슨 거상술을 해줘봐' 해서"
    } ]
  }, {
    "tStartMs": 1045930,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "오른쪽으로 바뀌었는데"
    } ]
  }, {
    "tStartMs": 1048790,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "이게 좀 더 피곤해지고"
    } ]
  }, {
    "tStartMs": 1050640,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "왜 좀 더 피곤해졌는데?"
    } ]
  }, {
    "tStartMs": 1053000,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "인상 강해지긴 했다"
    } ]
  }, {
    "tStartMs": 1054360,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "어머 강해 보여"
    } ]
  }, {
    "tStartMs": 1056610,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "어느날 제가 한 일주일 정도 안 보이면"
    } ]
  }, {
    "tStartMs": 1059350,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "눈꺼풀 거상술"
    } ]
  }, {
    "tStartMs": 1060600,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "그거 받으러 간 줄 아십시오"
    } ]
  }, {
    "tStartMs": 1062410,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "나쁘지 않아x2"
    } ]
  }, {
    "tStartMs": 1063300,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "이렇게 된다는 거죠"
    } ]
  }, {
    "tStartMs": 1064900,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "자 요렇게 바뀐다는 겁니다"
    } ]
  }, {
    "tStartMs": 1067240,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "한마디로 이 기사의 결론은 그겁니다"
    } ]
  }, {
    "tStartMs": 1069920,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "피곤한 세상이다"
    } ]
  }, {
    "tStartMs": 1071580,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "역사적으로 남성은 능력만 있으면 존경받았고"
    } ]
  }, {
    "tStartMs": 1074050,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "여성은 능력과 함께 외모도 좋아야 존경을 받았었는데"
    } ]
  }, {
    "tStartMs": 1077250,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "남성들도 능력만으로 부족하고"
    } ]
  }, {
    "tStartMs": 1079580,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "외모까지 갖춰야 한다는 생각을 하게 되었다"
    } ]
  }, {
    "tStartMs": 1081940,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "라면서 기사가 마무리됩니다"
    } ]
  }, {
    "tStartMs": 1084580,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "제가 여기까지 들으면서"
    } ]
  }, {
    "tStartMs": 1085740,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "진짜 깊은 생각이 들었어요"
    } ]
  }, {
    "tStartMs": 1088410,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "우리 미국분들이 모르셔도 뭘 모르시는구나"
    } ]
  }, {
    "tStartMs": 1091230,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "이거에 대한 고민을 해결할 수 있는 나라가 있는데"
    } ]
  }, {
    "tStartMs": 1093500,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "참 그 제가 실리콘밸리에 가서"
    } ]
  }, {
    "tStartMs": 1095460,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "구글러들 만날 때"
    } ]
  }, {
    "tStartMs": 1096250,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "이 얘기를 할 걸"
    } ]
  }, {
    "tStartMs": 1097320,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "너희의 고민 우리가 해결해 줄 수 있는데"
    } ]
  }, {
    "tStartMs": 1100560,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "답답합니다"
    } ]
  }, {
    "tStartMs": 1101650,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "그 BTS 공연만 보지 말고"
    } ]
  }, {
    "tStartMs": 1103760,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "K 땡땡 다 있잖아요"
    } ]
  }, {
    "tStartMs": 1106040,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "이 분야에는 말이 필요 없는 국가가 있습니다"
    } ]
  }, {
    "tStartMs": 1108590,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "플라스틱 서저리 성형에 관해서는"
    } ]
  }, {
    "tStartMs": 1111240,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "전 세계 모든 나라를 데려와도"
    } ]
  }, {
    "tStartMs": 1113120,
    "dDurationMs": 4130,
    "segs": [ {
      "utf8": "감히 우리나라와 어깨를 견줄 나라가 있을까?"
    } ]
  }, {
    "tStartMs": 1117250,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "이거 쉽지 않거든요"
    } ]
  }, {
    "tStartMs": 1118950,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "성형에 있어서"
    } ]
  }, {
    "tStartMs": 1120040,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "대한민국과 경쟁을 할 만한 나라가 있냐?"
    } ]
  }, {
    "tStartMs": 1125160,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "잘 떠오르지 않아요"
    } ]
  }, {
    "tStartMs": 1125960,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "잘 떠오르지 않는데"
    } ]
  }, {
    "tStartMs": 1127490,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "일단 2024년 우리나라를 방문한"
    } ]
  }, {
    "tStartMs": 1129960,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "외국인 환자가 117만 명입니다"
    } ]
  }, {
    "tStartMs": 1132320,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "게다가 최근에 더 미쳤어요"
    } ]
  }, {
    "tStartMs": 1133720,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "이제 보여드릴게요"
    } ]
  }, {
    "tStartMs": 1134690,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "2023년 대비 93%가 늘었습니다"
    } ]
  }, {
    "tStartMs": 1137940,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "그게 무슨 말이냐?"
    } ]
  }, {
    "tStartMs": 1139220,
    "dDurationMs": 5420,
    "segs": [ {
      "utf8": "우리나라를 방문한 외국인 환자 수가 500만을 2024년에 넘었는데"
    } ]
  }, {
    "tStartMs": 1144640,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "이렇게 올라갔다는 말입니다"
    } ]
  }, {
    "tStartMs": 1146100,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "이렇게"
    } ]
  }, {
    "tStartMs": 1147000,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "상승 속도가 가히 미쳤는데요"
    } ]
  }, {
    "tStartMs": 1149490,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "2024년에 환자가 117만 명까지 늘었어요"
    } ]
  }, {
    "tStartMs": 1153250,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "2023년에 60만 명이었어요"
    } ]
  }, {
    "tStartMs": 1155510,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "외국인 환자 수가"
    } ]
  }, {
    "tStartMs": 1156590,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "누적 500만을 넘은 건데"
    } ]
  }, {
    "tStartMs": 1158390,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "상승 속도가 거의 2배입니다 2배"
    } ]
  }, {
    "tStartMs": 1160520,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "엄청난 외국인 환자가 우리나라에 몰려오고 있다"
    } ]
  }, {
    "tStartMs": 1163780,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "물론 뭐 굳이 어디로 갔는지는"
    } ]
  }, {
    "tStartMs": 1165690,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "제가 말씀 안 드릴 텐데"
    } ]
  }, {
    "tStartMs": 1167250,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "우리나라 강남이나 압구정에 가보시면"
    } ]
  }, {
    "tStartMs": 1170020,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "성형외과 거리가 있습니다"
    } ]
  }, {
    "tStartMs": 1171850,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "완벽한 실력과 수많은 임상 경험"
    } ]
  }, {
    "tStartMs": 1174570,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "저렴한 가격으로 여러분들을 모시는"
    } ]
  }, {
    "tStartMs": 1176220,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "완벽한 성형외과 거리가 있기 때문에"
    } ]
  }, {
    "tStartMs": 1177970,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "아마 그렇지 않을까라고 제가 생각을 했는데"
    } ]
  }, {
    "tStartMs": 1180290,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "실제로 통계를 보니까"
    } ]
  }, {
    "tStartMs": 1182450,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "최근에 급격하게 증가한 외국인 환자들은"
    } ]
  }, {
    "tStartMs": 1185180,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "거의 대부분 피부과나 성형이 주 목적입니다"
    } ]
  }, {
    "tStartMs": 1189720,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "이게 어디서 나온 자료더라?"
    } ]
  }, {
    "tStartMs": 1191090,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "자료 출처가 이게 공식적으로 나온 자료거든요"
    } ]
  }, {
    "tStartMs": 1193430,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "보면은 2021년 이전에는"
    } ]
  }, {
    "tStartMs": 1196070,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "코로나 이전에는"
    } ]
  }, {
    "tStartMs": 1197160,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "우리나라에 온 외국인 환자들이"
    } ]
  }, {
    "tStartMs": 1199100,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "대부분 피부, 성형이"
    } ]
  }, {
    "tStartMs": 1200620,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "15에서 30% 정도밖에 안 됐어요"
    } ]
  }, {
    "tStartMs": 1203450,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "그랬는데 이게 감소한 건"
    } ]
  }, {
    "tStartMs": 1204980,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "코로나 때문에 그렇습니다"
    } ]
  }, {
    "tStartMs": 1206330,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "코로나 때는 피부, 성형을 받으려고"
    } ]
  }, {
    "tStartMs": 1207820,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "비행기 타고 못 오니까"
    } ]
  }, {
    "tStartMs": 1209150,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "많이 줄었는데"
    } ]
  }, {
    "tStartMs": 1209980,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "코로나가 딱 끝난 다음에"
    } ]
  }, {
    "tStartMs": 1211840,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "외국인 환자들이 우리나라에 물밀듯이 들어왔는데"
    } ]
  }, {
    "tStartMs": 1214050,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "아까 전에 2024년에 117만 명이 들어왔죠"
    } ]
  }, {
    "tStartMs": 1216820,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "완전히 역전됐어요"
    } ]
  }, {
    "tStartMs": 1218490,
    "dDurationMs": 4070,
    "segs": [ {
      "utf8": "피부 성형 목적으로 들어오는 비중이 68%입니다"
    } ]
  }, {
    "tStartMs": 1222560,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "예전에는 20%대가 안 됐어요"
    } ]
  }, {
    "tStartMs": 1224300,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "그러니까 한마디로 최근에 증가한 외국인 환자들은"
    } ]
  }, {
    "tStartMs": 1226910,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "거의 대부분 피부나 성형이 주목적이다"
    } ]
  }, {
    "tStartMs": 1230270,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "완전히 크로스 갔습니다"
    } ]
  }, {
    "tStartMs": 1231480,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "과거와는 외국인 환자 지도가 완전히 바뀌었다"
    } ]
  }, {
    "tStartMs": 1234740,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "피부과나 성형외과를 방문한 외국인 환자 수가"
    } ]
  }, {
    "tStartMs": 1237540,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "2024년 기준으로"
    } ]
  }, {
    "tStartMs": 1239330,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "84만 7천 명입니다"
    } ]
  }, {
    "tStartMs": 1242180,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "이 그래프를 보면"
    } ]
  }, {
    "tStartMs": 1243810,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "뭔가 많이 바뀌었다는 걸 알 수 있어요"
    } ]
  }, {
    "tStartMs": 1246540,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "예전에는 10만 대였어"
    } ]
  }, {
    "tStartMs": 1247900,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "10만 대"
    } ]
  }, {
    "tStartMs": 1248800,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "2020년 전까지"
    } ]
  }, {
    "tStartMs": 1251390,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "근데 2021년을 지나면서"
    } ]
  }, {
    "tStartMs": 1252860,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "뭔가 바뀌었어요"
    } ]
  }, {
    "tStartMs": 1254080,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "뭔가 질적으로 바뀌었다"
    } ]
  }, {
    "tStartMs": 1256030,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "여러분 주변에"
    } ]
  }, {
    "tStartMs": 1257020,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "피부과나 성형외과를 하시는 의사 선생님이 있으면"
    } ]
  }, {
    "tStartMs": 1260610,
    "dDurationMs": 4670,
    "segs": [ {
      "utf8": "가서 새해나 아니면 추석에 꼭 큰 절을 드리고 용돈을 받으십시오"
    } ]
  }, {
    "tStartMs": 1265280,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "대박났어x2"
    } ]
  }, {
    "tStartMs": 1266820,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "야 이거 대박났지"
    } ]
  }, {
    "tStartMs": 1268510,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "아니 뭐 외국인 환자가 10몇만 명 왔다가"
    } ]
  }, {
    "tStartMs": 1270940,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "84만 7천 명이 왔다니까요"
    } ]
  }, {
    "tStartMs": 1273270,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "그리고 이분들이 거의 90%가"
    } ]
  }, {
    "tStartMs": 1274870,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "서울에 있는 피부과나 성형외과를 방문했습니다"
    } ]
  }, {
    "tStartMs": 1277670,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "몇 배입니까?"
    } ]
  }, {
    "tStartMs": 1278670,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "거의 4배로 뛰었다는 거니까"
    } ]
  }, {
    "tStartMs": 1280510,
    "dDurationMs": 3730,
    "segs": [ {
      "utf8": "그 중에서도 성형외과를 많이 갔냐 피부과를 많이 갔냐"
    } ]
  }, {
    "tStartMs": 1284240,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "숫자를 보면"
    } ]
  }, {
    "tStartMs": 1285500,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "와"
    } ]
  }, {
    "tStartMs": 1286530,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "이 파란색이 피부과 환자입니다"
    } ]
  }, {
    "tStartMs": 1289130,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "우리나라로 들어온 피부과 외국인 환자예요"
    } ]
  }, {
    "tStartMs": 1292430,
    "dDurationMs": 4030,
    "segs": [ {
      "utf8": "옛날에 만대였는데 70만 명이 들어왔어요"
    } ]
  }, {
    "tStartMs": 1296460,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "2024년에"
    } ]
  }, {
    "tStartMs": 1297820,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "피부과 하십시오"
    } ]
  }, {
    "tStartMs": 1299550,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "2023년에 23만 9천 명이었는데"
    } ]
  }, {
    "tStartMs": 1301960,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "2024년에 70만 5천 명"
    } ]
  }, {
    "tStartMs": 1303810,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "작년에 몇 명일지 모르겠지만"
    } ]
  }, {
    "tStartMs": 1305190,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "작년도 굉장히 많이 늘었겠죠"
    } ]
  }, {
    "tStartMs": 1306620,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "70만 명 가까이가"
    } ]
  }, {
    "tStartMs": 1307900,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "피부과로 굉장히 몰려왔다는 겁니다"
    } ]
  }, {
    "tStartMs": 1310100,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "그러면 이게 왜 그랬을까?"
    } ]
  }, {
    "tStartMs": 1312740,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "갑자기 대한민국 피부과에"
    } ]
  }, {
    "tStartMs": 1313970,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "외국인들이 왜 이렇게 물밀듯이 들어왔을까?"
    } ]
  }, {
    "tStartMs": 1316130,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "저도 이유는 모르겠는데"
    } ]
  }, {
    "tStartMs": 1317330,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "제가 생각한 이유는 이겁니다"
    } ]
  }, {
    "tStartMs": 1319230,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "한국 화장품 열풍이"
    } ]
  }, {
    "tStartMs": 1321130,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "지금 우리나라가 전 세계에서"
    } ]
  }, {
    "tStartMs": 1322890,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "뷰티 시장에서 굉장히 큰 손이거든요"
    } ]
  }, {
    "tStartMs": 1324870,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "프랑스 싸대기를 때릴 정도의 큰 손이 됐는데"
    } ]
  }, {
    "tStartMs": 1327930,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "미국 사람들이 가장 많이 사용하는 화장품이"
    } ]
  }, {
    "tStartMs": 1330520,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "자국 화장품을 제외하면"
    } ]
  }, {
    "tStartMs": 1331580,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "한국 화장품입니다"
    } ]
  }, {
    "tStartMs": 1333060,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "일본도 한국 화장품 열풍이고"
    } ]
  }, {
    "tStartMs": 1334890,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "전 세계적인 한국 화장품 열풍이"
    } ]
  }, {
    "tStartMs": 1336950,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "굉장히 큰 영향을 미치지 않았을 거라고 생각해요"
    } ]
  }, {
    "tStartMs": 1339680,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "바르니까"
    } ]
  }, {
    "tStartMs": 1340440,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "K-POP 보면은"
    } ]
  }, {
    "tStartMs": 1341760,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "K-POP 언니 오빠들의 피부를 보면"
    } ]
  }, {
    "tStartMs": 1343820,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "거의 백옥이거든"
    } ]
  }, {
    "tStartMs": 1345380,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "한국인은 피부가 다 그렇습니까?"
    } ]
  }, {
    "tStartMs": 1347010,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "라고 생각을 하는 거죠"
    } ]
  }, {
    "tStartMs": 1348430,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "그래서 여러분들은 저 같은 사람은"
    } ]
  }, {
    "tStartMs": 1349780,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "주로 마스크를 쓰고 나갑니다"
    } ]
  }, {
    "tStartMs": 1351950,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "국위 선양을 위해서"
    } ]
  }, {
    "tStartMs": 1353250,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "마스크를 쓰고 나가야 되지 않나 생각을 하는데"
    } ]
  }, {
    "tStartMs": 1355890,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "그런 생각들을 하니까"
    } ]
  }, {
    "tStartMs": 1357030,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "화장품도 저렇게 좋은 나라"
    } ]
  }, {
    "tStartMs": 1358590,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "아이돌도 저렇게 피부가 좋은 나라"
    } ]
  }, {
    "tStartMs": 1360750,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "한국 화장품 열풍"
    } ]
  }, {
    "tStartMs": 1361820,
    "dDurationMs": 540,
    "segs": [ {
      "utf8": "그러다 보니까"
    } ]
  }, {
    "tStartMs": 1362360,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "우리나라에 피부 관련으로 오는 사람들이"
    } ]
  }, {
    "tStartMs": 1365640,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "이거 말이 안 되잖아요"
    } ]
  }, {
    "tStartMs": 1366980,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "이게 상식적으로는 말이 안 되는 수치이기 때문에"
    } ]
  }, {
    "tStartMs": 1369550,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "최근에 늘어난 게"
    } ]
  }, {
    "tStartMs": 1370690,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "아마 그런 열풍이 크게 영향을 미치지 않나 생각이 되고"
    } ]
  }, {
    "tStartMs": 1373540,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "그리고 우리나라의 저 피부과나 성형외과로"
    } ]
  }, {
    "tStartMs": 1376050,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "성형을 하러 오신"
    } ]
  }, {
    "tStartMs": 1376940,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "외국인 환자를 분석해보면"
    } ]
  }, {
    "tStartMs": 1378640,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "일본과 중국이 합계 비중 60%입니다"
    } ]
  }, {
    "tStartMs": 1381730,
    "dDurationMs": 3650,
    "segs": [ {
      "utf8": "일본 환자가 44만 명, 중국에서 26만 명"
    } ]
  }, {
    "tStartMs": 1385380,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "미국은 10만 명밖에 안 돼요"
    } ]
  }, {
    "tStartMs": 1388000,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "제가 실리콘밸리 해주고 싶은 말이 이거예요"
    } ]
  }, {
    "tStartMs": 1390610,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "너희도 주제입니다"
    } ]
  }, {
    "tStartMs": 1392300,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "눈을 떠라"
    } ]
  }, {
    "tStartMs": 1393310,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "너희 눈을 떠라"
    } ]
  }, {
    "tStartMs": 1394410,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "세계를 크게 봐"
    } ]
  }, {
    "tStartMs": 1396000,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "보이스 비 앰비셔스 모르나?"
    } ]
  }, {
    "tStartMs": 1397640,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "아직도 그 아까 전에 얼마라고요? 1억?"
    } ]
  }, {
    "tStartMs": 1400450,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "그런 거 받고 있으니까"
    } ]
  }, {
    "tStartMs": 1401600,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "그거 되겠어"
    } ]
  }, {
    "tStartMs": 1402360,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "눈을 크게 뜨고"
    } ]
  }, {
    "tStartMs": 1403350,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "글로벌로 보면"
    } ]
  }, {
    "tStartMs": 1404610,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "엄청난 나라가 있는데"
    } ]
  }, {
    "tStartMs": 1405970,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "그걸 못 보는 게 아니냐"
    } ]
  }, {
    "tStartMs": 1407680,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "게다가 최근에 증가한 외국인 환자분들을 보면"
    } ]
  }, {
    "tStartMs": 1411620,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "거의 90%가 여성입니다"
    } ]
  }, {
    "tStartMs": 1414500,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "피부과나 성형외과로 들어오기 때문에"
    } ]
  }, {
    "tStartMs": 1417030,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "당연히 여성 위주로 들어올 수밖에 없죠"
    } ]
  }, {
    "tStartMs": 1419840,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "피부나 성형 말고"
    } ]
  }, {
    "tStartMs": 1420580,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "내과나 한의학 이런 데로 들어왔으면"
    } ]
  }, {
    "tStartMs": 1422850,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "남녀가 비슷하게 들어올 텐데"
    } ]
  }, {
    "tStartMs": 1424470,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "피부, 성형 목적이다 보니까"
    } ]
  }, {
    "tStartMs": 1426070,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "새로 들어온 분들의"
    } ]
  }, {
    "tStartMs": 1426920,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "거의 90%가 여성이에요"
    } ]
  }, {
    "tStartMs": 1428920,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "그게 2020년대 우리나라 외국인 환자의 특징입니다"
    } ]
  }, {
    "tStartMs": 1432230,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "현재 여성이 84% 찍었어요"
    } ]
  }, {
    "tStartMs": 1434530,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "남성의 비중이 16%밖에 안 돼요"
    } ]
  }, {
    "tStartMs": 1436520,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "외국인 환자 중에"
    } ]
  }, {
    "tStartMs": 1437290,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "남성 비중이 역대 최저 수준입니다"
    } ]
  }, {
    "tStartMs": 1439410,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "그 말인즉슨 뭡니까?"
    } ]
  }, {
    "tStartMs": 1440870,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "실리콘밸리의 이 IT 개발자"
    } ]
  }, {
    "tStartMs": 1442990,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "남성 개발자들이 아직 눈을 못 뜬 거예요"
    } ]
  }, {
    "tStartMs": 1446490,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "제 결론입니다"
    } ]
  }, {
    "tStartMs": 1447590,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "눈을 떠라"
    } ]
  }, {
    "tStartMs": 1448480,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "눈을 떠"
    } ]
  }, {
    "tStartMs": 1449040,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "글로벌로 눈을 떠"
    } ]
  }, {
    "tStartMs": 1450130,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "아니 아직까지 그 캘리포니아에 박혀 가지고 말이야"
    } ]
  }, {
    "tStartMs": 1452790,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "그 자기 동네만 그 좁아 터진 관점"
    } ]
  }, {
    "tStartMs": 1456250,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "탁 트이면 정말 그대들에게"
    } ]
  }, {
    "tStartMs": 1458350,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "최적의 국가가 있는데"
    } ]
  }, {
    "tStartMs": 1459810,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "안타까워서 그래요 안타까워서"
    } ]
  }, {
    "tStartMs": 1461750,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "안타까워서 드리는 말씀이고요"
    } ]
  }, {
    "tStartMs": 1463490,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "미국 남성분들이여"
    } ]
  }, {
    "tStartMs": 1464730,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "눈을 뜨셔야 되지 않나 생각이 들고"
    } ]
  }, {
    "tStartMs": 1466630,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "아직도 그 비싼 10만 달러"
    } ]
  }, {
    "tStartMs": 1468930,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "어머 1억, 1억 5천"
    } ]
  }, {
    "tStartMs": 1471120,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "그런 비싼 미국 성형외과를 다닐 것이냐"
    } ]
  }, {
    "tStartMs": 1473350,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "아니면 저렴하죠?"
    } ]
  }, {
    "tStartMs": 1474880,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "실력 좋죠?"
    } ]
  }, {
    "tStartMs": 1475840,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "같은 값이면 한국 관광 엄청납니다"
    } ]
  }, {
    "tStartMs": 1478780,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "K-관광 언젠가 제가 주제로 갖고 올 건데요"
    } ]
  }, {
    "tStartMs": 1480800,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "일본 관광을 드디어 따라갈 준비를 하고 있거든요"
    } ]
  }, {
    "tStartMs": 1483780,
    "dDurationMs": 4150,
    "segs": [ {
      "utf8": "한국 관광까지 할 수 있는 K-의료를 즐길 것인가"
    } ]
  }, {
    "tStartMs": 1487930,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "생각해보면 이렇게"
    } ]
  }, {
    "tStartMs": 1489460,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "왼쪽을 먹냐 오른쪽을 먹냐"
    } ]
  }, {
    "tStartMs": 1490400,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "눈을 뜨면 이렇게 세계가 파라다이스가 아닌가 생각을 합니다"
    } ]
  }, {
    "tStartMs": 1495500,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "게다가 한국은 2016년에 외국인 환자 유치를 위한"
    } ]
  }, {
    "tStartMs": 1499130,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "미용 성형 부가세 환급도 적용을 시행했습니다"
    } ]
  }, {
    "tStartMs": 1502310,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "택스 프리 성형"
    } ]
  }, {
    "tStartMs": 1503650,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "아 좋습니다"
    } ]
  }, {
    "tStartMs": 1504840,
    "dDurationMs": 5110,
    "segs": [ {
      "utf8": "2024년 기준 환급해준 세금만 무려 955억이라고 합니다"
    } ]
  }, {
    "tStartMs": 1509950,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "택스 프리이기 때문에"
    } ]
  }, {
    "tStartMs": 1511070,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "오 그럼 이걸로 광고하면 되나요?"
    } ]
  }, {
    "tStartMs": 1514880,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "종료됐어요"
    } ]
  }, {
    "tStartMs": 1516610,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "2025년 종료돼서"
    } ]
  }, {
    "tStartMs": 1518150,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "예정대로 종료했습니다"
    } ]
  }, {
    "tStartMs": 1519290,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "했다고"
    } ]
  }, {
    "tStartMs": 1520190,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "예전에 텍스 프리였다라고 쓰면 되는 거죠"
    } ]
  }, {
    "tStartMs": 1523350,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "was 택스 프리"
    } ]
  }, {
    "tStartMs": 1524720,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "now는 아니고 now는 아니고"
    } ]
  }, {
    "tStartMs": 1526400,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "외국인에까지 세제 혜택을 제공하는 게 적절하냐?"
    } ]
  }, {
    "tStartMs": 1528980,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "해서 이게 종료가 됐습니다 그렇습니다"
    } ]
  }, {
    "tStartMs": 1531360,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "하지만 그럼에도 불구하고"
    } ]
  }, {
    "tStartMs": 1532660,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "충분히 우리나라 메리트가 있지 않나 생각이 되고"
    } ]
  }, {
    "tStartMs": 1534500,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "다만 그건 있어요"
    } ]
  }, {
    "tStartMs": 1535360,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "이건 제 개인 불만인데"
    } ]
  }, {
    "tStartMs": 1536870,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "그래서 그런지 몰라도"
    } ]
  }, {
    "tStartMs": 1538330,
    "dDurationMs": 4550,
    "segs": [ {
      "utf8": "요즘에 피부 치료 안 하는 피부과가 좀 늘고 있어서"
    } ]
  }, {
    "tStartMs": 1542880,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "제가 얼마 전에"
    } ]
  }, {
    "tStartMs": 1544110,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "다리에 까만 게 나는 것 같은"
    } ]
  }, {
    "tStartMs": 1546450,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "불안하잖아요"
    } ]
  }, {
    "tStartMs": 1547060,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "피부에 없던 점 같은 게 생기면"
    } ]
  }, {
    "tStartMs": 1549620,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "이거 치료하는 데를"
    } ]
  }, {
    "tStartMs": 1551200,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "피부과여서 들어갔더니"
    } ]
  }, {
    "tStartMs": 1553020,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "보더니 안 받어"
    } ]
  }, {
    "tStartMs": 1554390,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "안 받는 게 아니라 보더니"
    } ]
  }, {
    "tStartMs": 1557920,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "이게 물론 환자를 거부하거나 그런 건 아닌데"
    } ]
  }, {
    "tStartMs": 1560820,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "그걸 치료하는 곳이 아니라는 거죠"
    } ]
  }, {
    "tStartMs": 1562620,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "그런 기술이 있는 곳이 아니다"
    } ]
  }, {
    "tStartMs": 1564160,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "피부병을 치료하는 게 아니라"
    } ]
  }, {
    "tStartMs": 1566140,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "피부 미용 시술을 하는 피부과가 늘고 있다 보니까"
    } ]
  }, {
    "tStartMs": 1569960,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "그래서 그럴 거면"
    } ]
  }, {
    "tStartMs": 1571460,
    "dDurationMs": 4670,
    "segs": [ {
      "utf8": "피부과와 피부 미용과를 밖에 좀 나눠서 써주면"
    } ]
  }, {
    "tStartMs": 1576130,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "알아서 찾아 들어갈 텐데"
    } ]
  }, {
    "tStartMs": 1578570,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "다 같이 피부과로 써 있으니까"
    } ]
  }, {
    "tStartMs": 1580170,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "어떤 건 피부 미용과고"
    } ]
  }, {
    "tStartMs": 1582100,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "어떤 건 피부과인지"
    } ]
  }, {
    "tStartMs": 1583620,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "이거 알아보기가 굉장히 힘들더라고요"
    } ]
  }, {
    "tStartMs": 1585590,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "그래서 좀 나누어서 써줬으면"
    } ]
  }, {
    "tStartMs": 1588280,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "물론 뭐 구별하는 법이 있대"
    } ]
  }, {
    "tStartMs": 1589690,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "제가 나중에 인터넷 뒤져보니까"
    } ]
  }, {
    "tStartMs": 1591280,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "무슨 뭐 뭐라 그러죠?"
    } ]
  }, {
    "tStartMs": 1592580,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "피부과 전문의는 뭐가 있고"
    } ]
  }, {
    "tStartMs": 1594140,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "하여튼 그러던데"
    } ]
  }, {
    "tStartMs": 1595040,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "한눈에 알아보기 힘드니까"
    } ]
  }, {
    "tStartMs": 1596630,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "미용과 이렇게 써줬으면"
    } ]
  }, {
    "tStartMs": 1597910,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "굉장히 좋지 않을까라는"
    } ]
  }, {
    "tStartMs": 1598950,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "개인적인 생각을 한번 해봅니다"
    } ]
  }, {
    "tStartMs": 1601180,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "자 그리고 끝났는데"
    } ]
  }, {
    "tStartMs": 1602240,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "마지막으로 슈카까지 이런 말을 하는 거 보니까"
    } ]
  }, {
    "tStartMs": 1604750,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "굉장히 걱정이 되죠 뭐가?"
    } ]
  }, {
    "tStartMs": 1606850,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "성형수술 남용이 걱정이 되죠"
    } ]
  }, {
    "tStartMs": 1609150,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "그래서 얼마 전에"
    } ]
  }, {
    "tStartMs": 1610190,
    "dDurationMs": 5810,
    "segs": [ {
      "utf8": "교황청이 성형수술 남용을 경고하는 메시지를 냈습니다"
    } ]
  }, {
    "tStartMs": 1616000,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "제가 하라고 한 건 아니고요"
    } ]
  }, {
    "tStartMs": 1617080,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "실리콘밸리가 그랬다고 실리콘밸리가"
    } ]
  }, {
    "tStartMs": 1619400,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "교황청 산화 위원회에서 전세계 14억 가톨릭 신자들에게"
    } ]
  }, {
    "tStartMs": 1622650,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "미용 수술 자제를 권고했다"
    } ]
  }, {
    "tStartMs": 1625570,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "내용은 이렇습니다"
    } ]
  }, {
    "tStartMs": 1626750,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "바티칸은 너무 완벽한 몸매에 대한 과도한 추구를 하면"
    } ]
  }, {
    "tStartMs": 1629950,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "육체 숭배"
    } ]
  }, {
    "tStartMs": 1631100,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "그리고 비현실적인 추구로 이어질 수 있다고 밝혔다"
    } ]
  }, {
    "tStartMs": 1635100,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "그러면 교회가 성형수술을 금지하는 거냐?"
    } ]
  }, {
    "tStartMs": 1637990,
    "dDurationMs": 3410,
    "segs": [ {
      "utf8": "교회는 성형수술 자체를 금지하지는 않는다고 합니다"
    } ]
  }, {
    "tStartMs": 1641400,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "다만"
    } ]
  }, {
    "tStartMs": 1642110,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "자신의 허영심을 채우기 위한 시술을 받아서는 안 된다"
    } ]
  }, {
    "tStartMs": 1645280,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "라고 얘기를 했다는 거죠"
    } ]
  }, {
    "tStartMs": 1646620,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "우리 추기경님들이 그랬다는 겁니다"
    } ]
  }, {
    "tStartMs": 1648650,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "성경에서 인간의 몸은"
    } ]
  }, {
    "tStartMs": 1649670,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "하나님의 형상대로 창조되었기 때문에 그렇다라고 가르치신다고 하고요"
    } ]
  }, {
    "tStartMs": 1654410,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "지난해 선종한 프란치스코 교황께서도"
    } ]
  }, {
    "tStartMs": 1657340,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "지나친 성형수술 세태를 경계해야 된다"
    } ]
  }, {
    "tStartMs": 1659760,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "이런 말씀을 하셨다고 합니다"
    } ]
  }, {
    "tStartMs": 1661600,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "이번에 나온 문서가"
    } ]
  }, {
    "tStartMs": 1663180,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "레오 14세 교황에게 승인을 받은 문서라고 해요"
    } ]
  }, {
    "tStartMs": 1666210,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "공식적인 문서라는 거죠 한마디로"
    } ]
  }, {
    "tStartMs": 1667870,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "교황청이 발행한 공식적인 문서라고 하고"
    } ]
  }, {
    "tStartMs": 1671070,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "요렇게 내용이 나옵니다"
    } ]
  }, {
    "tStartMs": 1672990,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "신체 숭배가 만연해 지면서"
    } ]
  }, {
    "tStartMs": 1674890,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "건강하고 젊고 아름다운"
    } ]
  }, {
    "tStartMs": 1676300,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "완벽한 외형을 광적으로 추구하는 경향이 나타나고 있다"
    } ]
  }, {
    "tStartMs": 1682120,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "제가 뭐 그렇다는 건 아니고"
    } ]
  }, {
    "tStartMs": 1684300,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "하여튼 뭐 그렇다는 거고요"
    } ]
  }, {
    "tStartMs": 1686780,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "그리고 교황청의 문서에 나온 말입니다"
    } ]
  }, {
    "tStartMs": 1689340,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "성형수술은 그 순간의 취향에 따라"
    } ]
  }, {
    "tStartMs": 1691170,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "몸을 바꾸는 태도로 이어질 수 있다"
    } ]
  }, {
    "tStartMs": 1693510,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "그래서 앞으로 AI가 발전하면은"
    } ]
  }, {
    "tStartMs": 1695540,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "혹시 인간이 언젠가는 계속 그렇게 가다 보면"
    } ]
  }, {
    "tStartMs": 1698530,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "기계 임플란트까지 받는 것 아니냐"
    } ]
  }, {
    "tStartMs": 1700940,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "계속 젊어지고 계속 하려면 몸에서"
    } ]
  }, {
    "tStartMs": 1702840,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "어? 뭐가 안 좋아졌어?"
    } ]
  }, {
    "tStartMs": 1703900,
    "dDurationMs": 670,
    "segs": [ {
      "utf8": "하면 낀다는 거죠"
    } ]
  }, {
    "tStartMs": 1704570,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "갈아 끼우고 갈아 끼우고"
    } ]
  }, {
    "tStartMs": 1706810,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "그런 거를 이제 좀 우려하신다고 합니다 교황청에서"
    } ]
  }, {
    "tStartMs": 1710830,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "그리고 바티칸이 그러면 대신에 해결법을 알려주셨어요"
    } ]
  }, {
    "tStartMs": 1714850,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "주름 생기고 나이 들어 보이고 어떻게 처지고"
    } ]
  }, {
    "tStartMs": 1717880,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "그런 거에 대한 해결법"
    } ]
  }, {
    "tStartMs": 1718980,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "이렇게 말씀해 주셨습니다"
    } ]
  }, {
    "tStartMs": 1720600,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "아주 좋은 해결법이 있어요"
    } ]
  }, {
    "tStartMs": 1722260,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "예수님은 당신이 나이가 들어 얼굴에 주름이 생기더라도"
    } ]
  }, {
    "tStartMs": 1725130,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "여전히 당신을 사랑하실 것입니다"
    } ]
  }, {
    "tStartMs": 1727420,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "라고 해결법을 주셨습니다"
    } ]
  }, {
    "tStartMs": 1729490,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "그렇대요"
    } ]
  }, {
    "tStartMs": 1730650,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "그러니까 신께서는"
    } ]
  }, {
    "tStartMs": 1732200,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "당신이 얼굴에 주름이 생겨도"
    } ]
  }, {
    "tStartMs": 1734190,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "여전히 사랑하실 것이다"
    } ]
  }, {
    "tStartMs": 1735720,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "라고 주름 고민 해결법을 주셨으니까"
    } ]
  }, {
    "tStartMs": 1737910,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "고민 있으신 분들은 그렇게 기도를 통해서"
    } ]
  }, {
    "tStartMs": 1741290,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "1대1로 해결하시면 가장 좋지 않을까 생각을 합니다"
    } ]
  } ]
}

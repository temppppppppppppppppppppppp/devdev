  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 7780,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "본격적으로 이란 전쟁에 대한"
    } ]
  }, {
    "tStartMs": 10040,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "얘기를 한번 해보도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 11230,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "주제는 이겁니다"
    } ]
  }, {
    "tStartMs": 12360,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "미국은 손 떼겠습니다"
    } ]
  }, {
    "tStartMs": 13780,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "수고요"
    } ]
  }, {
    "tStartMs": 14700,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "라는 제목을 갖고 왔는데요"
    } ]
  }, {
    "tStartMs": 16610,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "어디서 손을 떼겠다는 거냐"
    } ]
  }, {
    "tStartMs": 18680,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "이란 전쟁이 끝난 거냐"
    } ]
  }, {
    "tStartMs": 20130,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "아, 이란에서 손을 떼면"
    } ]
  }, {
    "tStartMs": 21930,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "뭐 그나마 전쟁이 끝나는 거니까"
    } ]
  }, {
    "tStartMs": 23460,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "그나마 나은데"
    } ]
  }, {
    "tStartMs": 24430,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "다른 데서 손을 뗄 수도"
    } ]
  }, {
    "tStartMs": 25630,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "있다라는 얘기를 하셨습니다"
    } ]
  }, {
    "tStartMs": 27200,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "어디서 손을 뗀다는 걸까요"
    } ]
  }, {
    "tStartMs": 28900,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "자, 지금부터 한번 알아보도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 32120,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "자, 이미 이란 전쟁은"
    } ]
  }, {
    "tStartMs": 33410,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "미국-이란 전쟁은"
    } ]
  }, {
    "tStartMs": 34350,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "4주차에 접어들고 있습니다"
    } ]
  }, {
    "tStartMs": 36450,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "슈카월드에 정말 수많은 영상이 올라가고 있어요"
    } ]
  }, {
    "tStartMs": 39180,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "이대로 가면 10개 이상이 되지 않을까 생각하는데"
    } ]
  }, {
    "tStartMs": 41340,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "온 세상의 거의 모든 뉴스가"
    } ]
  }, {
    "tStartMs": 43170,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "중동 전쟁이 다 장악하고 있는 상황입니다"
    } ]
  }, {
    "tStartMs": 45410,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "물가, 유가, 산업,"
    } ]
  }, {
    "tStartMs": 47840,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "그리고 주식"
    } ]
  }, {
    "tStartMs": 48860,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "모든 게 이란 전쟁을 빼고"
    } ]
  }, {
    "tStartMs": 50300,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "중동 전쟁을 빼고는"
    } ]
  }, {
    "tStartMs": 51710,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "이야기할 수 없는 게"
    } ]
  }, {
    "tStartMs": 52570,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "지금이라고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 55040,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "지난번에 영상에서 보셨지만"
    } ]
  }, {
    "tStartMs": 56260,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "지난주에 트럼프 대통령은"
    } ]
  }, {
    "tStartMs": 57410,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "우리나라를 포함한 몇몇 국가들한테"
    } ]
  }, {
    "tStartMs": 59840,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "호르무즈해협의 군함을 파견할 것을 요구했어요"
    } ]
  }, {
    "tStartMs": 62310,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "중국, 영국, 프랑스, 일본"
    } ]
  }, {
    "tStartMs": 63620,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "그리고 한국"
    } ]
  }, {
    "tStartMs": 64550,
    "dDurationMs": 420,
    "segs": [ {
      "utf8": "같이 와서"
    } ]
  }, {
    "tStartMs": 64970,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "호르무즈에 군함을 보내라"
    } ]
  }, {
    "tStartMs": 66970,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "라고 요구를 했죠"
    } ]
  }, {
    "tStartMs": 68220,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "그때 트럼프 대통령이"
    } ]
  }, {
    "tStartMs": 69410,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 70730,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "많은 국가들이 협조 의사를 밝혔다"
    } ]
  }, {
    "tStartMs": 73370,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "특히 프랑스가 나선다고 하더군요"
    } ]
  }, {
    "tStartMs": 75580,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "프랑스가 좀 완벽한 나라는 아니지만"
    } ]
  }, {
    "tStartMs": 77450,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "마크롱이 좀 그렇긴 해요"
    } ]
  }, {
    "tStartMs": 79070,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "하지만 역시 프랑스입니다"
    } ]
  }, {
    "tStartMs": 80930,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "라고 얘기를 해서"
    } ]
  }, {
    "tStartMs": 82170,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "유럽 국가들이 호르무즈 해협에 군함을 보내나 보다"
    } ]
  }, {
    "tStartMs": 85210,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "라고 생각을 했죠"
    } ]
  }, {
    "tStartMs": 86560,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "그런데 조금 이따가"
    } ]
  }, {
    "tStartMs": 87840,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "대부분의 유럽 국가들이"
    } ]
  }, {
    "tStartMs": 88820,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "즉시 거부 성명을 발표했습니다"
    } ]
  }, {
    "tStartMs": 92160,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "영국 스타머 총리는 이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 93840,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "영국은 더 광범위한 전쟁에 휘말리지 않을 것이다"
    } ]
  }, {
    "tStartMs": 97290,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "독일은 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 98430,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "이것은 우리의 전쟁이 아니다"
    } ]
  }, {
    "tStartMs": 100890,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "이 전쟁은 우리가"
    } ]
  }, {
    "tStartMs": 102210,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "시작하지도 않았다"
    } ]
  }, {
    "tStartMs": 103200,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "그런데 왜 날 부르냐"
    } ]
  }, {
    "tStartMs": 105540,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "이거에 대해서는 사실 트럼프"
    } ]
  }, {
    "tStartMs": 106920,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "대통령이 할 말이 있긴 합니다"
    } ]
  }, {
    "tStartMs": 108700,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "왜냐하면 트럼프 대통령이"
    } ]
  }, {
    "tStartMs": 111500,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "독일을 부르지는 않았어요"
    } ]
  }, {
    "tStartMs": 112960,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "잘 보시면 독일은 없거든"
    } ]
  }, {
    "tStartMs": 114980,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "제가 어.. 그래"
    } ]
  }, {
    "tStartMs": 116670,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "니네 전쟁이 아니지"
    } ]
  }, {
    "tStartMs": 117510,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "중국, 영국, 프랑스, 일본, 한국"
    } ]
  }, {
    "tStartMs": 119180,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "독일 없는데"
    } ]
  }, {
    "tStartMs": 120100,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "독일 없는데"
    } ]
  }, {
    "tStartMs": 120960,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "독일이 아니 없지만"
    } ]
  }, {
    "tStartMs": 122540,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "얘기는 할 수 있지"
    } ]
  }, {
    "tStartMs": 123450,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "없지만 나도 뭐 나 안 가겠다고"
    } ]
  }, {
    "tStartMs": 125300,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "나 안 가겠다고"
    } ]
  }, {
    "tStartMs": 126010,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "우리 전쟁이 아니야"
    } ]
  }, {
    "tStartMs": 126760,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "맞아 맞아"
    } ]
  }, {
    "tStartMs": 127520,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "안 가겠다고 그래서"
    } ]
  }, {
    "tStartMs": 128550,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "부르진 않았지만"
    } ]
  }, {
    "tStartMs": 129380,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "가진 않겠다"
    } ]
  }, {
    "tStartMs": 130200,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "라고 거부 성명을 발표했고요"
    } ]
  }, {
    "tStartMs": 132660,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "아까 그럼 트럼프 대통령이"
    } ]
  }, {
    "tStartMs": 133980,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "프랑스는 온다 그랬을까"
    } ]
  }, {
    "tStartMs": 135100,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "프랑스는 가냐"
    } ]
  }, {
    "tStartMs": 136830,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "마크롱 대통령이"
    } ]
  }, {
    "tStartMs": 137550,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 138270,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "가긴 간다"
    } ]
  }, {
    "tStartMs": 139160,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "상황이 안정되면"
    } ]
  }, {
    "tStartMs": 141730,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "그럼 종전하면 가겠다는 거잖아"
    } ]
  }, {
    "tStartMs": 143200,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "그게 가는 거냐"
    } ]
  }, {
    "tStartMs": 144520,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "상황이 안정되면"
    } ]
  }, {
    "tStartMs": 145780,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "다른 동맹국들과 함께 가겠다고"
    } ]
  }, {
    "tStartMs": 148320,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "내가 얘기한 거다"
    } ]
  }, {
    "tStartMs": 150080,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "우리도 그렇게 얘기할 수 있지"
    } ]
  }, {
    "tStartMs": 151560,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "상황이 안정되면 호르무즈 해협에 가겠다"
    } ]
  }, {
    "tStartMs": 154780,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "그땐 여행도 가겠다"
    } ]
  }, {
    "tStartMs": 156160,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "전쟁이 끝나면 그땐"
    } ]
  }, {
    "tStartMs": 157410,
    "dDurationMs": 350,
    "segs": [ {
      "utf8": "하여튼"
    } ]
  }, {
    "tStartMs": 157760,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "그래서 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 158800,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "프랑스는 분쟁 당사국이 아니야"
    } ]
  }, {
    "tStartMs": 160580,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "호르무즈 해협의 개방 작전에는 참여할 수 없다"
    } ]
  }, {
    "tStartMs": 163810,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "안 가겠다는 거죠"
    } ]
  }, {
    "tStartMs": 164780,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "결론적으로 안 가겠다고 얘기를 했습니다"
    } ]
  }, {
    "tStartMs": 167900,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "저 말을 들은 트럼프 대통령이 극대노했죠"
    } ]
  }, {
    "tStartMs": 170820,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "이런 배은망덕한 놈들"
    } ]
  }, {
    "tStartMs": 172570,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "우리는 4만 5천 명의"
    } ]
  }, {
    "tStartMs": 173960,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "훌륭한 군인들을 배치해서"
    } ]
  }, {
    "tStartMs": 175840,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "유럽에 미군도 배치하고"
    } ]
  }, {
    "tStartMs": 177120,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "여기저기 다 주일미군 주한미군"
    } ]
  }, {
    "tStartMs": 179440,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "다 배치해갖고"
    } ]
  }, {
    "tStartMs": 180530,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "지켜주고 있는데"
    } ]
  }, {
    "tStartMs": 181400,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "너희들을 위험으로 또 보호하고 있는데"
    } ]
  }, {
    "tStartMs": 183040,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "그동안 아주 잘해왔어"
    } ]
  }, {
    "tStartMs": 183900,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "근데 고작 호위병력을 안 보내냐"
    } ]
  }, {
    "tStartMs": 186430,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "게다가 많은 걸 말한 것도 아니고"
    } ]
  }, {
    "tStartMs": 188450,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "그 기뢰 제거함"
    } ]
  }, {
    "tStartMs": 189590,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "그거 몇 척 보내라는 게"
    } ]
  }, {
    "tStartMs": 191160,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "그렇게 어려운 거냐"
    } ]
  }, {
    "tStartMs": 192450,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "제가 말했습니다"
    } ]
  }, {
    "tStartMs": 193330,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "기뢰 제거함 좀 보내줄 수 있습니까?"
    } ]
  }, {
    "tStartMs": 195220,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "라고 물었더니"
    } ]
  }, {
    "tStartMs": 196050,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "동맹국이란 것들이 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 197480,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "글쎄요, 저희는 개입하지 않는 게 좋겠습니다"
    } ]
  }, {
    "tStartMs": 199980,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "라고 대답을 하겠다는 거죠"
    } ]
  }, {
    "tStartMs": 201570,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "그래서 이렇게 얘기하셨어요"
    } ]
  }, {
    "tStartMs": 203000,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "제가 이럴 줄 알고 그동안"
    } ]
  }, {
    "tStartMs": 204560,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "동맹에 비판적이었던 겁니다"
    } ]
  }, {
    "tStartMs": 207330,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "저는 동맹이 미국 국가 보호를 해준다는 것에"
    } ]
  }, {
    "tStartMs": 209820,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "늘 비판적이었어요"
    } ]
  }, {
    "tStartMs": 211480,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "우리가 필요할 때"
    } ]
  }, {
    "tStartMs": 212230,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "그들은 항상 우리 곁에 없었기 때문입니다"
    } ]
  }, {
    "tStartMs": 215580,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "동맹국이라는 놈들은"
    } ]
  }, {
    "tStartMs": 217140,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "핵 보유국 이란과의 전쟁에"
    } ]
  }, {
    "tStartMs": 218780,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "참여하지 않는 데다가"
    } ]
  }, {
    "tStartMs": 220060,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "높은 유가 때문에"
    } ]
  }, {
    "tStartMs": 221260,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "돈 조금 내는 거"
    } ]
  }, {
    "tStartMs": 222660,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "그거에 대해서 불평만 하고 있다"
    } ]
  }, {
    "tStartMs": 224450,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "세계에 적이 있는데"
    } ]
  }, {
    "tStartMs": 225850,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "거기 전쟁을 같이 참여하지 않고"
    } ]
  }, {
    "tStartMs": 227690,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "가격 조금 오르는 것에 불평하고 말이야"
    } ]
  }, {
    "tStartMs": 229380,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "게다가 호르무즈 해협 호위"
    } ]
  }, {
    "tStartMs": 231050,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "이거는 위험 부담 없는"
    } ]
  }, {
    "tStartMs": 232460,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "간단한 군사 작전이야"
    } ]
  }, {
    "tStartMs": 234090,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "그런데도 동맹국들이 돕고 싶어 하지 않는다니"
    } ]
  }, {
    "tStartMs": 236670,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "이거 이래서야 되겠습니까?"
    } ]
  }, {
    "tStartMs": 238860,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "미국이 없으면"
    } ]
  }, {
    "tStartMs": 239650,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "나토는 종이 호랑이일 뿐입니다"
    } ]
  }, {
    "tStartMs": 241490,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "아, 종이 호랑이가"
    } ]
  }, {
    "tStartMs": 243190,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "영어도 그렇게 쓰는군요"
    } ]
  }, {
    "tStartMs": 244590,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "페이퍼 타이거"
    } ]
  }, {
    "tStartMs": 245500,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "영어에서 나온 말인가 보네"
    } ]
  }, {
    "tStartMs": 247940,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "아, 페이퍼 타이거"
    } ]
  }, {
    "tStartMs": 249920,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "페이퍼 타이거라고 합니다"
    } ]
  }, {
    "tStartMs": 251190,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "그러면서"
    } ]
  }, {
    "tStartMs": 252240,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "나토는 겁쟁이다"
    } ]
  }, {
    "tStartMs": 254700,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "이런 겁쟁이 같으니라고"
    } ]
  }, {
    "tStartMs": 256010,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "우리는 이것을 기억할 것입니다"
    } ]
  }, {
    "tStartMs": 258340,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "미국은 이것을   기억할 것입니다"
    } ]
  }, {
    "tStartMs": 261110,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "그러면서 약간 좀 어두운 말도 하셨어요"
    } ]
  }, {
    "tStartMs": 262700,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "자 다시 생각하는 게 좋을 거다"
    } ]
  }, {
    "tStartMs": 264730,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "유럽 국가들이 핵심 항로를 열기 위한"
    } ]
  }, {
    "tStartMs": 266310,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "미국의 노력에 동참하지 않는다면"
    } ]
  }, {
    "tStartMs": 268840,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "나토의 미래에"
    } ]
  }, {
    "tStartMs": 269950,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "매우 좋지 않은 일이 될 것이다"
    } ]
  }, {
    "tStartMs": 273760,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "very bad for the future"
    } ]
  }, {
    "tStartMs": 275230,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "of NATO라고 얘기를 했는데"
    } ]
  }, {
    "tStartMs": 277500,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "나토에서 탈퇴는 안 하겠지만"
    } ]
  }, {
    "tStartMs": 279900,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "나토의 미래가 정말 어두워질 수도 있지 않냐"
    } ]
  }, {
    "tStartMs": 281880,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "라는 얘기까지 하고 있습니다"
    } ]
  }, {
    "tStartMs": 283740,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "물론 이 얘기를 한 다음에도"
    } ]
  }, {
    "tStartMs": 285290,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "영국은 이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 287280,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "분명히 말씀드리지만"
    } ]
  }, {
    "tStartMs": 288560,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "이것은 나토의 임무가 아니다"
    } ]
  }, {
    "tStartMs": 290810,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "나토의 임무였던 적도 없어"
    } ]
  }, {
    "tStartMs": 292680,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "나토는 방어 동맹이야"
    } ]
  }, {
    "tStartMs": 295250,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "그리고 모든 조항들이"
    } ]
  }, {
    "tStartMs": 296410,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "본질적으로 방어를 지향해"
    } ]
  }, {
    "tStartMs": 298610,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "누가 우리를 공격하면"
    } ]
  }, {
    "tStartMs": 299760,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "집단 방위를 하자"
    } ]
  }, {
    "tStartMs": 301670,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "올 포 원"
    } ]
  }, {
    "tStartMs": 302350,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "원 포 올"
    } ]
  }, {
    "tStartMs": 303210,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "한 나라가 공격 받으면"
    } ]
  }, {
    "tStartMs": 304190,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "같이 지키자는 거지"
    } ]
  }, {
    "tStartMs": 305760,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "나토 동맹국 중에 하나가"
    } ]
  }, {
    "tStartMs": 307360,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "자의적인 전쟁을 벌인 후에"
    } ]
  }, {
    "tStartMs": 309030,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "다른 국가 모두에게 따르도록"
    } ]
  }, {
    "tStartMs": 310950,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "강요하는 동맹이 아니다"
    } ]
  }, {
    "tStartMs": 313250,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "진짜 강하죠?"
    } ]
  }, {
    "tStartMs": 316400,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "진짜 강합니다"
    } ]
  }, {
    "tStartMs": 317330,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "이렇게 얘기를 하면서"
    } ]
  }, {
    "tStartMs": 318980,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "전쟁에 휘말리지 않겠다는"
    } ]
  }, {
    "tStartMs": 320370,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "거부 의사를 확고하게 얘기를 했습니다"
    } ]
  }, {
    "tStartMs": 323390,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "그러니까 트럼프 대통령이"
    } ]
  }, {
    "tStartMs": 324610,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "또 이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 326120,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "에헤이 이거 보세요"
    } ]
  }, {
    "tStartMs": 326930,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "이거 사실"
    } ]
  }, {
    "tStartMs": 327870,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "충성도 테스트였습니다"
    } ]
  }, {
    "tStartMs": 329280,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "미국은 누구도 필요하지 않아요"
    } ]
  }, {
    "tStartMs": 332130,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "세계에서 가장 강한 게 미국 아니겠습니까?"
    } ]
  }, {
    "tStartMs": 334980,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "자 그래서 니들이"
    } ]
  }, {
    "tStartMs": 336110,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "실제로 올 생각이 있나 없나"
    } ]
  }, {
    "tStartMs": 337800,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "물어본 거야"
    } ]
  }, {
    "tStartMs": 338750,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "내가 충성도 테스트를 해봤는데"
    } ]
  }, {
    "tStartMs": 340920,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "이런 제대로 된 놈이 하나도 없구만"
    } ]
  }, {
    "tStartMs": 342650,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "충성도가 다 그래갖고"
    } ]
  }, {
    "tStartMs": 344180,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "뭐 미국과 뭐를 같이"
    } ]
  }, {
    "tStartMs": 345610,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "하겠습니까?"
    } ]
  }, {
    "tStartMs": 346840,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "저는 정말 몇몇 국가들에게"
    } ]
  }, {
    "tStartMs": 348790,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "실망할 거 같네요"
    } ]
  }, {
    "tStartMs": 350240,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "중대장은 실망했다"
    } ]
  }, {
    "tStartMs": 351620,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "나오라고 하니까"
    } ]
  }, {
    "tStartMs": 352430,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "한 놈도 안 나오고 말이야"
    } ]
  }, {
    "tStartMs": 353870,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "이거 그냥 테스트한 것뿐인데"
    } ]
  }, {
    "tStartMs": 355400,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "나중에 제가 잘 기억하고 있다가"
    } ]
  }, {
    "tStartMs": 357260,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "그 국가들이 어딘지 하나하나 말씀드리겠습니다"
    } ]
  }, {
    "tStartMs": 360510,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "그러면서 뭐 별일 아니라는 듯이"
    } ]
  }, {
    "tStartMs": 362630,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "충성도 테스트야"
    } ]
  }, {
    "tStartMs": 363670,
    "dDurationMs": 280,
    "segs": [ {
      "utf8": "흥!"
    } ]
  }, {
    "tStartMs": 363950,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "하고 들어가셨는데"
    } ]
  }, {
    "tStartMs": 365250,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "나중에 공화당 상원의원이"
    } ]
  }, {
    "tStartMs": 367620,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "이 SNS에 올린 바에 따르면"
    } ]
  }, {
    "tStartMs": 368910,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 370290,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "제 평생 대통령이"
    } ]
  }, {
    "tStartMs": 372150,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "이렇게 화를 내는 모습은 처음 봅니다"
    } ]
  }, {
    "tStartMs": 375480,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "린지 그레엄이 올렸는데"
    } ]
  }, {
    "tStartMs": 377630,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "유럽 동맹국들이"
    } ]
  }, {
    "tStartMs": 378600,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "호르무즈 해협에 오지 않는다는 거"
    } ]
  }, {
    "tStartMs": 380660,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "그 소극적인 태도를 보인다는 것에"
    } ]
  }, {
    "tStartMs": 383040,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "정말로 극대노하셨다 하는"
    } ]
  }, {
    "tStartMs": 386190,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "그런 SNS를 올렸어요"
    } ]
  }, {
    "tStartMs": 387550,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 388370,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "호르무즈 해협은 미국보다"
    } ]
  }, {
    "tStartMs": 389230,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "유럽에 훨씬 더 큰 이익을 주는 곳인데"
    } ]
  }, {
    "tStartMs": 391550,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "아시아에 더 큰 이익을 주는 곳인데"
    } ]
  }, {
    "tStartMs": 393180,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "어떻게 오지 않을 수 있냐라고"
    } ]
  }, {
    "tStartMs": 395460,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "극대노했다는 거죠"
    } ]
  }, {
    "tStartMs": 397470,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "그래서 헤그세스 전쟁부 장관이"
    } ]
  }, {
    "tStartMs": 399870,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "동맹들을 꾸짖었습니다"
    } ]
  }, {
    "tStartMs": 401970,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "뭐라고 꾸짖었냐?"
    } ]
  }, {
    "tStartMs": 402840,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 403870,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "트럼프 대통령은"
    } ]
  }, {
    "tStartMs": 404800,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "자유세계를 위해 일을 하고 계신다"
    } ]
  }, {
    "tStartMs": 406910,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "일하는 미국 자유세계의"
    } ]
  }, {
    "tStartMs": 408240,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "직접적인 위협 아니냐"
    } ]
  }, {
    "tStartMs": 409320,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "그럼에도 불구하고"
    } ]
  }, {
    "tStartMs": 410760,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "세계, 중동"
    } ]
  }, {
    "tStartMs": 411760,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "그리고 은혜를 모르는"
    } ]
  }, {
    "tStartMs": 412580,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "저런 유럽, 나토 동맹국들"
    } ]
  }, {
    "tStartMs": 414960,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "심지어 언론들까지"
    } ]
  }, {
    "tStartMs": 416320,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "트럼프 대통령에게 말해야 된다"
    } ]
  }, {
    "tStartMs": 418520,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "땡큐라고"
    } ]
  }, {
    "tStartMs": 420000,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "감사합니다라고"
    } ]
  }, {
    "tStartMs": 421320,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "감사를 이런 모르는 놈들"
    } ]
  }, {
    "tStartMs": 423420,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "자유세계를 위해서 대신 앞장서 가지고"
    } ]
  }, {
    "tStartMs": 425670,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "세계의 적, 이란과 지금 싸우고 있는데"
    } ]
  }, {
    "tStartMs": 427830,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "핵무기를 갖고 있는 직접적인"
    } ]
  }, {
    "tStartMs": 429280,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "미국과 이란과 싸우고 있는데"
    } ]
  }, {
    "tStartMs": 430890,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "지금 이렇게 감사하는 걸 모르냐?"
    } ]
  }, {
    "tStartMs": 432900,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "라고 꾸짖었고요"
    } ]
  }, {
    "tStartMs": 434590,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "미사일로 세계를 인질로 잡고"
    } ]
  }, {
    "tStartMs": 436390,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "핵폭탄을 만들거나"
    } ]
  }, {
    "tStartMs": 437510,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "핵폭탄을 쓰려고 시도하는"
    } ]
  }, {
    "tStartMs": 439130,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "이 테러 국가를 막아내준"
    } ]
  }, {
    "tStartMs": 440600,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "용기를 내주셔서"
    } ]
  }, {
    "tStartMs": 442060,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "감사합니다 라고 이야기해요"
    } ]
  }, {
    "tStartMs": 444770,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "이런 용기를 내주신 트럼프 대통령이 아니었다면"
    } ]
  }, {
    "tStartMs": 446760,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "지금 이란이 얼마나"
    } ]
  }, {
    "tStartMs": 447690,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "이 자유세계를 위협하겠냐"
    } ]
  }, {
    "tStartMs": 449240,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "트럼프 대통령에게"
    } ]
  }, {
    "tStartMs": 450100,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "감사해라 그래요"
    } ]
  }, {
    "tStartMs": 452160,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "또 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 453410,
    "dDurationMs": 3710,
    "segs": [ {
      "utf8": "자유세계의 역할을 해주셔서 감사합니다"
    } ]
  }, {
    "tStartMs": 457120,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "Thank you for"
    } ]
  }, {
    "tStartMs": 458730,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "Doing the work for the free world인데"
    } ]
  }, {
    "tStartMs": 461500,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "그래요"
    } ]
  }, {
    "tStartMs": 462500,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "이런 감사하는 걸 모르고"
    } ]
  }, {
    "tStartMs": 464160,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "감사해라라고 또"
    } ]
  }, {
    "tStartMs": 465980,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "일침을 날려주셨죠"
    } ]
  }, {
    "tStartMs": 468010,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "참, 그 동맹국들이 감사해야 되는데"
    } ]
  }, {
    "tStartMs": 470060,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "그것도 모르고"
    } ]
  }, {
    "tStartMs": 471140,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "호르무즈 해협에 군함도 안 보내고"
    } ]
  }, {
    "tStartMs": 472630,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "이래서 극대노"
    } ]
  }, {
    "tStartMs": 474800,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "이런 상황에서"
    } ]
  }, {
    "tStartMs": 476520,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "일본의 다카이치 총리는"
    } ]
  }, {
    "tStartMs": 478150,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "미국에서 미∙일 정상회담이 예정돼 있었습니다"
    } ]
  }, {
    "tStartMs": 481430,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "굉장히 살얼음판을 걷는 순간이죠"
    } ]
  }, {
    "tStartMs": 484360,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "감사하지도 못하는 이런 것도"
    } ]
  }, {
    "tStartMs": 485910,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "호르무즈에 군함도 안 보내고"
    } ]
  }, {
    "tStartMs": 487440,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "오늘 일본이 오네?"
    } ]
  }, {
    "tStartMs": 488820,
    "dDurationMs": 3790,
    "segs": [ {
      "utf8": "3월 20일 정상회담이 진행될 예정입니다"
    } ]
  }, {
    "tStartMs": 492610,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "일본은 호르무즈에 군함을 보냈냐?"
    } ]
  }, {
    "tStartMs": 495330,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "정상회담 직전에"
    } ]
  }, {
    "tStartMs": 496790,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "군함 요청에 거절 의사를 살포시 밝혔어요"
    } ]
  }, {
    "tStartMs": 500000,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "죄송합니다"
    } ]
  }, {
    "tStartMs": 500960,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "일본은 페르시아만에 군함을"
    } ]
  }, {
    "tStartMs": 502900,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "파견할 계획이 없습니다"
    } ]
  }, {
    "tStartMs": 504610,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "라고 살짝 밝혔는데"
    } ]
  }, {
    "tStartMs": 506000,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "그러면서 이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 507250,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "이번 정상회담에서 내가 설득해보겠다"
    } ]
  }, {
    "tStartMs": 510020,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "설명해보겠다 뭐를?"
    } ]
  }, {
    "tStartMs": 512300,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "보내고 싶었는데"
    } ]
  }, {
    "tStartMs": 513910,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "헌법 때문에"
    } ]
  }, {
    "tStartMs": 515120,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "평화헌법이잖아"
    } ]
  }, {
    "tStartMs": 516480,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "평화헌법 때문에 보낼 수가 없어요"
    } ]
  }, {
    "tStartMs": 518960,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "아유 저거 헌법만 있어도"
    } ]
  }, {
    "tStartMs": 520360,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "그냥 확 보내서 도움을 드리고 싶었는데"
    } ]
  }, {
    "tStartMs": 523610,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "일본은 군대 갈 수 없고"
    } ]
  }, {
    "tStartMs": 524940,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "전쟁에 참여 안 하고"
    } ]
  }, {
    "tStartMs": 526090,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "평화 그쵸"
    } ]
  }, {
    "tStartMs": 526700,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "뭐 이런 거 있잖아요"
    } ]
  }, {
    "tStartMs": 527520,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "그런 것 때문에"
    } ]
  }, {
    "tStartMs": 528740,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "정말 어쩔 수 없이"
    } ]
  }, {
    "tStartMs": 530080,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "마음은 200%, 300% 보여주고 싶었는데"
    } ]
  }, {
    "tStartMs": 531930,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "어쩔 수 없이 그랬기 때문에"
    } ]
  }, {
    "tStartMs": 533430,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "아마 이해해 주지 않을까라고 확신한다"
    } ]
  }, {
    "tStartMs": 537180,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "라고 얘기하면서"
    } ]
  }, {
    "tStartMs": 537880,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "이번에 미・일 정상회담으로"
    } ]
  }, {
    "tStartMs": 539760,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "다카이치 총리가 갔죠"
    } ]
  }, {
    "tStartMs": 540960,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "그리고 어떻게 트럼프 대통령이"
    } ]
  }, {
    "tStartMs": 542980,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "저걸 설명할 건가라고"
    } ]
  }, {
    "tStartMs": 544140,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "사실 좀 궁금해하고 있었는데"
    } ]
  }, {
    "tStartMs": 546060,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "다카이치 총리가 트럼프 대통령을 처음 보자마자"
    } ]
  }, {
    "tStartMs": 548560,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "한 행동이 있습니다"
    } ]
  }, {
    "tStartMs": 549380,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "처음 보자마자 뭘 했냐?"
    } ]
  }, {
    "tStartMs": 551950,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "바로 이 행동을 했습니다"
    } ]
  }, {
    "tStartMs": 553090,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "하..."
    } ]
  }, {
    "tStartMs": 556290,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "내리자마자"
    } ]
  }, {
    "tStartMs": 557530,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "차에서 탁 내리자마자"
    } ]
  }, {
    "tStartMs": 558910,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "갑자기 트럼프를 향해"
    } ]
  }, {
    "tStartMs": 560540,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "폴싹!"
    } ]
  }, {
    "tStartMs": 561370,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "폭!"
    } ]
  }, {
    "tStartMs": 562620,
    "dDurationMs": 410,
    "segs": [ {
      "utf8": "각하!"
    } ]
  }, {
    "tStartMs": 563030,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "하면서 안기는 거죠"
    } ]
  }, {
    "tStartMs": 564930,
    "dDurationMs": 7350,
    "segs": [ {
      "utf8": "이 장면 영상으로 보여드리겠습니다"
    } ]
  }, {
    "tStartMs": 574310,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "이게 굉장히 화제가 됐어요"
    } ]
  }, {
    "tStartMs": 579090,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "물론 완전히 폴짝 안기는 건 아닌데"
    } ]
  }, {
    "tStartMs": 581960,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "굉장히 친근한 모습으로"
    } ]
  }, {
    "tStartMs": 583810,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "정상 대 정상에서"
    } ]
  }, {
    "tStartMs": 584940,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "저 정도면 굉장히 친근한 거죠"
    } ]
  }, {
    "tStartMs": 586300,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "굉장히 친근한 모습으로"
    } ]
  }, {
    "tStartMs": 587740,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "확 안기는 그런 모습을 보여줬고요"
    } ]
  }, {
    "tStartMs": 589890,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "이런 걸 시작으로"
    } ]
  }, {
    "tStartMs": 590870,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "미・일 정상회담이 시작됐습니다"
    } ]
  }, {
    "tStartMs": 592900,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "미・일 정상회담 시작하자마자"
    } ]
  }, {
    "tStartMs": 594820,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "이 다카이치 일본 총리가 이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 596760,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "이런 어려운 상황 속에서도"
    } ]
  }, {
    "tStartMs": 598350,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "저는 전 세계의 평화를 가져오실 수 있는 분은"
    } ]
  }, {
    "tStartMs": 600950,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "오직 도널드"
    } ]
  }, {
    "tStartMs": 602650,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "당신 뿐이라고 믿습니다"
    } ]
  }, {
    "tStartMs": 604060,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "아 도널드"
    } ]
  }, {
    "tStartMs": 605160,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "노벨 평화상이 두 개가 있다면"
    } ]
  }, {
    "tStartMs": 606780,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "두 개를 다 드려야 될 분이 아닌가"
    } ]
  }, {
    "tStartMs": 608030,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "생각을 합니다"
    } ]
  }, {
    "tStartMs": 609100,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "도널드 당신만이 전 세계의"
    } ]
  }, {
    "tStartMs": 610480,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "평화를 가져오실 수 있어요"
    } ]
  }, {
    "tStartMs": 612060,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "라고 이제 악수로 얘기를 하면서"
    } ]
  }, {
    "tStartMs": 614780,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "미・일 정상회담이 시작이 됐죠"
    } ]
  }, {
    "tStartMs": 616790,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "정상회담 얘기가 쭉 나오는데"
    } ]
  }, {
    "tStartMs": 618340,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "지루한 건 다 빼고"
    } ]
  }, {
    "tStartMs": 619380,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "가장 화제가 됐던 건"
    } ]
  }, {
    "tStartMs": 620240,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "여러분들도 신문에서 많이 보셨을 거예요"
    } ]
  }, {
    "tStartMs": 622820,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "한 일본 기자가"
    } ]
  }, {
    "tStartMs": 624170,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "정상회담이 무난하게 진행되고 있었어요"
    } ]
  }, {
    "tStartMs": 625830,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "뭐 별다른 트러블도 없이"
    } ]
  }, {
    "tStartMs": 627260,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "쭉 진행되고 있었는데"
    } ]
  }, {
    "tStartMs": 628220,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "하하호호하고"
    } ]
  }, {
    "tStartMs": 629420,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "앞에는 미국의 그 캐비닛들이 다 앉아있습니다"
    } ]
  }, {
    "tStartMs": 632300,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "부통령도 앉아있고"
    } ]
  }, {
    "tStartMs": 633350,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "외무장관도 앉아있고"
    } ]
  }, {
    "tStartMs": 634570,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "이쪽에서 일본의 내각들이 앉아있고"
    } ]
  }, {
    "tStartMs": 636060,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "그런 상황인데"
    } ]
  }, {
    "tStartMs": 637020,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "한 일본 기자가"
    } ]
  }, {
    "tStartMs": 637900,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "갑자기 질문을 했어요"
    } ]
  }, {
    "tStartMs": 640100,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "그 이란 전쟁할 때"
    } ]
  }, {
    "tStartMs": 641470,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "선전포고도 안하고 기습하셨지 않습니까?"
    } ]
  }, {
    "tStartMs": 643850,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "왜 동맹국들에게 이란 전쟁 계획을"
    } ]
  }, {
    "tStartMs": 645960,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "알리지 않았나요?"
    } ]
  }, {
    "tStartMs": 647150,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "동맹국들에게 좀 알려줘야 되는 거 아니었습니까?"
    } ]
  }, {
    "tStartMs": 649690,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "라고 얘기를 했죠"
    } ]
  }, {
    "tStartMs": 650780,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "그러니까 트럼프 대통령의 표정이 갑자기 사악 굳더니"
    } ]
  }, {
    "tStartMs": 653780,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "우리는 기습을 원했습니다"
    } ]
  }, {
    "tStartMs": 655730,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "서프라이즈를 원했어요"
    } ]
  }, {
    "tStartMs": 657350,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "그리고 그 다음 말에"
    } ]
  }, {
    "tStartMs": 658600,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "이번 회담에 가장 유명한 말을 했습니다"
    } ]
  }, {
    "tStartMs": 661840,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "선전포고 안 하고 기습하는 거 그거"
    } ]
  }, {
    "tStartMs": 663900,
    "dDurationMs": 3530,
    "segs": [ {
      "utf8": "일본이 가장 잘 알지 않습니까?"
    } ]
  }, {
    "tStartMs": 667430,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "당신들 진주만 갈 때"
    } ]
  }, {
    "tStartMs": 669060,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "얘기했어요?"
    } ]
  }, {
    "tStartMs": 671170,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "이게 명장면이었어요"
    } ]
  }, {
    "tStartMs": 672450,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "이게"
    } ]
  }, {
    "tStartMs": 673220,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "선전포고도 없이 기습하고"
    } ]
  }, {
    "tStartMs": 674920,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "동맹들에게 왜 알리지 않았습니까?"
    } ]
  }, {
    "tStartMs": 676450,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "라고 일본 기자가 지적하니까"
    } ]
  }, {
    "tStartMs": 678090,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "너도 안 했잖아!"
    } ]
  }, {
    "tStartMs": 679460,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "야 진주만 할 때"
    } ]
  }, {
    "tStartMs": 680250,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "우리한테 얘기했어?"
    } ]
  }, {
    "tStartMs": 681370,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "안 했잖아! 라고 얘기를 하고"
    } ]
  }, {
    "tStartMs": 684190,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "이제 싹 웃으시면서"
    } ]
  }, {
    "tStartMs": 685320,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "농담처럼 하하하하고 넘어갔는데"
    } ]
  }, {
    "tStartMs": 688110,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "물론 트럼프 대통령이 농담이라고 하신 건데"
    } ]
  }, {
    "tStartMs": 691690,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "듣고 있던"
    } ]
  }, {
    "tStartMs": 692910,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "그 다카이치 총리의 표정이"
    } ]
  }, {
    "tStartMs": 697250,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "이게 그 영상 보여드릴게요"
    } ]
  }, {
    "tStartMs": 698980,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "뭔가 이렇게"
    } ]
  }, {
    "tStartMs": 700000,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "웃긴 웃는"
    } ]
  }, {
    "tStartMs": 701020,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "이분 웃는데"
    } ]
  }, {
    "tStartMs": 701910,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "눈이 안 웃는"
    } ]
  }, {
    "tStartMs": 703850,
    "dDurationMs": 430,
    "segs": [ {
      "utf8": "이분 웃는데"
    } ]
  }, {
    "tStartMs": 704280,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "눈은 좀 놀래갖고"
    } ]
  }, {
    "tStartMs": 705380,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "이걸 어떻게 해야 되나"
    } ]
  }, {
    "tStartMs": 706270,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "약간 당황하는"
    } ]
  }, {
    "tStartMs": 707480,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "정말 그 당황하는 모습이 또 나왔죠"
    } ]
  }, {
    "tStartMs": 710570,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "그 장면도 보시도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 712760,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "기자한테 얘기한 장면입니다"
    } ]
  }, {
    "tStartMs": 725150,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "너네도 얘기 안했잖아"
    } ]
  }, {
    "tStartMs": 729760,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "다카이치 총리"
    } ]
  }, {
    "tStartMs": 731160,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "표정이 아아..."
    } ]
  }, {
    "tStartMs": 733680,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "아 그만하자 그만하자"
    } ]
  }, {
    "tStartMs": 736060,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "그만하자"
    } ]
  }, {
    "tStartMs": 738420,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "기자야, 기자야?"
    } ]
  }, {
    "tStartMs": 740040,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "기자야, 오케이 됐다 됐다"
    } ]
  }, {
    "tStartMs": 741830,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "이제 그만하자"
    } ]
  }, {
    "tStartMs": 742660,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "어디 기자야 NHK냐"
    } ]
  }, {
    "tStartMs": 743970,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "어디냐 오케이 오케이"
    } ]
  }, {
    "tStartMs": 745180,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "거기까지 하자"
    } ]
  }, {
    "tStartMs": 745950,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "이런 표정을 싹 지어주셨는데"
    } ]
  }, {
    "tStartMs": 748840,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "조금 이따가 계속해야 되잖아요, 회담은"
    } ]
  }, {
    "tStartMs": 750540,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "그 표정이 표정이"
    } ]
  }, {
    "tStartMs": 752550,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "굉장히"
    } ]
  }, {
    "tStartMs": 754870,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "이제 그럴 수밖에 없죠"
    } ]
  }, {
    "tStartMs": 755900,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "그럴 수밖에 없고"
    } ]
  }, {
    "tStartMs": 756880,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "굉장히 당황하신 표정을 지었고"
    } ]
  }, {
    "tStartMs": 759530,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "트럼프 대통령은 일본한테도 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 762220,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "일본은 호르무즈 해협에"
    } ]
  }, {
    "tStartMs": 763210,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "굉장히 의존하고 있는 국가예요"
    } ]
  }, {
    "tStartMs": 764950,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "일본이 더 적극적으로 나서야 합니다"
    } ]
  }, {
    "tStartMs": 766940,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "우리는 주일미군으로 일본을 지켜주잖아요"
    } ]
  }, {
    "tStartMs": 769200,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "우리는 그런 관계이기 때문에"
    } ]
  }, {
    "tStartMs": 770590,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "일본이 더 적극적으로 나서주길 기대합니다"
    } ]
  }, {
    "tStartMs": 772910,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "자, 그래 일본아 군함 보낼 거니?"
    } ]
  }, {
    "tStartMs": 775040,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "라고 물어봤죠"
    } ]
  }, {
    "tStartMs": 776250,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "그 뒤 다카시 총리가 하는"
    } ]
  }, {
    "tStartMs": 777890,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "대답은 이런 거였습니다"
    } ]
  }, {
    "tStartMs": 779550,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "저희가 지난번에 360억 달러"
    } ]
  }, {
    "tStartMs": 782000,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "1차 미국 투자 계획을 발표했는데요"
    } ]
  }, {
    "tStartMs": 785170,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "이번에는 저희가 선물 보따리로"
    } ]
  }, {
    "tStartMs": 786780,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "2배를 갖고 왔습니다"
    } ]
  }, {
    "tStartMs": 788530,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "730억 달러"
    } ]
  }, {
    "tStartMs": 790140,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "물론 5,500억 달러 채우는 것 중에"
    } ]
  }, {
    "tStartMs": 791790,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "하나이긴 하지만"
    } ]
  }, {
    "tStartMs": 792640,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "108조 원"
    } ]
  }, {
    "tStartMs": 793500,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "1차 프로젝트의 2배를 넘는 규모입니다"
    } ]
  }, {
    "tStartMs": 795680,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "이 정도면"
    } ]
  }, {
    "tStartMs": 797120,
    "dDurationMs": 450,
    "segs": [ {
      "utf8": "군함 대신에"
    } ]
  }, {
    "tStartMs": 797570,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "100조 원 하는 거니까"
    } ]
  }, {
    "tStartMs": 799170,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "괜찮지 않으십니까?"
    } ]
  }, {
    "tStartMs": 800790,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "라고 얘기를 했죠"
    } ]
  }, {
    "tStartMs": 802770,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "그래서 회담은 어떻게 끝났는데"
    } ]
  }, {
    "tStartMs": 804070,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "이후에 백악관이 공식적인 사진을"
    } ]
  }, {
    "tStartMs": 807380,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "미・일 정상회담 사진을 쫙 업로드했거든요"
    } ]
  }, {
    "tStartMs": 809240,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "몇 개를"
    } ]
  }, {
    "tStartMs": 809970,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "8개 정도를 업로드했는데"
    } ]
  }, {
    "tStartMs": 811440,
    "dDurationMs": 3730,
    "segs": [ {
      "utf8": "그 중에 이런 사진을 업로드했어요"
    } ]
  }, {
    "tStartMs": 815170,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "백악관 공식 홈페이지에 올라온 사진입니다"
    } ]
  }, {
    "tStartMs": 819210,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "굳이"
    } ]
  }, {
    "tStartMs": 820860,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "남의 나라 총리인데"
    } ]
  }, {
    "tStartMs": 821880,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "그래도 저렇게 좀"
    } ]
  }, {
    "tStartMs": 822870,
    "dDurationMs": 3890,
    "segs": [ {
      "utf8": "물론 되게 좋아하시는 모습이 좋긴 한데"
    } ]
  }, {
    "tStartMs": 826760,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "조금 묘한"
    } ]
  }, {
    "tStartMs": 828730,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "이렇게 좋아하셨다"
    } ]
  }, {
    "tStartMs": 830110,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "그런 걸 올리고 싶었던 것 같긴 한데"
    } ]
  }, {
    "tStartMs": 832710,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "묘한 거를 좀 업로드했죠"
    } ]
  }, {
    "tStartMs": 836030,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "자, 이렇게 미・일 정상회담이 끝났는데"
    } ]
  }, {
    "tStartMs": 838150,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "그리고 트럼프 대통령이 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 840280,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "내가 잘 생각해보니까"
    } ]
  }, {
    "tStartMs": 841860,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "미국은 호르무즈를 지킬 필요가 없어요"
    } ]
  }, {
    "tStartMs": 844810,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "생각해보니까 그래"
    } ]
  }, {
    "tStartMs": 846330,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "야 그게 유럽이나 아시아에 더 중요한 거지"
    } ]
  }, {
    "tStartMs": 849700,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "뭐 미국엔 별 거 없잖아"
    } ]
  }, {
    "tStartMs": 852030,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "호르무즈를 필요에 따라서"
    } ]
  }, {
    "tStartMs": 853570,
    "dDurationMs": 4210,
    "segs": [ {
      "utf8": "이용하는 국가들이 경비하고 감시해야 하는 게 아닐까?"
    } ]
  }, {
    "tStartMs": 857780,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "미국이 굳이 그걸 지켜야 되나?"
    } ]
  }, {
    "tStartMs": 860410,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "라는 얘기를 해서"
    } ]
  }, {
    "tStartMs": 861550,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "굉장히 또 뒤집어졌습니다"
    } ]
  }, {
    "tStartMs": 863810,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "물론 이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 864710,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "물론 미국은 관대하니까"
    } ]
  }, {
    "tStartMs": 867220,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "다른 국가들의 요청이 있으면"
    } ]
  }, {
    "tStartMs": 869070,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "그거 돕기는 할 겁니다"
    } ]
  }, {
    "tStartMs": 870480,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "노력을 돕겠지만"
    } ]
  }, {
    "tStartMs": 871720,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "이란의 위협이 지금 거의 제거됐기 때문에"
    } ]
  }, {
    "tStartMs": 874240,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "사실 그럴 필요도 없어요"
    } ]
  }, {
    "tStartMs": 875240,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "전쟁에서 사실 이겼다니까"
    } ]
  }, {
    "tStartMs": 876780,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "이란 군사력은 망했어"
    } ]
  }, {
    "tStartMs": 878570,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "거의 0%, 남았어 0%"
    } ]
  }, {
    "tStartMs": 879590,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "그냥 드론 조금 보내고"
    } ]
  }, {
    "tStartMs": 881080,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "길에 깔고 하는 거지"
    } ]
  }, {
    "tStartMs": 882230,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "거의 없어요"
    } ]
  }, {
    "tStartMs": 883090,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "그러니까 미국이 별로 도와줄 필요 없고"
    } ]
  }, {
    "tStartMs": 885860,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "관련국들이 가서 시키는 게 당연하지"
    } ]
  }, {
    "tStartMs": 888050,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "않을까 생각합니다"
    } ]
  }, {
    "tStartMs": 889350,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "관련국들이면 어디"
    } ]
  }, {
    "tStartMs": 890500,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "아 그거 그 나라들은?"
    } ]
  }, {
    "tStartMs": 892930,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "예를 들면"
    } ]
  }, {
    "tStartMs": 894350,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "한국은 그 원유의 막대한 부분"
    } ]
  }, {
    "tStartMs": 896360,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "에너지의 상당 부분을"
    } ]
  }, {
    "tStartMs": 897450,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "호르무즈로부터 얻고 있어요"
    } ]
  }, {
    "tStartMs": 899650,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "그렇기 때문에 그들은 당연히"
    } ]
  }, {
    "tStartMs": 901420,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "우리에게 감사해야 되고요"
    } ]
  }, {
    "tStartMs": 903100,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "그것 뿐만 아니라"
    } ]
  }, {
    "tStartMs": 904110,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "우리를 당연히"
    } ]
  }, {
    "tStartMs": 905320,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "도와야 하는 게 아닐까요?"
    } ]
  }, {
    "tStartMs": 907040,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "라고 또 말씀하셨죠"
    } ]
  }, {
    "tStartMs": 910590,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "그래서 또 가슴이"
    } ]
  }, {
    "tStartMs": 912150,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "두근반, 세근반 뭐 이러고 있는데"
    } ]
  }, {
    "tStartMs": 914440,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "이 자료를 만든 와중에"
    } ]
  }, {
    "tStartMs": 915960,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "갑자기 트럼프 대통령이 화를 벌컥 내시더니"
    } ]
  }, {
    "tStartMs": 919040,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "이런 SNS를 올렸습니다"
    } ]
  }, {
    "tStartMs": 921150,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "이란은 지금부터 정확히 48시간 이내에"
    } ]
  }, {
    "tStartMs": 924190,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "아무런 위협 없이"
    } ]
  }, {
    "tStartMs": 925710,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "호르무즈 해협을 개방해라"
    } ]
  }, {
    "tStartMs": 927760,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "이거 올라온 지 얼마 안 된 트윗입니다"
    } ]
  }, {
    "tStartMs": 929600,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "지금부터 진짜 48시간입니다"
    } ]
  }, {
    "tStartMs": 931580,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "개방을 안 하면"
    } ]
  }, {
    "tStartMs": 933000,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "미국은 이란의 여러 원자력 발전소를 포함해서"
    } ]
  }, {
    "tStartMs": 937180,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "가장 큰 발전소부터 시작해서"
    } ]
  }, {
    "tStartMs": 939570,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "원자력 발전소들을 완전히"
    } ]
  }, {
    "tStartMs": 941890,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "파괴할 것이다"
    } ]
  }, {
    "tStartMs": 943570,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "지금까지 미국의 이란 폭격은"
    } ]
  }, {
    "tStartMs": 946060,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "원자력 발전소나"
    } ]
  }, {
    "tStartMs": 947460,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "아니면 그 기타 다른 발전소들"
    } ]
  }, {
    "tStartMs": 949660,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "유전, 아니면 기타 국가 설비들"
    } ]
  }, {
    "tStartMs": 951930,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "담수화 설비"
    } ]
  }, {
    "tStartMs": 953150,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "이런 거를 타겟으로 하진 않았습니다"
    } ]
  }, {
    "tStartMs": 955780,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "여기를 타겟하기 시작하면"
    } ]
  }, {
    "tStartMs": 957490,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "이란은 정말"
    } ]
  }, {
    "tStartMs": 959450,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "정말로 어려워지겠죠"
    } ]
  }, {
    "tStartMs": 960800,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "발전소를 파괴해버리면"
    } ]
  }, {
    "tStartMs": 963240,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "발전소 다시 짓는데"
    } ]
  }, {
    "tStartMs": 964820,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "하루 이틀이 걸리는 것도 아니고"
    } ]
  }, {
    "tStartMs": 966560,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "전기가 없어진다는 말과 똑같으니까"
    } ]
  }, {
    "tStartMs": 969470,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "그리고 발전망들"
    } ]
  }, {
    "tStartMs": 971140,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "다 부숴버리고"
    } ]
  }, {
    "tStartMs": 972150,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "원전 같은 것들 다 파괴해버리면"
    } ]
  }, {
    "tStartMs": 974690,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "정말 어려워질 수 있는데"
    } ]
  }, {
    "tStartMs": 976350,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "그걸 경고한 거죠"
    } ]
  }, {
    "tStartMs": 977860,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "48시간 내에 호르무즈 해협을"
    } ]
  }, {
    "tStartMs": 979480,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "개방하지 않으면"
    } ]
  }, {
    "tStartMs": 980600,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "원전을 파괴하겠다"
    } ]
  }, {
    "tStartMs": 982740,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "물론 트럼프 대통령의 이 발표 직전에"
    } ]
  }, {
    "tStartMs": 985540,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "이란과 이스라엘이"
    } ]
  }, {
    "tStartMs": 986830,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "서로의 핵시설을 공격한 일이 있었습니다"
    } ]
  }, {
    "tStartMs": 989380,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "이스라엘은 이란의 나탄즈라는"
    } ]
  }, {
    "tStartMs": 991080,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "핵시설을 공격했고요"
    } ]
  }, {
    "tStartMs": 992540,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "여기요 부셔져 있죠"
    } ]
  }, {
    "tStartMs": 993700,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "이란은 이에 대한 보복으로"
    } ]
  }, {
    "tStartMs": 994880,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "이스라엘의 디모나 여기도"
    } ]
  }, {
    "tStartMs": 996040,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "이스라엘의 핵연구소가 있다고 알려진 곳입니다"
    } ]
  }, {
    "tStartMs": 999120,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "서로 여기를 공격한 일이 있었어요"
    } ]
  }, {
    "tStartMs": 1000910,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "아마 이게 트리거가 되지 않나 생각하는데"
    } ]
  }, {
    "tStartMs": 1003340,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "48시간 내에 호르무즈 해협을 개방해라"
    } ]
  }, {
    "tStartMs": 1006880,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "이란 군사작전사령부는"
    } ]
  }, {
    "tStartMs": 1008750,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "역시 담화문을 발표했는데"
    } ]
  }, {
    "tStartMs": 1010350,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1011590,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "만일 적군이 이란의 연료 및"
    } ]
  }, {
    "tStartMs": 1013480,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "에너지 기반 시설을 침해할 경우에"
    } ]
  }, {
    "tStartMs": 1016110,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "미국과 그 정권이 중동 지역에서 보유한"
    } ]
  }, {
    "tStartMs": 1018670,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "모든 에너지 시설 및"
    } ]
  }, {
    "tStartMs": 1020360,
    "dDurationMs": 3890,
    "segs": [ {
      "utf8": "해수 담수화 시설을 공격 대상으로 삼을 것이다"
    } ]
  }, {
    "tStartMs": 1024250,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "중동 유전이나"
    } ]
  }, {
    "tStartMs": 1025660,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "중동 에너지 시설"
    } ]
  }, {
    "tStartMs": 1027100,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "송유관, 송유시설"
    } ]
  }, {
    "tStartMs": 1029220,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "해수 담수화 시설"
    } ]
  }, {
    "tStartMs": 1031490,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "이란이 페르시아만"
    } ]
  }, {
    "tStartMs": 1032860,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "건너편에 있는 중동으로"
    } ]
  }, {
    "tStartMs": 1034340,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "저기를 때리기 시작하면"
    } ]
  }, {
    "tStartMs": 1036290,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "왜냐하면 여긴 한두 군데가 아니잖아요"
    } ]
  }, {
    "tStartMs": 1038160,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "방어해야 될 곳이"
    } ]
  }, {
    "tStartMs": 1038940,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "한두 군데가 아니기 때문에"
    } ]
  }, {
    "tStartMs": 1040580,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "만약에 중동의"
    } ]
  }, {
    "tStartMs": 1041520,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "모든 에너지 기반 시설을"
    } ]
  }, {
    "tStartMs": 1043330,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "이란이 타격한다"
    } ]
  }, {
    "tStartMs": 1044690,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "물론 이란이 얼마나 타격할 수 있을지는 모르겠지만"
    } ]
  }, {
    "tStartMs": 1047510,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "그게 현실화되면"
    } ]
  }, {
    "tStartMs": 1049620,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "유가가 더 오르겠죠"
    } ]
  }, {
    "tStartMs": 1050820,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "그게 현실화되면 안 되죠"
    } ]
  }, {
    "tStartMs": 1052270,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "그럼 중동 전쟁이잖아요"
    } ]
  }, {
    "tStartMs": 1053900,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "그걸 공격받는 중동 국가들이"
    } ]
  }, {
    "tStartMs": 1055580,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "가만히 있지는 않을 것 같으니까"
    } ]
  }, {
    "tStartMs": 1057620,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "저게 현실화되면 안 되는데"
    } ]
  }, {
    "tStartMs": 1059980,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "48시간 위협을 한 상황이기 때문에"
    } ]
  }, {
    "tStartMs": 1062720,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "굉장히 좀 두근반 세근반 하죠"
    } ]
  }, {
    "tStartMs": 1065400,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "근데 정말 이 전쟁은"
    } ]
  }, {
    "tStartMs": 1067090,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "예측할 수 없는 게"
    } ]
  }, {
    "tStartMs": 1068170,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "그럼 강대강으로 가는 거냐"
    } ]
  }, {
    "tStartMs": 1069470,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "그거는 이 트럼프 대통령이라는 사람을"
    } ]
  }, {
    "tStartMs": 1071790,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "예측이 안 돼요"
    } ]
  }, {
    "tStartMs": 1072650,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "저런 말을 하면서"
    } ]
  }, {
    "tStartMs": 1073700,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "또 다른 쪽으로는"
    } ]
  }, {
    "tStartMs": 1074830,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "이란 전쟁의 단계적 축소를"
    } ]
  }, {
    "tStartMs": 1076480,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "고려한다고 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1078260,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "그래서 무슨 말 하는지 모르겠어요"
    } ]
  }, {
    "tStartMs": 1080000,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "호르무즈 해협은 동맹이 지켜라"
    } ]
  }, {
    "tStartMs": 1081380,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "미국은 손 뗄 거야, 흥!"
    } ]
  }, {
    "tStartMs": 1082830,
    "dDurationMs": 450,
    "segs": [ {
      "utf8": "하더니"
    } ]
  }, {
    "tStartMs": 1083280,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "그 다음 말은 48시간 내에 개방 안 하면"
    } ]
  }, {
    "tStartMs": 1085380,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "너희들 모두 날려버릴 거야, 흥!"
    } ]
  }, {
    "tStartMs": 1086990,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "그러니 또 그 다음 말은"
    } ]
  }, {
    "tStartMs": 1088070,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "이란 전쟁의"
    } ]
  }, {
    "tStartMs": 1088570,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "단계적 축소를 고려합니다"
    } ]
  }, {
    "tStartMs": 1089820,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "그래서 어려워"
    } ]
  }, {
    "tStartMs": 1092420,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "이게 무슨 말인지 정확히 모르겠어요"
    } ]
  }, {
    "tStartMs": 1094460,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "왔다 갔다 하는데"
    } ]
  }, {
    "tStartMs": 1095610,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "이 말도 하긴 하셨습니다"
    } ]
  }, {
    "tStartMs": 1096830,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 1097740,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "우리는 이란 테러 정권에 대한"
    } ]
  }, {
    "tStartMs": 1098940,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "대규모 군사 작전을 단계적으로"
    } ]
  }, {
    "tStartMs": 1100600,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "축소하는 방안을 검토 중입니다"
    } ]
  }, {
    "tStartMs": 1102160,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "왜냐하면 목표 달성에"
    } ]
  }, {
    "tStartMs": 1103560,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "매우 근접해 있기 때문입니다"
    } ]
  }, {
    "tStartMs": 1105370,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "사실상 이겼어"
    } ]
  }, {
    "tStartMs": 1106730,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "그러니까 이겼으니까"
    } ]
  }, {
    "tStartMs": 1107650,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "이제 단계적으로 축소해야지"
    } ]
  }, {
    "tStartMs": 1109760,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "백악관 대변인 캐롤라이 리빗도"
    } ]
  }, {
    "tStartMs": 1111470,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 1112480,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "대통령과 국방부는 임무를 완성하는데"
    } ]
  }, {
    "tStartMs": 1114520,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "약 4에서 6주가 걸릴 것으로 예상했습니다"
    } ]
  }, {
    "tStartMs": 1116850,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "그런데 3주가 지났네요"
    } ]
  }, {
    "tStartMs": 1119360,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "거의 다 왔다는 거죠"
    } ]
  }, {
    "tStartMs": 1120610,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "최소 절반 이상은"
    } ]
  }, {
    "tStartMs": 1122070,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "왔다는 것처럼 얘기를 했습니다"
    } ]
  }, {
    "tStartMs": 1125250,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "그래서 이게 진짜 다 온 거냐?"
    } ]
  }, {
    "tStartMs": 1127680,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "확전인 거냐?"
    } ]
  }, {
    "tStartMs": 1129080,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "해협이 풀리는 거냐?"
    } ]
  }, {
    "tStartMs": 1130760,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "정유시설을 공격하는 거냐?"
    } ]
  }, {
    "tStartMs": 1132810,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "아니 심지어 지상군 파병도 하는 거냐?"
    } ]
  }, {
    "tStartMs": 1135450,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "이것도 왜 그런 말을 하냐면"
    } ]
  }, {
    "tStartMs": 1136980,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "단계적으로 축소한다고"
    } ]
  }, {
    "tStartMs": 1138340,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "그러면서 복수의 미국 언론이"
    } ]
  }, {
    "tStartMs": 1140250,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "미 지상군의 이란 파견을 보도했다"
    } ]
  }, {
    "tStartMs": 1143280,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "그래서 모르겠어요"
    } ]
  }, {
    "tStartMs": 1144850,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "지상군, 해병대가 지상으로 가고 있다"
    } ]
  }, {
    "tStartMs": 1147650,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "물론 뭐 교체하기 위한 병력이라고 얘기를 했는데"
    } ]
  }, {
    "tStartMs": 1150560,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "그럼 단계적 축소입니까?"
    } ]
  }, {
    "tStartMs": 1152360,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "지상군 파견입니까?"
    } ]
  }, {
    "tStartMs": 1153910,
    "dDurationMs": 480,
    "segs": [ {
      "utf8": "라고 물었더니"
    } ]
  }, {
    "tStartMs": 1154390,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "트럼프 대통령이 이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 1155840,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "저는 어디에도 병력을 파병하지 않을 것입니다"
    } ]
  }, {
    "tStartMs": 1158650,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "지상군 보낼 계획이 없어요"
    } ]
  }, {
    "tStartMs": 1160510,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "오 안 보내는군요"
    } ]
  }, {
    "tStartMs": 1162050,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "다행입니다"
    } ]
  }, {
    "tStartMs": 1163000,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "그랬더니 또 이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 1164430,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "물론 파병할 계획이 있어도"
    } ]
  }, {
    "tStartMs": 1166140,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "여러분한테 말씀드리진 않을 겁니다"
    } ]
  }, {
    "tStartMs": 1169660,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "뭐, 뭐예요?"
    } ]
  }, {
    "tStartMs": 1170560,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "파병을 한다는 겁니까?"
    } ]
  }, {
    "tStartMs": 1171570,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "안 한다는 겁니까?"
    } ]
  }, {
    "tStartMs": 1172490,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "계획이 있어도 말하지 않을 거야"
    } ]
  }, {
    "tStartMs": 1174240,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "하지만 계획은 지금은 없어"
    } ]
  }, {
    "tStartMs": 1176000,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "앞으로 있는 겁니까?"
    } ]
  }, {
    "tStartMs": 1176970,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "그건 모르지"
    } ]
  }, {
    "tStartMs": 1178000,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "그래서 이게 한다는 뜻입니까?"
    } ]
  }, {
    "tStartMs": 1179480,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "안 한다는 뜻입니까?"
    } ]
  }, {
    "tStartMs": 1180160,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "나중에 백악관에 물어보니까"
    } ]
  }, {
    "tStartMs": 1181660,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "백악관이 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1183450,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "오피셜로 얘기했는데"
    } ]
  }, {
    "tStartMs": 1184720,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "트럼프 대통령이 말했듯이"
    } ]
  }, {
    "tStartMs": 1186150,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "지금 파병할 계획은 없습니다"
    } ]
  }, {
    "tStartMs": 1187840,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "아, 그럼 파병 안 한다는 거군요 아니요"
    } ]
  }, {
    "tStartMs": 1190140,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "대통령은 현명하게도"
    } ]
  }, {
    "tStartMs": 1191310,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "자신의 군사 전략을"
    } ]
  }, {
    "tStartMs": 1192520,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "언론에 공개하지 않습니다"
    } ]
  }, {
    "tStartMs": 1195230,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "한다는 겁니까?"
    } ]
  }, {
    "tStartMs": 1196960,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1197800,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "아 그거요?"
    } ]
  }, {
    "tStartMs": 1199120,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "한다는 것도 아니고"
    } ]
  }, {
    "tStartMs": 1199960,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "안 한다는 것도 아닙니다"
    } ]
  }, {
    "tStartMs": 1200840,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "그게 무슨 말입니까?"
    } ]
  }, {
    "tStartMs": 1201890,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "국방부가 지상군 파병 계획안을"
    } ]
  }, {
    "tStartMs": 1204390,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "최고사령관에게 제출했죠"
    } ]
  }, {
    "tStartMs": 1206450,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "했어요 그거는"
    } ]
  }, {
    "tStartMs": 1207650,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "최고 사령관에게 대통령의 선택권을"
    } ]
  }, {
    "tStartMs": 1209590,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "제공하기 위해서 드린 거예요"
    } ]
  }, {
    "tStartMs": 1210970,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "그럼 파병한다는 겁니까?"
    } ]
  }, {
    "tStartMs": 1212140,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "아, 그건 아니고"
    } ]
  }, {
    "tStartMs": 1213610,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "대통령의 결정을 내리지는 않았어요"
    } ]
  }, {
    "tStartMs": 1215900,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "현재로서는 지상군을 파병할 계획은 없죠"
    } ]
  }, {
    "tStartMs": 1218630,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "그럼 없는 겁니까?"
    } ]
  }, {
    "tStartMs": 1219420,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "아, 계획안은 올렸어요"
    } ]
  }, {
    "tStartMs": 1221520,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "한다는 겁니까?"
    } ]
  }, {
    "tStartMs": 1222280,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "안 한다는 겁니까?"
    } ]
  }, {
    "tStartMs": 1223030,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "결정을 내린 건 아닙니다"
    } ]
  }, {
    "tStartMs": 1224770,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "이건 무슨 말일까요"
    } ]
  }, {
    "tStartMs": 1227250,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "맞는 것 같아요"
    } ]
  }, {
    "tStartMs": 1228260,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "그런데 대통령이 결정을 안 내려서"
    } ]
  }, {
    "tStartMs": 1230670,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "대통령 결정에 달렸습니다"
    } ]
  }, {
    "tStartMs": 1232280,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "이거 완전히 동전 던지기죠"
    } ]
  }, {
    "tStartMs": 1233670,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "코인 플립 하는 거죠"
    } ]
  }, {
    "tStartMs": 1235560,
    "dDurationMs": 530,
    "segs": [ {
      "utf8": "앞!"
    } ]
  }, {
    "tStartMs": 1236090,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "하면 앞인 거고"
    } ]
  }, {
    "tStartMs": 1236650,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "뒤! 하면 뒤인데"
    } ]
  }, {
    "tStartMs": 1238730,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "하는 것도 아니고"
    } ]
  }, {
    "tStartMs": 1239960,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "안 하는 것도 아닌"
    } ]
  }, {
    "tStartMs": 1241470,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "거의 뫼비우스의 띠와 같은"
    } ]
  }, {
    "tStartMs": 1243150,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "상황이라고 보시면 됩니다"
    } ]
  }, {
    "tStartMs": 1244220,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "관찰을 안 하면"
    } ]
  }, {
    "tStartMs": 1245540,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "파병을 하는 거고요"
    } ]
  }, {
    "tStartMs": 1246640,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "관찰을 하면"
    } ]
  }, {
    "tStartMs": 1247810,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "그 순간"
    } ]
  }, {
    "tStartMs": 1248680,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "파병을 안 하는 게 될 수도 있습니다"
    } ]
  }, {
    "tStartMs": 1250690,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "관찰을 안 하고 있는 게"
    } ]
  }, {
    "tStartMs": 1252300,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "낫지 않을까 생각이 됩니다"
    } ]
  }, {
    "tStartMs": 1254560,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "네타냐후 이스라엘 총리는 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1256990,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "이란 전쟁은"
    } ]
  }, {
    "tStartMs": 1257860,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "사람들이 생각하는 것보다"
    } ]
  }, {
    "tStartMs": 1259370,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "더 빨리 끝날 수 있다"
    } ]
  }, {
    "tStartMs": 1261370,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "라고 얘기를 해서"
    } ]
  }, {
    "tStartMs": 1262720,
    "dDurationMs": 4190,
    "segs": [ {
      "utf8": "이게 뭐 너무나 상반된 얘기들을"
    } ]
  }, {
    "tStartMs": 1266910,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "반복적으로 하니까"
    } ]
  }, {
    "tStartMs": 1268690,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "불확실성이 이렇게 많은 전쟁도 처음 봤다"
    } ]
  }, {
    "tStartMs": 1270850,
    "dDurationMs": 540,
    "segs": [ {
      "utf8": "예를 들면"
    } ]
  }, {
    "tStartMs": 1271390,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "우크라이나 러시아 전쟁은"
    } ]
  }, {
    "tStartMs": 1272740,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "서로 끝난다는 얘기는 안 하잖아요"
    } ]
  }, {
    "tStartMs": 1274550,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "그래서 안 끝나겠구나"
    } ]
  }, {
    "tStartMs": 1275490,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "라고 생각하는데"
    } ]
  }, {
    "tStartMs": 1276130,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "이 전쟁은 뭐"
    } ]
  }, {
    "tStartMs": 1277530,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "끝나는 것 같기도 하고"
    } ]
  }, {
    "tStartMs": 1278300,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "안 끝나는 것 같기도 하고"
    } ]
  }, {
    "tStartMs": 1279810,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "그런 상황이라고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 1281160,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "그리고 이게 얼마 전에"
    } ]
  }, {
    "tStartMs": 1282630,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "지난주에"
    } ]
  }, {
    "tStartMs": 1283450,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "영국 가디언즈가"
    } ]
  }, {
    "tStartMs": 1284480,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "굉장히 특종 같은 보도를 하나 냈습니다"
    } ]
  }, {
    "tStartMs": 1287120,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "뭐라고 냈냐?"
    } ]
  }, {
    "tStartMs": 1287980,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "전쟁 직전에 이란이"
    } ]
  }, {
    "tStartMs": 1289710,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "놀라운 제안을 했다는 보도입니다"
    } ]
  }, {
    "tStartMs": 1292310,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "물론 한 언론사에서 냈기 때문에"
    } ]
  }, {
    "tStartMs": 1294810,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "이게 꼭 정답인지 아닌지 모르겠지만"
    } ]
  }, {
    "tStartMs": 1296770,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "이걸 세계 많은 언론들이 퍼가서"
    } ]
  }, {
    "tStartMs": 1298900,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "내용을 보도했어요"
    } ]
  }, {
    "tStartMs": 1300030,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "그 내용은 이런 겁니다"
    } ]
  }, {
    "tStartMs": 1301040,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "전쟁 직전 이란은"
    } ]
  }, {
    "tStartMs": 1302380,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "지난 2015년의 핵합의안과 다르게"
    } ]
  }, {
    "tStartMs": 1304960,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "일몰조항 없는 한마디로"
    } ]
  }, {
    "tStartMs": 1306860,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "영구적인 핵합의안을 제시했다"
    } ]
  }, {
    "tStartMs": 1309660,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "미국에 제시했다는 거죠"
    } ]
  }, {
    "tStartMs": 1311170,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "IAEA의 감시하에"
    } ]
  }, {
    "tStartMs": 1312640,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "이란은 60% 농축된 우라늄을 폐기하고"
    } ]
  }, {
    "tStartMs": 1315810,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "비가역적인 저농축 우라늄으로"
    } ]
  }, {
    "tStartMs": 1318320,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "전환할 것을 제안했다"
    } ]
  }, {
    "tStartMs": 1320750,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "미국에 이렇게 제안했다는 거고"
    } ]
  }, {
    "tStartMs": 1322660,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "한마디로 이란은"
    } ]
  }, {
    "tStartMs": 1323520,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "농축 우라늄을 포기하고"
    } ]
  }, {
    "tStartMs": 1324990,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "저농축 우라늄은"
    } ]
  }, {
    "tStartMs": 1325860,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "뭐 원전 돌릴 거"
    } ]
  }, {
    "tStartMs": 1327010,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "그런 걸로 전환하고"
    } ]
  }, {
    "tStartMs": 1327890,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "IAEA의 감시도 받고"
    } ]
  }, {
    "tStartMs": 1329340,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "이거는 영구적인 핵 합의안을"
    } ]
  }, {
    "tStartMs": 1330970,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "하겠다라고 얘기를 했다는 거죠"
    } ]
  }, {
    "tStartMs": 1332890,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "그리고 심지어"
    } ]
  }, {
    "tStartMs": 1334030,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "이란이 제시한 미국과 협상에는"
    } ]
  }, {
    "tStartMs": 1335700,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "공동 유전 개발을 포함한"
    } ]
  }, {
    "tStartMs": 1337080,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "석유 및 가스 분야의 공동 이익"
    } ]
  }, {
    "tStartMs": 1338660,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "광업투자"
    } ]
  }, {
    "tStartMs": 1339680,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "심지어 미국 민간항공기"
    } ]
  }, {
    "tStartMs": 1341930,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "보잉기까지 구매하겠다는 내용이"
    } ]
  }, {
    "tStartMs": 1344210,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "들어 있었다고 합니다"
    } ]
  }, {
    "tStartMs": 1346210,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "가디언에 따르면"
    } ]
  }, {
    "tStartMs": 1347580,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "그런데"
    } ]
  }, {
    "tStartMs": 1348580,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "지금 중동지역의 특사로 파견된"
    } ]
  }, {
    "tStartMs": 1350950,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "트럼프 친구"
    } ]
  }, {
    "tStartMs": 1351750,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "위트코프와"
    } ]
  }, {
    "tStartMs": 1352640,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "사위 쿠슈너가"
    } ]
  }, {
    "tStartMs": 1353950,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "이란의 제안을"
    } ]
  }, {
    "tStartMs": 1355340,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "외면했다라고 주장하고 있어요"
    } ]
  }, {
    "tStartMs": 1356700,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "이게 맞는지 틀린지 모르겠습니다"
    } ]
  }, {
    "tStartMs": 1358230,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "중재국인 오만 외무장관이"
    } ]
  }, {
    "tStartMs": 1360490,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "전쟁이 임박했음을 직감하고"
    } ]
  }, {
    "tStartMs": 1362320,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "워싱턴으로 급히 달려가서"
    } ]
  }, {
    "tStartMs": 1364380,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "이란이 이런 제안을 했다고 말을 했는데"
    } ]
  }, {
    "tStartMs": 1366600,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "왜냐하면 이 오만 외무장관은"
    } ]
  }, {
    "tStartMs": 1368300,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "위트코프와 쿠슈너가 고의든 아니든"
    } ]
  }, {
    "tStartMs": 1370640,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "트럼프에게 회담 내용을"
    } ]
  }, {
    "tStartMs": 1371650,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "숨겼다고 믿었다고 합니다"
    } ]
  }, {
    "tStartMs": 1373660,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "숨겼다기보다는"
    } ]
  }, {
    "tStartMs": 1375090,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "이 이란의 제안을 일축했다는 거죠"
    } ]
  }, {
    "tStartMs": 1377790,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "그 정도로는 안 돼"
    } ]
  }, {
    "tStartMs": 1378690,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "이렇게 일축했다는 건데"
    } ]
  }, {
    "tStartMs": 1379990,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "그리고 하루 뒤에 전쟁이"
    } ]
  }, {
    "tStartMs": 1381750,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "시작되었다고 얘기를 했죠"
    } ]
  }, {
    "tStartMs": 1384280,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "물론 트럼프 대통령이 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1386640,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "이란이 그런 합의를 제시했겠지만"
    } ]
  }, {
    "tStartMs": 1388940,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "했을 수 있지만"
    } ]
  }, {
    "tStartMs": 1390100,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "이란은 임박한 핵 위협이 있던 나라다"
    } ]
  }, {
    "tStartMs": 1392770,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "위협이 임박했기 때문에"
    } ]
  }, {
    "tStartMs": 1394180,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "전쟁을 할 수밖에 없었다"
    } ]
  }, {
    "tStartMs": 1395400,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "이렇게 얘기했거든요"
    } ]
  }, {
    "tStartMs": 1396750,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "그래서 이번에는"
    } ]
  }, {
    "tStartMs": 1398210,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "국가정보국장 털시라는 분이"
    } ]
  }, {
    "tStartMs": 1400490,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "상원에 와서"
    } ]
  }, {
    "tStartMs": 1401340,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "청문회에서 증언을 했습니다"
    } ]
  }, {
    "tStartMs": 1403040,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 1403840,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "질문이 이런 겁니다"
    } ]
  }, {
    "tStartMs": 1404910,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "이란의 핵전력이 임박한 위협이었습니까?"
    } ]
  }, {
    "tStartMs": 1407220,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "라고 질문을 하니까"
    } ]
  }, {
    "tStartMs": 1408470,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "국가정보국장이 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1410340,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "무엇이 임박한지에 대한 판단은"
    } ]
  }, {
    "tStartMs": 1412260,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "정부기관의 책임이 아닙니다"
    } ]
  }, {
    "tStartMs": 1414020,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "우리가 거기에 대한 판단을 하고"
    } ]
  }, {
    "tStartMs": 1415590,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "보고서를 올리지 않았어요"
    } ]
  }, {
    "tStartMs": 1418060,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "그러면서 대통령이 결정한 문제입니다"
    } ]
  }, {
    "tStartMs": 1420670,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "라고 얘기를 해서"
    } ]
  }, {
    "tStartMs": 1421600,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "상원의원들한테 욕을 엄청나게 먹었습니다"
    } ]
  }, {
    "tStartMs": 1425110,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "무엇이 임박한 위협인지에 대해"
    } ]
  }, {
    "tStartMs": 1426740,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "정부기관이 그걸 판단 안 하면"
    } ]
  }, {
    "tStartMs": 1428550,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "누가 판단하냐?"
    } ]
  }, {
    "tStartMs": 1429570,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "라고 했더니"
    } ]
  }, {
    "tStartMs": 1430190,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "이 털씨 누나가 그렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 1431580,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "제가 안 했어요"
    } ]
  }, {
    "tStartMs": 1433130,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "대통령이 결정했어요"
    } ]
  }, {
    "tStartMs": 1434310,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "라고 얘기를 했죠"
    } ]
  }, {
    "tStartMs": 1436500,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "자 그리고 여러분도 보셨겠지만"
    } ]
  }, {
    "tStartMs": 1438140,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "미국의 대테러 센터장이"
    } ]
  }, {
    "tStartMs": 1439680,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "장문의 편지와 함께"
    } ]
  }, {
    "tStartMs": 1440640,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "사임하는 일도 있었습니다"
    } ]
  }, {
    "tStartMs": 1442390,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 1443220,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "아는 양심상"
    } ]
  }, {
    "tStartMs": 1444230,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "대표적인 마가 인물로 유명한 분입니다"
    } ]
  }, {
    "tStartMs": 1446370,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "이 분은 굉장히 강성 마가로 유명한 분인데"
    } ]
  }, {
    "tStartMs": 1448570,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "이 대테러 센터장이라는 사람이"
    } ]
  }, {
    "tStartMs": 1450180,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "나는 양심상 이란과의 전쟁을 지지할 수 없다"
    } ]
  }, {
    "tStartMs": 1452540,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "왜냐하면"
    } ]
  }, {
    "tStartMs": 1453310,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "이란은 우리 국가에"
    } ]
  }, {
    "tStartMs": 1454850,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "이번 전쟁을 일으킨"
    } ]
  }, {
    "tStartMs": 1456410,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "주된 목적이 임박한 위협인데"
    } ]
  }, {
    "tStartMs": 1458800,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "임박한 위협을 가하지 않았다"
    } ]
  }, {
    "tStartMs": 1461180,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "이 전쟁은 이스라엘의"
    } ]
  }, {
    "tStartMs": 1462560,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "강력한 로비 때문에 시작한 것이 분명하다"
    } ]
  }, {
    "tStartMs": 1464770,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "라고 이스라엘 책임이다"
    } ]
  }, {
    "tStartMs": 1466600,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "이스라엘 때문이다"
    } ]
  }, {
    "tStartMs": 1467430,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "라는 얘기와 함께 사임을 했어요"
    } ]
  }, {
    "tStartMs": 1469730,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "한마디로 트럼프를 움직인 배후에"
    } ]
  }, {
    "tStartMs": 1471410,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "이제 이스라엘이 있는 게 아니냐"
    } ]
  }, {
    "tStartMs": 1473250,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "뭐 이런 의문을 제기한 거죠"
    } ]
  }, {
    "tStartMs": 1474680,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "그래서 3월 19일날"
    } ]
  }, {
    "tStartMs": 1476600,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "네타냐후 이스라엘 총리가"
    } ]
  }, {
    "tStartMs": 1478300,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "기자회견을 열었습니다"
    } ]
  }, {
    "tStartMs": 1479690,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "여기에 대해서 해명을 해야겠죠"
    } ]
  }, {
    "tStartMs": 1481240,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 1482260,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "자, 여러분 우선 제가 살아있다고"
    } ]
  }, {
    "tStartMs": 1484000,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "먼저 말하고 싶습니다"
    } ]
  }, {
    "tStartMs": 1485020,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "여러분 모두가 증인입니다"
    } ]
  }, {
    "tStartMs": 1486590,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "라고 얘기를 했어요"
    } ]
  }, {
    "tStartMs": 1487210,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "갑자기 왜 자기 살아있다고 얘기하냐"
    } ]
  }, {
    "tStartMs": 1489060,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "네타냐후 총리의 사망설이 돌았습니다"
    } ]
  }, {
    "tStartMs": 1491520,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "갑자기 네타냐후 총리가"
    } ]
  }, {
    "tStartMs": 1492480,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "왜 사망했다는 루머가 돌았나요?"
    } ]
  }, {
    "tStartMs": 1495060,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "영상 속에서"
    } ]
  }, {
    "tStartMs": 1496310,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "네타냐후 총리의 손가락이"
    } ]
  }, {
    "tStartMs": 1498390,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "6개다라는 루머가 돌았대요"
    } ]
  }, {
    "tStartMs": 1500480,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "그래서 AI로 만든 영상 아니냐라는"
    } ]
  }, {
    "tStartMs": 1502480,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "루머가 돌았다는 건데"
    } ]
  }, {
    "tStartMs": 1503800,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "이 장면입니다"
    } ]
  }, {
    "tStartMs": 1504900,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "하나, 둘, 셋, 넷"
    } ]
  }, {
    "tStartMs": 1507630,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "다섯, 여섯?"
    } ]
  }, {
    "tStartMs": 1509490,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "요거, 이게 다섯 개라는 겁니다"
    } ]
  }, {
    "tStartMs": 1511910,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "아, 잠깐만"
    } ]
  }, {
    "tStartMs": 1512870,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "지우고, 보여드리겠습니다"
    } ]
  }, {
    "tStartMs": 1513870,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "그렇게 보입니까?"
    } ]
  }, {
    "tStartMs": 1515100,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "요거, 요거"
    } ]
  }, {
    "tStartMs": 1518180,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "요게 여섯 개의 손가락이라는 거예요"
    } ]
  }, {
    "tStartMs": 1520480,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "씁..."
    } ]
  }, {
    "tStartMs": 1522720,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "아, 그냥 음영 같은데? 손 접힌 거 같은데"
    } ]
  }, {
    "tStartMs": 1527720,
    "dDurationMs": 4150,
    "segs": [ {
      "utf8": "손가락이 여섯 개 아니냐, 네타냐후 총리는 이미 죽었다"
    } ]
  }, {
    "tStartMs": 1531870,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "죽었는데, AI로 만든 영상이다 라고 했다는 거죠"
    } ]
  }, {
    "tStartMs": 1533410,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "그래서 네타냐후 총리가 긴급히"
    } ]
  }, {
    "tStartMs": 1535730,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "본인의 SNS에"
    } ]
  }, {
    "tStartMs": 1536430,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "이렇게 올렸습니다 이렇게"
    } ]
  }, {
    "tStartMs": 1540060,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "다섯 개라고"
    } ]
  }, {
    "tStartMs": 1541140,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "저 손가락 다섯 개예요 라고"
    } ]
  }, {
    "tStartMs": 1542460,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "생존 증명을 올렸다고 하는데"
    } ]
  }, {
    "tStartMs": 1544180,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "물론 음모론자들은"
    } ]
  }, {
    "tStartMs": 1545520,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "이것도 AI 영상이다"
    } ]
  }, {
    "tStartMs": 1547580,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "이것도 AI 영상이라고 얘기를 했다는데"
    } ]
  }, {
    "tStartMs": 1549880,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "그래서 이번에 기자회견에 나와서"
    } ]
  }, {
    "tStartMs": 1551600,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "자기 살아있다고 얘기를 했다는 거고요"
    } ]
  }, {
    "tStartMs": 1554720,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "네타냐후 총리가 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1556400,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "일단 우리는 사실상"
    } ]
  }, {
    "tStartMs": 1558140,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "전쟁에서 이겼습니다"
    } ]
  }, {
    "tStartMs": 1559390,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "우리는 압도적인 승리를 거뒀고"
    } ]
  }, {
    "tStartMs": 1561070,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "이란은 파멸하고 있습니다"
    } ]
  }, {
    "tStartMs": 1563760,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "지금 이란은"
    } ]
  }, {
    "tStartMs": 1564880,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "역대 어느 때보다 약해진 상황이고요"
    } ]
  }, {
    "tStartMs": 1567550,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "이스라엘은 지역 강대국을 넘어서"
    } ]
  }, {
    "tStartMs": 1569900,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "사실상 세계 강대국이라고 부를 정도의"
    } ]
  }, {
    "tStartMs": 1572800,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "위상을 갖추게 됐습니다"
    } ]
  }, {
    "tStartMs": 1575260,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "그 정도입니까?"
    } ]
  }, {
    "tStartMs": 1576300,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "세계 강대국이라고 부를 정도의"
    } ]
  }, {
    "tStartMs": 1577980,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "위상을 갖추게 됐다?"
    } ]
  }, {
    "tStartMs": 1579070,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "그리고 가짜 뉴스들"
    } ]
  }, {
    "tStartMs": 1580930,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "가짜 언론들이 이렇게 얘기하는데"
    } ]
  }, {
    "tStartMs": 1583150,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "이스라엘이 미국을"
    } ]
  }, {
    "tStartMs": 1584240,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "이란과의 분쟁에 끌어들인 거 아니냐?"
    } ]
  }, {
    "tStartMs": 1586050,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "그거 가짜 뉴스다"
    } ]
  }, {
    "tStartMs": 1588060,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "페이크 뉴스야"
    } ]
  }, {
    "tStartMs": 1589250,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "우리는 그런 적이 없어요"
    } ]
  }, {
    "tStartMs": 1590830,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "어떻게 그걸 증명합니까 그랬더니"
    } ]
  }, {
    "tStartMs": 1592570,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1593830,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "잘 생각해봐라, 잘"
    } ]
  }, {
    "tStartMs": 1595420,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "그게 가짜 뉴스일 이유가 있다"
    } ]
  }, {
    "tStartMs": 1597180,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "뭐냐"
    } ]
  }, {
    "tStartMs": 1598600,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "트럼프라는 사람이"
    } ]
  }, {
    "tStartMs": 1600430,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "설득될 양반이냐"
    } ]
  }, {
    "tStartMs": 1602590,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "누군가 뭐라고 해서"
    } ]
  }, {
    "tStartMs": 1603840,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "그게 들을 사람으로 보이니"
    } ]
  }, {
    "tStartMs": 1605820,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "누군가 트럼프에게 무엇을 하라고"
    } ]
  }, {
    "tStartMs": 1607430,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "지시할 수 있다고 생각하냐"
    } ]
  }, {
    "tStartMs": 1609720,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "그 양반이"
    } ]
  }, {
    "tStartMs": 1610730,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "내가 뭐라 그런다고"
    } ]
  }, {
    "tStartMs": 1611630,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "그걸 들어 먹을 것 같아?"
    } ]
  }, {
    "tStartMs": 1613660,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "네가 생각해봐라"
    } ]
  }, {
    "tStartMs": 1614600,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "네가 그게 될 소리냐?"
    } ]
  }, {
    "tStartMs": 1615960,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "라고 얘기를 해서"
    } ]
  }, {
    "tStartMs": 1617750,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "묘하게 설득력이 있긴 한데"
    } ]
  }, {
    "tStartMs": 1619690,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "오?...."
    } ]
  }, {
    "tStartMs": 1622020,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "그럴 듯한 것 같기도 하고"
    } ]
  }, {
    "tStartMs": 1623550,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "좀 이상한 것 같기도 하고"
    } ]
  }, {
    "tStartMs": 1624870,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "그게 설득될 양반이냐?"
    } ]
  }, {
    "tStartMs": 1627150,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "라고 항변을 하셨습니다"
    } ]
  }, {
    "tStartMs": 1628940,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "그래서 음모론이다"
    } ]
  }, {
    "tStartMs": 1630430,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "라고 얘기를 했는데"
    } ]
  }, {
    "tStartMs": 1631420,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "물론 많은 사람들은"
    } ]
  }, {
    "tStartMs": 1632740,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "그래도 이스라엘이 부추긴 거 아니냐?"
    } ]
  }, {
    "tStartMs": 1634370,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "라고 또 얘기하는 사람들이"
    } ]
  }, {
    "tStartMs": 1635710,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "많은 상황이죠"
    } ]
  }, {
    "tStartMs": 1636590,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "그러면서 네타냐후 총리가 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1638490,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "트럼프 대통령은"
    } ]
  }, {
    "tStartMs": 1639870,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "미국밖에 모르는 남자야"
    } ]
  }, {
    "tStartMs": 1642340,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "항상 그 아메리카 퍼스트"
    } ]
  }, {
    "tStartMs": 1644260,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "미국의 이익이 되냐 안 되냐"
    } ]
  }, {
    "tStartMs": 1646050,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "자기 이익은 생각하지 않고"
    } ]
  }, {
    "tStartMs": 1647600,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "다 내려놓고"
    } ]
  }, {
    "tStartMs": 1648990,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "미국의 이익만 생각하시는"
    } ]
  }, {
    "tStartMs": 1650620,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "오직 그런 분이기 때문에"
    } ]
  }, {
    "tStartMs": 1651540,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "아, 또 하나 있구나"
    } ]
  }, {
    "tStartMs": 1652890,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "그분은 오직"
    } ]
  }, {
    "tStartMs": 1654420,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "퓨처 제네레이션"
    } ]
  }, {
    "tStartMs": 1655860,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "미래의 세대를 위해서"
    } ]
  }, {
    "tStartMs": 1656870,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "좋냐 안 좋냐"
    } ]
  }, {
    "tStartMs": 1657750,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "이것만을 따지는 분이야"
    } ]
  }, {
    "tStartMs": 1660060,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "그래서 그렇게 석탄 캐고 막 돌리면서"
    } ]
  }, {
    "tStartMs": 1662230,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "좋은 에너지 이렇게 얘기하지 않습니까"
    } ]
  }, {
    "tStartMs": 1663980,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "환경 이런 거"
    } ]
  }, {
    "tStartMs": 1665250,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "내다 버..."
    } ]
  }, {
    "tStartMs": 1667040,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "내다버린 건 아니고"
    } ]
  }, {
    "tStartMs": 1668370,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "그게 환경에"
    } ]
  }, {
    "tStartMs": 1669320,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "악영향을 주지 않는다고 생각하기 때문에"
    } ]
  }, {
    "tStartMs": 1671620,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "미래 세대를 위해서"
    } ]
  }, {
    "tStartMs": 1672460,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "좋다고 생각하는 분이기 때문에"
    } ]
  }, {
    "tStartMs": 1675020,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "하여튼 그래서"
    } ]
  }, {
    "tStartMs": 1676350,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "그런 것밖에 모르는 분인데"
    } ]
  }, {
    "tStartMs": 1677340,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "너희들이 너무 오해하는 거 아니냐라고"
    } ]
  }, {
    "tStartMs": 1679360,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "또 일갈을 날려줬습니다"
    } ]
  }, {
    "tStartMs": 1681750,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "결론적으로"
    } ]
  }, {
    "tStartMs": 1682800,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "이 라이브로 하는"
    } ]
  }, {
    "tStartMs": 1683850,
    "dDurationMs": 450,
    "segs": [ {
      "utf8": "이 와중에"
    } ]
  }, {
    "tStartMs": 1684300,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "이미 한 10시간은 지난 것 같아요"
    } ]
  }, {
    "tStartMs": 1685600,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "발표된 다음에"
    } ]
  }, {
    "tStartMs": 1686740,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "48시간 경고가 내려왔습니다"
    } ]
  }, {
    "tStartMs": 1689270,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "이란이 지금부터 정확히"
    } ]
  }, {
    "tStartMs": 1690300,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "48시간 이내"
    } ]
  }, {
    "tStartMs": 1691200,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "아무런 위협 없이"
    } ]
  }, {
    "tStartMs": 1691890,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "호르무즈 해협을 개방할 것이냐"
    } ]
  }, {
    "tStartMs": 1694100,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "안 할 것이냐"
    } ]
  }, {
    "tStartMs": 1695810,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "확전일 것이냐"
    } ]
  }, {
    "tStartMs": 1696810,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "안정일 것이냐"
    } ]
  }, {
    "tStartMs": 1697450,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "근데 얼핏 생각에"
    } ]
  }, {
    "tStartMs": 1699490,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "개인적인 생각에"
    } ]
  }, {
    "tStartMs": 1700370,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "이란이 호르무즈 해협을"
    } ]
  }, {
    "tStartMs": 1702150,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "48시간 내에 개방한다는 거는"
    } ]
  }, {
    "tStartMs": 1704530,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "항복 선언 아닌가? 항복 선언"
    } ]
  }, {
    "tStartMs": 1707630,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "게다가 저걸 결정할 정도의 지휘자들은"
    } ]
  }, {
    "tStartMs": 1710330,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "이미 전부 다"
    } ]
  }, {
    "tStartMs": 1711870,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "암살 작전 때문에"
    } ]
  }, {
    "tStartMs": 1713310,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "그런 사람이 있는지 없는지도"
    } ]
  }, {
    "tStartMs": 1716130,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "위를 다 죽였잖아요"
    } ]
  }, {
    "tStartMs": 1717130,
    "dDurationMs": 650,
    "segs": [ {
      "utf8": "암살 작전으로"
    } ]
  }, {
    "tStartMs": 1717780,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "위가 지금 사실상 공백인 것 같은데"
    } ]
  }, {
    "tStartMs": 1720300,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "이 정도 결정을"
    } ]
  }, {
    "tStartMs": 1721210,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "내릴 수 있냐라는 것도"
    } ]
  }, {
    "tStartMs": 1722880,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "의심이 되고"
    } ]
  }, {
    "tStartMs": 1724000,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "그리고 실제로 48시간 내에 만약에"
    } ]
  }, {
    "tStartMs": 1725940,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "호르무즈 해협이 개방 안 되면"
    } ]
  }, {
    "tStartMs": 1727160,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "진짜 이란 발전소들을 미국이"
    } ]
  }, {
    "tStartMs": 1729610,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "직접적으로 타격을 할 것이냐"
    } ]
  }, {
    "tStartMs": 1731570,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "그러면 완전"
    } ]
  }, {
    "tStartMs": 1732790,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "확전일 것 같은데"
    } ]
  }, {
    "tStartMs": 1734950,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "걱정이 되죠"
    } ]
  }, {
    "tStartMs": 1736000,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "지금도 이란 전쟁이"
    } ]
  }, {
    "tStartMs": 1737210,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "이미 4주차로 들어가고 있지만"
    } ]
  }, {
    "tStartMs": 1739010,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "하..."
    } ]
  }, {
    "tStartMs": 1740010,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "어떻게 될지 모르겠습니다"
    } ]
  }, {
    "tStartMs": 1740950,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "진짜 한참도 모르는"
    } ]
  }, {
    "tStartMs": 1742250,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "전쟁이 지금도 펼쳐지고 있지 않나"
    } ]
  }, {
    "tStartMs": 1744000,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "생각을 합니다"
    } ]
  } ]
}

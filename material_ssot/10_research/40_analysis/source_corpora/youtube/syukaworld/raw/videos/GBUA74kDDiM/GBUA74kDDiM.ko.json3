{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 7650,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "자, 오늘의 주제는 트럼프 맨더링입니다"
    } ]
  }, {
    "tStartMs": 10330,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "트럼프 맨더링이 뭐냐?"
    } ]
  }, {
    "tStartMs": 11710,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "아마 모르실 거예요"
    } ]
  }, {
    "tStartMs": 13080,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "설명을 드리겠습니다"
    } ]
  }, {
    "tStartMs": 14520,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "지금 미국에서는 작년부터"
    } ]
  }, {
    "tStartMs": 16500,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "선거구 재조정 열풍이 불고 있습니다"
    } ]
  }, {
    "tStartMs": 19670,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "가장 앞서 나가고 있는 데가 텍사스인데"
    } ]
  }, {
    "tStartMs": 21970,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "텍사스주의 공화당은"
    } ]
  }, {
    "tStartMs": 23300,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "텍사스주의 38개 하원 선거구"
    } ]
  }, {
    "tStartMs": 26270,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "재조정 작업을 시작했습니다"
    } ]
  }, {
    "tStartMs": 28860,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "선거구 재조정이 뭐냐?"
    } ]
  }, {
    "tStartMs": 31170,
    "dDurationMs": 4070,
    "segs": [ {
      "utf8": "우리로 치면 구나 동구역을 나누는 거예요"
    } ]
  }, {
    "tStartMs": 35240,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "국회의원들이 여기는 A 국회의원"
    } ]
  }, {
    "tStartMs": 37240,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "여기는 B 국회의원"
    } ]
  }, {
    "tStartMs": 38080,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "여기는 C 국회의원 이거잖아요"
    } ]
  }, {
    "tStartMs": 39460,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "이거를 재조정하는 겁니다"
    } ]
  }, {
    "tStartMs": 41010,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "위치를 이런 식으로"
    } ]
  }, {
    "tStartMs": 42520,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "어디까지를"
    } ]
  }, {
    "tStartMs": 43460,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "이쪽 선거구에 넣을 건지"
    } ]
  }, {
    "tStartMs": 44740,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "어디까지를 이쪽 선거구에 넣을 건지"
    } ]
  }, {
    "tStartMs": 46390,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "보통 10년에 한 번 합니다"
    } ]
  }, {
    "tStartMs": 48060,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "인구가 변하거나"
    } ]
  }, {
    "tStartMs": 49140,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "행정구역이 변하거나 할 수 있으니까"
    } ]
  }, {
    "tStartMs": 50570,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "그런데 그런 것도 아닌데"
    } ]
  }, {
    "tStartMs": 52060,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "갑자기 이렇게 대규모로"
    } ]
  }, {
    "tStartMs": 53740,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "선거구 재조정을 한 적은"
    } ]
  }, {
    "tStartMs": 55480,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "미국에서 거의 없다 그럽니다"
    } ]
  }, {
    "tStartMs": 57000,
    "dDurationMs": 3530,
    "segs": [ {
      "utf8": "그러면 갑자기 선거구 재조정을 왜 하냐?"
    } ]
  }, {
    "tStartMs": 60530,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "설마 자기들 유리하려고"
    } ]
  }, {
    "tStartMs": 62720,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "우리 한 석이라도 더 하려고"
    } ]
  }, {
    "tStartMs": 65640,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "이거 유리하게 선거구 이렇게"
    } ]
  }, {
    "tStartMs": 68220,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "말도 안 되는 모습으로"
    } ]
  }, {
    "tStartMs": 69500,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "하는 거냐?"
    } ]
  }, {
    "tStartMs": 70860,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "어떻게 생각하십니까?"
    } ]
  }, {
    "tStartMs": 72820,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "놀랍게도 맞습니다"
    } ]
  }, {
    "tStartMs": 75740,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "음모론이 아니라"
    } ]
  }, {
    "tStartMs": 76920,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "본인들이 당당하게 밝혀요"
    } ]
  }, {
    "tStartMs": 79110,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "우리가 선거구 재조정하는 목적은"
    } ]
  }, {
    "tStartMs": 81320,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "의석을 추가로 얻기 위함이다"
    } ]
  }, {
    "tStartMs": 83620,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "한국적으로는 이해가 안 되는데"
    } ]
  }, {
    "tStartMs": 86140,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "우리가 의석을 조금이라도 더 얻어야 되니까"
    } ]
  }, {
    "tStartMs": 88380,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "지도 좀 잘 좀 잘라봐"
    } ]
  }, {
    "tStartMs": 89900,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "이렇게 자르고 이렇게 자르고"
    } ]
  }, {
    "tStartMs": 90770,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "어떻게 해야 더 얻냐?"
    } ]
  }, {
    "tStartMs": 92210,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "요거 지금 공부하고 있다는 소리입니다"
    } ]
  }, {
    "tStartMs": 94630,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "실제로 오른쪽에 있는 게"
    } ]
  }, {
    "tStartMs": 95760,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "트럼프 대통령이 요구한 건데"
    } ]
  }, {
    "tStartMs": 97360,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "저는 텍사스가 잘 자르면"
    } ]
  }, {
    "tStartMs": 98860,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "5개 의석을 추가로 얻을 수 있다고 생각합니다"
    } ]
  }, {
    "tStartMs": 101650,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "추가로 얻으면"
    } ]
  }, {
    "tStartMs": 102500,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "중간선거 과반수 확보에 아주"
    } ]
  }, {
    "tStartMs": 104050,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "큰 도움이 될 것 같아요"
    } ]
  }, {
    "tStartMs": 105260,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "잘 좀 해봐라"
    } ]
  }, {
    "tStartMs": 106720,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "그러면 아무리 대통령이 요구해도"
    } ]
  }, {
    "tStartMs": 109370,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "선거구를 그렇게 마음대로 잘라도 되냐?"
    } ]
  }, {
    "tStartMs": 112580,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "공화당이 뭐라고 반응했냐면"
    } ]
  }, {
    "tStartMs": 114020,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "이렇게 반응했습니다"
    } ]
  }, {
    "tStartMs": 115250,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "정말 좋은 생각이십니다"
    } ]
  }, {
    "tStartMs": 117000,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "대통령의 핵심 요구사항이"
    } ]
  }, {
    "tStartMs": 118630,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "공화당 의석 다섯 석을 늘리는 거니까"
    } ]
  }, {
    "tStartMs": 120450,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "우리가 선거구를 한번 조정해보겠습니다"
    } ]
  }, {
    "tStartMs": 123050,
    "dDurationMs": 490,
    "segs": [ {
      "utf8": "라고 얘기하고"
    } ]
  }, {
    "tStartMs": 123540,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "지금 텍사스가 이리저리 해보는 거예요"
    } ]
  }, {
    "tStartMs": 124980,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "된다는 거죠"
    } ]
  }, {
    "tStartMs": 126710,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "심지어 프로그램도 있어요"
    } ]
  }, {
    "tStartMs": 129290,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "선거구 재조정 프로그램을 운영하는 게"
    } ]
  }, {
    "tStartMs": 132320,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "미국의 당들입니다"
    } ]
  }, {
    "tStartMs": 133910,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "아니 선거관리위원회도 아닌데"
    } ]
  }, {
    "tStartMs": 135590,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "선거구 재조정을 할 수 있냐?"
    } ]
  }, {
    "tStartMs": 137170,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "할 수 있어요"
    } ]
  }, {
    "tStartMs": 138610,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "심지어 이 선거구 재조정 프로그램"
    } ]
  }, {
    "tStartMs": 140080,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "운영하는 목표가 이렇게 나옵니다"
    } ]
  }, {
    "tStartMs": 141630,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "향후 10년간 미국 하원에서"
    } ]
  }, {
    "tStartMs": 143300,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "공화당의 강력한 입지를 유지하는 것을"
    } ]
  }, {
    "tStartMs": 146030,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "목표로 선거구 재조정을 한다"
    } ]
  }, {
    "tStartMs": 149150,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "공화당의 선거구 재조정 프로그램입니다"
    } ]
  }, {
    "tStartMs": 151280,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "잘 만 하면 10년 간 꿀빨 수 있죠"
    } ]
  }, {
    "tStartMs": 153540,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "그리고 만약에 트럼프 대통령이 말했듯이"
    } ]
  }, {
    "tStartMs": 155710,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "하원에서 5석을 추가로 얻을 수 있다면"
    } ]
  }, {
    "tStartMs": 158080,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "지금 218대 214석이에요"
    } ]
  }, {
    "tStartMs": 160350,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "과반 218석입니다"
    } ]
  }, {
    "tStartMs": 161670,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "사실상 거의 5대 5라고 할 수 있는데"
    } ]
  }, {
    "tStartMs": 164950,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "5석을 추가로 얻을 수 있다면"
    } ]
  }, {
    "tStartMs": 167060,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "과반을 넘길 수도 있죠"
    } ]
  }, {
    "tStartMs": 167930,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "아주 큰 힘이 될 수 있죠"
    } ]
  }, {
    "tStartMs": 169890,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "그런데 제가 지금까지 설명드렸지만"
    } ]
  }, {
    "tStartMs": 171600,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "그렇게 선거구를 재조정해도 되냐라는 문제와"
    } ]
  }, {
    "tStartMs": 174240,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "그렇게 선거구를 재조정하는 걸 뭐라 그러냐"
    } ]
  }, {
    "tStartMs": 176530,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "교과서에서 배우셨죠"
    } ]
  }, {
    "tStartMs": 177910,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "개리맨더링이라고 합니다"
    } ]
  }, {
    "tStartMs": 179940,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "개리맨더링은 한 정당에 유리하도록"
    } ]
  }, {
    "tStartMs": 182600,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "의도적으로 선거구를 왜곡하는 행위라고"
    } ]
  }, {
    "tStartMs": 185390,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "우리는 배웠습니다"
    } ]
  }, {
    "tStartMs": 186890,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "배우긴 그렇게 배웠어요"
    } ]
  }, {
    "tStartMs": 187980,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "개리맨더링을 하겠다는 거냐"
    } ]
  }, {
    "tStartMs": 190010,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "이렇게 그림을 잘 그리면"
    } ]
  }, {
    "tStartMs": 192650,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "나한테 유리할 수 있어요"
    } ]
  }, {
    "tStartMs": 193620,
    "dDurationMs": 590,
    "segs": [ {
      "utf8": "그림을 잘 그리면"
    } ]
  }, {
    "tStartMs": 195390,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "예를 들면 노동자들이 많이 있어서"
    } ]
  }, {
    "tStartMs": 197530,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "노동당을 뽑을 것 같아"
    } ]
  }, {
    "tStartMs": 198530,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "나는 보수당이야"
    } ]
  }, {
    "tStartMs": 199290,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "그러면 걔네들은 이렇게 빼고 그리면 됩니다"
    } ]
  }, {
    "tStartMs": 202400,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "기가 막히네"
    } ]
  }, {
    "tStartMs": 203320,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "나는 학생들의 지지가 높아"
    } ]
  }, {
    "tStartMs": 204860,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "대학교가 여기 있어"
    } ]
  }, {
    "tStartMs": 205840,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "그러면 이렇게 한 다음에"
    } ]
  }, {
    "tStartMs": 207740,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "이렇게 만들면 돼요"
    } ]
  }, {
    "tStartMs": 209930,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "그러면 내가 유리하죠"
    } ]
  }, {
    "tStartMs": 211260,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "이렇게 만들면 됩니다"
    } ]
  }, {
    "tStartMs": 213380,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "이게 말이 됩니까?"
    } ]
  }, {
    "tStartMs": 214980,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "말이 되는 게 아니라"
    } ]
  }, {
    "tStartMs": 216010,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "요즘은 그렇게도 안 하고"
    } ]
  }, {
    "tStartMs": 217380,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "AI를 활용해서"
    } ]
  }, {
    "tStartMs": 218360,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "최적의 유리한 지도를 그린다고 합니다"
    } ]
  }, {
    "tStartMs": 220480,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "정교한 소프트웨어의 도움을 받아서"
    } ]
  }, {
    "tStartMs": 222330,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "아주 완벽하게 정말 미세하게 잘라서"
    } ]
  }, {
    "tStartMs": 226110,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "이런 선거구를 설정하는 게"
    } ]
  }, {
    "tStartMs": 227570,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "요즘 트렌드라고 하고요"
    } ]
  }, {
    "tStartMs": 228860,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "그래서 선거구 모양이 어떻게 나오냐"
    } ]
  }, {
    "tStartMs": 230950,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "내리면 이렇게"
    } ]
  }, {
    "tStartMs": 232630,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "실제 있는 선거구입니다"
    } ]
  }, {
    "tStartMs": 234010,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "이게 한 선거구예요"
    } ]
  }, {
    "tStartMs": 236260,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "정교하게 짠 거 봐라"
    } ]
  }, {
    "tStartMs": 237750,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "와 진짜 기가 막히죠"
    } ]
  }, {
    "tStartMs": 239420,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "삐죽 나온 건"
    } ]
  }, {
    "tStartMs": 240300,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "거기가 나한테 좀 유리해서겠죠"
    } ]
  }, {
    "tStartMs": 242550,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "이렇게 삐죽 나오고"
    } ]
  }, {
    "tStartMs": 243770,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "이렇게 삐죽 나오고"
    } ]
  }, {
    "tStartMs": 244720,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "이렇게"
    } ]
  }, {
    "tStartMs": 245540,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "미세하게 된 거는 다 이유가 있는 겁니다"
    } ]
  }, {
    "tStartMs": 247560,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "선거 공학이 들어간 거야 선거 공학이"
    } ]
  }, {
    "tStartMs": 249750,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "여기도 왜 뺐냐?"
    } ]
  }, {
    "tStartMs": 250690,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "당연히 마음에 안 들겠죠"
    } ]
  }, {
    "tStartMs": 251800,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "그래서 뺐다고 할 수 있고요"
    } ]
  }, {
    "tStartMs": 253370,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "가장 제가 보기에"
    } ]
  }, {
    "tStartMs": 255010,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "자료 만드는 친구들이 찾아놓는데"
    } ]
  }, {
    "tStartMs": 256130,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "가장 황당했던 선거구는"
    } ]
  }, {
    "tStartMs": 257620,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "이런 선거구가 있습니다"
    } ]
  }, {
    "tStartMs": 259200,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "일리노이주에 있다는데"
    } ]
  }, {
    "tStartMs": 260930,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "야, 이거 뭐야?"
    } ]
  }, {
    "tStartMs": 261820,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "가운데는 뭐길래 뺐지?"
    } ]
  }, {
    "tStartMs": 263230,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "모르겠습니다"
    } ]
  }, {
    "tStartMs": 264060,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "가운데는 마음에 안 드는 뭐가 자꾸 있나 보죠"
    } ]
  }, {
    "tStartMs": 266570,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "가운데를 쏙 빼서"
    } ]
  }, {
    "tStartMs": 268260,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "알맹이를 뺀 선거구도 있습니다"
    } ]
  }, {
    "tStartMs": 271100,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "국회의원이면"
    } ]
  }, {
    "tStartMs": 271870,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "이 선거구 국회의원이에요"
    } ]
  }, {
    "tStartMs": 273630,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "무슨 도로잖아 이건"
    } ]
  }, {
    "tStartMs": 274900,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "자 요렇게 만드는 게"
    } ]
  }, {
    "tStartMs": 276470,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "요즘 개리맨더링이라고 할 수 있는데"
    } ]
  }, {
    "tStartMs": 278550,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "교과서에서 배웠겠지만"
    } ]
  }, {
    "tStartMs": 279560,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "개리맨더링은"
    } ]
  }, {
    "tStartMs": 280400,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "개리가 사람 이름입니다"
    } ]
  }, {
    "tStartMs": 282020,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "1812년 메사추세스 주지사"
    } ]
  }, {
    "tStartMs": 284210,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "엘브리지 개리라는 사람이"
    } ]
  }, {
    "tStartMs": 285790,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "자기에게 유리하도록"
    } ]
  }, {
    "tStartMs": 286900,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "선거구를 저딴 식으로 만들었다가"
    } ]
  }, {
    "tStartMs": 288890,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "이름까지 붙었는데"
    } ]
  }, {
    "tStartMs": 290070,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "그때는 어떻게 만들었냐"
    } ]
  }, {
    "tStartMs": 291280,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "자기에게 유리하게"
    } ]
  }, {
    "tStartMs": 292720,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "요렇게 선거구를 만들었대요"
    } ]
  }, {
    "tStartMs": 294500,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "마음에 안 드는 거 빼고"
    } ]
  }, {
    "tStartMs": 295490,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "그랬다가 한 신문사가"
    } ]
  }, {
    "tStartMs": 296880,
    "dDurationMs": 650,
    "segs": [ {
      "utf8": "이거 뭐야"
    } ]
  }, {
    "tStartMs": 297530,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "살라만더"
    } ]
  }, {
    "tStartMs": 298150,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "도마뱀 그려놓은 거 아니야"
    } ]
  }, {
    "tStartMs": 299520,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "해서 개리 살라만더 해  서"
    } ]
  }, {
    "tStartMs": 301170,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "개리맨더가 됐다는 말이 있습니다"
    } ]
  }, {
    "tStartMs": 303120,
    "dDurationMs": 650,
    "segs": [ {
      "utf8": "도롱뇽 도롱뇽"
    } ]
  }, {
    "tStartMs": 303770,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "그래서 우리가 개리맨더링 이렇게 부르죠"
    } ]
  }, {
    "tStartMs": 307070,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "자 그럼 다시 돌아와서"
    } ]
  }, {
    "tStartMs": 308660,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "이번에 선거구 재조정을 한다는 텍사스는"
    } ]
  }, {
    "tStartMs": 311110,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "하원 의석을 무려 38석을 갖고 있는 주입니다"
    } ]
  }, {
    "tStartMs": 313930,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "미국에서 두 번째로 큰 주예요"
    } ]
  }, {
    "tStartMs": 315650,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "의석 기준으로"
    } ]
  }, {
    "tStartMs": 316730,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "캘리포니아가 52"
    } ]
  }, {
    "tStartMs": 318050,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "1위고 그 다음에 텍사스입니다"
    } ]
  }, {
    "tStartMs": 319320,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "플로리다가 28개"
    } ]
  }, {
    "tStartMs": 320510,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "한마디로 빅3예요 빅3"
    } ]
  }, {
    "tStartMs": 321730,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "저게 5석을 더 갖고 온다는 거죠"
    } ]
  }, {
    "tStartMs": 323740,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "자 그럼 여러분도 알다시피"
    } ]
  }, {
    "tStartMs": 324760,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "텍사스는 공화당의 텃밭입니다"
    } ]
  }, {
    "tStartMs": 327360,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "트럼프 공화당의 텃밭인데"
    } ]
  }, {
    "tStartMs": 329040,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "지금 텍사스 38석 중"
    } ]
  }, {
    "tStartMs": 330690,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "공화당이 25석이 있고"
    } ]
  }, {
    "tStartMs": 332120,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "민주당이 13석이 있어요"
    } ]
  }, {
    "tStartMs": 334270,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "65%를 공화당이 가지고 있습니다"
    } ]
  }, {
    "tStartMs": 335830,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "65대 34예요"
    } ]
  }, {
    "tStartMs": 337200,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "그런데 대선 당시에"
    } ]
  }, {
    "tStartMs": 339570,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "공화당의 텍사스 득표율을 보면"
    } ]
  }, {
    "tStartMs": 341570,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "56%였어요"
    } ]
  }, {
    "tStartMs": 343540,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "생각보다 높지 않습니다"
    } ]
  }, {
    "tStartMs": 345250,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "90%, 80%"
    } ]
  }, {
    "tStartMs": 346350,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "이렇게 될 것 같잖아요 아니에요"
    } ]
  }, {
    "tStartMs": 347850,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "공화당이 세다 그래도 56%예요"
    } ]
  }, {
    "tStartMs": 350030,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "그리고 민주당이"
    } ]
  }, {
    "tStartMs": 350830,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "뭐 한 40 몇% 이렇게 나옵니다"
    } ]
  }, {
    "tStartMs": 352420,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "그런데 하원의석은"
    } ]
  }, {
    "tStartMs": 353410,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "65%를 차지하고 있는 거예요"
    } ]
  }, {
    "tStartMs": 355650,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "그러니까 득표율 대비해서는"
    } ]
  }, {
    "tStartMs": 357090,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "의석을 많이 차지하고 있는데"
    } ]
  }, {
    "tStartMs": 358780,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "그것도 부족하니까 5석을 늘려봐라"
    } ]
  }, {
    "tStartMs": 361220,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "어떻게 늘릴 수 있냐?"
    } ]
  }, {
    "tStartMs": 362280,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "이렇게 만들면 됩니다"
    } ]
  }, {
    "tStartMs": 363960,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "이렇게 아까 설명드렸죠?"
    } ]
  }, {
    "tStartMs": 365240,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "공화당이 유리한 데"
    } ]
  }, {
    "tStartMs": 366660,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "난 여기를 하고 싶은데"
    } ]
  }, {
    "tStartMs": 367940,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "유리한 데까지 이렇게 내리면 됩니다"
    } ]
  }, {
    "tStartMs": 369980,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "이렇게 만들면"
    } ]
  }, {
    "tStartMs": 371570,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "여기 있는 의석을 다 가져올 수 있어요"
    } ]
  }, {
    "tStartMs": 373700,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "이게 뭐냐?"
    } ]
  }, {
    "tStartMs": 374620,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "농장 그런 겁니다"
    } ]
  }, {
    "tStartMs": 375680,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "농장, 목장 그런 게 있는데"
    } ]
  }, {
    "tStartMs": 376870,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "이쪽에 사람이"
    } ]
  }, {
    "tStartMs": 378080,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "많이 사는 데면"
    } ]
  }, {
    "tStartMs": 380080,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "이렇게 늘려서 이렇게 만들면 됩니다"
    } ]
  }, {
    "tStartMs": 381730,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "이게 실제로 이번에 추진하고 있는 거예요"
    } ]
  }, {
    "tStartMs": 383840,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "디스트릭트 32번"
    } ]
  }, {
    "tStartMs": 385990,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "구역을 이렇게 만들고요"
    } ]
  }, {
    "tStartMs": 387680,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "제가 지금 보여드린 건 실제입니다"
    } ]
  }, {
    "tStartMs": 390300,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "35번 구역도"
    } ]
  }, {
    "tStartMs": 392060,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "이런 식으로"
    } ]
  }, {
    "tStartMs": 393730,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "이렇게 파란색을 먹은 다음에"
    } ]
  }, {
    "tStartMs": 395010,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "이쪽은 안 될 것 같아"
    } ]
  }, {
    "tStartMs": 396330,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "거긴 빼고 이렇게 잘라가지고"
    } ]
  }, {
    "tStartMs": 398260,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "이렇게 하면"
    } ]
  }, {
    "tStartMs": 398970,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "여기를 먹을 수 있어요"
    } ]
  }, {
    "tStartMs": 400640,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "좋습니다"
    } ]
  }, {
    "tStartMs": 401250,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "여기는 안 돼"
    } ]
  }, {
    "tStartMs": 402110,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "안 되겠는 데 빼고"
    } ]
  }, {
    "tStartMs": 403170,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "샌 안토니아 이런 데 마음에 안 들어"
    } ]
  }, {
    "tStartMs": 404640,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "이렇게 빼고 넣으면 되는 거고요"
    } ]
  }, {
    "tStartMs": 407050,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "이런 거 다섯 번 하면 됩니다"
    } ]
  }, {
    "tStartMs": 408120,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "다섯 석을 늘리려면 이렇게"
    } ]
  }, {
    "tStartMs": 410400,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "이렇게 정교하게 이렇게"
    } ]
  }, {
    "tStartMs": 411580,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "자른 다음에"
    } ]
  }, {
    "tStartMs": 413550,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "뒤로 붙이기"
    } ]
  }, {
    "tStartMs": 414380,
    "dDurationMs": 670,
    "segs": [ {
      "utf8": "오케이 콜"
    } ]
  }, {
    "tStartMs": 415050,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "하여튼 그렇게 하면 돼요"
    } ]
  }, {
    "tStartMs": 417520,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "자 이렇게 하면은"
    } ]
  }, {
    "tStartMs": 418410,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "이제 아주 정교하게"
    } ]
  }, {
    "tStartMs": 419830,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "다섯 석에서 이길 수 있다는 건데"
    } ]
  }, {
    "tStartMs": 422150,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "자, 그런데"
    } ]
  }, {
    "tStartMs": 423030,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "여기서 드는 의문점이 그거죠"
    } ]
  }, {
    "tStartMs": 424700,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "그걸 어떻게 자른다는 건 알겠어"
    } ]
  }, {
    "tStartMs": 426380,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "근데 그래도 되냐"
    } ]
  }, {
    "tStartMs": 429590,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "저게 합법이냐"
    } ]
  }, {
    "tStartMs": 431960,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "우리나라 같으면 저거 하면 난리 나겠죠"
    } ]
  }, {
    "tStartMs": 433970,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "그래도 되냐 너무 당당하게 목표로 박았잖아"
    } ]
  }, {
    "tStartMs": 436870,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "우리가 다섯 석을 더 받기 위해서"
    } ]
  }, {
    "tStartMs": 439100,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "개리맨더링을 하겠다"
    } ]
  }, {
    "tStartMs": 440290,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "선거구 재조정 하겠다"
    } ]
  }, {
    "tStartMs": 441590,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "공식적으로 얘기하고 하는데"
    } ]
  }, {
    "tStartMs": 443430,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "그래도 되냐?"
    } ]
  }, {
    "tStartMs": 444990,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "물론 좋은 성적을 거둔"
    } ]
  }, {
    "tStartMs": 447090,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "일단 65%를 테사스주에서 차지했으니까"
    } ]
  }, {
    "tStartMs": 449600,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "스스로 선거구를 조금 더 먹자고"
    } ]
  }, {
    "tStartMs": 451790,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "다시 그린 사례는 거의 없었다"
    } ]
  }, {
    "tStartMs": 453550,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "떠올릴 수 없다고 하는데"
    } ]
  }, {
    "tStartMs": 454390,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "이건 역사상 사례고"
    } ]
  }, {
    "tStartMs": 455510,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "법으로 금지되어 있는 건 아니냐?"
    } ]
  }, {
    "tStartMs": 457430,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "당연히 법으로 안 될 것 같은데"
    } ]
  }, {
    "tStartMs": 459680,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "놀랍게도 현재 미국에서는"
    } ]
  }, {
    "tStartMs": 462000,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "합법이라고 합니다"
    } ]
  }, {
    "tStartMs": 462830,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "합법이라고 한다기보단"
    } ]
  }, {
    "tStartMs": 464680,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "막을 수 없다고 합니다"
    } ]
  }, {
    "tStartMs": 466660,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "막을 수 없다"
    } ]
  }, {
    "tStartMs": 467580,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "그게 무슨 소리냐?"
    } ]
  }, {
    "tStartMs": 468640,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "저렇게 개리맨더링을 한 선거구를 가지고"
    } ]
  }, {
    "tStartMs": 471110,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "대법원에 올라갔어요"
    } ]
  }, {
    "tStartMs": 472960,
    "dDurationMs": 520,
    "segs": [ {
      "utf8": "2019년에"
    } ]
  }, {
    "tStartMs": 473480,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "왜냐?"
    } ]
  }, {
    "tStartMs": 474190,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "선거구를 저렇게 당파적 이유로"
    } ]
  }, {
    "tStartMs": 476440,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "자기 유리한 대로"
    } ]
  }, {
    "tStartMs": 477370,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "자르는 거를 막아주세요"
    } ]
  }, {
    "tStartMs": 479150,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "위헌 판결해주세요라고 올라왔는데"
    } ]
  }, {
    "tStartMs": 481100,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "대법원이 부결했습니다"
    } ]
  }, {
    "tStartMs": 483930,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "선거구를 심사할 수 있는"
    } ]
  }, {
    "tStartMs": 485590,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "연방법원의 권한은 없다"
    } ]
  }, {
    "tStartMs": 488280,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "실제로 질문이 이렇게 나왔어요"
    } ]
  }, {
    "tStartMs": 489810,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "극단적 당파적인 개리맨더링이"
    } ]
  }, {
    "tStartMs": 491990,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "헌법상의 권리를 침해했는가?"
    } ]
  }, {
    "tStartMs": 494110,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "2019년 미 연방대법원은"
    } ]
  }, {
    "tStartMs": 496190,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "찬성 5표, 반대 4표로 침해 여부를"
    } ]
  }, {
    "tStartMs": 498660,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "연방법원이 심사할 수 없다"
    } ]
  }, {
    "tStartMs": 500830,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "보수 대법관 전원이"
    } ]
  }, {
    "tStartMs": 502260,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "심사할 수 없다라고 선언을 했고요"
    } ]
  }, {
    "tStartMs": 504470,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "진보 대법관 4명은"
    } ]
  }, {
    "tStartMs": 506150,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "이거를 법원이"
    } ]
  }, {
    "tStartMs": 507300,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "OX를 매겨야된다고 얘기를 했습니다"
    } ]
  }, {
    "tStartMs": 508950,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "5대 4로"
    } ]
  }, {
    "tStartMs": 509990,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "연방대법원은 더 이상"
    } ]
  }, {
    "tStartMs": 511380,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "선거구 획정에 대해서"
    } ]
  }, {
    "tStartMs": 512870,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "헌법상이나 아니면"
    } ]
  }, {
    "tStartMs": 514180,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "판결을 심사를 할 수 없어요"
    } ]
  }, {
    "tStartMs": 516010,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "그러면 그걸 누가 판단을 하냐"
    } ]
  }, {
    "tStartMs": 518610,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "연방대법원장은 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 521010,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "연방판사들은 두 주요 정당 간에"
    } ]
  }, {
    "tStartMs": 523600,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "정치적 권력을 어떻게 나눌지에 대해서"
    } ]
  }, {
    "tStartMs": 526060,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "의견을 심사를 할 권한이 없다"
    } ]
  }, {
    "tStartMs": 528850,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "그럼 누가 판단합니까?"
    } ]
  }, {
    "tStartMs": 529780,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "그건 정당들이 알아서 해야지"
    } ]
  }, {
    "tStartMs": 531900,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "정치잖아"
    } ]
  }, {
    "tStartMs": 533590,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "아니면 이렇게"
    } ]
  }, {
    "tStartMs": 535200,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "개리맨더링을 하건"
    } ]
  }, {
    "tStartMs": 536700,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "이렇게 하건"
    } ]
  }, {
    "tStartMs": 538530,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "그건 정치잖아"
    } ]
  }, {
    "tStartMs": 540100,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "정치인들이 알아서 해야지"
    } ]
  }, {
    "tStartMs": 541280,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "정치인들이 정치하다가"
    } ]
  }, {
    "tStartMs": 542640,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "얘 잘못한 것 같아요라고"
    } ]
  }, {
    "tStartMs": 543790,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "법원에 가져오면 그게 되냐?"
    } ]
  }, {
    "tStartMs": 546140,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "아니 그런데"
    } ]
  }, {
    "tStartMs": 547230,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "법은 공정함을 따지는 건데"
    } ]
  }, {
    "tStartMs": 548990,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "자의적인 선거구확정은 불공정하지 않습니까?"
    } ]
  }, {
    "tStartMs": 551940,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "이렇게 얘기했습니다 맞다"
    } ]
  }, {
    "tStartMs": 553680,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "그딴 식으로 그리는 건 대단히 불공정해"
    } ]
  }, {
    "tStartMs": 556160,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "불공정한 건 맞아"
    } ]
  }, {
    "tStartMs": 557360,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "하지만 개리맨더링이"
    } ]
  }, {
    "tStartMs": 559080,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "민주주의 원칙과 양립할 수 없다고 하더라도"
    } ]
  }, {
    "tStartMs": 561730,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "그 해결책이"
    } ]
  }, {
    "tStartMs": 563210,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "연방사법부"
    } ]
  }, {
    "tStartMs": 564250,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "대법원에 있다는 걸 의미하진 않는다"
    } ]
  }, {
    "tStartMs": 566970,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "그거는 니들이 이렇게 잘라"
    } ]
  }, {
    "tStartMs": 568310,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "개리맨더링을 해"
    } ]
  }, {
    "tStartMs": 569040,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "그래서 유권자들이 저런저런"
    } ]
  }, {
    "tStartMs": 570520,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "공화당이 못된 짓을 했군요"
    } ]
  }, {
    "tStartMs": 571800,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "그래서 표를 적게 줘"
    } ]
  }, {
    "tStartMs": 572850,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "그럼 공화당이 다음에 지겠지"
    } ]
  }, {
    "tStartMs": 574640,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "그럼 민주당이 이렇게 다시"
    } ]
  }, {
    "tStartMs": 575780,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "자르면 되는 거 아니야"
    } ]
  }, {
    "tStartMs": 576670,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "정치적으로 해결해야지"
    } ]
  }, {
    "tStartMs": 577820,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "그걸 왜 법원에 가져와 라고"
    } ]
  }, {
    "tStartMs": 579790,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "보수 대법관 5명이 얘기를 해서"
    } ]
  }, {
    "tStartMs": 581940,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "그 권한이 없었다는 걸 의미합니다"
    } ]
  }, {
    "tStartMs": 584510,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "실제로 이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 585510,
    "dDurationMs": 3770,
    "segs": [ {
      "utf8": "헌법에 그런 정치적인 기준은 없다"
    } ]
  }, {
    "tStartMs": 589280,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "그런 기준이 명시되어 있지 않다"
    } ]
  }, {
    "tStartMs": 591050,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "명확하고 실행 가능하며"
    } ]
  }, {
    "tStartMs": 592410,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "정치적으로 중립적이고 제한적인"
    } ]
  }, {
    "tStartMs": 594050,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "구체적인 기준이 없어"
    } ]
  }, {
    "tStartMs": 595390,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "우리도 뭐가 정의롭지 않은 건 알아"
    } ]
  }, {
    "tStartMs": 597350,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "하지만 뭐가 맞고 뭐가 틀린지는"
    } ]
  }, {
    "tStartMs": 598910,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "모르겠다라고 얘기를 했고요"
    } ]
  }, {
    "tStartMs": 600930,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "물론 소수 의견을 낸"
    } ]
  }, {
    "tStartMs": 602590,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "4명의 진보 대법관들은"
    } ]
  }, {
    "tStartMs": 603690,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "이때 아주 격양된 말이 나왔습니다"
    } ]
  }, {
    "tStartMs": 606950,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "법이 무엇인지"
    } ]
  }, {
    "tStartMs": 607880,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "선언해야 할 대법원의 의무를 져버렸던"
    } ]
  }, {
    "tStartMs": 609920,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "수많은 순간들이 있는데"
    } ]
  }, {
    "tStartMs": 611390,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "역사를 되돌아보면"
    } ]
  }, {
    "tStartMs": 612950,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "그 중에서도 이번 대법원의 결정은"
    } ]
  }, {
    "tStartMs": 615070,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "최악의 순간이다"
    } ]
  }, {
    "tStartMs": 616760,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "법원의 역할 중 하나는"
    } ]
  }, {
    "tStartMs": 617870,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "그 체제의 근간을 수호하는 것이고"
    } ]
  }, {
    "tStartMs": 619870,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "자유롭고 공정한 선거보다"
    } ]
  }, {
    "tStartMs": 621320,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "중요한 근간은 없는데"
    } ]
  }, {
    "tStartMs": 622550,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "이번에 대법원의 선고는"
    } ]
  }, {
    "tStartMs": 624030,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "그런 법원의 역할을 져버렸다"
    } ]
  }, {
    "tStartMs": 625840,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "뭐가 자유롭고"
    } ]
  }, {
    "tStartMs": 626760,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "뭐가 공정한지에 대한"
    } ]
  }, {
    "tStartMs": 628030,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "뭐 의견을 안 내는"
    } ]
  }, {
    "tStartMs": 628970,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "심사를 못하겠다고 얘기하니까"
    } ]
  }, {
    "tStartMs": 630500,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "그걸 저버린 게 아니냐"
    } ]
  }, {
    "tStartMs": 632140,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "라고 강력한 소수의견이 나왔죠"
    } ]
  }, {
    "tStartMs": 633750,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "하지만 소수였기 때문에"
    } ]
  }, {
    "tStartMs": 635150,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "지금은 그렇습니다"
    } ]
  }, {
    "tStartMs": 636360,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "그래서 이번에 텍사스주가 선거구 재조정할 때도"
    } ]
  }, {
    "tStartMs": 638600,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "당연히 법원까지 의견이 갔어요"
    } ]
  }, {
    "tStartMs": 641160,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "이걸 누가 이래도 되냐라고 소송을 걸었어요"
    } ]
  }, {
    "tStartMs": 643480,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "하지만 대법원까지 올라갔지만"
    } ]
  }, {
    "tStartMs": 644890,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "역시 안 됐습니다"
    } ]
  }, {
    "tStartMs": 646230,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "왜냐하면 지방법원은 새로운 선거구가"
    } ]
  }, {
    "tStartMs": 648590,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "위법하다라고 판단을 했거든요"
    } ]
  }, {
    "tStartMs": 650760,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "물론 여기 위법하다고 판단한 거는"
    } ]
  }, {
    "tStartMs": 652670,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "장애인이 많거나"
    } ]
  }, {
    "tStartMs": 654050,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "뭐 소수인종이 많거나"
    } ]
  }, {
    "tStartMs": 655440,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "이런 데를 인위적으로 잘랐기 때문에"
    } ]
  }, {
    "tStartMs": 657230,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "평등권을 침해한다"
    } ]
  }, {
    "tStartMs": 658410,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "뭐 이렇게 위법한다는 했는데"
    } ]
  }, {
    "tStartMs": 659710,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "이게 대법원까지 간 다음에 뒤집혔습니다"
    } ]
  }, {
    "tStartMs": 662390,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "이런 예비선거운동에서"
    } ]
  }, {
    "tStartMs": 663860,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "법원이 부적절하게 개입하는 건"
    } ]
  }, {
    "tStartMs": 665410,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "큰 혼란을 야기하기 때문에"
    } ]
  }, {
    "tStartMs": 667080,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "선거구 재조정안은 유효하다"
    } ]
  }, {
    "tStartMs": 669190,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "이런 선거구 재조정안이"
    } ]
  }, {
    "tStartMs": 670520,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "정치적 목적이 없다고 보는 겁니까?"
    } ]
  }, {
    "tStartMs": 672330,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "이번 판결은 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 673950,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "2025년 판결이에요"
    } ]
  }, {
    "tStartMs": 675320,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "공화당에 유리한 정치적 목적을"
    } ]
  }, {
    "tStartMs": 676960,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "가지고 있음을 인정한다"
    } ]
  }, {
    "tStartMs": 678830,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "하지만 뭐 어쩌겠어?"
    } ]
  }, {
    "tStartMs": 680320,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "대법원이 그걸 판단하는 데가 아닌데"
    } ]
  }, {
    "tStartMs": 682270,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "정치적 목적을 가진 선거구 획정이라도"
    } ]
  }, {
    "tStartMs": 684000,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "우리가 심사하는 곳이 아니야"
    } ]
  }, {
    "tStartMs": 685660,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "그러니까 인정할 수 있고"
    } ]
  }, {
    "tStartMs": 687210,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "아까 말한 대로"
    } ]
  }, {
    "tStartMs": 687930,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "평등권을 침해하고"
    } ]
  }, {
    "tStartMs": 688950,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "인종차별적 선거구 획정을 해도"
    } ]
  }, {
    "tStartMs": 691370,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "그 대안 제시를 못한"
    } ]
  }, {
    "tStartMs": 693060,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "정치적인 문제지"
    } ]
  }, {
    "tStartMs": 694140,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "법원이 판단할 문제는 아니다라고 얘기를 했습니다"
    } ]
  }, {
    "tStartMs": 696560,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "왜냐하면 이번에 자를 때"
    } ]
  }, {
    "tStartMs": 697860,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "텍사스 첫 주가"
    } ]
  }, {
    "tStartMs": 699360,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "유색 인종이 많이 있는 데는"
    } ]
  }, {
    "tStartMs": 700850,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "이렇게 걸렀어요"
    } ]
  }, {
    "tStartMs": 702360,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "백인들이 많이 있으면"
    } ]
  }, {
    "tStartMs": 703420,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "이런 식으로 만들었다가"
    } ]
  }, {
    "tStartMs": 705520,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "그랬다가 이후에 난리 난 거거든요"
    } ]
  }, {
    "tStartMs": 707580,
    "dDurationMs": 550,
    "segs": [ {
      "utf8": "야 뭐야"
    } ]
  }, {
    "tStartMs": 708130,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "나는 여기 사는데"
    } ]
  }, {
    "tStartMs": 709180,
    "dDurationMs": 650,
    "segs": [ {
      "utf8": "유색인종인데"
    } ]
  }, {
    "tStartMs": 709830,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "나는 빼고 요렇게"
    } ]
  }, {
    "tStartMs": 710960,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "선거가 된 거잖아"
    } ]
  }, {
    "tStartMs": 712410,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "그러다 보니까"
    } ]
  }, {
    "tStartMs": 713360,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "이걸로 평등을 걸었는데"
    } ]
  }, {
    "tStartMs": 715000,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "결국에 통과가 안 됐다고 보시면 되고요"
    } ]
  }, {
    "tStartMs": 717250,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "그러면 이번 법원의 합헌 판결로"
    } ]
  }, {
    "tStartMs": 719200,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "텍사스주는 결국 개리맨더링을 하게 됐는데"
    } ]
  }, {
    "tStartMs": 721690,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "문제는 여러분들이 민주당원이라고 생각해 보세요"
    } ]
  }, {
    "tStartMs": 724570,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "가만히 있겠습니까?"
    } ]
  }, {
    "tStartMs": 725980,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "내가 있는 주가"
    } ]
  }, {
    "tStartMs": 727410,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "나한테 불리한 것만 남겨"
    } ]
  }, {
    "tStartMs": 729340,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "유리한 건 쏙 빼갔어"
    } ]
  }, {
    "tStartMs": 730370,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "자기들끼리"
    } ]
  }, {
    "tStartMs": 731510,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "자신의 지역구가 눈뜨고 코베이는 거잖아요"
    } ]
  }, {
    "tStartMs": 733540,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "누가 플러스 5라는 거는"
    } ]
  }, {
    "tStartMs": 735130,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "누구는 마이너스 5라는 거예요"
    } ]
  }, {
    "tStartMs": 737150,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "당연히 민주당 하원위원 의원들은 묘수를 찾습니다"
    } ]
  }, {
    "tStartMs": 739730,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "방법이 없냐"
    } ]
  }, {
    "tStartMs": 741070,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "소송을 해봤는데 졌어"
    } ]
  }, {
    "tStartMs": 742720,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "대법원이 그래도 된대"
    } ]
  }, {
    "tStartMs": 744530,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "그럼 어떻게 해야 됩니까?"
    } ]
  }, {
    "tStartMs": 746180,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "저 텍사스 주의 선거구"
    } ]
  }, {
    "tStartMs": 748070,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "재획정 법안은"
    } ]
  }, {
    "tStartMs": 750110,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "텍사스 주의회를 통과해야 됩니다"
    } ]
  }, {
    "tStartMs": 753040,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "텍사스 주의회는"
    } ]
  }, {
    "tStartMs": 753860,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "공화당이 88석이고"
    } ]
  }, {
    "tStartMs": 754950,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "민주당이 62석이에요"
    } ]
  }, {
    "tStartMs": 756450,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "역시 공화당이 과반이야"
    } ]
  }, {
    "tStartMs": 757780,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "당연히 통과돼요"
    } ]
  }, {
    "tStartMs": 759140,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "방법이 없는 거 아니냐"
    } ]
  }, {
    "tStartMs": 760890,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "텍사스 주의회는 법안 통과를 위해서는"
    } ]
  }, {
    "tStartMs": 763410,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "전체 의원의 3분의 2 이상이 출석하고"
    } ]
  }, {
    "tStartMs": 765920,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "참석 의원의 과반수 찬성이면 통과합니다"
    } ]
  }, {
    "tStartMs": 768590,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "공화당이 88석이니까 과반수니까"
    } ]
  }, {
    "tStartMs": 770390,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "무조건 통과해요"
    } ]
  }, {
    "tStartMs": 771690,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "자 그러면 민주당 입장에서"
    } ]
  }, {
    "tStartMs": 772750,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "할 수 있는 게 없냐? 있죠"
    } ]
  }, {
    "tStartMs": 773830,
    "dDurationMs": 550,
    "segs": [ {
      "utf8": "하나 있어요"
    } ]
  }, {
    "tStartMs": 774380,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "뭐가 있습니까?"
    } ]
  }, {
    "tStartMs": 775710,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "전체 의원의 3분의 2 이상이"
    } ]
  }, {
    "tStartMs": 777360,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "출석해야 국회가 열립니다"
    } ]
  }, {
    "tStartMs": 780130,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "그러면 자기들은 과반수는 아니지만"
    } ]
  }, {
    "tStartMs": 781940,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "민주당 의원들이 도망을 가면"
    } ]
  }, {
    "tStartMs": 783920,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "국회가 안 열려요"
    } ]
  }, {
    "tStartMs": 785020,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "출석하지 않으면"
    } ]
  }, {
    "tStartMs": 786240,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "민주당 의원 50명 이상이"
    } ]
  }, {
    "tStartMs": 787640,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "의회에 출석하지 않으면"
    } ]
  }, {
    "tStartMs": 788570,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "100명이 안 되니까"
    } ]
  }, {
    "tStartMs": 789300,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "개회가 안 돼"
    } ]
  }, {
    "tStartMs": 790460,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "그럼 이 법안이 통과 안 되잖아"
    } ]
  }, {
    "tStartMs": 792580,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "그럼 참석하지 않으면 되냐?"
    } ]
  }, {
    "tStartMs": 794310,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "않으면 되죠"
    } ]
  }, {
    "tStartMs": 795040,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "민주당 의원들이 이번에 뭘 결정을 했냐?"
    } ]
  }, {
    "tStartMs": 797810,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "도망을 결정했습니다"
    } ]
  }, {
    "tStartMs": 799360,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "실화예요 실화"
    } ]
  }, {
    "tStartMs": 800820,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "왜냐하면 텍사스 주 안에 있으면"
    } ]
  }, {
    "tStartMs": 802820,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "체포해 놀랍게도"
    } ]
  }, {
    "tStartMs": 804800,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "체포해서 의사당에 밀어넣어"
    } ]
  }, {
    "tStartMs": 807030,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "그런 얘기를 해요"
    } ]
  }, {
    "tStartMs": 807870,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "잡아와서 의사당에 밀어넣어"
    } ]
  }, {
    "tStartMs": 809650,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "그러니까 텍사스 민주당 의원들이"
    } ]
  }, {
    "tStartMs": 811750,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "다 같이 모여서"
    } ]
  }, {
    "tStartMs": 812810,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "우리 2주간 옆 주로 도망갑니다"
    } ]
  }, {
    "tStartMs": 815050,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "선언을 하고 도망갔어요"
    } ]
  }, {
    "tStartMs": 816880,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "탈출했습니다 탈출"
    } ]
  }, {
    "tStartMs": 818600,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "남아있으면 체포되고 끌려서"
    } ]
  }, {
    "tStartMs": 819960,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "국회로 갈 수 있어"
    } ]
  }, {
    "tStartMs": 821120,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "그럼 그 순간 100명에 대한 문이 열리잖아"
    } ]
  }, {
    "tStartMs": 822860,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "그래서 도망을 갔고요"
    } ]
  }, {
    "tStartMs": 824500,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "도망을 가니까"
    } ]
  }, {
    "tStartMs": 825660,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "그걸 보고 있던 텍사스 주에서는"
    } ]
  }, {
    "tStartMs": 828020,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "또 야 뭐하는 짓이야"
    } ]
  }, {
    "tStartMs": 829470,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "아니 의원들이 의회를 안 열고"
    } ]
  }, {
    "tStartMs": 831050,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "도망가면 어떡해"
    } ]
  }, {
    "tStartMs": 832410,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "텍사스 법무장관이"
    } ]
  }, {
    "tStartMs": 833750,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "극대노해서 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 835030,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "법 위에 있다고 생각하는 자들을"
    } ]
  }, {
    "tStartMs": 836700,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "추적하기 위해서"
    } ]
  }, {
    "tStartMs": 838230,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "주정부가 가진 모든 수단을 동원하겠다"
    } ]
  }, {
    "tStartMs": 840600,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "자신의 주의 국회의원들을 추적하러"
    } ]
  }, {
    "tStartMs": 843300,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "옆 주로 가야 돼"
    } ]
  }, {
    "tStartMs": 844960,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "잡아오러"
    } ]
  }, {
    "tStartMs": 845720,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "저 겁쟁이들을 즉시 찾아내 체포하고"
    } ]
  }, {
    "tStartMs": 848380,
    "dDurationMs": 470,
    "segs": [ {
      "utf8": "놀랍습니다"
    } ]
  }, {
    "tStartMs": 848850,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "진짜 체포예요"
    } ]
  }, {
    "tStartMs": 849680,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "체포하고 의사당으로 데려와라"
    } ]
  }, {
    "tStartMs": 852100,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "이렇게 하고"
    } ]
  }, {
    "tStartMs": 852780,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "야 미안해 하면서"
    } ]
  }, {
    "tStartMs": 854750,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "데려와야 되는 거죠"
    } ]
  }, {
    "tStartMs": 856800,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "정치의 세계는 심오해"
    } ]
  }, {
    "tStartMs": 858460,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "우리가 알지 못하는 뭐가 있는 거야"
    } ]
  }, {
    "tStartMs": 859980,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "이래도 되냐 그건 모르겠어요"
    } ]
  }, {
    "tStartMs": 861610,
    "dDurationMs": 590,
    "segs": [ {
      "utf8": "도망가도 되냐"
    } ]
  }, {
    "tStartMs": 862200,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "그것도 모르겠고"
    } ]
  }, {
    "tStartMs": 863100,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "국회의원이 출석 안 한다고"
    } ]
  }, {
    "tStartMs": 864700,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "체포해서 끌고 와서"
    } ]
  }, {
    "tStartMs": 865790,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "의사당에 넣어도 되는지 잘 모르겠지만"
    } ]
  }, {
    "tStartMs": 868230,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "하여튼 미국은 그렇게 돌아갑니다"
    } ]
  }, {
    "tStartMs": 869650,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "또 주기적으로 가끔 이렇게 한대"
    } ]
  }, {
    "tStartMs": 871420,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "그랬지만 2주를 버텼지만"
    } ]
  }, {
    "tStartMs": 873390,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "결국에는 끝내 오래가지 못했고"
    } ]
  }, {
    "tStartMs": 875800,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "텍사스 선거구 재획정안은 통과가 됐습니다"
    } ]
  }, {
    "tStartMs": 878670,
    "dDurationMs": 530,
    "segs": [ {
      "utf8": "통과할 때"
    } ]
  }, {
    "tStartMs": 879200,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "텍사스 상원의원이 이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 880590,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "자 좋습니다"
    } ]
  }, {
    "tStartMs": 881470,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "이제 공화당 하은 의원 후보들에게"
    } ]
  }, {
    "tStartMs": 883660,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "더 유리한 선거가 책정이 됐다"
    } ]
  }, {
    "tStartMs": 885500,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "라고 당당하게 얘기하면서"
    } ]
  }, {
    "tStartMs": 886890,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "텍사스 선거구 재획정안이 통과가 됐습니다"
    } ]
  }, {
    "tStartMs": 889500,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "이 통과가 되는 걸 보고"
    } ]
  }, {
    "tStartMs": 890680,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "트럼프 대통령이 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 891870,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "아 역시 텍사스야"
    } ]
  }, {
    "tStartMs": 893610,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "텍사스는 우리를 결코 실망시키지 않는군요"
    } ]
  }, {
    "tStartMs": 896460,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "더 많은 공화당 의석은"
    } ]
  }, {
    "tStartMs": 897760,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "아마 범죄를 감소시키고"
    } ]
  }, {
    "tStartMs": 899390,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "경제를 번창시키고"
    } ]
  }, {
    "tStartMs": 900430,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "총기 소유권을 강화할 겁니다"
    } ]
  }, {
    "tStartMs": 901850,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "너무 잘했어요"
    } ]
  }, {
    "tStartMs": 902780,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "그리고 생각해보면"
    } ]
  }, {
    "tStartMs": 904080,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "우리가 굳이"
    } ]
  }, {
    "tStartMs": 905380,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "텍사스만 그럴 필요가 있을까요?"
    } ]
  }, {
    "tStartMs": 907800,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "공화당이 의회의 다수인 주가"
    } ]
  }, {
    "tStartMs": 910190,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "텍사스 하나입니까?"
    } ]
  }, {
    "tStartMs": 911740,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "미주리, 인디애나,"
    } ]
  }, {
    "tStartMs": 913130,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "다른 주들도 있잖아요"
    } ]
  }, {
    "tStartMs": 914520,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "그럼 뭐하고 있는 거죠?"
    } ]
  }, {
    "tStartMs": 915530,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "텍사스가 이렇게 잘하고 있는데"
    } ]
  }, {
    "tStartMs": 917100,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "다른 주는 이렇게"
    } ]
  }, {
    "tStartMs": 918240,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "아무것도 안 해도 되는 겁니까?"
    } ]
  }, {
    "tStartMs": 919940,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "텍사스주의 선례를 따르면"
    } ]
  }, {
    "tStartMs": 921400,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "아주 좋을 것 같습니다"
    } ]
  }, {
    "tStartMs": 922940,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "라고 얘기를 했어요"
    } ]
  }, {
    "tStartMs": 924060,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "놀랍게도 지금 제가 텍사스만 얘기했지만"
    } ]
  }, {
    "tStartMs": 926820,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "미주리, 오하이오, 노스캐롤라이나, 플로리다,"
    } ]
  }, {
    "tStartMs": 930110,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "인디애나 등등"
    } ]
  }, {
    "tStartMs": 931560,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "공화당이 우위라고 말하는 주들이"
    } ]
  }, {
    "tStartMs": 933900,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "전부 다 개리맨더링을 시도하고 있습니다"
    } ]
  }, {
    "tStartMs": 936970,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "지금 미국이 현재예요"
    } ]
  }, {
    "tStartMs": 938120,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "미주리는 플러스 한 석을 기대한다고 하고요"
    } ]
  }, {
    "tStartMs": 940550,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "오하이오는 플러스 두 석을 목표로 한다고 하고"
    } ]
  }, {
    "tStartMs": 942830,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "놀랍게도 목표 숫자도 나와"
    } ]
  }, {
    "tStartMs": 944990,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "이걸 이렇게 공식적으로"
    } ]
  }, {
    "tStartMs": 946290,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "목표를 얘기해도 되냐? 모르겠어요"
    } ]
  }, {
    "tStartMs": 947880,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "된대 미국은"
    } ]
  }, {
    "tStartMs": 948780,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "대부분 된다고 하니까"
    } ]
  }, {
    "tStartMs": 950080,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "억울하면 꼬우면 선거 이기던지"
    } ]
  }, {
    "tStartMs": 952210,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "꼬우면 선거 이겨서"
    } ]
  }, {
    "tStartMs": 953070,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "니들이 니들 쪽 두 석 해라"
    } ]
  }, {
    "tStartMs": 954740,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "지금 우리가 다수잖아"
    } ]
  }, {
    "tStartMs": 955870,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "뭐 하면 되는 거지"
    } ]
  }, {
    "tStartMs": 956920,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "어쩌라고 이게 정치라는데"
    } ]
  }, {
    "tStartMs": 958240,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "자 그래서 원시트 투시트"
    } ]
  }, {
    "tStartMs": 959800,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "플로리다는 두석에서"
    } ]
  }, {
    "tStartMs": 961780,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "다섯석까지도 노린다"
    } ]
  }, {
    "tStartMs": 963730,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "이런 식으로 개리맨더링을 지금 하고 있다고 하고요"
    } ]
  }, {
    "tStartMs": 966490,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "자 그러면 공화당이 저런다는 거는"
    } ]
  }, {
    "tStartMs": 968810,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "전체 화원의석이 늘어나는 건 아니니까"
    } ]
  }, {
    "tStartMs": 970720,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "민주당은 피해를 본다는 거죠"
    } ]
  }, {
    "tStartMs": 972320,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "자 민주당도 가만히 있으면 되겠습니까?"
    } ]
  }, {
    "tStartMs": 974560,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "당연히 해야죠"
    } ]
  }, {
    "tStartMs": 976450,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "당연히 해야지"
    } ]
  }, {
    "tStartMs": 977800,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "우리가 뭐 빙다리 핫바지야?"
    } ]
  }, {
    "tStartMs": 979380,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "뭐 꿔다놓은 보릿자루야?"
    } ]
  }, {
    "tStartMs": 980960,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "가만히 있으면 안 되잖아"
    } ]
  }, {
    "tStartMs": 982160,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "안 하면 바보지"
    } ]
  }, {
    "tStartMs": 983490,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "당당하게 하는데"
    } ]
  }, {
    "tStartMs": 985140,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "공화당이 자기들이 주 의회를 장악한 주에서"
    } ]
  }, {
    "tStartMs": 987740,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "선거구을 그리면"
    } ]
  }, {
    "tStartMs": 988830,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "민주당도 민주당이 장악한 주에서는"
    } ]
  }, {
    "tStartMs": 991120,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "선거구 다시 그리면 되는 거 아니야"
    } ]
  }, {
    "tStartMs": 992650,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "물론 선거구 꼬락서니가"
    } ]
  }, {
    "tStartMs": 994010,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "뭐 이딴 식으로 되겠지만"
    } ]
  }, {
    "tStartMs": 995660,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "그건 뭐 알 바입니까?"
    } ]
  }, {
    "tStartMs": 997010,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "이긴 다음에 다시 생각하면 되지"
    } ]
  }, {
    "tStartMs": 998550,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "이번에 이기면 되는 거니까"
    } ]
  }, {
    "tStartMs": 1000010,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "민주당도 다시 그리자"
    } ]
  }, {
    "tStartMs": 1002260,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "그래서 농담이 아니라"
    } ]
  }, {
    "tStartMs": 1003750,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "2025년 11월 캘리포니아 주는"
    } ]
  }, {
    "tStartMs": 1005770,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "선거구 재조정 법안을 승인했습니다"
    } ]
  }, {
    "tStartMs": 1008240,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "캘리포니아 주지사 개빈 뉴썸이"
    } ]
  }, {
    "tStartMs": 1009590,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "당당하게 이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 1010870,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "우리는 주어진 상황을 직시하고"
    } ]
  }, {
    "tStartMs": 1012700,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "맞불 작전을 펼쳐야 됩니다"
    } ]
  }, {
    "tStartMs": 1014810,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "주먹에는 주먹"
    } ]
  }, {
    "tStartMs": 1015720,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "불에는 불"
    } ]
  }, {
    "tStartMs": 1016400,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "눈에는 눈이지"
    } ]
  }, {
    "tStartMs": 1017490,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "우리라고 못할 게 뭐 있냐"
    } ]
  }, {
    "tStartMs": 1018620,
    "dDurationMs": 3890,
    "segs": [ {
      "utf8": "그래서 지금 캘리포니아 주 선거구가"
    } ]
  }, {
    "tStartMs": 1022510,
    "dDurationMs": 670,
    "segs": [ {
      "utf8": "이렇게 자르고"
    } ]
  }, {
    "tStartMs": 1023180,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "저렇게 자르고"
    } ]
  }, {
    "tStartMs": 1023790,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "지금 자세히 안 갖고 올게요"
    } ]
  }, {
    "tStartMs": 1024780,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "하여튼 저렇게 저렇게 자르면 된다고 합니다"
    } ]
  }, {
    "tStartMs": 1027730,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "여기 지금 졌잖아"
    } ]
  }, {
    "tStartMs": 1029150,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "근데 어떻게 어떻게 잘라서"
    } ]
  }, {
    "tStartMs": 1030180,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "이렇게 넣으면 이길 수 있대"
    } ]
  }, {
    "tStartMs": 1031690,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "그래서 캘리포니아도 목표가"
    } ]
  }, {
    "tStartMs": 1032850,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "다섯 석입니다"
    } ]
  }, {
    "tStartMs": 1033760,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "다섯 성을 민주당이 더 차지할 수 있도록"
    } ]
  }, {
    "tStartMs": 1035920,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "선거구 재획정을 하고 있고요"
    } ]
  }, {
    "tStartMs": 1037710,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "그러면 여러분 잘 생각해 보세요"
    } ]
  }, {
    "tStartMs": 1039990,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "너무나 억울한 사람이 있습니다"
    } ]
  }, {
    "tStartMs": 1041150,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "누구겠습니까?"
    } ]
  }, {
    "tStartMs": 1042720,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "당연히 여기 있는 사람이에요"
    } ]
  }, {
    "tStartMs": 1044990,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "여기"
    } ]
  }, {
    "tStartMs": 1046170,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "나는 공화당 의원인데"
    } ]
  }, {
    "tStartMs": 1048270,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "캘리포니아에서 잘하고 있어요"
    } ]
  }, {
    "tStartMs": 1050010,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "이겼어"
    } ]
  }, {
    "tStartMs": 1050760,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "근데 캘리포니아주가"
    } ]
  }, {
    "tStartMs": 1051740,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "지 맘대로 이리 자르고"
    } ]
  }, {
    "tStartMs": 1053230,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "저리 자르고 해서"
    } ]
  }, {
    "tStartMs": 1054030,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "내 지역구가 지금 날라가게 생겼잖아"
    } ]
  }, {
    "tStartMs": 1056800,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "그러니까 당연히"
    } ]
  }, {
    "tStartMs": 1057900,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "캘리포니아주"
    } ]
  }, {
    "tStartMs": 1058660,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "여기 있는 공화당 하원의원은"
    } ]
  }, {
    "tStartMs": 1061160,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "공화당에 이렇게 얘기해요"
    } ]
  }, {
    "tStartMs": 1062190,
    "dDurationMs": 550,
    "segs": [ {
      "utf8": "그런 거 하지 마라"
    } ]
  }, {
    "tStartMs": 1062740,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "야 그런 거 하지 마"
    } ]
  }, {
    "tStartMs": 1063640,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "그거 하면 민주당도 하고"
    } ]
  }, {
    "tStartMs": 1064750,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "그럼 내 거 날라가"
    } ]
  }, {
    "tStartMs": 1065640,
    "dDurationMs": 320,
    "segs": [ {
      "utf8": "하지 마"
    } ]
  }, {
    "tStartMs": 1065960,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "이렇게 하잖아요"
    } ]
  }, {
    "tStartMs": 1066940,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "하지만 힘이 없죠"
    } ]
  }, {
    "tStartMs": 1068700,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "트럼프 대통령이 하라 그러는데"
    } ]
  }, {
    "tStartMs": 1070260,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "자기 지역구 보존하려고"
    } ]
  }, {
    "tStartMs": 1071660,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "야 하지마"
    } ]
  }, {
    "tStartMs": 1072840,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "우리 하면 나 날아가"
    } ]
  }, {
    "tStartMs": 1073810,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "라고 얘기할 수 없단 말이에요"
    } ]
  }, {
    "tStartMs": 1075240,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "실제로 그렇게 얘기한 사람이 있었습니다"
    } ]
  }, {
    "tStartMs": 1076790,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "누구냐?"
    } ]
  }, {
    "tStartMs": 1077630,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "방금 얘기 드렸듯이"
    } ]
  }, {
    "tStartMs": 1078990,
    "dDurationMs": 3790,
    "segs": [ {
      "utf8": "가만히 있던 캘리포니아 공화당 의원들입니다"
    } ]
  }, {
    "tStartMs": 1082780,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "마이너스 5석 되게 생겼잖아요"
    } ]
  }, {
    "tStartMs": 1084690,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "벼락을 맞았잖아 지금"
    } ]
  }, {
    "tStartMs": 1085640,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "내 선거구가 갈갈이 찢겨갖고"
    } ]
  }, {
    "tStartMs": 1087930,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "개리맨더링인지"
    } ]
  }, {
    "tStartMs": 1088660,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "무슨 만두라는지"
    } ]
  }, {
    "tStartMs": 1089700,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "이렇게 됐어 지금"
    } ]
  }, {
    "tStartMs": 1091220,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "당연히 자신의 당에 개리맨더링"
    } ]
  }, {
    "tStartMs": 1092720,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "하지 말라고 얘기를 했는데"
    } ]
  }, {
    "tStartMs": 1093740,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "이게 먹히지 않잖아"
    } ]
  }, {
    "tStartMs": 1095070,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "내가 피해를 보지만"
    } ]
  }, {
    "tStartMs": 1096020,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "놀랍게도 그래서"
    } ]
  }, {
    "tStartMs": 1097180,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "공화당을 탈퇴했습니다"
    } ]
  }, {
    "tStartMs": 1098820,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "케빈 카일리인데요"
    } ]
  }, {
    "tStartMs": 1100810,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "물론 양당을 다 비판해"
    } ]
  }, {
    "tStartMs": 1102690,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "이 카일리라는 의원은"
    } ]
  }, {
    "tStartMs": 1104220,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "그런 식으로 하면"
    } ]
  }, {
    "tStartMs": 1105040,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "민주적인 원칙에 어긋나는 거야"
    } ]
  }, {
    "tStartMs": 1106530,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "나는 이걸 참을 수 없어"
    } ]
  }, {
    "tStartMs": 1107810,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "라고 나왔는데"
    } ]
  }, {
    "tStartMs": 1108470,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "어쨌건 피를 봐서 나왔고요"
    } ]
  }, {
    "tStartMs": 1110880,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "아마 이렇게 개리맨더링 된 걸 봐서"
    } ]
  }, {
    "tStartMs": 1112470,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "무소속이 더 유리할 수도 있어요"
    } ]
  }, {
    "tStartMs": 1114200,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "현재 미국 하원에서"
    } ]
  }, {
    "tStartMs": 1115500,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "유일한 무소속 의원이라고 합니다"
    } ]
  }, {
    "tStartMs": 1117410,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "뭐 이렇게 됐다고 할 수 있고"
    } ]
  }, {
    "tStartMs": 1119110,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "결국 요약해보면"
    } ]
  }, {
    "tStartMs": 1120910,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "우리 같은 한국인들이 보기엔"
    } ]
  }, {
    "tStartMs": 1122430,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "좀 개판 5분전이 아닌가라는 생각이 드는데"
    } ]
  }, {
    "tStartMs": 1124740,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "지금 전부 다 선거구 재획정하고 있습니다"
    } ]
  }, {
    "tStartMs": 1127360,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "플러스 5석, 플러스 1석,"
    } ]
  }, {
    "tStartMs": 1129440,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "여기도 회색은 시도  중"
    } ]
  }, {
    "tStartMs": 1130560,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "회색은 시도 중인 주고"
    } ]
  }, {
    "tStartMs": 1132810,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "여기는 지금 2석, 2석"
    } ]
  }, {
    "tStartMs": 1134290,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "이런 식으로 하고 있어요"
    } ]
  }, {
    "tStartMs": 1135340,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "현재까지는 공화당이 6석이고"
    } ]
  }, {
    "tStartMs": 1137690,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "한 7-8석이 조금 앞서고 있습니다"
    } ]
  }, {
    "tStartMs": 1139210,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "누가 누가 더 그림을 잘 그리냐"
    } ]
  }, {
    "tStartMs": 1141520,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "이런 싸움을 하고 있다고 보시면 되고요"
    } ]
  }, {
    "tStartMs": 1143840,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "이런 상황이니까"
    } ]
  }, {
    "tStartMs": 1145300,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "트럼프 대통령 입장에선"
    } ]
  }, {
    "tStartMs": 1146430,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "좀 마음에 안 들죠"
    } ]
  }, {
    "tStartMs": 1147330,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "아니 공화당만 해야지"
    } ]
  }, {
    "tStartMs": 1148720,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "민주당까지 하면 어떡해"
    } ]
  }, {
    "tStartMs": 1150050,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "반격하는 거잖아요"
    } ]
  }, {
    "tStartMs": 1150880,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "우리가 플러스 5석 하면 뭐합니까?"
    } ]
  }, {
    "tStartMs": 1152570,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "저기도 플러스 5석 하면"
    } ]
  }, {
    "tStartMs": 1153830,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "똔똔이잖아 퉁"
    } ]
  }, {
    "tStartMs": 1155360,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "이거 안 된단 말이에요"
    } ]
  }, {
    "tStartMs": 1156190,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "그래서 지금 마음에 안 들죠"
    } ]
  }, {
    "tStartMs": 1157790,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "감히 반격을 하고"
    } ]
  }, {
    "tStartMs": 1159150,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "그래서 새로운 전략을 하나"
    } ]
  }, {
    "tStartMs": 1160830,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "요즘에 강하게 밀고 있습니다"
    } ]
  }, {
    "tStartMs": 1162310,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "그 전략은 또 다른 오늘의 주제인데요"
    } ]
  }, {
    "tStartMs": 1164370,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "바로 더 세이브 아메리카 액트입니다"
    } ]
  }, {
    "tStartMs": 1167440,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "미국 구하기 법안"
    } ]
  }, {
    "tStartMs": 1169850,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "또 다른 새로운 전략이에요"
    } ]
  }, {
    "tStartMs": 1171510,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "이번 중간선거를 이기기 위한 필수"
    } ]
  }, {
    "tStartMs": 1173680,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "아주 그냥 거의 뭐 핵무기 같은"
    } ]
  }, {
    "tStartMs": 1175930,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "강력한 법안이라고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 1177730,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "미국을 구하는 법안"
    } ]
  }, {
    "tStartMs": 1179550,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "미국을 어떻게 구하냐?"
    } ]
  }, {
    "tStartMs": 1180700,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "당연히 공화당"
    } ]
  }, {
    "tStartMs": 1181580,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "트럼프가 선거에서 이겨야"
    } ]
  }, {
    "tStartMs": 1183290,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "미국을 구하기 때문에"
    } ]
  }, {
    "tStartMs": 1184470,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "만든 법안입니다"
    } ]
  }, {
    "tStartMs": 1185580,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "그럼 어떻게 해야"
    } ]
  }, {
    "tStartMs": 1186390,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "내가 선거에서 이길 수 있냐?"
    } ]
  }, {
    "tStartMs": 1188280,
    "dDurationMs": 630,
    "segs": [ {
      "utf8": "만들면 되죠"
    } ]
  }, {
    "tStartMs": 1188910,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "이렇게 하는 겁니다"
    } ]
  }, {
    "tStartMs": 1190530,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "이 법안은 백악관 홈페이지에"
    } ]
  }, {
    "tStartMs": 1192120,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "가시면 볼 수 있고요"
    } ]
  }, {
    "tStartMs": 1193520,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "아주 상식적이고 초당적인"
    } ]
  }, {
    "tStartMs": 1195450,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "법안이라고 주장을 하고 있어요"
    } ]
  }, {
    "tStartMs": 1196920,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "아주 상식적이야"
    } ]
  }, {
    "tStartMs": 1197820,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "우리한테 유리하게 그렇게 안 해"
    } ]
  }, {
    "tStartMs": 1198960,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "개리맨더링은 그렇게 안 해"
    } ]
  }, {
    "tStartMs": 1200030,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "그렇게 자르고"
    } ]
  }, {
    "tStartMs": 1200920,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "이런 거는 주에서 하는 거지"
    } ]
  }, {
    "tStartMs": 1202820,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "치사하게 안 해"
    } ]
  }, {
    "tStartMs": 1203610,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "상식적이고 단순하고"
    } ]
  }, {
    "tStartMs": 1205540,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "초당적인 법안이다"
    } ]
  }, {
    "tStartMs": 1207100,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "내용은 뭐냐?"
    } ]
  }, {
    "tStartMs": 1208000,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "내용은 간단합니다"
    } ]
  }, {
    "tStartMs": 1209300,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "진짜 상식적이에요"
    } ]
  }, {
    "tStartMs": 1210000,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "우리가 보기엔"
    } ]
  }, {
    "tStartMs": 1211150,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "연방선거 투표 등록 전에"
    } ]
  }, {
    "tStartMs": 1213130,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "유권자 등록하기 전에"
    } ]
  }, {
    "tStartMs": 1214940,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "유효한 신분증이나 시민권을 제시해라"
    } ]
  }, {
    "tStartMs": 1218060,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "이게 아메리칸 미국 구하기 법안입니다"
    } ]
  }, {
    "tStartMs": 1220470,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "그리고 우편 투표는 없다"
    } ]
  }, {
    "tStartMs": 1222240,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "인정하지 않겠다"
    } ]
  }, {
    "tStartMs": 1223190,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "직접 유효한 신분증이나"
    } ]
  }, {
    "tStartMs": 1224840,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "시민권을 제시해서"
    } ]
  }, {
    "tStartMs": 1226240,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "유권자 등록을 한 다음에"
    } ]
  }, {
    "tStartMs": 1227770,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "나와서 투표를 해라"
    } ]
  }, {
    "tStartMs": 1229510,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "얼핏 들으면 그렇게 안 했습니까?"
    } ]
  }, {
    "tStartMs": 1231650,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "지금까지는?"
    } ]
  }, {
    "tStartMs": 1232380,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "지금까지는 잠깐만"
    } ]
  }, {
    "tStartMs": 1233430,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "우편 투표 막는 거는"
    } ]
  }, {
    "tStartMs": 1234870,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "뭐 좀 새로울 수 있는데"
    } ]
  }, {
    "tStartMs": 1235660,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "아니 우리 주민등록증 내고"
    } ]
  }, {
    "tStartMs": 1237530,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "이거 확인하고 사인하고 가잖아요"
    } ]
  }, {
    "tStartMs": 1239140,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "우리는 투표할 때"
    } ]
  }, {
    "tStartMs": 1240540,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "신분증이나 시민권을 안 내고 했습니까?"
    } ]
  }, {
    "tStartMs": 1243610,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "실제 법안 내용이 그거예요"
    } ]
  }, {
    "tStartMs": 1244910,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "모든 유권자는 투표하려면"
    } ]
  }, {
    "tStartMs": 1246190,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "시민권 증명을 제시해야 된다"
    } ]
  }, {
    "tStartMs": 1247890,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "질병, 장애, 군복무, 여행"
    } ]
  }, {
    "tStartMs": 1249560,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "이런 특별한 경우를 제외하고는"
    } ]
  }, {
    "tStartMs": 1250640,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "우편 투표도 허용되지 않는다"
    } ]
  }, {
    "tStartMs": 1251890,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "직접 나와서 증명을 제시하고"
    } ]
  }, {
    "tStartMs": 1253830,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "그리고 투표를 해라"
    } ]
  }, {
    "tStartMs": 1255630,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "그러면 드는 궁금증"
    } ]
  }, {
    "tStartMs": 1257510,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "기존에는 안 했습니까?"
    } ]
  }, {
    "tStartMs": 1258630,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "기존에 신분증 검사를 안 했어요?"
    } ]
  }, {
    "tStartMs": 1260540,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "그리고 아무나 투표하는 거야?"
    } ]
  }, {
    "tStartMs": 1261800,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "놀러 갔다가 슈카가"
    } ]
  }, {
    "tStartMs": 1262880,
    "dDurationMs": 570,
    "segs": [ {
      "utf8": "뭐 하는 데예요?"
    } ]
  }, {
    "tStartMs": 1263450,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "들어왔더니"
    } ]
  }, {
    "tStartMs": 1264260,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "도장 찍고 있길래"
    } ]
  }, {
    "tStartMs": 1265650,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "저도 한 표 하겠습니다"
    } ]
  }, {
    "tStartMs": 1266870,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "하고 들어가서 찍어도 되냐?"
    } ]
  }, {
    "tStartMs": 1269450,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "그 정도로 미국이 없진 않고요"
    } ]
  }, {
    "tStartMs": 1271820,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "이게 주마다 다르다고 합니다"
    } ]
  }, {
    "tStartMs": 1273350,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "트럼프 대통령이 얘기하는"
    } ]
  }, {
    "tStartMs": 1275500,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "미국 구하기 법안은"
    } ]
  }, {
    "tStartMs": 1276990,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "엄격한 법적 신분증을 얘기하는 겁니다"
    } ]
  }, {
    "tStartMs": 1280130,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "조금 이따 제가 보여드릴게요"
    } ]
  }, {
    "tStartMs": 1281600,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "이걸 리얼 아이디라고 그래"
    } ]
  }, {
    "tStartMs": 1282860,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "리얼 아이디"
    } ]
  }, {
    "tStartMs": 1283570,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "리얼 아이디급에 속하는"
    } ]
  }, {
    "tStartMs": 1285440,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "엄격한 법적 신분증"
    } ]
  }, {
    "tStartMs": 1287810,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "그러니까 여권이라든지 그런 겁니다"
    } ]
  }, {
    "tStartMs": 1290650,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "모든 주가 이걸 다 요구해야 된다"
    } ]
  }, {
    "tStartMs": 1292750,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "그런데 기존에는 주마다 엄격한"
    } ]
  }, {
    "tStartMs": 1294700,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "법정 신분증 외에"
    } ]
  }, {
    "tStartMs": 1296310,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "은행 계좌나"
    } ]
  }, {
    "tStartMs": 1297440,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "사회보장 넘버"
    } ]
  }, {
    "tStartMs": 1298760,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "아니면 이름 주소"
    } ]
  }, {
    "tStartMs": 1299740,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "이런 것만 있어도 되는 주가 있었고"
    } ]
  }, {
    "tStartMs": 1301800,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "또 아니면 신분증이 없는 경우에"
    } ]
  }, {
    "tStartMs": 1303920,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "자신의 서명을 하고"
    } ]
  }, {
    "tStartMs": 1305570,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "나는 미국 시민권자입니다"
    } ]
  }, {
    "tStartMs": 1308090,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "만약에 내가 시민권자가 아니면"
    } ]
  }, {
    "tStartMs": 1309530,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "불이익을 감수하겠습니다"
    } ]
  }, {
    "tStartMs": 1310990,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "라는 서약서를 쓰고"
    } ]
  }, {
    "tStartMs": 1312110,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "투표하는 주도 있다고 합니다"
    } ]
  }, {
    "tStartMs": 1313760,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "있으면 그걸 확인하고 들어가면 되고"
    } ]
  }, {
    "tStartMs": 1315360,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "아니면 일부 주는"
    } ]
  }, {
    "tStartMs": 1316400,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "우편 등록을 하면"
    } ]
  }, {
    "tStartMs": 1317730,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "원거리로 등록을 하면"
    } ]
  }, {
    "tStartMs": 1319040,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "그냥 선거 당일 날에는"
    } ]
  }, {
    "tStartMs": 1320490,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "신분증을 제시하지 않고"
    } ]
  }, {
    "tStartMs": 1321760,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "이게 저예요"
    } ]
  }, {
    "tStartMs": 1322660,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "이게 하고 들어가고"
    } ]
  }, {
    "tStartMs": 1324190,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "투표가 가능하다고 합니다"
    } ]
  }, {
    "tStartMs": 1325770,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "사전 등록을 하면"
    } ]
  }, {
    "tStartMs": 1327300,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "이런 주마다 이걸 다르니까"
    } ]
  }, {
    "tStartMs": 1328850,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "이걸 모두 다 통합해서"
    } ]
  }, {
    "tStartMs": 1331020,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "엄격한 법정 신분증 사진이 있는"
    } ]
  }, {
    "tStartMs": 1333020,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "사진이 있는 법정 신분증으로 대조를 한 다음에"
    } ]
  }, {
    "tStartMs": 1335990,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "그 사람이 투표하게 만들자라는 게"
    } ]
  }, {
    "tStartMs": 1338080,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "법안이라고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 1339830,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "그럼 우리가 생각하기엔"
    } ]
  }, {
    "tStartMs": 1340920,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "아니 투표 시 신분증을"
    } ]
  }, {
    "tStartMs": 1342590,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "제시하라는 게 뭐가 문제냐?"
    } ]
  }, {
    "tStartMs": 1344640,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "대한민국은 당연히 그렇게 하는데"
    } ]
  }, {
    "tStartMs": 1346860,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "미국은 좀 다릅니다"
    } ]
  }, {
    "tStartMs": 1348440,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "민주당은 뭐라고 얘기하냐면"
    } ]
  }, {
    "tStartMs": 1349880,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "엄격한 법정 신분증"
    } ]
  }, {
    "tStartMs": 1351270,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "여권 아니면 출생증명서"
    } ]
  }, {
    "tStartMs": 1353010,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "아니면 운전면허증이라도"
    } ]
  }, {
    "tStartMs": 1354430,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "법적으로 약간 리얼 아이디 같은 거"
    } ]
  }, {
    "tStartMs": 1356800,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "이런 거를 요구하는데"
    } ]
  }, {
    "tStartMs": 1358160,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "미국인들은 놀랍게도"
    } ]
  }, {
    "tStartMs": 1359490,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "이런 서류를 가지지 않고"
    } ]
  }, {
    "tStartMs": 1360830,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "있는 사람들이 많다고 합니다"
    } ]
  }, {
    "tStartMs": 1363370,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "한국인이면 이해할 수 없는데"
    } ]
  }, {
    "tStartMs": 1364820,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "약 9%의 미국인들이"
    } ]
  }, {
    "tStartMs": 1366160,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "시민권을 쉽게 증명하는 서류가"
    } ]
  }, {
    "tStartMs": 1368260,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "없거나"
    } ]
  }, {
    "tStartMs": 1369530,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "아니면 만들기가 어렵거나"
    } ]
  }, {
    "tStartMs": 1371320,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "아니면 만들기를 귀찮아한다"
    } ]
  }, {
    "tStartMs": 1373570,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "우리가 이거랑 똑같은 거죠"
    } ]
  }, {
    "tStartMs": 1374620,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "아 내가 투표 하나 하는데"
    } ]
  }, {
    "tStartMs": 1376500,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "지금 주민등록증 발급받아야겠냐?"
    } ]
  }, {
    "tStartMs": 1378370,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "구청까지 가서 그거 발급받고"
    } ]
  }, {
    "tStartMs": 1380740,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "뭐 게다가 미국은 오래 걸릴 거 아니에요"
    } ]
  }, {
    "tStartMs": 1382440,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "난 그런 거 없이 살았는데"
    } ]
  }, {
    "tStartMs": 1384600,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "평생 없이 살았어요"
    } ]
  }, {
    "tStartMs": 1385950,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "미국에서"
    } ]
  }, {
    "tStartMs": 1386970,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "근데 뭐 하니까 저걸 만들래"
    } ]
  }, {
    "tStartMs": 1388830,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "이미 거기서부터 허들이야"
    } ]
  }, {
    "tStartMs": 1390070,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "근데 만드는 게 어려워"
    } ]
  }, {
    "tStartMs": 1392040,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "가야 되고"
    } ]
  }, {
    "tStartMs": 1393100,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "게다가 미국 구청은"
    } ]
  }, {
    "tStartMs": 1394250,
    "dDurationMs": 440,
    "segs": [ {
      "utf8": "여기서부터"
    } ]
  }, {
    "tStartMs": 1394690,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "250km 떨어질 수도 있습니다"
    } ]
  }, {
    "tStartMs": 1396620,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "250km"
    } ]
  }, {
    "tStartMs": 1397700,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "가서 한 3시간 기다렸는데"
    } ]
  }, {
    "tStartMs": 1399140,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "다시 갖고 오세요"
    } ]
  }, {
    "tStartMs": 1399990,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "그러면 다시 집에 갔다가"
    } ]
  }, {
    "tStartMs": 1401160,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "다시 올 수도 있어요"
    } ]
  }, {
    "tStartMs": 1402620,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "그러니까 이게 그렇게 만만하지 않을 수도 있죠"
    } ]
  }, {
    "tStartMs": 1405440,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "그래서 이렇게 주장하는 겁니다"
    } ]
  }, {
    "tStartMs": 1407640,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "많은 미국인들이 서류를 쉽게 구하지 못하거나"
    } ]
  }, {
    "tStartMs": 1409980,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "번거롭다 보니까"
    } ]
  }, {
    "tStartMs": 1410700,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "투표에 나서지 않을 것이다"
    } ]
  }, {
    "tStartMs": 1412430,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "거의 2,100만 명에 이르는 유권자들이"
    } ]
  }, {
    "tStartMs": 1414830,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "저 시민권 증명서류를"
    } ]
  }, {
    "tStartMs": 1416140,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "생각보다 쉽게 구할 수 없어"
    } ]
  }, {
    "tStartMs": 1417300,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "또는 구하기 진짜 어렵거나"
    } ]
  }, {
    "tStartMs": 1419350,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "내가 어디 태어났다는"
    } ]
  }, {
    "tStartMs": 1420250,
    "dDurationMs": 450,
    "segs": [ {
      "utf8": "이런 거"
    } ]
  }, {
    "tStartMs": 1420700,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "떼어오고 그래야 될 수도 있어요"
    } ]
  }, {
    "tStartMs": 1422040,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "우리 아버지가 떼어오고 그래야 될 수도 있고"
    } ]
  }, {
    "tStartMs": 1423800,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "아니면 어렵거나"
    } ]
  }, {
    "tStartMs": 1424990,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "투표 안 하면 어떻게 되는 거냐"
    } ]
  }, {
    "tStartMs": 1426110,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "그대로 2,100만 표가 날라가는 거잖아"
    } ]
  }, {
    "tStartMs": 1428130,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "민주당 입장에서는"
    } ]
  }, {
    "tStartMs": 1429460,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "물론 공화당 입장에서는"
    } ]
  }, {
    "tStartMs": 1430810,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "아니..."
    } ]
  }, {
    "tStartMs": 1431520,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "시민권자가 아닌 사람이 투표하면 어떡해?"
    } ]
  }, {
    "tStartMs": 1433570,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "가짜 유권자들의 투표를 막아야지"
    } ]
  }, {
    "tStartMs": 1435420,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "그동안 그런 가짜 유권자들이 투표를 해서"
    } ]
  }, {
    "tStartMs": 1437740,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "바이든이 이긴 거 아니야"
    } ]
  }, {
    "tStartMs": 1438790,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "원래 트럼프가 이겼는데"
    } ]
  }, {
    "tStartMs": 1440030,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "그런 가짜 그건 뭐야"
    } ]
  }, {
    "tStartMs": 1441630,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "사기투표"
    } ]
  }, {
    "tStartMs": 1442560,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "그런 것에서 이겼으니까"
    } ]
  }, {
    "tStartMs": 1443300,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "이런 걸 막아야 된다"
    } ]
  }, {
    "tStartMs": 1444390,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "불법적인 유권자 등록"
    } ]
  }, {
    "tStartMs": 1445580,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "이런 걸 막고"
    } ]
  }, {
    "tStartMs": 1446450,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "오히려 이 기회에"
    } ]
  }, {
    "tStartMs": 1447570,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "싹 조사를 해서"
    } ]
  }, {
    "tStartMs": 1448920,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "불법적으로 등록한 놈들"
    } ]
  }, {
    "tStartMs": 1450380,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "우편등록 이런 걸로 사기친 놈들"
    } ]
  }, {
    "tStartMs": 1452210,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "싹 조사해서"
    } ]
  }, {
    "tStartMs": 1453170,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "추방해버리자"
    } ]
  }, {
    "tStartMs": 1454840,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "비시민권자한테 투표한 놈 있으면"
    } ]
  }, {
    "tStartMs": 1456730,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "바로 보내야죠"
    } ]
  }, {
    "tStartMs": 1457970,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "라고 얘기하는 게"
    } ]
  }, {
    "tStartMs": 1459390,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "공화당이라고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 1461630,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "물론 이제 한국인들은"
    } ]
  }, {
    "tStartMs": 1463660,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "아니 주민등록 제시하면 되는 거 아니냐"
    } ]
  }, {
    "tStartMs": 1466530,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "라고 생각하지만"
    } ]
  }, {
    "tStartMs": 1467810,
    "dDurationMs": 550,
    "segs": [ {
      "utf8": "당연하겠지만"
    } ]
  }, {
    "tStartMs": 1468360,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "미국은 주민등록 같은 국가통합신분증이 없습니다"
    } ]
  }, {
    "tStartMs": 1471410,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "대부분의 우리가 아는 유럽식"
    } ]
  }, {
    "tStartMs": 1473620,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "서양 국가들은 국가통합신분증이 없죠"
    } ]
  }, {
    "tStartMs": 1475840,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "빅부라더라고 생각하잖아요"
    } ]
  }, {
    "tStartMs": 1477610,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "대부분 주의 운전면허증이나"
    } ]
  }, {
    "tStartMs": 1478910,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "사회보장번호 이런 걸로 가름하는데"
    } ]
  }, {
    "tStartMs": 1481000,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "이런 거는 허점이 있죠"
    } ]
  }, {
    "tStartMs": 1482350,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "시민권자가 아니어도 받을 수 있는"
    } ]
  }, {
    "tStartMs": 1484480,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "길 같은 게 있을 수 있다고 합니다"
    } ]
  }, {
    "tStartMs": 1485950,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "일반적인 이런 운전면허증이나"
    } ]
  }, {
    "tStartMs": 1487670,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "사회보장법으로는 안 된다"
    } ]
  }, {
    "tStartMs": 1489520,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "그래서 사실 트럼프 행정부가"
    } ]
  }, {
    "tStartMs": 1491390,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "작년에 만든"
    } ]
  }, {
    "tStartMs": 1492370,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "또 하나의 신분증이 있는데"
    } ]
  }, {
    "tStartMs": 1493330,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "그게 바로 리얼아이디입니다"
    } ]
  }, {
    "tStartMs": 1494620,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "2025년 5월부터"
    } ]
  }, {
    "tStartMs": 1496000,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "연방 규정을 준수하는 신분증"
    } ]
  }, {
    "tStartMs": 1498530,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "너가 누군지를"
    } ]
  }, {
    "tStartMs": 1500040,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "국가 규정 신분증"
    } ]
  }, {
    "tStartMs": 1501940,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "이건 사실은 2001년에"
    } ]
  }, {
    "tStartMs": 1503380,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "9.11 테러 이후에 법은 통과됐었는데"
    } ]
  }, {
    "tStartMs": 1505420,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "실행이 미뤄져 왔었는데"
    } ]
  }, {
    "tStartMs": 1507200,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "트럼프 행정부가 이걸 전격 실행했어요"
    } ]
  }, {
    "tStartMs": 1508770,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "리얼아이디를 제출해라"
    } ]
  }, {
    "tStartMs": 1511300,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "저도 리얼아이디가 뭔지"
    } ]
  }, {
    "tStartMs": 1513000,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "이번에 봤는데"
    } ]
  }, {
    "tStartMs": 1514050,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "이렇게 같은 운전면허증이라도"
    } ]
  }, {
    "tStartMs": 1516210,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "미국 국기나"
    } ]
  }, {
    "tStartMs": 1517060,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "이런 별같은 이런 확인표를 붙여준다고 합니다"
    } ]
  }, {
    "tStartMs": 1520100,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "자기가 미국 시민권자라는 걸"
    } ]
  }, {
    "tStartMs": 1521490,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "가서 인정을 해야겠죠"
    } ]
  }, {
    "tStartMs": 1522620,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "증명할 수 있는 서류, 여권, 출생"
    } ]
  }, {
    "tStartMs": 1524520,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "이런 거 들고 가서 하면"
    } ]
  }, {
    "tStartMs": 1526010,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "이런 리얼아이디를 발급해주고"
    } ]
  }, {
    "tStartMs": 1528090,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "이제 각 주에서 발급한"
    } ]
  }, {
    "tStartMs": 1529350,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "면허증, 신분증 이런 건 안 돼"
    } ]
  }, {
    "tStartMs": 1531210,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "그런 거 공식적인 목적에서 안 돼"
    } ]
  }, {
    "tStartMs": 1532850,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "지금도 해외여행 가려면"
    } ]
  }, {
    "tStartMs": 1533710,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "이런 걸로 안 되죠"
    } ]
  }, {
    "tStartMs": 1534580,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "여권이 있어야 되듯이"
    } ]
  }, {
    "tStartMs": 1536100,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "리얼아이디를 가져와라"
    } ]
  }, {
    "tStartMs": 1537730,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "라고 요구한다고 보시면 됩니다"
    } ]
  }, {
    "tStartMs": 1539950,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "미국 구하기 법안을"
    } ]
  }, {
    "tStartMs": 1540870,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "참고로 하원은 통과했는데"
    } ]
  }, {
    "tStartMs": 1542440,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "상원은 통과가 안되고 있어요"
    } ]
  }, {
    "tStartMs": 1544150,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "지금 트럼프 대통령은"
    } ]
  }, {
    "tStartMs": 1545010,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "이 법안이 통과되지 않으면"
    } ]
  }, {
    "tStartMs": 1546540,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "다른 법안에 서명하지 않을 것이다"
    } ]
  }, {
    "tStartMs": 1547890,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "라고 강력하게 밀어붙이고 있는데"
    } ]
  }, {
    "tStartMs": 1549580,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "상원에서는 통과가 안될 것 같아요"
    } ]
  }, {
    "tStartMs": 1551950,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "현재까지는 왜냐하면"
    } ]
  }, {
    "tStartMs": 1553760,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "미국 상원도 공화당이 다수당입니다"
    } ]
  }, {
    "tStartMs": 1555840,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "그래서 원래는 53석이기 때문에"
    } ]
  }, {
    "tStartMs": 1557240,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "통과가 되어야 되는데"
    } ]
  }, {
    "tStartMs": 1558320,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "옛날에 한번 했어요 이 내용은"
    } ]
  }, {
    "tStartMs": 1559780,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "필리버스터를 막기 위해서는"
    } ]
  }, {
    "tStartMs": 1561070,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "60석이 필요합니다"
    } ]
  }, {
    "tStartMs": 1562190,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "민주당이 무기한 필리버스터를 하면은"
    } ]
  }, {
    "tStartMs": 1564660,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "상원이 이걸 통과를 못할 수도 있어요"
    } ]
  }, {
    "tStartMs": 1566460,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "못하면은"
    } ]
  }, {
    "tStartMs": 1567780,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "저 미국 구하기 법안이라는 건"
    } ]
  }, {
    "tStartMs": 1569110,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "통과가 안 될 수도 있습니다"
    } ]
  }, {
    "tStartMs": 1570990,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "통과가 되면"
    } ]
  }, {
    "tStartMs": 1571930,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "실제로 저 아이디를 가지고"
    } ]
  }, {
    "tStartMs": 1573470,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "리얼 아이디가 있거나"
    } ]
  }, {
    "tStartMs": 1574310,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "국가 공인 신분증을"
    } ]
  }, {
    "tStartMs": 1575380,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "여권 같은 거를 가지고"
    } ]
  }, {
    "tStartMs": 1576290,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "증명할 수 있는 사람들만"
    } ]
  }, {
    "tStartMs": 1577460,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "투표를 하게 되겠죠"
    } ]
  }, {
    "tStartMs": 1579460,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "그런데 다 끝났는데"
    } ]
  }, {
    "tStartMs": 1580420,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "재밌는 거 하나 보여드리면"
    } ]
  }, {
    "tStartMs": 1581220,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "트럼프 대통령이 이런 얘기도 했습니다"
    } ]
  }, {
    "tStartMs": 1583210,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "미국은 인도나 브라질을 본받아야 된다"
    } ]
  }, {
    "tStartMs": 1586360,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "갑자기 인도나 브라질이 왜요?"
    } ]
  }, {
    "tStartMs": 1587710,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "인도는 오른쪽은 트럼프 대통령이 얘기한 겁니다"
    } ]
  }, {
    "tStartMs": 1589780,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "인도는 유권자 신분증을"
    } ]
  }, {
    "tStartMs": 1591980,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "생체인식 데이터베이스와"
    } ]
  }, {
    "tStartMs": 1593760,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "아예 연동을 했어"
    } ]
  }, {
    "tStartMs": 1595550,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "그래서 부정선거가 아예 불가능해요"
    } ]
  }, {
    "tStartMs": 1597750,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "그런데 미국은 시민권 있는지 없는지를"
    } ]
  }, {
    "tStartMs": 1599780,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "주로 자가 증명에 의존해"
    } ]
  }, {
    "tStartMs": 1601820,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "나 있어요"
    } ]
  }, {
    "tStartMs": 1602680,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "이러면 해준다는 거죠"
    } ]
  }, {
    "tStartMs": 1604340,
    "dDurationMs": 670,
    "segs": [ {
      "utf8": "아니면 나 있어요"
    } ]
  }, {
    "tStartMs": 1605010,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "또 얘가 서류를 가져오고"
    } ]
  }, {
    "tStartMs": 1606260,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "이런 증명에 의존해"
    } ]
  }, {
    "tStartMs": 1607130,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "그러면 안 돼"
    } ]
  }, {
    "tStartMs": 1607970,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "인도처럼 생체인식 데이터베이스"
    } ]
  }, {
    "tStartMs": 1610470,
    "dDurationMs": 650,
    "segs": [ {
      "utf8": "너무 좋지 않냐"
    } ]
  }, {
    "tStartMs": 1611120,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "이게 무슨 말이냐면"
    } ]
  }, {
    "tStartMs": 1612600,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "놀랍게도"
    } ]
  }, {
    "tStartMs": 1613570,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "인도는 13억 인구의"
    } ]
  }, {
    "tStartMs": 1615600,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "데이터베이스를 구축하는 나라입니다"
    } ]
  }, {
    "tStartMs": 1618620,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "전례 없는 규모의 신원 확인 시스템을"
    } ]
  }, {
    "tStartMs": 1620720,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "구축하는 나라가 놀랍게도 인도예요"
    } ]
  }, {
    "tStartMs": 1623140,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "국민들의 지문"
    } ]
  }, {
    "tStartMs": 1624260,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "홍채, 얼굴 스캔"
    } ]
  }, {
    "tStartMs": 1625650,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "이런 걸 합니다"
    } ]
  }, {
    "tStartMs": 1627290,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "그래서 복지 혜택"
    } ]
  }, {
    "tStartMs": 1628920,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "아니면 아까 투표"
    } ]
  }, {
    "tStartMs": 1630210,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "이런 거 권리"
    } ]
  }, {
    "tStartMs": 1631140,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "휴대전화 사용 내역"
    } ]
  }, {
    "tStartMs": 1632130,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "이런 걸 모두 다"
    } ]
  }, {
    "tStartMs": 1632920,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "이런 시스템을 통해서 돌아가요"
    } ]
  }, {
    "tStartMs": 1634820,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "예를 들면 이런 거"
    } ]
  }, {
    "tStartMs": 1636640,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "13억 모든 인구의"
    } ]
  }, {
    "tStartMs": 1637930,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "지문, 눈, 얼굴 스캔을 해도 되냐?"
    } ]
  }, {
    "tStartMs": 1640880,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "물론 한국인이라면"
    } ]
  }, {
    "tStartMs": 1642150,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "그걸 안 하냐?"
    } ]
  }, {
    "tStartMs": 1643040,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "라고 묻겠지만"
    } ]
  }, {
    "tStartMs": 1644180,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "우리는 주민등록할 때"
    } ]
  }, {
    "tStartMs": 1645440,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "다 이렇게 하기 때문에"
    } ]
  }, {
    "tStartMs": 1646310,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "그거 당연히 하는 거 아니에요?"
    } ]
  }, {
    "tStartMs": 1647360,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "라고 생각하지만"
    } ]
  }, {
    "tStartMs": 1648510,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "쟤는 그렇게 안 생각하니까"
    } ]
  }, {
    "tStartMs": 1649980,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "인도는 그걸 도입해서"
    } ]
  }, {
    "tStartMs": 1651180,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "이게 빅브라더 아니냐"
    } ]
  }, {
    "tStartMs": 1652430,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "라고 이제 비난을 받는다는 거죠"
    } ]
  }, {
    "tStartMs": 1654650,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "그리고 홍채, 눈"
    } ]
  }, {
    "tStartMs": 1655950,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "뭐 그것 때문에"
    } ]
  }, {
    "tStartMs": 1656700,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "복지혜택 이거를 뭐 주민등록"
    } ]
  }, {
    "tStartMs": 1658730,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "뭐 지문 이런 걸로 하면은"
    } ]
  }, {
    "tStartMs": 1660350,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "혹시 개인정보 그런 거 아니냐"
    } ]
  }, {
    "tStartMs": 1662130,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "인도 사람들은 걱정하지 않는다 그래요"
    } ]
  }, {
    "tStartMs": 1664100,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "있는 사람들은 있는 사람들을"
    } ]
  }, {
    "tStartMs": 1666470,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "걱정 안 하고"
    } ]
  }, {
    "tStartMs": 1667260,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "없는 사람들은"
    } ]
  }, {
    "tStartMs": 1668060,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "잃을 게 없기 때문에"
    } ]
  }, {
    "tStartMs": 1668810,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "걱정하지 않는다"
    } ]
  }, {
    "tStartMs": 1669800,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "라고 해서 별로 인도에서는"
    } ]
  }, {
    "tStartMs": 1670710,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "화제가 안 되는데"
    } ]
  }, {
    "tStartMs": 1671730,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "트럼프 대통령은 이제 이걸 부러워하는 거죠"
    } ]
  }, {
    "tStartMs": 1674640,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "자꾸 얘기하지만"
    } ]
  }, {
    "tStartMs": 1675260,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "한국인들은"
    } ]
  }, {
    "tStartMs": 1677010,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "원래 하는 거 아니냐"
    } ]
  }, {
    "tStartMs": 1678270,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "그쵸"
    } ]
  }, {
    "tStartMs": 1679240,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "우리나라도 공항 통과할 때"
    } ]
  }, {
    "tStartMs": 1680490,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "요즘 얼굴로 통과하잖아요 얼굴"
    } ]
  }, {
    "tStartMs": 1682100,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "이러면 바로 통과하잖아"
    } ]
  }, {
    "tStartMs": 1683240,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "얼굴 뭐 있는데"
    } ]
  }, {
    "tStartMs": 1684020,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "빨리 왔다 갔다 하는 거"
    } ]
  }, {
    "tStartMs": 1685200,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "빠른 수속"
    } ]
  }, {
    "tStartMs": 1686070,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "얼굴로 하거나"
    } ]
  }, {
    "tStartMs": 1687070,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "지문 이거에 별로"
    } ]
  }, {
    "tStartMs": 1688830,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "느낌이 없는데"
    } ]
  }, {
    "tStartMs": 1689950,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "서구에는 그러니까"
    } ]
  }, {
    "tStartMs": 1690990,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "우리나라도 2024년에"
    } ]
  }, {
    "tStartMs": 1692340,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "주민등록증의 지문을 모으는 것"
    } ]
  }, {
    "tStartMs": 1694440,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "이거 위원 심판 올라갔었습니다"
    } ]
  }, {
    "tStartMs": 1696700,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "헌법재판소는 합헌 판결 내렸어요"
    } ]
  }, {
    "tStartMs": 1699420,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "지문은 수집해도 괜찮다"
    } ]
  }, {
    "tStartMs": 1700830,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "합헌 판결에서 2024년입니다"
    } ]
  }, {
    "tStartMs": 1702660,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "아직 유지되고 있는데"
    } ]
  }, {
    "tStartMs": 1703990,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "참고로 인도는"
    } ]
  }, {
    "tStartMs": 1705020,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "요즘에 유권자 명부를 업데이트한다고 합니다"
    } ]
  }, {
    "tStartMs": 1708130,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "13억 명부를 업데이트해야 돼요"
    } ]
  }, {
    "tStartMs": 1710920,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "그럼 어떻게 하냐?"
    } ]
  }, {
    "tStartMs": 1711990,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "저 엄청난 디지털 정보를"
    } ]
  }, {
    "tStartMs": 1713990,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "아날로그로 업데이트합니다"
    } ]
  }, {
    "tStartMs": 1716090,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "그것도 옛날에 슈카월드 영상에 있어요"
    } ]
  }, {
    "tStartMs": 1717340,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "어떻게 아날로그로 업데이트를 하냐?"
    } ]
  }, {
    "tStartMs": 1719290,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "한 명 한 명 찾아가요"
    } ]
  }, {
    "tStartMs": 1720450,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "진짜입니다"
    } ]
  }, {
    "tStartMs": 1721660,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "13억을 한 명 한 명 찾아가고"
    } ]
  }, {
    "tStartMs": 1724060,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "옛날에 손톱에다가 줄 긋고 하는 거 있죠"
    } ]
  }, {
    "tStartMs": 1726170,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "누가 했는지 안 했는지"
    } ]
  }, {
    "tStartMs": 1727290,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "그런 아날로그 방식으로"
    } ]
  }, {
    "tStartMs": 1728810,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "디지털을 업데이트하는 나라가 인도인데요"
    } ]
  }, {
    "tStartMs": 1731890,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "이번에 이번 조사에는"
    } ]
  }, {
    "tStartMs": 1733370,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "무려 5억명을 관리해야 된다고 그럽니다"
    } ]
  }, {
    "tStartMs": 1736250,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "절반씩 하나 봐"
    } ]
  }, {
    "tStartMs": 1737310,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "10억 명에 달하는"
    } ]
  }, {
    "tStartMs": 1738350,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "투표권자를 검사해야 되는데"
    } ]
  }, {
    "tStartMs": 1739760,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "5억 명을 검사하는데"
    } ]
  }, {
    "tStartMs": 1741300,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "이 검사 인원이"
    } ]
  }, {
    "tStartMs": 1742850,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "50만 명입니다"
    } ]
  }, {
    "tStartMs": 1744710,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "50만 명이 자신이 해야되는"
    } ]
  }, {
    "tStartMs": 1747530,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "뭐 몇백 명 몇천 명이 되겠죠"
    } ]
  }, {
    "tStartMs": 1749070,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "이거를 데이터베이스에 수기로 입력합니다"
    } ]
  }, {
    "tStartMs": 1751230,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "한 명 한 명 찾아가서"
    } ]
  }, {
    "tStartMs": 1752210,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "야 일로와 일로와 일로와"
    } ]
  }, {
    "tStartMs": 1753100,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "일로와 일로와"
    } ]
  }, {
    "tStartMs": 1753910,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "눈 대 눈!"
    } ]
  }, {
    "tStartMs": 1754510,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "눈 대고요"
    } ]
  }, {
    "tStartMs": 1756060,
    "dDurationMs": 420,
    "segs": [ {
      "utf8": "갈게요"
    } ]
  }, {
    "tStartMs": 1756480,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "아이 아이 아이"
    } ]
  }, {
    "tStartMs": 1757310,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "손도 대, 손"
    } ]
  }, {
    "tStartMs": 1758530,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "오케이 너 했어"
    } ]
  }, {
    "tStartMs": 1759520,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "여기다 이렇게 줄 하나 그어주고"
    } ]
  }, {
    "tStartMs": 1761350,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "약간 이런 걸 한다는 거죠"
    } ]
  }, {
    "tStartMs": 1763530,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "5억 명을"
    } ]
  }, {
    "tStartMs": 1765390,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "자 그래서 인도는"
    } ]
  }, {
    "tStartMs": 1766810,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "놀랍게도"
    } ]
  }, {
    "tStartMs": 1767550,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "모두 전자 투표를 한다고 합니다"
    } ]
  }, {
    "tStartMs": 1770020,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "딱 대면 얘가 누군지 나와"
    } ]
  }, {
    "tStartMs": 1771610,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "그리고 번호 찍으면 돼"
    } ]
  }, {
    "tStartMs": 1772940,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "오 야 여기 있잖아"
    } ]
  }, {
    "tStartMs": 1774420,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "1번부터 10번까지"
    } ]
  }, {
    "tStartMs": 1775220,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "너 대 누르면 얘야"
    } ]
  }, {
    "tStartMs": 1777140,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "표 준거야 자기가"
    } ]
  }, {
    "tStartMs": 1777860,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "개인적으로는"
    } ]
  }, {
    "tStartMs": 1779520,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "야 이거는"
    } ]
  }, {
    "tStartMs": 1781230,
    "dDurationMs": 490,
    "segs": [ {
      "utf8": "비밀 유지에"
    } ]
  }, {
    "tStartMs": 1781720,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "조금 자기가 너무"
    } ]
  }, {
    "tStartMs": 1783490,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "야 이거"
    } ]
  }, {
    "tStartMs": 1784100,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "너무 누가 누구 찍었는지"
    } ]
  }, {
    "tStartMs": 1785790,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "물론 이게 또 비밀 처리되고"
    } ]
  }, {
    "tStartMs": 1787270,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "못 보게 하고 하겠지만"
    } ]
  }, {
    "tStartMs": 1788870,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "이게 이러면"
    } ]
  }, {
    "tStartMs": 1789720,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "누가 뭐 찍었는지가"
    } ]
  }, {
    "tStartMs": 1791090,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "이거 해킹당하면"
    } ]
  }, {
    "tStartMs": 1792010,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "아주 그냥"
    } ]
  }, {
    "tStartMs": 1793270,
    "dDurationMs": 390,
    "segs": [ {
      "utf8": "그쵸?"
    } ]
  }, {
    "tStartMs": 1793660,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "난리 날 것 같은데?"
    } ]
  }, {
    "tStartMs": 1794680,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "너 그쪽이니?"
    } ]
  }, {
    "tStartMs": 1796190,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "뭐 이런 얘기를 들을 수 있으니까"
    } ]
  }, {
    "tStartMs": 1798040,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "하여튼 이렇게 한다고 합니다"
    } ]
  }, {
    "tStartMs": 1798920,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "그래서 인도는 투표가 엄청나게 빠르다 그래요"
    } ]
  }, {
    "tStartMs": 1802140,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "개표가 개표가"
    } ]
  }, {
    "tStartMs": 1803190,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "머스크는 이렇게 얘기합니다"
    } ]
  }, {
    "tStartMs": 1804640,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "인도의 개표는 정말 놀랍다"
    } ]
  }, {
    "tStartMs": 1806850,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "하루 만에 6억 4천만 표가 모두 집계된다"
    } ]
  }, {
    "tStartMs": 1809570,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "근데 캘리포니아는 아직 개표 중이다"
    } ]
  }, {
    "tStartMs": 1811360,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "캘리포니아 민주당"
    } ]
  }, {
    "tStartMs": 1812990,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "민주당 저기는 아직 개표 중인데"
    } ]
  }, {
    "tStartMs": 1814790,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "인도는 하루 만에 하더라"
    } ]
  }, {
    "tStartMs": 1815970,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "그렇기 때문에 역시"
    } ]
  }, {
    "tStartMs": 1817340,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "인도가 부럽다라고 얘기를 하는 게"
    } ]
  }, {
    "tStartMs": 1819740,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "요즘의 미국이라고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 1822580,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "자, 그래서 뭐 개리맨더링"
    } ]
  }, {
    "tStartMs": 1825360,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "부정선거를 막겠다고"
    } ]
  }, {
    "tStartMs": 1826900,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "미국 구하기 법안을 추진하는데"
    } ]
  }, {
    "tStartMs": 1829270,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "개리맨더링은 부정선거냐 아니냐"
    } ]
  }, {
    "tStartMs": 1831160,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "개리맨더링은 되는데"
    } ]
  }, {
    "tStartMs": 1834070,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "부정선거는 안 되는"
    } ]
  }, {
    "tStartMs": 1834970,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "하여튼 아주 복잡하게 얽혀있는 게"
    } ]
  }, {
    "tStartMs": 1837240,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "요즘의 미국이라고 할 수 있습니다"
    } ]
  } ]
}

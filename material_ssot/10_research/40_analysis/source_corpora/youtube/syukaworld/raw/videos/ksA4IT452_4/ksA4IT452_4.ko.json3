  }, {
    "tStartMs": 1395130,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "팔라는 말이니까"
    } ]
  }, {
    "tStartMs": 1396540,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "뭐 97, 98, 99 될 때"
    } ]
  }, {
    "tStartMs": 1398360,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "팔라는 말이니까"
    } ]
  }, {
    "tStartMs": 1399790,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "100만닉스 얘기하는 분들은"

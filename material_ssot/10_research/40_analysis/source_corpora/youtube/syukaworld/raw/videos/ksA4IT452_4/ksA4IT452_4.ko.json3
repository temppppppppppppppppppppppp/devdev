    "tStartMs": 1574240,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "1년이 아니라"
    } ]
  }, {
    "tStartMs": 1575130,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "작년에 1년 영업이익이"
    } ]
  }, {
    "tStartMs": 1576420,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "44조였습니다"
    } ]
  }, {
    "tStartMs": 1577720,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "삼성전자가"
    } ]
  }, {
    "tStartMs": 1578440,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "작년에 1년 번 거를"
    } ]
  }, {
    "tStartMs": 1580090,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "한 분기에 벌어야"
    } ]
  }, {
    "tStartMs": 1582020,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "예상을 충족하는 거예요"
    } ]
  }, {
    "tStartMs": 1584340,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "그거 미만이면 쇼크입니다"
    } ]
  }, {
    "tStartMs": 1586030,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "30몇 조"
    } ]
  }, {
    "tStartMs": 1587500,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "쇼크야"
    } ]
  }, {
    "tStartMs": 1588320,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "영업이익 쇼크"
    } ]
  }, {
    "tStartMs": 1589310,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "한 분기에 30몇 조 벌어서 어떡해"
    } ]
  }, {
    "tStartMs": 1591470,
    "dDurationMs": 630,
    "segs": [ {
      "utf8": "밥이나 먹었어?"
    } ]
  }, {
    "tStartMs": 1592100,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "커피가 넘어가요?"
    } ]
  }, {
    "tStartMs": 1593340,
    "dDurationMs": 650,
    "segs": [ {
      "utf8": "안 되는 거죠?"
    } ]
  }, {
    "tStartMs": 1593990,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "그럼 안 돼요"
    } ]
  }, {
    "tStartMs": 1594980,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "30몇 조가 안 되고"
    } ]
  }, {
    "tStartMs": 1596220,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "4자가 보여야 돼요"
    } ]
  }, {
    "tStartMs": 1597030,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "일단 앞자리가 4자"
    } ]
  }, {
    "tStartMs": 1598390,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "그래서 작년 1년에 번 거를"
    } ]
  }, {
    "tStartMs": 1600000,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "한 분기마다 벌어야"
    } ]
  }, {
    "tStartMs": 1601600,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "이 예상 영업이익이 됩니다"
    } ]
  }, {
    "tStartMs": 1602810,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "그럼 SK하이닉스의 목표 주가는 얼마냐?"
    } ]
  }, {
    "tStartMs": 1606230,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "이미 95만원인데"
    } ]
  }, {
    "tStartMs": 1607710,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "100만원은 안되지 않냐?"
    } ]
  }, {
    "tStartMs": 1609770,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "목표 주가를 보면요"
    } ]
  }, {
    "tStartMs": 1610880,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "교보증권 120만원 좋고요"
    } ]
  }, {
    "tStartMs": 1613140,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "흥국증권 120만원 좋아요"
    } ]
  }, {
    "tStartMs": 1615200,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "KB 140"
    } ]
  }, {
    "tStartMs": 1616630,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "KB 형님들이 아까부터"
    } ]
  }, {
    "tStartMs": 1618800,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "잘 쏘시네, 140 좋습니다"
    } ]
  }, {
    "tStartMs": 1620960,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "140이면 얼마야?"
    } ]
  }, {
    "tStartMs": 1621910,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "45만원 올라야 되네"
    } ]
  }, {
    "tStartMs": 1623150,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "50%"
    } ]
  }, {
    "tStartMs": 1623990,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "지금부터 50%"
    } ]
  }, {
    "tStartMs": 1625280,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "요걸로 하겠습니다"
    } ]
  }, {
    "tStartMs": 1626200,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "지금부터 50%"
    } ]
  }, {
    "tStartMs": 1627680,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "오를 룸이 있지 않나 생각이 되고요"
    } ]
  }, {
    "tStartMs": 1629320,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "키움증권 형님들이 역시 보수적이고"
    } ]
  }, {
    "tStartMs": 1631170,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "냉철하신 분이에요"
    } ]
  }, {
    "tStartMs": 1632090,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "역시 배우신 분들이죠"
    } ]
  }, {
    "tStartMs": 1633510,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "냉철하게 110만 원"
    } ]
  }, {
    "tStartMs": 1634870,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "요것도 한 10% 조금 더 오르는 거"
    } ]
  }, {
    "tStartMs": 1637400,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "평균적으로 123만 원까지"
    } ]
  }, {
    "tStartMs": 1639380,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "이게 매달 레포트가 나올 때마다"
    } ]
  }, {
    "tStartMs": 1640950,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "목표주가 계속 올라가고 있습니다"
    } ]
  }, {
    "tStartMs": 1643250,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "영업이익을 보면"
    } ]
  }, {
    "tStartMs": 1644460,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "평균 145조가 나왔어요"
    } ]
  }, {
    "tStartMs": 1646430,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "2025년 하이닉스가"
    } ]
  }, {
    "tStartMs": 1648160,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "역대 최고로 번 돈이 47조입니다"
    } ]
  }, {
    "tStartMs": 1650810,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "이제 앞으로는 하이닉스 마찬가지로"
    } ]
  }, {
    "tStartMs": 1652610,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "작년 1년에 번 거를"
    } ]
  }, {
    "tStartMs": 1653560,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "거의 한 분기 정도에 벌어야 돼요"
    } ]
  }, {
    "tStartMs": 1655380,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "그게 예상 영업이익입니다"
    } ]
  }, {
    "tStartMs": 1657970,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "그렇기 때문에 반도체 기업들의"
    } ]
  }, {
    "tStartMs": 1659680,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "목표 주가가 이렇게 올라가고 있는 게"
    } ]
  }, {
    "tStartMs": 1661220,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "역시 영업이익 전망치 기준이"
    } ]
  }, {
    "tStartMs": 1662620,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "계속 올라가고 있다고 보시면 되고요"
    } ]
  }, {
    "tStartMs": 1664280,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "그럼에도 싸다라는 말도 있어요"
    } ]
  }, {
    "tStartMs": 1666800,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "삼성전자 SK하이닉스의 PER이"
    } ]
  }, {
    "tStartMs": 1668490,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "8.6배, 5.3배다"
    } ]
  }, {
    "tStartMs": 1670780,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "글로벌 기업들, 엔비디아, TSMC"
    } ]
  }, {
    "tStartMs": 1672640,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "마이크론 테크놀로지보다 싸지 않냐"
    } ]
  }, {
    "tStartMs": 1674650,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "물론 함정은"
    } ]
  }, {
    "tStartMs": 1675970,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "우리는 언제나 여기 아래에 있는 기업보다는"
    } ]
  }, {
    "tStartMs": 1678820,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "PER이 낮았습니다"
    } ]
  }, {
    "tStartMs": 1680110,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "지금 많이 따라간 거예요"
    } ]
  }, {
    "tStartMs": 1681790,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "이거 많이 따라한 거야"
    } ]
  }, {
    "tStartMs": 1682650,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "옛날에 엔비디아 막 40배 그럴 때"
    } ]
  }, {
    "tStartMs": 1684500,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "우리는 5배, 4배 그랬어요"
    } ]
  }, {
    "tStartMs": 1686160,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "많이 따라갔지만"
    } ]
  }, {
    "tStartMs": 1687530,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "하여튼 PER 기준으로는"
    } ]
  }, {
    "tStartMs": 1689540,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "아직도 낮다라는 얘기가 있고"
    } ]
  }, {
    "tStartMs": 1691030,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "그리고 얼마 전에"
    } ]
  }, {
    "tStartMs": 1691800,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "SK그룹 최태원 회장님이"
    } ]
  }, {
    "tStartMs": 1693320,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "직접 SK하이닉스의 영업이익"
    } ]
  }, {
    "tStartMs": 1694910,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "추정을 얘기한 적이 있어요"
    } ]
  }, {
    "tStartMs": 1696210,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "얼마 전에, 엊그제, 엊그제"
    } ]
  }, {
    "tStartMs": 1697370,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "뭐라고 얘기했냐?"
    } ]
  }, {
    "tStartMs": 1698130,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "지금 새로운 예상치는"
    } ]
  }, {
    "tStartMs": 1699140,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "아마 증권가 예상치를"
    } ]
  }, {
    "tStartMs": 1700100,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "그대로 갖고 오신 것 같은데"
    } ]
  }, {
    "tStartMs": 1701350,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "1,000억 달러를 넘을 수도 있다고 한다"
    } ]
  }, {
    "tStartMs": 1702940,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "145조"
    } ]
  }, {
    "tStartMs": 1704420,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "오, 그럼 회장님 얘기하시니까"
    } ]
  }, {
    "tStartMs": 1705820,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "넘는 겁니까?"
    } ]
  }, {
    "tStartMs": 1706500,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "아, 1,000억 달러 손실이 될 수도 있다"
    } ]
  }, {
    "tStartMs": 1709920,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "어, 이거 무슨 말씀인가 하면"
    } ]
  }, {
    "tStartMs": 1711940,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "내가 보아하니 12월 시장에서는"
    } ]
  }, {
    "tStartMs": 1714080,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "SK하이닉스의 올해 영업이익이"
    } ]
  }, {
    "tStartMs": 1715720,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "500억 달러로 가더군요"
    } ]
  }, {
    "tStartMs": 1717420,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "근데 1월이 지나니까"
    } ]
  }, {
    "tStartMs": 1718790,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "700억 달러라고 해요"
    } ]
  }, {
    "tStartMs": 1720410,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "근데 2월이 되니까"
    } ]
  }, {
    "tStartMs": 1721550,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "1000억 달러라고 합시다"
    } ]
  }, {
    "tStartMs": 1722640,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "야, 이거 뭐야 계속 올라가잖아"
    } ]
  }, {
    "tStartMs": 1725010,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "한 달에 40%씩 영업이익 목표치가 올라가는데"
    } ]
  }, {
    "tStartMs": 1728750,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "그 말인 즉슨 변동폭이 매우 크다는 겁니다"
    } ]
  }, {
    "tStartMs": 1731880,
    "dDurationMs": 510,
    "segs": [ {
      "utf8": "신기술"
    } ]
  }, {
    "tStartMs": 1732390,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "우리가 신기술로 지금 승부를 보고 있는데"
    } ]
  }, {
    "tStartMs": 1734470,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "하나의 해결책일 수도 있지만"
    } ]
  }, {
    "tStartMs": 1736100,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "다른 기업이 신기술을 만들면"
    } ]
  }, {
    "tStartMs": 1737970,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "반대로 모든 것을 없앨 수도 있다"
    } ]
  }, {
    "tStartMs": 1739970,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 1740990,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "지금은 기술에 따라서"
    } ]
  }, {
    "tStartMs": 1742340,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "여기 갔다 저기 갔다 하는 거니까"
    } ]
  }, {
    "tStartMs": 1743500,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "한마디로 천억 달러를 벌 수도 있지만"
    } ]
  }, {
    "tStartMs": 1745630,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "잘못해서 기술 패권을 놓치게 되면"
    } ]
  }, {
    "tStartMs": 1747960,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "천억 달러의 손실이 될 수도 있다"
    } ]
  }, {
    "tStartMs": 1749550,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "그렇게 얘기를 하셨고요"
    } ]
  }, {
    "tStartMs": 1751130,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "그리고 이런 말씀도 하셨습니다"
    } ]
  }, {
    "tStartMs": 1753140,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "우리는 HBM과 같은 더"
    } ]
  }, {
    "tStartMs": 1754370,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "많은 괴물 칩을 만들어야 되고"
    } ]
  }, {
    "tStartMs": 1756100,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "이 몬스터 칩들이"
    } ]
  }, {
    "tStartMs": 1757390,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "우리 회사에 진짜 돈을 벌어주는 제품이긴 합니다"
    } ]
  }, {
    "tStartMs": 1759810,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "이게 물론 1번인데"
    } ]
  }, {
    "tStartMs": 1761180,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "품귀 현상도 있어요"
    } ]
  }, {
    "tStartMs": 1762870,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "우리가 흔히 아는 D램 품귀"
    } ]
  }, {
    "tStartMs": 1764540,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "뭐라고 얘기하셨냐?"
    } ]
  }, {
    "tStartMs": 1765510,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "HBM 마진 60%요"
    } ]
  }, {
    "tStartMs": 1766780,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "근데 일반 칩 마진이 80%네?"
    } ]
  }, {
    "tStartMs": 1769140,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "숏티지 났어"
    } ]
  }, {
    "tStartMs": 1770080,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "D램이 숏티지 났어"
    } ]
  }, {
    "tStartMs": 1772400,
    "dDurationMs": 650,
    "segs": [ {
      "utf8": "품귀현상이 나서"
    } ]
  }, {
    "tStartMs": 1773050,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "사자가 들어오는 거죠"
    } ]
  }, {
    "tStartMs": 1773950,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "거의 사재기가 들어와서"
    } ]
  }, {
    "tStartMs": 1775260,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "HBM보다 일반 칩을 파는 게 더 많이 났습니다"
    } ]
  }, {
    "tStartMs": 1778420,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "그래서 이게 무슨 상황인지 모르겠는데"
    } ]
  }, {
    "tStartMs": 1780420,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "이것은 지금"
    } ]
  }, {
    "tStartMs": 1781060,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "약간 왜곡된 상황인 건 맞는 것 같아요"
    } ]
  }, {
    "tStartMs": 1782940,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "일반 칩 마진이 80%"
    } ]
  }, {
    "tStartMs": 1784560,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "야 그럼 누가 HBM 만들어?"
    } ]
  }, {
    "tStartMs": 1786080,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "D램 만들어야지"
    } ]
  }, {
    "tStartMs": 1787030,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "80% 재고가 남는다고 하는데"
    } ]
  }, {
    "tStartMs": 1788770,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "그래서 엄청난 돈을 벌고 있다는 거고"
    } ]
  }, {
    "tStartMs": 1791410,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "물론 우리나라 반도체 기업들"
    } ]
  }, {
    "tStartMs": 1794180,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "SK하이닉스나 삼성전자"
    } ]
  }, {
    "tStartMs": 1795470,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "주가 상승률이 엄청난데"
    } ]
  }, {
    "tStartMs": 1796970,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "더 많이 오른 기업도 있습니다"
    } ]
  }, {
    "tStartMs": 1798440,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "반도체 기업 중에"
    } ]
  }, {
    "tStartMs": 1799830,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "아 마이크론 얘기를 하려는 거냐"
    } ]
  }, {
    "tStartMs": 1801200,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "마이크론 얘기 많이 했잖아요"
    } ]
  }, {
    "tStartMs": 1802720,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "놀랍게도 우리 옆 나라"
    } ]
  }, {
    "tStartMs": 1804590,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "일본의 반도체 기업"
    } ]
  }, {
    "tStartMs": 1806170,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "키옥시아가"
    } ]
  }, {
    "tStartMs": 1807230,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "최근 1년 주가 상승률이 700%입니다"
    } ]
  }, {
    "tStartMs": 1810480,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "거의 미래에셋이 났어요"
    } ]
  }, {
    "tStartMs": 1812060,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "700%"
    } ]
  }, {
    "tStartMs": 1813190,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "연초 이후 상승률이 81%"
    } ]
  }, {
    "tStartMs": 1815780,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "그동안 우리가 관심을 안 뒀는데"
    } ]
  }, {
    "tStartMs": 1817950,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "일본 반도체 기업이지만"
    } ]
  }, {
    "tStartMs": 1819130,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "랜드 시장 3위에요"
    } ]
  }, {
    "tStartMs": 1820800,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "지금 마이크로사와 공동 3위 정도 될 겁니다"
    } ]
  }, {
    "tStartMs": 1822920,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "7배가 올랐어요"
    } ]
  }, {
    "tStartMs": 1824570,
    "dDurationMs": 380,
    "segs": [ {
      "utf8": "아..."
    } ]
  }, {
    "tStartMs": 1824950,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "근데 잘 생각해보면"
    } ]
  }, {
    "tStartMs": 1826120,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "키옥시아라는 이름을 어디서 들었죠?"
    } ]
  }, {
    "tStartMs": 1828000,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "어디서 들었습니까?"
    } ]
  }, {
    "tStartMs": 1829730,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "2018년 키옥시아는"
    } ]
  }, {
    "tStartMs": 1831520,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "도시바 반도체 메모리 사업이 독립해서"
    } ]
  }, {
    "tStartMs": 1834410,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "2017년에 출범한 기업입니다"
    } ]
  }, {
    "tStartMs": 1836810,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "한마디로 도시바가 무너지면서"
    } ]
  }, {
    "tStartMs": 1839030,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "반도체 메모리 사업부만 떼어서 팔았어요"
    } ]
  }, {
    "tStartMs": 1842530,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "눈물이 앞을 가리죠"
    } ]
  }, {
    "tStartMs": 1843310,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "도시바 입장에서는"
    } ]
  }, {
    "tStartMs": 1844280,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "그걸 누가 샀냐?"
    } ]
  }, {
    "tStartMs": 1845550,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "한미일 연합 컨소시엄이 샀습니다"
    } ]
  }, {
    "tStartMs": 1848060,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "왜냐하면 이건 일본의 어떤"
    } ]
  }, {
    "tStartMs": 1849850,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "자부심 같은 기업이기 때문에"
    } ]
  }, {
    "tStartMs": 1851310,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "반도체 메모리 사업이"
    } ]
  }, {
    "tStartMs": 1852260,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "국가적 기관 사업인데"
    } ]
  }, {
    "tStartMs": 1853600,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "막 팔 수는 없다"
    } ]
  }, {
    "tStartMs": 1854320,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "이런 의견들이 많아서"
    } ]
  }, {
    "tStartMs": 1855550,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "한국, 미국, 일본이 연합 컨소시엄을 이뤘어요"
    } ]
  }, {
    "tStartMs": 1858460,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "도시바도 41%에 들어갔습니다"
    } ]
  }, {
    "tStartMs": 1860530,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "그래서 이때 SK하이닉스가"
    } ]
  }, {
    "tStartMs": 1862360,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "4조 원을 투자했습니다"
    } ]
  }, {
    "tStartMs": 1864290,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "2.6조 원 지분 투자"
    } ]
  }, {
    "tStartMs": 1866330,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "1.3조 원 CB 투자"
    } ]
  }, {
    "tStartMs": 1867930,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "합계 4조 원"
    } ]
  }, {
    "tStartMs": 1868640,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "한마디로 4조 원어치 지분을 확보한 것과 같죠"
    } ]
  }, {
    "tStartMs": 1871340,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "근데 아까는 어떻게 됐다고요?"
    } ]
  }, {
    "tStartMs": 1873020,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "700%가 올랐어요"
    } ]
  }, {
    "tStartMs": 1874970,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "물론 단가가"
    } ]
  }, {
    "tStartMs": 1876290,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "CB단가가 얼마인지에 따라 다르겠지만"
    } ]
  }, {
    "tStartMs": 1878480,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "현재 평가이익만 10조 원이 넘었다"
    } ]
  }, {
    "tStartMs": 1881630,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "10조 단위의 평가이익이 예상됩니다"
    } ]
  }, {
    "tStartMs": 1883240,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "아마 훌쩍 넘었지 않을까라고"
    } ]
  }, {
    "tStartMs": 1884910,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "개인적으로 생각하는데"
    } ]
  }, {
    "tStartMs": 1886080,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "잡혀있는 건 그 정도인 것 같아요"
    } ]
  }, {
    "tStartMs": 1887890,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "한마디로 여기서도 역시 대박이 났다는 거고"
    } ]
  }, {
    "tStartMs": 1890950,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "그리고 제 개인적인 생각에"
    } ]
  }, {
    "tStartMs": 1892510,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "도시바는"
    } ]
  }, {
    "tStartMs": 1894810,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "참 큰 기업 중에"
    } ]
  }, {
    "tStartMs": 1896160,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "가장 운 나쁜 기업을 꼽아라 라고 하면"
    } ]
  }, {
    "tStartMs": 1898220,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "저는 도시바를 꼽고 싶습니다"
    } ]
  }, {
    "tStartMs": 1900640,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "눈물이 앞을 가리는 기업이에요"
    } ]
  }, {
    "tStartMs": 1902560,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "도시바는 여러분들이 잘 아시는"
    } ]
  }, {
    "tStartMs": 1903910,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "일본 기업인데"
    } ]
  }, {
    "tStartMs": 1904930,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "2006년 미국 원전 기업"
    } ]
  }, {
    "tStartMs": 1906730,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "웨스팅하우스에 6조원을 투자합니다"
    } ]
  }, {
    "tStartMs": 1909170,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "이거 사실 우리나라 그때"
    } ]
  }, {
    "tStartMs": 1910400,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "두산이 사겠다고 들어갔는데"
    } ]
  }, {
    "tStartMs": 1912310,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "얘들이 엄청 비싸게 불렀어요"
    } ]
  }, {
    "tStartMs": 1914020,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "6조원에 샀어요"
    } ]
  }, {
    "tStartMs": 1915370,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "근데 2011년에 후쿠시마 원전 사고가 발생하네"
    } ]
  }, {
    "tStartMs": 1919300,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "전 세계가 탈원전 분위기로 하네"
    } ]
  }, {
    "tStartMs": 1921430,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "6조를 원전 기업에 넣었네"
    } ]
  }, {
    "tStartMs": 1923810,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "2016년 도시바가 10조원이"
    } ]
  }, {
    "tStartMs": 1925200,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "넘는 적자가 납니다"
    } ]
  }, {
    "tStartMs": 1926300,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "일본 제조업체 역사상 최대 적자였어요"
    } ]
  }, {
    "tStartMs": 1928690,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "그래서 진짜 속된 말로"
    } ]
  }, {
    "tStartMs": 1930590,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "망했습니다"
    } ]
  }, {
    "tStartMs": 1931490,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "완전히 회사가 없어지지 않았는데"
    } ]
  }, {
    "tStartMs": 1933930,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "상장 폐지했어요"
    } ]
  }, {
    "tStartMs": 1935470,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "그리고 2017년"
    } ]
  }, {
    "tStartMs": 1936760,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "결국에 주력 부분이었던"
    } ]
  }, {
    "tStartMs": 1937830,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "반도체 사업 부분을"
    } ]
  }, {
    "tStartMs": 1939090,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "눈물의 매각을 합니다"
    } ]
  }, {
    "tStartMs": 1941530,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "당시에 랜드 시장"
    } ]
  }, {
    "tStartMs": 1942980,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "글로벌 점유율 2위였습니다, 2위"
    } ]
  }, {
    "tStartMs": 1946180,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "삼성전자가 랜드 1위였고"
    } ]
  }, {
    "tStartMs": 1948150,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "무려 20% 가까운 점유율을 갖고 있던 게"
    } ]
  }, {
    "tStartMs": 1950200,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "일본 도시바였어요"
    } ]
  }, {
    "tStartMs": 1951620,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "요즘 랜드 시장을 생각해봐요"
    } ]
  }, {
    "tStartMs": 1953470,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "이걸 갖고 있었으면"
    } ]
  }, {
    "tStartMs": 1955360,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "도시바는 랜드 플래시를"
    } ]
  }, {
    "tStartMs": 1956750,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "세계 최초로 개발한 기업이고"
    } ]
  }, {
    "tStartMs": 1957980,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "고용량 SSD의 강자였다"
    } ]
  }, {
    "tStartMs": 1960160,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "고용량"
    } ]
  }, {
    "tStartMs": 1961890,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "SK 하이닉스가 들어가서"
    } ]
  }, {
    "tStartMs": 1963820,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "투자를 한 거죠"
    } ]
  }, {
    "tStartMs": 1965180,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "지분율을 굉장히 높게 가져갔는데"
    } ]
  }, {
    "tStartMs": 1967760,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "이걸 버텼으면"
    } ]
  }, {
    "tStartMs": 1969480,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "물론 10조에 적자였기 때문에"
    } ]
  }, {
    "tStartMs": 1970790,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "못 버텼지만"
    } ]
  }, {
    "tStartMs": 1971690,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "지금도 지분율은 있습니다"
    } ]
  }, {
    "tStartMs": 1972900,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "지금도 지분율은 있어서"
    } ]
  }, {
    "tStartMs": 1974400,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "나쁘진 않았지만"
    } ]
  }, {
    "tStartMs": 1975200,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "이걸 통째로 자기 것이 될 수 있었는데"
    } ]
  }, {
    "tStartMs": 1977690,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "지금 뭐 난리가 났는데"
    } ]
  }, {
    "tStartMs": 1980430,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "참, 물론 10년을 알 수 없지만"
    } ]
  }, {
    "tStartMs": 1982050,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "그리고 도시바가"
    } ]
  }, {
    "tStartMs": 1983360,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "원전 기업 웨스팅하우스를 샀다가"
    } ]
  }, {
    "tStartMs": 1986270,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "이걸 결국 엄청 적자가 나서"
    } ]
  }, {
    "tStartMs": 1988320,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "웨스팅하우스를 다시 팔았습니다"
    } ]
  }, {
    "tStartMs": 1990670,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "캐나다 사모펀드에 팔았어요"
    } ]
  }, {
    "tStartMs": 1992170,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "이때 우리나라가 산다는 말도 있었는데"
    } ]
  }, {
    "tStartMs": 1994000,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "이거 샀으면 대박이죠"
    } ]
  }, {
    "tStartMs": 1995430,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "후쿠시마 원전 때문에"
    } ]
  }, {
    "tStartMs": 1996580,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "전 세계가 탈원전한다"
    } ]
  }, {
    "tStartMs": 1998430,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "이제 원전의 시대는 갔다"
    } ]
  }, {
    "tStartMs": 2000640,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "친환경 막 이렇게 가다가"
    } ]
  }, {
    "tStartMs": 2002300,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "AI 그러니까 전 세계가"
    } ]
  }, {
    "tStartMs": 2004490,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "원전으로 다 돌았단 말이에요"
    } ]
  }, {
    "tStartMs": 2006560,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "요즘 원전 기업들 주가 보십시오"
    } ]
  }, {
    "tStartMs": 2008220,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "두산에너빌리티 주가를 봐요"
    } ]
  }, {
    "tStartMs": 2009850,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "지금 몇 배가 오르고 있는데"
    } ]
  }, {
    "tStartMs": 2011660,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "그걸 또 팔았네"
    } ]
  }, {
    "tStartMs": 2013150,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "그 도시바는"
    } ]
  }, {
    "tStartMs": 2014700,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "원전 기업도 갖고 있고"
    } ]
  }, {
    "tStartMs": 2016320,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "랜드 메모리 기업도 갖고 있고"
    } ]
  }, {
    "tStartMs": 2018230,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "그거 두 개만 갖고"
    } ]
  }, {
    "tStartMs": 2019080,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "그냥 가만히만 있었어도"
    } ]
  }, {
    "tStartMs": 2020260,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "지금 아마 두 개 다 거의"
    } ]
  }, {
    "tStartMs": 2022270,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "10배가 날 수 있었는데"
    } ]
  }, {
    "tStartMs": 2023760,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "둘 다 갖고 있다가"
    } ]
  }, {
    "tStartMs": 2025400,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "결국에는 참"
    } ]
  }, {
    "tStartMs": 2027450,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "웨스팅하우스도 결국 6조 원에 매각합니다"
    } ]
  }, {
    "tStartMs": 2029280,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "이거 캐나다 사모펀드가 가져갔고"
    } ]
  }, {
    "tStartMs": 2031530,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "참고로 웨스팅하우스는"
    } ]
  }, {
    "tStartMs": 2032640,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "전 세계 원전의 50%를"
    } ]
  }, {
    "tStartMs": 2034080,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "설계, 건설한 기업이고"
    } ]
  }, {
    "tStartMs": 2035170,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "원천 기술과 특허를"
    } ]
  }, {
    "tStartMs": 2036420,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "대량 보유한 기업이에요"
    } ]
  }, {
    "tStartMs": 2037710,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "우리나라가 원전 수출할 때마다"
    } ]
  }, {
    "tStartMs": 2040240,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "이 태클을 거는 기업이 어디예요?"
    } ]
  }, {
    "tStartMs": 2041460,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "여기입니다"
    } ]
  }, {
    "tStartMs": 2042660,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "왜 자기네 기술을 갖고"
    } ]
  }, {
    "tStartMs": 2043860,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "한국이 원전 수출하냐"
    } ]
  }, {
    "tStartMs": 2044870,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "맨날 가서 뭐 기술료 달라"
    } ]
  }, {
    "tStartMs": 2046350,
    "dDurationMs": 480,
    "segs": [ {
      "utf8": "뭐 달라"
    } ]
  }, {
    "tStartMs": 2046830,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "계속 얘기하는 게 웨스팅하우스예요"
    } ]
  }, {
    "tStartMs": 2048340,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "그래서 이때 캐나다 사모펀드가 살 때"
    } ]
  }, {
    "tStartMs": 2050240,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "사실 우리가 샀으면"
    } ]
  }, {
    "tStartMs": 2052000,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "우리가 샀으면 대박이었는데"
    } ]
  }, {
    "tStartMs": 2053540,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "물론 미래를 내다볼 수는 없지만"
    } ]
  }, {
    "tStartMs": 2056650,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "그렇다는 거고요"
    } ]
  }, {
    "tStartMs": 2057360,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "결국 도시바는 웨스팅하우스도"
    } ]
  }, {
    "tStartMs": 2058800,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "이제 안 갖고 있습니다"
    } ]
  }, {
    "tStartMs": 2060160,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "안 갖고 있고"
    } ]
  }, {
    "tStartMs": 2061440,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "역사에 만약은 없지만"
    } ]
  }, {
    "tStartMs": 2062820,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "2005년에 아까 잠깐 얘기 드렸죠"
    } ]
  }, {
    "tStartMs": 2064670,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "두산중공업, 두산에너빌리티가"
    } ]
  }, {
    "tStartMs": 2066460,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "웨스팅하우스 입찰에 참가했었어요"
    } ]
  }, {
    "tStartMs": 2068970,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "물론 샀으면"
    } ]
  }, {
    "tStartMs": 2071420,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "후쿠시마 그 원전 폭격 맞고"
    } ]
  }, {
    "tStartMs": 2073980,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "10조 적자가 났습니다"
    } ]
  }, {
    "tStartMs": 2075860,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "도시바가 이때 54억 달러를 썼고"
    } ]
  }, {
    "tStartMs": 2077980,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "두산에너빌리티가 미국 기업들과"
    } ]
  }, {
    "tStartMs": 2079530,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "컨소시엄 입찰에서 32억 달러를 적었어요"
    } ]
  }, {
    "tStartMs": 2082280,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "그래서 도시바가 가져갔거든요"
    } ]
  }, {
    "tStartMs": 2083740,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "두산에노빌리티가 샀어"
    } ]
  }, {
    "tStartMs": 2085270,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "웨스팅하우스를"
    } ]
  }, {
    "tStartMs": 2086250,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "후쿠시마 사태 때문에"
    } ]
  }, {
    "tStartMs": 2087320,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "10조 적자가 나면 두산이 망했죠"
    } ]
  }, {
    "tStartMs": 2090210,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "웨스팅하우스 망하고"
    } ]
  }, {
    "tStartMs": 2091000,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "근데 만약에 그때 도시바처럼 안 되고 버텼어"
    } ]
  }, {
    "tStartMs": 2094120,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "버텼으면 지금 두산에노빌리티 시가총액은"
    } ]
  }, {
    "tStartMs": 2097200,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "아마..."
    } ]
  }, {
    "tStartMs": 2098980,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "미쳐돌아가지 않았을까"
    } ]
  }, {
    "tStartMs": 2100220,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "세계 원전의 50%를 건설한 기업이고"
    } ]
  }, {
    "tStartMs": 2102750,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "원전의 어지간한 원천기술과 특허를"
    } ]
  }, {
    "tStartMs": 2104720,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "대부분 가지고 있는 기업이에요"
    } ]
  }, {
    "tStartMs": 2106750,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "아니면 후쿠시마 원전은 터져서"
    } ]
  }, {
    "tStartMs": 2109350,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "도시마가 나가 떨어지고 난 다음에"
    } ]
  }, {
    "tStartMs": 2112470,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "인수를 할 기회도 있긴 있었거든요"
    } ]
  }, {
    "tStartMs": 2114130,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "그때 샀으면"
    } ]
  }, {
    "tStartMs": 2115270,
    "dDurationMs": 650,
    "segs": [ {
      "utf8": "아깝죠"
    } ]
  }, {
    "tStartMs": 2115920,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "우리 역사에 만약은 없지만"
    } ]
  }, {
    "tStartMs": 2117260,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "그때 샀으면 정말 또 대박이지 않을까"
    } ]
  }, {
    "tStartMs": 2119630,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "생각합니다"
    } ]
  }, {
    "tStartMs": 2121040,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "자, 그래서 오늘 대부분 얘기 끝났는데"
    } ]
  }, {
    "tStartMs": 2123520,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "준비한 게 하나가 더 있어서"
    } ]
  }, {
    "tStartMs": 2125950,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "살짝 한번 해보면은"
    } ]
  }, {
    "tStartMs": 2127510,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "요거는 유튜브 영상에 올라갈지"
    } ]
  }, {
    "tStartMs": 2129290,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "안 올라갈지 모르겠습니다"
    } ]
  }, {
    "tStartMs": 2130420,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "우리끼리 한번 얘기해 보시죠"
    } ]
  }, {
    "tStartMs": 2132100,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "자 이런 생각이 들죠"
    } ]
  }, {
    "tStartMs": 2133300,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "어떤 생각이 드냐"
    } ]
  }, {
    "tStartMs": 2135000,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "요거는"
    } ]
  }, {
    "tStartMs": 2137120,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "자, 우리 차트 쟁이들의"
    } ]
  }, {
    "tStartMs": 2138620,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "주술 얘기를 한번 해보도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 2140320,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "자, 언제 내려야 하냐"
    } ]
  }, {
    "tStartMs": 2141860,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "우리의 모든 관심은 여기일 수밖에 없어요"
    } ]
  }, {
    "tStartMs": 2144430,
    "dDurationMs": 510,
    "segs": [ {
      "utf8": "물론 우리가"
    } ]
  }, {
    "tStartMs": 2144940,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "1이냐 2이냐 3이냐 4이냐는"
    } ]
  }, {
    "tStartMs": 2146410,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "모르겠어요"
    } ]
  }, {
    "tStartMs": 2147390,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "자, 여러분 이렇게 된 차트라고 가정을 했을 때"
    } ]
  }, {
    "tStartMs": 2149160,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "여러분들은 언제 내리실 것 같습니까?"
    } ]
  }, {
    "tStartMs": 2152000,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "정답은 물론 아무도 몰라요"
    } ]
  }, {
    "tStartMs": 2153980,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "제 경험상"
    } ]
  }, {
    "tStartMs": 2155070,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "사람들은 보통 언제 내리냐?"
    } ]
  }, {
    "tStartMs": 2156770,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "제일 많은 건 여기입니다"
    } ]
  }, {
    "tStartMs": 2158860,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "0번"
    } ]
  }, {
    "tStartMs": 2159660,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "사람들은 보통 0이 제일 많아요"
    } ]
  }, {
    "tStartMs": 2161820,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "이만큼 오르면 팔 거든"
    } ]
  }, {
    "tStartMs": 2163730,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "0을 여기 하겠습니다"
    } ]
  }, {
    "tStartMs": 2165110,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "사람들이 제일 많이 파는 곳은"
    } ]
  }, {
    "tStartMs": 2166750,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "0번인데"
    } ]
  }, {
    "tStartMs": 2168040,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "보통은 제 경험에"
    } ]
  }, {
    "tStartMs": 2169960,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "진짜 개인 경험입니다"
    } ]
  }, {
    "tStartMs": 2171710,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "트레이더 시절의 경험을 보면"
    } ]
  }, {
    "tStartMs": 2173280,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "1에 가장 많이 내려요"
    } ]
  }, {
    "tStartMs": 2175520,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "1 구간, 이 구간에"
    } ]
  }, {
    "tStartMs": 2177380,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "이게 어렵거든요"
    } ]
  }, {
    "tStartMs": 2178280,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "고점인 것 같고,"
    } ]
  }, {
    "tStartMs": 2179240,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "엄청 많이 오른 것 같고"
    } ]
  }, {
    "tStartMs": 2180720,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "나는 2에 내리고 싶다, 최고점"
    } ]
  }, {
    "tStartMs": 2182850,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "이게 힘듭니다"
    } ]
  }, {
    "tStartMs": 2183840,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "개인적인 경험으로는 거의 불가능하다"
    } ]
  }, {
    "tStartMs": 2186580,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "고수는 불가능하다"
    } ]
  }, {
    "tStartMs": 2187810,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "제 결론은 그거예요"
    } ]
  }, {
    "tStartMs": 2189380,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "고수는 불가능해요"
    } ]
  }, {
    "tStartMs": 2190430,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "왜냐하면 고수는 저기서 내릴 생각을 안 해"
    } ]
  }, {
    "tStartMs": 2193160,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "저기까지 버틴 사람은"
    } ]
  }, {
    "tStartMs": 2194830,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "저기서 내릴 생각은 안 해"
    } ]
  }, {
    "tStartMs": 2196920,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "보통 그래요"
    } ]
  }, {
    "tStartMs": 2197540,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "그러니까 2는 운이 좀 좋거나"
    } ]
  }, {
    "tStartMs": 2199610,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "아니면 진짜 주식의 신이거나"
    } ]
  }, {
    "tStartMs": 2200800,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "그러니까 주식의 신은 못 봤는데"
    } ]
  }, {
    "tStartMs": 2202890,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "주식의 신이면 갈 수 있지만"
    } ]
  }, {
    "tStartMs": 2204490,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "고수 정도로는 여기서 못 내려요"
    } ]
  }, {
    "tStartMs": 2206660,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "어디서 많이 내리냐?"
    } ]
  }, {
    "tStartMs": 2207820,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "보통 대부분"
    } ]
  }, {
    "tStartMs": 2209620,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "여기 언저리죠"
    } ]
  }, {
    "tStartMs": 2210790,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "이 구간 3이라고"
    } ]
  }, {
    "tStartMs": 2212050,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "제가 표현을 했는데"
    } ]
  }, {
    "tStartMs": 2213230,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "보통 3에 내리고"
    } ]
  }, {
    "tStartMs": 2214570,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "고수들도 대부분 여기서 내릴 수 있게"
    } ]
  }, {
    "tStartMs": 2216350,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "기도를 합니다"
    } ]
  }, {
    "tStartMs": 2217750,
    "dDurationMs": 360,
    "segs": [ {
      "utf8": "왜?"
    } ]
  }, {
    "tStartMs": 2218110,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "여기서도 못 내리는 경우가 많거든"
    } ]
  }, {
    "tStartMs": 2220360,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "여기서 못 내리면 여기거든요"
    } ]
  }, {
    "tStartMs": 2222020,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "여기는 이제 반려주식이 돼요"
    } ]
  }, {
    "tStartMs": 2224740,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "그래서 제 개인적인 생각에"
    } ]
  }, {
    "tStartMs": 2226140,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "우리의 목표는 여긴데"
    } ]
  }, {
    "tStartMs": 2227990,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "3입니다"
    } ]
  }, {
    "tStartMs": 2230020,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "1에서 버티기 쉽지 않아요"
    } ]
  }, {
    "tStartMs": 2232460,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "여기를 버티면 고수다"
    } ]
  }, {
    "tStartMs": 2234020,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "제가 이렇게 그렸지만은"
    } ]
  }, {
    "tStartMs": 2235650,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "이런 겁니다"
    } ]
  }, {
    "tStartMs": 2237240,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "여기가 1이에요"
    } ]
  }, {
    "tStartMs": 2238690,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "무슨 소리냐?"
    } ]
  }, {
    "tStartMs": 2239600,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "1에서 내리면 고수라고 얘기를 하는 게"
    } ]
  }, {
    "tStartMs": 2241220,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "경험만 말씀드리면"
    } ]
  }, {
    "tStartMs": 2243080,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "보통 이렇게 되거든요"
    } ]
  }, {
    "tStartMs": 2244160,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "여기서 많이 내린다는 거죠"
    } ]
  }, {
    "tStartMs": 2247280,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "여기까지 버티면"
    } ]
  }, {
    "tStartMs": 2248390,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "사실은 고수라고 할 수 있고"
    } ]
  }, {
    "tStartMs": 2250160,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "대부분 여기서 팔 수 있으면"
    } ]
  }, {
    "tStartMs": 2252020,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "신이야, 신"
    } ]
  }, {
    "tStartMs": 2253250,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "이건 불가능해요"
    } ]
  }, {
    "tStartMs": 2253870,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "왜냐하면 올라가는 걸 누가 팔아요"
    } ]
  }, {
    "tStartMs": 2256580,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "상승하고 있는 걸"
    } ]
  }, {
    "tStartMs": 2257950,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "이거 진짜 어렵습니다"
    } ]
  }, {
    "tStartMs": 2259300,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "진짜 잘 팔아야 이 구간인데"
    } ]
  }, {
    "tStartMs": 2261310,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "보통은 이 구간에서도 쉽지 않고"
    } ]
  }, {
    "tStartMs": 2263100,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "이 구간이 제일 많은 것 같아요"
    } ]
  }, {
    "tStartMs": 2264690,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "여기 어디 구간 정도가"
    } ]
  }, {
    "tStartMs": 2266200,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "제일 많지 않냐 생각이 되고"
    } ]
  }, {
    "tStartMs": 2267810,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "그래서 이 우리 차트쟁이들의"
    } ]
  }, {
    "tStartMs": 2269990,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "주식쟁이들의 주술 차트를 보통 보면"
    } ]
  }, {
    "tStartMs": 2272380,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "제가 한번 여러분들의 심리를"
    } ]
  }, {
    "tStartMs": 2273760,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "한번 만들어 보겠습니다"
    } ]
  }, {
    "tStartMs": 2275100,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "보통 투자자들의 상황 판단이 어떻게 되냐?"
    } ]
  }, {
    "tStartMs": 2277820,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "여기서는 버텨 그래요"
    } ]
  }, {
    "tStartMs": 2279030,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "잘하는 분들"
    } ]
  }, {
    "tStartMs": 2279800,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "버텨 버텨 버텨"
    } ]
  }, {
    "tStartMs": 2280770,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "1에서 밀리기 시작하면"
    } ]
  }, {
    "tStartMs": 2282370,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "왜 많이 파냐?"
    } ]
  }, {
    "tStartMs": 2283110,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "가장 많이 파냐? 고점인가?"
    } ]
  }, {
    "tStartMs": 2285620,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "이게 바로 나와 밀렸잖아요"
    } ]
  }, {
    "tStartMs": 2287390,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "고점인가가 나올 수밖에 없어요"
    } ]
  }, {
    "tStartMs": 2289800,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "특히 A가 깊은 경우에는"
    } ]
  }, {
    "tStartMs": 2291280,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "버티기가 어렵습니다"
    } ]
  }, {
    "tStartMs": 2292580,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "왜냐하면 뒤가 없잖아요"
    } ]
  }, {
    "tStartMs": 2293710,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "지금은 제가 이렇게 그렸지만"
    } ]
  }, {
    "tStartMs": 2294940,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "이 뒤가 지금 없는 겁니다"
    } ]
  }, {
    "tStartMs": 2296480,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "없는 거에서 이 앞부분만 보면"
    } ]
  }, {
    "tStartMs": 2298990,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "이게 무섭단 말이에요"
    } ]
  }, {
    "tStartMs": 2299770,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "그리고 이 앞에도 뭔가 사연이 있죠"
    } ]
  }, {
    "tStartMs": 2301420,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "제가 깊게 그려오지 않았지만"
    } ]
  }, {
    "tStartMs": 2302810,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "그런 상황이어서"
    } ]
  }, {
    "tStartMs": 2304540,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "고점인가 하고 내리는 거예요"
    } ]
  }, {
    "tStartMs": 2306340,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "버틴다고 칩시다"
    } ]
  }, {
    "tStartMs": 2307470,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "위에까지 버텨요"
    } ]
  }, {
    "tStartMs": 2308490,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "버티면 올라갈 때 못 내리고"
    } ]
  }, {
    "tStartMs": 2309960,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "이거 올라갈 때 내리면"
    } ]
  }, {
    "tStartMs": 2311040,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "진짜 성인입니다, 성인"
    } ]
  }, {
    "tStartMs": 2313050,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "나는 이 정도면 충분히 먹은 것 같아"
    } ]
  }, {
    "tStartMs": 2314950,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "더 이상은 욕심이야"
    } ]
  }, {
    "tStartMs": 2316100,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "이 정도면 성인 군자야"
    } ]
  }, {
    "tStartMs": 2317990,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "그분은 인격적으로 완성이 된 분이야"
    } ]
  }, {
    "tStartMs": 2320060,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "존경해야 돼"
    } ]
  }, {
    "tStartMs": 2321180,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "저는 절대 안 돼"
    } ]
  }, {
    "tStartMs": 2322660,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "야, 더 먹어야지"
    } ]
  }, {
    "tStartMs": 2324240,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "형 무슨 소리세요, 형님"
    } ]
  }, {
    "tStartMs": 2325860,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "24만 전자, 27만 전자"
    } ]
  }, {
    "tStartMs": 2328440,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "지금 130만 닉스가 나를 기다리고 있는데"
    } ]
  }, {
    "tStartMs": 2331440,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "형님 이거를"
    } ]
  }, {
    "tStartMs": 2332100,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "아우 전 안 돼요"
    } ]
  }, {
    "tStartMs": 2333570,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "욕심이... 장난합니까?"
    } ]
  }, {
    "tStartMs": 2334930,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "코스피가 지금"
    } ]
  }, {
    "tStartMs": 2335720,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "1만을 향해서 가고 있는 이 와중에"
    } ]
  }, {
    "tStartMs": 2337570,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "지금 말이야"
    } ]
  }, {
    "tStartMs": 2338570,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "나는 이 정도면 충분해"
    } ]
  }, {
    "tStartMs": 2340160,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "100% 먹었으면 되지 않니?"
    } ]
  }, {
    "tStartMs": 2341600,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "뭐 이 정도면 어떻게 내려"
    } ]
  }, {
    "tStartMs": 2343360,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "이거는 인격 수양의 단계다"
    } ]
  }, {
    "tStartMs": 2347400,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "물론 좀 밀리면"
    } ]
  }, {
    "tStartMs": 2348860,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "오만 가지 생각이 다 들죠"
    } ]
  }, {
    "tStartMs": 2350200,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "오만 가지 생각이 다 들어요"
    } ]
  }, {
    "tStartMs": 2351520,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "근데 던지기 전에 이유를 찾습니다"
    } ]
  }, {
    "tStartMs": 2354360,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "뭐를 찾냐?"
    } ]
  }, {
    "tStartMs": 2355350,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "보통 전고점을 찾아요"
    } ]
  }, {
    "tStartMs": 2357210,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "또는 전저점을 찾습니다"
    } ]
  }, {
    "tStartMs": 2358780,
    "dDurationMs": 420,
    "segs": [ {
      "utf8": "여기"
    } ]
  }, {
    "tStartMs": 2359200,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "여기 쯤에 이렇게 그어요"
    } ]
  }, {
    "tStartMs": 2360430,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "그 다음에 마음속으로"
    } ]
  }, {
    "tStartMs": 2361870,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "주술을 외우면서 버텨요"
    } ]
  }, {
    "tStartMs": 2363070,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "그래, 전고점에서 버틸 거야"
    } ]
  }, {
    "tStartMs": 2364970,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "버틸 거야"
    } ]
  }, {
    "tStartMs": 2365700,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "그리고 많은 사람들이"
    } ]
  }, {
    "tStartMs": 2366710,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "그 주술을 같이 외우면서"
    } ]
  }, {
    "tStartMs": 2368500,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "전고점에서 한번 사봐야지 라는 생각을 합니다"
    } ]
  }, {
    "tStartMs": 2371200,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "여기일 수도 있어요"
    } ]
  }, {
    "tStartMs": 2372120,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "전점일 수도 있어요"
    } ]
  }, {
    "tStartMs": 2373300,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "그래서 실제로 많은 사람들이"
    } ]
  }, {
    "tStartMs": 2374730,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "그렇게 생각하기 때문에"
    } ]
  }, {
    "tStartMs": 2375790,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "이 전고점에 오면 한번 들어올려요 놀랍게도"
    } ]
  }, {
    "tStartMs": 2377940,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "그러면 오! 다행이다"
    } ]
  }, {
    "tStartMs": 2379800,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "역시 내가 맞았거든"
    } ]
  }, {
    "tStartMs": 2380930,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "왜냐면 여기서 보면"
    } ]
  }, {
    "tStartMs": 2381980,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "이렇게 나가는 거지만"
    } ]
  }, {
    "tStartMs": 2383230,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "이 지점에서는 사실은"
    } ]
  }, {
    "tStartMs": 2385070,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "여기하고 똑같은 거예요"
    } ]
  }, {
    "tStartMs": 2386980,
    "dDurationMs": 580,
    "segs": [ {
      "utf8": "똑같은 거잖아"
    } ]
  }, {
    "tStartMs": 2387560,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "여기도 전고점이"
    } ]
  }, {
    "tStartMs": 2388330,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "어디 있었을 거야"
    } ]
  }, {
    "tStartMs": 2389130,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "그래서 거기하고 버텨서 버텨서 나온 거잖아"
    } ]
  }, {
    "tStartMs": 2391890,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "그래서 여기도 역시 똑같이 버텼기 때문에"
    } ]
  }, {
    "tStartMs": 2393750,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "이제 가겠구나 생각을 합니다"
    } ]
  }, {
    "tStartMs": 2395430,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "다 같이 룰루랄라 하죠"
    } ]
  }, {
    "tStartMs": 2396760,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "그랬는데"
    } ]
  }, {
    "tStartMs": 2398340,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "약간 힘이 없이"
    } ]
  }, {
    "tStartMs": 2399470,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "비실비실되더니"
    } ]
  }, {
    "tStartMs": 2401520,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "밀리네"
    } ]
  }, {
    "tStartMs": 2402500,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "여기를 깨네"
    } ]
  }, {
    "tStartMs": 2404320,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "대부분 진짜 진짜 고수는"
    } ]
  }, {
    "tStartMs": 2406880,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "여기서 팔 수 있겠지만"
    } ]
  }, {
    "tStartMs": 2407630,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "못 팔 걸"
    } ]
  }, {
    "tStartMs": 2408740,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "못 팔아요 못 팔어"
    } ]
  }, {
    "tStartMs": 2410010,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "여기 쉽게 못 팔고"
    } ]
  }, {
    "tStartMs": 2411100,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "이거 깨질 때 나가죠"
    } ]
  }, {
    "tStartMs": 2412830,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "야 아니다 아니다"
    } ]
  }, {
    "tStartMs": 2414000,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "야, 왜냐면 이유가"
    } ]
  }, {
    "tStartMs": 2414940,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "이제 이유 자기가 설득이 돼야 돼요"
    } ]
  }, {
    "tStartMs": 2416900,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "자기가 보통 설득이 돼야 되기 때문에"
    } ]
  }, {
    "tStartMs": 2418430,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "내가 주술을 외우고"
    } ]
  }, {
    "tStartMs": 2419780,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "쌀알 세 개를 던져 봤더니"
    } ]
  }, {
    "tStartMs": 2421750,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "쌀알의 배석이 이렇게 이렇게 되는 거잖아요"
    } ]
  }, {
    "tStartMs": 2424000,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "야 이거 던져 봤더니 아니야"
    } ]
  }, {
    "tStartMs": 2425810,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "야 이거 타로점을 했더니"
    } ]
  }, {
    "tStartMs": 2427250,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "여기서 뭔가 흉측한 뭐가 나왔어"
    } ]
  }, {
    "tStartMs": 2429740,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "그래서 이거 깨질 때"
    } ]
  }, {
    "tStartMs": 2430580,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "보통 많이 던집니다"
    } ]
  }, {
    "tStartMs": 2432100,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "그래서 보통 뭐 좀"
    } ]
  }, {
    "tStartMs": 2433620,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "이 주술 좀 하고 그쵸?"
    } ]
  }, {
    "tStartMs": 2435140,
    "dDurationMs": 170,
    "segs": [ {
      "utf8": "이 쪽"
    } ]
  }, {
    "tStartMs": 2435310,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "껌 좀 씹는다는 분들이"
    } ]
  }, {
    "tStartMs": 2436860,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "이 지점에서 많이 던지죠"
    } ]
  }, {
    "tStartMs": 2439400,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "근데 이게 참 악랄한 게"
    } ]
  }, {
    "tStartMs": 2441700,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "왜냐하면 제가 이렇게 그렸지만"
    } ]
  }, {
    "tStartMs": 2444320,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "이게 페이크야, 페이크"
    } ]
  }, {
    "tStartMs": 2446810,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "그리고 여기도 페이크가 있어요"
    } ]
  }, {
    "tStartMs": 2447890,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "제가 이렇게 그렸지만"
    } ]
  }, {
    "tStartMs": 2448620,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "보통 어떻게 되냐면"
    } ]
  }, {
    "tStartMs": 2450070,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "이렇게 됩니다"
    } ]
  }, {
    "tStartMs": 2451190,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "살짝 깨져요, 살짝"
    } ]
  }, {
    "tStartMs": 2453950,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "이 살짝 깨질 때"
    } ]
  }, {
    "tStartMs": 2454960,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "옳거니 깨졌구나 하고 던져요"
    } ]
  }, {
    "tStartMs": 2457470,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "그럼 아래로 긴 꼬리가 달리더니"
    } ]
  }, {
    "tStartMs": 2459160,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "갑자기 오후장 쯤에 이걸 들어올려서"
    } ]
  }, {
    "tStartMs": 2461110,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "이렇게 갑니다"
    } ]
  }, {
    "tStartMs": 2462620,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "약간 조성한 표현을 쓰면 맛이 가요"
    } ]
  }, {
    "tStartMs": 2465250,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "이 페이크에 당하면"
    } ]
  }, {
    "tStartMs": 2467070,
    "dDurationMs": 630,
    "segs": [ {
      "utf8": "소위 맛이 가"
    } ]
  }, {
    "tStartMs": 2467700,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "정신을 잡을 수가 없다"
    } ]
  }, {
    "tStartMs": 2469170,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "그 다음부터 이렇게 가잖아?"
    } ]
  }, {
    "tStartMs": 2470620,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "그럼 미쳐버립니다"
    } ]
  }, {
    "tStartMs": 2472350,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "그때부터는 마음속으로 숏을 기원합니다"
    } ]
  }, {
    "tStartMs": 2474710,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "빠져라"
    } ]
  }, {
    "tStartMs": 2475640,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "이 망할 주식"
    } ]
  }, {
    "tStartMs": 2476670,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "빠져라"
    } ]
  }, {
    "tStartMs": 2477770,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "난 여기서 던졌거든 지금"
    } ]
  }, {
    "tStartMs": 2479040,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "페이크에 당해서"
    } ]
  }, {
    "tStartMs": 2480340,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "이거 무조건 빠져요"
    } ]
  }, {
    "tStartMs": 2481490,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "빠지면 행복해"
    } ]
  }, {
    "tStartMs": 2483370,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "어휴"
    } ]
  }, {
    "tStartMs": 2484670,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "야 그럼 내가 맞았지"
    } ]
  }, {
    "tStartMs": 2485900,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "근데 여기서 가면은"
    } ]
  }, {
    "tStartMs": 2487420,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "그때부터 스텝이 꼬여요"
    } ]
  }, {
    "tStartMs": 2489300,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "그래서 이게 멘탈 게임인데"
    } ]
  }, {
    "tStartMs": 2490940,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "저게 갔을 때"
    } ]
  }, {
    "tStartMs": 2491990,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "이게 갈 때 참지 못하잖아요"
    } ]
  }, {
    "tStartMs": 2493970,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "어떻게 되냐면은"
    } ]
  }, {
    "tStartMs": 2495340,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "이렇게 했다가 올라간 다음에"
    } ]
  }, {
    "tStartMs": 2496350,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "참지 못하고 잡아요"
    } ]
  }, {
    "tStartMs": 2498270,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "이게 진짜 힘들거든"
    } ]
  }, {
    "tStartMs": 2499330,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "이게 해봐요"
    } ]
  }, {
    "tStartMs": 2500220,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "왜냐하면 이렇게 갈 줄 아나?"
    } ]
  }, {
    "tStartMs": 2501430,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "제가 이렇게 그렸으니까 그렇지"
    } ]
  }, {
    "tStartMs": 2502580,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "여기서 내가 손절한 걸 수도 있잖아"
    } ]
  }, {
    "tStartMs": 2504500,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "쭉 갈 수 있어"
    } ]
  }, {
    "tStartMs": 2505190,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "다시 잡습니다"
    } ]
  }, {
    "tStartMs": 2506680,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "근데 이게 흔들리잖아, 여기서"
    } ]
  }, {
    "tStartMs": 2508110,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "그럼 이제 오만 가지 생각이"
    } ]
  }, {
    "tStartMs": 2509570,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "다 들어요"
    } ]
  }, {
    "tStartMs": 2510470,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "난 여기서 한 번 던졌는데"
    } ]
  }, {
    "tStartMs": 2511880,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "이 고점에서 샀단 말이야"
    } ]
  }, {
    "tStartMs": 2513410,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "근데 밀려서 여기네?"
    } ]
  }, {
    "tStartMs": 2514550,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "또 물렸네?"
    } ]
  }, {
    "tStartMs": 2516030,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "본부장님이 얘기하죠"
    } ]
  }, {
    "tStartMs": 2516980,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "벌었냐? 깨졌는데요?"
    } ]
  }, {
    "tStartMs": 2518550,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "너 롱이잖아"
    } ]
  }, {
    "tStartMs": 2519460,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "예"
    } ]
  }, {
    "tStartMs": 2520200,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "근데 왜 깨졌냐?"
    } ]
  }, {
    "tStartMs": 2521570,
    "dDurationMs": 670,
    "segs": [ {
      "utf8": "그러게요"
    } ]
  }, {
    "tStartMs": 2522240,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "난 롱만 잡았는데 깨졌네"
    } ]
  }, {
    "tStartMs": 2525500,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "다시 밀려"
    } ]
  }, {
    "tStartMs": 2526310,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "그래서 여기서 진짜"
    } ]
  }, {
    "tStartMs": 2527870,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "전력을 다해 기도합니다"
    } ]
  }, {
    "tStartMs": 2529080,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "깨지지 말라고"
    } ]
  }, {
    "tStartMs": 2531030,
    "dDurationMs": 580,
    "segs": [ {
      "utf8": "이거 깨진 순간"
    } ]
  }, {
    "tStartMs": 2531610,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "멘탈이 바사삭?"
    } ]
  }, {
    "tStartMs": 2533090,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "멘탈 바사삭이고"
    } ]
  }, {
    "tStartMs": 2534680,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "여기서 진짜 한 번 더 하면"
    } ]
  }, {
    "tStartMs": 2536250,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "진짜 시장이 악랄한 게"
    } ]
  }, {
    "tStartMs": 2537620,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "여기서 훼이크 한 번 더 주죠"
    } ]
  }, {
    "tStartMs": 2539170,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "다시 꼬리 만들고"
    } ]
  }, {
    "tStartMs": 2540080,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "다시 이렇게 가면"
    } ]
  }, {
    "tStartMs": 2541270,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "그때부터는 병원 가야 돼"
    } ]
  }, {
    "tStartMs": 2542650,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "이거는 손을 떼야 돼"
    } ]
  }, {
    "tStartMs": 2544550,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "이거 두 번 반복하면"
    } ]
  }, {
    "tStartMs": 2546060,
    "dDurationMs": 490,
    "segs": [ {
      "utf8": "다 나갑니다"
    } ]
  }, {
    "tStartMs": 2546550,
    "dDurationMs": 350,
    "segs": [ {
      "utf8": "다 나가"
    } ]
  }, {
    "tStartMs": 2546900,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "두 번 반복하면 없어"
    } ]
  }, {
    "tStartMs": 2548120,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "번 거 다 나가, 다 나가"
    } ]
  }, {
    "tStartMs": 2549090,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "이 손을 떼야 돼요"
    } ]
  }, {
    "tStartMs": 2549970,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "이때는 저기 여의도공원 놀러 가야 돼요"
    } ]
  }, {
    "tStartMs": 2552600,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "옆에서 말려줘야 돼요"
    } ]
  }, {
    "tStartMs": 2554240,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "여기서 손절이 다시 나갔는데"
    } ]
  }, {
    "tStartMs": 2556090,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "여기다가 손절이 다시 올라간다고"
    } ]
  }, {
    "tStartMs": 2557660,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "다시 잡으면"
    } ]
  }, {
    "tStartMs": 2558390,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "여기서부터는 멘탈이 이미 갔기 때문에"
    } ]
  }, {
    "tStartMs": 2560380,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "조그만 흔들려도 다 손절이에요"
    } ]
  }, {
    "tStartMs": 2562490,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "이게 멘탈 게임이죠"
    } ]
  }, {
    "tStartMs": 2563790,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "그래서 이 페이크 주는 거에서"
    } ]
  }, {
    "tStartMs": 2565790,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "물론 그렇다고"
    } ]
  }, {
    "tStartMs": 2568370,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "야, 나는 뭐 마음이 편해"
    } ]
  }, {
    "tStartMs": 2570060,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "그럼 쭉 내려가면"
    } ]
  }, {
    "tStartMs": 2570940,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "이제 반려 주식"
    } ]
  }, {
    "tStartMs": 2572200,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "반려 주식이 되는 경우가 더욱 많죠"
    } ]
  }, {
    "tStartMs": 2575290,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "자 그래서 지금까지"
    } ]
  }, {
    "tStartMs": 2576810,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "재미있게 얘기는 잠깐 드렸지만"
    } ]
  }, {
    "tStartMs": 2578990,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "전세계 사람들이 이 매도 타임 때문에"
    } ]
  }, {
    "tStartMs": 2581320,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "머리를 쥐어짭니다"
    } ]
  }, {
    "tStartMs": 2583400,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "매수는 보통 근거가 있어요"
    } ]
  }, {
    "tStartMs": 2585000,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "사람마다"
    } ]
  }, {
    "tStartMs": 2586220,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "이유가 있어"
    } ]
  }, {
    "tStartMs": 2587100,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "PER이 있고 영업이익이 있고"
    } ]
  }, {
    "tStartMs": 2589050,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "뭐가 있고 정책이 있고"
    } ]
  }, {
    "tStartMs": 2590720,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "회장님의 뭐가 있고"
    } ]
  }, {
    "tStartMs": 2591750,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "다 근거가 있어요"
    } ]
  }, {
    "tStartMs": 2592970,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "자기만의 뭐가 있고"
    } ]
  }, {
    "tStartMs": 2595170,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "매수는 다"
    } ]
  }, {
    "tStartMs": 2596010,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "그래서 매수는 과학이라는 얘기를 많이 해요"
    } ]
  }, {
    "tStartMs": 2598160,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "근데 매도는 근거가 있기 힘들어"
    } ]
  }, {
    "tStartMs": 2600980,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "SK 하이닉스 얼마가 과학이야?"
    } ]
  }, {
    "tStartMs": 2602750,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "모르잖아요"
    } ]
  }, {
    "tStartMs": 2603580,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "삼성전자 위로 얼마?"
    } ]
  }, {
    "tStartMs": 2605210,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "삼성전자 이러면 10조를 버는데"
    } ]
  }, {
    "tStartMs": 2607080,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "시가총액이 5조밖에 안 됩니까?"
    } ]
  }, {
    "tStartMs": 2608430,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "이거는 근거가 있어요"
    } ]
  }, {
    "tStartMs": 2610010,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "이건 자기가 과학인데"
    } ]
  }, {
    "tStartMs": 2611110,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "매도는 위는 광기에는 근거가 없어"
    } ]
  }, {
    "tStartMs": 2614240,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "광기에는"
    } ]
  }, {
    "tStartMs": 2614850,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "이걸 매도를 예술이라고 부르기 때문에"
    } ]
  }, {
    "tStartMs": 2617170,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "이 매도 타이밍을"
    } ]
  }, {
    "tStartMs": 2617990,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "그렇게 고민을 많이 해요"
    } ]
  }, {
    "tStartMs": 2619680,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "이게 더 어렵습니다"
    } ]
  }, {
    "tStartMs": 2621660,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "제가 보기에는"
    } ]
  }, {
    "tStartMs": 2622420,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "매수보다 더"
    } ]
  }, {
    "tStartMs": 2623440,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "매수를 잘하는 게"
    } ]
  }, {
    "tStartMs": 2624130,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "물론 최고 고수죠"
    } ]
  }, {
    "tStartMs": 2625260,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "이게 잘하는 게 고수인데"
    } ]
  }, {
    "tStartMs": 2626630,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "매도가 더 어려워요"
    } ]
  }, {
    "tStartMs": 2627750,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "어렵기는"
    } ]
  }, {
    "tStartMs": 2628820,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "잘하는 게 어렵다는 거죠"
    } ]
  }, {
    "tStartMs": 2630110,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "그리고 이 훼이크들 때문에"
    } ]
  }, {
    "tStartMs": 2632480,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "세계에서 가장 유명한 패턴이 등장을 합니다"
    } ]
  }, {
    "tStartMs": 2635620,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "여러분들이 이런 이 주술"
    } ]
  }, {
    "tStartMs": 2637330,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "지금 제가 얘기하는"
    } ]
  }, {
    "tStartMs": 2638170,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "이 주식세계의 주술을 배울 때"
    } ]
  }, {
    "tStartMs": 2641300,
    "dDurationMs": 590,
    "segs": [ {
      "utf8": "배우는 거잖아요"
    } ]
  }, {
    "tStartMs": 2641890,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "주술이잖아, 주술"
    } ]
  }, {
    "tStartMs": 2643200,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "위로 던지고 종 좀 치면서"
    } ]
  }, {
    "tStartMs": 2645820,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "남쪽을 향해서 이걸 해야지"
    } ]
  }, {
    "tStartMs": 2647080,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "이런 걸 배울 때"
    } ]
  }, {
    "tStartMs": 2648160,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "가장 유명하게 배우는"
    } ]
  }, {
    "tStartMs": 2649720,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "아브라카타브라가 있어요"
    } ]
  }, {
    "tStartMs": 2651330,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "있죠?"
    } ]
  }, {
    "tStartMs": 2651990,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "무슨 꿈 던지는 거"
    } ]
  }, {
    "tStartMs": 2653470,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "그게 뭐냐"
    } ]
  }, {
    "tStartMs": 2654660,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "세계에서 가장 유명한 주술이 바로"
    } ]
  }, {
    "tStartMs": 2656120,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "이 헤드 앤 숄더입니다"
    } ]
  }, {
    "tStartMs": 2658060,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "이게 왜 등장을 했냐"
    } ]
  }, {
    "tStartMs": 2659430,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "제가 모든 패턴을 모든 주술을"
    } ]
  }, {
    "tStartMs": 2661380,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "다 하기에는 시간도 그러니까"
    } ]
  }, {
    "tStartMs": 2662730,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "알지도 못하고"
    } ]
  }, {
    "tStartMs": 2663820,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "이 유명한 패턴이 왜 등장했냐면"
    } ]
  }, {
    "tStartMs": 2666440,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "사람들이 매도를 생각하거든"
    } ]
  }, {
    "tStartMs": 2668500,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "나는 잘하고 싶단 말이야"
    } ]
  }, {
    "tStartMs": 2669890,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "그러다 보니까"
    } ]
  }, {
    "tStartMs": 2671330,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "이게 등장을 해요"
    } ]
  }, {
    "tStartMs": 2672380,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "아까 제가 쭉 옆에 써놨죠?"
    } ]
  }, {
    "tStartMs": 2674420,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "그 사람들의 생각, 마음이"
    } ]
  }, {
    "tStartMs": 2676270,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "그래서 이 패턴이 등장을 합니다"
    } ]
  }, {
    "tStartMs": 2677990,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "그래서"
    } ]
  }, {
    "tStartMs": 2678550,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "왜 무슨 말이냐?"
    } ]
  }, {
    "tStartMs": 2679720,
    "dDurationMs": 530,
    "segs": [ {
      "utf8": "보세요"
    } ]
  }, {
    "tStartMs": 2680250,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "아까 전에 뭐 이런 게 있었을 거 아니에요?"
    } ]
  }, {
    "tStartMs": 2681840,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "버티고 여기서도 버팁니다"
    } ]
  }, {
    "tStartMs": 2683460,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "올라가죠?"
    } ]
  }, {
    "tStartMs": 2684390,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "버티는데 아까 얘기 드렸죠?"
    } ]
  }, {
    "tStartMs": 2686490,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "페이크"
    } ]
  }, {
    "tStartMs": 2688030,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "페이크가 와요"
    } ]
  }, {
    "tStartMs": 2688860,
    "dDurationMs": 630,
    "segs": [ {
      "utf8": "페이크가"
    } ]
  }, {
    "tStartMs": 2689490,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "막 그래서 사람들이 무슨 생각을 하냐"
    } ]
  }, {
    "tStartMs": 2691650,
    "dDurationMs": 670,
    "segs": [ {
      "utf8": "깨졌을 때"
    } ]
  }, {
    "tStartMs": 2692320,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "일단 던지는 사람이 있죠"
    } ]
  }, {
    "tStartMs": 2693710,
    "dDurationMs": 490,
    "segs": [ {
      "utf8": "던지는 사람"
    } ]
  }, {
    "tStartMs": 2694200,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "그래서 아래로 한번 쭉 가고"
    } ]
  }, {
    "tStartMs": 2696150,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "올라갈 때"
    } ]
  }, {
    "tStartMs": 2697520,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "우리는 흔히 뭐 확인을 한다"
    } ]
  }, {
    "tStartMs": 2699680,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "이런 표현을 써요"
    } ]
  }, {
    "tStartMs": 2701130,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "왜냐하면 이 3 상승에서"
    } ]
  }, {
    "tStartMs": 2702650,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "수많은 사람들이 들어가거든"
    } ]
  }, {
    "tStartMs": 2705070,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "이게 올라가던 주식이잖아요"
    } ]
  }, {
    "tStartMs": 2706340,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "들어가요"
    } ]
  }, {
    "tStartMs": 2707070,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "이 훼이크에 진짜 많이 당합니다"
    } ]
  }, {
    "tStartMs": 2709910,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "진짜 많이"
    } ]
  }, {
    "tStartMs": 2711000,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "그래서 마음을 놓고 있다가"
    } ]
  }, {
    "tStartMs": 2712670,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "소위 말해 우리 선 긋는 거 있죠"
    } ]
  }, {
    "tStartMs": 2715030,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "선을 어떻게 긋던 간에"
    } ]
  }, {
    "tStartMs": 2716450,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "이 페이크를 한 번 맞고"
    } ]
  }, {
    "tStartMs": 2717630,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "다시 떨어져"
    } ]
  }, {
    "tStartMs": 2719350,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "그래서 이게 그 유명한"
    } ]
  }, {
    "tStartMs": 2720830,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "헤드 앤 숄더 차트가 되는 게"
    } ]
  }, {
    "tStartMs": 2722670,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "아니 그냥 편하게"
    } ]
  }, {
    "tStartMs": 2723910,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "이렇게 올라가다가"
    } ]
  }, {
    "tStartMs": 2724940,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "이렇게 빠져주면 얼마나 좋아요"
    } ]
  }, {
    "tStartMs": 2727200,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "얼마나 좋아"
    } ]
  }, {
    "tStartMs": 2728100,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "피해자도 없고"
    } ]
  }, {
    "tStartMs": 2729370,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "적당히 팔면 되잖아"
    } ]
  }, {
    "tStartMs": 2730770,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "근데 이 악랄한 주식 놈들이"
    } ]
  }, {
    "tStartMs": 2733090,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "이렇게 빠진다니까"
    } ]
  }, {
    "tStartMs": 2735690,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "해보세요 해보세요"
    } ]
  }, {
    "tStartMs": 2737060,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "이게 얼마나 유명하면"
    } ]
  }, {
    "tStartMs": 2738550,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "이 주문이 세계에서"
    } ]
  }, {
    "tStartMs": 2740270,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "가장 유명한 주문이 됐어요"
    } ]
  }, {
    "tStartMs": 2742010,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "거의 구음진경이 된 거야"
    } ]
  }, {
    "tStartMs": 2743660,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "구음진경이"
    } ]
  }, {
    "tStartMs": 2744800,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "이거에 당한 피해자들이"
    } ]
  }, {
    "tStartMs": 2746720,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "전 세계에 제가 보기에"
    } ]
  }, {
    "tStartMs": 2747760,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "3천만 명은 된다 이거"
    } ]
  }, {
    "tStartMs": 2749330,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "이거 당해본 사람이"
    } ]
  }, {
    "tStartMs": 2750810,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "이게 그렇게 됩니다"
    } ]
  }, {
    "tStartMs": 2752310,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "왜냐하면 올라갈 때 못 산 사람들"
    } ]
  }, {
    "tStartMs": 2754980,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "한 번 들어가고요"
    } ]
  }, {
    "tStartMs": 2756180,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "내려갈 때 팔았다가"
    } ]
  }, {
    "tStartMs": 2757630,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "올라가니까"
    } ]
  }, {
    "tStartMs": 2758310,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "내가 잘못했다 하고"
    } ]
  }, {
    "tStartMs": 2759280,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "따라가서 잡은 사람들이 다시 빠지죠"
    } ]
  }, {
    "tStartMs": 2761920,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "수많은 피해자를 양산한"
    } ]
  }, {
    "tStartMs": 2764260,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "정말 몹쓸"
    } ]
  }, {
    "tStartMs": 2766040,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "거의 뭐 흑사병에 준하는"
    } ]
  }, {
    "tStartMs": 2768240,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "그런 아주 몹쓸 주문이 아닐까"
    } ]
  }, {
    "tStartMs": 2770630,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "금지시켜야 된다"
    } ]
  }, {
    "tStartMs": 2771630,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "개인적으로"
    } ]
  }, {
    "tStartMs": 2772510,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "개인적으로"
    } ]
  }, {
    "tStartMs": 2773170,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "요 3 패턴을 보일 때"
    } ]
  }, {
    "tStartMs": 2774640,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "시장을 멈추고"
    } ]
  }, {
    "tStartMs": 2775990,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "이놈들을 모두 떼로 잡고"
    } ]
  }, {
    "tStartMs": 2777110,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "어?"
    } ]
  }, {
    "tStartMs": 2777980,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "쭉 올려야지 말이야"
    } ]
  }, {
    "tStartMs": 2779220,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "그걸 내려갖고"
    } ]
  }, {
    "tStartMs": 2780490,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "아주 몹쓸 놈의"
    } ]
  }, {
    "tStartMs": 2782100,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "패턴이지 않나 생각이 되고요"
    } ]
  }, {
    "tStartMs": 2784330,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "그리고 제가 그림을"
    } ]
  }, {
    "tStartMs": 2785110,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "이렇게 그려서 그렇지"
    } ]
  }, {
    "tStartMs": 2786710,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "예쁘게 그리면 이렇게 돼요"
    } ]
  }, {
    "tStartMs": 2787860,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "왜냐면 아까 고점 얘기했잖아요"
    } ]
  }, {
    "tStartMs": 2789270,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "여기 전 저점을 보는 분도 있어요"
    } ]
  }, {
    "tStartMs": 2791190,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "내려와서 요렇게"
    } ]
  }, {
    "tStartMs": 2792040,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "여기서 버티겠지"
    } ]
  }, {
    "tStartMs": 2793150,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "올라가네 페이크네 쭉 빠지네?"
    } ]
  }, {
    "tStartMs": 2796220,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "그래서 여러분들이 뭐 주술책"
    } ]
  }, {
    "tStartMs": 2797990,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "마법서를 읽다 보면은"
    } ]
  }, {
    "tStartMs": 2799260,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "여기를 뭐 넥 클래스 라인이네"
    } ]
  }, {
    "tStartMs": 2800870,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "뭐 이런 소리를 써요"
    } ]
  }, {
    "tStartMs": 2801770,
    "dDurationMs": 670,
    "segs": [ {
      "utf8": "근데 그걸 외우는 게"
    } ]
  }, {
    "tStartMs": 2802440,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "아무 소용이 없어요"
    } ]
  }, {
    "tStartMs": 2803270,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "외울 필요가 없어"
    } ]
  }, {
    "tStartMs": 2804310,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "무슨 넥라인이네 어깨라인이네"
    } ]
  }, {
    "tStartMs": 2805840,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "그런 거 알 필요 없어요"
    } ]
  }, {
    "tStartMs": 2807100,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "근데 왜 알아야 되냐?"
    } ]
  }, {
    "tStartMs": 2808440,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "알 필요 없지만 알아야 되는 게 웃긴데"
    } ]
  }, {
    "tStartMs": 2810160,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "이름이 중요한 게 아니라"
    } ]
  }, {
    "tStartMs": 2811390,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "사람들이 여기를 보잖아"
    } ]
  }, {
    "tStartMs": 2812840,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "거기 주술처럼 들어갔다가"
    } ]
  }, {
    "tStartMs": 2814280,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "주술처럼 깨져서 그래"
    } ]
  }, {
    "tStartMs": 2816000,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "해보시면 압니다, 해보시면"
    } ]
  }, {
    "tStartMs": 2817830,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "그래서 오른쪽 여기,"
    } ]
  }, {
    "tStartMs": 2819550,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "여기 올 것 같으면"
    } ]
  }, {
    "tStartMs": 2821030,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "다 같이 주문을 외우고"
    } ]
  }, {
    "tStartMs": 2822240,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "잘 피해가기를, 잘 피해가기를"
    } ]
  }, {
    "tStartMs": 2824450,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "또 악랄한 게 그렇다고"
    } ]
  }, {
    "tStartMs": 2825450,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "아 슈카형이 그랬으니까"
    } ]
  }, {
    "tStartMs": 2826720,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "이게 빠지는구나"
    } ]
  }, {
    "tStartMs": 2827730,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "난 헤드 앤 숄더를 피해야지"
    } ]
  }, {
    "tStartMs": 2829180,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "그러면 놀랍게도 시장이 이렇게 갑니다"
    } ]
  }, {
    "tStartMs": 2832400,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "그게 무슨 말입니까?"
    } ]
  }, {
    "tStartMs": 2833570,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "시장은 아무 일 없이 이렇게 갔는데"
    } ]
  }, {
    "tStartMs": 2836960,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "나 혼자 텅 빈 곳에"
    } ]
  }, {
    "tStartMs": 2838940,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "선 긋고 온갖 오만"
    } ]
  }, {
    "tStartMs": 2841120,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "짓이라고 표현할게요"
    } ]
  }, {
    "tStartMs": 2842200,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "오만 짓을 다 하더니"
    } ]
  }, {
    "tStartMs": 2843460,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "이렇게 간다고 혼자 쇼한 거잖아요"
    } ]
  }, {
    "tStartMs": 2845530,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "하지만 시장은 아무 일도 없었어"
    } ]
  }, {
    "tStartMs": 2847330,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "나 혼자 주문을 외우고"
    } ]
  }, {
    "tStartMs": 2849050,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "혼자 뭐 이게 뭐 아브라카타브라라는 둥"
    } ]
  }, {
    "tStartMs": 2851070,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "무슨 뭐 그쵸?"
    } ]
  }, {
    "tStartMs": 2852420,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "헤드 앤 숄더라는 둥 온갖 소리를 다 했지만"
    } ]
  }, {
    "tStartMs": 2854940,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "시장은... 뭐?"
    } ]
  }, {
    "tStartMs": 2856360,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "...뭔데?"
    } ]
  }, {
    "tStartMs": 2857590,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "그냥 올라가는 건데"
    } ]
  }, {
    "tStartMs": 2858290,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "뭐 왜 너 혼자 거기서"
    } ]
  }, {
    "tStartMs": 2859260,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "사고 팔고 난리를 치더니"
    } ]
  }, {
    "tStartMs": 2860680,
    "dDurationMs": 590,
    "segs": [ {
      "utf8": "혼자 빠지고"
    } ]
  }, {
    "tStartMs": 2861270,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "포지션 없냐? 없냐?"
    } ]
  }, {
    "tStartMs": 2863110,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "아니 너 롱이라며"
    } ]
  }, {
    "tStartMs": 2864010,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "포지션 없어?"
    } ]
  }, {
    "tStartMs": 2865230,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "너 뭐 먹냐 그러면?"
    } ]
  }, {
    "tStartMs": 2866350,
    "dDurationMs": 540,
    "segs": [ {
      "utf8": "쭉 가죠"
    } ]
  }, {
    "tStartMs": 2866890,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "그러면 이제"
    } ]
  }, {
    "tStartMs": 2867950,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "죄송합니다 죄송합니다"
    } ]
  }, {
    "tStartMs": 2869460,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "아니 회의 때는"
    } ]
  }, {
    "tStartMs": 2870260,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "맨날 롱 잡는다는 놈이야"
    } ]
  }, {
    "tStartMs": 2871270,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "아니, 아니 차트를 봐"
    } ]
  }, {
    "tStartMs": 2872640,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "차트를 네가 도대체"
    } ]
  }, {
    "tStartMs": 2874150,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "손절할 라인이 없는데"
    } ]
  }, {
    "tStartMs": 2875400,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "어디서 판 거야?"
    } ]
  }, {
    "tStartMs": 2876860,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "아니 이렇게 가는 차트에서"
    } ]
  }, {
    "tStartMs": 2877920,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "네가 어떻게 팔 수..."
    } ]
  }, {
    "tStartMs": 2879210,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "이거 못 버틴 거야 이거?"
    } ]
  }, {
    "tStartMs": 2880270,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "이거?"
    } ]
  }, {
    "tStartMs": 2881090,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "아니야 먹은 게"
    } ]
  }, {
    "tStartMs": 2882060,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "이게 올라간 게 70%인데"
    } ]
  }, {
    "tStartMs": 2883420,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "이거 10% 밀렸다고 던지는 놈이"
    } ]
  }, {
    "tStartMs": 2885260,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "세상에 어딨어"
    } ]
  }, {
    "tStartMs": 2887220,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "그러고 보면 그래요"
    } ]
  }, {
    "tStartMs": 2888520,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "나 혼자 여기서 뭐 이거 긋고"
    } ]
  }, {
    "tStartMs": 2889880,
    "dDurationMs": 480,
    "segs": [ {
      "utf8": "저거 긋고"
    } ]
  }, {
    "tStartMs": 2890360,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "이거 긋고 하면서"
    } ]
  }, {
    "tStartMs": 2891190,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "빠진다고 주문외웠는데"
    } ]
  }, {
    "tStartMs": 2892460,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "안 내려가고 이러고 간 거죠"
    } ]
  }, {
    "tStartMs": 2893730,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "그래서 이 차트가 악랄해"
    } ]
  }, {
    "tStartMs": 2896220,
    "dDurationMs": 390,
    "segs": [ {
      "utf8": "악랄해"
    } ]
  }, {
    "tStartMs": 2896610,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "마치 아무 일도 없었다는 듯이"
    } ]
  }, {
    "tStartMs": 2899040,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "하지만 우린 알고 있죠"
    } ]
  }, {
    "tStartMs": 2900840,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "아무 일도 없는 게 아니야"
    } ]
  }, {
    "tStartMs": 2902340,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "이 악랄한 놈의"
    } ]
  }, {
    "tStartMs": 2904430,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "뭔가 있었어, 요거"
    } ]
  }, {
    "tStartMs": 2906340,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "그래서 이게 이렇게 되면은"
    } ]
  }, {
    "tStartMs": 2909430,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "헤드 앤 숄더인 거고"
    } ]
  }, {
    "tStartMs": 2911130,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "그냥 아무 일도 없이 가면은"
    } ]
  }, {
    "tStartMs": 2912500,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "나 혼자 쇼한 겁니다"
    } ]
  }, {
    "tStartMs": 2914560,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "헤드 앤 쇼야"
    } ]
  }, {
    "tStartMs": 2915720,
    "dDurationMs": 630,
    "segs": [ {
      "utf8": "나 혼자 쇼하고"
    } ]
  }, {
    "tStartMs": 2916350,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "나 혼자 포지션 놓고"
    } ]
  }, {
    "tStartMs": 2917090,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "나 혼자 던졌지"
    } ]
  }, {
    "tStartMs": 2918070,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "시장은 그냥 갔는데"
    } ]
  }, {
    "tStartMs": 2920630,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "하여튼 그렇습니다"
    } ]
  }, {
    "tStartMs": 2922310,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "그래서 이게 이 주술이라는 게"
    } ]
  }, {
    "tStartMs": 2924930,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "알면 그렇듯한데"
    } ]
  }, {
    "tStartMs": 2926510,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "시장이 그냥 무시하고 가면은"
    } ]
  }, {
    "tStartMs": 2928160,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "나 혼자 뭐 뒤에서"
    } ]
  }, {
    "tStartMs": 2929680,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "뭐 북치고 장구치고 한"
    } ]
  }, {
    "tStartMs": 2930880,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "그런 게 됩니다"
    } ]
  }, {
    "tStartMs": 2932640,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "그냥 참고로만 이런 심리가 있다라는 것을"
    } ]
  }, {
    "tStartMs": 2935380,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "참고로만 알아두시고"
    } ]
  }, {
    "tStartMs": 2936540,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "결론적으로는 최고점에서"
    } ]
  }, {
    "tStartMs": 2937860,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "매도할 수 있는 사람은"
    } ]
  }, {
    "tStartMs": 2938830,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "굉장히 없다"
    } ]
  }, {
    "tStartMs": 2940070,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "우리는 보통 1을 여기다 그렸는데"
    } ]
  }, {
    "tStartMs": 2942100,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "여기입니다"
    } ]
  }, {
    "tStartMs": 2943010,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "여기서 많이 내리고"
    } ]
  }, {
    "tStartMs": 2944120,
    "dDurationMs": 650,
    "segs": [ {
      "utf8": "잘하는 분들이"
    } ]
  }, {
    "tStartMs": 2944770,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "여기서 좀 많이 내리고"
    } ]
  }, {
    "tStartMs": 2946430,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "여기서 내리는 분들이 제일 고수입니다"
    } ]
  }, {
    "tStartMs": 2948700,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "아까 얘기했지만"
    } ]
  }, {
    "tStartMs": 2949690,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "이딴 거 긋다 보면 이렇게 가거나"
    } ]
  }, {
    "tStartMs": 2951200,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "이런 게 있죠"
    } ]
  }, {
    "tStartMs": 2952640,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "2에서 내릴 수 있는 분들은"
    } ]
  }, {
    "tStartMs": 2954080,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "운짱이거나"
    } ]
  }, {
    "tStartMs": 2955790,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "아니면 신이다,  신이다"
    } ]
  }, {
    "tStartMs": 2957510,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "이렇게 생각하시면 되고"
    } ]
  }, {
    "tStartMs": 2958710,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "4는 이제 우리가 믿음 매매로 가는 거예요"
    } ]
  }, {
    "tStartMs": 2960060,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "여기서부터는 기도입니다"
    } ]
  }, {
    "tStartMs": 2963650,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "여기서부터는 신실한 자들의 영역이에요"
    } ]
  }, {
    "tStartMs": 2966270,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "농담이 아니라"
    } ]
  }, {
    "tStartMs": 2967130,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "여기서부터는"
    } ]
  }, {
    "tStartMs": 2967850,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "신앙심이 필요한 영역이에요"
    } ]
  }, {
    "tStartMs": 2970010,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "아니면 HTS를 삭제하고"
    } ]
  }, {
    "tStartMs": 2971840,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "보지 않는 단계"
    } ]
  }, {
    "tStartMs": 2973600,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "내가 그게 있었나?"
    } ]
  }, {
    "tStartMs": 2974620,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "이런 생각을 하는 단계인데"
    } ]
  }, {
    "tStartMs": 2975990,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "믿음을 좀 굳건히 하시고"
    } ]
  }, {
    "tStartMs": 2977850,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "몸과 마음을 수련하시는 단계이기 때문에"
    } ]
  }, {
    "tStartMs": 2979750,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "그 전에 트레이더가 되려면"
    } ]
  }, {
    "tStartMs": 2981170,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "여기를 봐야 됩니다"
    } ]
  }, {
    "tStartMs": 2982670,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "여기까지 가면 트레이더는 접어야 돼요"
    } ]
  }, {
    "tStartMs": 2984560,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "트레이더는 접어야 돼요"
    } ]
  }, {
    "tStartMs": 2985640,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "트레이더 하면 안 되지"
    } ]
  }, {
    "tStartMs": 2986710,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "솔직히 약간 그런 게"
    } ]
  }, {
    "tStartMs": 2988010,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "믿음"
    } ]
  }, {
    "tStartMs": 2988700,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "신자 이렇게 되고"
    } ]
  }, {
    "tStartMs": 2990430,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "그래서 코스피를 보면"
    } ]
  }, {
    "tStartMs": 2992030,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "아직은 뭐 누가 보더라도"
    } ]
  }, {
    "tStartMs": 2993380,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "폭발적인 상승 구간에 있죠"
    } ]
  }, {
    "tStartMs": 2996190,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "개인적으로는"
    } ]
  }, {
    "tStartMs": 2997590,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "요즘에 1이 손에 안 잡힌다 라고 하는 분들이 많아서"
    } ]
  }, {
    "tStartMs": 3000010,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "저걸 지금 보여드린 건데"
    } ]
  }, {
    "tStartMs": 3001280,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "여유롭게 뭐 아직은 뭐"
    } ]
  }, {
    "tStartMs": 3002750,
    "dDurationMs": 520,
    "segs": [ {
      "utf8": "좋잖아요"
    } ]
  }, {
    "tStartMs": 3003270,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "아직은 특별히 밀린 것도 없고"
    } ]
  }, {
    "tStartMs": 3004850,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "5 영업일 밖에 밀린 적이 없대요"
    } ]
  }, {
    "tStartMs": 3006570,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "쭉쭉 올라가니까"
    } ]
  }, {
    "tStartMs": 3007350,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "여유롭게 뭐 여기가 고점일지"
    } ]
  }, {
    "tStartMs": 3009470,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "여기가 고점일지 모르는 거죠"
    } ]
  }, {
    "tStartMs": 3010720,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "여기가 고점일지"
    } ]
  }, {
    "tStartMs": 3011630,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "물론 지금이 고점일 수도 있죠"
    } ]
  }, {
    "tStartMs": 3012880,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "그럼 뭐 또 이렇게 모습 보일 거 아니에요"
    } ]
  }, {
    "tStartMs": 3014820,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "그러면 그때 대응하시면 되지 않을까 생각하고"
    } ]
  }, {
    "tStartMs": 3017790,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "여유롭게 여러분들이 하실 일이 있다면"
    } ]
  }, {
    "tStartMs": 3019690,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "주식 때문에 일이 손에 안 잡힌다"
    } ]
  }, {
    "tStartMs": 3021270,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "이런 분들도 있는데"
    } ]
  }, {
    "tStartMs": 3022300,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "이렇게 하시다가"
    } ]
  }, {
    "tStartMs": 3023590,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "물론 어느 순간 되면"
    } ]
  }, {
    "tStartMs": 3024910,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "여유롭게 안 되실 때가 있을 겁니다"
    } ]
  }, {
    "tStartMs": 3027200,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "그때 이제 좀 좋은 판단을 하시기를"
    } ]
  }, {
    "tStartMs": 3029870,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "한번 기원해 보겠습니다"
    } ]
  }, {
    "tStartMs": 3032140,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "아, 좋습니다"
    } ]
  }, {
    "tStartMs": 3033950,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "갑자기 또 헤드 앤 숄더가 생각이 나서"
    } ]
  }, {
    "tStartMs": 3036070,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "제가 저렇게 열변을 토하는 거는"
    } ]
  }, {
    "tStartMs": 3037650,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "여러 번 당했기 때문이거든요"
    } ]
  }, {
    "tStartMs": 3040160,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "피해자들은 안다"
    } ]
  }, {
    "tStartMs": 3041420,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "피해자들은"
    } ]
  }, {
    "tStartMs": 3042110,
    "dDurationMs": 480,
    "segs": [ {
      "utf8": "그쵸?"
    } ]
  }, {
    "tStartMs": 3042590,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "페이크 한 번 당하면은"
    } ]
  }, {
    "tStartMs": 3044990,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "키보드 부서집니다"
    } ]
  }, {
    "tStartMs": 3046150,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "키보드 부서져"
    } ]
  }, {
    "tStartMs": 3047530,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "화가 많이 나는데"
    } ]
  }, {
    "tStartMs": 3048730,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "그 수양이 필요해요, 수양이"
    } ]
  }, {
    "tStartMs": 3050060,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "뭐 갬블러도 그렇고"
    } ]
  }, {
    "tStartMs": 3051040,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "트레이더도 그렇고"
    } ]
  }, {
    "tStartMs": 3052150,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "마음 수양이 제일 중요하죠"
    } ]
  } ]
}

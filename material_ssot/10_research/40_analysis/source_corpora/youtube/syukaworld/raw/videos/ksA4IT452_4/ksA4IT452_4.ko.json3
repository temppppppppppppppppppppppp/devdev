  }, {
    "tStartMs": 1402280,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "하이닉스를 안 들고 계신 분이다"
    } ]
  }, {
    "tStartMs": 1404170,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "이렇게 보시면 됩니다"
    } ]
  }, {
    "tStartMs": 1405190,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "숏돌이니까"
    } ]
  }, {
    "tStartMs": 1406110,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "역시 연초 이후 상승률은 40%고요"
    } ]
  }, {
    "tStartMs": 1408010,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "최근 1년 상승률은 362%입니다"
    } ]
  }, {
    "tStartMs": 1411810,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "명짤 있죠?"
    } ]
  }, {
    "tStartMs": 1414510,
    "dDurationMs": 670,
    "segs": [ {
      "utf8": "제가 이 짤 보고"
    } ]
  }, {
    "tStartMs": 1415180,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "진짜 한참 웃었는데"
    } ]
  }, {
    "tStartMs": 1416830,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "삼성전자 사야 됩니까?"
    } ]
  }, {
    "tStartMs": 1417960,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "말아야 됩니까?"
    } ]
  }, {
    "tStartMs": 1419620,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "삼성전자 사야 돼요? 말아야 돼요?"
    } ]
  }, {
    "tStartMs": 1421410,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "명짤 있습니다"
    } ]
  }, {
    "tStartMs": 1422750,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "이렇게 얘기하더라고요"
    } ]
  }, {
    "tStartMs": 1423590,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "이거 보고 한참 웃었는데"
    } ]
  }, {
    "tStartMs": 1426300,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "그거 질문할 시간에"
    } ]
  }, {
    "tStartMs": 1427640,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "설명할 시간이 없죠"
    } ]
  }, {
    "tStartMs": 1428600,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "일단 타고 질문하는 게..."
    } ]
  }, {
    "tStartMs": 1430500,
    "dDurationMs": 470,
    "segs": [ {
      "utf8": "맞았다"
    } ]
  }, {
    "tStartMs": 1430970,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "지금까지는"
    } ]
  }, {
    "tStartMs": 1431580,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "맞다는 아니고요"
    } ]
  }, {
    "tStartMs": 1432380,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "이렇게 하시면 안 되지만"
    } ]
  }, {
    "tStartMs": 1433950,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "요즘엔 그랬다"
    } ]
  }, {
    "tStartMs": 1435130,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "설명할 시간이 없어"
    } ]
  }, {
    "tStartMs": 1436230,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "지금 그거 설명하면 오르고 있잖아"

  }, {
    "tStartMs": 1480490,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "모든 건 사이클이니까"
    } ]
  }, {
    "tStartMs": 1481730,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "설명할 시간이 없을 수도 있습니다"

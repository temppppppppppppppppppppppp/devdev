  }, {
    "tStartMs": 1389420,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "이거 5%니까"
    } ]
  }, {
    "tStartMs": 1390040,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "5만원이니까"
    } ]
  }, {
    "tStartMs": 1391190,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "5%면 100만닉스잖아"
    } ]
  }, {
    "tStartMs": 1392810,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "목표가 100만닉스라면"

  }, {
    "tStartMs": 1438810,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "성과급 늦게 줬다고"
    } ]
  }, {
    "tStartMs": 1439710,
    "dDurationMs": 410,
    "segs": [ {
      "utf8": "지금 뭐?"
    } ]
  }, {
    "tStartMs": 1440120,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "한 달에 30%가 날아갔다는데?"
    } ]
  }, {
    "tStartMs": 1441590,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "어서 타!"

  "events": [ {
    "tStartMs": 8000,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "자, 오늘의 마지막 주제 코스피입니다"
    } ]
  }, {
    "tStartMs": 10210,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "왜냐하면 이제 슬슬 좋아야"
    } ]
  }, {
    "tStartMs": 12250,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "슬슬"
    } ]
  }, {
    "tStartMs": 13500,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "어, 내 이제 무습다"
    } ]
  }, {
    "tStartMs": 15310,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "자 코스피가 이제 올라와서 좋아"
    } ]
  }, {
    "tStartMs": 17670,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "너무 좋아, 너무 좋은데"
    } ]
  }, {
    "tStartMs": 19090,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "쭉쭉 더 올라가기를 기대합니다"
    } ]
  }, {
    "tStartMs": 21880,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "기원하고 그러는데"
    } ]
  }, {
    "tStartMs": 22910,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "야 살짝"
    } ]
  }, {
    "tStartMs": 25010,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "살짝살짝"
    } ]
  }, {
    "tStartMs": 25810,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "야, 좀 놀이공원 높은 거 올라가면"
    } ]
  }, {
    "tStartMs": 28220,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "스릴 있잖아요?"
    } ]
  }, {
    "tStartMs": 29290,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "스릴이 좀 느껴지겠네요"
    } ]
  }, {
    "tStartMs": 30910,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "계속 올라가니까"
    } ]
  }, {
    "tStartMs": 31950,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "한 번도 못 올라와본"
    } ]
  }, {
    "tStartMs": 33780,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "고산지대의 공기를 마시니까 좋아"
    } ]
  }, {
    "tStartMs": 35970,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "좋긴 한데"
    } ]
  }, {
    "tStartMs": 38370,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "새로운 느낌이 들죠"
    } ]
  }, {
    "tStartMs": 39670,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "그 얘기를 한번 해보도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 40990,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "왜냐하면 코스피가 5,800을 넘겼거든요"
    } ]
  }, {
    "tStartMs": 44550,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "놀랍게도 5,700이 붕괴되고"
    } ]
  }, {
    "tStartMs": 47040,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "5,800을 넘겼습니다"
    } ]
  }, {
    "tStartMs": 48510,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "아마 5,800이 붕괴되면서"
    } ]
  }, {
    "tStartMs": 50350,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "5,900을 넘기지 않을까"
    } ]
  }, {
    "tStartMs": 52030,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "개인적으로 생각하는데"
    } ]
  }, {
    "tStartMs": 53410,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "연초 이후로 우리가 얼마를 올렸냐"
    } ]
  }, {
    "tStartMs": 56000,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "이건 작년 초고요 아닌가?"
    } ]
  }, {
    "tStartMs": 58800,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "여기가 작년 초구나"
    } ]
  }, {
    "tStartMs": 60450,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "잠깐만 잠깐만"
    } ]
  }, {
    "tStartMs": 61660,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "이게 작년 초가 아니구나"
    } ]
  }, {
    "tStartMs": 63480,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "죄송합니다"
    } ]
  }, {
    "tStartMs": 64650,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "이게 너무 적응이 안 돼"
    } ]
  }, {
    "tStartMs": 65560,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "여기가 1월이군요"
    } ]
  }, {
    "tStartMs": 67010,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "여기가 2월"
    } ]
  }, {
    "tStartMs": 68030,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "이게 적응이 안 된다"
    } ]
  }, {
    "tStartMs": 69340,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "이게 2025년, 2024년"
    } ]
  }, {
    "tStartMs": 72090,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "그런 줄 알았는데 아닙니다"
    } ]
  }, {
    "tStartMs": 73190,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "여기가 2월입니다, 2월"
    } ]
  }, {
    "tStartMs": 74750,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "연초에 4,300이었어요, 맞습니까?"
    } ]
  }, {
    "tStartMs": 77700,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "너무 급하게 오르니까"
    } ]
  }, {
    "tStartMs": 78740,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "기억력에 오류가 있어"
    } ]
  }, {
    "tStartMs": 80510,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "와, 4,300에서"
    } ]
  }, {
    "tStartMs": 82780,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "지금 2월이 안 끝났는데"
    } ]
  }, {
    "tStartMs": 84090,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "5,800이 됐다는 거죠?"
    } ]
  }, {
    "tStartMs": 86530,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "1,500포인트"
    } ]
  }, {
    "tStartMs": 88190,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "6,000까지 200포인트 남았습니다"
    } ]
  }, {
    "tStartMs": 90700,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "이 정도면 사실상 갔다"
    } ]
  }, {
    "tStartMs": 92930,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "3.5%야, 3.5%"
    } ]
  }, {
    "tStartMs": 95770,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "3% 오르면 가 그럼 왔지 이건"
    } ]
  }, {
    "tStartMs": 97680,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "사실상 6,000은 찍었다"
    } ]
  }, {
    "tStartMs": 99500,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "와 이게 엄청났다고 할 수 있고"
    } ]
  }, {
    "tStartMs": 102000,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "지금 두 달이 안 지났잖아요"
    } ]
  }, {
    "tStartMs": 103010,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "2월이 안 지났으니까"
    } ]
  }, {
    "tStartMs": 103670,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "두 달이 안 지났는데"
    } ]
  }, {
    "tStartMs": 104800,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "연초 이후 코스피 상승률은 35%입니다"
    } ]
  }, {
    "tStartMs": 107660,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "상한가, 이미 상한가에요"
    } ]
  }, {
    "tStartMs": 110510,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "여러분들의 주식이 상한가를 못 맞으면"
    } ]
  }, {
    "tStartMs": 112570,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "코스피보다 못 버는 겁니다"
    } ]
  }, {
    "tStartMs": 114270,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "코스피보다 못 버는 거예요"
    } ]
  }, {
    "tStartMs": 116240,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "평균가를 못 했다"
    } ]
  }, {
    "tStartMs": 118080,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "상한가 안 맞으면"
    } ]
  }, {
    "tStartMs": 118960,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "평균보다 못 한 겁니다"
    } ]
  }, {
    "tStartMs": 120420,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "만약 지금 2월이 안 지났잖아요"
    } ]
  }, {
    "tStartMs": 122320,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "2월이라고 치고"
    } ]
  }, {
    "tStartMs": 123250,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "이대로 연말까지 간다"
    } ]
  }, {
    "tStartMs": 124510,
    "dDurationMs": 650,
    "segs": [ {
      "utf8": "이 각도로"
    } ]
  }, {
    "tStartMs": 125160,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "그러면 올해 250% 오르는 겁니다"
    } ]
  }, {
    "tStartMs": 128980,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "솔직히 그건 어렵다고 생각하는데"
    } ]
  }, {
    "tStartMs": 131400,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "이게 지금 2월이잖아요"
    } ]
  }, {
    "tStartMs": 132310,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "이 각도로 쭉 12월까지 간다"
    } ]
  }, {
    "tStartMs": 136290,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "그러면 250%입니다"
    } ]
  }, {
    "tStartMs": 137080,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "250%"
    } ]
  }, {
    "tStartMs": 137720,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "250%가 얼마냐?"
    } ]
  }, {
    "tStartMs": 138890,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "4천에서 250%면"
    } ]
  }, {
    "tStartMs": 140260,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "야, 계산도 안 돼"
    } ]
  }, {
    "tStartMs": 141510,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "이 각대로 쭉 가면"
    } ]
  }, {
    "tStartMs": 142450,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "만 가는 거야, 만"
    } ]
  }, {
    "tStartMs": 143430,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "그래, 만이네   만"
    } ]
  }, {
    "tStartMs": 144540,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "4천에서 250%니까"
    } ]
  }, {
    "tStartMs": 146060,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "이 각도로 쭉 가서 만을 가기를"
    } ]
  }, {
    "tStartMs": 148240,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "아, 좋습니다"
    } ]
  }, {
    "tStartMs": 149440,
    "dDurationMs": 670,
    "segs": [ {
      "utf8": "아, 좋다"
    } ]
  }, {
    "tStartMs": 150110,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "딱 떨어지네"
    } ]
  }, {
    "tStartMs": 151490,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "4천에 250%"
    } ]
  }, {
    "tStartMs": 152870,
    "dDurationMs": 590,
    "segs": [ {
      "utf8": "4*2 = 8"
    } ]
  }, {
    "tStartMs": 153460,
    "dDurationMs": 540,
    "segs": [ {
      "utf8": "4*5=20,"
    } ]
  }, {
    "tStartMs": 154000,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "만이구만"
    } ]
  }, {
    "tStartMs": 155450,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "오른 게 만이니까"
    } ]
  }, {
    "tStartMs": 157340,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "오른 게 만이니까"
    } ]
  }, {
    "tStartMs": 158520,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "4천 더 해야 되네"
    } ]
  }, {
    "tStartMs": 159570,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "1만 4천이네"
    } ]
  }, {
    "tStartMs": 160770,
    "dDurationMs": 630,
    "segs": [ {
      "utf8": "양보하자"
    } ]
  }, {
    "tStartMs": 161400,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "1만 정도로 만족하겠습니다"
    } ]
  }, {
    "tStartMs": 162940,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "1만 정도로 양보해야지"
    } ]
  }, {
    "tStartMs": 164220,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "사람이 욕심을 부리면 안 돼요"
    } ]
  }, {
    "tStartMs": 165700,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "겸손해야지"
    } ]
  }, {
    "tStartMs": 167220,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "1만 정도로 양보하고"
    } ]
  }, {
    "tStartMs": 168580,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "1만 좋습니다,  1만"
    } ]
  }, {
    "tStartMs": 170200,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "이대로 쭉 가면"
    } ]
  }, {
    "tStartMs": 171040,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "아마 1만 정도가 되지 않을까 생각하고"
    } ]
  }, {
    "tStartMs": 172870,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "최근 1년 코스피 상승률이 119%예요"
    } ]
  }, {
    "tStartMs": 175680,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "119%"
    } ]
  }, {
    "tStartMs": 176990,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "최근 1년간 자기 투자 자산이"
    } ]
  }, {
    "tStartMs": 179640,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "더블이 안 되신 분들은"
    } ]
  }, {
    "tStartMs": 181200,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "코스피 평균보다 조금 못했다라고 보시면 되고요"
    } ]
  }, {
    "tStartMs": 185180,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "그리고 제가 정말 놀랐던 게"
    } ]
  }, {
    "tStartMs": 187140,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "연초 이후 코스피 차트를 잘 보면"
    } ]
  }, {
    "tStartMs": 188850,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "무슨 생각이 드십니까?"
    } ]
  }, {
    "tStartMs": 190400,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "제가 이 파란 걸로 찍어온 점이"
    } ]
  }, {
    "tStartMs": 191900,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "무슨 점이냐면"
    } ]
  }, {
    "tStartMs": 193150,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "종가가 마이너스인 날이에요"
    } ]
  }, {
    "tStartMs": 195110,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "단 5일 있었습니다, 5일"
    } ]
  }, {
    "tStartMs": 197280,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "영업일이 33 영업일이었어"
    } ]
  }, {
    "tStartMs": 199140,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "제가 손으로 세어봤습니다"
    } ]
  }, {
    "tStartMs": 200420,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "33영업일 중에 28일이 플러스예요"
    } ]
  }, {
    "tStartMs": 203470,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "단 5일만 했어요, 5일"
    } ]
  }, {
    "tStartMs": 205060,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "5일도"
    } ]
  }, {
    "tStartMs": 206060,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "이런 날은 정말 소폭만 했어요 소폭"
    } ]
  }, {
    "tStartMs": 208700,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "그걸 빼고 어느 정도"
    } ]
  }, {
    "tStartMs": 210030,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "느낌 있게 빠진 게 3일이에요"
    } ]
  }, {
    "tStartMs": 212190,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "나머지는 다 올랐어"
    } ]
  }, {
    "tStartMs": 212880,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "나머지는 다 올랐어"
    } ]
  }, {
    "tStartMs": 214750,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "쫙"
    } ]
  }, {
    "tStartMs": 215360,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "거의 뭐 90%의 확률로"
    } ]
  }, {
    "tStartMs": 217150,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "올랐다고 보시면 됩니다"
    } ]
  }, {
    "tStartMs": 218620,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "그래서 이 말이 진짜 과장이 아니에요"
    } ]
  }, {
    "tStartMs": 220510,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "오늘도 코스피는 올랐나요?"
    } ]
  }, {
    "tStartMs": 223780,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "뭐 당연히 오른 거 아니겠습니까?"
    } ]
  }, {
    "tStartMs": 225540,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "뭐 당연한 겁니다"
    } ]
  }, {
    "tStartMs": 227040,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "코스피 오른 얘기 하지 마요"
    } ]
  }, {
    "tStartMs": 228420,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "뭐 당연한 걸"
    } ]
  }, {
    "tStartMs": 229540,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "90% 확률인데"
    } ]
  }, {
    "tStartMs": 231930,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "코스피가 안 올랐습니까?"
    } ]
  }, {
    "tStartMs": 233370,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "이 말은"
    } ]
  }, {
    "tStartMs": 234480,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "오늘 우박이 왔나요?"
    } ]
  }, {
    "tStartMs": 236340,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "지금 이정도 얘기를 해야 되는 거예요"
    } ]
  }, {
    "tStartMs": 237630,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "아, 코스피가 안 올랐구나"
    } ]
  }, {
    "tStartMs": 239330,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "우박이 왔나?"
    } ]
  }, {
    "tStartMs": 240490,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "천둥, 번개가"
    } ]
  }, {
    "tStartMs": 241790,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "뭐 그 정도 되는 사건이지 않았나"
    } ]
  }, {
    "tStartMs": 244040,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "생각을 합니다"
    } ]
  }, {
    "tStartMs": 245150,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "그래서 쭉 올라왔다는 거고요"
    } ]
  }, {
    "tStartMs": 247720,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "미국, 일본, 대만, 중국"
    } ]
  }, {
    "tStartMs": 252430,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "그래요"
    } ]
  }, {
    "tStartMs": 253040,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "연초 이후로 나스닥이"
    } ]
  }, {
    "tStartMs": 254690,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "어머 빠졌네"
    } ]
  }, {
    "tStartMs": 256990,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "어머"
    } ]
  }, {
    "tStartMs": 258750,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "잘못된 거 아닌가?"
    } ]
  }, {
    "tStartMs": 259780,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "어떻게 빠졌네"
    } ]
  }, {
    "tStartMs": 262660,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "그래요, 좋은 날이 있겠죠"
    } ]
  }, {
    "tStartMs": 264510,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "좋은 날이 있을 텐데"
    } ]
  }, {
    "tStartMs": 265730,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "좀 힘내야 되지 않나 생각하고"
    } ]
  }, {
    "tStartMs": 267550,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "코스피가 35%고요"
    } ]
  }, {
    "tStartMs": 269400,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "나머지 일본, 대만 아래"
    } ]
  }, {
    "tStartMs": 271400,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "중국, 중국 보합이네"
    } ]
  }, {
    "tStartMs": 275390,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "홍콩H지수, 0.28%"
    } ]
  }, {
    "tStartMs": 277360,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "괜찮아요"
    } ]
  }, {
    "tStartMs": 278760,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "좋은 날이 있겠죠, 괜찮아요"
    } ]
  }, {
    "tStartMs": 280380,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "이대로 쭉 가면 한 3%는 되겠네"
    } ]
  }, {
    "tStartMs": 282800,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "괜찮습니다"
    } ]
  }, {
    "tStartMs": 284030,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "코스피는 34%고요"
    } ]
  }, {
    "tStartMs": 286270,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "그 정도 올랐다고 할 수 있고"
    } ]
  }, {
    "tStartMs": 288030,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "최근 1년으로 보면"
    } ]
  }, {
    "tStartMs": 289880,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "코스피가 119%"
    } ]
  }, {
    "tStartMs": 291660,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "나스닥이 17%"
    } ]
  }, {
    "tStartMs": 293820,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "1년 수익률 17%면"
    } ]
  }, {
    "tStartMs": 295890,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "나쁘지 않습니다"
    } ]
  }, {
    "tStartMs": 296640,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "충분히 좋았고요"
    } ]
  }, {
    "tStartMs": 297760,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "닛케이 48%"
    } ]
  }, {
    "tStartMs": 298710,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "어휴 힘 좀 썼네 닛케이"
    } ]
  }, {
    "tStartMs": 300400,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "그래 뭐 다카이치 총리가"
    } ]
  }, {
    "tStartMs": 302240,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "결심한다고 하더라"
    } ]
  }, {
    "tStartMs": 303010,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "그래 힘내고"
    } ]
  }, {
    "tStartMs": 304060,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "가권지수 TSMC도 잘나간다며"
    } ]
  }, {
    "tStartMs": 306260,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "어휴, 요즘 연휴여서"
    } ]
  }, {
    "tStartMs": 308640,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "쉬고있는데"
    } ]
  }, {
    "tStartMs": 309520,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "뭐 연휴 끝나면 좀 오르겠네"
    } ]
  }, {
    "tStartMs": 311230,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "그럼 한 요정도 올테니까"
    } ]
  }, {
    "tStartMs": 312400,
    "dDurationMs": 530,
    "segs": [ {
      "utf8": "잘했어 잘했어"
    } ]
  }, {
    "tStartMs": 312930,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "그정도면 잘했다"
    } ]
  }, {
    "tStartMs": 313800,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "아유, 뭐 그정도 하면 되지"
    } ]
  }, {
    "tStartMs": 314970,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "뭐 뭐 이렇게 욕심을 부려"
    } ]
  }, {
    "tStartMs": 316430,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "한 40% 올랐으면 잘했구만"
    } ]
  }, {
    "tStartMs": 318240,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "물론 코스피는 한 120% 했는데"
    } ]
  }, {
    "tStartMs": 320180,
    "dDurationMs": 580,
    "segs": [ {
      "utf8": "괜찮습니다"
    } ]
  }, {
    "tStartMs": 320760,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "코스피니까 그런거니까"
    } ]
  }, {
    "tStartMs": 322620,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "그래서 뭐 우리 나스닥이는"
    } ]
  }, {
    "tStartMs": 324080,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "우리 스닥이는 일단 대만 제치고"
    } ]
  }, {
    "tStartMs": 326140,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "일본 제치고"
    } ]
  }, {
    "tStartMs": 327330,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "그리고 이제 코스피로 오면 되지 않을까 생각합니다"
    } ]
  }, {
    "tStartMs": 329630,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "기다려줄게, 기다려줄게"
    } ]
  }, {
    "tStartMs": 330800,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "천천히 와"
    } ]
  }, {
    "tStartMs": 331550,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "급하면 다쳐요"
    } ]
  }, {
    "tStartMs": 332860,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "그리고 뛰면 돌부리 걸리면"
    } ]
  }, {
    "tStartMs": 334240,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "넘어지면 무릎 까진다"
    } ]
  }, {
    "tStartMs": 335350,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "천천히 오면"
    } ]
  }, {
    "tStartMs": 336480,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "우리 높은 데서 기다리고 있을 테니까"
    } ]
  }, {
    "tStartMs": 338300,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "오면 와서 이렇게 한 잔씩 하시고"
    } ]
  }, {
    "tStartMs": 340150,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "아, 좋습니다"
    } ]
  }, {
    "tStartMs": 342390,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "좋구만, 좋아요"
    } ]
  }, {
    "tStartMs": 343400,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "그래서 아마 다 같이 높은 데서"
    } ]
  }, {
    "tStartMs": 345810,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "한 잔 할 수 있지 않을까 생각하고요"
    } ]
  }, {
    "tStartMs": 348170,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "게다가 이번 상승장은"
    } ]
  }, {
    "tStartMs": 350220,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "포모를 느끼는 분들이 그렇게 많다 그래요"
    } ]
  }, {
    "tStartMs": 352450,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "이게 왜냐하면"
    } ]
  }, {
    "tStartMs": 353260,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "1번 대형주 위주의 상승이었어요"
    } ]
  }, {
    "tStartMs": 355620,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "그리고 2번, 아까 보셨지만"
    } ]
  }, {
    "tStartMs": 357480,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "나스닥이 좀 못 따라왔어요"
    } ]
  }, {
    "tStartMs": 359090,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "그러니까 미국 주식도 따라오고"
    } ]
  }, {
    "tStartMs": 360870,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "소형주까지 다 올라오고"
    } ]
  }, {
    "tStartMs": 362250,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "물론 지수가 오르긴 했지만"
    } ]
  }, {
    "tStartMs": 363890,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "어쨌건 대형주가 대단히 많이 끌었거든요"
    } ]
  }, {
    "tStartMs": 365990,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "물론 이번에는 돌아가면서 올라와서"
    } ]
  }, {
    "tStartMs": 367420,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "사실은 사고만 있었으면"
    } ]
  }, {
    "tStartMs": 368830,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "거기에 못 올라타기가 어려울 정도로"
    } ]
  }, {
    "tStartMs": 370670,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "여러 가지 분야가 올랐지만"
    } ]
  }, {
    "tStartMs": 372150,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "어쨌건 소형주 위주의"
    } ]
  }, {
    "tStartMs": 373760,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "투자를 하신 분들이"
    } ]
  }, {
    "tStartMs": 374380,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "이제 코스닥 달리니까"
    } ]
  }, {
    "tStartMs": 375350,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "앞으로 좋겠죠"
    } ]
  }, {
    "tStartMs": 376060,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "포모를 좀 느끼고 있다고 많이 하고"
    } ]
  }, {
    "tStartMs": 378010,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "우리 직원들도 그 얘기를 하더라고요"
    } ]
  }, {
    "tStartMs": 379870,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "심지어 항의한 분도 있었어요"
    } ]
  }, {
    "tStartMs": 381980,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "왜 내..내가 뭐 했다고 했더니"
    } ]
  }, {
    "tStartMs": 384640,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "성과급을 빨리 주셨으면"
    } ]
  }, {
    "tStartMs": 385960,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "주식을 더 살 수 있는데"
    } ]
  }, {
    "tStartMs": 386960,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "?!"
    } ]
  }, {
    "tStartMs": 388060,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "늦게 줘서 못 샀다"
    } ]
  }, {
    "tStartMs": 391990,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "작년 말이나 올해 연초에 빨리 줬으면"
    } ]
  }, {
    "tStartMs": 393990,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "지금 35%"
    } ]
  }, {
    "tStartMs": 394600,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "3분의 1을 더 먹는데"
    } ]
  }, {
    "tStartMs": 396410,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "중순 2월 늦게 줘서 말이야"
    } ]
  }, {
    "tStartMs": 398940,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "10%밖에 못 먹었어"
    } ]
  }, {
    "tStartMs": 399920,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "슈카 때문이다"
    } ]
  }, {
    "tStartMs": 401430,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "죄송합니다"
    } ]
  }, {
    "tStartMs": 402750,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "하루하루가 이렇게 중요한 코스피일지를"
    } ]
  }, {
    "tStartMs": 404620,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "제가 미처 모르고"
    } ]
  }, {
    "tStartMs": 405610,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "그럴 줄 알았으면"
    } ]
  }, {
    "tStartMs": 406340,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "미리 빠르게 계산해서"
    } ]
  }, {
    "tStartMs": 407860,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "작년 말에만 드렸어도"
    } ]
  }, {
    "tStartMs": 409680,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "30% 이상 더"
    } ]
  }, {
    "tStartMs": 411250,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "수익률이 올 수 있었는데"
    } ]
  }, {
    "tStartMs": 412800,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "코스피 하루는"
    } ]
  }, {
    "tStartMs": 413970,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "그냥 보통 일이 아니라는 거를"
    } ]
  }, {
    "tStartMs": 415690,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "제가 너무 간과하고"
    } ]
  }, {
    "tStartMs": 417630,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "한 두 달 정도는 천천히 해도"
    } ]
  }, {
    "tStartMs": 418990,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "큰 변화가 없겠지라는"
    } ]
  }, {
    "tStartMs": 419960,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "이런 방심, 자만, 오만이죠"
    } ]
  }, {
    "tStartMs": 422400,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "그런 오만 때문에"
    } ]
  }, {
    "tStartMs": 423650,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "35%의 기회비용"
    } ]
  }, {
    "tStartMs": 425300,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "기회 손실이 온 거에 대해서"
    } ]
  }, {
    "tStartMs": 426740,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "우리 직원분들에게 다시 한 번 사과를 드리고요"
    } ]
  }, {
    "tStartMs": 428870,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "뭐 아직 끝난 거 아니니까"
    } ]
  }, {
    "tStartMs": 430290,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "지금 가고 있으니까"
    } ]
  }, {
    "tStartMs": 431460,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "지금부터 쭉쭉 가시면"
    } ]
  }, {
    "tStartMs": 432740,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "충분히 메이크 업할 수 있지 않을까"
    } ]
  }, {
    "tStartMs": 434790,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "생각을 합니다"
    } ]
  }, {
    "tStartMs": 436020,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "포모를 느끼신 우리 직원분들"
    } ]
  }, {
    "tStartMs": 437800,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "다시 한 번 사과를 드리고요"
    } ]
  }, {
    "tStartMs": 439460,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "그리고 포모를 느낀 분들이 너무 많다 보니까 어?"
    } ]
  }, {
    "tStartMs": 441660,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "그 돈이 오기 전에"
    } ]
  }, {
    "tStartMs": 442460,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "나는 먼저 사야지"
    } ]
  }, {
    "tStartMs": 444260,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "실제로 우리 직원이"
    } ]
  }, {
    "tStartMs": 445570,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "현금이 없어도"
    } ]
  }, {
    "tStartMs": 446440,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "주식을 살 수 있는 거 아닙니까?"
    } ]
  }, {
    "tStartMs": 447890,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "라는 질문을 저한테 했었죠"
    } ]
  }, {
    "tStartMs": 449340,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "그 친구가 이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 450670,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "주식을 꼭 현금으로 사야 돼요?"
    } ]
  }, {
    "tStartMs": 452180,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "저는 이게 처음에 무슨 말인가 했습니다"
    } ]
  }, {
    "tStartMs": 453900,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "주식을 현금으로 사지"
    } ]
  }, {
    "tStartMs": 454830,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "그럼 뭐로 사냐? 했더니"
    } ]
  }, {
    "tStartMs": 456520,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "아, 미수?"
    } ]
  }, {
    "tStartMs": 459230,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "아니면 신용공여?"
    } ]
  }, {
    "tStartMs": 461230,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "빌려서 살 수 있죠 빌려서"
    } ]
  }, {
    "tStartMs": 463290,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "따서 갚으면 됩니다"
    } ]
  }, {
    "tStartMs": 464830,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "놀랍게도 이 생각을 하는 분들이"
    } ]
  }, {
    "tStartMs": 466940,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "너무나 늘어난 끝에"
    } ]
  }, {
    "tStartMs": 468540,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "이거 올해 초에요"
    } ]
  }, {
    "tStartMs": 469790,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "올해 초에 주식 신용공여"
    } ]
  }, {
    "tStartMs": 471630,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "한마디로 돈 빌려서"
    } ]
  }, {
    "tStartMs": 472600,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "주식 산 분들이 16조였어"
    } ]
  }, {
    "tStartMs": 474680,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "지금 32조가 됐어요"
    } ]
  }, {
    "tStartMs": 476750,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "따갚대에 들어갔습니다"
    } ]
  }, {
    "tStartMs": 478260,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "따갚대 두 배 증가했어요"
    } ]
  }, {
    "tStartMs": 479570,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "두 배"
    } ]
  }, {
    "tStartMs": 480130,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "야 내가 따서 갚을게"
    } ]
  }, {
    "tStartMs": 481330,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "기다려봐 따서 갚을게"
    } ]
  }, {
    "tStartMs": 482700,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "야수야, 야수"
    } ]
  }, {
    "tStartMs": 484710,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "용자구만 용자"
    } ]
  }, {
    "tStartMs": 486150,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "거의 진짜 대단합니다, 형님들"
    } ]
  }, {
    "tStartMs": 487970,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "진짜 뭐 갬블러의 피가 막 흐른다"
    } ]
  }, {
    "tStartMs": 489760,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "근데 솔직히 이해는 해요"
    } ]
  }, {
    "tStartMs": 491260,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "요번은 어쩔 수 없다"
    } ]
  }, {
    "tStartMs": 492390,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "요번은 저도 인정"
    } ]
  }, {
    "tStartMs": 494050,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "이걸 보면"
    } ]
  }, {
    "tStartMs": 495040,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "이걸 보면 따서 갚고 싶지?"
    } ]
  }, {
    "tStartMs": 497600,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "그 마음은 이해합니다"
    } ]
  }, {
    "tStartMs": 499660,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "저걸 보니까 33영업일 중에"
    } ]
  }, {
    "tStartMs": 501560,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "5영업일 빼고 다 올라갔대더라"
    } ]
  }, {
    "tStartMs": 503160,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "확률은 90%요?"
    } ]
  }, {
    "tStartMs": 505050,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "확률은 90%?"
    } ]
  }, {
    "tStartMs": 506310,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "에이 모르겠다"
    } ]
  }, {
    "tStartMs": 507360,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "따서 갚을게요"
    } ]
  }, {
    "tStartMs": 509050,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "한 돈이 16조 원이 늘어난 겁니다"
    } ]
  }, {
    "tStartMs": 511200,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "32조예요 지금"
    } ]
  }, {
    "tStartMs": 513030,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "날마다 늘어나고 있어요, 날마다"
    } ]
  }, {
    "tStartMs": 514790,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "각도 보세요 각도"
    } ]
  }, {
    "tStartMs": 516020,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "지금까지는"
    } ]
  }, {
    "tStartMs": 518360,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "따서 갚으신 분들이 승자인데"
    } ]
  }, {
    "tStartMs": 520260,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "꼭 승자가 쭉 상승이 완만해지기 전에"
    } ]
  }, {
    "tStartMs": 524540,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "그쵸, 이걸 외국인들이 받아가고"
    } ]
  }, {
    "tStartMs": 526550,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "형님들은 무사히 나오고"
    } ]
  }, {
    "tStartMs": 528320,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "내려가고"
    } ]
  }, {
    "tStartMs": 528940,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "우리 외국인 형님들이"
    } ]
  }, {
    "tStartMs": 529880,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "고점에서 이렇게 받아가는"
    } ]
  }, {
    "tStartMs": 531060,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "좋습니다"
    } ]
  }, {
    "tStartMs": 533060,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "아니면 기관형들이 받아가도 돼요"
    } ]
  }, {
    "tStartMs": 534660,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "이 그림으로 딱 가면 좋습니다"
    } ]
  }, {
    "tStartMs": 536860,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "아름다운 그림이죠"
    } ]
  }, {
    "tStartMs": 537990,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "코스피가 이제 쫙 가다가 만 정도 찍고"
    } ]
  }, {
    "tStartMs": 540100,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "수그러들 때"
    } ]
  }, {
    "tStartMs": 541590,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "개인들이 던지기 시작하면"
    } ]
  }, {
    "tStartMs": 543540,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "팔기 시작하면"
    } ]
  }, {
    "tStartMs": 544670,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "포모에 빠진 기관과 외국인 형들이"
    } ]
  }, {
    "tStartMs": 547210,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "이만 갈 거야 라고 사면서"
    } ]
  }, {
    "tStartMs": 549280,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "우리는 줄이고"
    } ]
  }, {
    "tStartMs": 550500,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "코스피가 횡보하면 됩니다"
    } ]
  }, {
    "tStartMs": 552100,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "계획 딱 그려졌죠?"
    } ]
  }, {
    "tStartMs": 553120,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "이게 시나리오예요, 시나리오"
    } ]
  }, {
    "tStartMs": 554270,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "영화 작전, 좋습니다"
    } ]
  }, {
    "tStartMs": 555590,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "슈카월드의 작전이니까"
    } ]
  }, {
    "tStartMs": 557000,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "아마 그대로 가지 않을까 생각이 되고요"
    } ]
  }, {
    "tStartMs": 559840,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "따서 갚아야 돼"
    } ]
  }, {
    "tStartMs": 560640,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "따서 갚아야 돼"
    } ]
  }, {
    "tStartMs": 561710,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "지금 그런 상황입니다"
    } ]
  }, {
    "tStartMs": 563390,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "그렇기 때문에"
    } ]
  }, {
    "tStartMs": 564450,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "32조"
    } ]
  }, {
    "tStartMs": 565410,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "무려 신용공여를 16조를 올렸어요"
    } ]
  }, {
    "tStartMs": 567270,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "그 말인즉슨"
    } ]
  }, {
    "tStartMs": 568950,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "증권사들이 너무 많이 빌려줬다"
    } ]
  }, {
    "tStartMs": 572080,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "신규 대출을 못하고 있다"
    } ]
  }, {
    "tStartMs": 574400,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "한도가 있어요"
    } ]
  }, {
    "tStartMs": 575580,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "은행도 한도가 있습니다"
    } ]
  }, {
    "tStartMs": 576470,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "대출을 막 1, 2경원"
    } ]
  }, {
    "tStartMs": 577750,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "이렇게 해줄 수는 없어요"
    } ]
  }, {
    "tStartMs": 578750,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "너무 많이 빌려줘서"
    } ]
  }, {
    "tStartMs": 580290,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "신규 대출"
    } ]
  }, {
    "tStartMs": 581070,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "왜냐면 자본금 대비 몇 배"
    } ]
  }, {
    "tStartMs": 582110,
    "dDurationMs": 650,
    "segs": [ {
      "utf8": "이런 게 있거든"
    } ]
  }, {
    "tStartMs": 582760,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "당연히 있습니다"
    } ]
  }, {
    "tStartMs": 583690,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "신규 대출이 멈추는"
    } ]
  }, {
    "tStartMs": 585040,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "중단하는 증권사들이 급증하고 있답니다"
    } ]
  }, {
    "tStartMs": 587060,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "NH 투자 증권, 증권담보대출"
    } ]
  }, {
    "tStartMs": 589270,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "신규 취급 중단했다"
    } ]
  }, {
    "tStartMs": 591140,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "KB증권 중단, 한투 중단"
    } ]
  }, {
    "tStartMs": 593260,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "대출 한도가 다 찼네"
    } ]
  }, {
    "tStartMs": 594260,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "그 자본을 늘리면 더 빌려줄 수 있어요"
    } ]
  }, {
    "tStartMs": 597230,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "그래서 이게 자본을 증자를 해야지"
    } ]
  }, {
    "tStartMs": 599080,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "증자를 해서"
    } ]
  }, {
    "tStartMs": 600330,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "아니면 뭐든 하더라도 해서"
    } ]
  }, {
    "tStartMs": 601760,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "하여튼"
    } ]
  }, {
    "tStartMs": 602490,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "맥스로 땡긴 겁니다"
    } ]
  }, {
    "tStartMs": 603710,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "맥스로 빌려준 거기 때문에"
    } ]
  }, {
    "tStartMs": 605990,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "게다가 증권사에서 빌렸더니"
    } ]
  }, {
    "tStartMs": 607950,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "우리 다 찼어요"
    } ]
  }, {
    "tStartMs": 608650,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "그럼 어떻게 하면 됩니까?"
    } ]
  }, {
    "tStartMs": 609970,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "돈 빌려주는 데가"
    } ]
  }, {
    "tStartMs": 611540,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "증권사밖에 없나요?"
    } ]
  }, {
    "tStartMs": 612950,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "신용을 땡기면 되죠"
    } ]
  }, {
    "tStartMs": 615750,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "그래서인지 몰라도"
    } ]
  }, {
    "tStartMs": 616840,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "2025년 말 기준"
    } ]
  }, {
    "tStartMs": 618500,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "우리나라 가계신용 잔액이"
    } ]
  }, {
    "tStartMs": 620160,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "1,978조가 됐는데요"
    } ]
  }, {
    "tStartMs": 622030,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "전년 대비 56조가 증가했습니다"
    } ]
  }, {
    "tStartMs": 623900,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "물론 주택담보대출이 45조예요"
    } ]
  }, {
    "tStartMs": 626900,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "주담대가 짱이긴 해"
    } ]
  }, {
    "tStartMs": 628240,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "아무리 뭐라 그래도"
    } ]
  }, {
    "tStartMs": 629030,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "주담대가 44조가 늘었고"
    } ]
  }, {
    "tStartMs": 631220,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "나머지 11조, 12조 정도가..."
    } ]
  }, {
    "tStartMs": 633410,
    "dDurationMs": 590,
    "segs": [ {
      "utf8": "그 정도 중에서"
    } ]
  }, {
    "tStartMs": 634000,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "아마 주식을 산 돈이"
    } ]
  }, {
    "tStartMs": 634860,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "반은 되지 않을까?"
    } ]
  }, {
    "tStartMs": 635800,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "여기서도 한 5,6조 땡겨오자"
    } ]
  }, {
    "tStartMs": 637550,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "개인적인 생각에"
    } ]
  }, {
    "tStartMs": 638760,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "생각이 되고"
    } ]
  }, {
    "tStartMs": 639530,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "가계 신용 잔액이"
    } ]
  }, {
    "tStartMs": 640570,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "전년 대비 56조가 늘었어요"
    } ]
  }, {
    "tStartMs": 642560,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "2.9%"
    } ]
  }, {
    "tStartMs": 643390,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "2021년 이후 최고 상승률입니다"
    } ]
  }, {
    "tStartMs": 645980,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "물론 최고 상승률이라고 해도"
    } ]
  }, {
    "tStartMs": 648260,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "예전에는 훨씬 높았죠"
    } ]
  }, {
    "tStartMs": 649760,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "거의 뭐 5%, 7%"
    } ]
  }, {
    "tStartMs": 651070,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "또는 10% 위였는데"
    } ]
  }, {
    "tStartMs": 652660,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "쭉 내려갔다가"
    } ]
  }, {
    "tStartMs": 653990,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "이제 여기 내려온 겁니다"
    } ]
  }, {
    "tStartMs": 655160,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "이 정도 왔다고 할 수 있고"
    } ]
  }, {
    "tStartMs": 657090,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "아마 올해도"
    } ]
  }, {
    "tStartMs": 658190,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "한 2% 정도"
    } ]
  }, {
    "tStartMs": 659240,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "만약에 늘었다고 치면"
    } ]
  }, {
    "tStartMs": 660490,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "올해 우리는 2천조국이 됩니다"
    } ]
  }, {
    "tStartMs": 662850,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "천조국은 이제 명함을 못 내밀어요"
    } ]
  }, {
    "tStartMs": 664620,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "2천조국이 되고"
    } ]
  }, {
    "tStartMs": 666260,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "2천조면 일론 머스크 재산이 얼마더라?"
    } ]
  }, {
    "tStartMs": 668640,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "헷갈리는데"
    } ]
  }, {
    "tStartMs": 670260,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "귀화시키면 갚을 수도 있을 것 같습니다"
    } ]
  }, {
    "tStartMs": 672100,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "2천조국이 아마 되지 않을까 생각이 되고"
    } ]
  }, {
    "tStartMs": 675600,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "그렇기 때문에"
    } ]
  }, {
    "tStartMs": 676460,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "지금 현재 상황이"
    } ]
  }, {
    "tStartMs": 677640,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "주식시장이 약간만 흔들려도"
    } ]
  }, {
    "tStartMs": 679720,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "변동성이 커질 수 있는 상황이에요"
    } ]
  }, {
    "tStartMs": 681840,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "생각해봐요"
    } ]
  }, {
    "tStartMs": 682400,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "지금 32조가 신용공여 들어갔는데"
    } ]
  }, {
    "tStartMs": 685120,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "이게 조금 밀리면"
    } ]
  }, {
    "tStartMs": 686330,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "반대매매"
    } ]
  }, {
    "tStartMs": 687520,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "증권사가 던지는 거"
    } ]
  }, {
    "tStartMs": 688670,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "반대매매가 나와요"
    } ]
  }, {
    "tStartMs": 689430,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "빌린 돈이 빠지면"
    } ]
  }, {
    "tStartMs": 690850,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "담보가 모자르면 증권사에서 전화와요"
    } ]
  }, {
    "tStartMs": 692850,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "고객님 담보 더 넣으세요"
    } ]
  }, {
    "tStartMs": 694450,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "돈 없는데요?"
    } ]
  }, {
    "tStartMs": 695220,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "그러면 여러분들의 주식을 던지죠"
    } ]
  }, {
    "tStartMs": 697170,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "시장가에 팔아요"
    } ]
  }, {
    "tStartMs": 698810,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "그렇게 일어나는 게 반대매매인데"
    } ]
  }, {
    "tStartMs": 700560,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "이 날 조금 빠진 날 있죠?"
    } ]
  }, {
    "tStartMs": 703020,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "이 날이 종가가 -1.44였어요"
    } ]
  }, {
    "tStartMs": 705620,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "사실은 많이 빠진 날은 아닙니다"
    } ]
  }, {
    "tStartMs": 707470,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "저가가 마이너스 5.1이었는데"
    } ]
  }, {
    "tStartMs": 709610,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "한 3%, 4% 빠지니까"
    } ]
  }, {
    "tStartMs": 710790,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "반대매매가 엄청 나온 거예요"
    } ]
  }, {
    "tStartMs": 712420,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "-5%까지 밀었다가"
    } ]
  }, {
    "tStartMs": 713990,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "그걸 또 다 들어올려서"
    } ]
  }, {
    "tStartMs": 715380,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "종가 1.44에 끝났는데"
    } ]
  }, {
    "tStartMs": 717040,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "2월 9일 하루에 반대매매가"
    } ]
  }, {
    "tStartMs": 718570,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "360억이 나왔습니다"
    } ]
  }, {
    "tStartMs": 720440,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "이거 조금 움직였다고"
    } ]
  }, {
    "tStartMs": 722070,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "이제 조금 파란색 나오면"
    } ]
  }, {
    "tStartMs": 723660,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "반대매매가 아마"
    } ]
  }, {
    "tStartMs": 724930,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "몇백억씩 나올 수 있어요"
    } ]
  }, {
    "tStartMs": 726040,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "몇백억씩"
    } ]
  }, {
    "tStartMs": 726780,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "그럼 저 아래에서 또 들고"
    } ]
  }, {
    "tStartMs": 728200,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "들어올리는 사람도 있고"
    } ]
  }, {
    "tStartMs": 729960,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "지금 그래서 변동성이 대단히 클 수 있는 상황이고"
    } ]
  }, {
    "tStartMs": 733300,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "그러면 5,800"
    } ]
  }, {
    "tStartMs": 734600,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "거의 6천에 왔는데"
    } ]
  }, {
    "tStartMs": 735770,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "애널리스트 분들의 분위기는 어떠냐"
    } ]
  }, {
    "tStartMs": 737710,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "이것도 궁금하죠"
    } ]
  }, {
    "tStartMs": 738560,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "얼마까지 보시냐"
    } ]
  }, {
    "tStartMs": 739980,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "얼마 전에"
    } ]
  }, {
    "tStartMs": 741020,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "한화증권의 이재만 연구위원님께서"
    } ]
  }, {
    "tStartMs": 744270,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "레포트를 하나 냈어요"
    } ]
  }, {
    "tStartMs": 745500,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "보면 코스피 7,900의 시나리오"
    } ]
  }, {
    "tStartMs": 749060,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "좋습니다"
    } ]
  }, {
    "tStartMs": 752000,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "아까 슈카는 1만의 시나리오를 제시했고요"
    } ]
  }, {
    "tStartMs": 754940,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "초등학교 수학을 사용해서"
    } ]
  }, {
    "tStartMs": 757240,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "이대로 쭉 가면"
    } ]
  }, {
    "tStartMs": 758370,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "연말까지 1만, 1만4천이다라는"
    } ]
  }, {
    "tStartMs": 761190,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "믿거나 말거나 시나리오를 얘기했는데"
    } ]
  }, {
    "tStartMs": 762530,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "이거 애너리스트 분이잖아요"
    } ]
  }, {
    "tStartMs": 763910,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "이거 연구위원님의"
    } ]
  }, {
    "tStartMs": 764770,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "시나리오 7,900p 좋습니다"
    } ]
  }, {
    "tStartMs": 766790,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "물론 시나리오가 여러 개가 있고"
    } ]
  }, {
    "tStartMs": 768640,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "고점이 7,900이긴 하지만"
    } ]
  }, {
    "tStartMs": 770340,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "충분히 가능성이 있지 않다는 생각이 들고요"
    } ]
  }, {
    "tStartMs": 772540,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "7,900을 제시한 이유는"
    } ]
  }, {
    "tStartMs": 774230,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "레포트는 가서 직접 읽어보시고"
    } ]
  }, {
    "tStartMs": 776250,
    "dDurationMs": 670,
    "segs": [ {
      "utf8": "여러 가지 이유가 있는데"
    } ]
  }, {
    "tStartMs": 776920,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "그 중에 하나가 보면"
    } ]
  }, {
    "tStartMs": 777520,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "역시 코스피 순이익 전망치의 상승이 있습니다"
    } ]
  }, {
    "tStartMs": 780450,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "2025년 12월 말"
    } ]
  }, {
    "tStartMs": 781970,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "코스피 순이익"
    } ]
  }, {
    "tStartMs": 782920,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "2026년 전체 코스피 순이익 전망치가"
    } ]
  }, {
    "tStartMs": 785580,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "330조였다"
    } ]
  }, {
    "tStartMs": 786890,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "코스피는 모든 기업들이"
    } ]
  }, {
    "tStartMs": 788190,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "2026년에 303조 원을 벌겠군요"
    } ]
  }, {
    "tStartMs": 790670,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "근데 단 두 달이 지났는데"
    } ]
  }, {
    "tStartMs": 792510,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "2026년 2월이니까"
    } ]
  }, {
    "tStartMs": 793770,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "두 달 만에"
    } ]
  }, {
    "tStartMs": 794590,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "코스피 순이익 전망치를"
    } ]
  }, {
    "tStartMs": 796060,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "457조로 늘렸습니다"
    } ]
  }, {
    "tStartMs": 798710,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "127조가 두 달 만에 늘었어"
    } ]
  }, {
    "tStartMs": 801250,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "거의 40%의 순이익 상승이 있었는데"
    } ]
  }, {
    "tStartMs": 805650,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "어떻게 127조가 늘었냐?"
    } ]
  }, {
    "tStartMs": 807540,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "물론 반도체 순이익이 크게 늘었어"
    } ]
  }, {
    "tStartMs": 810170,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "이 127조 중에"
    } ]
  }, {
    "tStartMs": 811250,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "한 120조 정도가"
    } ]
  }, {
    "tStartMs": 813060,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "반도체가 D램 값이 후루루 후룩하고"
    } ]
  }, {
    "tStartMs": 815560,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "H빔이 후루룩 후룩하고"
    } ]
  }, {
    "tStartMs": 817200,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "여러분들이 컴퓨터 그래픽카드 받을 때"
    } ]
  }, {
    "tStartMs": 818740,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "어머 이게 말이 돼요?"
    } ]
  }, {
    "tStartMs": 820000,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "라고 하는 돈들이 늘어나면서"
    } ]
  }, {
    "tStartMs": 821550,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "전세계 가전제품들이"
    } ]
  }, {
    "tStartMs": 822870,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "어머 D램 가격이 이게"
    } ]
  }, {
    "tStartMs": 824960,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "내가 가격 올려야 됐네"
    } ]
  }, {
    "tStartMs": 825980,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "등등등등등 하면서"
    } ]
  }, {
    "tStartMs": 827900,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "127조가 늘었다고 보면 되고요"
    } ]
  }, {
    "tStartMs": 830380,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "자, 이런 걸 보다 보니까"
    } ]
  }, {
    "tStartMs": 831720,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "사람들이 참을 수 없죠"
    } ]
  }, {
    "tStartMs": 832970,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "그래서 언제까지 그렇게"
    } ]
  }, {
    "tStartMs": 835080,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "미수 신용공여를 할 건가"
    } ]
  }, {
    "tStartMs": 836530,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "내 돈으로 하겠다"
    } ]
  }, {
    "tStartMs": 837880,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "라는 돈이 지금 100조를 돌파했습니다"
    } ]
  }, {
    "tStartMs": 840800,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "투자자 예탁금"
    } ]
  }, {
    "tStartMs": 841960,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "주식을 팔아서"
    } ]
  }, {
    "tStartMs": 842620,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "계좌로 들어온 돈일 수도 있고"
    } ]
  }, {
    "tStartMs": 844010,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "주식을 사려고 돈을 모으고 모으고"
    } ]
  }, {
    "tStartMs": 845890,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "예금 깨고 부동산 팔고"
    } ]
  }, {
    "tStartMs": 847380,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "여기 적금 깨고 들어온 돈이"
    } ]
  }, {
    "tStartMs": 848990,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "사상 최초로 100조원을 돌파했습니다"
    } ]
  }, {
    "tStartMs": 852170,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "80조 돌파도 사상 최초였는데"
    } ]
  }, {
    "tStartMs": 854590,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "그거 두 달도 못 갔어요"
    } ]
  }, {
    "tStartMs": 856380,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "두 달도 못 가서"
    } ]
  }, {
    "tStartMs": 858020,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "100조, 지금 106조입니다"
    } ]
  }, {
    "tStartMs": 859950,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "이 기세로 가면"
    } ]
  }, {
    "tStartMs": 861720,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "아직 멈추지 않았어요"
    } ]
  }, {
    "tStartMs": 862790,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "지금 이렇게 때문에"
    } ]
  }, {
    "tStartMs": 863930,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "어디까지 갈지는 모르는 상황이고"
    } ]
  }, {
    "tStartMs": 866070,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "100조의 대기자금이"
    } ]
  }, {
    "tStartMs": 867840,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "대기자금이"
    } ]
  }, {
    "tStartMs": 868340,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "와 진짜 우리나라 돈은 다 이쪽으로 온 것 같다"
    } ]
  }, {
    "tStartMs": 870020,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "부동산 시장이 조금 안 좋을 수도 있겠다 생각하 는 게"
    } ]
  }, {
    "tStartMs": 872250,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "100조가 일로 왔네, 100조가"
    } ]
  }, {
    "tStartMs": 874140,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "물론 평상시에도 몇 십조는 있었지만"
    } ]
  }, {
    "tStartMs": 876750,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "그런 상황이라고 할 수 있고요"
    } ]
  }, {
    "tStartMs": 877920,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "자 그러면"
    } ]
  }, {
    "tStartMs": 879100,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "이 신용공여로"
    } ]
  }, {
    "tStartMs": 880010,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "대출받아서 주식도 많이 사"
    } ]
  }, {
    "tStartMs": 881370,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "미수 뭐 많이 사"
    } ]
  }, {
    "tStartMs": 882990,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "그 심지어 투자자 혜탁금 100조 들어왔어"
    } ]
  }, {
    "tStartMs": 884920,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "투자자 예탁금 이자"
    } ]
  }, {
    "tStartMs": 886090,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "이런 거 증권사가 다 이거 수익 모델입니다"
    } ]
  }, {
    "tStartMs": 888480,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "여러분 증권 주식 사겠다고"
    } ]
  }, {
    "tStartMs": 889980,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "계좌에다 돈 넣은 거"
    } ]
  }, {
    "tStartMs": 891310,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "그거 뭐 이자"
    } ]
  }, {
    "tStartMs": 892040,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "높게 나옵니까?"
    } ]
  }, {
    "tStartMs": 892960,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "당연히 안 나오죠"
    } ]
  }, {
    "tStartMs": 893920,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "언제 주식 살 줄 모르는"
    } ]
  }, {
    "tStartMs": 895010,
    "dDurationMs": 650,
    "segs": [ {
      "utf8": "대기자금인데"
    } ]
  }, {
    "tStartMs": 895660,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "그럼 만약에 은행 갖다 놓으면"
    } ]
  }, {
    "tStartMs": 896820,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "예금이 높잖아요"
    } ]
  }, {
    "tStartMs": 897880,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "증권사들이 이 돈들을 다 운용을 하죠"
    } ]
  }, {
    "tStartMs": 900370,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "역시 수익 모델이에요"
    } ]
  }, {
    "tStartMs": 901730,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "그 말인즉슨"
    } ]
  }, {
    "tStartMs": 903230,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "증권사들의 실적이"
    } ]
  }, {
    "tStartMs": 904680,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "미쳐돌아가겠구나라는 생각을 할 수 있죠"
    } ]
  }, {
    "tStartMs": 906910,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "그래서 나는 증권주를 사야지"
    } ]
  }, {
    "tStartMs": 908770,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "라고 판단한 분들은"
    } ]
  }, {
    "tStartMs": 909890,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "완전 완전 완전 에이스인데"
    } ]
  }, {
    "tStartMs": 914510,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "그 생각을 언제 했냐가 중요합니다"
    } ]
  }, {
    "tStartMs": 916770,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "심지어 어제 한 분도 벌었어요"
    } ]
  }, {
    "tStartMs": 919170,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "일주일 전에 한 분도 많이 벌었습니다"
    } ]
  }, {
    "tStartMs": 921700,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "1년 전에 할 필요도 없어요"
    } ]
  }, {
    "tStartMs": 922910,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "왜냐하면 엊그제부터"
    } ]
  }, {
    "tStartMs": 924230,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "10%, 20%씩"
    } ]
  }, {
    "tStartMs": 925900,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "증권주들이 미친듯이 뛰어서"
    } ]
  }, {
    "tStartMs": 927490,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "이렇게 올라갔기 때문에"
    } ]
  }, {
    "tStartMs": 928780,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "작년에 그 생각을 했다"
    } ]
  }, {
    "tStartMs": 930100,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "그럼 뭐 거의 두 개 먹었어요"
    } ]
  }, {
    "tStartMs": 931420,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "증권주 ETF가"
    } ]
  }, {
    "tStartMs": 933090,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "한 종목이 아니라"
    } ]
  }, {
    "tStartMs": 933810,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "ETF가 연초 이후 100%가 늘었습니다"
    } ]
  }, {
    "tStartMs": 936460,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "물론 증권주 섹터 전체가"
    } ]
  }, {
    "tStartMs": 937890,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "이렇게 상승한 건 아닌데"
    } ]
  }, {
    "tStartMs": 939420,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "ETF들은 대부분 대형주를 담으니까"
    } ]
  }, {
    "tStartMs": 941280,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "연초에 100% 올랐어요"
    } ]
  }, {
    "tStartMs": 943010,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "여러분들이 증권주를 샀으면"
    } ]
  }, {
    "tStartMs": 944430,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "어지간한 거 샀으면 2배입니다"
    } ]
  }, {
    "tStartMs": 946410,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "작년 초에 샀다"
    } ]
  }, {
    "tStartMs": 947540,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "2025년 초에"
    } ]
  }, {
    "tStartMs": 948620,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "어지간한 거는 3배예요"
    } ]
  }, {
    "tStartMs": 950450,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "내가 증권주 쭉 들고 있었는데"
    } ]
  }, {
    "tStartMs": 952760,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "3배밖에 못 먹었네?"
    } ]
  }, {
    "tStartMs": 954190,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "평타한 거야"
    } ]
  }, {
    "tStartMs": 955710,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "4배를 먹었어야 했는데"
    } ]
  }, {
    "tStartMs": 956850,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "왜 나는 3배밖에 못 먹었나?"
    } ]
  }, {
    "tStartMs": 958450,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "평타야"
    } ]
  }, {
    "tStartMs": 959820,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "200% 2배?"
    } ]
  }, {
    "tStartMs": 961500,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "부진해"
    } ]
  }, {
    "tStartMs": 962340,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "부진한 거죠"
    } ]
  }, {
    "tStartMs": 962960,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "2025년 초에 증권주를 샀는데"
    } ]
  }, {
    "tStartMs": 964750,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "2배밖에 못 먹었으면"
    } ]
  }, {
    "tStartMs": 966120,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "잘못 고르신 거예요"
    } ]
  }, {
    "tStartMs": 967550,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "대충 다트로 던졌으면 3배인데"
    } ]
  }, {
    "tStartMs": 970290,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "종목이 좀 그랬어요"
    } ]
  }, {
    "tStartMs": 971130,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "2배밖에 못 먹은 그런 상황이라고 할 수 있고요"
    } ]
  }, {
    "tStartMs": 973970,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "근데 이 각도가 좀 너무한 거 아닌가"
    } ]
  }, {
    "tStartMs": 976390,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "싶은 생각이 들죠"
    } ]
  }, {
    "tStartMs": 977840,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "이게 무슨 개별 주식도 아니고"
    } ]
  }, {
    "tStartMs": 979130,
    "dDurationMs": 30,
    "segs": [ {
      "utf8": "ETF인데"
    } ]
  }, {
    "tStartMs": 979160,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "ETF는 10개 이상이 들어간 겁니다"
    } ]
  }, {
    "tStartMs": 981770,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "10개 이상"
    } ]
  }, {
    "tStartMs": 982620,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "10개 이상 평균이"
    } ]
  }, {
    "tStartMs": 984220,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "100%면 두 달 만에"
    } ]
  }, {
    "tStartMs": 986660,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "엄청난 차트라고 할 수 있고요"
    } ]
  }, {
    "tStartMs": 987880,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "그리고 이 차트를"
    } ]
  }, {
    "tStartMs": 988860,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "이 증권주의의 급등을 이끈"
    } ]
  }, {
    "tStartMs": 990670,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "바로 그 종목"
    } ]
  }, {
    "tStartMs": 991970,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "오늘의 주제와 같은 종목인데"
    } ]
  }, {
    "tStartMs": 994210,
    "dDurationMs": 3650,
    "segs": [ {
      "utf8": "미래에셋 증권이 있습니다"
    } ]
  }, {
    "tStartMs": 997860,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "살 걸"
    } ]
  }, {
    "tStartMs": 998820,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "야 살 걸"
    } ]
  }, {
    "tStartMs": 999860,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "아 미래에셋 다니는 친구들 많은데"
    } ]
  }, {
    "tStartMs": 1001500,
    "dDurationMs": 3850,
    "segs": [ {
      "utf8": "내 후배가 잘 나갈 것 같다 그랬는데"
    } ]
  }, {
    "tStartMs": 1005350,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "알려줘도 못 먹네, 알려줘도"
    } ]
  }, {
    "tStartMs": 1007230,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "우리 회사 요즘 좋아요, 그래요?"
    } ]
  }, {
    "tStartMs": 1009120,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "요즘 증권주 다 좋잖아"
    } ]
  }, {
    "tStartMs": 1010680,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "그렇긴 하죠"
    } ]
  }, {
    "tStartMs": 1012690,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "미래에셋 증권이"
    } ]
  }, {
    "tStartMs": 1014140,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "연초 이후에"
    } ]
  }, {
    "tStartMs": 1015620,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "187%"
    } ]
  }, {
    "tStartMs": 1016860,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "연초가 지금 두 달 지났잖아!"
    } ]
  }, {
    "tStartMs": 1018780,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "두 달 안 지났는데, 187%"
    } ]
  }, {
    "tStartMs": 1020310,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "최근 1년이 잘못 계산한 거 아니지?"
    } ]
  }, {
    "tStartMs": 1022670,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "이거 헷갈리네, 724%?"
    } ]
  }, {
    "tStartMs": 1025090,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "말이 됩니까?"
    } ]
  }, {
    "tStartMs": 1026020,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "뭡니까 724%는 이거 뭐야"
    } ]
  }, {
    "tStartMs": 1027970,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "만 원짜리가"
    } ]
  }, {
    "tStartMs": 1028680,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "7만 원 왔다는 소린가?"
    } ]
  }, {
    "tStartMs": 1029700,
    "dDurationMs": 280,
    "segs": [ {
      "utf8": "맞네"
    } ]
  }, {
    "tStartMs": 1029980,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "만 원짜리가 7만 원 왔다는 거죠"
    } ]
  }, {
    "tStartMs": 1032080,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "724%"
    } ]
  }, {
    "tStartMs": 1035100,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "아휴 하이닉스 왜 했나"
    } ]
  }, {
    "tStartMs": 1037510,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "그렇죠?"
    } ]
  }, {
    "tStartMs": 1038370,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "그 미래에셋 증권 들고 있으면 되는데"
    } ]
  }, {
    "tStartMs": 1041320,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "일곱 배 x2 아, 잠깐만"
    } ]
  }, {
    "tStartMs": 1043040,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "어..."
    } ]
  }, {
    "tStartMs": 1044510,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "그쵸 뭐 딴 거 들고 있을 필요도 없이"
    } ]
  }, {
    "tStartMs": 1046910,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "증권주 중에서 시총이 1위였는데"
    } ]
  }, {
    "tStartMs": 1048630,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "저거 들고 있으면"
    } ]
  }, {
    "tStartMs": 1049290,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "7배인데, 7배"
    } ]
  }, {
    "tStartMs": 1050480,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "올해만 2배"
    } ]
  }, {
    "tStartMs": 1051290,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "187%, 3배네 3배"
    } ]
  }, {
    "tStartMs": 1053170,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "3배로 된 거죠, 187%"
    } ]
  }, {
    "tStartMs": 1055160,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "그런 상황인데"
    } ]
  }, {
    "tStartMs": 1056240,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "현재 미래에셋 증권이 시가총액이"
    } ]
  }, {
    "tStartMs": 1058590,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "40조를 넘었습니다"
    } ]
  }, {
    "tStartMs": 1060430,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "증권사 시총 1위고요"
    } ]
  }, {
    "tStartMs": 1061960,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "금융사 중에서도 시총 4위까지 올라왔어요"
    } ]
  }, {
    "tStartMs": 1064160,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "위에 남은 게 KB, 신한지주, 삼성생명입니다"
    } ]
  }, {
    "tStartMs": 1067610,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "40조까지 올라왔어"
    } ]
  }, {
    "tStartMs": 1069020,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "하나금융, 우리금융지주를 제쳤어요"
    } ]
  }, {
    "tStartMs": 1071900,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "오, 40조까지 올라왔다"
    } ]
  }, {
    "tStartMs": 1074480,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "엄청난 상승이라고 하시는데"
    } ]
  }, {
    "tStartMs": 1075740,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "700%는"
    } ]
  }, {
    "tStartMs": 1078020,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "옛날에 좀 들고 있었거든요"
    } ]
  }, {
    "tStartMs": 1080200,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "옛날에 갖고 있었는데"
    } ]
  }, {
    "tStartMs": 1081780,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "참지를 못하고"
    } ]
  }, {
    "tStartMs": 1082940,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "참지를 못하고"
    } ]
  }, {
    "tStartMs": 1084670,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "7배 하여튼 그렇습니다 하여튼 그렇고요"
    } ]
  }, {
    "tStartMs": 1086740,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "뭐, 뭐 그쵸 한탄해봐야"
    } ]
  }, {
    "tStartMs": 1088710,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "무슨 소용이 있냐"
    } ]
  }, {
    "tStartMs": 1089600,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "왜 이렇게 올랐냐"
    } ]
  }, {
    "tStartMs": 1090830,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "여러 가지가 있는데"
    } ]
  }, {
    "tStartMs": 1091560,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "물론 처음에 일본의 실적이 좋고"
    } ]
  }, {
    "tStartMs": 1092910,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "그리고 요즘에"
    } ]
  }, {
    "tStartMs": 1094240,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "하나 소개시켜 드리겠지만"
    } ]
  }, {
    "tStartMs": 1095790,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "홍콩이나 인도 미국 등에서"
    } ]
  }, {
    "tStartMs": 1097490,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "해외 시장 성과가 좋다"
    } ]
  }, {
    "tStartMs": 1098840,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "멀티플이 굉장히 올라갔고"
    } ]
  }, {
    "tStartMs": 1100270,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "그리고 스페이스X 투자"
    } ]
  }, {
    "tStartMs": 1102230,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "와, 이것도 있습니다"
    } ]
  }, {
    "tStartMs": 1104710,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "놀랍게도 증권사인데"
    } ]
  }, {
    "tStartMs": 1106780,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "PI 투자로 자기자본 투자로"
    } ]
  }, {
    "tStartMs": 1108180,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "스페이스X하고 XA에 들어가서"
    } ]
  }, {
    "tStartMs": 1110070,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "투자가 또 대박이 났고요"
    } ]
  }, {
    "tStartMs": 1111710,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "그리고 요즘에 디지털 자산 투자도 많이 발표하죠"
    } ]
  }, {
    "tStartMs": 1113800,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "코빗 인수한다든지"
    } ]
  }, {
    "tStartMs": 1115030,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "홍콩에서 디지털 채권도 발행하고"
    } ]
  }, {
    "tStartMs": 1117120,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "또 디지털 자산에 뛰어든다 그러니까"
    } ]
  }, {
    "tStartMs": 1119110,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "결국에는 성과가 좋고"
    } ]
  }, {
    "tStartMs": 1120240,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "멀티플까지 같이 올라가면서"
    } ]
  }, {
    "tStartMs": 1121820,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "상승률이 굉장히 올라갔다고 보면 되는데"
    } ]
  }, {
    "tStartMs": 1123920,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "최근 영업이익을 보면"
    } ]
  }, {
    "tStartMs": 1125460,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "2023년에 5천억이었어요"
    } ]
  }, {
    "tStartMs": 1127440,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "작년에 1조 천억이고요"
    } ]
  }, {
    "tStartMs": 1129310,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "그러니까 2024년에"
    } ]
  }, {
    "tStartMs": 1130620,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "2025년에는 1조 9천억까지 올라갔습니다"
    } ]
  }, {
    "tStartMs": 1132660,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "2배, 70%"
    } ]
  }, {
    "tStartMs": 1134370,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "뭐 그냥 영업이익이 올라간 거 정도로는"
    } ]
  }, {
    "tStartMs": 1136750,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "이 정도 상승인데"
    } ]
  }, {
    "tStartMs": 1138080,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "이게 또 해외 법인에서 발생한 세진이익이 크네?"
    } ]
  }, {
    "tStartMs": 1140830,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "이것 때문에 멀티플이 더 올라갔어요"
    } ]
  }, {
    "tStartMs": 1142600,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "글로벌에서 통하는 증권사가 된 거 아니냐"
    } ]
  }, {
    "tStartMs": 1144830,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "예를 들면 뉴욕 법인"
    } ]
  }, {
    "tStartMs": 1146080,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "홍콩 법인, 싱가포르 법인"
    } ]
  }, {
    "tStartMs": 1147580,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "이런 데가 있죠"
    } ]
  }, {
    "tStartMs": 1148190,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "제가 실제로 물어보니까"
    } ]
  }, {
    "tStartMs": 1151730,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "요즘에 해외 법인들 실적이 굉장히 좋다 그러고"
    } ]
  }, {
    "tStartMs": 1155030,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "부럽습니다 자, 그리고 미래에셋 그룹의"
    } ]
  }, {
    "tStartMs": 1157930,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "이것도 또 유명한데"
    } ]
  }, {
    "tStartMs": 1159300,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "스페이스X와 xAI 투자 성공이 있다"
    } ]
  }, {
    "tStartMs": 1162500,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "미래에셋 그룹이 2022년에 스페이스X에"
    } ]
  }, {
    "tStartMs": 1164670,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "약 4천억을 투자한 걸로 알려져 있습니다"
    } ]
  }, {
    "tStartMs": 1166820,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "이 중 절반이"
    } ]
  }, {
    "tStartMs": 1167530,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "미래에셋 증권이 들어갔다고 하고요"
    } ]
  }, {
    "tStartMs": 1169570,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "스페이스X 시가총액이 얼마나 들어갔냐"
    } ]
  }, {
    "tStartMs": 1171700,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "추정치인데 한 1,250억 달러?"
    } ]
  }, {
    "tStartMs": 1173860,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "이 정도로 예상이 될 때"
    } ]
  }, {
    "tStartMs": 1176490,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "이 가격으로 투자를 했다는 것 같아요"
    } ]
  }, {
    "tStartMs": 1178380,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "정확하진 않습니다"
    } ]
  }, {
    "tStartMs": 1180080,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "근데 지금 나오는 얘기에 따르면"
    } ]
  }, {
    "tStartMs": 1181580,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "올해 스페이스X가 IPO를 할 것 같은데"
    } ]
  }, {
    "tStartMs": 1183970,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "싸게 보는 데가"
    } ]
  }, {
    "tStartMs": 1184890,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "1조 2천억 달러"
    } ]
  }, {
    "tStartMs": 1186520,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "높게 보는 데는"
    } ]
  }, {
    "tStartMs": 1187300,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "1조 5천억 달러까지 보는 것 같아요"
    } ]
  }, {
    "tStartMs": 1189110,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "그럼 몇 배가 증가한 겁니까?"
    } ]
  }, {
    "tStartMs": 1190400,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "1,250달러에서 10배"
    } ]
  }, {
    "tStartMs": 1192990,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "얼마 넣었다고요? 4천억"
    } ]
  }, {
    "tStartMs": 1194750,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "미래에셋이 절반? 2천억"
    } ]
  }, {
    "tStartMs": 1196580,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "그럼 2천억에 10배면"
    } ]
  }, {
    "tStartMs": 1198030,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "2조가 나왔다는 거죠, 10배로"
    } ]
  }, {
    "tStartMs": 1200920,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "그래서 영업이익 말고"
    } ]
  }, {
    "tStartMs": 1203140,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "평가에 굉장히 커질 가능성도"
    } ]
  }, {
    "tStartMs": 1204850,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "굉장히 있고"
    } ]
  }, {
    "tStartMs": 1205730,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "물론 본인들 주식도 7배 올랐으니까"
    } ]
  }, {
    "tStartMs": 1207760,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "스페이스X가 10배 오른 게"
    } ]
  }, {
    "tStartMs": 1208960,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "굉장히 많이 오른 건 아니죠"
    } ]
  }, {
    "tStartMs": 1210350,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "미래색 그룹은 xAI"
    } ]
  }, {
    "tStartMs": 1212020,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "머스크의 AI 기업"
    } ]
  }, {
    "tStartMs": 1213240,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "X에 대규모 투자를 했는데"
    } ]
  }, {
    "tStartMs": 1214670,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "여기서 평가 일단"
    } ]
  }, {
    "tStartMs": 1215830,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "3천억에서 4천억 예상한다고 그럽니다"
    } ]
  }, {
    "tStartMs": 1217700,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "한마디로 투자도 굉장히 대박이 났고"
    } ]
  }, {
    "tStartMs": 1220000,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "그리고 제 개인적인 생각엔"
    } ]
  }, {
    "tStartMs": 1221660,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "요즘의 미래에셋 그룹의 박현주 회장님이 얘기하는 게"
    } ]
  }, {
    "tStartMs": 1225280,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "약간 예전 손정의 아저씨 보는 느낌이 약간 나요"
    } ]
  }, {
    "tStartMs": 1229090,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "투자 전문 뭘 하겠다라는 느낌이 약간 있는데"
    } ]
  }, {
    "tStartMs": 1232450,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "얼마 전에 한국경제가 인터뷰를 했는데"
    } ]
  }, {
    "tStartMs": 1234260,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "이런 얘기를 했습니다"
    } ]
  }, {
    "tStartMs": 1235290,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "AI 때문에"
    } ]
  }, {
    "tStartMs": 1236030,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "인류가 역사상 가장 가파른 변곡점에 서 있고"
    } ]
  }, {
    "tStartMs": 1238620,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "지금의 패러다임을 바꿀 기회인데"
    } ]
  }, {
    "tStartMs": 1240450,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "향후 5년간 축적될 영업이익과"
    } ]
  }, {
    "tStartMs": 1242500,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "투자 이익이 한 28조가 된다"
    } ]
  }, {
    "tStartMs": 1244660,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "이 돈을 과감히 투입하겠다 이랬거든요"
    } ]
  }, {
    "tStartMs": 1248600,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "그래서 이런 얘기를 예전에는"
    } ]
  }, {
    "tStartMs": 1250150,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "일본의 손정의 아저씨가 굉장히 많이 했는데"
    } ]
  }, {
    "tStartMs": 1253890,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "본격적으로 돈을 투자해서"
    } ]
  }, {
    "tStartMs": 1255660,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "뭔가 갖고 오겠다"
    } ]
  }, {
    "tStartMs": 1257460,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "꿈을 만들고"
    } ]
  }, {
    "tStartMs": 1258690,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "잘 될지는 모르겠지만"
    } ]
  }, {
    "tStartMs": 1259790,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "꿈을 만드니까"
    } ]
  }, {
    "tStartMs": 1261120,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "멀티플이 굉장히 올라가는 게 아닌가 생각되고"
    } ]
  }, {
    "tStartMs": 1263830,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "현재 경쟁사 대비 PBR을 보면"
    } ]
  }, {
    "tStartMs": 1265880,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "미래에셋 증권이 멀티플이 두 배입니다"
    } ]
  }, {
    "tStartMs": 1267960,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "그 말인즉슨"
    } ]
  }, {
    "tStartMs": 1269340,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "딴 증권사도 올라갈 수 있다는 건지"
    } ]
  }, {
    "tStartMs": 1272380,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "미래셋이 너무 고평가를 받은 건지 모르겠지만"
    } ]
  }, {
    "tStartMs": 1274760,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "하이튼 멀티플이 지금 2배까지 올라간 게"
    } ]
  }, {
    "tStartMs": 1276980,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "미래셋 증권이라고 보면 되고"
    } ]
  }, {
    "tStartMs": 1278340,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "그래서 7배가 올라갔다는 거죠"
    } ]
  }, {
    "tStartMs": 1280110,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "그럼 증권주는 왜 오르냐?"
    } ]
  }, {
    "tStartMs": 1281610,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "물론 증권사별 방금 얘기했던"
    } ]
  }, {
    "tStartMs": 1282910,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "미래셋 증권이나"
    } ]
  }, {
    "tStartMs": 1284030,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "이런 다른 증권 개별 이슈들도 있지만"
    } ]
  }, {
    "tStartMs": 1285760,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "역시 증시 활약이 크죠"
    } ]
  }, {
    "tStartMs": 1287030,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "영업이익이 당연히 증가하고 있고"
    } ]
  }, {
    "tStartMs": 1288830,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "3차 상포개정, 자산소거 의무"
    } ]
  }, {
    "tStartMs": 1290420,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "이런 게 있으니까"
    } ]
  }, {
    "tStartMs": 1291450,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "멀티플도 굉장히"
    } ]
  }, {
    "tStartMs": 1293110,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "밸류에이션 자체가 늘어나는 경향도 있고"
    } ]
  }, {
    "tStartMs": 1296450,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "증권주가 원래 사이클을 많이 타잖아요"
    } ]
  }, {
    "tStartMs": 1297980,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "사이클이 올라가는 사이클이다 보니까"
    } ]
  }, {
    "tStartMs": 1299610,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "그런 게 아닌가 생각이 되죠"
    } ]
  }, {
    "tStartMs": 1301600,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "그리고 증권주도 증권주인데"
    } ]
  }, {
    "tStartMs": 1303770,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "역시 우리들이 가장 많이 산"
    } ]
  }, {
    "tStartMs": 1306120,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "국민 주식 삼성전자"
    } ]
  }, {
    "tStartMs": 1307740,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "얼마냐?"
    } ]
  }, {
    "tStartMs": 1308600,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "외우기 힘듭니다"
    } ]
  }, {
    "tStartMs": 1309460,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "왜냐하면 매일매일 바뀌거든요"
    } ]
  }, {
    "tStartMs": 1311970,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "우리 삼성전자 주가가 매일매일 바뀌어서"
    } ]
  }, {
    "tStartMs": 1314380,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "외우기 힘들어요"
    } ]
  }, {
    "tStartMs": 1315140,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "옛날에는 5만원? 6만원?"
    } ]
  }, {
    "tStartMs": 1316700,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "이러면 끝났죠"
    } ]
  }, {
    "tStartMs": 1317440,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "요즘은 아니에요"
    } ]
  }, {
    "tStartMs": 1318390,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "매일 매일이 바뀐다"
    } ]
  }, {
    "tStartMs": 1320270,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "지금 19만원입니다 19만원"
    } ]
  }, {
    "tStartMs": 1322940,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "17만원 아니에요? 에헤이"
    } ]
  }, {
    "tStartMs": 1324930,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "며칠 전이죠"
    } ]
  }, {
    "tStartMs": 1326170,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "며칠 전이에요"
    } ]
  }, {
    "tStartMs": 1327300,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "며칠 전 주가를 얘기하면 어떡해요 여긴데"
    } ]
  }, {
    "tStartMs": 1329550,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "16만 원?"
    } ]
  }, {
    "tStartMs": 1330840,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "에이 지난주"
    } ]
  }, {
    "tStartMs": 1332230,
    "dDurationMs": 550,
    "segs": [ {
      "utf8": "지난주"
    } ]
  }, {
    "tStartMs": 1332780,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "지금은 19만 원입니다"
    } ]
  }, {
    "tStartMs": 1335190,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "20만 전자가 사실상 눈앞에 왔고"
    } ]
  }, {
    "tStartMs": 1337100,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "20만 전자"
    } ]
  }, {
    "tStartMs": 1338010,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "목표 20만 전자 아닙니까?"
    } ]
  }, {
    "tStartMs": 1339510,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "그렇게 얘기하는 사람은 숏입니다"
    } ]
  }, {
    "tStartMs": 1342840,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "목표가 20만 전자예요?"
    } ]
  }, {
    "tStartMs": 1344280,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "이렇게 얘기하는 사람도 숏이죠"
    } ]
  }, {
    "tStartMs": 1345700,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "이거 얼마 남은 거야?"
    } ]
  }, {
    "tStartMs": 1346860,
    "dDurationMs": 210,
    "segs": [ {
      "utf8": "4%?"
    } ]
  }, {
    "tStartMs": 1347070,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "그거 팔란 소리잖아"
    } ]
  }, {
    "tStartMs": 1349410,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "20만 전자 얘기하는 분들은"
    } ]
  }, {
    "tStartMs": 1350810,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "이제 숏돌이"
    } ]
  }, {
    "tStartMs": 1351960,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "아 내가 숏이구나 라고 생각하시면 되고요"
    } ]
  }, {
    "tStartMs": 1354370,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "목표가를 이거 어떻게 되는 거예요"
    } ]
  }, {
    "tStartMs": 1355930,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "목표가를 하여튼 그렇습니다"
    } ]
  }, {
    "tStartMs": 1357240,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "하여튼 그래요"
    } ]
  }, {
    "tStartMs": 1357990,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "연초 이후 상승률이 48%고요"
    } ]
  }, {
    "tStartMs": 1360330,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "최근 1년 상승률이 231%입니다"
    } ]
  }, {
    "tStartMs": 1363230,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "이런 날이 올 줄 몰랐죠"
    } ]
  }, {
    "tStartMs": 1365060,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "이런 날이 올 줄"
    } ]
  }, {
    "tStartMs": 1366190,
    "dDurationMs": 410,
    "segs": [ {
      "utf8": "자 그러면"
    } ]
  }, {
    "tStartMs": 1366600,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "어, 저는 삼성전자 아니라 SK하이닉스인데요"
    } ]
  }, {
    "tStartMs": 1369320,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "하이닉스는 95만원입니다"
    } ]
  }, {
    "tStartMs": 1372700,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "하이닉스 가격은 외우기 더 힘들어요"
    } ]
  }, {
    "tStartMs": 1375040,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "더 힘들어 저기는"
    } ]
  }, {
    "tStartMs": 1376390,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "저기는 더 많이 움직이기 때문에"
    } ]
  }, {
    "tStartMs": 1377890,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "뭐 80"
    } ]
  }, {
    "tStartMs": 1378950,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "아 옛날 얘기야"
    } ]
  }, {
    "tStartMs": 1380320,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "92만원"
    } ]
  }, {
    "tStartMs": 1380980,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "아유, 어저께 얘기지"
    } ]
  }, {
    "tStartMs": 1382270,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "그렇게 외우면 안 돼"
    } ]
  }, {
    "tStartMs": 1383100,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "95만원, 100만닉스 100만닉스"

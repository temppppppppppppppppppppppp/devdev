          "type": "string"
        },
        "macro_battlefield": {
          "type": "string"
        },
        "macro_battlefield_map": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bundle_goal": {
          "type": "string"
        },
        "first_signboard_block": {
          "type": "integer"
        },
        "representative_reevaluation_block": {
          "type": "integer"
        },
        "next_battlefield_ticket_block": {
          "type": "integer"
        },
        "timing_reconciliation_note": {
          "type": "string"
        }

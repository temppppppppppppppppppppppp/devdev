{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "narrative_ssot/reference/reference_selection.schema.json",
  "title": "reference_selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "work_id",
    "selection_date",
    "selected_cards"
  ],
  "properties": {
    "work_id": {
      "type": "string",
      "minLength": 1
    },
    "selection_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "work_identity_override": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "title",
        "reason"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string",
          "minLength": 1
        },
        "commercial_label": {
          "type": "string",
          "minLength": 1
        },
        "slug_aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "profile_override": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "primary_profile",
        "secondary_profile",
        "reason"
      ],
      "properties": {
        "primary_profile": {
          "type": "string",
          "enum": [
            "business_growth_profile",
            "investment_market_profile",
            "entertainment_media_profile",
            "medical_professional_profile",
            "office_power_profile",
            "tech_startup_profile",
            "urban_power_profile",
            "wuxia"
          ]
        },
        "secondary_profile": {
          "type": "string",
          "enum": [
            "",
            "business_growth_profile",
            "investment_market_profile",
            "entertainment_media_profile",
            "medical_professional_profile",
            "office_power_profile",
            "tech_startup_profile",
            "urban_power_profile",
            "wuxia"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "opening_bundle_contract_override": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "bundle_window",
        "macro_battlefield",
        "macro_battlefield_map",
        "bundle_goal",
        "first_signboard_block",
        "representative_reevaluation_block",
        "next_battlefield_ticket_block",
        "timing_reconciliation_note"
      ],
      "properties": {
        "bundle_window": {
          "type": "string",
          "minLength": 1
        },
        "macro_battlefield": {
          "type": "string",
          "minLength": 1
        },
        "macro_battlefield_map": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "bundle_goal": {
          "type": "string",
          "minLength": 1
        },
        "first_signboard_block": {
          "type": "integer",
          "minimum": 2,
          "maximum": 6
        },
        "representative_reevaluation_block": {
          "type": "integer",
          "minimum": 2,
          "maximum": 6
        },
        "next_battlefield_ticket_block": {
          "type": "integer",
          "minimum": 2,
          "maximum": 6
        },
        "timing_reconciliation_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "selected_cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "card_slug",
          "track",
          "handoff_label",
          "selection_reason",
          "must_not_copy_applied",
          "contamination_risk_reviewed"
        ],
        "properties": {
          "card_slug": {
            "type": "string",
            "minLength": 1
          },
          "track": {
            "type": "string",
            "enum": [
              "A",
              "B"
            ]
          },
          "handoff_label": {
            "type": "string",
            "minLength": 1
          },
          "selection_reason": {
            "type": "string",
            "minLength": 1
          },
          "must_not_copy_applied": {
            "type": "boolean"
          },
          "contamination_risk_reviewed": {
            "type": "boolean"
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "narrative_ssot/reference/reference_selection.schema.json",
  "title": "reference_selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "work_id",
    "selection_date",
    "selected_cards"
  ],
  "properties": {
    "work_id": {
      "type": "string",
      "minLength": 1
    },
    "selection_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "selected_cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "card_slug",
          "track",
          "handoff_label",
          "selection_reason",
          "must_not_copy_applied",
          "contamination_risk_reviewed"
        ],
        "properties": {
          "card_slug": {
            "type": "string",
            "minLength": 1
          },
          "track": {
            "type": "string",
            "enum": [
              "A",
              "B"
            ]
          },
          "handoff_label": {
            "type": "string",
            "minLength": 1
          },
          "selection_reason": {
            "type": "string",
            "minLength": 1
          },
          "must_not_copy_applied": {
            "type": "boolean"
          },
          "contamination_risk_reviewed": {
            "type": "boolean"
          }
        }
      }
    }
  }
}


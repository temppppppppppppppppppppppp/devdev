  } ],
  "events": [ {
    "tStartMs": 6970,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "3번째 주제"
    } ]
  }, {
    "tStartMs": 7990,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "영국은 귀족들이 지배하는 나라냐가"
    } ]
  }, {
    "tStartMs": 11480,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "이번 주제가 되겠습니다"
    } ]
  }, {
    "tStartMs": 12690,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "너무 재밌는 내용이에요"
    } ]
  }, {
    "tStartMs": 14250,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "저랑 같이 한번 보도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 15900,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "지난 3월 11일"
    } ]
  }, {
    "tStartMs": 17040,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "영국에선 법안이 하나 통과되는데요"
    } ]
  }, {
    "tStartMs": 18790,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "법안의 내용이 우리가 보면"
    } ]
  }, {
    "tStartMs": 20280,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "깜짝 놀랄만한 내용입니다"
    } ]
  }, {
    "tStartMs": 22290,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "이런 내용이 있어요"
    } ]
  }, {
    "tStartMs": 23390,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "세습 귀족들이 가지고 가는"
    } ]
  }, {
    "tStartMs": 25070,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "의석을 폐지하겠다"
    } ]
  }, {
    "tStartMs": 27440,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "정확하게 말하면"
    } ]
  }, {
    "tStartMs": 28540,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "영국의회는 상원에서"
    } ]
  }, {
    "tStartMs": 29690,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "세습 귀족 의원들을 모두 제외하는"
    } ]
  }, {
    "tStartMs": 32380,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "모두 퇴출시키는 법안을"
    } ]
  }, {
    "tStartMs": 34420,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "승인했다라는 겁니다"
    } ]
  }, {
    "tStartMs": 36040,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "그런데 이 한국인들이 보면"
    } ]
  }, {
    "tStartMs": 38390,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "세습 귀족이 아직도 국회의원을 하나?"
    } ]
  }, {
    "tStartMs": 42450,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "귀족으로 세습돼서"
    } ]
  }, {
    "tStartMs": 43860,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "국회의원을 하는 나라가"
    } ]
  }, {
    "tStartMs": 45450,
    "dDurationMs": 650,
    "segs": [ {
      "utf8": "물론 있겠지만"
    } ]
  }, {
    "tStartMs": 46100,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "그게 영국이냐?"
    } ]
  }, {
    "tStartMs": 47470,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "일단 영국에서는 아직도"
    } ]
  }, {
    "tStartMs": 49290,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "귀족들이 국회의원을 하나요?"
    } ]
  }, {
    "tStartMs": 50980,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "이건 너무 영국을 모르는 질문이에요"
    } ]
  }, {
    "tStartMs": 53270,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "왜냐하면 영국 상원의 이름이 뭡니까?"
    } ]
  }, {
    "tStartMs": 57050,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "귀족원이에요"
    } ]
  }, {
    "tStartMs": 58260,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "하우스 오브 로드예요"
    } ]
  }, {
    "tStartMs": 60260,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "하우스 오브 로드"
    } ]
  }, {
    "tStartMs": 61460,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "말 그대로 로드들의 집이야"
    } ]
  }, {
    "tStartMs": 63540,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "귀족원"
    } ]
  }, {
    "tStartMs": 64440,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "그리고 영국 상원의 멤버들은"
    } ]
  }, {
    "tStartMs": 65930,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "서로 뭐라고 부르냐?"
    } ]
  }, {
    "tStartMs": 66990,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "피어스라고 불러요"
    } ]
  }, {
    "tStartMs": 67990,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "피어라는 게"
    } ]
  }, {
    "tStartMs": 68740,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "원래 경쟁 상대"
    } ]
  }, {
    "tStartMs": 69990,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "피어들이잖아요"
    } ]
  }, {
    "tStartMs": 70860,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "뭐라고 하지"
    } ]
  }, {
    "tStartMs": 71870,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "증권사면 증권사 피어들이 있고"
    } ]
  }, {
    "tStartMs": 73300,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "나랑 비슷한 동류들을 피어라고 부르잖아"
    } ]
  }, {
    "tStartMs": 75930,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "왕 앞에는 모두 피어다 라고 해서"
    } ]
  }, {
    "tStartMs": 78220,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "피어라고 부르는데"
    } ]
  }, {
    "tStartMs": 79270,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "본인들끼리 귀족이라고 불러"
    } ]
  }, {
    "tStartMs": 81060,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "상원의원이면 귀족이야"
    } ]
  }, {
    "tStartMs": 83800,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "귀족들이 국회의원을 하는 게 아니라"
    } ]
  }, {
    "tStartMs": 85610,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "상원은 귀족원입니다"
    } ]
  }, {
    "tStartMs": 87840,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "그러면 상원 말고"
    } ]
  }, {
    "tStartMs": 88820,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "이거 상원이니까"
    } ]
  }, {
    "tStartMs": 89750,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "하원은 뭐라고 부릅니까?"
    } ]
  }, {
    "tStartMs": 91950,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "상원은 귀족원이에요"
    } ]
  }, {
    "tStartMs": 93480,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "하원은?"
    } ]
  }, {
    "tStartMs": 94920,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "농노라니요"
    } ]
  }, {
    "tStartMs": 95990,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "농노라니"
    } ]
  }, {
    "tStartMs": 96820,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "농노는 아니고"
    } ]
  }, {
    "tStartMs": 98180,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "우리가 보면 상당히 이해하기 힘든데"
    } ]
  }, {
    "tStartMs": 100340,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "이렇게 부릅니다"
    } ]
  }, {
    "tStartMs": 101550,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "영국 하원의 이름은 평민원이에요"
    } ]
  }, {
    "tStartMs": 104630,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "평민원"
    } ]
  }, {
    "tStartMs": 105520,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "귀족원 있고"
    } ]
  }, {
    "tStartMs": 106490,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "평민원이 있어"
    } ]
  }, {
    "tStartMs": 108120,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "우리가 보면은"
    } ]
  }, {
    "tStartMs": 108930,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "들고 일어날 일이죠"
    } ]
  }, {
    "tStartMs": 110000,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "야, 너는 귀족이고"
    } ]
  }, {
    "tStartMs": 111110,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "나는 평민이냐"
    } ]
  }, {
    "tStartMs": 112170,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "근데 그렇게 불러요"
    } ]
  }, {
    "tStartMs": 113450,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "하우스 오브 커먼이에요 커먼"
    } ]
  }, {
    "tStartMs": 114940,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "뭐라 그래야 돼 이걸"
    } ]
  }, {
    "tStartMs": 116570,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "대중 다수"
    } ]
  }, {
    "tStartMs": 118020,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "평민원, 시민원"
    } ]
  }, {
    "tStartMs": 119460,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "시민원보다"
    } ]
  }, {
    "tStartMs": 120210,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "좀 어떻게 보면"
    } ]
  }, {
    "tStartMs": 121210,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "귀족과 나뉘어 있는 거죠"
    } ]
  }, {
    "tStartMs": 122560,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "로드와 커먼이 나뉘어 있는 거예요"
    } ]
  }, {
    "tStartMs": 124550,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "영국 하원의원들은"
    } ]
  }, {
    "tStartMs": 125840,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "보통 국회의원이라고 불러요"
    } ]
  }, {
    "tStartMs": 127130,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "MP"
    } ]
  }, {
    "tStartMs": 128020,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "그래서 영국에서 국회의원이다"
    } ]
  }, {
    "tStartMs": 129790,
    "dDurationMs": 270,
    "segs": [ {
      "utf8": "라고 하면"
    } ]
  }, {
    "tStartMs": 130060,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "보통 하원의원입니다"
    } ]
  }, {
    "tStartMs": 131460,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "상원은 뭡니까?"
    } ]
  }, {
    "tStartMs": 132260,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "아까 얘기했잖아요"
    } ]
  }, {
    "tStartMs": 132870,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "피어스"
    } ]
  }, {
    "tStartMs": 133530,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "귀족, 귀족"
    } ]
  }, {
    "tStartMs": 134580,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "어... 아니 근데"
    } ]
  }, {
    "tStartMs": 137020,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "아무리 그래도"
    } ]
  }, {
    "tStartMs": 137580,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "시대가 어느 때인데"
    } ]
  }, {
    "tStartMs": 138740,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "귀족원과 평민원으로 나누는 게"
    } ]
  }, {
    "tStartMs": 140550,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "이게 말이 되냐"
    } ]
  }, {
    "tStartMs": 141930,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "아니 이게 이게"
    } ]
  }, {
    "tStartMs": 142640,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "언제적 얘기를 지금"
    } ]
  }, {
    "tStartMs": 144190,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "야, 무슨 귀족원이 있고"
    } ]
  }, {
    "tStartMs": 145880,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "평민원이 있어"
    } ]
  }, {
    "tStartMs": 147290,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "있어요"
    } ]
  }, {
    "tStartMs": 148150,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "영국의회는"
    } ]
  }, {
    "tStartMs": 149180,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "14세기에 이게 나뉘었습니다"
    } ]
  }, {
    "tStartMs": 151010,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "양원제가"
    } ]
  }, {
    "tStartMs": 151900,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "700년의 역사가 있어요"
    } ]
  }, {
    "tStartMs": 153590,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "1300 몇 년부터 이걸 하고 있어"
    } ]
  }, {
    "tStartMs": 155610,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "그러니까 지금 함부로 바꾸기도 그런데"
    } ]
  }, {
    "tStartMs": 158620,
    "dDurationMs": 440,
    "segs": [ {
      "utf8": "그러면은"
    } ]
  }, {
    "tStartMs": 159060,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "우리가 기존에 자주 보던"
    } ]
  }, {
    "tStartMs": 161180,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "영국 의원들끼리 나와서"
    } ]
  }, {
    "tStartMs": 162450,
    "dDurationMs": 450,
    "segs": [ {
      "utf8": "막"
    } ]
  }, {
    "tStartMs": 162900,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "미스터 스피커 하면서"
    } ]
  }, {
    "tStartMs": 164370,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "삿대질 하면서 싸우는데"
    } ]
  }, {
    "tStartMs": 166480,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "여기는 평민원이에요"
    } ]
  }, {
    "tStartMs": 169190,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "이거 우리가 많이 보던 거"
    } ]
  }, {
    "tStartMs": 170150,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "이런 거 이거는"
    } ]
  }, {
    "tStartMs": 171770,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "영국 국회죠"
    } ]
  }, {
    "tStartMs": 172790,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "영국 하원인데 평민이야 평민"
    } ]
  }, {
    "tStartMs": 175350,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "그럼 상원은요?"
    } ]
  }, {
    "tStartMs": 176970,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "영국 상원 귀족원은"
    } ]
  }, {
    "tStartMs": 178090,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "여러분들이 아마 잘 못 보셨을 겁니다"
    } ]
  }, {
    "tStartMs": 180030,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "이렇게 생겼어요"
    } ]
  }, {
    "tStartMs": 181700,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "왜 못 봤냐?"
    } ]
  }, {
    "tStartMs": 182520,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "사실 별로 하는 게 없어서"
    } ]
  }, {
    "tStartMs": 184150,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "죄송합니다"
    } ]
  }, {
    "tStartMs": 184950,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "별로 하는 게 없어서"
    } ]
  }, {
    "tStartMs": 186120,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "나와봐야 별 소용이 없는데"
    } ]
  }, {
    "tStartMs": 187760,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "이렇게 빨간 옷 입고"
    } ]
  }, {
    "tStartMs": 189730,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "근엄하게 근엄하게"
    } ]
  }, {
    "tStartMs": 191560,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "딱"
    } ]
  }, {
    "tStartMs": 192720,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "아니 피어들이잖아요"
    } ]
  }, {
    "tStartMs": 193940,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "우리 귀족들인데 어디 말이야"
    } ]
  }, {
    "tStartMs": 196070,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "발딱발딱 서서"
    } ]
  }, {
    "tStartMs": 196730,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "지금 삿대질하고"
    } ]
  }, {
    "tStartMs": 197500,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "안 하죠?"
    } ]
  }, {
    "tStartMs": 198370,
    "dDurationMs": 590,
    "segs": [ {
      "utf8": "이렇게"
    } ]
  }, {
    "tStartMs": 198960,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "이렇게 이렇게 있는 게"
    } ]
  }, {
    "tStartMs": 200440,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "이제 상원입니다"
    } ]
  }, {
    "tStartMs": 201410,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "우린 아마 잘 못 보셨을 거예요"
    } ]
  }, {
    "tStartMs": 203210,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "이 산타크로스 복장은 왜 입고 있냐?"
    } ]
  }, {
    "tStartMs": 204760,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "여기가 12월 25일이라서 그러냐?"
    } ]
  }, {
    "tStartMs": 206460,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "그게 아닙니다"
    } ]
  }, {
    "tStartMs": 207470,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "저들이 입고 있는 복장은"
    } ]
  }, {
    "tStartMs": 209120,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "역사와 전통을 자랑하는 복장이에요"
    } ]
  }, {
    "tStartMs": 211540,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "붉은색과 흰색"
    } ]
  }, {
    "tStartMs": 213030,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "단비털 예복을 입고 있습니다"
    } ]
  }, {
    "tStartMs": 215520,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "역사가 700년이니까"
    } ]
  }, {
    "tStartMs": 217230,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "전통을 굉장히 중시해요"
    } ]
  }, {
    "tStartMs": 218420,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "귀족원이라니까 귀족원"
    } ]
  }, {
    "tStartMs": 219740,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "전통을 얼마나 중시하냐"
    } ]
  }, {
    "tStartMs": 221620,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "저희가 귀족원이니까"
    } ]
  }, {
    "tStartMs": 222700,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "예를 들면 이런 게 있어요"
    } ]
  }, {
    "tStartMs": 223920,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "우리가 해리포터에서 봤을 법한 내용들을"
    } ]
  }, {
    "tStartMs": 226750,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "실제로 해"
    } ]
  }, {
    "tStartMs": 227670,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "제가 예시를 몇 개 보여드리겠습니다"
    } ]
  }, {
    "tStartMs": 229480,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "일단 영국의 상원"
    } ]
  }, {
    "tStartMs": 231350,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "귀족원도 의장이 있어요"
    } ]
  }, {
    "tStartMs": 233240,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "로드 맥폴이 있습니다"
    } ]
  }, {
    "tStartMs": 234710,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "남작인가?"
    } ]
  }, {
    "tStartMs": 236920,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "제가 알기에 그런데"
    } ]
  }, {
    "tStartMs": 238060,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "로드 맥폴이 있고"
    } ]
  }, {
    "tStartMs": 239390,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "조금 이따 보여드리겠지만"
    } ]
  }, {
    "tStartMs": 240510,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "이 뒤에 있는 것도 다 의미가 있어요"
    } ]
  }, {
    "tStartMs": 242470,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "갑자기 누워있는 이 촛대 같은 건 뭐냐"
    } ]
  }, {
    "tStartMs": 245110,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "이제 설명드리겠습니다"
    } ]
  }, {
    "tStartMs": 246140,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "심지어 앉아있는 의자도 의미가 있어요"
    } ]
  }, {
    "tStartMs": 248340,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "그거 설명드릴게요"
    } ]
  }, {
    "tStartMs": 249270,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "그리고 오른쪽에 블랙 로드가 있어요"
    } ]
  }, {
    "tStartMs": 252240,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "이런 게 많은데"
    } ]
  }, {
    "tStartMs": 253070,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "대표적인 것만 소개시켜 드리겠습니다"
    } ]
  }, {
    "tStartMs": 255020,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "블랙 로드는 뭐냐?"
    } ]
  }, {
    "tStartMs": 256370,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "이게 아주 재밌는 직책인데"
    } ]
  }, {
    "tStartMs": 258380,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "로드가 이거잖아요"
    } ]
  }, {
    "tStartMs": 259380,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "이 검은 지팡이"
    } ]
  }, {
    "tStartMs": 260950,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "우리가 흔히 말하는 뭐라 그러죠?"
    } ]
  }, {
    "tStartMs": 262350,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "이렇게 지팡이 들고 있는 거"
    } ]
  }, {
    "tStartMs": 263480,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "뭐 해리포터에서도 이런 거 들고 갖고"
    } ]
  }, {
    "tStartMs": 265370,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "뭐라고 뭐라고 하잖아"
    } ]
  }, {
    "tStartMs": 266970,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "블랙 로드를 담당하는"
    } ]
  }, {
    "tStartMs": 268620,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "사라 클라크 경인데"
    } ]
  }, {
    "tStartMs": 269860,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "원래 이거 하는 사람들이"
    } ]
  }, {
    "tStartMs": 270830,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "남자입니다 남자인데"
    } ]
  }, {
    "tStartMs": 272690,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "700년 만에 처음으로"
    } ]
  }, {
    "tStartMs": 274190,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "여성이 블랙, 직위예요"
    } ]
  }, {
    "tStartMs": 275630,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "이름 직위"
    } ]
  }, {
    "tStartMs": 276760,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "사람 이름이 아니야"
    } ]
  }, {
    "tStartMs": 277550,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "블랙로드가 직위야"
    } ]
  }, {
    "tStartMs": 279480,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "블랙로드의"
    } ]
  }, {
    "tStartMs": 280810,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "사라 클락이 여성으로는"
    } ]
  }, {
    "tStartMs": 282070,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "처음으로 이걸 담당합니다"
    } ]
  }, {
    "tStartMs": 283800,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "그럼 저 블랙로드는 뭐하는 사람이냐?"
    } ]
  }, {
    "tStartMs": 285430,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "아주 직책이 높은 사람이에요"
    } ]
  }, {
    "tStartMs": 287550,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "물론 의장이 제일 높지만"
    } ]
  }, {
    "tStartMs": 288630,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "굉장히 높은 사람인데"
    } ]
  }, {
    "tStartMs": 290080,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "블랙로드는 뭐냐?"
    } ]
  }, {
    "tStartMs": 291350,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "보신 분도 있을 텐데"
    } ]
  }, {
    "tStartMs": 292420,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "이 검은 지팡이"
    } ]
  }, {
    "tStartMs": 293220,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "이게 블랙로드예요"
    } ]
  }, {
    "tStartMs": 294340,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "이걸 들 수 있는 직책 같은 겁니다"
    } ]
  }, {
    "tStartMs": 296060,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "그러니까 우리로 치면 무슨 참모총장"
    } ]
  }, {
    "tStartMs": 297590,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "뭐 그런 거예요"
    } ]
  }, {
    "tStartMs": 298460,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "저걸 딱 들어"
    } ]
  }, {
    "tStartMs": 299320,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "저걸 들면 뭐하는 거냐?"
    } ]
  }, {
    "tStartMs": 300760,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "원래 영국은"
    } ]
  }, {
    "tStartMs": 302050,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "국왕이 왕국이기 때문에"
    } ]
  }, {
    "tStartMs": 304130,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "의회를 열 때"
    } ]
  }, {
    "tStartMs": 305370,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "국왕이 소집을 해요"
    } ]
  }, {
    "tStartMs": 307060,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "그래서 영국왕이"
    } ]
  }, {
    "tStartMs": 308590,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "야, 의회 열라그래라"
    } ]
  }, {
    "tStartMs": 309970,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "그럼 블랙로드가 왕의 명을 들은 다음에"
    } ]
  }, {
    "tStartMs": 312570,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "하원으로 가"
    } ]
  }, {
    "tStartMs": 313560,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "왜냐면 하원은 평민원이잖아"
    } ]
  }, {
    "tStartMs": 315030,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "평민들에게"
    } ]
  }, {
    "tStartMs": 317140,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "왕의 의사를 전달해주러 가"
    } ]
  }, {
    "tStartMs": 318980,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "블랙로드를 딱 들고"
    } ]
  }, {
    "tStartMs": 320120,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "그럼 딱 들고 갈 때"
    } ]
  }, {
    "tStartMs": 321760,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "이게 여기가 하원 문입니다"
    } ]
  }, {
    "tStartMs": 323370,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "이 블랙로드가 이렇게 오면"
    } ]
  }, {
    "tStartMs": 324960,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "전통이 있어요"
    } ]
  }, {
    "tStartMs": 326070,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "하원에서 문을 쾅 닫습니다"
    } ]
  }, {
    "tStartMs": 328570,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "영상 있어요"
    } ]
  }, {
    "tStartMs": 329360,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "유튜브 가서 보시면 많아요"
    } ]
  }, {
    "tStartMs": 330790,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "갑자기 문을 쾅 닫어"
    } ]
  }, {
    "tStartMs": 331850,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "왜냐면은"
    } ]
  }, {
    "tStartMs": 332790,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "우리는 국민의 대표고"
    } ]
  }, {
    "tStartMs": 334140,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "왕 앞에 굴종할 수 없다"
    } ]
  }, {
    "tStartMs": 335460,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "그래서 일부러 문을 쾅 닫습니다"
    } ]
  }, {
    "tStartMs": 337350,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "독립적이다 그거예요"
    } ]
  }, {
    "tStartMs": 338610,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "네가 오라"
    } ]
  }, {
    "tStartMs": 339210,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "그러면 내가 가야 되냐?"
    } ]
  }, {
    "tStartMs": 340170,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "뭐 이겁니다 왕이 오라"
    } ]
  }, {
    "tStartMs": 341260,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "그러면 내가 가야 돼?"
    } ]
  }, {
    "tStartMs": 341940,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "내가 국민 대표인데?"
    } ]
  }, {
    "tStartMs": 343240,
    "dDurationMs": 450,
    "segs": [ {
      "utf8": "쾅 닫아요"
    } ]
  }, {
    "tStartMs": 343690,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "그럼 블랙로드가"
    } ]
  }, {
    "tStartMs": 344910,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "지팡이로"
    } ]
  }, {
    "tStartMs": 345950,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "문을 쾅쾅쾅 두드립니다"
    } ]
  }, {
    "tStartMs": 347870,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "세 번을 두드려요"
    } ]
  }, {
    "tStartMs": 349050,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "그러면 안에서"
    } ]
  }, {
    "tStartMs": 350390,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "국민의 대표들이"
    } ]
  }, {
    "tStartMs": 352670,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "세 번이나 두드리는 거 보니까"
    } ]
  }, {
    "tStartMs": 354370,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "급하구만"
    } ]
  }, {
    "tStartMs": 355260,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "저 정도 숙였으면"
    } ]
  }, {
    "tStartMs": 356810,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "한 번 가줄까?"
    } ]
  }, {
    "tStartMs": 358410,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "해서 문을 엽니다"
    } ]
  }, {
    "tStartMs": 359730,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "그래서 한 번 두드리면"
    } ]
  }, {
    "tStartMs": 360600,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "안 열어요"
    } ]
  }, {
    "tStartMs": 361460,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "한 번 두드면 안 돼"
    } ]
  }, {
    "tStartMs": 362360,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "안 급하잖아"
    } ]
  }, {
    "tStartMs": 363300,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "아니 국민의 대표인데"
    } ]
  }, {
    "tStartMs": 364750,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "좀 와서 좀 말이야"
    } ]
  }, {
    "tStartMs": 366210,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "정중하게 부탁해야"
    } ]
  }, {
    "tStartMs": 367340,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "갈까 말까 하는데"
    } ]
  }, {
    "tStartMs": 368370,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "그래서 세 번 톡톡톡 두드립니다"
    } ]
  }, {
    "tStartMs": 371600,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "그래서 검은 로드예요"
    } ]
  }, {
    "tStartMs": 372720,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "이걸로 톡톡 두드리는데"
    } ]
  }, {
    "tStartMs": 373860,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "그래서 제가 어디 가서 글을 읽어보니까"
    } ]
  }, {
    "tStartMs": 376150,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "하도 이걸 두들겨서"
    } ]
  }, {
    "tStartMs": 377270,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "여기 역사적인 흉터도 있다 그러는데"
    } ]
  }, {
    "tStartMs": 379430,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "거기까지는 모르겠고"
    } ]
  }, {
    "tStartMs": 380360,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "두드려요 이 모습"
    } ]
  }, {
    "tStartMs": 381350,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "제가 보여드리도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 382900,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "이것이 영국이다라는 것을"
    } ]
  }, {
    "tStartMs": 384120,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "가장 직접적으로 보여주는"
    } ]
  }, {
    "tStartMs": 385820,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "장면이라고 할 수 있는데"
    } ]
  }, {
    "tStartMs": 387240,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "이게 어디냐면 하원 안쪽이에요"
    } ]
  }, {
    "tStartMs": 389390,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "뒤에 문이 있잖아"
    } ]
  }, {
    "tStartMs": 390620,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "블랙로드 가서 문을"
    } ]
  }, {
    "tStartMs": 391490,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "지금 쾅 닫은 상황이에요"
    } ]
  }, {
    "tStartMs": 393030,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "그리고 앞에 있는 사람은"
    } ]
  }, {
    "tStartMs": 394130,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "또 직위가 있어"
    } ]
  }, {
    "tStartMs": 395010,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "그것까지 설명을 안 드릴게요"
    } ]
  }, {
    "tStartMs": 396330,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "이걸 외치는 사람이에요"
    } ]
  }, {
    "tStartMs": 397400,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "외치는 사람인데"
    } ]
  }, {
    "tStartMs": 398260,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "이제 블랙로드가 온 거야"
    } ]
  }, {
    "tStartMs": 399570,
    "dDurationMs": 570,
    "segs": [ {
      "utf8": "하원에"
    } ]
  }, {
    "tStartMs": 400140,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "이렇게 됩니다"
    } ]
  }, {
    "tStartMs": 407050,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "블랙로드가 왔죠"
    } ]
  }, {
    "tStartMs": 408310,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "문이 열립니다"
    } ]
  }, {
    "tStartMs": 411960,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "저걸 외쳐요"
    } ]
  }, {
    "tStartMs": 413430,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "저렇게 왕의 뭘 지시를 받고"
    } ]
  }, {
    "tStartMs": 416150,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "의회를 열어라 하고 온 거예요"
    } ]
  }, {
    "tStartMs": 433500,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "이런 거 하고"
    } ]
  }, {
    "tStartMs": 434160,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "뒤에 오시는 분이"
    } ]
  }, {
    "tStartMs": 435220,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "저 앞에 있는 저걸 들죠"
    } ]
  }, {
    "tStartMs": 437820,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "저것도 의미가 있습니다"
    } ]
  }, {
    "tStartMs": 438910,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "소개시켜 드릴텐데"
    } ]
  }, {
    "tStartMs": 440230,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "갑자기 저 봉 같은 건 왜 들고 가냐"
    } ]
  }, {
    "tStartMs": 442840,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "저게 예식이에요"
    } ]
  }, {
    "tStartMs": 443610,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "예식 일종의"
    } ]
  }, {
    "tStartMs": 444590,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "우리 치면은"
    } ]
  }, {
    "tStartMs": 445390,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "뭐 가끔 광화문에서 하는"
    } ]
  }, {
    "tStartMs": 446850,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "뭐 이렇게 교환하는 예식이 있죠"
    } ]
  }, {
    "tStartMs": 448580,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "갑자기 봉을 휙 듭니다"
    } ]
  }, {
    "tStartMs": 449860,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "저 봉은 뭐냐?"
    } ]
  }, {
    "tStartMs": 451210,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "봉이 아니라"
    } ]
  }, {
    "tStartMs": 452190,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "저게 황금 철퇴입니다 철퇴"
    } ]
  }, {
    "tStartMs": 454870,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "메이스예요, 메이스"
    } ]
  }, {
    "tStartMs": 456220,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "이 철퇴는 뭐냐?"
    } ]
  }, {
    "tStartMs": 457540,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "이 황금 철퇴가"
    } ]
  }, {
    "tStartMs": 459000,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "국왕으로부터 받은"
    } ]
  }, {
    "tStartMs": 460360,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "입법의 권위 같은 걸 얘기한다고 합니다"
    } ]
  }, {
    "tStartMs": 462690,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "그래서 이 철퇴가 없으면"
    } ]
  }, {
    "tStartMs": 464670,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "의회를 열 수 없어요"
    } ]
  }, {
    "tStartMs": 466250,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "영국에서"
    } ]
  }, {
    "tStartMs": 467150,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "영국 하원에 이 철퇴가 없다?"
    } ]
  }, {
    "tStartMs": 468810,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "그러면 진행이 안 돼"
    } ]
  }, {
    "tStartMs": 470710,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "법안을 통과시킬 수도 없어"
    } ]
  }, {
    "tStartMs": 472020,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "그러니까 저게 무조건 있어야 돼"
    } ]
  }, {
    "tStartMs": 473940,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "그러면 이런 생각 들죠"
    } ]
  }, {
    "tStartMs": 474800,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "그러면 내가 마음에 들지 않는"
    } ]
  }, {
    "tStartMs": 475890,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "법이 통과되려고 할 때"
    } ]
  }, {
    "tStartMs": 477310,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "이 철퇴를 들고"
    } ]
  }, {
    "tStartMs": 478240,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "도망가면 어떻게 되냐"
    } ]
  }, {
    "tStartMs": 479770,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "이런 생각 들지 않습니까?"
    } ]
  }, {
    "tStartMs": 481310,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "아니 뭐 필리버스터도 하는데"
    } ]
  }, {
    "tStartMs": 482960,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "20시간씩"
    } ]
  }, {
    "tStartMs": 484010,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "법안 마음에 안 드는데"
    } ]
  }, {
    "tStartMs": 484880,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "통과되려고 그러면"
    } ]
  }, {
    "tStartMs": 485790,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "에라이씨 하고 철퇴를 들고"
    } ]
  }, {
    "tStartMs": 486910,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "도망가면 어떻게 되냐"
    } ]
  }, {
    "tStartMs": 488270,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "도망가면 어떻게 되는지"
    } ]
  }, {
    "tStartMs": 489490,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "한번 보여드리겠습니다"
    } ]
  }, {
    "tStartMs": 490710,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "자 놀랍게도"
    } ]
  }, {
    "tStartMs": 492070,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "실제로 그런 일을 합니다"
    } ]
  }, {
    "tStartMs": 494470,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "여기 하원이에요"
    } ]
  }, {
    "tStartMs": 495570,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "여기 보면 철퇴가 있어"
    } ]
  }, {
    "tStartMs": 497060,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "노동당 국회의원이에요"
    } ]
  }, {
    "tStartMs": 498850,
    "dDurationMs": 440,
    "segs": [ {
      "utf8": "얘기하다가"
    } ]
  }, {
    "tStartMs": 499290,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "마음에 안 들었어"
    } ]
  }, {
    "tStartMs": 500400,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "그러니까 갑자기 벌떡 일어나더니"
    } ]
  }, {
    "tStartMs": 502680,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "가더니"
    } ]
  }, {
    "tStartMs": 505980,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "저걸 들고"
    } ]
  }, {
    "tStartMs": 509210,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "멈춘 거야"
    } ]
  }, {
    "tStartMs": 509770,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "지금 국회가 멈춰야 돼"
    } ]
  }, {
    "tStartMs": 510590,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "아무것도 못 해"
    } ]
  }, {
    "tStartMs": 511670,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "지금 도망가려고 그러죠 도망가려고"
    } ]
  }, {
    "tStartMs": 513680,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "이렇게 이 앞에 있는 사람이"
    } ]
  }, {
    "tStartMs": 515000,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "이제 감시원입니다"
    } ]
  }, {
    "tStartMs": 517240,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "감시원한테 잡혔어요"
    } ]
  }, {
    "tStartMs": 518100,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "도망가다가"
    } ]
  }, {
    "tStartMs": 519790,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "다시 갖다 놓죠"
    } ]
  }, {
    "tStartMs": 524200,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "난리 오분 전이 되는데"
    } ]
  }, {
    "tStartMs": 525690,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "더 이상은 보여드리지 않겠습니다"
    } ]
  }, {
    "tStartMs": 527240,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "가서 보십시오"
    } ]
  }, {
    "tStartMs": 527990,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "저거를 실제로 가끔 저런 일이 있습니다"
    } ]
  }, {
    "tStartMs": 531190,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "왜냐하면 실컷 얘기하다가도"
    } ]
  }, {
    "tStartMs": 532490,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "저게 없어지는 순간에 의회가 아니에요"
    } ]
  }, {
    "tStartMs": 535260,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "의회가 멈추는 거기 때문에"
    } ]
  }, {
    "tStartMs": 536960,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "지  마음에 안 들면"
    } ]
  }, {
    "tStartMs": 538040,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "저걸 들고 도망을 획책하고요"
    } ]
  }, {
    "tStartMs": 540520,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "그러다 걸리면"
    } ]
  }, {
    "tStartMs": 541480,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "사방에서 외치는 게"
    } ]
  }, {
    "tStartMs": 542970,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "돌려놓으라고"
    } ]
  }, {
    "tStartMs": 543800,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "갖다놔"
    } ]
  }, {
    "tStartMs": 544460,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "풋잇백 하라고"
    } ]
  }, {
    "tStartMs": 545570,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "그래서 경비가 가서 잡고"
    } ]
  }, {
    "tStartMs": 547680,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "그걸 가서 노는 거고"
    } ]
  }, {
    "tStartMs": 548670,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "이게 노동당 소속 의원이었고"
    } ]
  }, {
    "tStartMs": 550500,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "보수당 의원들이 이 짓을 했다고"
    } ]
  }, {
    "tStartMs": 552290,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "퇴진을 요구하고"
    } ]
  }, {
    "tStartMs": 553240,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "실제로 퇴장당했습니다"
    } ]
  }, {
    "tStartMs": 554540,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "이거 들고 도망가려고 하다가"
    } ]
  }, {
    "tStartMs": 556270,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "이런 일이 벌어지는 게"
    } ]
  }, {
    "tStartMs": 557730,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "영국 의회라고 보시면 되고"
    } ]
  }, {
    "tStartMs": 559700,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "아까 전에 말씀드린 영국 상원 의자"
    } ]
  }, {
    "tStartMs": 561630,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "앉아있는 의자"
    } ]
  }, {
    "tStartMs": 563080,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "빨간 의자, 뒤에도 있죠?"
    } ]
  }, {
    "tStartMs": 564540,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "이것도 아까 말씀드린 메이스"
    } ]
  }, {
    "tStartMs": 566560,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "왕의 권위 같은"
    } ]
  }, {
    "tStartMs": 567550,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "메이스라고 할 수 있고"
    } ]
  }, {
    "tStartMs": 568450,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "앉아있는 의자는 의미가 있어요"
    } ]
  }, {
    "tStartMs": 570310,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "이거를 울색이라고 한다 그러는데"
    } ]
  }, {
    "tStartMs": 572010,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "이게 의자가 아니라"
    } ]
  }, {
    "tStartMs": 573180,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "양털 바구니입니다"
    } ]
  }, {
    "tStartMs": 574470,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "그러니까 양털 주머니"
    } ]
  }, {
    "tStartMs": 575860,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "콩주머니 같이 양털 가득 넣는 주머니예요"
    } ]
  }, {
    "tStartMs": 578310,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "왜냐하면 옛날에는 영국이 면화업으로"
    } ]
  }, {
    "tStartMs": 580430,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "세계에서 가장 부유한 국가가 됐잖아요"
    } ]
  }, {
    "tStartMs": 582130,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "영국의 상징을 양면화"
    } ]
  }, {
    "tStartMs": 584240,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "이런 걸 생각해서"
    } ]
  }, {
    "tStartMs": 585350,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "영국의 상징을 가득 넣은 거를"
    } ]
  }, {
    "tStartMs": 587010,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "영국의 부유함"
    } ]
  }, {
    "tStartMs": 588570,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "뭐 대형제국 그런 상징이죠"
    } ]
  }, {
    "tStartMs": 590170,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "거기 앉아있어요"
    } ]
  }, {
    "tStartMs": 591120,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "근데 재밌는 건"
    } ]
  }, {
    "tStartMs": 592580,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "여기까지가 상원이라고 합니다"
    } ]
  }, {
    "tStartMs": 594670,
    "dDurationMs": 520,
    "segs": [ {
      "utf8": "여기까지가"
    } ]
  }, {
    "tStartMs": 595190,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "무슨 소리냐?"
    } ]
  }, {
    "tStartMs": 596230,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "앉아있으면"
    } ]
  }, {
    "tStartMs": 597810,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "참석, 참여한 게 아니에요"
    } ]
  }, {
    "tStartMs": 599860,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "이딴 걸 왜 따지느냐"
    } ]
  }, {
    "tStartMs": 600720,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "저도 모르겠어요"
    } ]
  }, {
    "tStartMs": 602010,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "근데 얘네 그렇대"
    } ]
  }, {
    "tStartMs": 602970,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "상원의장이"
    } ]
  }, {
    "tStartMs": 604020,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "의견을 내기할 때"
    } ]
  }, {
    "tStartMs": 605370,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "앉아있으면"
    } ]
  }, {
    "tStartMs": 606010,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "너는 지금 의사당 밖에 있어"
    } ]
  }, {
    "tStartMs": 608150,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "일어서서 얘기를 해야 돼요"
    } ]
  }, {
    "tStartMs": 610730,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "이게 경계야"
    } ]
  }, {
    "tStartMs": 612020,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "그게 주는 권한이다 이런 거죠"
    } ]
  }, {
    "tStartMs": 613510,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "그래서 일어서서"
    } ]
  }, {
    "tStartMs": 614380,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "앉아서 얘기하면 안 들어"
    } ]
  }, {
    "tStartMs": 616320,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "일어서서 얘기해야 되는"
    } ]
  }, {
    "tStartMs": 617940,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "그런 게 있습니다"
    } ]
  }, {
    "tStartMs": 618550,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "그럼 울색을 치우면"
    } ]
  }, {
    "tStartMs": 619640,
    "dDurationMs": 370,
    "segs": [ {
      "utf8": "어떻게 되냐"
    } ]
  }, {
    "tStartMs": 620010,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "그건 저도 모르겠어요"
    } ]
  }, {
    "tStartMs": 621310,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "근데 귀족원이어서"
    } ]
  }, {
    "tStartMs": 622710,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "별로 치울 일은 없을"
    } ]
  }, {
    "tStartMs": 623700,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "것 같아요 귀족원이어서"
    } ]
  }, {
    "tStartMs": 624710,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "하여튼 그렇다고 합니다"
    } ]
  }, {
    "tStartMs": 625730,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "별의별 게 다 있는데"
    } ]
  }, {
    "tStartMs": 627290,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "그냥 그렇다는 걸 들으면 되고요"
    } ]
  }, {
    "tStartMs": 629310,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "그러면 다시 돌아와서"
    } ]
  }, {
    "tStartMs": 630390,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "다른 거 진짜 많아요"
    } ]
  }, {
    "tStartMs": 631460,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "700년이나 돼서"
    } ]
  }, {
    "tStartMs": 632260,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "별 희한한 것들이 많이 있더라고요"
    } ]
  }, {
    "tStartMs": 634390,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "그러면 우리가 궁금한 걸 넘어갑시다"
    } ]
  }, {
    "tStartMs": 636330,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "영국 귀족원"
    } ]
  }, {
    "tStartMs": 637420,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "영국 상원들의 멤버들은"
    } ]
  }, {
    "tStartMs": 639000,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "어떻게 선출되냐"
    } ]
  }, {
    "tStartMs": 640300,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "투표하냐 선거하냐?"
    } ]
  }, {
    "tStartMs": 642150,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "안 합니다"
    } ]
  }, {
    "tStartMs": 643060,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "영국 상원은 선출직이 아니에요"
    } ]
  }, {
    "tStartMs": 645300,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "선거로 뽑히지 않아요"
    } ]
  }, {
    "tStartMs": 646890,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "총리가 제청하고"
    } ]
  }, {
    "tStartMs": 648100,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "영국 왕이 임명합니다"
    } ]
  }, {
    "tStartMs": 650010,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "그러면 임명한 다음에"
    } ]
  }, {
    "tStartMs": 651200,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "임기는 몇 년이냐?"
    } ]
  }, {
    "tStartMs": 652160,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "임기는 종신입니다"
    } ]
  }, {
    "tStartMs": 654580,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "저거 종신직이에요"
    } ]
  }, {
    "tStartMs": 656280,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "한 번 임명받으면"
    } ]
  }, {
    "tStartMs": 658350,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "귀족이잖아"
    } ]
  }, {
    "tStartMs": 659190,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "귀족을 잠깐 하는 게 어딨어"
    } ]
  }, {
    "tStartMs": 661550,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "물론 귀족들이 임명을 받는 거긴 한데"
    } ]
  }, {
    "tStartMs": 663840,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "상원은 종신직입니다"
    } ]
  }, {
    "tStartMs": 665590,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "귀족들도 종신 귀족들이 많은데"
    } ]
  }, {
    "tStartMs": 667380,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "종신이냐 세습이냐로 나뉩니다"
    } ]
  }, {
    "tStartMs": 669340,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "여기서 잠깐 설명을 드리면"
    } ]
  }, {
    "tStartMs": 671130,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "세습 귀족이 있고"
    } ]
  }, {
    "tStartMs": 672120,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "종신 귀족이 있어요"
    } ]
  }, {
    "tStartMs": 673340,
    "dDurationMs": 300,
    "segs": [ {
      "utf8": "다르냐?"
    } ]
  }, {
    "tStartMs": 673640,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "달라요"
    } ]
  }, {
    "tStartMs": 674630,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "무슨 소리냐?"
    } ]
  }, {
    "tStartMs": 675760,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "세습 귀족은 내 아들도 귀족이야"
    } ]
  }, {
    "tStartMs": 677620,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "종신 귀족은"
    } ]
  }, {
    "tStartMs": 678760,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "내 라이프타임"
    } ]
  }, {
    "tStartMs": 679560,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "나까지만 귀족이에요"
    } ]
  }, {
    "tStartMs": 681400,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "그게 있습니다"
    } ]
  }, {
    "tStartMs": 682550,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "아들 대대로"
    } ]
  }, {
    "tStartMs": 683780,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "대대손손"
    } ]
  }, {
    "tStartMs": 684490,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "귀족이 될 수 있냐?"
    } ]
  }, {
    "tStartMs": 685670,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "나까지만 귀족이냐?"
    } ]
  }, {
    "tStartMs": 687010,
    "dDurationMs": 630,
    "segs": [ {
      "utf8": "이런 게 있는데"
    } ]
  }, {
    "tStartMs": 687640,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "좀 이따가 다시 설명드릴게요"
    } ]
  }, {
    "tStartMs": 689080,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "어쨌건 왕이 한번 임명하면"
    } ]
  }, {
    "tStartMs": 690900,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "평생 동안 상원위원직을"
    } ]
  }, {
    "tStartMs": 692850,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "유지할 수 있습니다"
    } ]
  }, {
    "tStartMs": 694200,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "그럼 명예직이냐?"
    } ]
  }, {
    "tStartMs": 695390,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "명예직이긴 한데"
    } ]
  }, {
    "tStartMs": 696490,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "돈이 나와요"
    } ]
  }, {
    "tStartMs": 697780,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "하루 일당이 60만원 정도 됩니다"
    } ]
  }, {
    "tStartMs": 699530,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "물론 여기에 상원의원으로 들어갈 정도면"
    } ]
  }, {
    "tStartMs": 702000,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "60만원 돈도 아닌 사람들이 들어가겠지만"
    } ]
  }, {
    "tStartMs": 704710,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "어쨌건 평생 비과세입니다"
    } ]
  }, {
    "tStartMs": 706810,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "비과세"
    } ]
  }, {
    "tStartMs": 707750,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "비과세로 급여가 나오고요"
    } ]
  }, {
    "tStartMs": 709610,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "평생 영국 상원의 피어스이기 때문에"
    } ]
  }, {
    "tStartMs": 712500,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "국회의사당 이런 데를"
    } ]
  }, {
    "tStartMs": 713680,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "평생 이용하는 겁니다"
    } ]
  }, {
    "tStartMs": 715000,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "영국 귀족이죠, 귀족"
    } ]
  }, {
    "tStartMs": 716230,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "말 그대로"
    } ]
  }, {
    "tStartMs": 717140,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "제가 방금 설명드렸지만"
    } ]
  }, {
    "tStartMs": 718840,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "영국 상원의원이 무려 800명이에요"
    } ]
  }, {
    "tStartMs": 721690,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "이 중에 680명은"
    } ]
  }, {
    "tStartMs": 723400,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "라이프타임 귀족이고"
    } ]
  }, {
    "tStartMs": 724720,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "종신 귀족"
    } ]
  }, {
    "tStartMs": 725980,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "세습 귀족도 있습니다"
    } ]
  }, {
    "tStartMs": 727640,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "훨씬 적어요"
    } ]
  }, {
    "tStartMs": 728760,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "훨씬"
    } ]
  }, {
    "tStartMs": 729460,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "이거 진짜 몇백 년간"
    } ]
  }, {
    "tStartMs": 730810,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "내려온 귀족들이야"
    } ]
  }, {
    "tStartMs": 731840,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "92명입니다 현재까지"
    } ]
  }, {
    "tStartMs": 733270,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "전체 세습 귀족이"
    } ]
  }, {
    "tStartMs": 734570,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "92명이라는 게 아니라"
    } ]
  }, {
    "tStartMs": 735990,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "상원에 있는 세습 귀족이 92명이에요"
    } ]
  }, {
    "tStartMs": 739250,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "그러면 세습 상원의원이"
    } ]
  }, {
    "tStartMs": 741710,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "92명이란 거잖아요"
    } ]
  }, {
    "tStartMs": 743360,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "그럼 이들은 아들도 상원의원이 될까?"
    } ]
  }, {
    "tStartMs": 746760,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "내가 상원의원이에요"
    } ]
  }, {
    "tStartMs": 749030,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "세습 상원의원"
    } ]
  }, {
    "tStartMs": 750000,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "세습 귀족 상원의원이야"
    } ]
  }, {
    "tStartMs": 751470,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "아들이 상원의원이 되냐?"
    } ]
  }, {
    "tStartMs": 753330,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "당연히 세습이니까"
    } ]
  }, {
    "tStartMs": 754740,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "당연히 됩니다"
    } ]
  }, {
    "tStartMs": 755830,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "당연히 돼요"
    } ]
  }, {
    "tStartMs": 756820,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "당연한 거야"
    } ]
  }, {
    "tStartMs": 758630,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "세습 귀족인데"
    } ]
  }, {
    "tStartMs": 759450,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "백작 아들이 백작이지 한 거잖아요"
    } ]
  }, {
    "tStartMs": 760730,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "백작 아들이  백작이지"
    } ]
  }, {
    "tStartMs": 762160,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "세습을 한다면"
    } ]
  }, {
    "tStartMs": 763150,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "그래서 그 귀족 가문들은"
    } ]
  }, {
    "tStartMs": 764930,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "수백 년 동안 상원을"
    } ]
  }, {
    "tStartMs": 766810,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "700년 가까이 물려받으면서"
    } ]
  }, {
    "tStartMs": 769300,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "영원히 계승하고 있습니다"
    } ]
  }, {
    "tStartMs": 771420,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "상원이 물론 별 힘이 없지만"
    } ]
  }, {
    "tStartMs": 772860,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "그래도 법률을 제정하고"
    } ]
  }, {
    "tStartMs": 773980,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "토론할 권리가 있거든요"
    } ]
  }, {
    "tStartMs": 775380,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "영원히 하고 있다고 보시면 되고요"
    } ]
  }, {
    "tStartMs": 778880,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "라이프타임"
    } ]
  }, {
    "tStartMs": 779830,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "종신 귀족보다"
    } ]
  }, {
    "tStartMs": 780680,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "세습 귀족이 훨씬 작죠"
    } ]
  }, {
    "tStartMs": 782220,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "당연히 그럴 수밖에 없는 게"
    } ]
  }, {
    "tStartMs": 783770,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "아주 오래전부터 귀족인 경우가 다입니다"
    } ]
  }, {
    "tStartMs": 786800,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "세습 귀족들은"
    } ]
  }, {
    "tStartMs": 787690,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "수백 년의 역사가 있고"
    } ]
  }, {
    "tStartMs": 789150,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "토지를, 영지를 갖고 있고"
    } ]
  }, {
    "tStartMs": 791070,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "작위를 세습 받고"
    } ]
  }, {
    "tStartMs": 792550,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "남작, 백작, 자작, 후작, 공작"
    } ]
  }, {
    "tStartMs": 794370,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "뭐 이런 사람들"
    } ]
  }, {
    "tStartMs": 795500,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "공작이 11명이고"
    } ]
  }, {
    "tStartMs": 796560,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "현재 상원에는"
    } ]
  }, {
    "tStartMs": 797490,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "백작이 26명이고"
    } ]
  }, {
    "tStartMs": 798630,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "뭐 그렇다고 합니다"
    } ]
  }, {
    "tStartMs": 800340,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "근데 우리가 보기에는"
    } ]
  }, {
    "tStartMs": 801210,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "야 이거 뭐야?"
    } ]
  }, {
    "tStartMs": 802230,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "세습도 하고"
    } ]
  }, {
    "tStartMs": 803860,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "선거도 안 하고"
    } ]
  }, {
    "tStartMs": 805050,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "자기들끼리 쿵짜리 쿵짜리"
    } ]
  }, {
    "tStartMs": 806540,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "이게 말이 됩니까?"
    } ]
  }, {
    "tStartMs": 807940,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "그래서 영국에서도"
    } ]
  }, {
    "tStartMs": 809400,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "이미 1999년 노동당 총리"
    } ]
  }, {
    "tStartMs": 811450,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "토니 블레어 때"
    } ]
  }, {
    "tStartMs": 812820,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "세습 귀족을 폐지하려고 그랬어요"
    } ]
  }, {
    "tStartMs": 814960,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "상원에서 세습 상원의원을 폐지하자"
    } ]
  }, {
    "tStartMs": 817360,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "이때 600명이"
    } ]
  }, {
    "tStartMs": 818540,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "넘는 세습 상원의원들이 축출됐어요"
    } ]
  }, {
    "tStartMs": 820980,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "지금은 상원이 종신 상원의원과"
    } ]
  }, {
    "tStartMs": 823080,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "세습 상원의원으로 나뉘어 있잖아요"
    } ]
  }, {
    "tStartMs": 824330,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "옛날에는 대부분 세습 상원의원이었는데"
    } ]
  }, {
    "tStartMs": 826450,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "그걸 다 없애고"
    } ]
  }, {
    "tStartMs": 828180,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "92명만 잠깐 남겨놨습니다"
    } ]
  }, {
    "tStartMs": 830090,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "임시방편으로"
    } ]
  }, {
    "tStartMs": 831510,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "그랬는데 그 92명의 세습 귀족들이"
    } ]
  }, {
    "tStartMs": 833810,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "지금 25년이 지났지만"
    } ]
  }, {
    "tStartMs": 835450,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "아직도 상원에 남아있는 겁니다"
    } ]
  }, {
    "tStartMs": 838100,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "아직도 물려받고 있고요"
    } ]
  }, {
    "tStartMs": 840120,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "그 다음 죽으면 누가 할지"
    } ]
  }, {
    "tStartMs": 841230,
    "dDurationMs": 540,
    "segs": [ {
      "utf8": "이런 거 투표를 해서"
    } ]
  }, {
    "tStartMs": 841770,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "그 다음 물려받고 하는데"
    } ]
  }, {
    "tStartMs": 843370,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "물론 방금 말씀드렸지만"
    } ]
  }, {
    "tStartMs": 845290,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "상원이 그렇게 큰 힘이 없다고 합니다"
    } ]
  }, {
    "tStartMs": 847280,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "영국에서는"
    } ]
  }, {
    "tStartMs": 847890,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "법률을 제정하고"
    } ]
  }, {
    "tStartMs": 849340,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "정부 활동을 견제하고"
    } ]
  }, {
    "tStartMs": 850840,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "이의를 제기까지는 하는데"
    } ]
  }, {
    "tStartMs": 852800,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "하원에서 법안을 발의되면"
    } ]
  }, {
    "tStartMs": 854650,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "상원에서 그걸 무효화시킬 수 있냐?"
    } ]
  }, {
    "tStartMs": 857200,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "아주 제한적인 경우를 제외하고는"
    } ]
  }, {
    "tStartMs": 859060,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "법안의 법률 제정도 막을 수가 없어요"
    } ]
  }, {
    "tStartMs": 862070,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "이걸 막을 수 있으면 이상하지"
    } ]
  }, {
    "tStartMs": 863480,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "막을 수 있으면 어떡해"
    } ]
  }, {
    "tStartMs": 864920,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "세습해서 상원위원이 되는데"
    } ]
  }, {
    "tStartMs": 866960,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "국민이 뽑은 대표"
    } ]
  }, {
    "tStartMs": 867990,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "하원이 법을 만들었었는데"
    } ]
  }, {
    "tStartMs": 869780,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "상원에서 싫어!"
    } ]
  }, {
    "tStartMs": 870900,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "이럴 수 있냐?"
    } ]
  }, {
    "tStartMs": 872260,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "거의 안 된다고 합니다"
    } ]
  }, {
    "tStartMs": 873140,
    "dDurationMs": 530,
    "segs": [ {
      "utf8": "제한적인 경우를 제외하고는"
    } ]
  }, {
    "tStartMs": 873670,
    "dDurationMs": 590,
    "segs": [ {
      "utf8": "거의 안 되는데"
    } ]
  }, {
    "tStartMs": 874260,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "다만 법안의 통과를"
    } ]
  }, {
    "tStartMs": 876260,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "재고해 줄 걸 요청할 수 있어요"
    } ]
  }, {
    "tStartMs": 877670,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "그러니까 하원으로 다시"
    } ]
  }, {
    "tStartMs": 878290,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "되돌려 보낼 수 있어"
    } ]
  }, {
    "tStartMs": 879810,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "결정사항을 재고해 달라"
    } ]
  }, {
    "tStartMs": 881030,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "그러니까 통과가 지연되거나"
    } ]
  }, {
    "tStartMs": 882270,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "시간을 끌 수 있는 거죠"
    } ]
  }, {
    "tStartMs": 884180,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "예를 들면 어떤 게 시간이 많이 끌리냐?"
    } ]
  }, {
    "tStartMs": 885800,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "자기들은 귀족이잖아요"
    } ]
  }, {
    "tStartMs": 887150,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "그러다 보니까"
    } ]
  }, {
    "tStartMs": 888040,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "고용이나"
    } ]
  }, {
    "tStartMs": 889370,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "시민권 이런 법안들은"
    } ]
  }, {
    "tStartMs": 891620,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "보통 다시"
    } ]
  }, {
    "tStartMs": 892580,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "되돌아가는 걸 많이 한다 그럽니다"
    } ]
  }, {
    "tStartMs": 894000,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "귀족에 불리한 거"
    } ]
  }, {
    "tStartMs": 895700,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "이런 것들이 다시 되돌아가는 경우가 많다"
    } ]
  }, {
    "tStartMs": 898070,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "그리고 이 종신 귀족들은"
    } ]
  }, {
    "tStartMs": 899380,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "그냥 왕이 임명을 하거든요"
    } ]
  }, {
    "tStartMs": 901010,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "그래서 계속 늘어납니다"
    } ]
  }, {
    "tStartMs": 903190,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "물론 자기가 죽으면 없어지지만"
    } ]
  }, {
    "tStartMs": 904980,
    "dDurationMs": 630,
    "segs": [ {
      "utf8": "그러다 보니까"
    } ]
  }, {
    "tStartMs": 905610,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "현재 영국 상원의원이"
    } ]
  }, {
    "tStartMs": 907260,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "무려 842명이에요"
    } ]
  }, {
    "tStartMs": 909440,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "이 정도면 상원이 아니라"
    } ]
  }, {
    "tStartMs": 911330,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "뭐라고 해야 되죠?"
    } ]
  }, {
    "tStartMs": 912060,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "이거 842명이면?"
    } ]
  }, {
    "tStartMs": 913270,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "거의 무슨 대학이야, 대학"
    } ]
  }, {
    "tStartMs": 915290,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "숫자가 말도 안 돼"
    } ]
  }, {
    "tStartMs": 916300,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "하원이 650명인데"
    } ]
  }, {
    "tStartMs": 918280,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "하원보다 상원이 더 많아"
    } ]
  }, {
    "tStartMs": 920520,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "보통은 상원이 훨씬 적습니다"
    } ]
  }, {
    "tStartMs": 922780,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "예를 들면 프랑스도 많은데"
    } ]
  }, {
    "tStartMs": 924080,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "348명"
    } ]
  }, {
    "tStartMs": 925050,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "독일은 69명이야"
    } ]
  }, {
    "tStartMs": 926230,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "여기는 계속 내니까"
    } ]
  }, {
    "tStartMs": 926990,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "권한도 없잖아요 별로"
    } ]
  }, {
    "tStartMs": 928250,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "842명 뭐가 좀 이상해졌죠"
    } ]
  }, {
    "tStartMs": 932030,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "그래서 처음으로 돌아가면"
    } ]
  }, {
    "tStartMs": 933900,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "영국 스타머 총리는 총선 전부터"
    } ]
  }, {
    "tStartMs": 936030,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "남아있는 92명의"
    } ]
  }, {
    "tStartMs": 937480,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "세습 상원 의석도 없애야 된다"
    } ]
  }, {
    "tStartMs": 939690,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "라는 걸 주장을 했고"
    } ]
  }, {
    "tStartMs": 941190,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "이걸로 의회를 개혁해야겠다"
    } ]
  }, {
    "tStartMs": 943250,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "그래서 자기가 총리가 된 다음에"
    } ]
  }, {
    "tStartMs": 944770,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "2026년"
    } ]
  }, {
    "tStartMs": 945730,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "25년이 지났죠"
    } ]
  }, {
    "tStartMs": 947090,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "600명이 쫓겨난 다음에"
    } ]
  }, {
    "tStartMs": 948660,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "92명의 남은 세습 위원들을"
    } ]
  }, {
    "tStartMs": 950370,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "축출하는 법안을"
    } ]
  }, {
    "tStartMs": 951470,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "이번에 통과시켰다는 겁니다"
    } ]
  }, {
    "tStartMs": 953100,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "저들은 세습이 아니라"
    } ]
  }, {
    "tStartMs": 954010,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "자기가 이제 끝나면"
    } ]
  }, {
    "tStartMs": 955410,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "자기가 죽어서"
    } ]
  }, {
    "tStartMs": 955970,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "그 상원의원 자리를 끝나면은"
    } ]
  }, {
    "tStartMs": 957870,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "이제 아들한테 못 물려주게 되는"
    } ]
  }, {
    "tStartMs": 959430,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "그런 거죠"
    } ]
  }, {
    "tStartMs": 960140,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "심지어 저 스타머 총리는 이렇게 얘기합니다"
    } ]
  }, {
    "tStartMs": 962350,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "아예 귀족원을 폐지해야 된다"
    } ]
  }, {
    "tStartMs": 964850,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "요즘 시대에 귀족원이 뭐야?"
    } ]
  }, {
    "tStartMs": 966990,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "그게 말이 되냐?"
    } ]
  }, {
    "tStartMs": 968220,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "상원은 게다가 국민들이 뽑지도 않잖아"
    } ]
  }, {
    "tStartMs": 970660,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "이런 구조를 옹호할 수는 없고"
    } ]
  }, {
    "tStartMs": 972340,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "상원을 폐지하고"
    } ]
  }, {
    "tStartMs": 973770,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "선출직 의원으로 구성된 상원으로"
    } ]
  }, {
    "tStartMs": 976100,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "차라리 만들던가"
    } ]
  }, {
    "tStartMs": 977400,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "아니면 없애자"
    } ]
  }, {
    "tStartMs": 978390,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "라는 거를 주장하고 있는 게"
    } ]
  }, {
    "tStartMs": 979500,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "보통 노동시장 쪽에서"
    } ]
  }, {
    "tStartMs": 980560,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "저런 얘기를 많이 하죠"
    } ]
  }, {
    "tStartMs": 981910,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "지금 영국의 상황이라고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 984180,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "이쯤에서 영국의 귀족에 대해서"
    } ]
  }, {
    "tStartMs": 985840,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "조금만 알아보면"
    } ]
  }, {
    "tStartMs": 986990,
    "dDurationMs": 650,
    "segs": [ {
      "utf8": "영국에는"
    } ]
  }, {
    "tStartMs": 987640,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "귀족들이 거의 3천 명에 가깝게 존재한다고 합니다"
    } ]
  }, {
    "tStartMs": 990820,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "준남작까지 포함해서"
    } ]
  }, {
    "tStartMs": 992310,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "작위를 가진 귀족들이"
    } ]
  }, {
    "tStartMs": 993440,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "2,700명인데"
    } ]
  }, {
    "tStartMs": 994810,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "준남작이라는"
    } ]
  }, {
    "tStartMs": 995780,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "작위가 가장 많고요"
    } ]
  }, {
    "tStartMs": 996690,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "1,200명"
    } ]
  }, {
    "tStartMs": 997420,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "종신 귀족이 700명"
    } ]
  }, {
    "tStartMs": 998780,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "둘을 합친 게 2,000명"
    } ]
  }, {
    "tStartMs": 1000180,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "1,900명 정도"
    } ]
  }, {
    "tStartMs": 1001470,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "여기까지는 그냥 라이프타임"
    } ]
  }, {
    "tStartMs": 1004220,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "여기 포함이 아니구나"
    } ]
  }, {
    "tStartMs": 1005330,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "세습 귀족이 800명 됩니다"
    } ]
  }, {
    "tStartMs": 1007770,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "찐찐찐 귀족이 한 800명이에요"
    } ]
  }, {
    "tStartMs": 1010390,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "종신 귀족은"
    } ]
  }, {
    "tStartMs": 1011170,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "훌륭한 일을 잘하는 게 있으면"
    } ]
  }, {
    "tStartMs": 1013080,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "국왕이 가끔 작위를 줘요"
    } ]
  }, {
    "tStartMs": 1014630,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "작위만 할 수 있는 거고"
    } ]
  }, {
    "tStartMs": 1016210,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "로드 누구 이런 거 붙이죠"
    } ]
  }, {
    "tStartMs": 1017990,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "찐 귀족은 한 800명이라고 할 수 있고요"
    } ]
  }, {
    "tStartMs": 1020190,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "영국의 귀족 작위를 순서대로 보면"
    } ]
  }, {
    "tStartMs": 1023220,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "공작, 듀크 최고위입니다 최고위"
    } ]
  }, {
    "tStartMs": 1025620,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "예를 들면"
    } ]
  }, {
    "tStartMs": 1026620,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "영국의 왕세자"
    } ]
  }, {
    "tStartMs": 1027440,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "이런 사람들은 듀크죠"
    } ]
  }, {
    "tStartMs": 1028860,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "왕자들 듀크 하잖아요"
    } ]
  }, {
    "tStartMs": 1030410,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "24명"
    } ]
  }, {
    "tStartMs": 1031450,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "물론 왕족은 다른 것도 많이 붙지만"
    } ]
  }, {
    "tStartMs": 1033410,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "이런 거 많이 갖고 있죠"
    } ]
  }, {
    "tStartMs": 1034710,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "후작 34명"
    } ]
  }, {
    "tStartMs": 1036220,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "백작 180명"
    } ]
  }, {
    "tStartMs": 1037590,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "여기까지는 이제 자작까지구나"
    } ]
  }, {
    "tStartMs": 1039380,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "찐찐찐찐 귀족들이고"
    } ]
  }, {
    "tStartMs": 1041040,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "자작도 100명"
    } ]
  }, {
    "tStartMs": 1042070,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "남작 400명"
    } ]
  }, {
    "tStartMs": 1043620,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "여기까지는 앞에"
    } ]
  }, {
    "tStartMs": 1044900,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "로드를 붙인다 그럽니다"
    } ]
  }, {
    "tStartMs": 1046550,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "로드 땡땡이"
    } ]
  }, {
    "tStartMs": 1047780,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "로드 땡땡이 이런 거 붙이죠"
    } ]
  }, {
    "tStartMs": 1049320,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "그러면 아까 전에 준남작 있었잖아요"
    } ]
  }, {
    "tStartMs": 1051710,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "준남작은 여기 없네요"
    } ]
  }, {
    "tStartMs": 1052900,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "준남작은 뭡니까?"
    } ]
  }, {
    "tStartMs": 1054130,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "준남작은 정확하게는 귀족이 아닙니다"
    } ]
  }, {
    "tStartMs": 1057380,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "정확하게는 평민이야"
    } ]
  }, {
    "tStartMs": 1058740,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "남작보다는 아래고"
    } ]
  }, {
    "tStartMs": 1060050,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "기사보다는 높아"
    } ]
  }, {
    "tStartMs": 1061640,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "우리로 치면 중인이야 중인"
    } ]
  }, {
    "tStartMs": 1063360,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "중인은 왜 있습니까?"
    } ]
  }, {
    "tStartMs": 1064830,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "세습을 해요"
    } ]
  }, {
    "tStartMs": 1066050,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "Sir가 붙습니다"
    } ]
  }, {
    "tStartMs": 1067190,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "Sir는 보통 기사들이 Sir가 붙죠"
    } ]
  }, {
    "tStartMs": 1069090,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "로드가 아니고 써인데"
    } ]
  }, {
    "tStartMs": 1070710,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "중위는 왜 생겼냐"
    } ]
  }, {
    "tStartMs": 1071630,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "준남작은 1611년에"
    } ]
  }, {
    "tStartMs": 1073790,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "당시의 제임스 1세가"
    } ]
  }, {
    "tStartMs": 1074910,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "세수 확보를 위해서"
    } ]
  }, {
    "tStartMs": 1076410,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "돈을 많이 주면"
    } ]
  }, {
    "tStartMs": 1078010,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "작위를 줬다 해서"
    } ]
  }, {
    "tStartMs": 1079710,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "준...작위가 준남작이라고 합니다"
    } ]
  }, {
    "tStartMs": 1083750,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "뭔지 알 것 같아요"
    } ]
  }, {
    "tStartMs": 1084550,
    "dDurationMs": 510,
    "segs": [ {
      "utf8": "돈 주면"
    } ]
  }, {
    "tStartMs": 1085060,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "옛날에 우리도 비슷한 거 있었죠"
    } ]
  }, {
    "tStartMs": 1087080,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "그래서 준남작도 작위라고 할 수 있지만"
    } ]
  }, {
    "tStartMs": 1089670,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "정확하게는"
    } ]
  }, {
    "tStartMs": 1090620,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "평민에 들어간다고 합니다"
    } ]
  }, {
    "tStartMs": 1092460,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "그러면 얼마 전에"
    } ]
  }, {
    "tStartMs": 1094010,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "데이비드 베컴이 기사 작위를 받았습니다"
    } ]
  }, {
    "tStartMs": 1096890,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "그리고 아니면 또 누가 받았죠?"
    } ]
  }, {
    "tStartMs": 1098630,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "퍼거슨 할아버지도 경이죠"
    } ]
  }, {
    "tStartMs": 1101070,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "맨유 감독"
    } ]
  }, {
    "tStartMs": 1102100,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "경이잖아"
    } ]
  }, {
    "tStartMs": 1102830,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "나이트"
    } ]
  }, {
    "tStartMs": 1103880,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "나이트가 귀족이냐"
    } ]
  }, {
    "tStartMs": 1105980,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "나이트는 귀족이 아닙니다"
    } ]
  }, {
    "tStartMs": 1107890,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "그냥 나이트예요"
    } ]
  }, {
    "tStartMs": 1108820,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "로드라고"
    } ]
  }, {
    "tStartMs": 1109720,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "로드 데이비드 베컴이라고 못 붙여요"
    } ]
  }, {
    "tStartMs": 1112330,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "써가 붙습니다"
    } ]
  }, {
    "tStartMs": 1114750,
    "dDurationMs": 460,
    "segs": [ {
      "utf8": "써가"
    } ]
  }, {
    "tStartMs": 1115210,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "바로 아래에 기사라고 보시면 되고요"
    } ]
  }, {
    "tStartMs": 1117740,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "참고로 이거 잠깐만"
    } ]
  }, {
    "tStartMs": 1118970,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "데이비드 베컴이"
    } ]
  }, {
    "tStartMs": 1119850,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "저 귀족 작위 받을 때"
    } ]
  }, {
    "tStartMs": 1121220,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "잠깐 보여드리면"
    } ]
  }, {
    "tStartMs": 1121950,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "앞에는 다 빼고"
    } ]
  }, {
    "tStartMs": 1123100,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "이걸 왜 보여드리냐면"
    } ]
  }, {
    "tStartMs": 1124500,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "아주 친근한 게 나와서 그래요"
    } ]
  }, {
    "tStartMs": 1131080,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "베컴이 기사 작위받는 장면인데"
    } ]
  }, {
    "tStartMs": 1137090,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "저작권에 걸렸어"
    } ]
  }, {
    "tStartMs": 1138010,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "갑자기 뜬금없이"
    } ]
  }, {
    "tStartMs": 1139670,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "우리가 잘 아는"
    } ]
  }, {
    "tStartMs": 1140530,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "골든 노래가 나오죠"
    } ]
  }, {
    "tStartMs": 1142290,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "왜 그런가 제가 알아보지는 않았는데"
    } ]
  }, {
    "tStartMs": 1143950,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "놀랍게도 본인들이 깐 겁니다"
    } ]
  }, {
    "tStartMs": 1145650,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "본인들이 깐 배경음악을"
    } ]
  }, {
    "tStartMs": 1147620,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "골든으로 하면서"
    } ]
  }, {
    "tStartMs": 1149040,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "기사 작위를 받는 그런 모습이 있었습니다"
    } ]
  }, {
    "tStartMs": 1151430,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "그리고 영국은"
    } ]
  }, {
    "tStartMs": 1152600,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "여전히 혈통 기반의 세습 귀족 작위가 있습니다"
    } ]
  }, {
    "tStartMs": 1155790,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "794개가 있어요"
    } ]
  }, {
    "tStartMs": 1157730,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "본인들은 적다고 생각하는 것 같아요"
    } ]
  }, {
    "tStartMs": 1159770,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "우리가 보기엔 무지하게 많은데"
    } ]
  }, {
    "tStartMs": 1161470,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "굉장히 작다"
    } ]
  }, {
    "tStartMs": 1162660,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "3천에 가깝다는 귀족 중에서도"
    } ]
  }, {
    "tStartMs": 1164610,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "세습 귀족은 794개뿐이다"
    } ]
  }, {
    "tStartMs": 1167340,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "나머지 귀족들은 이건 뭐 나이트지만"
    } ]
  }, {
    "tStartMs": 1169490,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "왕이 이렇게 받으면"
    } ]
  }, {
    "tStartMs": 1170760,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "라이프 타임"
    } ]
  }, {
    "tStartMs": 1171320,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "본인 생존만 하는데"
    } ]
  }, {
    "tStartMs": 1172960,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "이거는 진짜 세습하는 작위입니다"
    } ]
  }, {
    "tStartMs": 1175080,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "지금 세습 작위는"
    } ]
  }, {
    "tStartMs": 1176570,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "수여가 안 된다고 해요"
    } ]
  }, {
    "tStartMs": 1178150,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "왕족을 제외하면"
    } ]
  }, {
    "tStartMs": 1178850,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "새로운 세습 귀족 작위는"
    } ]
  }, {
    "tStartMs": 1180180,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "이제 수여되지 않는다"
    } ]
  }, {
    "tStartMs": 1181300,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "나는 영국의 세습 귀족이 되고 싶어요"
    } ]
  }, {
    "tStartMs": 1183020,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "불가능합니다"
    } ]
  }, {
    "tStartMs": 1183800,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "이제는 안 줘요"
    } ]
  }, {
    "tStartMs": 1184680,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "없앨 판에"
    } ]
  }, {
    "tStartMs": 1185460,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "지금 이걸 줄 리가 없죠"
    } ]
  }, {
    "tStartMs": 1187920,
    "dDurationMs": 550,
    "segs": [ {
      "utf8": "예를 들면"
    } ]
  }, {
    "tStartMs": 1188470,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "여러분들이 가장 잘 알 것 같은"
    } ]
  }, {
    "tStartMs": 1190360,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "영국의 세습 귀족"
    } ]
  }, {
    "tStartMs": 1191640,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "제가 한 번 보여드리겠습니다"
    } ]
  }, {
    "tStartMs": 1193260,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "샌드위치 백작이 있어요"
    } ]
  }, {
    "tStartMs": 1195370,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "공식 이름이 샌드위치입니다"
    } ]
  }, {
    "tStartMs": 1197040,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "가문이"
    } ]
  }, {
    "tStartMs": 1197940,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "왜 이름이 샌드위치입니까?"
    } ]
  }, {
    "tStartMs": 1199340,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "어떻게 이름을 그렇게 지었습니까?"
    } ]
  }, {
    "tStartMs": 1200780,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "그게 아니라"
    } ]
  }, {
    "tStartMs": 1201470,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "여러분들이 먹는 샌드위치가"
    } ]
  }, {
    "tStartMs": 1203090,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "이분이 만들어서 샌드위치예요"
    } ]
  }, {
    "tStartMs": 1205600,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "그러니까 우리가 어떻게"
    } ]
  }, {
    "tStartMs": 1206310,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "이름을 샌드위치라고 지었냐라고"
    } ]
  }, {
    "tStartMs": 1207560,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "말하면 안 되죠"
    } ]
  }, {
    "tStartMs": 1208530,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "그건 전후가 바뀐 겁니다"
    } ]
  }, {
    "tStartMs": 1210260,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "샌드위치 백작이 카드 게임을 하다가"
    } ]
  }, {
    "tStartMs": 1213080,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "너무 게임을 하고 싶으니까"
    } ]
  }, {
    "tStartMs": 1214350,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "야 이 자리에서 먹을 수 있게"
    } ]
  }, {
    "tStartMs": 1215410,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "빵 사이에 고기 껴와 해서"
    } ]
  }, {
    "tStartMs": 1216990,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "샌드위치가 됐다"
    } ]
  }, {
    "tStartMs": 1217890,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "이런 말이 있죠"
    } ]
  }, {
    "tStartMs": 1218730,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "진짜 그래서 샌드위치 백작인데"
    } ]
  }, {
    "tStartMs": 1221300,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "1,700년도 사람이죠"
    } ]
  }, {
    "tStartMs": 1222750,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "이게 역사에만 있냐?"
    } ]
  }, {
    "tStartMs": 1224070,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "아닙니다 지금도 있어요"
    } ]
  }, {
    "tStartMs": 1226220,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "세습 귀족입니다"
    } ]
  }, {
    "tStartMs": 1227650,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "샌드위치 백작의 후손들이"
    } ]
  }, {
    "tStartMs": 1229430,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "왼쪽에 있는 게"
    } ]
  }, {
    "tStartMs": 1230770,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "정말 영국에서 가장 유명한"
    } ]
  }, {
    "tStartMs": 1232430,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "저택 중에 하나라고 하는데"
    } ]
  }, {
    "tStartMs": 1233900,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "매퍼튼?"
    } ]
  }, {
    "tStartMs": 1234800,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "요게 대저탁이라고 합니다"
    } ]
  }, {
    "tStartMs": 1236190,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "샌드위치 백작이 여전히 살고 있고요"
    } ]
  }, {
    "tStartMs": 1238810,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "샌드위치 백작이 가지고 있는"
    } ]
  }, {
    "tStartMs": 1240380,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "땅이 얼마냐?"
    } ]
  }, {
    "tStartMs": 1241400,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "200만평 이상입니다"
    } ]
  }, {
    "tStartMs": 1242660,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "영지죠 영지"
    } ]
  }, {
    "tStartMs": 1244220,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "245만평"
    } ]
  }, {
    "tStartMs": 1246030,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "저들의 삶은 어떠나요?"
    } ]
  }, {
    "tStartMs": 1247400,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "여러분들이 볼 수 있어요"
    } ]
  }, {
    "tStartMs": 1248850,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "유튜브 채널이 있거든요"
    } ]
  }, {
    "tStartMs": 1250070,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "요즘은 그런 세상이에요"
    } ]
  }, {
    "tStartMs": 1251990,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "백작도 유튜브 채널을 운영하는 시대입니다"
    } ]
  }, {
    "tStartMs": 1255130,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "가시면 있어요"
    } ]
  }, {
    "tStartMs": 1255880,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "백작의 유튜브 채널"
    } ]
  }, {
    "tStartMs": 1257270,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "백작의 하루는 어떤지 가서 보실 수 있고요"
    } ]
  }, {
    "tStartMs": 1260450,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "매퍼튼인지 뭔지 가서 들어가는 모습"
    } ]
  }, {
    "tStartMs": 1262710,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "뭐 이런거 볼 수 있습니다"
    } ]
  }, {
    "tStartMs": 1263930,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "그리고 이렇게 얘기해요"
    } ]
  }, {
    "tStartMs": 1264620,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "본인들은 세속 작위이긴 하지만"
    } ]
  }, {
    "tStartMs": 1266680,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "그냥 여러분들과 똑같다"
    } ]
  }, {
    "tStartMs": 1268070,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "그냥 작은 저택에 있고"
    } ]
  }, {
    "tStartMs": 1269710,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "유튜브 채널을 통해서 알리고 있다"
    } ]
  }, {
    "tStartMs": 1271280,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "뭐 이런 유튜버입니다, 유튜버"
    } ]
  }, {
    "tStartMs": 1273480,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "반갑네"
    } ]
  }, {
    "tStartMs": 1274840,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "샌드위치 백작 반가워요"
    } ]
  }, {
    "tStartMs": 1276580,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "여러분들이 아는"
    } ]
  }, {
    "tStartMs": 1277590,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "영국의 대부분 유명한 장소들은"
    } ]
  }, {
    "tStartMs": 1279480,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "대부분 귀족 소유입니다"
    } ]
  }, {
    "tStartMs": 1281460,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "해리포터를 촬영한 성"
    } ]
  }, {
    "tStartMs": 1283810,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "요거는 노섬벌랜드 공작"
    } ]
  }, {
    "tStartMs": 1284760,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "가문의 소유고요"
    } ]
  }, {
    "tStartMs": 1285650,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "실제로 공작 거예요"
    } ]
  }, {
    "tStartMs": 1286920,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "1,309년에 샀다니까"
    } ]
  }, {
    "tStartMs": 1288500,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "700년, 700년 가까이"
    } ]
  }, {
    "tStartMs": 1291070,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "저 성을 소유하고 있는"
    } ]
  }, {
    "tStartMs": 1292460,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "공작 가문이라고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 1294050,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "근데 이렇게 얘기하니까"
    } ]
  }, {
    "tStartMs": 1295400,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "700년 동안 성을 갖고 있었잖아요"
    } ]
  }, {
    "tStartMs": 1297420,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "되게 특별한 경우구나"
    } ]
  }, {
    "tStartMs": 1298490,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "아닙니다"
    } ]
  }, {
    "tStartMs": 1299450,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "자, 이게 오늘의 주제입니다"
    } ]
  }, {
    "tStartMs": 1300700,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "영국 귀족들은 사실상 지금도"
    } ]
  }, {
    "tStartMs": 1303440,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "영국을 소유하고 있습니다"
    } ]
  }, {
    "tStartMs": 1306770,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "그게 무슨 말이냐?"
    } ]
  }, {
    "tStartMs": 1308100,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "뭔가 지배하고 있다는 거냐?"
    } ]
  }, {
    "tStartMs": 1309530,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "지배는 당연히 국민들이 뽑은"
    } ]
  }, {
    "tStartMs": 1311750,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "영국 하원이 정치적인 활동을 많이 하니까,"
    } ]
  }, {
    "tStartMs": 1313770,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "결정을 하니까"
    } ]
  }, {
    "tStartMs": 1314660,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "지배는 영국 국민들이 하고 있죠"
    } ]
  }, {
    "tStartMs": 1316470,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "뭐 왕은 형식적일 뿐이고"
    } ]
  }, {
    "tStartMs": 1318170,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "그러나 물리적 토지는"
    } ]
  }, {
    "tStartMs": 1320550,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "거의 30% 이상"
    } ]
  }, {
    "tStartMs": 1321950,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "40%로"
    } ]
  }, {
    "tStartMs": 1322850,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "귀족들이 갖고 있습니다"
    } ]
  }, {
    "tStartMs": 1324460,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "말이 안 될 것 같죠?"
    } ]
  }, {
    "tStartMs": 1326040,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "현재 공식적으로"
    } ]
  }, {
    "tStartMs": 1327080,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "국토의 3분의 1을"
    } ]
  }, {
    "tStartMs": 1328750,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "작위를 가진 귀족들이 가지고 있습니다"
    } ]
  }, {
    "tStartMs": 1331940,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "지금 현재 영국 토지의"
    } ]
  }, {
    "tStartMs": 1334690,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "50%를"
    } ]
  }, {
    "tStartMs": 1335410,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "1% 미만 인구가 소유하고 있는데"
    } ]
  }, {
    "tStartMs": 1337720,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "한 2만 5천 명 된다 그래요"
    } ]
  }, {
    "tStartMs": 1339680,
    "dDurationMs": 450,
    "segs": [ {
      "utf8": "주로 귀족들"
    } ]
  }, {
    "tStartMs": 1340130,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "아니면 기업인들입니다"
    } ]
  }, {
    "tStartMs": 1341400,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "요거를 표로 보여드리면"
    } ]
  }, {
    "tStartMs": 1343230,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "영국 전체 토지의 30%가"
    } ]
  }, {
    "tStartMs": 1345620,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "귀족과 기사가 갖고 있고요"
    } ]
  }, {
    "tStartMs": 1347430,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "여기서 말하는 토지가"
    } ]
  }, {
    "tStartMs": 1348380,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "산까지 다 들어가는 건지"
    } ]
  }, {
    "tStartMs": 1349330,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "정확히 모르겠는데"
    } ]
  }, {
    "tStartMs": 1350740,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "표시는 이렇게 됩니다"
    } ]
  }, {
    "tStartMs": 1351740,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "기업의 한 18%"
    } ]
  }, {
    "tStartMs": 1352900,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "산 이런 건 빼겠죠"
    } ]
  }, {
    "tStartMs": 1354240,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "그건 국유지니까"
    } ]
  }, {
    "tStartMs": 1355430,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "국유지는 아마 빼고"
    } ]
  }, {
    "tStartMs": 1356560,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "다른 토지만 의미하는 것 같아요"
    } ]
  }, {
    "tStartMs": 1358230,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "금융자본 있고"
    } ]
  }, {
    "tStartMs": 1358890,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "17%는 알 수 없고"
    } ]
  }, {
    "tStartMs": 1360250,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "가장 놀라운 건"
    } ]
  }, {
    "tStartMs": 1361620,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "일반 국민들은"
    } ]
  }, {
    "tStartMs": 1362660,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "단 5%의"
    } ]
  }, {
    "tStartMs": 1363760,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "토지를 보유하고 있습니다"
    } ]
  }, {
    "tStartMs": 1365860,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "이게 우리는 이해가 안 되죠"
    } ]
  }, {
    "tStartMs": 1368000,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "귀족과 기사가 전체 토지의 30%인데"
    } ]
  }, {
    "tStartMs": 1371150,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "일반 국민들은 5%예요"
    } ]
  }, {
    "tStartMs": 1373530,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "나머지는 기업, 금융자본,"
    } ]
  }, {
    "tStartMs": 1375210,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "심지어 알 수 없음도 있습니다"
    } ]
  }, {
    "tStartMs": 1377020,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "알 수 없음은 뭐냐?"
    } ]
  }, {
    "tStartMs": 1378830,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "소유자를 알 수 없다고"
    } ]
  }, {
    "tStartMs": 1380010,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "나오는 17%의 토지는"
    } ]
  }, {
    "tStartMs": 1381370,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "대부분 귀족들의 소유입니다"
    } ]
  }, {
    "tStartMs": 1383800,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "사실은 30%가 아니에요"
    } ]
  }, {
    "tStartMs": 1385580,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "이게 40%가 넘는 겁니다"
    } ]
  }, {
    "tStartMs": 1387420,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "이걸 더해야 돼"
    } ]
  }, {
    "tStartMs": 1388340,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "30 더하기 17 해서"
    } ]
  }, {
    "tStartMs": 1389560,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "맥스 47인데"
    } ]
  }, {
    "tStartMs": 1390780,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "한 40% 이상이라고 보면 되겠죠"
    } ]
  }, {
    "tStartMs": 1393160,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "전체 이용 가능한 토지의"
    } ]
  }, {
    "tStartMs": 1395070,
    "dDurationMs": 4130,
    "segs": [ {
      "utf8": "40% 이상을 귀족과 기사들이 갖고 있으니까"
    } ]
  }, {
    "tStartMs": 1399200,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "물리적으로 소유하고 있다고 봐도"
    } ]
  }, {
    "tStartMs": 1401050,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "틀린 말은 아니죠"
    } ]
  }, {
    "tStartMs": 1402140,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "그런데 어떻게"
    } ]
  }, {
    "tStartMs": 1402700,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "알 수 없음이 될 수 있냐?"
    } ]
  }, {
    "tStartMs": 1403840,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "그거는 우리나라적으로 생각해서 그래요"
    } ]
  }, {
    "tStartMs": 1406450,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "영국은 공공기관 같은 데 가서"
    } ]
  }, {
    "tStartMs": 1408650,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "토지 소유권을 우리가 등기치거나"
    } ]
  }, {
    "tStartMs": 1410410,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "기록할 의무가 없는 나라입니다"
    } ]
  }, {
    "tStartMs": 1412640,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "그러니까 우리식으로"
    } ]
  }, {
    "tStartMs": 1414010,
    "dDurationMs": 420,
    "segs": [ {
      "utf8": "구청 가서"
    } ]
  }, {
    "tStartMs": 1414430,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "반드시 신고해야지"
    } ]
  }, {
    "tStartMs": 1415300,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "이런 게 잘 없어요"
    } ]
  }, {
    "tStartMs": 1416400,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "이제 우리처럼"
    } ]
  }, {
    "tStartMs": 1417120,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "중앙 집권화가 확실한 나라는"
    } ]
  }, {
    "tStartMs": 1418660,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "그렇게 생각하는데"
    } ]
  }, {
    "tStartMs": 1419850,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "여기는 개인주의니까"
    } ]
  }, {
    "tStartMs": 1420850,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "네가 알아서 뭐 하게"
    } ]
  }, {
    "tStartMs": 1421530,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "이런 생각이잖아요"
    } ]
  }, {
    "tStartMs": 1422640,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "그래서 소유권을 신고하는 건"
    } ]
  }, {
    "tStartMs": 1424930,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "토지 거래할 때"
    } ]
  }, {
    "tStartMs": 1426310,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "이럴 때 소유권을 신고하는데"
    } ]
  }, {
    "tStartMs": 1427940,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "귀족들의 영지는"
    } ]
  }, {
    "tStartMs": 1429370,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "공개 시장에서 매매되지 않습니다"
    } ]
  }, {
    "tStartMs": 1431480,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "일반적으로"
    } ]
  }, {
    "tStartMs": 1432330,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "망하면 모르겠는데"
    } ]
  }, {
    "tStartMs": 1433720,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "귀족들의 영지는 매매가 안 돼요"
    } ]
  }, {
    "tStartMs": 1435680,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "안 팔아"
    } ]
  }, {
    "tStartMs": 1436590,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "아예 그 트러스트 신탁에"
    } ]
  }, {
    "tStartMs": 1438060,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "써 있는 경우도 많아요"
    } ]
  }, {
    "tStartMs": 1439570,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "이 토지는 매매하지 않는다"
    } ]
  }, {
    "tStartMs": 1441550,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "그래서 수색이 거의"
    } ]
  }, {
    "tStartMs": 1442480,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "몇백 년 동안 거래 없이"
    } ]
  }, {
    "tStartMs": 1444240,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "가문 대대로 이어져 왔기 때문에"
    } ]
  }, {
    "tStartMs": 1445940,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "소유권이 신고가 안 돼 있으면"
    } ]
  }, {
    "tStartMs": 1447340,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "모르는 거예요"
    } ]
  }, {
    "tStartMs": 1448440,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "신고를 하면"
    } ]
  }, {
    "tStartMs": 1449160,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "그때서야 알게 되는"
    } ]
  }, {
    "tStartMs": 1450550,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "토지가 17%라는 거고요"
    } ]
  }, {
    "tStartMs": 1452920,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "이거를 정리해 보면"
    } ]
  }, {
    "tStartMs": 1454200,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "토지의 40% 넘게"
    } ]
  }, {
    "tStartMs": 1456410,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "귀족들이 소유하고"
    } ]
  }, {
    "tStartMs": 1457670,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "일반 국민들은 단 5%를"
    } ]
  }, {
    "tStartMs": 1459410,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "소유하는 게 영국이라고 하고요"
    } ]
  }, {
    "tStartMs": 1461900,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "한마디로 어쨌건 굉장히"
    } ]
  }, {
    "tStartMs": 1463800,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "부하 권력 측면에서"
    } ]
  }, {
    "tStartMs": 1464670,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "귀족은 뭐 아직도 있는 거죠"
    } ]
  }, {
    "tStartMs": 1466510,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "자 그러면 우리가 드는 궁금증은"
    } ]
  }, {
    "tStartMs": 1468810,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "일반 국민들이"
    } ]
  }, {
    "tStartMs": 1469700,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "사용 가능한 토지"
    } ]
  }, {
    "tStartMs": 1470800,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "5% 사용하는 게 말이 되냐?"
    } ]
  }, {
    "tStartMs": 1472730,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "이유가 있습니다"
    } ]
  }, {
    "tStartMs": 1473780,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "정확하게는 5%가 아니에요 사실"
    } ]
  }, {
    "tStartMs": 1475290,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "사실 더 많이 가지고 있죠?"
    } ]
  }, {
    "tStartMs": 1477370,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "이거보다 훨씬 많이 가지고 있어요"
    } ]
  }, {
    "tStartMs": 1478710,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "근데 공식적으로는 그래요"
    } ]
  }, {
    "tStartMs": 1480380,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "왜냐하면 소유라는 개념이"
    } ]
  }, {
    "tStartMs": 1481360,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "두 개로 나뉘어서 그렇습니다"
    } ]
  }, {
    "tStartMs": 1482330,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "영국은 리스홀드라는 거와"
    } ]
  }, {
    "tStartMs": 1484720,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "프리홀드라는 게 있어요"
    } ]
  }, {
    "tStartMs": 1486550,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "예전에 슈카월드에 한 번 나왔어요"
    } ]
  }, {
    "tStartMs": 1487910,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "프리홀드는 우리가 생각하는 소유권이에요"
    } ]
  }, {
    "tStartMs": 1490370,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "토지와 건물의 완전한 소유권"
    } ]
  }, {
    "tStartMs": 1492890,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "그럼 리스홀드는 뭐냐?"
    } ]
  }, {
    "tStartMs": 1494900,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "초장기 임대계약 보시면 됩니다"
    } ]
  }, {
    "tStartMs": 1496570,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "우리나라도 여의도 어떤 건물이"
    } ]
  }, {
    "tStartMs": 1498420,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "99년 임대차 계약"
    } ]
  }, {
    "tStartMs": 1499480,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "이런 거 맺죠"
    } ]
  }, {
    "tStartMs": 1500180,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "서울시하고 99년"
    } ]
  }, {
    "tStartMs": 1501590,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "땅 임대차 맺고 막 그러는데"
    } ]
  }, {
    "tStartMs": 1503160,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "리스홀드는 그렇게 임대기간이"
    } ]
  }, {
    "tStartMs": 1504620,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "엄청나게 긴 임대차 계약입니다"
    } ]
  }, {
    "tStartMs": 1506870,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "사실상 리스홀더들은"
    } ]
  }, {
    "tStartMs": 1508510,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "자기 거라고 생각을 해요"
    } ]
  }, {
    "tStartMs": 1509880,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "99년이면 한 인간의 범위를 넘잖아요"
    } ]
  }, {
    "tStartMs": 1512500,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "200년 리스홀드도 있습니다"
    } ]
  }, {
    "tStartMs": 1514280,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "999년 리스홀드도 있어요"
    } ]
  }, {
    "tStartMs": 1516480,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "999년은 뭐야?"
    } ]
  }, {
    "tStartMs": 1517970,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "그럼 소유권이지 사실상"
    } ]
  }, {
    "tStartMs": 1519940,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "사실상 소유권인데"
    } ]
  }, {
    "tStartMs": 1521390,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "공식적인 땅 주인은 사실 따로 있는 거죠"
    } ]
  }, {
    "tStartMs": 1524410,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "이해가 안 되실 것 같아서"
    } ]
  }, {
    "tStartMs": 1525830,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "좀 설명을 해드리겠습니다"
    } ]
  }, {
    "tStartMs": 1527500,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "보면 볼수록 신기한데"
    } ]
  }, {
    "tStartMs": 1529000,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "영국 귀족들은 자신의 영지,"
    } ]
  }, {
    "tStartMs": 1530590,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "토지를 매매하지 않거나"
    } ]
  }, {
    "tStartMs": 1531860,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "또는 매매하지 못합니다"
    } ]
  }, {
    "tStartMs": 1533660,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "리스홀드를 하는데"
    } ]
  }, {
    "tStartMs": 1534970,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "임대차를 주는데"
    } ]
  }, {
    "tStartMs": 1535990,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "기간은 90년에서"
    } ]
  }, {
    "tStartMs": 1537190,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "999년까지 줄 수 있어요"
    } ]
  }, {
    "tStartMs": 1539690,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "999년은 뭐야?"
    } ]
  }, {
    "tStartMs": 1540940,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "그냥 준 거죠"
    } ]
  }, {
    "tStartMs": 1541550,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "사실 준 건데"
    } ]
  }, {
    "tStartMs": 1542750,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "어쨌건 영지니까 줄 수는 없고"
    } ]
  }, {
    "tStartMs": 1545430,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "겉은 내 걸로 치자"
    } ]
  }, {
    "tStartMs": 1546750,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "하지만 네 거야"
    } ]
  }, {
    "tStartMs": 1547630,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "뭐 이게 되는 겁니다"
    } ]
  }, {
    "tStartMs": 1548980,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "그래야 영국 귀족들의 토지"
    } ]
  }, {
    "tStartMs": 1549950,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "비중이 40% 육박하는데"
    } ]
  }, {
    "tStartMs": 1551900,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "방금 말씀하셨지만"
    } ]
  }, {
    "tStartMs": 1552650,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "리소홀드 권리만 매매하고"
    } ]
  }, {
    "tStartMs": 1554610,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "프리홀더 진짜 소유권은"
    } ]
  }, {
    "tStartMs": 1556100,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "거의 매매하지 않죠"
    } ]
  }, {
    "tStartMs": 1557120,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "이게 규모가 얼마나 되냐"
    } ]
  }, {
    "tStartMs": 1558680,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "영국 주택 규모의"
    } ]
  }, {
    "tStartMs": 1560310,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "무려"
    } ]
  }, {
    "tStartMs": 1561020,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "19%가 리소홀드라고 합니다"
    } ]
  }, {
    "tStartMs": 1563560,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "477만 채"
    } ]
  }, {
    "tStartMs": 1565720,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "실제 주인은 있는 거예요"
    } ]
  }, {
    "tStartMs": 1567430,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "영지건 귀족이건 누군지 몰라도"
    } ]
  }, {
    "tStartMs": 1569300,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "실제 우리가 생각하는 소유권 따로 있는데"
    } ]
  }, {
    "tStartMs": 1571890,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "이 위에 400만 채 이상의"
    } ]
  }, {
    "tStartMs": 1574170,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "주택이 있죠"
    } ]
  }, {
    "tStartMs": 1575350,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "전체 주택이 19%"
    } ]
  }, {
    "tStartMs": 1576720,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "그리고 이들은 아까 말씀드렸지만"
    } ]
  }, {
    "tStartMs": 1578180,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "본인들이 사실상 소유자"
    } ]
  }, {
    "tStartMs": 1579800,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "99년이면"
    } ]
  }, {
    "tStartMs": 1580520,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "내 평생이잖아요"
    } ]
  }, {
    "tStartMs": 1581560,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "200년이면"
    } ]
  }, {
    "tStartMs": 1582400,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "뭐 200년이면 언제입니까?"
    } ]
  }, {
    "tStartMs": 1583690,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "200년 전에 우리 조선시대였잖아"
    } ]
  }, {
    "tStartMs": 1585530,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "뭐 그런 생각을 하니까"
    } ]
  }, {
    "tStartMs": 1587120,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "그래서 리스홀드를 받은 사람들은"
    } ]
  }, {
    "tStartMs": 1589470,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "56%는 본인이 주인이라고 살고 있고"
    } ]
  }, {
    "tStartMs": 1591730,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "38%는 내 거니까"
    } ]
  }, {
    "tStartMs": 1592990,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "다시 월세를 줘요"
    } ]
  }, {
    "tStartMs": 1594390,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "뭐 그렇다고 합니다"
    } ]
  }, {
    "tStartMs": 1596560,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "19%는 별로 안 많네요"
    } ]
  }, {
    "tStartMs": 1598070,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "런던에 가면"
    } ]
  }, {
    "tStartMs": 1599520,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "런던 주거용 부동산의"
    } ]
  }, {
    "tStartMs": 1601190,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "무려 36%가 장기임대"
    } ]
  }, {
    "tStartMs": 1603600,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "소위 말해 리스홀드라고 합니다"
    } ]
  }, {
    "tStartMs": 1605760,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "세 채 중에 한 채는"
    } ]
  }, {
    "tStartMs": 1607160,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "진짜 소유자가 따로 있어요"
    } ]
  }, {
    "tStartMs": 1608920,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "130만 채가 넘는다고 해요"
    } ]
  }, {
    "tStartMs": 1610930,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "그리고 만약에"
    } ]
  }, {
    "tStartMs": 1612250,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "아파트를 산다"
    } ]
  }, {
    "tStartMs": 1613580,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "런던 아파트의 약 62%가 리스홀드입니다"
    } ]
  }, {
    "tStartMs": 1616810,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "진짜 주인 따로 있어요"
    } ]
  }, {
    "tStartMs": 1618020,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "그리고 실제 거래되는 아파트들은"
    } ]
  }, {
    "tStartMs": 1619680,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "거의 99%가 리스홀드라고 할 정도로"
    } ]
  }, {
    "tStartMs": 1622290,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "프리홀드는 안 나온다는 겁니다"
    } ]
  }, {
    "tStartMs": 1624350,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "안 팔어!"
    } ]
  }, {
    "tStartMs": 1624910,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "진짜 소유권은 안 나오는"
    } ]
  }, {
    "tStartMs": 1626200,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "거래가 안 된다고 보시면 되고"
    } ]
  }, {
    "tStartMs": 1628200,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "옛날에 한번 소개시켜드렸죠"
    } ]
  }, {
    "tStartMs": 1629910,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "이거 웨스트민스터 공작 가문"
    } ]
  }, {
    "tStartMs": 1631680,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "이거 한번 소개시켜드렸는데"
    } ]
  }, {
    "tStartMs": 1633020,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "스물 몇 살 때는"
    } ]
  }, {
    "tStartMs": 1634320,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "공작이 이걸 물려받아서"
    } ]
  }, {
    "tStartMs": 1635960,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "축하할 때만 나왔는데"
    } ]
  }, {
    "tStartMs": 1637240,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "이 공작 가문이 가지고 있는 토지를 보면"
    } ]
  }, {
    "tStartMs": 1639900,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "이렇게 돼 있습니다"
    } ]
  }, {
    "tStartMs": 1641260,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "동이에요 동 거의"
    } ]
  }, {
    "tStartMs": 1642450,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "명동을 가지고 있어"
    } ]
  }, {
    "tStartMs": 1644340,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "이게 영국 최중심부입니다"
    } ]
  }, {
    "tStartMs": 1645740,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "가운데 있는 게 버킹엄 궁정이에요"
    } ]
  }, {
    "tStartMs": 1648290,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "이거 템즈강이고"
    } ]
  }, {
    "tStartMs": 1649140,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "영국 최중심부의"
    } ]
  }, {
    "tStartMs": 1650600,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "명동이 자기 거야"
    } ]
  }, {
    "tStartMs": 1652730,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "자기 가문 거야"
    } ]
  }, {
    "tStartMs": 1654140,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "자기 가문께 된 지는"
    } ]
  }, {
    "tStartMs": 1655480,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "300년 됐어"
    } ]
  }, {
    "tStartMs": 1657940,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "1700년대부터 저거를 지금까지"
    } ]
  }, {
    "tStartMs": 1660570,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "동으로 갖고 있어요 동으로"
    } ]
  }, {
    "tStartMs": 1662330,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "이런 공작 가문이"
    } ]
  }, {
    "tStartMs": 1663140,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "여기 하나냐"
    } ]
  }, {
    "tStartMs": 1664680,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "런던에만 16개 가문이"
    } ]
  }, {
    "tStartMs": 1666970,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "177만 평을 프리홀드하고 있습니다"
    } ]
  }, {
    "tStartMs": 1669980,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "영원한 소유권"
    } ]
  }, {
    "tStartMs": 1671310,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "매물로 나오지 않는"
    } ]
  }, {
    "tStartMs": 1672490,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "런던 중심에만"
    } ]
  }, {
    "tStartMs": 1673700,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "여기 지금 잘라놓은 게"
    } ]
  }, {
    "tStartMs": 1674740,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "다 누구 거 누구 거 얘기한 거예요"
    } ]
  }, {
    "tStartMs": 1676310,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "누구 거 누구 거 얘기한 거야"
    } ]
  }, {
    "tStartMs": 1678070,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "이런 식으로"
    } ]
  }, {
    "tStartMs": 1679220,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "이렇게 돼 있죠"
    } ]
  }, {
    "tStartMs": 1680000,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "여기 다 무슨 공작, 무슨 백작"
    } ]
  }, {
    "tStartMs": 1682180,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "무슨 귀족"
    } ]
  }, {
    "tStartMs": 1683290,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "뭐 뭐시기 트러스트"
    } ]
  }, {
    "tStartMs": 1685030,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "뭐 이런 데인 거예요"
    } ]
  }, {
    "tStartMs": 1685930,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "서울시 중구가 292만 평인데"
    } ]
  }, {
    "tStartMs": 1688200,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "굳이 지금 잘 아는 거"
    } ]
  }, {
    "tStartMs": 1689220,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "중구의 한 3분의 2 정도 되는"
    } ]
  }, {
    "tStartMs": 1690640,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "정도의 크기는"
    } ]
  }, {
    "tStartMs": 1691660,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "소유주가 따로 있다는 거죠"
    } ]
  }, {
    "tStartMs": 1694010,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "물론 이렇게 얘기 드리면"
    } ]
  }, {
    "tStartMs": 1695420,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "아니, 쟤네는 상속세가 없나?"
    } ]
  }, {
    "tStartMs": 1698260,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "무슨 뭐 300년간 상속을 하고"
    } ]
  }, {
    "tStartMs": 1700340,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "그럼 상속세가 없냐?"
    } ]
  }, {
    "tStartMs": 1702480,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "영국에는 우리가 생각하기엔"
    } ]
  }, {
    "tStartMs": 1703880,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "이해가 안 되는 제도가 많은데"
    } ]
  }, {
    "tStartMs": 1704900,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "첫 번째,"
    } ]
  }, {
    "tStartMs": 1705820,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "문화유산 면세 제도가 있습니다"
    } ]
  }, {
    "tStartMs": 1708060,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "무슨 말입니까?"
    } ]
  }, {
    "tStartMs": 1709240,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "이런 건 문화유산이라는 거예요"
    } ]
  }, {
    "tStartMs": 1711030,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "아까 전에 무슨 성 어디 갔죠?"
    } ]
  }, {
    "tStartMs": 1712730,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "이런 성"
    } ]
  }, {
    "tStartMs": 1713720,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "영지 이건 문화유산이야"
    } ]
  }, {
    "tStartMs": 1715830,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "당연히 면세지"
    } ]
  }, {
    "tStartMs": 1716750,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "내가 소유하는 게 아니라"
    } ]
  }, {
    "tStartMs": 1717820,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "난 관리하는 거야"
    } ]
  }, {
    "tStartMs": 1718900,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "실제로 그렇게 얘기합니다"
    } ]
  }, {
    "tStartMs": 1720430,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "우리 가문이 관리하는 문화유산이야"
    } ]
  }, {
    "tStartMs": 1723650,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "해리포터 찍고 하잖아"
    } ]
  }, {
    "tStartMs": 1724680,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "문화유산"
    } ]
  }, {
    "tStartMs": 1725340,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "그러기 때문에"
    } ]
  }, {
    "tStartMs": 1726440,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "문화유산 면세 제도로"
    } ]
  }, {
    "tStartMs": 1727940,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "상속세를 면제 받을 수"
    } ]
  }, {
    "tStartMs": 1729430,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "물론 문화유산이 되려면"
    } ]
  }, {
    "tStartMs": 1731010,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "저기를 주기적으로"
    } ]
  }, {
    "tStartMs": 1732100,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "일반인들한테 공개해야 됩니다"
    } ]
  }, {
    "tStartMs": 1734040,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "여러분들 영국 돌아다닐 때"
    } ]
  }, {
    "tStartMs": 1735610,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "저런 성 같은데"
    } ]
  }, {
    "tStartMs": 1736400,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "문 열려있는 데가 많아요"
    } ]
  }, {
    "tStartMs": 1737290,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "그냥 가서 보면 돼"
    } ]
  }, {
    "tStartMs": 1738390,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "와 여기 나를 위해서"
    } ]
  }, {
    "tStartMs": 1739420,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "이렇게 열어뒀구나"
    } ]
  }, {
    "tStartMs": 1740080,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "아니 세금 안 받으려고"
    } ]
  }, {
    "tStartMs": 1741850,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "문화유산이 되려면"
    } ]
  }, {
    "tStartMs": 1743010,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "그 문을 주기적으로 열어놔야 돼요"
    } ]
  }, {
    "tStartMs": 1744700,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "열어놓는 시즌이 있습니다"
    } ]
  }, {
    "tStartMs": 1745860,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "그래서 어지간한 성들은"
    } ]
  }, {
    "tStartMs": 1747330,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "들어가서 볼 수 있습니다"
    } ]
  }, {
    "tStartMs": 1749340,
    "dDurationMs": 650,
    "segs": [ {
      "utf8": "방금 얘기했죠?"
    } ]
  }, {
    "tStartMs": 1749990,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "일반인에게 관람을 허용을 해야"
    } ]
  }, {
    "tStartMs": 1752370,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "세금 감면 혜택을 받을 수 있습니다"
    } ]
  }, {
    "tStartMs": 1754350,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "그래서 여러분들이 관람할 수 있는"
    } ]
  }, {
    "tStartMs": 1756070,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "그런 성들이 많고요"
    } ]
  }, {
    "tStartMs": 1757140,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "그리고 문화유산이 되면"
    } ]
  }, {
    "tStartMs": 1758520,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "거기 있는 모든 내용이 다 문화유산입니다"
    } ]
  }, {
    "tStartMs": 1761990,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "식기까지"
    } ]
  }, {
    "tStartMs": 1763270,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "토스트 거치대도 등록돼 있어요"
    } ]
  }, {
    "tStartMs": 1765690,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "조건부긴 하지만"
    } ]
  }, {
    "tStartMs": 1766450,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "모두 세금 감면 혜택이라고 할 수 있고요"
    } ]
  }, {
    "tStartMs": 1769270,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "그리고 요즘에 이걸로"
    } ]
  }, {
    "tStartMs": 1770250,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "또 영국이 시끄러운데"
    } ]
  }, {
    "tStartMs": 1771700,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "농지는 상속세 면제 대상입니다"
    } ]
  }, {
    "tStartMs": 1774170,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "근데 저런 대영주들의 땅은"
    } ]
  }, {
    "tStartMs": 1775900,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "농지가 많죠"
    } ]
  }, {
    "tStartMs": 1776920,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "몇백만 평 농지가 많으니까"
    } ]
  }, {
    "tStartMs": 1779120,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "물론 그 때문에 문제가 돼서"
    } ]
  }, {
    "tStartMs": 1780630,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "지금 2026년 4월"
    } ]
  }, {
    "tStartMs": 1782090,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "다음 달부터"
    } ]
  }, {
    "tStartMs": 1782700,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "저기 상한선이 적용이 됩니다"
    } ]
  }, {
    "tStartMs": 1785080,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "자 그리고 가장 중요한 거"
    } ]
  }, {
    "tStartMs": 1786880,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "가족 신탁은 상속세 면제가 됩니다"
    } ]
  }, {
    "tStartMs": 1790070,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "우리로서는 상상할 수 없는 제도인데"
    } ]
  }, {
    "tStartMs": 1792660,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "보통 저런 귀족들, 억만장자들, 지주들"
    } ]
  }, {
    "tStartMs": 1795270,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "초거대 지주들은"
    } ]
  }, {
    "tStartMs": 1796330,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "개인이"
    } ]
  }, {
    "tStartMs": 1797180,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "상속을 하지 않아요"
    } ]
  }, {
    "tStartMs": 1798310,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "트러스트가 내려옵니다"
    } ]
  }, {
    "tStartMs": 1799870,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "가족신탁"
    } ]
  }, {
    "tStartMs": 1800940,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "거기서 이 모든 걸 관리하죠"
    } ]
  }, {
    "tStartMs": 1803010,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "그리고 거기 귀족이 됐건"
    } ]
  }, {
    "tStartMs": 1805050,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "거기 세습하는 누구는"
    } ]
  }, {
    "tStartMs": 1806270,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "이 트러스트를 관리하는 사람이 돼"
    } ]
  }, {
    "tStartMs": 1808980,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "그러니까 상속세가 없다는 논리예요"
    } ]
  }, {
    "tStartMs": 1811110,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "신탁은 관리자가 바뀌는 거지"
    } ]
  }, {
    "tStartMs": 1813200,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "소유자가 바뀌는 게 아니다"
    } ]
  }, {
    "tStartMs": 1815490,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "우리 신탁은"
    } ]
  }, {
    "tStartMs": 1816500,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "백년, 만년, 천년"
    } ]
  }, {
    "tStartMs": 1817920,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "똑같이 슈카 신탁이야"
    } ]
  }, {
    "tStartMs": 1820070,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "그러니까 우리가 관리해"
    } ]
  }, {
    "tStartMs": 1821400,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "근데 여기 헤드가, 보스가"
    } ]
  }, {
    "tStartMs": 1823430,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "관리자가 아들이 되는 거지"
    } ]
  }, {
    "tStartMs": 1825410,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "그러니까 이건 소유가 아니고"
    } ]
  }, {
    "tStartMs": 1826560,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "관리이고"
    } ]
  }, {
    "tStartMs": 1827300,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "때문에 상속을 안 하는데"
    } ]
  }, {
    "tStartMs": 1828610,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "무슨 상속이 있어요?"
    } ]
  }, {
    "tStartMs": 1829680,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "상속세는 면제되는 거고요"
    } ]
  }, {
    "tStartMs": 1831310,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "물론 10년에 한 번씩"
    } ]
  }, {
    "tStartMs": 1832660,
    "dDurationMs": 340,
    "segs": [ {
      "utf8": "우리로 치면"
    } ]
  }, {
    "tStartMs": 1833000,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "보유세 같은 게 있다 그래요"
    } ]
  }, {
    "tStartMs": 1834330,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "주기적으로 세금을 내긴 하는데"
    } ]
  }, {
    "tStartMs": 1836710,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "어쨌건 이런 면제가 있고요"
    } ]
  }, {
    "tStartMs": 1838020,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "그리고 또 한국인이라면"
    } ]
  }, {
    "tStartMs": 1839380,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "잘 이해가 안 되는 제도"
    } ]
  }, {
    "tStartMs": 1840760,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "7년 상속세 면제 규칙이 있다 그럽니다"
    } ]
  }, {
    "tStartMs": 1843520,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "7-year 룰이라고 그러는데"
    } ]
  }, {
    "tStartMs": 1845340,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "저도 이번에 봤어요"
    } ]
  }, {
    "tStartMs": 1846040,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "이건 뭔가 하고 봤더니"
    } ]
  }, {
    "tStartMs": 1847730,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "영국은 누구에게 자산을 증여한 다음에"
    } ]
  }, {
    "tStartMs": 1850080,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "7년간 자산을 증여한 사람이"
    } ]
  }, {
    "tStartMs": 1852380,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "아버지가 살아있으면"
    } ]
  }, {
    "tStartMs": 1854080,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "상속세가 면제됩니다"
    } ]
  }, {
    "tStartMs": 1856140,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "7년 내에 돌아가시면 어떻게 되나요?"
    } ]
  }, {
    "tStartMs": 1858020,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "우리 아빠가 나한테 준 다음에?"
    } ]
  }, {
    "tStartMs": 1859070,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "아 그러면 기간에 따라서"
    } ]
  }, {
    "tStartMs": 1860860,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "상속세를 내요"
    } ]
  }, {
    "tStartMs": 1861760,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "3년 이내 사망하면"
    } ]
  }, {
    "tStartMs": 1862970,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "그건 상속이야"
    } ]
  }, {
    "tStartMs": 1864150,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "그건 40% 상속세입니다"
    } ]
  }, {
    "tStartMs": 1866210,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "그건 상속이잖아"
    } ]
  }, {
    "tStartMs": 1867280,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "아버지 돌아가시면 주실 거니까"
    } ]
  }, {
    "tStartMs": 1868250,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "상속이네"
    } ]
  }, {
    "tStartMs": 1869000,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "하지만 7년간 살았다면"
    } ]
  }, {
    "tStartMs": 1870180,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "아 이건 상속이 아니구나"
    } ]
  }, {
    "tStartMs": 1871800,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "이거는 젊은 사람들한테"
    } ]
  }, {
    "tStartMs": 1873040,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "부를 넘기는 그런 거구나"
    } ]
  }, {
    "tStartMs": 1874830,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "이건 상속이 아니다"
    } ]
  }, {
    "tStartMs": 1876120,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "생전 증여 뭐 이렇게 들어가는 거죠"
    } ]
  }, {
    "tStartMs": 1877480,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "우리로 치면"
    } ]
  }, {
    "tStartMs": 1878320,
    "dDurationMs": 260,
    "segs": [ {
      "utf8": "그래서"
    } ]
  }, {
    "tStartMs": 1878580,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "아버지가 오래 사셔야 돼"
    } ]
  }, {
    "tStartMs": 1880010,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "3년에서 4년 사이에 돌아가시면"
    } ]
  }, {
    "tStartMs": 1881530,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "32% 세금입니다"
    } ]
  }, {
    "tStartMs": 1882680,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "아버지가 장수해야 돼"
    } ]
  }, {
    "tStartMs": 1884380,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "참 효자를 만드는 법이 아닐까 생각하는데"
    } ]
  }, {
    "tStartMs": 1887420,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "부모님 장수를 정말 간절히 빌게 되는"
    } ]
  }, {
    "tStartMs": 1889900,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "그런 법이라고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 1891250,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "하지만 부모님 입장에서"
    } ]
  }, {
    "tStartMs": 1893000,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "아니면 받는 입장에서"
    } ]
  }, {
    "tStartMs": 1894360,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "7년 못 사실 수도 있잖아"
    } ]
  }, {
    "tStartMs": 1895850,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "그래서 영국 귀족들을 보면"
    } ]
  }, {
    "tStartMs": 1897690,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "자식들이"
    } ]
  }, {
    "tStartMs": 1898290,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "20대, 30대만 돼도"
    } ]
  }, {
    "tStartMs": 1899540,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "이미 상속하는 걸 볼 수 있어요"
    } ]
  }, {
    "tStartMs": 1902060,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "이미 그 이유가 있습니다"
    } ]
  }, {
    "tStartMs": 1903290,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "7년 내에 잘못되면 어떡해"
    } ]
  }, {
    "tStartMs": 1905020,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "빨리 주는 게 이득이다"
    } ]
  }, {
    "tStartMs": 1907100,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "내가 젊었을 때"
    } ]
  }, {
    "tStartMs": 1908460,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "물론 이 법의 뜻은 이렇다고 합니다"
    } ]
  }, {
    "tStartMs": 1910420,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "자산이 일찍 젊은 사람들에게 넘어가서"
    } ]
  }, {
    "tStartMs": 1912560,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "경제활동에 투자하면 좋지 않냐"
    } ]
  }, {
    "tStartMs": 1914610,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "라는 초기의 뜻은 있었대"
    } ]
  }, {
    "tStartMs": 1916150,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "20대, 30대 때 빨리빨리"
    } ]
  }, {
    "tStartMs": 1917980,
    "dDurationMs": 570,
    "segs": [ {
      "utf8": "자산 넘기고"
    } ]
  }, {
    "tStartMs": 1918550,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "젊은 사람들이 소비도 많이 하고"
    } ]
  }, {
    "tStartMs": 1919970,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "투자를 많이 하게 돼서"
    } ]
  }, {
    "tStartMs": 1920910,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "경제를 팽팽 돌려보자"
    } ]
  }, {
    "tStartMs": 1922230,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "라는 뜻은 있었지만"
    } ]
  }, {
    "tStartMs": 1923540,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "어쨌건 지금은 일종의"
    } ]
  }, {
    "tStartMs": 1925540,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "부의 대물림 통로가 됐다고 하고요"
    } ]
  }, {
    "tStartMs": 1927500,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "결론적으로 영국은 여전히"
    } ]
  }, {
    "tStartMs": 1928920,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "제가 보기엔"
    } ]
  }, {
    "tStartMs": 1929790,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "귀족들이 보유하고 있다"
    } ]
  }, {
    "tStartMs": 1932000,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "한국인들이 보기엔"
    } ]
  }, {
    "tStartMs": 1933210,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "뒤에 있는 성과"
    } ]
  }, {
    "tStartMs": 1934790,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "앞에 있는 분이 누구냐면"
    } ]
  }, {
    "tStartMs": 1936220,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "노섬벌렌드 공작입니다"
    } ]
  }, {
    "tStartMs": 1938780,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "아 영지를 산책하시네"
    } ]
  }, {
    "tStartMs": 1940800,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "공식적으로는 관리자죠"
    } ]
  }, {
    "tStartMs": 1942630,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "신탁의 관리자"
    } ]
  }, {
    "tStartMs": 1944300,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "관리자라고 하면 좀 이상한데"
    } ]
  }, {
    "tStartMs": 1945770,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "신탁의 소유자"
    } ]
  }, {
    "tStartMs": 1947330,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "하여튼 그런 개념입니다"
    } ]
  }, {
    "tStartMs": 1948830,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "그래서 듀크 오브  노섬벌렌드"
    } ]
  }, {
    "tStartMs": 1952190,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "멋있기는 한데"
    } ]
  }, {
    "tStartMs": 1953130,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "참 왕국이니까"
    } ]
  }, {
    "tStartMs": 1954540,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "21세기에도 여전히"
    } ]
  }, {
    "tStartMs": 1956330,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "귀족들의 소유와 영향력은"
    } ]
  }, {
    "tStartMs": 1957950,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "여전하구나라는 걸"
    } ]
  }, {
    "tStartMs": 1959130,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "생각하게 되는 주제라고 할 수 있습니다"
    } ]
  } ]
}

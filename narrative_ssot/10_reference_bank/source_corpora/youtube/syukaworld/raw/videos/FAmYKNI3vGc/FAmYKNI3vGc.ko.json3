{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 7810,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "자, 마지막 주제는 미국과 이란의 전쟁이 시작됐죠"
    } ]
  }, {
    "tStartMs": 11740,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "제가 이거 한 어떤 교수님한테 말을 들었을 때"
    } ]
  }, {
    "tStartMs": 16400,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "전쟁할 가능성이 굉장히 높다"
    } ]
  }, {
    "tStartMs": 17780,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "70-80% 이상이다"
    } ]
  }, {
    "tStartMs": 19790,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "라고 말을 들었었는데"
    } ]
  }, {
    "tStartMs": 21840,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "강의를 들었었는데"
    } ]
  }, {
    "tStartMs": 23180,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "설마 설마 했는데"
    } ]
  }, {
    "tStartMs": 24170,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "진짜 전쟁이 일어났습니다"
    } ]
  }, {
    "tStartMs": 27070,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "2월 28일"
    } ]
  }, {
    "tStartMs": 28290,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "이스라엘은 이란에 대한"
    } ]
  }, {
    "tStartMs": 29670,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "선제 공격을 개시했습니다"
    } ]
  }, {
    "tStartMs": 31610,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "처음에는 예방적 공격 그랬는데"
    } ]
  }, {
    "tStartMs": 33510,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "결국에 선제 공격이었죠"
    } ]
  }, {
    "tStartMs": 35380,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "이스라엘은 이란에 대한 선제 공격을 감행했다고"
    } ]
  }, {
    "tStartMs": 37640,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "공식적  으로 발표했습니다"
    } ]
  }, {
    "tStartMs": 39460,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "이스라엘은 지금 국가 비상사태를 선포하고"
    } ]
  }, {
    "tStartMs": 41950,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "이란 전역을 한 군데를 타격한 게 아니에요"
    } ]
  }, {
    "tStartMs": 44510,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "몇 백 군데가 넘는"
    } ]
  }, {
    "tStartMs": 45540,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "이란 전역을 동시에 공습했다고"
    } ]
  }, {
    "tStartMs": 47780,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "알려져 있습니다"
    } ]
  }, {
    "tStartMs": 48830,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "이스라엘은 이건"
    } ]
  }, {
    "tStartMs": 49690,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "하루 이틀에 끝날 일이 아니라"
    } ]
  }, {
    "tStartMs": 50910,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "며칠간 지속될 것이다라고 얘기했는데"
    } ]
  }, {
    "tStartMs": 53180,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "물론 전쟁이 빨리 끝나면"
    } ]
  }, {
    "tStartMs": 54460,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "며칠이겠지만은"
    } ]
  }, {
    "tStartMs": 55510,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "뭐 길게 갈 수도 있는"
    } ]
  }, {
    "tStartMs": 56470,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "그런 상황이라고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 57920,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "지금 이란과 미국은 어떤 상황이었냐?"
    } ]
  }, {
    "tStartMs": 60480,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "이란은 미국과"
    } ]
  }, {
    "tStartMs": 61620,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "뭐 아시겠지만"
    } ]
  }, {
    "tStartMs": 62410,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "여러 차례 핵 협상을 하고 있었어요"
    } ]
  }, {
    "tStartMs": 64470,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "트럼프 대통령의 사위인 재러드 쿠슈너나"
    } ]
  }, {
    "tStartMs": 66170,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "지난번에 슈카월드에 나왔던"
    } ]
  }, {
    "tStartMs": 67220,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "특사 스티브 위트코프"
    } ]
  }, {
    "tStartMs": 68330,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "트럼프 대통령의 친구죠?"
    } ]
  }, {
    "tStartMs": 70060,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "이런 특사들이 가서"
    } ]
  }, {
    "tStartMs": 71010,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "오만은"
    } ]
  }, {
    "tStartMs": 71770,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "오만이 지금 중재 역할을 하고 있습니다"
    } ]
  }, {
    "tStartMs": 73440,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "이란 대표들하고 만나서"
    } ]
  }, {
    "tStartMs": 74450,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "계속 협상을 하고 있었습니다"
    } ]
  }, {
    "tStartMs": 76420,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "미국은 이렇게 주장했어요"
    } ]
  }, {
    "tStartMs": 77460,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "이란이 여전히 핵무기와"
    } ]
  }, {
    "tStartMs": 78590,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "탄도미사일 개발을 추진하고 있다"
    } ]
  }, {
    "tStartMs": 80930,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "이란과 합의가 이루어지지 않을 경우에"
    } ]
  }, {
    "tStartMs": 82630,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "미국은 군사적 옵션을"
    } ]
  }, {
    "tStartMs": 83620,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "실행할 수밖에 없다라고 하면서"
    } ]
  }, {
    "tStartMs": 85120,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "핵 협상을 하고 있었죠"
    } ]
  }, {
    "tStartMs": 87350,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "이란은 현재"
    } ]
  }, {
    "tStartMs": 88530,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "60%에 가까운 농축도를 가진"
    } ]
  }, {
    "tStartMs": 90890,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "우라늄을 보유한 것으로 알려지고 있습니다"
    } ]
  }, {
    "tStartMs": 94310,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "한마디로 마음을 먹으면"
    } ]
  }, {
    "tStartMs": 95570,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "핵무기를 제조할 수 있는 수준까지"
    } ]
  }, {
    "tStartMs": 97370,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "우라늄을 농축한 것으로 알려져 있어요"
    } ]
  }, {
    "tStartMs": 100030,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "이란은 본인들은 뭐라고 얘기를 하냐?"
    } ]
  }, {
    "tStartMs": 102200,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "핵무기 개발을 시도한 적은 없다"
    } ]
  }, {
    "tStartMs": 104040,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "하지만 우라늄을 농축할 권리는 있다"
    } ]
  }, {
    "tStartMs": 106470,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "라고 주장하고 있습니다"
    } ]
  }, {
    "tStartMs": 108260,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "아마 기억이 나시겠지만"
    } ]
  }, {
    "tStartMs": 109510,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "작년 6월에"
    } ]
  }, {
    "tStartMs": 110770,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "저 이란의 핵시설을"
    } ]
  }, {
    "tStartMs": 112000,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "미국이 폭격을 했죠"
    } ]
  }, {
    "tStartMs": 113890,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "B-2 스텔스 폭격기"
    } ]
  }, {
    "tStartMs": 115020,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "위에 있는 가오리 같은 거"
    } ]
  }, {
    "tStartMs": 116310,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "7대가 나갔고"
    } ]
  }, {
    "tStartMs": 117250,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "미국 전투기 125대가 출격을 해서"
    } ]
  }, {
    "tStartMs": 120060,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "이란 핵시설 3곳을"
    } ]
  }, {
    "tStartMs": 121400,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "벙커버스터를 날리면서"
    } ]
  }, {
    "tStartMs": 122950,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "초토화시킨 적이 있습니다"
    } ]
  }, {
    "tStartMs": 124720,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "이런 적이 있는데"
    } ]
  }, {
    "tStartMs": 125520,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "지금 현재 미국은 뭐를 요구하고 있냐"
    } ]
  }, {
    "tStartMs": 127830,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "요구하는 게 여러 개가 있는데"
    } ]
  }, {
    "tStartMs": 128790,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "그중에 가장 중요한 건 역시 핵인데"
    } ]
  }, {
    "tStartMs": 131490,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "이란이 보유한 우라늄을"
    } ]
  }, {
    "tStartMs": 133090,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "모두 미국에 넘기든지"
    } ]
  }, {
    "tStartMs": 135040,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "국외로 방출해라"
    } ]
  }, {
    "tStartMs": 136990,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "그리고 이란은 영구적으로"
    } ]
  }, {
    "tStartMs": 138930,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "핵 프로그램을 중단해라"
    } ]
  }, {
    "tStartMs": 141690,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "이걸 요구하고 있어요"
    } ]
  }, {
    "tStartMs": 142820,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "이란이 이걸 받아들이면"
    } ]
  }, {
    "tStartMs": 145190,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "그래도 어떻게든"
    } ]
  }, {
    "tStartMs": 146410,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "전쟁은 없을 수도 있었지 않나 생각을 하는데"
    } ]
  }, {
    "tStartMs": 149360,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "영구적인 핵 프로그램 중단"
    } ]
  }, {
    "tStartMs": 150840,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "그리고 미국이 언제든지"
    } ]
  }, {
    "tStartMs": 152630,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "이란의 핵시설을 사찰할 수 있는 권리까지"
    } ]
  }, {
    "tStartMs": 155580,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "농축 우라늄을 이란 땅에 남기지 마라"
    } ]
  }, {
    "tStartMs": 159240,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "결론적으로 전쟁이 난 걸 보면"
    } ]
  }, {
    "tStartMs": 161270,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "이란은 영구적인 핵 포기를 거부한 걸로 보입니다"
    } ]
  }, {
    "tStartMs": 164510,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "대신에 뭐를 요구했다고 알려져 있냐면"
    } ]
  }, {
    "tStartMs": 166590,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "60%인 농축도를 1.5%까지 낮추겠다"
    } ]
  }, {
    "tStartMs": 170080,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "무기로 쓰지 못할 정도로"
    } ]
  }, {
    "tStartMs": 171760,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "핵 발전에 쓸 정도까지만 낮추겠다"
    } ]
  }, {
    "tStartMs": 173630,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "아니면 몇 년간 농축을 중단하겠다"
    } ]
  }, {
    "tStartMs": 175910,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "아니면 아랍과 이란이"
    } ]
  }, {
    "tStartMs": 177400,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "컨소시움을 만들어서 처리하게 하자"
    } ]
  }, {
    "tStartMs": 179740,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "그리고 너희가 감시하면 되지 않냐"
    } ]
  }, {
    "tStartMs": 181520,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "이란 국외로 반출하거나"
    } ]
  }, {
    "tStartMs": 182730,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "영구적인 핵 포기는 못하겠다라고"
    } ]
  }, {
    "tStartMs": 185270,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "이렇게 버텼는데"
    } ]
  }, {
    "tStartMs": 186510,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "이렇게 핵 협상을 하는 와중에"
    } ]
  }, {
    "tStartMs": 188800,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "트럼프 대통령은 이란과의 전쟁을"
    } ]
  }, {
    "tStartMs": 191290,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "바로 선언을 했습니다"
    } ]
  }, {
    "tStartMs": 192860,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "이스라엘에 선제 타격이 있은 직후구요"
    } ]
  }, {
    "tStartMs": 194960,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 196360,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "미국은 이제 이란에서"
    } ]
  }, {
    "tStartMs": 197750,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "대규모 전투 작전을 개시했습니다"
    } ]
  }, {
    "tStartMs": 200570,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "우리의 목표는 매우 잔인하고 끔찍한"
    } ]
  }, {
    "tStartMs": 202730,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "이란 정권의 임박한 위협을"
    } ]
  }, {
    "tStartMs": 204820,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "제거하는 것입니다"
    } ]
  }, {
    "tStartMs": 206670,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "이란은"
    } ]
  }, {
    "tStartMs": 207530,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "세계 최대 테러 지원국이며"
    } ]
  }, {
    "tStartMs": 210090,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "최근에도 시위에 나선"
    } ]
  }, {
    "tStartMs": 211530,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "자국민 수만 명을 거리에서 무참히 살해했습니다"
    } ]
  }, {
    "tStartMs": 216250,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "이 테러 정권은 절대"
    } ]
  }, {
    "tStartMs": 218080,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "핵무기를 보유해서는 안됩니다"
    } ]
  }, {
    "tStartMs": 220100,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "다시 한번 강조합니다"
    } ]
  }, {
    "tStartMs": 221630,
    "dDurationMs": 3730,
    "segs": [ {
      "utf8": "이란은 절대 핵무기를 가질 수 없습니다"
    } ]
  }, {
    "tStartMs": 225360,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "우리는 이걸 이란에 계속적으로 요구해 왔고"
    } ]
  }, {
    "tStartMs": 227760,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "협상을 시도했지만"
    } ]
  }, {
    "tStartMs": 229040,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "이란은 끝내 협상을 거부했습니다"
    } ]
  }, {
    "tStartMs": 231850,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "우리는 이제 이를 더 이상 용납할 수 없습니다"
    } ]
  }, {
    "tStartMs": 235990,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "미국은 이제 이란의 미사일을 파괴하고"
    } ]
  }, {
    "tStartMs": 238750,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "미사일 산업시설을 완전히 궤멸시킬 것입니다"
    } ]
  }, {
    "tStartMs": 242240,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "또한 그들의 해군도 궤멸시킬 것입니다"
    } ]
  }, {
    "tStartMs": 244960,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "핵무기 연구소를 포함한"
    } ]
  }, {
    "tStartMs": 246600,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "제철시설도 당연히 궤멸시키겠죠"
    } ]
  }, {
    "tStartMs": 249630,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "이제 곧 이란은 미국의 군사력과"
    } ]
  }, {
    "tStartMs": 252230,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "위력을 알게 될 것입니다"
    } ]
  }, {
    "tStartMs": 254280,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "이란은 미국을 과소평가하고 있어요"
    } ]
  }, {
    "tStartMs": 256370,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "이 정권은 곧 미국의 군사력과 위력이"
    } ]
  }, {
    "tStartMs": 259060,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "감히 넘볼 수 없다는 사실을 깨닫게 될 것입니다"
    } ]
  }, {
    "tStartMs": 262220,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "지구상 그 어떤 군대도"
    } ]
  }, {
    "tStartMs": 263560,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "미국의 군사력, 힘, 그리고 정교함에"
    } ]
  }, {
    "tStartMs": 265940,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "근접조차 하지 못합니다"
    } ]
  }, {
    "tStartMs": 269050,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "이슬람 혁명수비대와 군대, 그리고 경찰 여러분들"
    } ]
  }, {
    "tStartMs": 272380,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "즉시 위기를 내려놓으십시오"
    } ]
  }, {
    "tStartMs": 274500,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "그러면 완전한 면책특권을 보장받을 것입니다"
    } ]
  }, {
    "tStartMs": 277950,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "하지만 그렇지 않으면"
    } ]
  }, {
    "tStartMs": 279360,
    "dDurationMs": 3970,
    "segs": [ {
      "utf8": "확실한 죽음을 맞이하게 될 것입니다"
    } ]
  }, {
    "tStartMs": 283330,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "그리고 이란 국민 여러분"
    } ]
  }, {
    "tStartMs": 285640,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "드디어 자유의 시간이 왔습니다"
    } ]
  }, {
    "tStartMs": 288030,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "위대하고 자랑스러운 이란 국민 여러분은"
    } ]
  }, {
    "tStartMs": 290270,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "모든 것이 끝나면"
    } ]
  }, {
    "tStartMs": 291480,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "이 정부를 장악하십시오"
    } ]
  }, {
    "tStartMs": 293950,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "이거는 여러분들에게 주어진"
    } ]
  }, {
    "tStartMs": 295520,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "단 한 번의 기회가 될 것입니다"
    } ]
  }, {
    "tStartMs": 299010,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "아마 수 세대에 걸쳐서"
    } ]
  }, {
    "tStartMs": 300770,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "단 한 번의 기회가 될 수도 있어요"
    } ]
  }, {
    "tStartMs": 303260,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "여러분은 오랫동안 미국의 도움을 요청했지만"
    } ]
  }, {
    "tStartMs": 305690,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "그동안 그 어떤 대통령도"
    } ]
  }, {
    "tStartMs": 307300,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "여러분의 요청에 응답하지 않았습니다"
    } ]
  }, {
    "tStartMs": 309460,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "하지만 이제"
    } ]
  }, {
    "tStartMs": 310700,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "여러분이 원하는 일을 해주는"
    } ]
  }, {
    "tStartMs": 312530,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "그 대통령이 생겼습니다"
    } ]
  }, {
    "tStartMs": 314520,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "이 기회를 잡으십시오"
    } ]
  }, {
    "tStartMs": 316510,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "이란 국민 여러분 지금이 바로"
    } ]
  }, {
    "tStartMs": 318750,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "행동해야 될 때입니다"
    } ]
  }, {
    "tStartMs": 320280,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "이 기회를 놓치지 마십시오"
    } ]
  }, {
    "tStartMs": 322740,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "미국의 용감한 군인들에게"
    } ]
  }, {
    "tStartMs": 323920,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "신의 축복이 있기를 감사합니다"
    } ]
  }, {
    "tStartMs": 325900,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "하면서 사실상 선전포고죠"
    } ]
  }, {
    "tStartMs": 328320,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "연설을 마치셨는데"
    } ]
  }, {
    "tStartMs": 330180,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "미국 전쟁부가 밝힌"
    } ]
  }, {
    "tStartMs": 331940,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "이번 작전의 공식 이름은"
    } ]
  }, {
    "tStartMs": 333930,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "에픽 퓨리 작전입니다"
    } ]
  }, {
    "tStartMs": 335640,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "오퍼레이션 에픽 퓨리"
    } ]
  }, {
    "tStartMs": 338020,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "에픽 퓨리"
    } ]
  }, {
    "tStartMs": 338800,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "이걸 우리나라말로 뭐라고 해석해야 될지 모르겠는데"
    } ]
  }, {
    "tStartMs": 342100,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "짱 열받음?"
    } ]
  }, {
    "tStartMs": 343130,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "짱 화남? 개열받음?"
    } ]
  }, {
    "tStartMs": 344830,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "속된 표현은 좀"
    } ]
  }, {
    "tStartMs": 346980,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "빡쳤다"
    } ]
  }, {
    "tStartMs": 347930,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "뭐 이런 거랑 비슷한데"
    } ]
  }, {
    "tStartMs": 349400,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "에픽이 굉장히 뭐 그런 거죠"
    } ]
  }, {
    "tStartMs": 351120,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "극대노!"
    } ]
  }, {
    "tStartMs": 351760,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "그래 좋다"
    } ]
  }, {
    "tStartMs": 352670,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "역시 나 저거 하여튼 생각해"
    } ]
  }, {
    "tStartMs": 353900,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "그게 가장 적당한 게 극대노 작전이네"
    } ]
  }, {
    "tStartMs": 357130,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "역시 집단지성이 엄청나군요"
    } ]
  }, {
    "tStartMs": 359230,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "극대노 작전입니다"
    } ]
  }, {
    "tStartMs": 360690,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "우리 열받았다 작전이죠"
    } ]
  }, {
    "tStartMs": 362480,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "에픽한 퓨리 작전"
    } ]
  }, {
    "tStartMs": 364790,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "이란의 상황은 어떠냐"
    } ]
  }, {
    "tStartMs": 366460,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "여러분들 다 아시지만"
    } ]
  }, {
    "tStartMs": 367720,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "이란은 1997년 이슬람 혁명 이후"
    } ]
  }, {
    "tStartMs": 369690,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "신정국가로 전환을 했죠"
    } ]
  }, {
    "tStartMs": 371410,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "종교국가"
    } ]
  }, {
    "tStartMs": 372450,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "지금도 종교 지도자가"
    } ]
  }, {
    "tStartMs": 373340,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "국가 최고 지도자고요"
    } ]
  }, {
    "tStartMs": 374630,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "현 알리 하메이니는"
    } ]
  }, {
    "tStartMs": 375990,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "2대 최고 종교 지도자이자"
    } ]
  }, {
    "tStartMs": 377730,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "국가 최고 지도자입니다"
    } ]
  }, {
    "tStartMs": 379460,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "1981년 89년까지 대통령을 했고"
    } ]
  }, {
    "tStartMs": 381830,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "89년부터 현재까지 최고 종교 지도자니까"
    } ]
  }, {
    "tStartMs": 384110,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "거의 45년 동안 종교로"
    } ]
  }, {
    "tStartMs": 386040,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "이란을 통치하고 있다라고 보시면 됩니다"
    } ]
  }, {
    "tStartMs": 389290,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "그렇기 때문에 너무 오랫동안 종교로 억눌러왔고"
    } ]
  }, {
    "tStartMs": 392180,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "또 한 명이 지금 45년 넘게"
    } ]
  }, {
    "tStartMs": 394180,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "이란을 통치하고 있잖아요"
    } ]
  }, {
    "tStartMs": 395610,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "그리고 미국하고 각을 지면서"
    } ]
  }, {
    "tStartMs": 398240,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "이란 경제도 굉장히 안 좋고"
    } ]
  }, {
    "tStartMs": 399440,
    "dDurationMs": 580,
    "segs": [ {
      "utf8": "살기 어렵고"
    } ]
  }, {
    "tStartMs": 400020,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "환율 날아가고 하니까"
    } ]
  }, {
    "tStartMs": 401510,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "지난 1월 반정부시위가 발생했죠"
    } ]
  }, {
    "tStartMs": 403470,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "슈카월드에서 했었습니다"
    } ]
  }, {
    "tStartMs": 404900,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "거기서 사망자가"
    } ]
  }, {
    "tStartMs": 406350,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "공식 발표가 3천 명이에요"
    } ]
  }, {
    "tStartMs": 408880,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "비공식으로 3만 명 이상이란 말이 나오고 있습니다"
    } ]
  }, {
    "tStartMs": 411920,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "4만 명 얘기도 나오고 있어요"
    } ]
  }, {
    "tStartMs": 413980,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "경제난을 이유로 개혁을 요구한 시위대에"
    } ]
  }, {
    "tStartMs": 416260,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "무차별 발포했다"
    } ]
  }, {
    "tStartMs": 417820,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "이것 때문에 이란 내에서"
    } ]
  }, {
    "tStartMs": 419000,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "지금 현재 이란 정권의 지지율이"
    } ]
  }, {
    "tStartMs": 421500,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "굉장히 내려간 걸로 알려져 있습니다"
    } ]
  }, {
    "tStartMs": 423170,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "이란 시민들도"
    } ]
  }, {
    "tStartMs": 424580,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "지금 현재 이란 정권에서"
    } ]
  }, {
    "tStartMs": 425550,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "굉장히 분노한 사람들이 많을 수밖에 없는 게"
    } ]
  }, {
    "tStartMs": 428440,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "3만 명이 죽은 거는"
    } ]
  }, {
    "tStartMs": 430150,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "말이 안 되기 때문에"
    } ]
  }, {
    "tStartMs": 432130,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "또 실제로 제가 들으니까"
    } ]
  }, {
    "tStartMs": 433540,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "시신을 돌려주지 않았다"
    } ]
  }, {
    "tStartMs": 435540,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "시신을 돌려달라고 하니까"
    } ]
  }, {
    "tStartMs": 436850,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "몸값을 요구했다"
    } ]
  }, {
    "tStartMs": 437920,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "시신 값을"
    } ]
  }, {
    "tStartMs": 439040,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "그런 내용들이 있을 정도로"
    } ]
  }, {
    "tStartMs": 440020,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "굉장히 내부 분위기도 굉장히 좋지 않은"
    } ]
  }, {
    "tStartMs": 442370,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "그런 상황이죠"
    } ]
  }, {
    "tStartMs": 443390,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "그렇기 때문에 트럼프 대통령이 얘기한 거는"
    } ]
  }, {
    "tStartMs": 445480,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "미국이 전쟁을 치르니까"
    } ]
  }, {
    "tStartMs": 447240,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "지금 내부 반정부 시위가 일어나서"
    } ]
  }, {
    "tStartMs": 450060,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "이란의 반정부 시위대는 일어나서"
    } ]
  }, {
    "tStartMs": 452140,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "민주주의의 기회를 잡아라"
    } ]
  }, {
    "tStartMs": 454860,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "라고 얘기를 하는 거죠"
    } ]
  }, {
    "tStartMs": 456220,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "미국 입장에서는 어떻게 보면 기회이기도 하고"
    } ]
  }, {
    "tStartMs": 458210,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "저렇게 이란 정부가"
    } ]
  }, {
    "tStartMs": 459850,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "자기네 자국민들을 학살했을 때"
    } ]
  }, {
    "tStartMs": 461790,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "거기에 분노한 시위대가 일어나서"
    } ]
  }, {
    "tStartMs": 463830,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "민주주의의 기회를 잡으라고"
    } ]
  }, {
    "tStartMs": 465320,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "트럼프 대통령이 얘기하고 있다라고"
    } ]
  }, {
    "tStartMs": 466600,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "보시면 될 것 같습니다"
    } ]
  }, {
    "tStartMs": 468600,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "이란 외교부는 성명을 이렇게 발표했어요"
    } ]
  }, {
    "tStartMs": 471310,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "굽히고 들어가거나"
    } ]
  }, {
    "tStartMs": 472130,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "우리가 핵무기를 포기하겠다거나"
    } ]
  }, {
    "tStartMs": 474160,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "협상을 하거나"
    } ]
  }, {
    "tStartMs": 475140,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "그렇게 갈 줄 알았더니"
    } ]
  }, {
    "tStartMs": 476420,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "아니었습니다"
    } ]
  }, {
    "tStartMs": 477270,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 478140,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "이란은 대응에 주저하지 않을 것이다"
    } ]
  }, {
    "tStartMs": 480820,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "조국을 수호하고"
    } ]
  }, {
    "tStartMs": 481720,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "적의 군사적 공격에 맞서야 할 때가 왔다"
    } ]
  }, {
    "tStartMs": 485220,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "이스라엘과 미국에게"
    } ]
  }, {
    "tStartMs": 486690,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "역사상 한 번도 경험해보지 못한"
    } ]
  }, {
    "tStartMs": 489230,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "교훈을 줄 것이다"
    } ]
  }, {
    "tStartMs": 490980,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "우리는 어떠한 관용도 베풀지 않을 것이다"
    } ]
  }, {
    "tStartMs": 494740,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "그러면서 놀랍게도"
    } ]
  }, {
    "tStartMs": 496380,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "중동지역에 위치한 미군기지에"
    } ]
  }, {
    "tStartMs": 499070,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "미사일과 드론 공격을 날렸죠"
    } ]
  }, {
    "tStartMs": 501870,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "제가 놀랍게도라고 얘기를 한 건"
    } ]
  }, {
    "tStartMs": 503500,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "미군기지여서가 아니라"
    } ]
  }, {
    "tStartMs": 505280,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "이게 중동지역 다른 나라의"
    } ]
  }, {
    "tStartMs": 506940,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "미사일을 날려서 그렇습니다"
    } ]
  }, {
    "tStartMs": 508610,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "걸프지역에 있는 미군기지"
    } ]
  }, {
    "tStartMs": 509920,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "거의 대부분의"
    } ]
  }, {
    "tStartMs": 510750,
    "dDurationMs": 650,
    "segs": [ {
      "utf8": "오만은 빼고"
    } ]
  }, {
    "tStartMs": 511400,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "오만은 중계하던 나라이기 때문에"
    } ]
  }, {
    "tStartMs": 512680,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "거기를 빼고"
    } ]
  }, {
    "tStartMs": 513700,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "미군기지에 거의 대부분 공격을 날렸는데"
    } ]
  }, {
    "tStartMs": 516020,
    "dDurationMs": 280,
    "segs": [ {
      "utf8": "여기는"
    } ]
  }, {
    "tStartMs": 516300,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "카타르, 쿠웨이트"
    } ]
  }, {
    "tStartMs": 517380,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "아랍에미리트, 바레인이에요"
    } ]
  }, {
    "tStartMs": 519630,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "미군기지에 날렸다고 하지만"
    } ]
  }, {
    "tStartMs": 521230,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "어쨌건 다른 나라에 미사일을 날렸잖아요"
    } ]
  }, {
    "tStartMs": 524510,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "이 걸프만에 있는 미군기지"
    } ]
  }, {
    "tStartMs": 526540,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "여기를 대부분 타겟으로 날렸는데"
    } ]
  }, {
    "tStartMs": 528890,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "미국의 해외기지가 이처럼 광범위하고"
    } ]
  }, {
    "tStartMs": 530980,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "동시다발적인 공격을 받은 건 처음이라고 합니다"
    } ]
  }, {
    "tStartMs": 534520,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "방금 제가 얘기했지만"
    } ]
  }, {
    "tStartMs": 535880,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "아무리 미군기지라도"
    } ]
  }, {
    "tStartMs": 537420,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "엄연히 다른 나라 영토인데"
    } ]
  }, {
    "tStartMs": 539680,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "우리 치면 우리나라에서"
    } ]
  }, {
    "tStartMs": 542020,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "누가 미사일을 우리한테 날린 거하고 똑같죠"
    } ]
  }, {
    "tStartMs": 544440,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "중동에 있는 다른 나라에"
    } ]
  }, {
    "tStartMs": 545470,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "미사일을 마구 날려도 되냐"
    } ]
  }, {
    "tStartMs": 547800,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "이란은 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 549070,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "그건 그 걸프 국가들이"
    } ]
  }, {
    "tStartMs": 550790,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "미국에게 기지를 제공해준 게 문제다"
    } ]
  }, {
    "tStartMs": 553570,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "그들은 기지를 제공해 주지 말고"
    } ]
  }, {
    "tStartMs": 555270,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "제공해 줬다 하더라도"
    } ]
  }, {
    "tStartMs": 556200,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "이 공격을 막았어야지"
    } ]
  }, {
    "tStartMs": 557890,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "너희들은 의무를 다하지 않았어"
    } ]
  }, {
    "tStartMs": 559160,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "그러니까 우리가 미군 기지를"
    } ]
  }, {
    "tStartMs": 561270,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "공격하는 것은 당연하다"
    } ]
  }, {
    "tStartMs": 563150,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "라고 얘기를 하고 있고요"
    } ]
  }, {
    "tStartMs": 564550,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "물론 공격받는 나라들 입장에서는"
    } ]
  }, {
    "tStartMs": 566370,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "뭐야?"
    } ]
  }, {
    "tStartMs": 567170,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "왜 우리까지?"
    } ]
  }, {
    "tStartMs": 568640,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "사우디아라비아가 성명을 발표했는데"
    } ]
  }, {
    "tStartMs": 570510,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "이렇게 성명을 발표했습니다"
    } ]
  }, {
    "tStartMs": 572540,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "이란이 리야드와 사우디 동부 지역을 공격했다"
    } ]
  }, {
    "tStartMs": 575620,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "본인들의 수도를 공격했다는 겁니다"
    } ]
  }, {
    "tStartMs": 577140,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "이러한 공격은 어떤 구실로도"
    } ]
  }, {
    "tStartMs": 578620,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "어떤 방식으로도 정당화될 수 없다"
    } ]
  }, {
    "tStartMs": 581090,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "사우디가 자국의 영공과 영토를"
    } ]
  }, {
    "tStartMs": 583370,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "이란을 공격하는데"
    } ]
  }, {
    "tStartMs": 584300,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "사용하지 않겠다고"
    } ]
  }, {
    "tStartMs": 585810,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "얘기를 했음에도 불구하고"
    } ]
  }, {
    "tStartMs": 587760,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "우리 영공과 영토로는"
    } ]
  }, {
    "tStartMs": 589640,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "미국이 공격하지 못하게 할게"
    } ]
  }, {
    "tStartMs": 590790,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "우린 참여하지 않을게"
    } ]
  }, {
    "tStartMs": 591880,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "라고 선을 그었는데"
    } ]
  }, {
    "tStartMs": 593110,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "이란은 이러한 공격을 감행한 것이다"
    } ]
  }, {
    "tStartMs": 595520,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "이제 사우디는"
    } ]
  }, {
    "tStartMs": 596470,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "보복 조치를 취할 권리가 있다"
    } ]
  }, {
    "tStartMs": 599220,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "제가 모든 나라를 갖고 오진 않았는데"
    } ]
  }, {
    "tStartMs": 600420,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "걸프 지역 국가들이"
    } ]
  }, {
    "tStartMs": 601360,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "대부분 저런 스탠스입니다"
    } ]
  }, {
    "tStartMs": 602700,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "바레인 정부는 이란의 공격을"
    } ]
  }, {
    "tStartMs": 604530,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "배신적인 공격"
    } ]
  }, {
    "tStartMs": 606210,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "왕국의 주권과 안보에 대한"
    } ]
  }, {
    "tStartMs": 607630,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "노골적인 침해라고 얘기했고요"
    } ]
  }, {
    "tStartMs": 609860,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "카타르, 쿠웨이트, 아랍에미리트"
    } ]
  }, {
    "tStartMs": 611170,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "모두 비슷한 스탠스고"
    } ]
  }, {
    "tStartMs": 612950,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "영공을 폐쇄하고"
    } ]
  }, {
    "tStartMs": 614130,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "이란의 자국 영토 공격을"
    } ]
  }, {
    "tStartMs": 616380,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "규탄하고 있는 그런 상황입니다"
    } ]
  }, {
    "tStartMs": 618550,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "물론 여기에는 다들 아시겠지만"
    } ]
  }, {
    "tStartMs": 620690,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "아랍 국가들은 대부분"
    } ]
  }, {
    "tStartMs": 622050,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "이슬람에서 수니파죠"
    } ]
  }, {
    "tStartMs": 624380,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "이란은 시아파죠"
    } ]
  }, {
    "tStartMs": 625890,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "이라크는 조금 섞여있고"
    } ]
  }, {
    "tStartMs": 627790,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "한 60% 정도가 시아"
    } ]
  }, {
    "tStartMs": 630460,
    "dDurationMs": 470,
    "segs": [ {
      "utf8": "30%가 수니"
    } ]
  }, {
    "tStartMs": 630930,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "이런 얘기를 많이 하는 것 같던데"
    } ]
  }, {
    "tStartMs": 632470,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "그리고 아랍과 이란은 당연하지만"
    } ]
  }, {
    "tStartMs": 634740,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "민족, 종교, 언어가 다르죠"
    } ]
  }, {
    "tStartMs": 637120,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "여기는 비슷하다고 해도 아랍이죠"
    } ]
  }, {
    "tStartMs": 640340,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "아랍어를 쓰고"
    } ]
  }, {
    "tStartMs": 641900,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "인종도 있지만 비슷하고"
    } ]
  }, {
    "tStartMs": 645060,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "아랍은 아랍어를 쓰는데"
    } ]
  }, {
    "tStartMs": 647520,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "이란은 페르시아어를 쓰는 페르시아인들이죠"
    } ]
  }, {
    "tStartMs": 650750,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "이란은 아랍이 아니죠"
    } ]
  }, {
    "tStartMs": 652320,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "중동은 맞지만,"
    } ]
  }, {
    "tStartMs": 653000,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "미들리스트는 맞지만"
    } ]
  }, {
    "tStartMs": 654310,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "아랍이 아니다"
    } ]
  }, {
    "tStartMs": 654950,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "아랍은 아랍어를 쓰고"
    } ]
  }, {
    "tStartMs": 656320,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "아랍인들이 중심인 반면"
    } ]
  }, {
    "tStartMs": 657910,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "역시 조금"
    } ]
  }, {
    "tStartMs": 659310,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "이질적인 그런 존재라고 할 수 있고"
    } ]
  }, {
    "tStartMs": 661520,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "이 지도를 봐도"
    } ]
  }, {
    "tStartMs": 662800,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "이 중동을 보면"
    } ]
  }, {
    "tStartMs": 664350,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "약간 이란은"
    } ]
  }, {
    "tStartMs": 667490,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "엉덩이는 아시아 쪽에 있죠"
    } ]
  }, {
    "tStartMs": 669280,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "그래서 중동을 세력으로 얘기를 할 때"
    } ]
  }, {
    "tStartMs": 671100,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "이런 얘기를 많이 하시더라고요"
    } ]
  }, {
    "tStartMs": 672280,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "저도 이거 수업으로 들었는데"
    } ]
  }, {
    "tStartMs": 673820,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "아랍, 터키, 페르시아, 이란"
    } ]
  }, {
    "tStartMs": 677940,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "세 개의 큰 축 이렇게 얘기하시던데"
    } ]
  }, {
    "tStartMs": 679960,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "여기 유대인도 들어가서"
    } ]
  }, {
    "tStartMs": 681640,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "이스라엘 없던 게 들어왔긴 하지만"
    } ]
  }, {
    "tStartMs": 684000,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "네 개의 큰 축"
    } ]
  }, {
    "tStartMs": 685630,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "페르시아가 아랍에 공격한 그런"
    } ]
  }, {
    "tStartMs": 687670,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "모습이 됐기 때문에"
    } ]
  }, {
    "tStartMs": 689450,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "반발하고 있죠"
    } ]
  }, {
    "tStartMs": 690750,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "그리고 이 자료를 만들 때만 해도"
    } ]
  }, {
    "tStartMs": 692430,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "저는 이렇게 만들었습니다"
    } ]
  }, {
    "tStartMs": 694090,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "미국과 이스라엘은"
    } ]
  }, {
    "tStartMs": 695010,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "이란 최고 지도자와 대통령을"
    } ]
  }, {
    "tStartMs": 696390,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "포함한 지도부의 암살을"
    } ]
  }, {
    "tStartMs": 697440,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "시도 중인 것으로 알려졌다"
    } ]
  }, {
    "tStartMs": 699460,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "토요일 날"
    } ]
  }, {
    "tStartMs": 700370,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "공습하자마자 자료를 만들던 거예요"
    } ]
  }, {
    "tStartMs": 702080,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "최고 지도자 아야톨라 알리 하메네이"
    } ]
  }, {
    "tStartMs": 704350,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "페제스키안 대통령"
    } ]
  }, {
    "tStartMs": 705710,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "이런 지도부는"
    } ]
  }, {
    "tStartMs": 706500,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "그때 당시에 이란은"
    } ]
  }, {
    "tStartMs": 707300,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "폭탄 테러로 인한 암살 시도에도 불구하고"
    } ]
  }, {
    "tStartMs": 708840,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "안전하다고 얘기하고 있던 때입니다"
    } ]
  }, {
    "tStartMs": 710650,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "여기가 하메네이 거처라고 알려진 위성사진이고"
    } ]
  }, {
    "tStartMs": 713220,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "하지만 안전하다 이미 어디론가 다 숨었다"
    } ]
  }, {
    "tStartMs": 716510,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "그런데 이제 다 아시지만"
    } ]
  }, {
    "tStartMs": 718460,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "저 공격 직후에"
    } ]
  }, {
    "tStartMs": 719710,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "진짜 직후에 트럼프 대통령은"
    } ]
  }, {
    "tStartMs": 721990,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "이란 최고 지도자"
    } ]
  }, {
    "tStartMs": 722890,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "알리 하메네이의 사망을 발표합니다"
    } ]
  }, {
    "tStartMs": 725440,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "옆에는 트럼프 대통령의 한 말이에요"
    } ]
  }, {
    "tStartMs": 727030,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "본인 SNS에 쓴 말입니다"
    } ]
  }, {
    "tStartMs": 728380,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "역사상 가장 악랄한 인물 중 하나인"
    } ]
  }, {
    "tStartMs": 730350,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "하메네이가 죽었다"
    } ]
  }, {
    "tStartMs": 731710,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 733220,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "하메네이는 미국의 추적을 피할 수 없었다"
    } ]
  }, {
    "tStartMs": 736330,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "하메네의 죽음은 이란 국민뿐만 아니라"
    } ]
  }, {
    "tStartMs": 738060,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "미국인과 세계 모든 이들을 위한 정의다"
    } ]
  }, {
    "tStartMs": 740770,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "우리의 정보망과 추적 시스템을"
    } ]
  }, {
    "tStartMs": 742420,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "그는 피할 수 없었고"
    } ]
  }, {
    "tStartMs": 743420,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "이란은 아무것도 할 수 없었다"
    } ]
  }, {
    "tStartMs": 745750,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "그리고 다시 한번 얘기합니다"
    } ]
  }, {
    "tStartMs": 747360,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "이란인들이여 일어나라"
    } ]
  }, {
    "tStartMs": 749570,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "바라건대 혁명수비대와 경찰들은"
    } ]
  }, {
    "tStartMs": 751220,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "이란의 애국자들과 평화롭게 통합하여"
    } ]
  }, {
    "tStartMs": 753230,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "이란을 위대한 나라로 되돌리길 바랍니다"
    } ]
  }, {
    "tStartMs": 756120,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "지금이 이란 국민들이"
    } ]
  }, {
    "tStartMs": 756930,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "조국을 되찾을 수 있는"
    } ]
  }, {
    "tStartMs": 758110,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "최고의 기회입니다"
    } ]
  }, {
    "tStartMs": 759390,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "라고 또 올렸죠"
    } ]
  }, {
    "tStartMs": 761380,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "그래서 물론 트럼프 대통령이 확인을 했지만"
    } ]
  }, {
    "tStartMs": 764170,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "진짜인가 싶었는데"
    } ]
  }, {
    "tStartMs": 765530,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "이란도 최고 지도자의 사망을 확인합니다"
    } ]
  }, {
    "tStartMs": 768440,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "이런 최고 지도자가 순교했다"
    } ]
  }, {
    "tStartMs": 771490,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "어떻게 죽었는지는 알려져 있지는 않지만"
    } ]
  }, {
    "tStartMs": 773400,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "나오는 뉴스에 따르면"
    } ]
  }, {
    "tStartMs": 774860,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "공습으로 인한"
    } ]
  }, {
    "tStartMs": 775820,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "거의 첫 공습으로 인한 사망으로 추정이 돼요"
    } ]
  }, {
    "tStartMs": 778720,
    "dDurationMs": 570,
    "segs": [ {
      "utf8": "이렇게 얘기합니다"
    } ]
  }, {
    "tStartMs": 779290,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "이란 국영통신은 토요일 새벽"
    } ]
  }, {
    "tStartMs": 781400,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "최고지도자 관저 내 집무실에서"
    } ]
  }, {
    "tStartMs": 783350,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "직무를 수행하던 중"
    } ]
  }, {
    "tStartMs": 784850,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "최고지도자가 사망했다"
    } ]
  }, {
    "tStartMs": 786430,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "토요일 아침입니다, 아침"
    } ]
  }, {
    "tStartMs": 788060,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "그리고 또 놀라운 건"
    } ]
  }, {
    "tStartMs": 789860,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "최고 지도자만 사망한 게 아니라"
    } ]
  }, {
    "tStartMs": 791580,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "이란의 육군참모총장"
    } ]
  }, {
    "tStartMs": 793390,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "국방부 장관도 사망한 것으로 보입니다"
    } ]
  }, {
    "tStartMs": 796420,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "이란 국영TV가"
    } ]
  }, {
    "tStartMs": 797730,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "육군 참모총장과 국방부 장관이 사망했다고 보도했다"
    } ]
  }, {
    "tStartMs": 801210,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "또 CBS는 약 40명의 이란 관리들이"
    } ]
  }, {
    "tStartMs": 803860,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "초기 공습으로 사망했다 라고 보도했습니다"
    } ]
  }, {
    "tStartMs": 807460,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "심지어 이란 혁명수비대 사령관도"
    } ]
  }, {
    "tStartMs": 810040,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "사망했다는 말이 나오고 있어요"
    } ]
  }, {
    "tStartMs": 812010,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "모하마드 파크프루라고 불리는데"
    } ]
  }, {
    "tStartMs": 813800,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "최고 안보 고문도 사망했다"
    } ]
  }, {
    "tStartMs": 816680,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "그런데 저게 전쟁이 시작된 지"
    } ]
  }, {
    "tStartMs": 818280,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "진짜 몇 시간 되지도 않았거든요"
    } ]
  }, {
    "tStartMs": 820190,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "어떻게 이렇게 빠른 시간 내에"
    } ]
  }, {
    "tStartMs": 822670,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "최고 수뇌부들을"
    } ]
  }, {
    "tStartMs": 824060,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "거의 표적 암살하듯이 사살할 수 있었냐"
    } ]
  }, {
    "tStartMs": 827740,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "정말로 그렇게 정보력이 뛰어났던 거냐"
    } ]
  }, {
    "tStartMs": 830530,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "월 스트리트에 여기에 관련된 기사가 나왔습니다"
    } ]
  }, {
    "tStartMs": 833980,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "이 기사를 보면"
    } ]
  }, {
    "tStartMs": 834670,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "사실은 그 이유를 어느 정도"
    } ]
  }, {
    "tStartMs": 835960,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "알 수 있었을 것 같아요"
    } ]
  }, {
    "tStartMs": 837450,
    "dDurationMs": 570,
    "segs": [ {
      "utf8": "영어로 되어 있는 건데"
    } ]
  }, {
    "tStartMs": 838020,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "제가 한글로 갖고 온 거예요"
    } ]
  }, {
    "tStartMs": 839640,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "미국과 이스라엘이 이 시점에"
    } ]
  }, {
    "tStartMs": 841410,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "공격한 것은 이유가 있었다"
    } ]
  }, {
    "tStartMs": 843350,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "미국과 이스라엘이 공격하자마자"
    } ]
  }, {
    "tStartMs": 846240,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "최고 지도자와 그 최고 지도부를"
    } ]
  }, {
    "tStartMs": 848520,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "다 죽일 수 있었던 건 아니야"
    } ]
  }, {
    "tStartMs": 850760,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "아무 때나 그럴 수 있었던 건 아니야"
    } ]
  }, {
    "tStartMs": 852760,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "그 시점을 노리고"
    } ]
  }, {
    "tStartMs": 854400,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "공격을 시작한 거다"
    } ]
  }, {
    "tStartMs": 856250,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "이스라엘과 미국, 군사정보국은"
    } ]
  }, {
    "tStartMs": 858600,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "이란의 고위 정치 및 군사 지도자들이"
    } ]
  }, {
    "tStartMs": 861090,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "회의를 여는 기회를"
    } ]
  }, {
    "tStartMs": 862420,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "오랫동안 주시하고 기다려왔다"
    } ]
  }, {
    "tStartMs": 864180,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "한마디로 D-day가 있었다는 말입니다"
    } ]
  }, {
    "tStartMs": 867310,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "월스트리트에 따르면"
    } ]
  }, {
    "tStartMs": 868810,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "이들이 모이는 그 회의날을 미리 알고 있었어"
    } ]
  }, {
    "tStartMs": 872000,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "그래서 협상을 하면서"
    } ]
  }, {
    "tStartMs": 872920,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "그 D-day 내에 협상이 끝나면"
    } ]
  }, {
    "tStartMs": 875200,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "뭐 이란과 전쟁을 안 할 수도 있겠죠"
    } ]
  }, {
    "tStartMs": 877100,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "근데 협상을 하다가도"
    } ]
  }, {
    "tStartMs": 878320,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "이 디데이가 오면"
    } ]
  }, {
    "tStartMs": 879550,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "그날이 공격 날이었다는 겁니다"
    } ]
  }, {
    "tStartMs": 881980,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "공격을 시작하자마자"
    } ]
  }, {
    "tStartMs": 883140,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "저들을 암살한 게 아니라"
    } ]
  }, {
    "tStartMs": 885080,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "암살이 곧 전쟁의 시작이었던 거죠"
    } ]
  }, {
    "tStartMs": 888260,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "그래서 그 자리에서"
    } ]
  }, {
    "tStartMs": 889660,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "모든 지도자들을 한꺼번에 제거할"
    } ]
  }, {
    "tStartMs": 891720,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "수 있을 것이라고 판단했다"
    } ]
  }, {
    "tStartMs": 893230,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "전쟁의 개시일자는 우연이 아니었다"
    } ]
  }, {
    "tStartMs": 895920,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "그 증거로 월스트리트가 얘기하는 건"
    } ]
  }, {
    "tStartMs": 898240,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "토요일 대낮의 아침입니다"
    } ]
  }, {
    "tStartMs": 899960,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "토요일 오전에 공습을 감행했는데"
    } ]
  }, {
    "tStartMs": 902530,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "보통 전쟁의 시작은"
    } ]
  }, {
    "tStartMs": 904010,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "완전 새벽, 어둑어둑할 때"
    } ]
  }, {
    "tStartMs": 905540,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "아니면 밤에 합니다"
    } ]
  }, {
    "tStartMs": 907140,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "그런데 왜 낮에 했냐?"
    } ]
  }, {
    "tStartMs": 909070,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "그때가 이란의 최고 지도자인 아야톨라 하메네이가"
    } ]
  }, {
    "tStartMs": 912190,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "참석을 했다는 것을 알고 있었다는 거죠"
    } ]
  }, {
    "tStartMs": 915940,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "정보전에서 완전히 밀렸다고 할 수 있고"
    } ]
  }, {
    "tStartMs": 918860,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "물론 미국의 주장이긴 합니다"
    } ]
  }, {
    "tStartMs": 920500,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "어찌됐건 주장이긴 하지만"
    } ]
  }, {
    "tStartMs": 921860,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "그리고 이스라엘은 하메네이 거처에"
    } ]
  }, {
    "tStartMs": 923360,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "30발의 폭탄을 투하했다고 밝혔어요"
    } ]
  }, {
    "tStartMs": 926160,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "무슨 폭탄을 투하했는지 모르겠습니다"
    } ]
  }, {
    "tStartMs": 928290,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "결국에는 거기에 모여있던"
    } ]
  }, {
    "tStartMs": 930120,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "최고 지도자를 포함해서"
    } ]
  }, {
    "tStartMs": 931540,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "지도부 세력들을 굉장히 많이 암살했다는 거고요"
    } ]
  }, {
    "tStartMs": 934850,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "이스라엘의 첫 공격이 그냥 공격이 아니었고"
    } ]
  }, {
    "tStartMs": 937640,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "역사상 최대 규모의"
    } ]
  }, {
    "tStartMs": 938790,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "이스라엘 역사상 최대 규모의"
    } ]
  }, {
    "tStartMs": 940620,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "단일 공습 작전이었다고 합니다"
    } ]
  }, {
    "tStartMs": 942620,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "이스라엘은 첫 공습을"
    } ]
  }, {
    "tStartMs": 944220,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "200대의 전투기로"
    } ]
  }, {
    "tStartMs": 945900,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "500개의 타격 목표물을"
    } ]
  }, {
    "tStartMs": 947250,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "동시에 타격했고"
    } ]
  }, {
    "tStartMs": 948560,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "이스라엘 역사상 최대 규모의"
    } ]
  }, {
    "tStartMs": 950250,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "단일 공습 작전이었다"
    } ]
  }, {
    "tStartMs": 952220,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "그러니까 그냥 몇 대 보내서"
    } ]
  }, {
    "tStartMs": 954140,
    "dDurationMs": 670,
    "segs": [ {
      "utf8": "전쟁 시작이야"
    } ]
  }, {
    "tStartMs": 954810,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "이거 한 게 아니라"
    } ]
  }, {
    "tStartMs": 955760,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "가만히 있다가 한 방에"
    } ]
  }, {
    "tStartMs": 957590,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "첫 한 방을"
    } ]
  }, {
    "tStartMs": 958710,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "엄청나게 파워를 실어서"
    } ]
  }, {
    "tStartMs": 960770,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "때렸다고 보면 되겠죠"
    } ]
  }, {
    "tStartMs": 962910,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "한마디로 이란은 몰랐지만"
    } ]
  }, {
    "tStartMs": 965610,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "제가 생각하는 겁니다"
    } ]
  }, {
    "tStartMs": 966820,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "이란은 몰랐지만"
    } ]
  }, {
    "tStartMs": 968170,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "그들의 협상은"
    } ]
  }, {
    "tStartMs": 969370,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "시간 제한이 있었어요"
    } ]
  }, {
    "tStartMs": 971580,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "이 디데이가 있었다는 거죠"
    } ]
  }, {
    "tStartMs": 973510,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "디데이가 잡힌 순간"
    } ]
  }, {
    "tStartMs": 974910,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "이 회담은 타임어택이었어요"
    } ]
  }, {
    "tStartMs": 976970,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "이란은 몰랐지"
    } ]
  }, {
    "tStartMs": 978340,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "시간을 본인들은 끄는 게"
    } ]
  }, {
    "tStartMs": 979750,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "좋은 전략이었다고 생각할 수 있지만"
    } ]
  }, {
    "tStartMs": 981940,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "그런 게 아니었다는 겁니다"
    } ]
  }, {
    "tStartMs": 983070,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "시간을 끌면 공격은 시작되는 거예요"
    } ]
  }, {
    "tStartMs": 985930,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "타임어택이었는데"
    } ]
  }, {
    "tStartMs": 987590,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "이란만 그걸 몰랐다는 거고"
    } ]
  }, {
    "tStartMs": 990010,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "이란이 정보전에서 얼마나 패배를 했냐"
    } ]
  }, {
    "tStartMs": 992440,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "전쟁이 시작됨과 동시에"
    } ]
  }, {
    "tStartMs": 993860,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "이스라엘이"
    } ]
  }, {
    "tStartMs": 994660,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "이란의 국영통신사를 해킹했습니다"
    } ]
  }, {
    "tStartMs": 997020,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "그래서 이란의 국영통신사 1면에"
    } ]
  }, {
    "tStartMs": 999020,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "바로 이스라엘의 메시지가"
    } ]
  }, {
    "tStartMs": 1000900,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "대문짝만하게 떴대요"
    } ]
  }, {
    "tStartMs": 1002550,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "우리가 졌다"
    } ]
  }, {
    "tStartMs": 1003290,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "뭐 이런 거겠죠"
    } ]
  }, {
    "tStartMs": 1004370,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "아야톨라 정권의 보안군에게는"
    } ]
  }, {
    "tStartMs": 1006060,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "끔찍한 일이 벌어졌다"
    } ]
  }, {
    "tStartMs": 1007870,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "이스라엘 혁명수비대"
    } ]
  }, {
    "tStartMs": 1008930,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "바시지 민병대는 치명적인 타격 입고 궤멸했다"
    } ]
  }, {
    "tStartMs": 1012160,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "라는 게 본인의 국영통신사에"
    } ]
  }, {
    "tStartMs": 1013930,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "해킹을 당해서 그게 1면에 뜨게 만들었다는 거고요"
    } ]
  }, {
    "tStartMs": 1017180,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "이스라엘 정보당국에"
    } ]
  }, {
    "tStartMs": 1018580,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "완벽하게 파악이 된 게 아닌가"
    } ]
  }, {
    "tStartMs": 1020690,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "라고 개인적으로 생각하고"
    } ]
  }, {
    "tStartMs": 1021990,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "그렇기 때문에 시작과 동시에"
    } ]
  }, {
    "tStartMs": 1023710,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "수뇌부를 암살하면서"
    } ]
  }, {
    "tStartMs": 1025230,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "전쟁이 시작이 됐고"
    } ]
  }, {
    "tStartMs": 1026850,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "지도자들의 위치와"
    } ]
  }, {
    "tStartMs": 1028010,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "회의 시간이 정확하게 유출됐다"
    } ]
  }, {
    "tStartMs": 1029820,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "심지어 최고 지도자의 시간까지"
    } ]
  }, {
    "tStartMs": 1031990,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "해당 시간에 맞춰서"
    } ]
  }, {
    "tStartMs": 1032980,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "전투기가 발사됐고"
    } ]
  }, {
    "tStartMs": 1034350,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "미사일이 투하됐다 집중적으로"
    } ]
  }, {
    "tStartMs": 1036160,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "전쟁 시작과 동시에 국영통신사가"
    } ]
  }, {
    "tStartMs": 1037810,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "사실상 패배 메시지를 송출했고"
    } ]
  }, {
    "tStartMs": 1040280,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "심지어 이건 월스트리트에 나온 건데"
    } ]
  }, {
    "tStartMs": 1041840,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "이란 군인들이 사용하는"
    } ]
  }, {
    "tStartMs": 1043570,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "무슬림 기도 시간 앱을 해킹해서"
    } ]
  }, {
    "tStartMs": 1045640,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "탈영을 촉구하는 메시지를"
    } ]
  }, {
    "tStartMs": 1047190,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "이란 군인들이 받아보게 만들었다"
    } ]
  }, {
    "tStartMs": 1049440,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "말도 안 되죠 이거"
    } ]
  }, {
    "tStartMs": 1051970,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "군인들의 이 앱에 떴다는 거죠"
    } ]
  }, {
    "tStartMs": 1054670,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "군인들이 사용하는 네트워크에"
    } ]
  }, {
    "tStartMs": 1056350,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "우리 졌습니다"
    } ]
  }, {
    "tStartMs": 1057390,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "빨리 탈영하세요"
    } ]
  }, {
    "tStartMs": 1058350,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "지금 안 탈영하면 당신은 죽습니다"
    } ]
  }, {
    "tStartMs": 1060010,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "이런 게 떴다는 거예요"
    } ]
  }, {
    "tStartMs": 1061200,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "사실상 이 정도면"
    } ]
  }, {
    "tStartMs": 1063170,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "정보전에서는 완전히 패배한 게 아닌가"
    } ]
  }, {
    "tStartMs": 1065360,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "생각이 되고"
    } ]
  }, {
    "tStartMs": 1066240,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "앞으로는 모르겠지만 시작은"
    } ]
  }, {
    "tStartMs": 1068240,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "이란은 현재 최고 수준의"
    } ]
  }, {
    "tStartMs": 1069690,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "복수를 다짐하고 있습니다"
    } ]
  }, {
    "tStartMs": 1071240,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "최고 지도자가 사망을 했기 때문에"
    } ]
  }, {
    "tStartMs": 1073370,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "전쟁이 끝나거나"
    } ]
  }, {
    "tStartMs": 1074730,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "아니면 좀 굽히거나"
    } ]
  }, {
    "tStartMs": 1076460,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "우리가 졌다 미안하다"
    } ]
  }, {
    "tStartMs": 1077470,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "다시 하자"
    } ]
  }, {
    "tStartMs": 1078400,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "이렇게 되기를 바랬는데"
    } ]
  }, {
    "tStartMs": 1081170,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "전쟁은 빨리 끝나야 되니까"
    } ]
  }, {
    "tStartMs": 1082690,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "다시 타협으로 들어가고"
    } ]
  }, {
    "tStartMs": 1084130,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "대화로 들어가고를 바랬는데"
    } ]
  }, {
    "tStartMs": 1085650,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "이란은 현재 최고 수준의"
    } ]
  }, {
    "tStartMs": 1086930,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "복수를 다짐하고 있습니다"
    } ]
  }, {
    "tStartMs": 1088070,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 1088940,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "미국은 이란 국민의 심장을 찔렀고"
    } ]
  }, {
    "tStartMs": 1091300,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "우리는 미국의 심장을 찌를 것이다"
    } ]
  }, {
    "tStartMs": 1093190,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "우리 군대의 보복은 훨씬 더 강력해질 것이다"
    } ]
  }, {
    "tStartMs": 1096610,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "너희 지금 지도자 없잖아"
    } ]
  }, {
    "tStartMs": 1097970,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "임시 지도의 체제로 보복을 이어나갈 것이다"
    } ]
  }, {
    "tStartMs": 1100280,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "임시 지도위원회는 일요일에 구성될 것이고"
    } ]
  }, {
    "tStartMs": 1102960,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "우리가 지금 지도부가 없어졌다고 해서"
    } ]
  }, {
    "tStartMs": 1105360,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "어떤 분리주의 단체라도"
    } ]
  }, {
    "tStartMs": 1107020,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "이란 시민들의 혁명"
    } ]
  }, {
    "tStartMs": 1108260,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "이런 걸 두려워하는 거죠"
    } ]
  }, {
    "tStartMs": 1109560,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "행동을 시도할 경우에"
    } ]
  }, {
    "tStartMs": 1110520,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "강력한 대응으로 맞설 것이다"
    } ]
  }, {
    "tStartMs": 1113370,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "그리고 이란 혁명 수비대는"
    } ]
  }, {
    "tStartMs": 1114780,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "사령관이 암살되었다고 알려져 있는데"
    } ]
  }, {
    "tStartMs": 1117250,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "맹렬한 공세 작전이라는 걸 예고했습니다"
    } ]
  }, {
    "tStartMs": 1120530,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "이란군 역사상 가장 맹렬한 공세 작전을"
    } ]
  }, {
    "tStartMs": 1122930,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "이스라엘과 미군 기지를 대상으로"
    } ]
  }, {
    "tStartMs": 1124420,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "곧 시작할 것이다"
    } ]
  }, {
    "tStartMs": 1126190,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "물론 이게 얼마나 올지 모르겠는데"
    } ]
  }, {
    "tStartMs": 1128160,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "새로운 무기를 발사할 거다"
    } ]
  }, {
    "tStartMs": 1129570,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "이런 말을 하고 있는데"
    } ]
  }, {
    "tStartMs": 1131170,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "실제로 엄포일지"
    } ]
  }, {
    "tStartMs": 1132510,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "뭐가 있는지 한번 봐야 되지 않을까"
    } ]
  }, {
    "tStartMs": 1134100,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "생각을 하고"
    } ]
  }, {
    "tStartMs": 1134900,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "이란 시민들의 반응은 어떠냐?"
    } ]
  }, {
    "tStartMs": 1136790,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "이건 알 수 없죠"
    } ]
  }, {
    "tStartMs": 1138100,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "진짜 알 수 없는데"
    } ]
  }, {
    "tStartMs": 1139330,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "CNN에 따르면"
    } ]
  }, {
    "tStartMs": 1140480,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "애도와 축하가 뒤섞여 있다고 합니다"
    } ]
  }, {
    "tStartMs": 1143330,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "하메네이 사망 확인 후"
    } ]
  }, {
    "tStartMs": 1144410,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "이란 국민들이 거리로 나와"
    } ]
  }, {
    "tStartMs": 1145600,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "축하 행사를 벌이고 있다"
    } ]
  }, {
    "tStartMs": 1147290,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "그만큼 민심을 잃었고"
    } ]
  }, {
    "tStartMs": 1148650,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "3만 명, 4만 명을 학살을 했고"
    } ]
  }, {
    "tStartMs": 1150610,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "40년 넘게 독재를 했기 때문에"
    } ]
  }, {
    "tStartMs": 1153040,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "이란 국민들이 정치에 대해서"
    } ]
  }, {
    "tStartMs": 1155520,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "바뀌기를 원하는 것은"
    } ]
  }, {
    "tStartMs": 1156610,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "기정사실인 것 같고요"
    } ]
  }, {
    "tStartMs": 1158150,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "반면에 수천 명의 친정부 성향 지도자들이"
    } ]
  }, {
    "tStartMs": 1160700,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "광장에 나와서 하메네이의 죽음을 애도하기로 했다"
    } ]
  }, {
    "tStartMs": 1163460,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "완전히 나뉘였다는 거죠"
    } ]
  }, {
    "tStartMs": 1166110,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "이란이 보복을 얘기하니까"
    } ]
  }, {
    "tStartMs": 1167260,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "트럼프 대통령도 또 메시지를 날렸습니다"
    } ]
  }, {
    "tStartMs": 1170380,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "이란은 그 어느 때보다"
    } ]
  }, {
    "tStartMs": 1171640,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "강력한 공격을 감행하겠다고 밝혔다"
    } ]
  }, {
    "tStartMs": 1174490,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "하지만 그렇게 해서는 안 된다"
    } ]
  }, {
    "tStartMs": 1176890,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "만약 이란이 강력한 반격을 한다면"
    } ]
  }, {
    "tStartMs": 1179710,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "우리는 전례 없는 위력으로"
    } ]
  }, {
    "tStartMs": 1181260,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "그들을 응징할 것이다"
    } ]
  }, {
    "tStartMs": 1183350,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "라고 얘기를 했죠"
    } ]
  }, {
    "tStartMs": 1184780,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "그리고 실제로 일요일 아침"
    } ]
  }, {
    "tStartMs": 1186550,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "자료를 만드는 와중에"
    } ]
  }, {
    "tStartMs": 1188080,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "이란의 반격이 실제로 발생을 한 것처럼 보입니다"
    } ]
  }, {
    "tStartMs": 1191250,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "현재까지는 지금부터 계속 뉴스가 나오겠지만"
    } ]
  }, {
    "tStartMs": 1193860,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "두바이, 도하"
    } ]
  }, {
    "tStartMs": 1195010,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "이런 걸프만 도시 전역에서"
    } ]
  }, {
    "tStartMs": 1196520,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "폭발이 발생을 했고요"
    } ]
  }, {
    "tStartMs": 1198670,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "아까 말씀드렸지만"
    } ]
  }, {
    "tStartMs": 1199440,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "이란은 중동 여러 도시에 대한"
    } ]
  }, {
    "tStartMs": 1200870,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "반격을 감행하고 있다고 밝혔습니다"
    } ]
  }, {
    "tStartMs": 1203240,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "주요 공항이 파괴됐고"
    } ]
  }, {
    "tStartMs": 1204860,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "인구 밀집 지역도 공격이 예외가 아니었고"
    } ]
  }, {
    "tStartMs": 1207300,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "가장 우리한테는 좀 알만한 뉴스는"
    } ]
  }, {
    "tStartMs": 1210020,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "부르주 알 아랍 호텔"
    } ]
  }, {
    "tStartMs": 1211370,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "예쁘게 생긴 호텔 있잖아요"
    } ]
  }, {
    "tStartMs": 1213100,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "여기에 이란 드론이 추락하여"
    } ]
  }, {
    "tStartMs": 1214990,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "화재가 발생했다고 합니다"
    } ]
  }, {
    "tStartMs": 1216450,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "이 건물에 타격을 입은 건 아니고"
    } ]
  }, {
    "tStartMs": 1218430,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "이 근처 어디에 이란의 드론이 떨어진 모양이야"
    } ]
  }, {
    "tStartMs": 1221280,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "작은 화재가 발생했던..."
    } ]
  }, {
    "tStartMs": 1222940,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "그런 일까지 벌어졌다고 하고"
    } ]
  }, {
    "tStartMs": 1225470,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "두바이 입장에서는"
    } ]
  }, {
    "tStartMs": 1226310,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "굉장히 예민하게 전쟁을 볼 수밖에 없고"
    } ]
  }, {
    "tStartMs": 1228630,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "무엇보다도 최대 관심사는 이거죠"
    } ]
  }, {
    "tStartMs": 1230830,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "과연 이란이 호르무즈 해협을 봉쇄할 것이냐"
    } ]
  }, {
    "tStartMs": 1235010,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "페르시아만이라고 불리는 소위 아랍만이라고"
    } ]
  }, {
    "tStartMs": 1237420,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "불리는 여기를 이렇게 나오죠"
    } ]
  }, {
    "tStartMs": 1239400,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "이렇게 나와서 인도양으로 빠져나오는 건데"
    } ]
  }, {
    "tStartMs": 1241880,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "여기가 호르무즈 해협이잖아요"
    } ]
  }, {
    "tStartMs": 1243450,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "여기를 봉쇄할 거냐"
    } ]
  }, {
    "tStartMs": 1245020,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "지금 미사일 이렇게 쏘고 있는 거죠"
    } ]
  }, {
    "tStartMs": 1246740,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "이런 식으로 이란이"
    } ]
  }, {
    "tStartMs": 1247980,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "건너편에서 쏘고 있는 건데"
    } ]
  }, {
    "tStartMs": 1249000,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "바다 건너에서"
    } ]
  }, {
    "tStartMs": 1249860,
    "dDurationMs": 3730,
    "segs": [ {
      "utf8": "이 해협을 봉쇄하게 되면 심각해지겠죠"
    } ]
  }, {
    "tStartMs": 1253590,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "너무나 잘 아시지만"
    } ]
  }, {
    "tStartMs": 1254680,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "여기 조그맣게 보이는 목줄처럼 보이는"
    } ]
  }, {
    "tStartMs": 1256680,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "호르무즈 해협은"
    } ]
  }, {
    "tStartMs": 1257480,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "이 안에가 사우디"
    } ]
  }, {
    "tStartMs": 1258910,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "여기가 이라크, 아랍에미리트, 쿠웨이트"
    } ]
  }, {
    "tStartMs": 1262170,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "이란 이런 원유가 전부 다 나오는 길목입니다"
    } ]
  }, {
    "tStartMs": 1265030,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "세계 원유의 20%가"
    } ]
  }, {
    "tStartMs": 1266270,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "여기를 통과한다고 알려져 있고요"
    } ]
  }, {
    "tStartMs": 1267810,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "특히 세계 원유가 문제가 아니라"
    } ]
  }, {
    "tStartMs": 1269580,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "우리나라 원유 수입량의"
    } ]
  }, {
    "tStartMs": 1270860,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "70%가 여기를 통과합니다"
    } ]
  }, {
    "tStartMs": 1273060,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "일본도 거의 비슷할 거예요"
    } ]
  }, {
    "tStartMs": 1274360,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "아시아로 나오는 원유들이"
    } ]
  }, {
    "tStartMs": 1275760,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "아시아 가깝잖아"
    } ]
  }, {
    "tStartMs": 1277230,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "여기를 지금 막으면"
    } ]
  }, {
    "tStartMs": 1278880,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "우리나라나 일본은"
    } ]
  }, {
    "tStartMs": 1280180,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "유가가 굉장히 어렵지 않냐라는 얘기를"
    } ]
  }, {
    "tStartMs": 1282070,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "또 많이 하고"
    } ]
  }, {
    "tStartMs": 1283420,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "현재까지 나온"
    } ]
  }, {
    "tStartMs": 1284420,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "제가 이 자료를 만들 때까지만"
    } ]
  }, {
    "tStartMs": 1285550,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "해도 어떤 스탠스였냐"
    } ]
  }, {
    "tStartMs": 1286840,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "일단 이란 혁명수비대는"
    } ]
  }, {
    "tStartMs": 1288160,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "호르무즈 해협 봉쇄를 선언했다고 알려져 있습니다"
    } ]
  }, {
    "tStartMs": 1291290,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "왜냐하면 주변에 지나가는 선박들에게"
    } ]
  }, {
    "tStartMs": 1293410,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "호르무즈 해협을 통과할 수 없다는"
    } ]
  }, {
    "tStartMs": 1294870,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "무전을 발신했다고 알려져 있어요"
    } ]
  }, {
    "tStartMs": 1296870,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "다만 아직 이란이"
    } ]
  }, {
    "tStartMs": 1298100,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "공식적으로 봉쇄 선언을 하진 않았어요"
    } ]
  }, {
    "tStartMs": 1301260,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "오후 11시 14분까지는"
    } ]
  }, {
    "tStartMs": 1302670,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "아니 한 8시까지는 안 그랬습니다"
    } ]
  }, {
    "tStartMs": 1304900,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "지금은 모르겠어요"
    } ]
  }, {
    "tStartMs": 1306350,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "지금 어떻게 하는지 모르겠는데"
    } ]
  }, {
    "tStartMs": 1307810,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "아직 공식적인 선언은 아니지만"
    } ]
  }, {
    "tStartMs": 1309420,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "어쨌건 호르무즈 해협을"
    } ]
  }, {
    "tStartMs": 1311130,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "통과할 수 없는 건 맞는 것 같고"
    } ]
  }, {
    "tStartMs": 1312800,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "왜냐하면 이런 상황에서"
    } ]
  }, {
    "tStartMs": 1314960,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "누가 거기를 유조선을 끌고 통과하겠어요"
    } ]
  }, {
    "tStartMs": 1317840,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "미사일이 언제 날아올지 모르던데"
    } ]
  }, {
    "tStartMs": 1320100,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "그러니까 이란이 공식적으로"
    } ]
  }, {
    "tStartMs": 1321080,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "막냐 안 막냐가 중요한 게 아니라"
    } ]
  }, {
    "tStartMs": 1322810,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "쏘냐 안 쏘냐인데"
    } ]
  }, {
    "tStartMs": 1324270,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "지금 쏠지 안 쏠지 모르는 상황에서"
    } ]
  }, {
    "tStartMs": 1325920,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "누가 거기를 가겠어"
    } ]
  }, {
    "tStartMs": 1327560,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "그렇기 때문에 선박의 통행량이"
    } ]
  }, {
    "tStartMs": 1328860,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "이미 70%가 감소했다"
    } ]
  }, {
    "tStartMs": 1330250,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "멈췄다는 거죠"
    } ]
  }, {
    "tStartMs": 1331280,
    "dDurationMs": 580,
    "segs": [ {
      "utf8": "잠깐!"
    } ]
  }, {
    "tStartMs": 1331860,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "앞뒤로 멈췄고"
    } ]
  }, {
    "tStartMs": 1333190,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "일부 선박은 전속력으로 빠져나가고 있다"
    } ]
  }, {
    "tStartMs": 1335840,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "기회가 있을 때"
    } ]
  }, {
    "tStartMs": 1336990,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "빨리 빠져나가려고"
    } ]
  }, {
    "tStartMs": 1337900,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "조금 진입했는데"
    } ]
  }, {
    "tStartMs": 1338700,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "어? 어떻게 된 거야? 확!"
    } ]
  }, {
    "tStartMs": 1339940,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "지금 전부 이제 그러고 있는"
    } ]
  }, {
    "tStartMs": 1341280,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "상황이라고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 1343240,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "게다가 호르무즈 해협 말고"
    } ]
  }, {
    "tStartMs": 1345890,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "여기 아덴만 앞에"
    } ]
  }, {
    "tStartMs": 1346970,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "홍해, 홍해죠 홍해"
    } ]
  }, {
    "tStartMs": 1349150,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "이란의 지원을 받는"
    } ]
  }, {
    "tStartMs": 1350290,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "여기 예멘입니다"
    } ]
  }, {
    "tStartMs": 1351460,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "예멘의 후티 반군이"
    } ]
  }, {
    "tStartMs": 1353150,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "공격 참전 의사를 표명했어요"
    } ]
  }, {
    "tStartMs": 1355420,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "표명만 했습니다"
    } ]
  }, {
    "tStartMs": 1356270,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "뭐라고 얘기를 했냐?"
    } ]
  }, {
    "tStartMs": 1357290,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "이스라엘과 홍해를 통과하는 선박에 대해"
    } ]
  }, {
    "tStartMs": 1359290,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "공격 재개를 하겠다"
    } ]
  }, {
    "tStartMs": 1360640,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "옛날에 이 예멘의 후티 반군이"
    } ]
  }, {
    "tStartMs": 1362380,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "홍해 막아가지고"
    } ]
  }, {
    "tStartMs": 1363680,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "프랑스도 출격하고"
    } ]
  }, {
    "tStartMs": 1364680,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "미국도 출격하고 했었죠"
    } ]
  }, {
    "tStartMs": 1366510,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "그러면 만약에 얘네가 여기를 막는다"
    } ]
  }, {
    "tStartMs": 1368750,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "여기가 수에즈 운하입니다"
    } ]
  }, {
    "tStartMs": 1369850,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "여기가 홍해고 이렇게 나오는데"
    } ]
  }, {
    "tStartMs": 1371510,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "아덴만"
    } ]
  }, {
    "tStartMs": 1372500,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "여기가 아까 페르시아만"
    } ]
  }, {
    "tStartMs": 1374240,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "여기도 막고, 여기도 막으면"
    } ]
  }, {
    "tStartMs": 1376630,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "이 안에 있는 중동 국가들의"
    } ]
  }, {
    "tStartMs": 1378420,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "석유가 나올 길이 없죠"
    } ]
  }, {
    "tStartMs": 1380810,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "아 그거는 그런 일은 없으리라고 생각하는데"
    } ]
  }, {
    "tStartMs": 1383720,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "만약에 두 개가 동시에 막히면"
    } ]
  }, {
    "tStartMs": 1385650,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "문제가 굉장히 커지겠죠"
    } ]
  }, {
    "tStartMs": 1386720,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "하지만 후티 반군이 지금까지는 뭐"
    } ]
  }, {
    "tStartMs": 1388700,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "본격적인 지금 미사일을"
    } ]
  }, {
    "tStartMs": 1390620,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "쐈다라는 내용도 나오고 있어요"
    } ]
  }, {
    "tStartMs": 1391990,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "나오고 있는데"
    } ]
  }, {
    "tStartMs": 1393330,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "이렇게 확대되지 않기를 기도해야겠죠"
    } ]
  }, {
    "tStartMs": 1395880,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "양쪽이 동시에 막히면"
    } ]
  }, {
    "tStartMs": 1396990,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "아마 굉장히 커질 수 있지 않나 생각하고"
    } ]
  }, {
    "tStartMs": 1399960,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "그리고 가장 중요한 거"
    } ]
  }, {
    "tStartMs": 1402110,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "많은 분들이 코스피 항방에 대해서"
    } ]
  }, {
    "tStartMs": 1404080,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "지금 우려하고 계십니다"
    } ]
  }, {
    "tStartMs": 1406180,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "굉장히 빠르게 올라왔죠"
    } ]
  }, {
    "tStartMs": 1408350,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "그렇기 때문에 타격도 굉장히 있을까봐"
    } ]
  }, {
    "tStartMs": 1410750,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "있을까봐"
    } ]
  }, {
    "tStartMs": 1412090,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "우리는 3월 1일 월요일이"
    } ]
  }, {
    "tStartMs": 1413270,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "삼일절 휴장입니다"
    } ]
  }, {
    "tStartMs": 1414940,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "그래서 오늘 말고"
    } ]
  }, {
    "tStartMs": 1415580,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "내일은 일단 상황이 어떻게 돌아가는지를"
    } ]
  }, {
    "tStartMs": 1418370,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "하루 더 볼 수 있어요"
    } ]
  }, {
    "tStartMs": 1419870,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "실제로 미국 시장이 어떻게 움직이는지를"
    } ]
  }, {
    "tStartMs": 1422230,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "좀 볼 수 있겠죠"
    } ]
  }, {
    "tStartMs": 1423650,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "그래서 많은 분들이 걱정을 하는데"
    } ]
  }, {
    "tStartMs": 1426640,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "이거는 진짜 전쟁의 양상에 따라서"
    } ]
  }, {
    "tStartMs": 1428260,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "많이 달라지지 않을까 생각하는데"
    } ]
  }, {
    "tStartMs": 1431570,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "유전을 통과하는 데"
    } ]
  }, {
    "tStartMs": 1432350,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "큰 문제가 없는 정도라면"
    } ]
  }, {
    "tStartMs": 1434190,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "사실 우리나라 경제에"
    } ]
  }, {
    "tStartMs": 1435410,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "바로바로 영향을 미치는 문제는 아니니까"
    } ]
  }, {
    "tStartMs": 1438470,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "큰 타격이 없기를 기대하고 있고"
    } ]
  }, {
    "tStartMs": 1441100,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "기원하고 있고"
    } ]
  }, {
    "tStartMs": 1442010,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "특히 하루!"
    } ]
  }, {
    "tStartMs": 1442910,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "하루 좀 쉬었다 가니까"
    } ]
  }, {
    "tStartMs": 1444210,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "다른 나라가 막 크게 움직일 때"
    } ]
  }, {
    "tStartMs": 1447140,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "조금 우리는 결과를 지켜보면서"
    } ]
  }, {
    "tStartMs": 1448890,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "갈 수도 있지 않을까 생각해서"
    } ]
  }, {
    "tStartMs": 1450310,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "코스피가 좀 잘 선방하기를"
    } ]
  }, {
    "tStartMs": 1452290,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "어려운 날 미국 시장에 대한"
    } ]
  }, {
    "tStartMs": 1453390,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "관심도 굉장히 올라가겠죠"
    } ]
  }, {
    "tStartMs": 1455170,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "그리고 세계는 어떻게 반응하고 있냐"
    } ]
  }, {
    "tStartMs": 1457270,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "일단 유엔은 안전보장회사회를 긴급 개최했습니다"
    } ]
  }, {
    "tStartMs": 1460740,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "이러한 문제에 관한 긴급 회의를 개최하겠다"
    } ]
  }, {
    "tStartMs": 1463250,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "그러면서 긴급하게"
    } ]
  }, {
    "tStartMs": 1465080,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "심심한 규탄을 발표했습니다"
    } ]
  }, {
    "tStartMs": 1467560,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "오늘 중동에서 발생한 군사적 긴장구조"
    } ]
  }, {
    "tStartMs": 1469570,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "규탄한다"
    } ]
  }, {
    "tStartMs": 1470390,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "미국과 이스라엘의"
    } ]
  }, {
    "tStartMs": 1471000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "이란에 대한 무력 사용"
    } ]
  }, {
    "tStartMs": 1472000,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "국제 평화와 안보를 훼손한다"
    } ]
  }, {
    "tStartMs": 1473310,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "전쟁하지 마라"
    } ]
  }, {
    "tStartMs": 1474280,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "라고 심심한 규탄을 발표했고요"
    } ]
  }, {
    "tStartMs": 1476710,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "중국은 강력하게 비난했습니다"
    } ]
  }, {
    "tStartMs": 1479730,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "주권 국가에 대한 뻔뻔스러운 침략이자"
    } ]
  }, {
    "tStartMs": 1481650,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "힘의 정치와 패권주의의 일환이다"
    } ]
  }, {
    "tStartMs": 1483930,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "유엔 헌장의 노골적인 위반이며"
    } ]
  }, {
    "tStartMs": 1485420,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "국제관계의 근본규범에서 벗어나는 일이다"
    } ]
  }, {
    "tStartMs": 1488450,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "어떻게 주권국가를 쳐들어갈 수 있냐?"
    } ]
  }, {
    "tStartMs": 1490240,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "침략할 수 있냐?"
    } ]
  }, {
    "tStartMs": 1491070,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "남의 나라를 쳐들어가고"
    } ]
  }, {
    "tStartMs": 1492480,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "힘으로 억압하고 바다를 막고"
    } ]
  }, {
    "tStartMs": 1494730,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "이러는 건 말도 안 된다"
    } ]
  }, {
    "tStartMs": 1495750,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "그런 건 하는 게 아니다"
    } ]
  }, {
    "tStartMs": 1496870,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "패권주의는 없다"
    } ]
  }, {
    "tStartMs": 1497860,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "라고 강력하게 비난을 했고요"
    } ]
  }, {
    "tStartMs": 1500450,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "러시아 외무부도 강력하게"
    } ]
  }, {
    "tStartMs": 1501720,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "비난한 성명을 발표했습니다"
    } ]
  }, {
    "tStartMs": 1503810,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "이란은 유엔 회원국인데"
    } ]
  }, {
    "tStartMs": 1505350,
    "dDurationMs": 590,
    "segs": [ {
      "utf8": "그런 나라에 대해서"
    } ]
  }, {
    "tStartMs": 1505940,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "고의적이고 계획적인 무력을 침략을 하다니"
    } ]
  }, {
    "tStartMs": 1508200,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "이건 국제법과 규범을 정면으로 위반하는 행위다"
    } ]
  }, {
    "tStartMs": 1511270,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "침략자들의 의도는 이란의 헌정질서를 파기하고"
    } ]
  }, {
    "tStartMs": 1514140,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "무력과 패권에 굴복하지 않는"
    } ]
  }, {
    "tStartMs": 1515720,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "국가의 지도부를 제거하겠다는 것이다"
    } ]
  }, {
    "tStartMs": 1518290,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "강제국의 패권에 굴복하지 않는다고"
    } ]
  }, {
    "tStartMs": 1520730,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "그 국가에 쳐들어가서"
    } ]
  }, {
    "tStartMs": 1521940,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "그 국가 지도부를 제거하겠다는"
    } ]
  }, {
    "tStartMs": 1523530,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "이런 행태"
    } ]
  }, {
    "tStartMs": 1524570,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "이런 야만적인 행태에게 말이 되냐"
    } ]
  }, {
    "tStartMs": 1527100,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "전쟁 말이야 그런 거"
    } ]
  }, {
    "tStartMs": 1528220,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "유엔 회원국이 어떻게 쳐들어가?"
    } ]
  }, {
    "tStartMs": 1529890,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "라고 얘기를 했고요"
    } ]
  }, {
    "tStartMs": 1532440,
    "dDurationMs": 420,
    "segs": [ {
      "utf8": "그렇죠?"
    } ]
  }, {
    "tStartMs": 1532860,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "뭐 그래요"
    } ]
  }, {
    "tStartMs": 1534250,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "최근에 미국 행정부가"
    } ]
  }, {
    "tStartMs": 1535280,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "국제법의 근본 원칙을 무시하고"
    } ]
  }, {
    "tStartMs": 1537110,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "지속적이고 체계적으로 자행하는 공격은"
    } ]
  }, {
    "tStartMs": 1539130,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "특히 우려스럽다"
    } ]
  }, {
    "tStartMs": 1540420,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "어떻게 전쟁을 4년씩 하고 말이야"
    } ]
  }, {
    "tStartMs": 1541980,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "그러면 안 되는 거죠"
    } ]
  }, {
    "tStartMs": 1543360,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "국제 평화 분쟁은"
    } ]
  }, {
    "tStartMs": 1544610,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "평화롭게 해결해야 되는데"
    } ]
  }, {
    "tStartMs": 1547080,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "그 말이야"
    } ]
  }, {
    "tStartMs": 1547830,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "쳐들어가고 그러면 안 된다"
    } ]
  }, {
    "tStartMs": 1549620,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "강력하게 비난 성명을 발표했습니다"
    } ]
  }, {
    "tStartMs": 1553240,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "북한은 여기에 대한 성명은 아닌데"
    } ]
  }, {
    "tStartMs": 1555010,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "개인적으로는 그 얼마 전에 했던 말인데"
    } ]
  }, {
    "tStartMs": 1557110,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "김정은이"
    } ]
  }, {
    "tStartMs": 1558140,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "한국은 동족의 범주에서"
    } ]
  }, {
    "tStartMs": 1559710,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "영원히 배제할 것"
    } ]
  }, {
    "tStartMs": 1561390,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "하지만 미국과는 공존할 수 있다"
    } ]
  }, {
    "tStartMs": 1563200,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "왜냐하면 동족의 범주로 했다가"
    } ]
  }, {
    "tStartMs": 1564990,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "잘못해서"
    } ]
  }, {
    "tStartMs": 1566640,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "트럼프 대통령이 얘기하듯이"
    } ]
  }, {
    "tStartMs": 1568340,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "이란 시민들이여 일어나라"
    } ]
  }, {
    "tStartMs": 1569820,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "정권을 바꿔라"
    } ]
  }, {
    "tStartMs": 1570670,
    "dDurationMs": 650,
    "segs": [ {
      "utf8": "뭐 그러고 있는데"
    } ]
  }, {
    "tStartMs": 1571320,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "여기도 잘못 일어나면"
    } ]
  }, {
    "tStartMs": 1572870,
    "dDurationMs": 550,
    "segs": [ {
      "utf8": "어 그치요"
    } ]
  }, {
    "tStartMs": 1573420,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "뭐 그럴 수 있기 때문에"
    } ]
  }, {
    "tStartMs": 1575040,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "한국과는 안되고"
    } ]
  }, {
    "tStartMs": 1576110,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "미국과는 할 수 있다"
    } ]
  }, {
    "tStartMs": 1577470,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "음... 역시 뭐 누울 자리는 보고"
    } ]
  }, {
    "tStartMs": 1580510,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "다리를 뻗는 게 아닌가 생각을 하고요"
    } ]
  }, {
    "tStartMs": 1583120,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "뭐 그렇게 얘기했다고 하고"
    } ]
  }, {
    "tStartMs": 1584820,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "개인적으로는"
    } ]
  }, {
    "tStartMs": 1585970,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "쭉 몇 년을 보고 있으면"
    } ]
  }, {
    "tStartMs": 1587640,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "저 하마스가 쏘아올린"
    } ]
  }, {
    "tStartMs": 1589340,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "나비 효과가 엄청나다"
    } ]
  }, {
    "tStartMs": 1591460,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "아니면 하마스가 트리거를 만들지 않았더라도"
    } ]
  }, {
    "tStartMs": 1594350,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "이렇게 흘러갔을까?"
    } ]
  }, {
    "tStartMs": 1595960,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "역사에 가정은 없지만"
    } ]
  }, {
    "tStartMs": 1597390,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "그런 생각을 좀 많이 하는데"
    } ]
  }, {
    "tStartMs": 1599080,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "2023년 7월 하마스가 이스라엘을 공격합니다"
    } ]
  }, {
    "tStartMs": 1602380,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "2024년 하마스 최고지도가 사망하면서"
    } ]
  }, {
    "tStartMs": 1604540,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "하마스가 사실상 궤멸이 돼요"
    } ]
  }, {
    "tStartMs": 1606530,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "그리고 2024년 하마스를 지원했던"
    } ]
  }, {
    "tStartMs": 1608170,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "레바논 헤즈볼라 삐삐 터지고 그러면서"
    } ]
  }, {
    "tStartMs": 1611270,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "최고 지도자가 폭격으로 사망하죠"
    } ]
  }, {
    "tStartMs": 1613120,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "사실상 헤즈볼라가 궤멸이 됩니다"
    } ]
  }, {
    "tStartMs": 1615610,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "그리고 2024년 10월인가"
    } ]
  }, {
    "tStartMs": 1616800,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "시리아 아사드 정권이"
    } ]
  }, {
    "tStartMs": 1618530,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "붕괴가 돼요"
    } ]
  }, {
    "tStartMs": 1619830,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "전부 다 이스라엘을 타겟으로 하는 저거잖아요"
    } ]
  }, {
    "tStartMs": 1623300,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "저항의 축"
    } ]
  }, {
    "tStartMs": 1624500,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "그리고 지금은 이란이죠"
    } ]
  }, {
    "tStartMs": 1626610,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "이란, 테헤란의 공격을 봐서"
    } ]
  }, {
    "tStartMs": 1627860,
    "dDurationMs": 3950,
    "segs": [ {
      "utf8": "2026년에 이란 최고 지도자가 사망을 합니다"
    } ]
  }, {
    "tStartMs": 1631810,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "한마디로 이스라엘과 미국에 맞서던 저항의 축이"
    } ]
  }, {
    "tStartMs": 1634980,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "이 하마스의 이스라엘 공격을"
    } ]
  }, {
    "tStartMs": 1636490,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "시작으로 하나, 둘, 셋,"
    } ]
  }, {
    "tStartMs": 1639570,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "지금 네 개가 무너지려는 직전이죠"
    } ]
  }, {
    "tStartMs": 1641440,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "이란이 어떻게 될지 모르겠지만"
    } ]
  }, {
    "tStartMs": 1642980,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "여기까지 가는 거죠"
    } ]
  }, {
    "tStartMs": 1644500,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "이라크도 사실 내부적으로는"
    } ]
  }, {
    "tStartMs": 1645980,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "흔들릴 마음이 있기 때문에"
    } ]
  }, {
    "tStartMs": 1648300,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "이란이 사실상 이번에 완전히 만약에"
    } ]
  }, {
    "tStartMs": 1651110,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "미국과 이스라엘의 패배를 하고"
    } ]
  }, {
    "tStartMs": 1652810,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "정권이 바뀌거나 한다면"
    } ]
  }, {
    "tStartMs": 1655570,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "이스라엘을 적대시한 세력들이"
    } ]
  }, {
    "tStartMs": 1657080,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "굉장히 저항의 축이"
    } ]
  }, {
    "tStartMs": 1658990,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "사실상 궤멸되는 거 아니냐"
    } ]
  }, {
    "tStartMs": 1661330,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "마지막 남은 게"
    } ]
  }, {
    "tStartMs": 1662010,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "이 아래 예멘이죠"
    } ]
  }, {
    "tStartMs": 1663680,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "예멘은 위에 있는 국가들에 비하면"
    } ]
  }, {
    "tStartMs": 1665640,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "이란 같은 국가들에 비하면"
    } ]
  }, {
    "tStartMs": 1667420,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "굉장히 작은 세력이라고 봐도"
    } ]
  }, {
    "tStartMs": 1669520,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "무난하기 때문에"
    } ]
  }, {
    "tStartMs": 1670410,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "이란이 여기서 만약에 무너지면"
    } ]
  }, {
    "tStartMs": 1673030,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "하마스가 쏘아올린 나비효과로"
    } ]
  }, {
    "tStartMs": 1675140,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "저항의 축이 완전히"
    } ]
  }, {
    "tStartMs": 1676280,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "몇 년 만입니까? 불과"
    } ]
  }, {
    "tStartMs": 1677540,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "3년?"
    } ]
  }, {
    "tStartMs": 1678680,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "2년 반 만에 차례대로 무너지는 모습이"
    } ]
  }, {
    "tStartMs": 1681320,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "나오는 게 아닌가 생각이 되고"
    } ]
  }, {
    "tStartMs": 1683040,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "이번 전쟁이 이란의 패배로 끝나면"
    } ]
  }, {
    "tStartMs": 1685430,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "방금 말씀드렸지만"
    } ]
  }, {
    "tStartMs": 1686340,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "저항의 축이 사실상 붕괴되는"
    } ]
  }, {
    "tStartMs": 1688090,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "모습을 보이지 않나 생각을 하고"
    } ]
  }, {
    "tStartMs": 1690370,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "우리한테는 그것보다 더"
    } ]
  }, {
    "tStartMs": 1692000,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "저항의 축보다 더 중요한 건"
    } ]
  }, {
    "tStartMs": 1693130,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "아무래도 전쟁이 빨리 끝나야겠죠"
    } ]
  }, {
    "tStartMs": 1695180,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "전쟁이 빨리 끝나고"
    } ]
  }, {
    "tStartMs": 1696800,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "호르무즈 해협이나"
    } ]
  }, {
    "tStartMs": 1697860,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "홍해가 막히는"
    } ]
  }, {
    "tStartMs": 1699940,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "이런 것들이 일어나지 않고"
    } ]
  }, {
    "tStartMs": 1701990,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "빨리 사망자도 없고"
    } ]
  }, {
    "tStartMs": 1703690,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "빨리 완만하게 끝내서"
    } ]
  }, {
    "tStartMs": 1704940,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "전쟁의 시대가 아직도 지속되고 있는데"
    } ]
  }, {
    "tStartMs": 1707260,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "우크라이나 전쟁이 4년을 하고 있고요"
    } ]
  }, {
    "tStartMs": 1710350,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "이란 전쟁까지 지금 터진 상황이고"
    } ]
  }, {
    "tStartMs": 1713200,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "우크라이나 전쟁 이후로는 전쟁"
    } ]
  }, {
    "tStartMs": 1715270,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "소식이 끊이질 않는 것 같아요"
    } ]
  }, {
    "tStartMs": 1716960,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "여기도 전쟁, 여기도 전쟁, 저기도 전쟁"
    } ]
  }, {
    "tStartMs": 1720130,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "저항의 축이 거의 다"
    } ]
  }, {
    "tStartMs": 1721790,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "무너졌다고 하니까"
    } ]
  }, {
    "tStartMs": 1723010,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "이번을 끝으로 전쟁의 시대가"
    } ]
  }, {
    "tStartMs": 1724670,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "빨리 종식되기를 기원해 보겠습니다"
    } ]
  }, {
    "tStartMs": 1728000,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "개인적으로는 그런 생각도 해요"
    } ]
  }, {
    "tStartMs": 1729220,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "월요일날 우리 시장이 열리지 않는 게 다행이다"
    } ]
  }, {
    "tStartMs": 1732640,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "지금 열렸으면"
    } ]
  }, {
    "tStartMs": 1734460,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "이게 버티기가 쉽지 않지 않을까?"
    } ]
  }, {
    "tStartMs": 1737470,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "왜냐하면 지금 코스피가 낮은 상황이었으면"
    } ]
  }, {
    "tStartMs": 1740320,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "그래도 변동성이 적을 것 같은데"
    } ]
  }, {
    "tStartMs": 1742240,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "6천이니까"
    } ]
  }, {
    "tStartMs": 1744020,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "지금 1% 움직이면 60포인트지 않아요"
    } ]
  }, {
    "tStartMs": 1747420,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "몇백 포인트씩 움직이거든요"
    } ]
  }, {
    "tStartMs": 1749710,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "가격이 위로 올라와서"
    } ]
  }, {
    "tStartMs": 1750760,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "6천 포인트이면 5% 움직이면"
    } ]
  }, {
    "tStartMs": 1752050,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "3백 포인트씩 움직이는 건데"
    } ]
  }, {
    "tStartMs": 1754490,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "지금 막 이렇게 한창 분위기 좋고"
    } ]
  }, {
    "tStartMs": 1756360,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "쫙 올라가고 들어간 돈도 정말 많고"
    } ]
  }, {
    "tStartMs": 1758550,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "투자자들이 정말 많은데"
    } ]
  }, {
    "tStartMs": 1760390,
    "dDurationMs": 3770,
    "segs": [ {
      "utf8": "다행히 굉장히 큰 변수가 생겼잖아요"
    } ]
  }, {
    "tStartMs": 1764160,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "다행이라고 얘기하면"
    } ]
  }, {
    "tStartMs": 1765020,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "그렇지만 월요일이 휴장함으로써"
    } ]
  }, {
    "tStartMs": 1766350,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "마음을 좀 가라앉히고"
    } ]
  }, {
    "tStartMs": 1767940,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "안정을 찾을 수 있는"
    } ]
  }, {
    "tStartMs": 1769220,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "그런 시간을 벌어서"
    } ]
  }, {
    "tStartMs": 1770260,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "별다른 거 없이 가던 길 쭉쭉 갔으면 하는"
    } ]
  }, {
    "tStartMs": 1773220,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "작은 소망을 말해봅니다"
    } ]
  } ]
}

{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 7810,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "지난번에 살짝 했던 얘기인데"
    } ]
  }, {
    "tStartMs": 9940,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "또 다시 새로운 게 나와서"
    } ]
  }, {
    "tStartMs": 11390,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "정말 가슴 아픈 얘기를"
    } ]
  }, {
    "tStartMs": 12880,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "하나 먼저 하고 시작하도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 14650,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "그건 뭐냐?"
    } ]
  }, {
    "tStartMs": 15730,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "바로 담합 얘기입니다"
    } ]
  }, {
    "tStartMs": 17870,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "담합 또 담합"
    } ]
  }, {
    "tStartMs": 19990,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "여기가 담합 공화국이냐?"
    } ]
  }, {
    "tStartMs": 22270,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "눈만 뜨면 담합 얘기가"
    } ]
  }, {
    "tStartMs": 24230,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "경제 유튜버가 담합 얘기를 안 할 수가 없다"
    } ]
  }, {
    "tStartMs": 26590,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "안 할 수가 없어서"
    } ]
  }, {
    "tStartMs": 27280,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "또 담합을 가지고 왔습니다"
    } ]
  }, {
    "tStartMs": 28980,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "지난번에 했던 그 얘기"
    } ]
  }, {
    "tStartMs": 30180,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "똑같이 하는 거냐? 아니에요"
    } ]
  }, {
    "tStartMs": 31990,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "비슷한데 아닙니다"
    } ]
  }, {
    "tStartMs": 32980,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "왜냐하면 놀랍게도"
    } ]
  }, {
    "tStartMs": 34880,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "새로운 담합 사건이 또 등장했습니다"
    } ]
  }, {
    "tStartMs": 37750,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "담합이 뭔지 아시죠?"
    } ]
  }, {
    "tStartMs": 39290,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "짜고 치는 고스톱"
    } ]
  }, {
    "tStartMs": 41250,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "이렇게 하면 너무 저렴하니까"
    } ]
  }, {
    "tStartMs": 42770,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "담합이라는 게"
    } ]
  }, {
    "tStartMs": 44350,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "저렴하지 않게 얘기하면"
    } ]
  }, {
    "tStartMs": 45350,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "짬짬이"
    } ]
  }, {
    "tStartMs": 46910,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "뭐 그런 겁니다, 그런 거예요"
    } ]
  }, {
    "tStartMs": 48150,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "한마디로 짜고 하는 건데"
    } ]
  }, {
    "tStartMs": 49730,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "지난 3월 6일 날 공정거래위원회가"
    } ]
  }, {
    "tStartMs": 51570,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "또 다시 담합 사건을"
    } ]
  }, {
    "tStartMs": 53390,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "하나 발표했습니다"
    } ]
  }, {
    "tStartMs": 54230,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "심의 상정을 했는데"
    } ]
  }, {
    "tStartMs": 55860,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "사실상 발표했다고 보시면 되죠"
    } ]
  }, {
    "tStartMs": 57760,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "그럼 이번엔 지난번에 밀가루, 설탕인데"
    } ]
  }, {
    "tStartMs": 59860,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "이번엔 뭘 담합했냐?"
    } ]
  }, {
    "tStartMs": 61500,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "이번에 나온 건"
    } ]
  }, {
    "tStartMs": 62870,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "전분당 관련 합의 혐의를 포착했다"
    } ]
  }, {
    "tStartMs": 66370,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "전분당 관련 담합을 포착했다는 겁니다"
    } ]
  }, {
    "tStartMs": 70040,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "기존에 밀가루와 설탕 같은 거를 조사하다 보니까"
    } ]
  }, {
    "tStartMs": 73260,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "전분당 관련 제조 판매 사업자들도"
    } ]
  }, {
    "tStartMs": 75740,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "조직적인 담합 행위를 했네?"
    } ]
  }, {
    "tStartMs": 77340,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "이거를 적발했다는 거죠"
    } ]
  }, {
    "tStartMs": 78930,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "전분당이 뭐냐?"
    } ]
  }, {
    "tStartMs": 80520,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "제가 아는 분당은 천당 위에 분당"
    } ]
  }, {
    "tStartMs": 82770,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "뭐 그거밖에 없는데"
    } ]
  }, {
    "tStartMs": 83860,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "전분당은 뭐냐?"
    } ]
  }, {
    "tStartMs": 85440,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "전분당은 사실 여러분들이 다 알고 있습니다"
    } ]
  }, {
    "tStartMs": 87540,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "이름을 어렵게 해서 그렇지"
    } ]
  }, {
    "tStartMs": 88840,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "흔히 말해서"
    } ]
  }, {
    "tStartMs": 89750,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "전분, 전분가루"
    } ]
  }, {
    "tStartMs": 91240,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "당류, 물엿, 액상과당"
    } ]
  }, {
    "tStartMs": 93560,
    "dDurationMs": 480,
    "segs": [ {
      "utf8": "이거 있죠?"
    } ]
  }, {
    "tStartMs": 94040,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "뿌려 먹는 거, 포도당"
    } ]
  }, {
    "tStartMs": 96440,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "요리할 때는 당연히 쓰고"
    } ]
  }, {
    "tStartMs": 97700,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "과자, 음료, 아이스크림"
    } ]
  }, {
    "tStartMs": 99430,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "무슨 소스"
    } ]
  }, {
    "tStartMs": 100620,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "안 들어가는 게 없고"
    } ]
  }, {
    "tStartMs": 102020,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "우리나라 1년 매출이 한 1조 넘습니다"
    } ]
  }, {
    "tStartMs": 103960,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "1조 될까? 1조 좀 안 되나?"
    } ]
  }, {
    "tStartMs": 105800,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "그 정도 되는"
    } ]
  }, {
    "tStartMs": 106460,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "굉장히 큰 시장이라고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 108560,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "그동안 이상하게 비쌌다"
    } ]
  }, {
    "tStartMs": 110540,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "이상하게 비쌌던 건 이유가 있죠?"
    } ]
  }, {
    "tStartMs": 112260,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "왜냐하면 담합을 하고 있었습니다"
    } ]
  }, {
    "tStartMs": 114820,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "와 이거 진짜"
    } ]
  }, {
    "tStartMs": 116710,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "볼수록 레전드라는 생각이 안 들 수가 없습니다"
    } ]
  }, {
    "tStartMs": 119150,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "지난번에 밀가루, 설탕 얘기하더니"
    } ]
  }, {
    "tStartMs": 121840,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "전분, 당류 모두 다 담합이 있었다는 거죠"
    } ]
  }, {
    "tStartMs": 124840,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "그러면 얼마 동안 담합을 했냐?"
    } ]
  }, {
    "tStartMs": 127200,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "이번에 발표하신 조사관리관이 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 129820,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "2018년 5월에서 2025년 10월까지"
    } ]
  }, {
    "tStartMs": 132860,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "적발된 거죠"
    } ]
  }, {
    "tStartMs": 133560,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "적발된 것만 총 7년 6개월에 걸쳐서"
    } ]
  }, {
    "tStartMs": 136350,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "반복적 조직적으로"
    } ]
  }, {
    "tStartMs": 138070,
    "dDurationMs": 3850,
    "segs": [ {
      "utf8": "전문당 판매 가격 담합회의를 했다라는 건데"
    } ]
  }, {
    "tStartMs": 141920,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "7년 6개월"
    } ]
  }, {
    "tStartMs": 142790,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "그 전에 했는지 잘 모르겠습니다"
    } ]
  }, {
    "tStartMs": 144760,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "7년 6개월간 얼마를 담합했냐?"
    } ]
  }, {
    "tStartMs": 147470,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "담합한 총 금액은"
    } ]
  }, {
    "tStartMs": 149350,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "이번에 발표된 내용은"
    } ]
  }, {
    "tStartMs": 150650,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "공정거래위원회가 발표한 거죠"
    } ]
  }, {
    "tStartMs": 152270,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "6조 2천억 어치를 담합했다고 합니다"
    } ]
  }, {
    "tStartMs": 155330,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "대충 한 1년에 9천억?"
    } ]
  }, {
    "tStartMs": 156920,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "요즘 한 8천억이 시작했으면"
    } ]
  }, {
    "tStartMs": 158500,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "한 1조 됐겠죠?"
    } ]
  }, {
    "tStartMs": 159530,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "9천억에서 1조 정도의 담합이 있었다는 겁니다"
    } ]
  }, {
    "tStartMs": 163650,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "그러면 전분당 담합을 했는데"
    } ]
  }, {
    "tStartMs": 165920,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "우린 이제 알고 있어요"
    } ]
  }, {
    "tStartMs": 166820,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "가장 중요한 게 뭔지"
    } ]
  }, {
    "tStartMs": 168100,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "6조 2천억 어치를 담합했으면"
    } ]
  }, {
    "tStartMs": 170210,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "어떤 페널티가 있냐?"
    } ]
  }, {
    "tStartMs": 172330,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "과징금이 얼마냐?"
    } ]
  }, {
    "tStartMs": 173490,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "얼마나 낫겠습니까?"
    } ]
  }, {
    "tStartMs": 174960,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "아직 모르죠 아직 모르지만"
    } ]
  }, {
    "tStartMs": 176610,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "현재 언급되는 과징금의 규모는"
    } ]
  }, {
    "tStartMs": 178960,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "우리나라 법상 관련 매출액의"
    } ]
  }, {
    "tStartMs": 180740,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "최대 20%까지"
    } ]
  }, {
    "tStartMs": 182150,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "과징금을 부과할 수 있다고 합니다"
    } ]
  }, {
    "tStartMs": 184560,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "6조 2천억의 최대 20%니까"
    } ]
  }, {
    "tStartMs": 186400,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "1조 2천억 정도가 과징금으로 맥스!"
    } ]
  }, {
    "tStartMs": 188820,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "저게 부과된다는 게 아니라 부과할 수 있다!"
    } ]
  }, {
    "tStartMs": 191810,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "그러니까 형량으로 따지면"
    } ]
  }, {
    "tStartMs": 193640,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "10년 이하 징역이죠"
    } ]
  }, {
    "tStartMs": 194960,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "1년일 수도 있고"
    } ]
  }, {
    "tStartMs": 195620,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "2년일 수도 있고"
    } ]
  }, {
    "tStartMs": 196680,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "7년일 수도 있고"
    } ]
  }, {
    "tStartMs": 197300,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "10년일 수도 있지만"
    } ]
  }, {
    "tStartMs": 198370,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "맥스가 이제 20%"
    } ]
  }, {
    "tStartMs": 199490,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "1조 2천억이라고 합니다"
    } ]
  }, {
    "tStartMs": 201460,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "저는 근데 1조 2천억이라는 금액을 떠나서"
    } ]
  }, {
    "tStartMs": 204160,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "매출액의 20%라는 과징금의 한계는"
    } ]
  }, {
    "tStartMs": 206310,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "제 개인적인 생각에"
    } ]
  }, {
    "tStartMs": 207690,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "너무 약한 거 아닌가 생각을 해요"
    } ]
  }, {
    "tStartMs": 210020,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "솔직히"
    } ]
  }, {
    "tStartMs": 211410,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "매출액의 20%를"
    } ]
  }, {
    "tStartMs": 212570,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "막 7년이건 10년이건 담합을 했는데"
    } ]
  }, {
    "tStartMs": 215020,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "저 정도밖에 안 때리면"
    } ]
  }, {
    "tStartMs": 216140,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "10년 전 매출액의 가격과"
    } ]
  }, {
    "tStartMs": 219020,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "지금 매출액의 돈의 가치가 똑같냐"
    } ]
  }, {
    "tStartMs": 221580,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "7년 전에 100만 원과"
    } ]
  }, {
    "tStartMs": 222660,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "지금 100만 원이 똑같냐라는 걸 생각했을 때"
    } ]
  }, {
    "tStartMs": 225310,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "저 매출액의 최대 20%는"
    } ]
  }, {
    "tStartMs": 227260,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "담합 기간을 생각하면"
    } ]
  }, {
    "tStartMs": 228630,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "이자밖에 안 되지 않나"
    } ]
  }, {
    "tStartMs": 229610,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "개인적으로 그렇게 생각해요"
    } ]
  }, {
    "tStartMs": 231390,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "담합으로 매출액의"
    } ]
  }, {
    "tStartMs": 232680,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "5%를 이득 봤을지"
    } ]
  }, {
    "tStartMs": 233920,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "10%를 이득 봤을지 모르겠지만"
    } ]
  }, {
    "tStartMs": 235520,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "이득 보고 지금까지"
    } ]
  }, {
    "tStartMs": 236310,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "계속 굴려서 이만해졌는데"
    } ]
  }, {
    "tStartMs": 238910,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "안 걸리면 땡이고"
    } ]
  }, {
    "tStartMs": 240420,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "걸려봐야 매출액의 최대 20%라고"
    } ]
  }, {
    "tStartMs": 242410,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "그러면 너무 약한 게임이다"
    } ]
  }, {
    "tStartMs": 244370,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "이건 너무 약한 게임이고"
    } ]
  }, {
    "tStartMs": 245890,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "그리고 여기서 이런 말하긴 그렇지만"
    } ]
  }, {
    "tStartMs": 249730,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "이게 반복이 되잖아요"
    } ]
  }, {
    "tStartMs": 250850,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "반복이"
    } ]
  }, {
    "tStartMs": 251490,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "반복이 안 되게 하려면"
    } ]
  }, {
    "tStartMs": 253010,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "누군가는 저거를 최종 책임자"
    } ]
  }, {
    "tStartMs": 255490,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "최종 책임자 같은 경우에는"
    } ]
  }, {
    "tStartMs": 256530,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "굉장히 강하게 또"
    } ]
  }, {
    "tStartMs": 257490,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "기업 입장에서도"
    } ]
  }, {
    "tStartMs": 258590,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "야 우리가 담합하면 망하겠구나"
    } ]
  }, {
    "tStartMs": 260420,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "저는 실제로"
    } ]
  }, {
    "tStartMs": 261400,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "몇 개를 망하게 만들어야 된다고"
    } ]
  }, {
    "tStartMs": 262700,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "생각을 해요"
    } ]
  }, {
    "tStartMs": 263420,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "말이 안 되잖아요"
    } ]
  }, {
    "tStartMs": 264190,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "맨날 걸리는데"
    } ]
  }, {
    "tStartMs": 265360,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "제가 갖고 오지 않아서 그렇지만"
    } ]
  }, {
    "tStartMs": 266500,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "공정거래위원회가 매년 담합했다고"
    } ]
  }, {
    "tStartMs": 268750,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "내는 게 몇 개인지 아십니까?"
    } ]
  }, {
    "tStartMs": 270470,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "큰 것만 갖고 오는 거예요"
    } ]
  }, {
    "tStartMs": 271440,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "큰 것만"
    } ]
  }, {
    "tStartMs": 272500,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "그래서 매출액의 20%는"
    } ]
  }, {
    "tStartMs": 273770,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "징벌적 과징금으로는 너무나 약하고"
    } ]
  }, {
    "tStartMs": 276130,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "거의 뭐 현가 정도 아닌가?"
    } ]
  }, {
    "tStartMs": 277950,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "그냥 이득 보고 가져갈게 라는 정도밖에"
    } ]
  }, {
    "tStartMs": 280250,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "안 되지 않냐라고 개인적으로는"
    } ]
  }, {
    "tStartMs": 281700,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "생각을 하는 편입니다"
    } ]
  }, {
    "tStartMs": 283060,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "왜냐하면 제가 경제학을 옛날에 배웠는데"
    } ]
  }, {
    "tStartMs": 285890,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "그때 이런 얘기를 했어요"
    } ]
  }, {
    "tStartMs": 286870,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "독점과 더불어서"
    } ]
  }, {
    "tStartMs": 288090,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "시장 경제의 대표적인 실패 사례가 뭐냐"
    } ]
  }, {
    "tStartMs": 290110,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "그럼 가장 먼저 드는 게 담합입니다 담합"
    } ]
  }, {
    "tStartMs": 292190,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "경제학 원론에 나오는 거잖아"
    } ]
  }, {
    "tStartMs": 293450,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "1학년 1학기 수업에"
    } ]
  }, {
    "tStartMs": 295180,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "경쟁과 시장 가격 결정이라는 시장"
    } ]
  }, {
    "tStartMs": 296970,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "자본주의 근간을 흔드는 일이라고"
    } ]
  }, {
    "tStartMs": 298410,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "분명히 그렇게 세게 배우는데"
    } ]
  }, {
    "tStartMs": 300650,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "뭐 툭하면 펼쳐지니까"
    } ]
  }, {
    "tStartMs": 301890,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "게다가 작은 것도 아니고"
    } ]
  }, {
    "tStartMs": 303490,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "작은 동네의 담합이라든지"
    } ]
  }, {
    "tStartMs": 305520,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "무슨 뭐 그런 거면 모르겠지만"
    } ]
  }, {
    "tStartMs": 307320,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "우리나라 시장을 거의 대부분"
    } ]
  }, {
    "tStartMs": 309060,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "90%에서 100% 차지하는"
    } ]
  }, {
    "tStartMs": 310720,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "국민 대부분이 사용하는 생활용품들에서"
    } ]
  }, {
    "tStartMs": 311860,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "툭하면 담합이 걸린다는 거는"
    } ]
  }, {
    "tStartMs": 315310,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "우리가 그동안 너무 담합에 대해서"
    } ]
  }, {
    "tStartMs": 317480,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "좀 약하게 생각한 거 아닌가?"
    } ]
  }, {
    "tStartMs": 319060,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "거기에 대해서"
    } ]
  }, {
    "tStartMs": 320330,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "어떤 징벌적, 엄벌을 안 했기 때문에"
    } ]
  }, {
    "tStartMs": 322390,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "이런 일이 있는 게 아닌가라는"
    } ]
  }, {
    "tStartMs": 323430,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "생각을 굉장히 많이 합니다"
    } ]
  }, {
    "tStartMs": 325970,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "지난번에 밀가루, 설탕 담합 얘기를 했는데"
    } ]
  }, {
    "tStartMs": 328820,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "설탕 3조 담합이 있었죠"
    } ]
  }, {
    "tStartMs": 331210,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "이번에 과징금 나왔습니다"
    } ]
  }, {
    "tStartMs": 332660,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "공정위원회는 국내 설탕을 4년간 담합해서"
    } ]
  }, {
    "tStartMs": 335400,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "3조 원째 매출을 올린 기업들에게"
    } ]
  }, {
    "tStartMs": 337730,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "매출액의 15%"
    } ]
  }, {
    "tStartMs": 338730,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "20%가 맥스인데"
    } ]
  }, {
    "tStartMs": 340480,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "15%로 결정을 했다고 그럽니다"
    } ]
  }, {
    "tStartMs": 342420,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "4,083억의 과징금을 부과했다"
    } ]
  }, {
    "tStartMs": 345310,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "3개의 기업이"
    } ]
  }, {
    "tStartMs": 346430,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "1,200에서 1,500억 정도의 과징금을"
    } ]
  }, {
    "tStartMs": 348480,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "나눠서 부과를 받았습니다"
    } ]
  }, {
    "tStartMs": 350790,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "4년간 3조 원 했는데"
    } ]
  }, {
    "tStartMs": 352920,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "기업당 한 1,200~1,500억"
    } ]
  }, {
    "tStartMs": 355190,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "한 1년에서 2년 영업이익 정도인 거죠"
    } ]
  }, {
    "tStartMs": 358570,
    "dDurationMs": 440,
    "segs": [ {
      "utf8": "그래요"
    } ]
  }, {
    "tStartMs": 359010,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "두 번 말하지는 않겠습니다"
    } ]
  }, {
    "tStartMs": 360090,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "두 번 말하지 않겠고"
    } ]
  }, {
    "tStartMs": 361470,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "그리고 이번에 전분당 담합에 걸린"
    } ]
  }, {
    "tStartMs": 363350,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "기업들이 걸리니까"
    } ]
  }, {
    "tStartMs": 366080,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "당황스럽다기보단"
    } ]
  }, {
    "tStartMs": 368100,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "화가 안날수가 없는 게"
    } ]
  }, {
    "tStartMs": 371170,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "일제히 가격인하를 선언했어요"
    } ]
  }, {
    "tStartMs": 373410,
    "dDurationMs": 340,
    "segs": [ {
      "utf8": "걸리니까"
    } ]
  }, {
    "tStartMs": 373750,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "그러면 가격인하가 가능했단 말이잖아요"
    } ]
  }, {
    "tStartMs": 377050,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "그동안"
    } ]
  }, {
    "tStartMs": 378120,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "7년동안 담합했다며"
    } ]
  }, {
    "tStartMs": 379460,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "그럼 7년동안 가격인하가 가능한데"
    } ]
  }, {
    "tStartMs": 381130,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "안했다는거잖아요"
    } ]
  }, {
    "tStartMs": 382410,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "줄줄이 가격인하를 했는데"
    } ]
  }, {
    "tStartMs": 383810,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "전분당 주요제품 가격을"
    } ]
  }, {
    "tStartMs": 385460,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "3~5% 인하 했습니다"
    } ]
  }, {
    "tStartMs": 388260,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "어... 사실은 개인적으로는"
    } ]
  }, {
    "tStartMs": 391530,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "이것도 작다고 생각하는 편이지만"
    } ]
  }, {
    "tStartMs": 393080,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "그건 뭐 기업들의 입장이 있을 거고"
    } ]
  }, {
    "tStartMs": 395010,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "그 기업들은 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 397100,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "최근 국제 원재료 가격을 반영하고"
    } ]
  }, {
    "tStartMs": 399230,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "원재료가 많이 내려왔죠"
    } ]
  }, {
    "tStartMs": 400710,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "정부의 물가 안전 기조에"
    } ]
  }, {
    "tStartMs": 402110,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "적극 동참하는 취지로"
    } ]
  }, {
    "tStartMs": 403810,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "제품 가격을 인하했다"
    } ]
  }, {
    "tStartMs": 405360,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "고객과 소비자 부담을 더는 데"
    } ]
  }, {
    "tStartMs": 407230,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "조금이나마 기여할 수 있기를 바란다"
    } ]
  }, {
    "tStartMs": 409220,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "그래요"
    } ]
  }, {
    "tStartMs": 410520,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "담합으로 인해서"
    } ]
  }, {
    "tStartMs": 411280,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "우리가 그동안 부담이 컸는데"
    } ]
  }, {
    "tStartMs": 413060,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "덕분에"
    } ]
  }, {
    "tStartMs": 413800,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "고객과 소비자 부담이 조금이라도 줄어들지 않았나"
    } ]
  }, {
    "tStartMs": 416660,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "생각을 합니다"
    } ]
  }, {
    "tStartMs": 418530,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "그렇게 얘기했고"
    } ]
  }, {
    "tStartMs": 419620,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "불과 얼마 전에 지금 설탕 얘기했지만"
    } ]
  }, {
    "tStartMs": 422210,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "밀가루 담합이 있었죠"
    } ]
  }, {
    "tStartMs": 423870,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "그리고 이번에 전분당 담합까지 나왔어요"
    } ]
  }, {
    "tStartMs": 425920,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "그럼 이제 끝이냐?"
    } ]
  }, {
    "tStartMs": 427410,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "이번에 공정거래위원회 발표"
    } ]
  }, {
    "tStartMs": 428860,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "내용이 이렇게 나옵니다"
    } ]
  }, {
    "tStartMs": 430290,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "전분당 가격 담합 행위 외에 또 있어"
    } ]
  }, {
    "tStartMs": 433790,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "또 뭔데?"
    } ]
  }, {
    "tStartMs": 434560,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "입찰 담합 행위"
    } ]
  }, {
    "tStartMs": 437310,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "어디에 입찰할 때"
    } ]
  }, {
    "tStartMs": 438760,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "정부 사업이건"
    } ]
  }, {
    "tStartMs": 439420,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "어디 사업이건"
    } ]
  }, {
    "tStartMs": 440240,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "우리 입찰해서 경쟁을 하잖아요"
    } ]
  }, {
    "tStartMs": 442140,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "경쟁 입찰할 때"
    } ]
  }, {
    "tStartMs": 443100,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "담합을 한 게 남아있고"
    } ]
  }, {
    "tStartMs": 444610,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "전분당 부산물 가격에 대해서도"
    } ]
  }, {
    "tStartMs": 447160,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "지금 담합이 있는 걸 조사 중이다"
    } ]
  }, {
    "tStartMs": 449810,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "더 있다는 거죠"
    } ]
  }, {
    "tStartMs": 450730,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "그럼 전분당 부산물은 또 뭐냐"
    } ]
  }, {
    "tStartMs": 453220,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "옥수수 같은 거 분쇄해서"
    } ]
  }, {
    "tStartMs": 454390,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "전분, 당류 이런 거 뽑잖아요"
    } ]
  }, {
    "tStartMs": 456350,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "그걸 뽑고 남은 섬유질"
    } ]
  }, {
    "tStartMs": 458560,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "배아 이런 겁니다"
    } ]
  }, {
    "tStartMs": 460540,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "소들이 먹고 그런 거 있죠"
    } ]
  }, {
    "tStartMs": 462120,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "사료용으로 쓰이는 거"
    } ]
  }, {
    "tStartMs": 463270,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "짜고 남은 거"
    } ]
  }, {
    "tStartMs": 464550,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "놀랍게도 거기서도 담합 가능성이 있다는 거죠"
    } ]
  }, {
    "tStartMs": 468120,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "조사한다고 하니까"
    } ]
  }, {
    "tStartMs": 468950,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "아마 또 나올 겁니다"
    } ]
  }, {
    "tStartMs": 470080,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "또 나올 건데"
    } ]
  }, {
    "tStartMs": 470980,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "여기까지가 발표 내용이고요"
    } ]
  }, {
    "tStartMs": 473450,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "그러면 밀가루, 설탕, 전분당"
    } ]
  }, {
    "tStartMs": 475980,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "딱 3개에서"
    } ]
  }, {
    "tStartMs": 477210,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "현재까지 밝혀진 담합 총금액은 얼마냐?"
    } ]
  }, {
    "tStartMs": 479670,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "아직 부산물도 남았지만,"
    } ]
  }, {
    "tStartMs": 481660,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "입찰 담합도 남았지만"
    } ]
  }, {
    "tStartMs": 482970,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "그런 거 다 빼고 밝혀진 것만"
    } ]
  }, {
    "tStartMs": 485080,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "밀가루가 6조였고"
    } ]
  }, {
    "tStartMs": 486490,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "설탕이 3조였습니다"
    } ]
  }, {
    "tStartMs": 488300,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "그런데 이번에 전분당이 6조라며?"
    } ]
  }, {
    "tStartMs": 490610,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "물론 어느 정도가 겹칠지는 정확히 모르겠는데"
    } ]
  }, {
    "tStartMs": 493830,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "별로 안 겹칠 것 같아요"
    } ]
  }, {
    "tStartMs": 494760,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "따로 발표한 거 보니까"
    } ]
  }, {
    "tStartMs": 496070,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "그러면 9조, 6조, 15조"
    } ]
  }, {
    "tStartMs": 499550,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "15조"
    } ]
  }, {
    "tStartMs": 500830,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "매출액이 15조를"
    } ]
  }, {
    "tStartMs": 502940,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "지난 몇 년간일지 모르지만"
    } ]
  }, {
    "tStartMs": 504310,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "거의 10년간에 걸쳐서 담합을 했다는 거잖아요"
    } ]
  }, {
    "tStartMs": 506910,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "뭐 겹치는 게 좀 있어도"
    } ]
  }, {
    "tStartMs": 508320,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "일단 밀가루 설탕만 9조 원 이상이니까"
    } ]
  }, {
    "tStartMs": 511100,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "10조 이상의"
    } ]
  }, {
    "tStartMs": 512310,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "제가 기억하기에"
    } ]
  }, {
    "tStartMs": 513340,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "우리나라 최대의 식품 담합 중에 하나가 아닐까?"
    } ]
  }, {
    "tStartMs": 515710,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "뭐 이 정도면 생각을 합니다"
    } ]
  }, {
    "tStartMs": 519070,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "굉장히 우리가 생각한 것보다"
    } ]
  }, {
    "tStartMs": 520540,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "굉장히 큰 사건이라고 할 수 있고"
    } ]
  }, {
    "tStartMs": 522600,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "게다가 이 담합만 있었냐"
    } ]
  }, {
    "tStartMs": 524830,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "제가 몇 개 보여드릴게요"
    } ]
  }, {
    "tStartMs": 526600,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "굳이 얘기하자면"
    } ]
  }, {
    "tStartMs": 527900,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "2023년에는"
    } ]
  }, {
    "tStartMs": 529340,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "드라이아이스 담합도 있었습니다"
    } ]
  }, {
    "tStartMs": 531670,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "이거 2년 반 전이잖아요"
    } ]
  }, {
    "tStartMs": 533730,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "6개의 드라이아이스 제조사가"
    } ]
  }, {
    "tStartMs": 535290,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "12년간 담합을 했다"
    } ]
  }, {
    "tStartMs": 537320,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "드라이아이스 제조 판매업체 6곳이면"
    } ]
  }, {
    "tStartMs": 539160,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "우리나라 점유율의 99%입니다"
    } ]
  }, {
    "tStartMs": 541270,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "거의 90%"
    } ]
  }, {
    "tStartMs": 542340,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "100%라고 보면 되는데"
    } ]
  }, {
    "tStartMs": 543840,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "여러분들이 사던 드라이아이스 가격"
    } ]
  }, {
    "tStartMs": 546130,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "그거는 담합된 가격이었습니다"
    } ]
  }, {
    "tStartMs": 549040,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "그러니까 정상 시장가가 아니었다는 거예요"
    } ]
  }, {
    "tStartMs": 550960,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "담합된 가격은 정상 시장가가 아닙니다"
    } ]
  }, {
    "tStartMs": 552920,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "여러분들이 먹던 밀가루"
    } ]
  }, {
    "tStartMs": 554170,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "여러분들이 먹던 설탕"
    } ]
  }, {
    "tStartMs": 555420,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "당류 이런 것들"
    } ]
  }, {
    "tStartMs": 556830,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "다 정상가격이 아니었던 거죠"
    } ]
  }, {
    "tStartMs": 558890,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "짜고 친 가격이었다는 말과 똑같습니다"
    } ]
  }, {
    "tStartMs": 561460,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "이 드라이아이스는 무려 12년 동안"
    } ]
  }, {
    "tStartMs": 563540,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "마치 한 개 회사처럼"
    } ]
  }, {
    "tStartMs": 564750,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "가격이 동일하게 변동했다"
    } ]
  }, {
    "tStartMs": 567130,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "가격 다운을 무려 12년을 했어요"
    } ]
  }, {
    "tStartMs": 568650,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "2007년 5월"
    } ]
  }, {
    "tStartMs": 569790,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "처음 경쟁사가 모임을 열고"
    } ]
  }, {
    "tStartMs": 571730,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "물론 이게 처음인지 모릅니다"
    } ]
  }, {
    "tStartMs": 572900,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "걸린 기억이니까"
    } ]
  }, {
    "tStartMs": 574190,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "빙과사에 판매하거나"
    } ]
  }, {
    "tStartMs": 575360,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "아니면 소매업자들이 많이 쓰는"
    } ]
  }, {
    "tStartMs": 577390,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "드라이아이스 단가를 함께 올리기로 합의한 거죠"
    } ]
  }, {
    "tStartMs": 580410,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "그래서 2007년에서 2019년까지"
    } ]
  }, {
    "tStartMs": 582430,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "12년에 걸쳐서"
    } ]
  }, {
    "tStartMs": 583290,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "드라이아이스 가격은 87% 올랐습니다"
    } ]
  }, {
    "tStartMs": 586250,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "물론 물가가 많이 올랐으니까"
    } ]
  }, {
    "tStartMs": 587520,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "87%가 많이 올랐는지"
    } ]
  }, {
    "tStartMs": 588880,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "적게 올랐는지 모르겠지만"
    } ]
  }, {
    "tStartMs": 590060,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "확실한 거는"
    } ]
  }, {
    "tStartMs": 591310,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "그 물가에 비해서는 많이 올랐을 겁니다"
    } ]
  }, {
    "tStartMs": 593230,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "그게 담합이니까"
    } ]
  }, {
    "tStartMs": 594720,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "그게 아니면 담합을 할 리가 없죠"
    } ]
  }, {
    "tStartMs": 596320,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "50% 오를 수 있는 것도"
    } ]
  }, {
    "tStartMs": 597740,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "한 87% 올린 거고"
    } ]
  }, {
    "tStartMs": 599390,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "한 40% 올릴 수 있어도"
    } ]
  }, {
    "tStartMs": 600710,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "80% 올리는 거고"
    } ]
  }, {
    "tStartMs": 601730,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "그게 담합이라고 보시면 되고"
    } ]
  }, {
    "tStartMs": 603670,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "매출액 기준으로는 2007년 대비 2019년에"
    } ]
  }, {
    "tStartMs": 606210,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "우리가 드라이아이스를 많이 쓰게 됐죠"
    } ]
  }, {
    "tStartMs": 608050,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "그래서 총 3배로 상승을 했습니다"
    } ]
  }, {
    "tStartMs": 610280,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "가격도 오르고"
    } ]
  }, {
    "tStartMs": 611360,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "매출도 오르고"
    } ]
  }, {
    "tStartMs": 612350,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "한마디로 지난 12년간"
    } ]
  }, {
    "tStartMs": 613810,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "우리나라 드라이아이스 시장은 경쟁이 없던 시장이고"
    } ]
  }, {
    "tStartMs": 616660,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "우리는 시장 경제에 있지 않았던 거죠"
    } ]
  }, {
    "tStartMs": 619610,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "우리는 정해진 가격을 내고 사는"
    } ]
  }, {
    "tStartMs": 622450,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "그런 시장에 있었던 겁니다"
    } ]
  }, {
    "tStartMs": 623930,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "몰랐지만"
    } ]
  }, {
    "tStartMs": 625320,
    "dDurationMs": 590,
    "segs": [ {
      "utf8": "여기 써있죠"
    } ]
  }, {
    "tStartMs": 625910,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "이게 공정위가 발표한 내용이에요"
    } ]
  }, {
    "tStartMs": 627870,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "국내 드라이아이스 시장은 경쟁이 소멸한 것과 같은"
    } ]
  }, {
    "tStartMs": 630830,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "지난 12년을 보내게 됐다"
    } ]
  }, {
    "tStartMs": 633280,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "저 12년에 대한 과징금도 나왔어요"
    } ]
  }, {
    "tStartMs": 636460,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "얼마가 나왔냐"
    } ]
  }, {
    "tStartMs": 637420,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "6개사에 48억 나왔습니다"
    } ]
  }, {
    "tStartMs": 640610,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "6개 사이에 48억"
    } ]
  }, {
    "tStartMs": 641750,
    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "한 개 사당 한 8억 나왔네 그래요"
    } ]
  }, {
    "tStartMs": 647190,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "그렇다고 합니다"
    } ]
  }, {
    "tStartMs": 648100,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "많이 얘기했으니까 더 얘기하지 않겠습니다"
    } ]
  }, {
    "tStartMs": 650040,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "또 보여드릴까요?"
    } ]
  }, {
    "tStartMs": 651030,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "이거 많아요"
    } ]
  }, {
    "tStartMs": 651630,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "갖고 오려면 100개도 갖고 올 수 있습니다"
    } ]
  }, {
    "tStartMs": 653700,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "2021년엔 아이스크림 담합"
    } ]
  }, {
    "tStartMs": 655520,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "사건이 있었습니다"
    } ]
  }, {
    "tStartMs": 657050,
    "dDurationMs": 470,
    "segs": [ {
      "utf8": "어?"
    } ]
  }, {
    "tStartMs": 657520,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "아이스크림 왜 이렇게 비싸?"
    } ]
  }, {
    "tStartMs": 658520,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "아 그거요?"
    } ]
  }, {
    "tStartMs": 659550,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "담합된 가격이었어요"
    } ]
  }, {
    "tStartMs": 661860,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "그 당시에는 5년 전이죠"
    } ]
  }, {
    "tStartMs": 663730,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "역대 최대 규모의 식품 담합 사건이었습니다"
    } ]
  }, {
    "tStartMs": 666880,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "하지만 이 기록은 아마 깨졌을 거예요"
    } ]
  }, {
    "tStartMs": 668630,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "왜냐 이번에 아까 보셨지만"
    } ]
  }, {
    "tStartMs": 669890,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "거의 10조 가까운 담합이 나왔기 때문에"
    } ]
  }, {
    "tStartMs": 672600,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "깨졌지 않나라고"
    } ]
  }, {
    "tStartMs": 673260,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "개인적으로 생각하는데"
    } ]
  }, {
    "tStartMs": 674450,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "아이스크림 시장 점유"
    } ]
  }, {
    "tStartMs": 675520,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "85% 이상을 차지하는"
    } ]
  }, {
    "tStartMs": 677360,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "빙과 업체들이 가격을 담합한 사건입니다"
    } ]
  }, {
    "tStartMs": 680050,
    "dDurationMs": 630,
    "segs": [ {
      "utf8": "검찰 내용인데"
    } ]
  }, {
    "tStartMs": 680680,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "아래에 적혀 있죠"
    } ]
  }, {
    "tStartMs": 681770,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "이 사건은 역대 식품 담합 중"
    } ]
  }, {
    "tStartMs": 683090,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "최대 규모로"
    } ]
  }, {
    "tStartMs": 684180,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "아이스크림 가격을"
    } ]
  }, {
    "tStartMs": 684940,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "장기간 담합해"
    } ]
  }, {
    "tStartMs": 685850,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "결과적으로 물가 상승으로 이어졌다라는 얘기고요"
    } ]
  }, {
    "tStartMs": 689280,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "당시 아이스크림 업체들은"
    } ]
  }, {
    "tStartMs": 690800,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "소매점을 자신의 거래처로 만들기 위해서"
    } ]
  }, {
    "tStartMs": 692790,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "가격을 낮추는 영업 경쟁을 그만두기로 합의했다"
    } ]
  }, {
    "tStartMs": 696250,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "서로 가격을 맞춘 거죠"
    } ]
  }, {
    "tStartMs": 697920,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "판매 뭐 이런데도 다 담합을 했겠죠"
    } ]
  }, {
    "tStartMs": 701150,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "이들의 유통채널 합의가 이루어진"
    } ]
  }, {
    "tStartMs": 702660,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "2017년 이후로 이걸 했다 그랬는데"
    } ]
  }, {
    "tStartMs": 704410,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "아이스크림 물가 지수가 급격하게 상승했다"
    } ]
  }, {
    "tStartMs": 707540,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "담합의 결과는 당연히 가격의 상승입니다"
    } ]
  }, {
    "tStartMs": 709760,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "아이스크림 가격이 이상한데요"
    } ]
  }, {
    "tStartMs": 711550,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "아까도 말씀드렸지만"
    } ]
  }, {
    "tStartMs": 713050,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "그거는 자유 경쟁으로 인한 가격이 아니었습니다"
    } ]
  }, {
    "tStartMs": 716270,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "누군가가 정해진 가격을"
    } ]
  }, {
    "tStartMs": 718500,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "살 수밖에 없었던"
    } ]
  }, {
    "tStartMs": 719710,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "그런 일이 있었다는 거죠"
    } ]
  }, {
    "tStartMs": 721060,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "우리나라 최대 당시에 2021년 기준으로"
    } ]
  }, {
    "tStartMs": 723400,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "식품 담합 사건이었는데"
    } ]
  }, {
    "tStartMs": 725080,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "과징금이 얼마 나왔냐"
    } ]
  }, {
    "tStartMs": 726820,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "4개 업체에 1350억 나왔습니다"
    } ]
  }, {
    "tStartMs": 730360,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "물론 이 기록은 이제 깨졌지만"
    } ]
  }, {
    "tStartMs": 733470,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "최대 식품 담합에 4개사 1350억"
    } ]
  }, {
    "tStartMs": 736940,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "한 개사에 300억 좀 넘는 340억?"
    } ]
  }, {
    "tStartMs": 739800,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "이 정도가 나왔던 사건이고요"
    } ]
  }, {
    "tStartMs": 741220,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "2021년 사건이다 보니까"
    } ]
  }, {
    "tStartMs": 743230,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "아이스크림 담합을 한 임원진에"
    } ]
  }, {
    "tStartMs": 744750,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "대한 판결도 나왔어요"
    } ]
  }, {
    "tStartMs": 746580,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "우리나라 최대 식품 담합이니까"
    } ]
  }, {
    "tStartMs": 748580,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "엄청나게 센 판결이 나왔겠죠"
    } ]
  }, {
    "tStartMs": 750640,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "보시면은 항소심에서도 모두"
    } ]
  }, {
    "tStartMs": 752640,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "징역형 집행유예를 선고받았습니다"
    } ]
  }, {
    "tStartMs": 755900,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "담합이 인정 안 돼서 그러냐?"
    } ]
  }, {
    "tStartMs": 758130,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "재판부는 담합 사실을 인정했습니다"
    } ]
  }, {
    "tStartMs": 760570,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "아이스크림 가격 조정이"
    } ]
  }, {
    "tStartMs": 761660,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "담합에 따라 이루어온 것으로 보이지"
    } ]
  }, {
    "tStartMs": 763610,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "원가 상승에 의한 것이라고 보기 어렵다"
    } ]
  }, {
    "tStartMs": 766650,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "재판부 판결문입니다"
    } ]
  }, {
    "tStartMs": 768470,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "2017년, 2021년 사이에"
    } ]
  }, {
    "tStartMs": 769950,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "아이스크림 가격이 오른 건"
    } ]
  }, {
    "tStartMs": 771130,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "원가 상승 때문이 아닙니다"
    } ]
  }, {
    "tStartMs": 772610,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "아우, 저 담합 때문이에요"
    } ]
  }, {
    "tStartMs": 774610,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "여기 임원들은 각각 징역 1년에"
    } ]
  }, {
    "tStartMs": 776310,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "집행유예 2년"
    } ]
  }, {
    "tStartMs": 777280,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "어떤 임원은 징역 6개월에"
    } ]
  }, {
    "tStartMs": 778890,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "집행유예 1년을 선고받았어요"
    } ]
  }, {
    "tStartMs": 780780,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "물론 이게 유죄이긴 한데"
    } ]
  }, {
    "tStartMs": 782010,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "집행유예니까"
    } ]
  }, {
    "tStartMs": 783060,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "감옥에 안 갔다는 말이죠"
    } ]
  }, {
    "tStartMs": 784910,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "그리고 법인에게는 벌금 2억 원 나왔습니다"
    } ]
  }, {
    "tStartMs": 787090,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "과징금 말고 벌금"
    } ]
  }, {
    "tStartMs": 789350,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "더 보여드릴 수도 있는데"
    } ]
  }, {
    "tStartMs": 790410,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "똑같은 게 반복되니까"
    } ]
  }, {
    "tStartMs": 792020,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "그런데도 불구하고"
    } ]
  }, {
    "tStartMs": 793240,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "이게 계속 반복이 되는 거죠"
    } ]
  }, {
    "tStartMs": 795210,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "그리고 이것도 있죠"
    } ]
  }, {
    "tStartMs": 796580,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "얼마 전에 저는 이거는 담합인지 아닌지 모르겠는데"
    } ]
  }, {
    "tStartMs": 799140,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "굉장히 이슈가 되는 게 있어서"
    } ]
  }, {
    "tStartMs": 800330,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "하나 가져왔습니다"
    } ]
  }, {
    "tStartMs": 801220,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "그건 뭐냐"
    } ]
  }, {
    "tStartMs": 802340,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "미국-이란 전쟁이 터지자"
    } ]
  }, {
    "tStartMs": 803890,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "유가가 빠르게 상승했어요"
    } ]
  }, {
    "tStartMs": 805730,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "글로벌 유가가"
    } ]
  }, {
    "tStartMs": 806690,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "60달러에서 90달러로"
    } ]
  }, {
    "tStartMs": 807810,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "선물, 선물이 쭉 올랐다"
    } ]
  }, {
    "tStartMs": 809480,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "뭐 현지에서 판매하는 가격이겠죠"
    } ]
  }, {
    "tStartMs": 811200,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "50%가 올랐는데"
    } ]
  }, {
    "tStartMs": 812610,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "와 그럼 이제"
    } ]
  }, {
    "tStartMs": 813330,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "곧 우리나라 유가도 오르겠구나"
    } ]
  }, {
    "tStartMs": 814670,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "그쵸 오르는 건 맞는데"
    } ]
  }, {
    "tStartMs": 816460,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "벌써 올랐다는 게 문제죠"
    } ]
  }, {
    "tStartMs": 817790,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "아직 중동에서"
    } ]
  }, {
    "tStartMs": 820930,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "캔 원유가"
    } ]
  }, {
    "tStartMs": 822450,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "우리나라까지 아직 안 왔을 것 같은데"
    } ]
  }, {
    "tStartMs": 824050,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "그 가격에선 원유가 왔을 리가 없잖아요"
    } ]
  }, {
    "tStartMs": 825860,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "막혀있기도 하고"
    } ]
  }, {
    "tStartMs": 826800,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "물론 가격이 오르는데"
    } ]
  }, {
    "tStartMs": 828030,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "아직 와"
    } ]
  }, {
    "tStartMs": 829620,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "거의 뭐 6G"
    } ]
  }, {
    "tStartMs": 831010,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "거의 인공위성급으로 빠르게 올랐는데"
    } ]
  }, {
    "tStartMs": 834110,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "미국의 이란 공격이 시작한 날 2월 18일이죠"
    } ]
  }, {
    "tStartMs": 836260,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "3월 6일차 휘발유 가격이"
    } ]
  }, {
    "tStartMs": 837700,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "지금 거의 2,000원에 가고 있죠"
    } ]
  }, {
    "tStartMs": 839920,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "전쟁 개시 불과 일주일 만에"
    } ]
  }, {
    "tStartMs": 841250,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "가격이 엄청나게 빨리 오르는 건데"
    } ]
  }, {
    "tStartMs": 843500,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "원래 전쟁이 나고 하면"
    } ]
  }, {
    "tStartMs": 845320,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "유가가 오르는 건 당연하겠지만"
    } ]
  }, {
    "tStartMs": 846700,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "이번에는 굉장히 빨리 올랐다"
    } ]
  }, {
    "tStartMs": 848590,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "너무나 빨리 올랐다라는 게 문제가 됐고"
    } ]
  }, {
    "tStartMs": 851180,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "이 한국석유공사가 운영하는"
    } ]
  }, {
    "tStartMs": 852570,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "오피넷이라는 데가 있습니다"
    } ]
  }, {
    "tStartMs": 853730,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "여기를 보면"
    } ]
  }, {
    "tStartMs": 854710,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "서울 기준으로 1,757원이었는데"
    } ]
  }, {
    "tStartMs": 857430,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "일주일 만에 1,946원이 됐어요"
    } ]
  }, {
    "tStartMs": 860560,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "200원이 올랐고요"
    } ]
  }, {
    "tStartMs": 861700,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "지방이 더 많이 올랐네"
    } ]
  }, {
    "tStartMs": 863230,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "이유는 모르겠지만"
    } ]
  }, {
    "tStartMs": 864010,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "지방이 조금 더 올랐습니다"
    } ]
  }, {
    "tStartMs": 865380,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "1600원 후반대였던 것 같은데"
    } ]
  }, {
    "tStartMs": 867580,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "대충 이때 언저리가"
    } ]
  }, {
    "tStartMs": 868770,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "1892까지 올랐어"
    } ]
  }, {
    "tStartMs": 871380,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "지방에 가서 기름 넣어도"
    } ]
  }, {
    "tStartMs": 872830,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "1900원을 볼 수 있겠네요"
    } ]
  }, {
    "tStartMs": 874230,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "300원만큼"
    } ]
  }, {
    "tStartMs": 874930,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "굉장히 엄청나게 빨리 올랐죠"
    } ]
  }, {
    "tStartMs": 877440,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "그러면 많은 사람들이 생각하기에"
    } ]
  }, {
    "tStartMs": 879010,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "가격이 오르는 건 알겠는데"
    } ]
  }, {
    "tStartMs": 880860,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "아직 그 비싸게 주고 산 기름이"
    } ]
  }, {
    "tStartMs": 882920,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "한국으로 벌써 왔을 리는 없잖아요"
    } ]
  }, {
    "tStartMs": 884720,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "물론 실시간으로 올라가니까"
    } ]
  }, {
    "tStartMs": 886530,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "글로벌 가격이 어느 정도 올리는 게 맞는데"
    } ]
  }, {
    "tStartMs": 889450,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "이렇게 반영하는 게 맞냐"
    } ]
  }, {
    "tStartMs": 891620,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "이건 다 싸게 샀던 싸게라면"
    } ]
  }, {
    "tStartMs": 893510,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "뭐해도 예전 가격으로 샀던 기름들인데"
    } ]
  }, {
    "tStartMs": 896160,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "전부 다 새로운 가격으로 받는다는 거죠"
    } ]
  }, {
    "tStartMs": 898400,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "그럼 반대로 가격이 떨어졌을 때는"
    } ]
  }, {
    "tStartMs": 900410,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "기존에 있던 것도"
    } ]
  }, {
    "tStartMs": 901230,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "낮은 가격으로 빨리 해줄 거냐"
    } ]
  }, {
    "tStartMs": 902650,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "이거는 이렇게 가잖아요"
    } ]
  }, {
    "tStartMs": 904130,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "근데 이건 이렇게 오르고"
    } ]
  }, {
    "tStartMs": 905030,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "물론 모든 게 그렇긴 하지만"
    } ]
  }, {
    "tStartMs": 906760,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "대한민국에서는 그러다 보니까"
    } ]
  }, {
    "tStartMs": 909780,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "이번에는 왜 번개처럼 올랐냐라는 게"
    } ]
  }, {
    "tStartMs": 912370,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "또 문제가 많이 됐죠"
    } ]
  }, {
    "tStartMs": 913740,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "그래서 여기에 대해서"
    } ]
  }, {
    "tStartMs": 915060,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "서로 입장이 좀 다릅니다"
    } ]
  }, {
    "tStartMs": 916800,
    "dDurationMs": 590,
    "segs": [ {
      "utf8": "예를 들면"
    } ]
  }, {
    "tStartMs": 917390,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "주유소협회는 이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 919200,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "정유사가 공급가격을 인상했다"
    } ]
  }, {
    "tStartMs": 922620,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "주유소는 정유사나 대리자로부터"
    } ]
  }, {
    "tStartMs": 924830,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "석유제품을 공급받아"
    } ]
  }, {
    "tStartMs": 925930,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "판매하는 소매 유통이기 때문에"
    } ]
  }, {
    "tStartMs": 927590,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "가격 상승의 1차유는"
    } ]
  }, {
    "tStartMs": 928790,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "정유사의 가격 인상이다"
    } ]
  }, {
    "tStartMs": 930380,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "하루에 159루 말이야"
    } ]
  }, {
    "tStartMs": 931950,
    "dDurationMs": 530,
    "segs": [ {
      "utf8": "말이 되나?"
    } ]
  }, {
    "tStartMs": 932480,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "그리고 주유소 가격은"
    } ]
  }, {
    "tStartMs": 933920,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "단순히 공급가격과 판매가격"
    } ]
  }, {
    "tStartMs": 935910,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "차이만을 보면 안 된다"
    } ]
  }, {
    "tStartMs": 937470,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "그런 보도자료를 발표하셨습니다"
    } ]
  }, {
    "tStartMs": 939680,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "정유사에서 공급가격을 인상해서"
    } ]
  }, {
    "tStartMs": 943480,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "킹쩍을 수 없었다"
    } ]
  }, {
    "tStartMs": 944620,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "그런 내용인데"
    } ]
  }, {
    "tStartMs": 945570,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "공급가격과 판매가격 차이만을 보면 안 된다"
    } ]
  }, {
    "tStartMs": 950110,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "인건비도 오르고"
    } ]
  }, {
    "tStartMs": 951870,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "전기료도 오르고"
    } ]
  }, {
    "tStartMs": 952900,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "그 이야기 하신 것 같아요"
    } ]
  }, {
    "tStartMs": 954270,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "주유소협회는 이렇게 얘기를 했고"
    } ]
  }, {
    "tStartMs": 956130,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "그럼 정유업계는"
    } ]
  }, {
    "tStartMs": 957610,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "정유업계는 이렇게 얘기합니다"
    } ]
  }, {
    "tStartMs": 958870,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "우린 억울하다"
    } ]
  }, {
    "tStartMs": 960280,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "주유소 공급가는 국제 시세를 반영하기 때문에"
    } ]
  }, {
    "tStartMs": 962730,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "일부 올라간 게 사실이지만"
    } ]
  }, {
    "tStartMs": 964260,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "개별 주유소가 가격을 그보다 많이 올리는 건"
    } ]
  }, {
    "tStartMs": 966720,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "정유사가 통제할 수 없는 영역이다"
    } ]
  }, {
    "tStartMs": 969100,
    "dDurationMs": 570,
    "segs": [ {
      "utf8": "우리가 주는 거"
    } ]
  }, {
    "tStartMs": 969670,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "조금 올라온 거 맞아"
    } ]
  }, {
    "tStartMs": 971120,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "하지만 개별 주유소에서 그보다 많이 올랐잖아"
    } ]
  }, {
    "tStartMs": 973250,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "라고 얘기하는 건"
    } ]
  }, {
    "tStartMs": 973870,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "또 정유업계의 입장이라고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 976610,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "왜 올랐냐를 두고"
    } ]
  }, {
    "tStartMs": 978290,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "양쪽 입장이 좀 다른 그런 상황인데"
    } ]
  }, {
    "tStartMs": 980530,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "정유업계는 이렇게 얘기하죠"
    } ]
  }, {
    "tStartMs": 981670,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "주유소들이 가격이 낮을 때 사줬던 재고"
    } ]
  }, {
    "tStartMs": 983770,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "아까 얘기했던 가격이 낮을 때 샀던 것까지"
    } ]
  }, {
    "tStartMs": 986410,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "한 번에 현재 가격에 반영하는 거 아니냐"
    } ]
  }, {
    "tStartMs": 988940,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "일찍 올린 거 아니냐라는 게"
    } ]
  }, {
    "tStartMs": 990420,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "또 이제 정유업계가"
    } ]
  }, {
    "tStartMs": 992030,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "이야기하는 거라고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 993410,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "억울하다는 거죠"
    } ]
  }, {
    "tStartMs": 995750,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "현재 정부는 저런 상황이니까"
    } ]
  }, {
    "tStartMs": 998050,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "기름값 최고가 지정 얘기가 나오고 있어요"
    } ]
  }, {
    "tStartMs": 1000960,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "기름 가격을 정부가 정하겠다는"
    } ]
  }, {
    "tStartMs": 1003010,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "거와 비슷한 겁니다"
    } ]
  }, {
    "tStartMs": 1003770,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "저건 1997년 유가 자유화 이후 처음이라는데"
    } ]
  }, {
    "tStartMs": 1007700,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "제가 1997년 이전에는"
    } ]
  }, {
    "tStartMs": 1009250,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "차에 기름을 넣어본 적이 없어서"
    } ]
  }, {
    "tStartMs": 1011410,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "그때 고등학생이어서"
    } ]
  }, {
    "tStartMs": 1012340,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "제가 잘 기억이 안 납니다"
    } ]
  }, {
    "tStartMs": 1013510,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "그때는 기름가 최고가가 있었구나"
    } ]
  }, {
    "tStartMs": 1015700,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "우리 아버지 형님들은"
    } ]
  }, {
    "tStartMs": 1017030,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "제 삼촌의 시대는 알 텐데"
    } ]
  }, {
    "tStartMs": 1018810,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "30년 만에 처음으로"
    } ]
  }, {
    "tStartMs": 1020470,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "기름가 최고가 캡이죠, 캡"
    } ]
  }, {
    "tStartMs": 1022100,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "캡을 씌울 수도 있다는 얘기를 하고 있어요"
    } ]
  }, {
    "tStartMs": 1024600,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "만약에 캡을 씌우면"
    } ]
  }, {
    "tStartMs": 1025850,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "물론 경제학적으로만 따지면"
    } ]
  }, {
    "tStartMs": 1027260,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "이론적으로만 따지면"
    } ]
  }, {
    "tStartMs": 1028590,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "가격 상한을 하면"
    } ]
  }, {
    "tStartMs": 1029440,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "공급을 잘 안 합니다"
    } ]
  }, {
    "tStartMs": 1030890,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "공급 부족이 나올 수 있다는"
    } ]
  }, {
    "tStartMs": 1032580,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "이런 문제점이 있죠"
    } ]
  }, {
    "tStartMs": 1034100,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "다만 정부의 뜻은"
    } ]
  }, {
    "tStartMs": 1034930,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "아마 천천히 올라야지"
    } ]
  }, {
    "tStartMs": 1036820,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "이게 말이 되냐인 것 같아요"
    } ]
  }, {
    "tStartMs": 1038530,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "지적했다는 건 아닙니다"
    } ]
  }, {
    "tStartMs": 1039600,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "검토하겠다라고 얘기를 했고"
    } ]
  }, {
    "tStartMs": 1041850,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "법무부 장관은 이런 얘기도 했습니다"
    } ]
  }, {
    "tStartMs": 1044080,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "담합은 반사회적 중대 범죄이기 때문에"
    } ]
  }, {
    "tStartMs": 1046720,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "대검찰청에 엄정 대응할 것을 지시했다"
    } ]
  }, {
    "tStartMs": 1050210,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "그런데 참 우리나라는"
    } ]
  }, {
    "tStartMs": 1052030,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "우리나라는 뭐 해도"
    } ]
  }, {
    "tStartMs": 1052760,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "이렇게 가격이 오를 때마다"
    } ]
  }, {
    "tStartMs": 1054860,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "우리가 갈라파고 쓰고 섬나라니까"
    } ]
  }, {
    "tStartMs": 1056690,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "어쩔 수 없는 측면이 있는데"
    } ]
  }, {
    "tStartMs": 1059040,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "너무 한 번에"
    } ]
  }, {
    "tStartMs": 1060290,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "이렇게 되는 게 많지 않나 생각이 되고"
    } ]
  }, {
    "tStartMs": 1062170,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "이번에 정부가 또 발표한 것 중에"
    } ]
  }, {
    "tStartMs": 1064400,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "자료가 하나 있는데"
    } ]
  }, {
    "tStartMs": 1065640,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "교복 얘기도 나왔어요"
    } ]
  }, {
    "tStartMs": 1067560,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "교복 가격 개선 관리 방안을 발표했다"
    } ]
  }, {
    "tStartMs": 1070410,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "지금 한참 봤습니다"
    } ]
  }, {
    "tStartMs": 1071480,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "저는 왜냐하면 처음에 학원비 위주로 봤거든요"
    } ]
  }, {
    "tStartMs": 1073330,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "학원비가 어떻게 되나?"
    } ]
  }, {
    "tStartMs": 1074320,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "근데 앞에 교복이 더 언론에서"
    } ]
  }, {
    "tStartMs": 1075990,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "시끄럽길래 교복은 왜?"
    } ]
  }, {
    "tStartMs": 1078330,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "현재 우리나라 교복 가격은"
    } ]
  }, {
    "tStartMs": 1080210,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "교육부와 시도교육청이"
    } ]
  }, {
    "tStartMs": 1081620,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "상한가를 정하는 제도라고 합니다"
    } ]
  }, {
    "tStartMs": 1084150,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "2026년 교복 상한가는 34만 4530원이에요"
    } ]
  }, {
    "tStartMs": 1087640,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "이미 캡이 있어"
    } ]
  }, {
    "tStartMs": 1089060,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "캡이 있는 시장이란 거죠"
    } ]
  }, {
    "tStartMs": 1090530,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "34만 원 정도의 캡이 있는 시장입니다"
    } ]
  }, {
    "tStartMs": 1092820,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "그리고 이 캡에 따라서"
    } ]
  }, {
    "tStartMs": 1094180,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "지자체들이 34만 원이 캡이야?"
    } ]
  }, {
    "tStartMs": 1096700,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "그럼 34만 원어치 현금이나 바우처"
    } ]
  }, {
    "tStartMs": 1099780,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "아니면 현물을 구매해서 주는"
    } ]
  }, {
    "tStartMs": 1101820,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "이런 보통 지자체들이"
    } ]
  }, {
    "tStartMs": 1102660,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "그런 복지를 많이 하죠"
    } ]
  }, {
    "tStartMs": 1104230,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "학생들에 대한 교복 지원을 많이 하니까"
    } ]
  }, {
    "tStartMs": 1106120,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "여기에 맞춰서 지원을 합니다"
    } ]
  }, {
    "tStartMs": 1108280,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "학부모 부담을 경감하려고"
    } ]
  }, {
    "tStartMs": 1110120,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "그러면 문제가 없는 거 아니냐?"
    } ]
  }, {
    "tStartMs": 1112350,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "아니 캡이 있고"
    } ]
  }, {
    "tStartMs": 1113200,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "그 캡에 맞춰서"
    } ]
  }, {
    "tStartMs": 1113860,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "지자체들이 지원도 많이 해주고"
    } ]
  }, {
    "tStartMs": 1115820,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "문제는 뭐냐?"
    } ]
  }, {
    "tStartMs": 1117410,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "문제는 여러 가지가 있는데요"
    } ]
  }, {
    "tStartMs": 1118980,
    "dDurationMs": 3610,
    "segs": [ {
      "utf8": "일단 첫 번째가 교복 상한가가 지정되는 건"
    } ]
  }, {
    "tStartMs": 1122590,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "동하복 한 세트만 지정된다고 합니다"
    } ]
  }, {
    "tStartMs": 1124880,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "저도 이번에 알았어요"
    } ]
  }, {
    "tStartMs": 1126100,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "그러니까 한 세트 말고"
    } ]
  }, {
    "tStartMs": 1127520,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "두 세트부터는 안 된다는 거죠"
    } ]
  }, {
    "tStartMs": 1129010,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "근데 문제는 교복이 동하복 한 세트 말고"
    } ]
  }, {
    "tStartMs": 1131850,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "생활복, 체육복"
    } ]
  }, {
    "tStartMs": 1134380,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "그리고 보통 셔츠 추가"
    } ]
  }, {
    "tStartMs": 1136000,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "바지 추가 뭐 이런 거 하죠"
    } ]
  }, {
    "tStartMs": 1137630,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "위에 두꺼운 건 추가를 안 하는데"
    } ]
  }, {
    "tStartMs": 1139390,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "바지나 셔츠"
    } ]
  }, {
    "tStartMs": 1140110,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "이런 거는 보통 한 번씩 더 산단 말이에요"
    } ]
  }, {
    "tStartMs": 1142550,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "그리고 여러 가지 생활복"
    } ]
  }, {
    "tStartMs": 1143760,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "이런 거 더 사니까"
    } ]
  }, {
    "tStartMs": 1145020,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "그래서 이런 걸 다 하면"
    } ]
  }, {
    "tStartMs": 1145990,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "교복에 한 60만 원 이상이 들어간다"
    } ]
  }, {
    "tStartMs": 1148290,
    "dDurationMs": 460,
    "segs": [ {
      "utf8": "라는 거죠"
    } ]
  }, {
    "tStartMs": 1148750,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "34만 원 말고"
    } ]
  }, {
    "tStartMs": 1149810,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "그거보다 한 두 배 조금 안 되게 들어간다"
    } ]
  }, {
    "tStartMs": 1152590,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "그리고 우리가 너무나 잘 아는"
    } ]
  }, {
    "tStartMs": 1154430,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "30만 원을 지원한다고 하니까"
    } ]
  }, {
    "tStartMs": 1156290,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "교복값이 30만 원이 오르더라"
    } ]
  }, {
    "tStartMs": 1158230,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "아 그거?"
    } ]
  }, {
    "tStartMs": 1160680,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "캡이 34만 원이라"
    } ]
  }, {
    "tStartMs": 1162050,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "그러니까 모든 교복이"
    } ]
  }, {
    "tStartMs": 1163240,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "갑자기 34만 원이 되는 이 현상"
    } ]
  }, {
    "tStartMs": 1165760,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "아주 잘 알고 있습니다"
    } ]
  }, {
    "tStartMs": 1168050,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "이거 회사 다니면"
    } ]
  }, {
    "tStartMs": 1169030,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "점심비 2천 원 지원해주면"
    } ]
  }, {
    "tStartMs": 1170360,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "갑자기 회사 앞에 점심비가 2,000원이 오르죠"
    } ]
  }, {
    "tStartMs": 1173430,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "무슨 말인지 알겠어요"
    } ]
  }, {
    "tStartMs": 1174240,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "그래서 가격들이 다 거기에 맞춰서"
    } ]
  }, {
    "tStartMs": 1176390,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "쫙 오른 다음에"
    } ]
  }, {
    "tStartMs": 1177640,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "나머지 추가로 살 때마다"
    } ]
  }, {
    "tStartMs": 1178990,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "가격이 이제 많이 들어서"
    } ]
  }, {
    "tStartMs": 1180820,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "60만 원까지 된다"
    } ]
  }, {
    "tStartMs": 1182240,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "제가 직원분들한테 물어봤습니다"
    } ]
  }, {
    "tStartMs": 1184020,
    "dDurationMs": 630,
    "segs": [ {
      "utf8": "진짜 아니야?"
    } ]
  }, {
    "tStartMs": 1184650,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "졸업한 지 얼마 안 되지"
    } ]
  }, {
    "tStartMs": 1185980,
    "dDurationMs": 210,
    "segs": [ {
      "utf8": "아직"
    } ]
  }, {
    "tStartMs": 1186190,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "거의 뭐 10년된 직원이긴 한데"
    } ]
  }, {
    "tStartMs": 1188110,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "그래서 이렇게 얘기하더라고요"
    } ]
  }, {
    "tStartMs": 1189390,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "본인도 50만 원 이상은 들었던 것 같다"
    } ]
  }, {
    "tStartMs": 1191650,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "어떤 게 들었어? 물어보니까"
    } ]
  }, {
    "tStartMs": 1193110,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "교복 30만 원"
    } ]
  }, {
    "tStartMs": 1194090,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "생활복 10"
    } ]
  }, {
    "tStartMs": 1194790,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "체육복 10"
    } ]
  }, {
    "tStartMs": 1195610,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "여분셔츠 바지 10"
    } ]
  }, {
    "tStartMs": 1196890,
    "dDurationMs": 580,
    "segs": [ {
      "utf8": "50"
    } ]
  }, {
    "tStartMs": 1197470,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "이거는 더 들었다 왜?"
    } ]
  }, {
    "tStartMs": 1198670,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "그랬더니 이런 얘기를 했습니다"
    } ]
  }, {
    "tStartMs": 1199710,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "제가 적은 거 아니에요"
    } ]
  }, {
    "tStartMs": 1200830,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "쌤들이 줄인 바지와 치마를 뺏어가서"
    } ]
  }, {
    "tStartMs": 1203470,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "각각 5만원씩 추가돼서"
    } ]
  }, {
    "tStartMs": 1204810,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "60만원에 됐다"
    } ]
  }, {
    "tStartMs": 1206200,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "참고로 그 여직원입니다"
    } ]
  }, {
    "tStartMs": 1209420,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "뭘 줄여 입어"
    } ]
  }, {
    "tStartMs": 1211140,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "아니 뭘 쌤들이 그걸 뺏어가"
    } ]
  }, {
    "tStartMs": 1212760,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "너무 많이 줄였겠지"
    } ]
  }, {
    "tStartMs": 1215290,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "그걸 쌤들이 뺏어간 것도"
    } ]
  }, {
    "tStartMs": 1216910,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "추가 비용으로 쳐야 되나?"
    } ]
  }, {
    "tStartMs": 1218500,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "뺏어가면 안 돌려주나?"
    } ]
  }, {
    "tStartMs": 1219400,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "하긴 줄인 걸 돌려줄 수도 없잖아"
    } ]
  }, {
    "tStartMs": 1221300,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "하여튼 본인은 그래서 가격이 더 추가됐기 때문에"
    } ]
  }, {
    "tStartMs": 1224510,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "60만원 가까이 들었다라는"
    } ]
  }, {
    "tStartMs": 1226180,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "생생한 증언이 있었습니다"
    } ]
  }, {
    "tStartMs": 1228240,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "그러면 교복 같은 게"
    } ]
  }, {
    "tStartMs": 1229610,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "왜 그렇게 가격이 또 올랐냐"
    } ]
  }, {
    "tStartMs": 1230800,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "내용을 보면"
    } ]
  }, {
    "tStartMs": 1231940,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "공정위가 이런 얘기를 했습니다"
    } ]
  }, {
    "tStartMs": 1233380,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "2017년 이후에 교복 구매"
    } ]
  }, {
    "tStartMs": 1234980,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "담합행위 시정명령만 32건이다"
    } ]
  }, {
    "tStartMs": 1237890,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "99개 사업자에 32건"
    } ]
  }, {
    "tStartMs": 1240060,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "과징금 2건"
    } ]
  }, {
    "tStartMs": 1241010,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "경고 7건"
    } ]
  }, {
    "tStartMs": 1242270,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "시정명령을 내린 거"
    } ]
  }, {
    "tStartMs": 1243390,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "담합을 했다고"
    } ]
  }, {
    "tStartMs": 1244760,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "그러면 그걸 없애면 되지 않냐"
    } ]
  }, {
    "tStartMs": 1246180,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "이번 정부 발표에"
    } ]
  }, {
    "tStartMs": 1247000,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "이런 구문이 나옵니다"
    } ]
  }, {
    "tStartMs": 1248470,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "입찰, 담합 등"
    } ]
  }, {
    "tStartMs": 1249520,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "불공정 거래 관행이 지속되고 있다"
    } ]
  }, {
    "tStartMs": 1254160,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "없애지 못한다는 거죠"
    } ]
  }, {
    "tStartMs": 1255520,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "잘 안 없어진다"
    } ]
  }, {
    "tStartMs": 1257020,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "음... 여기 써있어요"
    } ]
  }, {
    "tStartMs": 1259790,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "지속됨에 따라"
    } ]
  }, {
    "tStartMs": 1260780,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "그럼 없애면 없어질 거 아니야"
    } ]
  }, {
    "tStartMs": 1262270,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "잘 안 없어진다는 거죠"
    } ]
  }, {
    "tStartMs": 1264080,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "그래서 그럼 어떻게 해"
    } ]
  }, {
    "tStartMs": 1264970,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "안 없어지면"
    } ]
  }, {
    "tStartMs": 1265880,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "담합을 어떻게 합니까?"
    } ]
  }, {
    "tStartMs": 1267280,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "첫 번째 아이디어는 그러면"
    } ]
  }, {
    "tStartMs": 1269130,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "교복 전체를 캡을 씌우지 말고"
    } ]
  }, {
    "tStartMs": 1271270,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "품목별 캡을 씌우자"
    } ]
  }, {
    "tStartMs": 1272650,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "아 세세하게 나갑니다"
    } ]
  }, {
    "tStartMs": 1275020,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "티셔츠 얼마?"
    } ]
  }, {
    "tStartMs": 1275970,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "바지 얼마? 하나하나"
    } ]
  }, {
    "tStartMs": 1277570,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "나중에 단추 얼마 정도 나오겠다"
    } ]
  }, {
    "tStartMs": 1279260,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "뭐 얼마?"
    } ]
  }, {
    "tStartMs": 1279860,
    "dDurationMs": 460,
    "segs": [ {
      "utf8": "뭐 얼마?"
    } ]
  }, {
    "tStartMs": 1280320,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "이렇게 아예 품목별로 해서"
    } ]
  }, {
    "tStartMs": 1281620,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "담합해도 가격을 못 올리게"
    } ]
  }, {
    "tStartMs": 1283550,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "아이디어입니다, 아이디어"
    } ]
  }, {
    "tStartMs": 1284800,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "이걸 자꾸 하니까"
    } ]
  }, {
    "tStartMs": 1285600,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "플러스 알파, 플러스 알파해서 하니까"
    } ]
  }, {
    "tStartMs": 1287390,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "오죽하면"
    } ]
  }, {
    "tStartMs": 1288280,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "오죽하면이라는 말이"
    } ]
  }, {
    "tStartMs": 1289790,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "절로 나온다고 할 수 있고"
    } ]
  }, {
    "tStartMs": 1292440,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "그리고 이것도 어려우니까"
    } ]
  }, {
    "tStartMs": 1293950,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "뭐라고 얘기를 했냐면"
    } ]
  }, {
    "tStartMs": 1295090,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "자료 이렇게 나옵니다"
    } ]
  }, {
    "tStartMs": 1295950,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "아예 편한 교복으로 전환하겠다"
    } ]
  }, {
    "tStartMs": 1298870,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "가격이 비싸고 불편한 정장형 교복을"
    } ]
  }, {
    "tStartMs": 1301890,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "앞으로 긴 시간에 걸쳐서"
    } ]
  }, {
    "tStartMs": 1303230,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "좀 줄이고"
    } ]
  }, {
    "tStartMs": 1304040,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "생활형 교복, 체육복"
    } ]
  }, {
    "tStartMs": 1305800,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "편한 교복으로 전환하겠다"
    } ]
  }, {
    "tStartMs": 1307940,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "저는 이거 나쁘지 않다고 보는데"
    } ]
  }, {
    "tStartMs": 1309620,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "근데 편한 생활형 교복으로 전환하는 이유가"
    } ]
  }, {
    "tStartMs": 1312960,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "담합 같은 불공정 거래 때문이라면"
    } ]
  }, {
    "tStartMs": 1316520,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "세계 최초가 아닐까?"
    } ]
  }, {
    "tStartMs": 1317790,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "담합이 계속되니까"
    } ]
  }, {
    "tStartMs": 1319530,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "그것 때문에 기존 정장형 대신에"
    } ]
  }, {
    "tStartMs": 1322090,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "생활형 교복으로"
    } ]
  }, {
    "tStartMs": 1323580,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "전환하는 걸 검토한다는 거죠"
    } ]
  }, {
    "tStartMs": 1325820,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "그 정도로 담합이라는 게 잡는다고 하더라도"
    } ]
  }, {
    "tStartMs": 1328820,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "발본색원 하는 게"
    } ]
  }, {
    "tStartMs": 1329780,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "굉장히 어렵다는 것을"
    } ]
  }, {
    "tStartMs": 1331650,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "반증하지 않나 생각이 되고"
    } ]
  }, {
    "tStartMs": 1333170,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "한마디로 못 막을 바에 없애겠다는 거죠"
    } ]
  }, {
    "tStartMs": 1335600,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "정장형 교복의 폐지를 유도하겠다"
    } ]
  }, {
    "tStartMs": 1338240,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "생활형 교복이나"
    } ]
  }, {
    "tStartMs": 1339810,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "제가 어렸을 때"
    } ]
  }, {
    "tStartMs": 1340820,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "제가 다니던 고등학교는"
    } ]
  }, {
    "tStartMs": 1342240,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "처음에 교복이 없었어요"
    } ]
  }, {
    "tStartMs": 1343960,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "자유복이었어요"
    } ]
  }, {
    "tStartMs": 1344870,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "좋잖아요 좋은데"
    } ]
  }, {
    "tStartMs": 1346070,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "문제는 제가 다니던 고등학교는"
    } ]
  }, {
    "tStartMs": 1348380,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "대머리였어요"
    } ]
  }, {
    "tStartMs": 1350020,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "대머리가 뭐냐"
    } ]
  }, {
    "tStartMs": 1351510,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "앞머리 1CM"
    } ]
  }, {
    "tStartMs": 1353280,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "옛날 고등학교들은 대부분 스포츠였잖아요, 스포츠"
    } ]
  }, {
    "tStartMs": 1356410,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "저희 학교는 스포츠가 아니라"
    } ]
  }, {
    "tStartMs": 1358210,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "빠박이였어요"
    } ]
  }, {
    "tStartMs": 1360140,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "빠박이"
    } ]
  }, {
    "tStartMs": 1360900,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "앞머리 1CM"
    } ]
  }, {
    "tStartMs": 1361640,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "지금 생각하면"
    } ]
  }, {
    "tStartMs": 1363160,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "너무 잔인한 제도라고 할 수 있는데"
    } ]
  }, {
    "tStartMs": 1366180,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "어쩔 수 없습니다"
    } ]
  }, {
    "tStartMs": 1366950,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "그 뭐 하여튼 교칙이 그랬어"
    } ]
  }, {
    "tStartMs": 1368330,
    "dDurationMs": 510,
    "segs": [ {
      "utf8": "앞머리 1CM"
    } ]
  }, {
    "tStartMs": 1368840,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "그리고 앞에 우리 가면 이렇게 들어올 때"
    } ]
  }, {
    "tStartMs": 1371500,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "그 선도부라 그러죠"
    } ]
  }, {
    "tStartMs": 1372400,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "선도부 선생님이"
    } ]
  }, {
    "tStartMs": 1373690,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "배드민턴 채 이렇게 들고 있다가"
    } ]
  }, {
    "tStartMs": 1375300,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "머리 좀 기내 지나가면은"
    } ]
  }, {
    "tStartMs": 1376680,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "배드민턴 터치를 머리 이렇게 됩니다"
    } ]
  }, {
    "tStartMs": 1378090,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "여기 눌러요 이렇게"
    } ]
  }, {
    "tStartMs": 1378990,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "그래서 배드민턴 채"
    } ]
  }, {
    "tStartMs": 1380200,
    "dDurationMs": 580,
    "segs": [ {
      "utf8": "위 삐죽"
    } ]
  }, {
    "tStartMs": 1380780,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "나오는 거 있으면"
    } ]
  }, {
    "tStartMs": 1381540,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "그때 바리깡이라 그러죠"
    } ]
  }, {
    "tStartMs": 1382560,
    "dDurationMs": 650,
    "segs": [ {
      "utf8": "이걸로"
    } ]
  }, {
    "tStartMs": 1383210,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "윙"
    } ]
  }, {
    "tStartMs": 1383770,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "즉석해서 밀어주던"
    } ]
  }, {
    "tStartMs": 1385150,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "즉석 서비스까지"
    } ]
  }, {
    "tStartMs": 1386890,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "해주셨던 게 갑자기 기억이납니다"
    } ]
  }, {
    "tStartMs": 1388340,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "어? 너 일로 와 해서"
    } ]
  }, {
    "tStartMs": 1389180,
    "dDurationMs": 230,
    "segs": [ {
      "utf8": "왜요?"
    } ]
  }, {
    "tStartMs": 1389410,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "그러면 가만히 있어 하고"
    } ]
  }, {
    "tStartMs": 1390540,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "배드민턴에 딱 된 다음에"
    } ]
  }, {
    "tStartMs": 1392320,
    "dDurationMs": 580,
    "segs": [ {
      "utf8": "위로 나오면"
    } ]
  }, {
    "tStartMs": 1392900,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "여기를 윙윙 두 개만 밀어요"
    } ]
  }, {
    "tStartMs": 1394860,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "많이 밀면 시간 걸리니까"
    } ]
  }, {
    "tStartMs": 1396190,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "그러면 가운데 고속도로가 나잖아"
    } ]
  }, {
    "tStartMs": 1397840,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "이거 어떻게 해요 그러면?"
    } ]
  }, {
    "tStartMs": 1398970,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "학교 내에 이발소가 있었습니다"
    } ]
  }, {
    "tStartMs": 1401220,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "놀랍게도"
    } ]
  }, {
    "tStartMs": 1402230,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "밖에 있는 이발소하고 계약을 맺어서"
    } ]
  }, {
    "tStartMs": 1404210,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "점심시간에 바리깡든"
    } ]
  }, {
    "tStartMs": 1406030,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "이발사 선생님이 학교에 왔어"
    } ]
  }, {
    "tStartMs": 1408130,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "가운데 길난 애들 밀어주려고"
    } ]
  }, {
    "tStartMs": 1410100,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "그래서 길난 애 와"
    } ]
  }, {
    "tStartMs": 1411780,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "길난 애들 이렇게 밀어주고"
    } ]
  }, {
    "tStartMs": 1413430,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "긴 애들 이렇게 밀어주고"
    } ]
  }, {
    "tStartMs": 1414980,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "수업하다가도"
    } ]
  }, {
    "tStartMs": 1415600,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "선생님이 너 머리 길잖아"
    } ]
  }, {
    "tStartMs": 1417280,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "죄송합니다 내일 깎아올게"
    } ]
  }, {
    "tStartMs": 1418550,
    "dDurationMs": 590,
    "segs": [ {
      "utf8": "안 돼"
    } ]
  }, {
    "tStartMs": 1419140,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "점심시간에 가"
    } ]
  }, {
    "tStartMs": 1420110,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "점심시간에 가서"
    } ]
  }, {
    "tStartMs": 1421860,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "밀고 오던"
    } ]
  }, {
    "tStartMs": 1423060,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "그런 게 있었습니다"
    } ]
  }, {
    "tStartMs": 1423680,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "이 얘기를 왜 하냐"
    } ]
  }, {
    "tStartMs": 1424540,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "근데 사복이었어요"
    } ]
  }, {
    "tStartMs": 1426400,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "사복에 머리가 빠박이잖아"
    } ]
  }, {
    "tStartMs": 1429300,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "더 이상해"
    } ]
  }, {
    "tStartMs": 1430590,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "차라리 교복에 머리가 빠박이면"
    } ]
  }, {
    "tStartMs": 1432520,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "쟤네 뭐"
    } ]
  }, {
    "tStartMs": 1433290,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "그렇죠 육군사관학교"
    } ]
  }, {
    "tStartMs": 1434630,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "그런 느낌도 있을 수 있잖아요"
    } ]
  }, {
    "tStartMs": 1436410,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "육사 아니면 유니폼"
    } ]
  }, {
    "tStartMs": 1437890,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "유니폼 입는 회사 공사"
    } ]
  }, {
    "tStartMs": 1439420,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "이런 느낌인데"
    } ]
  }, {
    "tStartMs": 1440450,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "사복에 빠박이면"
    } ]
  }, {
    "tStartMs": 1442050,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "사람들이 고등학생인데"
    } ]
  }, {
    "tStartMs": 1444310,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "혹시 출소하셨어요?"
    } ]
  }, {
    "tStartMs": 1446090,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "이런 얘기도 하고"
    } ]
  }, {
    "tStartMs": 1447380,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "스님인가?"
    } ]
  }, {
    "tStartMs": 1448370,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "이런 얘기를 해서"
    } ]
  }, {
    "tStartMs": 1450050,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "우리 학교 별명이 무슨 무슨 고가 아니라"
    } ]
  }, {
    "tStartMs": 1452740,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "무슨 무슨 사였어요"
    } ]
  }, {
    "tStartMs": 1453800,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "무슨 무슨 사"
    } ]
  }, {
    "tStartMs": 1455300,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "이게 절 이름처럼 붙어서"
    } ]
  }, {
    "tStartMs": 1457330,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "무슨 무슨 사"
    } ]
  }, {
    "tStartMs": 1457990,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "무슨 무슨 사"
    } ]
  }, {
    "tStartMs": 1458690,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "스님들 나온다고"
    } ]
  }, {
    "tStartMs": 1460710,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "저희는 3천 명이었거든요"
    } ]
  }, {
    "tStartMs": 1462350,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "전교생이"
    } ]
  }, {
    "tStartMs": 1463070,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "한 학년에 천 명씩"
    } ]
  }, {
    "tStartMs": 1464190,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "하교 때 되면 문이 열리더니"
    } ]
  }, {
    "tStartMs": 1466140,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "스님 3천 분이 촤아악"
    } ]
  }, {
    "tStartMs": 1468220,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "이렇게 촤아악"
    } ]
  }, {
    "tStartMs": 1469380,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "사복 입고"
    } ]
  }, {
    "tStartMs": 1470130,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "촤아악 이렇게"
    } ]
  }, {
    "tStartMs": 1471730,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "아니 갑자기 그게 생각이 납니다"
    } ]
  }, {
    "tStartMs": 1473420,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "그래서 학생들이 안 된다"
    } ]
  }, {
    "tStartMs": 1474970,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "우리 머리를 길게 해주던지"
    } ]
  }, {
    "tStartMs": 1476390,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "교복을 입히던지 바꿔달라 그랬더니"
    } ]
  }, {
    "tStartMs": 1478900,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "놀랍게도 그렇게 얘기하면"
    } ]
  }, {
    "tStartMs": 1480380,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "머리를 길게 해주실 줄 알았는데"
    } ]
  }, {
    "tStartMs": 1482350,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "교복을 입히시더라고요"
    } ]
  }, {
    "tStartMs": 1484850,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "지금 생각하면 대응이 잘못됐다"
    } ]
  }, {
    "tStartMs": 1486850,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "우리가 요구를 그렇게 하면 안 되고"
    } ]
  }, {
    "tStartMs": 1488620,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "머리를 길게 해주던지"
    } ]
  }, {
    "tStartMs": 1489720,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "교복을 입어야지"
    } ]
  }, {
    "tStartMs": 1490480,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "이거 너무한 거 아닙니까?"
    } ]
  }, {
    "tStartMs": 1491420,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "출소했다는 소리 듣고 그랬더니"
    } ]
  }, {
    "tStartMs": 1492900,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "선생님들이 그래 알겠어"
    } ]
  }, {
    "tStartMs": 1494000,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "교복을 입혀줄게"
    } ]
  }, {
    "tStartMs": 1495070,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "해서 놀랍게도"
    } ]
  }, {
    "tStartMs": 1496770,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "제 모교가 그때부터 교복이 생겼습니다"
    } ]
  }, {
    "tStartMs": 1498540,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "우리 후배들한테 미안하게 생각해요"
    } ]
  }, {
    "tStartMs": 1500620,
    "dDurationMs": 490,
    "segs": [ {
      "utf8": "잘 말했으면"
    } ]
  }, {
    "tStartMs": 1501110,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "너희도 교복 안 입을 수 있었는데"
    } ]
  }, {
    "tStartMs": 1503160,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "우리가 그걸 주장하는 바람에"
    } ]
  }, {
    "tStartMs": 1505380,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "선생님들이 그걸 선택할 줄 몰랐지"
    } ]
  }, {
    "tStartMs": 1506840,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "머리를 길게 해줄 줄 알았는데"
    } ]
  }, {
    "tStartMs": 1508220,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "그래서 이제 교복이 나왔다는"
    } ]
  }, {
    "tStartMs": 1510090,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "그런 믿거나 말거나 사건이 있었습니다"
    } ]
  }, {
    "tStartMs": 1511770,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "이게 1994년"
    } ]
  }, {
    "tStartMs": 1513600,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "1995년 그때였던 것 같아요"
    } ]
  }, {
    "tStartMs": 1515230,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "결국 하고 싶은 말은"
    } ]
  }, {
    "tStartMs": 1516910,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "우리가 담합을 너무 가볍게 생각하는 게 아닌가"
    } ]
  }, {
    "tStartMs": 1519560,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "너무 많으니까"
    } ]
  }, {
    "tStartMs": 1520970,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "게다가 생활 물가가 그렇게 높다고 얘기를 하는데"
    } ]
  }, {
    "tStartMs": 1523640,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "정상적인 가격이 아니라는 거잖아요"
    } ]
  }, {
    "tStartMs": 1525930,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "담합 가격은 정상적인 가격이 아닙니다"
    } ]
  }, {
    "tStartMs": 1528390,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "그거는 짜고 치는 가격이죠"
    } ]
  }, {
    "tStartMs": 1530020,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "짠 가격이기 때문에"
    } ]
  }, {
    "tStartMs": 1531520,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "아까도 말씀드렸지만"
    } ]
  }, {
    "tStartMs": 1532420,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "시장 경제의 대표적인 실패 사례로 봐야 되고"
    } ]
  }, {
    "tStartMs": 1535420,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "우리가 이렇게 가격이 높은 이유에 대해서"
    } ]
  }, {
    "tStartMs": 1537490,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "여러 가지 얘기를 하는데"
    } ]
  }, {
    "tStartMs": 1538840,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "여러 가지 얘기를 하는 기조에는"
    } ]
  }, {
    "tStartMs": 1541120,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "기본적으로 깔려있는 것은"
    } ]
  }, {
    "tStartMs": 1542250,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "반칙이 없다는 게 깔려있는 거죠"
    } ]
  }, {
    "tStartMs": 1544630,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "반칙이 없는 상황에서도"
    } ]
  }, {
    "tStartMs": 1545970,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "가격이 높다면"
    } ]
  }, {
    "tStartMs": 1546830,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "그걸 어떻게 하면 낮출 수 있을까?"
    } ]
  }, {
    "tStartMs": 1548850,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "유통을 어떻게 해볼까?"
    } ]
  }, {
    "tStartMs": 1549990,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "수입을 어떻게 해볼까?"
    } ]
  }, {
    "tStartMs": 1551290,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "대량 생산을 해볼까?"
    } ]
  }, {
    "tStartMs": 1552220,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "이런 고민을 하는 건데"
    } ]
  }, {
    "tStartMs": 1553330,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "반칙이 있다면"
    } ]
  }, {
    "tStartMs": 1554160,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "그런 게 아무런 소용이 없는 겁니다"
    } ]
  }, {
    "tStartMs": 1556590,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "아무런 소용이 없잖아요"
    } ]
  }, {
    "tStartMs": 1557920,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "기본적으로 이 경쟁과 시장의 가격 결정이라는"
    } ]
  }, {
    "tStartMs": 1561490,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "이 메커니즘을 완전히 훼손하는 거기 때문에"
    } ]
  }, {
    "tStartMs": 1564130,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "굉장히 좀 그런 게 없도록"
    } ]
  }, {
    "tStartMs": 1566190,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "특히 우리가 사는 물건들"
    } ]
  }, {
    "tStartMs": 1567470,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "가격은 가격이 너무 비싸니까"
    } ]
  }, {
    "tStartMs": 1569410,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "그걸 낮추기 위해서는"
    } ]
  }, {
    "tStartMs": 1570770,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "뭔가 페널티를 조금 더"
    } ]
  }, {
    "tStartMs": 1572430,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "개인적으로는 좀 올려야"
    } ]
  }, {
    "tStartMs": 1574770,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "이게 반복이 안 되지 않을까?"
    } ]
  }, {
    "tStartMs": 1576390,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "반복이 안 되면"
    } ]
  }, {
    "tStartMs": 1577120,
    "dDurationMs": 670,
    "segs": [ {
      "utf8": "이제 그 다음에 페널티 좀"
    } ]
  }, {
    "tStartMs": 1577790,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "낮출 수도 있을 것 같은데"
    } ]
  }, {
    "tStartMs": 1579030,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "계속 반복이 되니까"
    } ]
  }, {
    "tStartMs": 1580370,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "좀 주의깊게 담합이 좀 없어질 수 있도록"
    } ]
  }, {
    "tStartMs": 1582650,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "노력해야 되지 않나 생각해 봅니다"
    } ]
  } ]
}

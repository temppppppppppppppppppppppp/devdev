  }, {
    "tStartMs": 1466400,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "내년 말까지 5천억 달러"
    } ]
  }, {
    "tStartMs": 1467900,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "후년 말까지는 1조 달러"
    } ]
  }, {
    "tStartMs": 1470260,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "엄청난 발표였다고 생각을 했는데"

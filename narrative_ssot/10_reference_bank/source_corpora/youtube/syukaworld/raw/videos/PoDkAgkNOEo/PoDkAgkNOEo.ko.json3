  }, {
    "tStartMs": 1472380,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "막상 주가는 횡보했어요"
    } ]
  }, {
    "tStartMs": 1475010,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "저 발표를 실시간으로 보신 분이 있는지 모르겠는데"
    } ]
  }, {
    "tStartMs": 1478110,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "장중에는 올랐어"
    } ]
  }, {
    "tStartMs": 1479200,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "거의 5% 갖고 올랐어"
    } ]
  }, {
    "tStartMs": 1480840,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "오 가는구나 됐어! 라고 했는데"
    } ]
  }, {
    "tStartMs": 1482940,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "다시 밀려서 끝났어요"
    } ]
  }, {
    "tStartMs": 1484160,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "다시 다 밀려서"
    } ]
  }, {
    "tStartMs": 1485680,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "결국엔 횡보했습니다"
    } ]
  }, {
    "tStartMs": 1486760,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "결국엔 1% 되기 때문에"
    } ]
  }, {
    "tStartMs": 1488810,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "엔비디아를 갖고 계시는 분들은"
    } ]
  }, {
    "tStartMs": 1490190,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "요즘 횡비디아죠, 횡비디아"
    } ]
  }, {
    "tStartMs": 1491400,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "이게 뭐 오르는 것도 아니고"
    } ]
  }, {
    "tStartMs": 1493220,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "현대차라고 하면 안 되죠"
    } ]
  }, {
    "tStartMs": 1494850,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "현대차는 이렇게 됐기 때문에"
    } ]
  }, {
    "tStartMs": 1496420,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "과거의 현대차가 아니죠"
    } ]
  }, {
    "tStartMs": 1498050,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "횡비디아로 불리고 있는데"
    } ]
  }, {
    "tStartMs": 1499400,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "여전히 횡비디아가 아닌가 생각이 되고"
    } ]
  }, {
    "tStartMs": 1502080,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "그걸 왜 횡보하느냐"
    } ]
  }, {
    "tStartMs": 1502880,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "1조 달러가 엄청난데"
    } ]
  }, {
    "tStartMs": 1504720,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "엔비디아 주주들이"
    } ]
  }, {
    "tStartMs": 1505520,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "이렇게 얘기한다고 그래요"
    } ]
  }, {
    "tStartMs": 1506750,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "겨우?"
    } ]
  }, {
    "tStartMs": 1508190,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "이 전망이 매출 성장에 중대한"
    } ]
  }, {
    "tStartMs": 1510440,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "가속을 뜻하는 건 아니다"
    } ]
  }, {
    "tStartMs": 1512700,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "엄청난 성장인데요"
    } ]
  }, {
    "tStartMs": 1513740,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "아 그거?"
    } ]
  }, {
    "tStartMs": 1514620,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "그거 뭐 끽해야 100%"
    } ]
  }, {
    "tStartMs": 1516380,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "성장한다는 거잖아"
    } ]
  }, {
    "tStartMs": 1518190,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "뭐 원래도 그 정도 했어"
    } ]
  }, {
    "tStartMs": 1519280,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "원래도 그 정도"
    } ]
  }, {
    "tStartMs": 1520830,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "많을 때 200% 했는데"
    } ]
  }, {
    "tStartMs": 1521930,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "뭐 이 정도 성장한다는 건데"
    } ]
  }, {
    "tStartMs": 1523970,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "뭐, 가던 길 가는 거 아닌가?"
    } ]
  }, {
    "tStartMs": 1525790,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "100%로는 안 되지"
    } ]
  }, {
    "tStartMs": 1527050,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "화끈하게 가야지, 화끈하게"
    } ]
  }, {
    "tStartMs": 1528830,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "이런 화성 가는 모습을 보여줘야 되는데"
    } ]
  }, {
    "tStartMs": 1531090,
    "dDurationMs": 490,
    "segs": [ {
      "utf8": "뭐 그냥 뭐"
    } ]
  }, {
    "tStartMs": 1531580,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "비비적비비적 한 7, 80% 정도 성장으로는"
    } ]
  }, {
    "tStartMs": 1534440,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "횡비디아라는 건데"
    } ]
  }, {
    "tStartMs": 1536540,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "그래요"
    } ]
  }, {
    "tStartMs": 1537370,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "굉장히 좀 이 세계 1위 기업이다 보니까"
    } ]
  }, {
    "tStartMs": 1540230,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "눈높이가 높아도"
    } ]
  }, {
    "tStartMs": 1541210,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "너무 높지 않나 생각을 하고"
    } ]
  }, {
    "tStartMs": 1543560,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "물론 1조 달러 전망 자체는"
    } ]
  }, {
    "tStartMs": 1544900,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "굉장히 좋은 뉴스이기 때문에"
    } ]
  }, {
    "tStartMs": 1546580,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "반도체 기업이 장기적으로는"
    } ]
  }, {
    "tStartMs": 1548250,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "좋을 것 같다는 생각되지만"
    } ]
  }, {
    "tStartMs": 1549600,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "당장 내일 가격이 밀리면"
    } ]
  }, {
    "tStartMs": 1551700,
    "dDurationMs": 550,
    "segs": [ {
      "utf8": "걱정이 좀 되는"
    } ]
  }, {
    "tStartMs": 1552250,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "그런 상황이라고 할 수 있죠"
    } ]
  }, {
    "tStartMs": 1553590,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "게다가 이것도 전쟁으로 인한"
    } ]
  }, {
    "tStartMs": 1555500,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "우리의 비용이라고 할 수 있고"
    } ]
  }, {
    "tStartMs": 1556960,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "원달러 환율 같은 경우에는"
    } ]
  }, {
    "tStartMs": 1558260,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "지금 우리나라가 전쟁 이후에 급등해서"
    } ]
  }, {
    "tStartMs": 1559970,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "1500원을 약간 넘었습니다"
    } ]
  }, {
    "tStartMs": 1562720,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "1500원 고지전 중인데"
    } ]
  }, {
    "tStartMs": 1564460,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "올라갔다 내려갔다 하고 있어요"
    } ]
  }, {
    "tStartMs": 1566480,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "월요일 되면 조금 더 내려가길 기대하는데"
    } ]
  }, {
    "tStartMs": 1568620,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "현재는 1,508원입니다"
    } ]
  }, {
    "tStartMs": 1570020,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "미국 이란 전쟁 이후로"
    } ]
  }, {
    "tStartMs": 1571150,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "원달러가 70원이 올랐어요"
    } ]
  }, {
    "tStartMs": 1573150,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "그런데 미국보다"
    } ]
  }, {
    "tStartMs": 1574170,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "우리나라가 조금 더 급한 게"
    } ]
  }, {
    "tStartMs": 1575440,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "우리나라는 조금 더 급한 게"
    } ]
  }, {
    "tStartMs": 1576400,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "우리나라는 유가와 환율이"
    } ]
  }, {
    "tStartMs": 1577850,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "동시에 올랐다는 말과 똑같습니다"
    } ]
  }, {
    "tStartMs": 1580760,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "우리나라 물가에 가장 큰 영향을 미치는"
    } ]
  }, {
    "tStartMs": 1583070,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "개별 요소는 1번이 환율이고"
    } ]
  }, {
    "tStartMs": 1584950,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "2번이 유가로 알려져 있어요"
    } ]
  }, {
    "tStartMs": 1587100,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "외부 요소, 외부 요소"
    } ]
  }, {
    "tStartMs": 1588080,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "우리나라 내부 요소를 제외한다면"
    } ]
  }, {
    "tStartMs": 1589710,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "물론 우리나라가 막"
    } ]
  }, {
    "tStartMs": 1591230,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "돈 찍고 그러면 팍 오르겠죠"
    } ]
  }, {
    "tStartMs": 1592420,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "그런 걸 제외하고"
    } ]
  }, {
    "tStartMs": 1593720,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "물가에 가장 큰 영향을 끼치는 걸 꼽아라"
    } ]
  }, {
    "tStartMs": 1595760,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "그럼 보통 1번이 환율입니다"
    } ]
  }, {
    "tStartMs": 1597560,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "2번이 유가예요"
    } ]
  }, {
    "tStartMs": 1598720,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "환율이 근데"
    } ]
  }, {
    "tStartMs": 1599870,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "저 미국・이란 전쟁 때문에 올랐고"
    } ]
  }, {
    "tStartMs": 1602690,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "유가가 100달러, 110달러를 넘었고"
    } ]
  }, {
    "tStartMs": 1605340,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "환율 상승과 유가 상승의 조합은"
    } ]
  }, {
    "tStartMs": 1607690,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "물가에는 최악의 조합입니다"
    } ]
  }, {
    "tStartMs": 1609920,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "물론 지금 당장 잠깐 했다가"
    } ]
  }, {
    "tStartMs": 1611660,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "내려오면 되죠"
    } ]
  }, {
    "tStartMs": 1612300,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "일시적이면 상관없는데"
    } ]
  }, {
    "tStartMs": 1613730,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "이게 좀 길어지거나 하면"
    } ]
  }, {
    "tStartMs": 1615710,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "굉장히 또 비상이라고 할 수 있죠"
    } ]
  }, {
    "tStartMs": 1618360,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "그래서 우리나라 금통위가"
    } ]
  }, {
    "tStartMs": 1619690,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "얼마 전에 열렸는데"
    } ]
  }, {
    "tStartMs": 1620930,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "기준 금리는 동결됐습니다"
    } ]
  }, {
    "tStartMs": 1622880,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "2.5%에 동결됐는데"
    } ]
  }, {
    "tStartMs": 1624350,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "이번 금통위에서 사상 최초로"
    } ]
  }, {
    "tStartMs": 1626500,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "K-점도표가 등장했어요"
    } ]
  }, {
    "tStartMs": 1628600,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "이제 우리나라도 점도표를 발표합니다"
    } ]
  }, {
    "tStartMs": 1630790,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "금통위에서"
    } ]
  }, {
    "tStartMs": 1631830,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "이번부터 한다 그랬는데"
    } ]
  }, {
    "tStartMs": 1632880,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "이번이 최초예요"
    } ]
  }, {
    "tStartMs": 1633820,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "6개월 후에"
    } ]
  }, {
    "tStartMs": 1635020,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "기준금리가 어디에 있을 거냐"
    } ]
  }, {
    "tStartMs": 1637040,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "금통위원분들이 점을 찍은 거예요"
    } ]
  }, {
    "tStartMs": 1639030,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "마치 연준처럼"
    } ]
  }, {
    "tStartMs": 1639920,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "한 명당 3개의 점을 찍습니다"
    } ]
  }, {
    "tStartMs": 1641980,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "6개월 뒤에"
    } ]
  }, {
    "tStartMs": 1642670,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "지금 현재를 보면"
    } ]
  }, {
    "tStartMs": 1643640,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "인상이 1표고"
    } ]
  }, {
    "tStartMs": 1645100,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "인하가 4표거든요"
    } ]
  }, {
    "tStartMs": 1646610,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "나머지는 모두 동결이에요"
    } ]
  }, {
    "tStartMs": 1648010,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "오, 그럼 인상 가능성보다"
    } ]
  }, {
    "tStartMs": 1649090,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "인하 가능성이 훨씬 많군요"
    } ]
  }, {
    "tStartMs": 1651490,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "저 점도표는 2월에 찍은 겁니다"
    } ]
  }, {
    "tStartMs": 1654980,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "미국, 이란 전쟁 이전에 찍었어"
    } ]
  }, {
    "tStartMs": 1658400,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "지금 다시 찍으라 그러면"
    } ]
  }, {
    "tStartMs": 1660370,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "어디에 찍힐까?"
    } ]
  }, {
    "tStartMs": 1662180,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "그때보다 물가는 상방이고"
    } ]
  }, {
    "tStartMs": 1664570,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "성장률은 하방 리스크가 훨씬 커졌죠"
    } ]
  }, {
    "tStartMs": 1667390,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "환율도 그렇고"
    } ]
  }, {
    "tStartMs": 1668630,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "유가도 그렇고"
    } ]
  }, {
    "tStartMs": 1669990,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "그렇게 따지면"
    } ]
  }, {
    "tStartMs": 1670830,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "미국보다도 개인적으로"
    } ]
  }, {
    "tStartMs": 1672990,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "개인이 장기화되고"
    } ]
  }, {
    "tStartMs": 1673780,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "물가가 상승되면"
    } ]
  }, {
    "tStartMs": 1675050,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "금리가 인상될 수도 있을 것 같은데"
    } ]
  }, {
    "tStartMs": 1677810,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "근데 아까도 말씀드렸지만"
    } ]
  }, {
    "tStartMs": 1678950,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "공급할 스태그플레이션 하에서"
    } ]
  }, {
    "tStartMs": 1680820,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "중앙은행이 할 수 있는 역할이"
    } ]
  }, {
    "tStartMs": 1682100,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "굉장히 제한적입니다"
    } ]
  }, {
    "tStartMs": 1683840,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "물가가 올라가면"
    } ]
  }, {
    "tStartMs": 1684560,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "결국엔 물가를 잡기 위해서"
    } ]
  }, {
    "tStartMs": 1685640,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "금리 인상 얘기가 안 나올 수는 없을 것 같은데"
    } ]
  }, {
    "tStartMs": 1687920,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "그렇다고 뭐 고유가 환경에서"
    } ]
  }, {
    "tStartMs": 1690120,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "금리만 올린다고"
    } ]
  }, {
    "tStartMs": 1691460,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "문제 해결되는 게 아니기 때문에"
    } ]
  }, {
    "tStartMs": 1693180,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "굉장히 어려운 시기가 올 수 있겠죠"
    } ]
  }, {
    "tStartMs": 1695140,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "그래서 전쟁이 빨리 끝나고"
    } ]
  }, {
    "tStartMs": 1696600,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "물가도 내려가고"
    } ]
  }, {
    "tStartMs": 1697790,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "환율도 안정화돼야"
    } ]
  }, {
    "tStartMs": 1698850,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "다시 이제 금리 인상 같은 얘기가 안 나오고"
    } ]
  }, {
    "tStartMs": 1700950,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "금리 인하 쪽으로 가면서"
    } ]
  }, {
    "tStartMs": 1702270,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "우리나라 주식시장도 다시"
    } ]
  }, {
    "tStartMs": 1703790,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "상승을 할 수 있지 않을까"
    } ]
  }, {
    "tStartMs": 1705890,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "생각을 합니다"
    } ]
  } ]
}

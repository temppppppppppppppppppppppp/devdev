  }, {
    "tStartMs": 1445260,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "전액 현금 3배 났고"
    } ]
  }, {
    "tStartMs": 1446610,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "저 기업이 NBA 역사상"
    } ]
  }, {
    "tStartMs": 1447840,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "최대 규모 인수를 한"
    } ]
  }, {
    "tStartMs": 1449230,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "AI 추론 특화 기업이라고 할 수 있죠"
    } ]
  }, {
    "tStartMs": 1452150,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "그리고 GTC에서"
    } ]
  }, {
    "tStartMs": 1453630,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "젠슨황 선생님이 이렇게 얘기했습니다"

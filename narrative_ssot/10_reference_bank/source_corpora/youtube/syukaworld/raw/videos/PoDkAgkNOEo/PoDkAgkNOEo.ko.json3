  }, {
    "tStartMs": 1431430,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "3개월 전에 69억 달러 기준으로"
    } ]
  }, {
    "tStartMs": 1433720,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "투자자금을 모았는데"
    } ]
  }, {
    "tStartMs": 1434830,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "200억 달러에"
    } ]
  }, {
    "tStartMs": 1435850,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "전액 현금 인수했어요"
    } ]
  }, {
    "tStartMs": 1438270,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "부럽다 3배로"
    } ]
  }, {
    "tStartMs": 1439940,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "전액 현금으로"
    } ]
  }, {
    "tStartMs": 1441230,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "저 그록에 들어갔던 분들은"
    } ]
  }, {
    "tStartMs": 1442680,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "순식간에 3개월 만에"
    } ]
  }, {
    "tStartMs": 1443940,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "3배 난 겁니다, 3배"

{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 7330,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "자, 세 번째 주제는 바로 이겁니다"
    } ]
  }, {
    "tStartMs": 9400,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "전쟁 비용 청구서가 나오고 있다"
    } ]
  }, {
    "tStartMs": 12450,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "전쟁 비용이 얼마가 될지"
    } ]
  }, {
    "tStartMs": 14150,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "한번 저와 같이"
    } ]
  }, {
    "tStartMs": 15020,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "알아보는 시간을 갖도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 17230,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "왜냐하면 미국・이란 전쟁이 길어지면서"
    } ]
  }, {
    "tStartMs": 19110,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "전쟁 비용이 눈덩이처럼 커지고 있거든요"
    } ]
  }, {
    "tStartMs": 22040,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "미국이 툭 하면"
    } ]
  }, {
    "tStartMs": 23240,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "적의 핵심 시설을 멀리서 막 쏘잖아요"
    } ]
  }, {
    "tStartMs": 25330,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "미사일로"
    } ]
  }, {
    "tStartMs": 26070,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "그때 발사하는 미사일이"
    } ]
  }, {
    "tStartMs": 27410,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "왼쪽에 보이는 토마호크 미사일입니다"
    } ]
  }, {
    "tStartMs": 29730,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "생긴 것만 봐도"
    } ]
  }, {
    "tStartMs": 30490,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "눈에 좀 익숙하죠"
    } ]
  }, {
    "tStartMs": 31270,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "수천 킬로미터 밖에서"
    } ]
  }, {
    "tStartMs": 32800,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "구축함 이런 데서"
    } ]
  }, {
    "tStartMs": 34260,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "발사하는 미사일들"
    } ]
  }, {
    "tStartMs": 35520,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "그게 토마호크 미사일인데"
    } ]
  }, {
    "tStartMs": 37380,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "이 토마호크 미사일이 한 발에"
    } ]
  }, {
    "tStartMs": 38760,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "350만 달러라고 합니다"
    } ]
  }, {
    "tStartMs": 41320,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "52억 원"
    } ]
  }, {
    "tStartMs": 42370,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "한마디로 빌딩을 쏘는 겁니다"
    } ]
  }, {
    "tStartMs": 43970,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "강남아파트 한 채를"
    } ]
  }, {
    "tStartMs": 47040,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "한 발 쏠 때마다 날아가는 거죠"
    } ]
  }, {
    "tStartMs": 49660,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "전쟁 발발 일주일 만에"
    } ]
  }, {
    "tStartMs": 51400,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "미국이 쏜"
    } ]
  }, {
    "tStartMs": 52220,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "토마호크 미사일이 300발입니다"
    } ]
  }, {
    "tStartMs": 54890,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "강남아파트 300채를"
    } ]
  }, {
    "tStartMs": 56540,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "일주일 만에 쐈어요"
    } ]
  }, {
    "tStartMs": 58020,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "토마호크만"
    } ]
  }, {
    "tStartMs": 59510,
    "dDurationMs": 510,
    "segs": [ {
      "utf8": "그거 말고"
    } ]
  }, {
    "tStartMs": 60020,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "기타 미사일 비용까지 합치면"
    } ]
  }, {
    "tStartMs": 62370,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "전쟁 발발 일주일 만에"
    } ]
  }, {
    "tStartMs": 63790,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "미국이 쏜 미사일이 8조입니다"
    } ]
  }, {
    "tStartMs": 65600,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "8조 어치를"
    } ]
  }, {
    "tStartMs": 67870,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "어쨌건 날렸어요"
    } ]
  }, {
    "tStartMs": 69030,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "어쨌건 쐈고요"
    } ]
  }, {
    "tStartMs": 70340,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "게다가 미사일만 쐈냐?"
    } ]
  }, {
    "tStartMs": 72400,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "이란이 날린"
    } ]
  }, {
    "tStartMs": 73420,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "드론이나 미사일을 막아야겠죠"
    } ]
  }, {
    "tStartMs": 75610,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "소위 뭐 사드라든지"
    } ]
  }, {
    "tStartMs": 76920,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "무슨 아이언돔이라든지"
    } ]
  }, {
    "tStartMs": 77990,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "그런 거 있잖아요"
    } ]
  }, {
    "tStartMs": 78840,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "그걸 통해서"
    } ]
  }, {
    "tStartMs": 79590,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "날라오면 고고도 지역방위를 합니다"
    } ]
  }, {
    "tStartMs": 81950,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "이란이 보낸 미사일을 격추하는 거"
    } ]
  }, {
    "tStartMs": 83780,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "이 격추하려고 쓰이는"
    } ]
  }, {
    "tStartMs": 85530,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "대공방어 탄약에만"
    } ]
  }, {
    "tStartMs": 87420,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "역시 또 8조가 들어갔어요"
    } ]
  }, {
    "tStartMs": 89620,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "어쨌건 막아야 될 거 아니에요"
    } ]
  }, {
    "tStartMs": 91100,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "그러니까 이란은"
    } ]
  }, {
    "tStartMs": 92100,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "한 1, 2천만 원짜리 날리는데"
    } ]
  }, {
    "tStartMs": 94300,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "그걸 격추하려면"
    } ]
  }, {
    "tStartMs": 95810,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "몇 억짜리를 쏴서"
    } ]
  }, {
    "tStartMs": 96800,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "격추하는 걸 수도 있습니다"
    } ]
  }, {
    "tStartMs": 98420,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "천만 원짜리 날라오는데"
    } ]
  }, {
    "tStartMs": 99670,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "우리는 3억짜리로 막아야 되는"
    } ]
  }, {
    "tStartMs": 101300,
    "dDurationMs": 540,
    "segs": [ {
      "utf8": "그런 게 이제"
    } ]
  }, {
    "tStartMs": 101840,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "반복이 되고 있다는 거죠"
    } ]
  }, {
    "tStartMs": 103580,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "게다가 그거 외에"
    } ]
  }, {
    "tStartMs": 105310,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "전투로 인한 손실도 있고"
    } ]
  }, {
    "tStartMs": 106720,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "기지 피해도 있고"
    } ]
  }, {
    "tStartMs": 107720,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "운영 지원비 이런 게 다 들어가죠"
    } ]
  }, {
    "tStartMs": 109610,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "그런 비용도"
    } ]
  }, {
    "tStartMs": 110170,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "일주일에 2조가 들어갔다고 합니다"
    } ]
  }, {
    "tStartMs": 112480,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "결론적으로"
    } ]
  }, {
    "tStartMs": 113500,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "개전 첫 주일 만에"
    } ]
  }, {
    "tStartMs": 114780,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "정확히는 6일 만에"
    } ]
  }, {
    "tStartMs": 116260,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "들어간 전쟁 비용이"
    } ]
  }, {
    "tStartMs": 117790,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "127억 달러, 19조입니다"
    } ]
  }, {
    "tStartMs": 121250,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "물론 모든 비용을 다 넣은 건 아니고"
    } ]
  }, {
    "tStartMs": 123050,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "저 멀리서 병력을 증가하려면"
    } ]
  }, {
    "tStartMs": 125030,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "이동시켜야 되거나"
    } ]
  }, {
    "tStartMs": 125940,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "미군 시설을 복구해야 되거나"
    } ]
  }, {
    "tStartMs": 127100,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "이런 건 아직 들어간 게 아니라고 합니다"
    } ]
  }, {
    "tStartMs": 128830,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "6일 만에"
    } ]
  }, {
    "tStartMs": 130180,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "총 비용이냐?"
    } ]
  }, {
    "tStartMs": 130860,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "지금은 전쟁 22일 차입니다"
    } ]
  }, {
    "tStartMs": 133540,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "물론 첫 주에 가장 많은 돈을 썼겠지만"
    } ]
  }, {
    "tStartMs": 135900,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "그래도 이거보다"
    } ]
  }, {
    "tStartMs": 136610,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "굉장히 크게 증가했다는 걸"
    } ]
  }, {
    "tStartMs": 138460,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "알 수 있죠"
    } ]
  }, {
    "tStartMs": 139540,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "미 국방부가 밝힌"
    } ]
  }, {
    "tStartMs": 140780,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "첫 주 오피셜 비용은"
    } ]
  }, {
    "tStartMs": 142120,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "113억 달러입니다"
    } ]
  }, {
    "tStartMs": 143580,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "위에 있는 비용은"
    } ]
  }, {
    "tStartMs": 144350,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "이제 민간에서"
    } ]
  }, {
    "tStartMs": 145680,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "그걸 바탕으로 조금 더 수정한 비용이"
    } ]
  }, {
    "tStartMs": 147140,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "127억 달러니까"
    } ]
  }, {
    "tStartMs": 148590,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "15조에서 20조 사이 언저리를"
    } ]
  }, {
    "tStartMs": 151580,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "첫 일주일간"
    } ]
  }, {
    "tStartMs": 152320,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "전쟁 비용으로 사용했다고 보면 됩니다"
    } ]
  }, {
    "tStartMs": 154670,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "게다가 최근 이란이 얼마 전에"
    } ]
  }, {
    "tStartMs": 156510,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "F35 한 대를 공격했다"
    } ]
  }, {
    "tStartMs": 158460,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "그래서 격추했다 이런 걸 발표했어요"
    } ]
  }, {
    "tStartMs": 160540,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "격추는 아닌 것 같고"
    } ]
  }, {
    "tStartMs": 162050,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "이란 상공에서 어떻게 공격을 받았나 봐요"
    } ]
  }, {
    "tStartMs": 164640,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "그래서 인근 미군 공군기지"
    } ]
  }, {
    "tStartMs": 165880,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "비상 착륙했다고 그러는데"
    } ]
  }, {
    "tStartMs": 167480,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "저 F35 한 대의 가격이"
    } ]
  }, {
    "tStartMs": 169180,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "보통 8천만 달러가 넘습니다"
    } ]
  }, {
    "tStartMs": 171270,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "미사일을 가득 채우고 있으면"
    } ]
  }, {
    "tStartMs": 172740,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "1억 달러에 육박해요"
    } ]
  }, {
    "tStartMs": 174300,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "이거 한 대 잘못되면"
    } ]
  }, {
    "tStartMs": 175450,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "천억입니다"
    } ]
  }, {
    "tStartMs": 176530,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "대당"
    } ]
  }, {
    "tStartMs": 177380,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "조종사의 어떤 그런 비용은 다 빼고"
    } ]
  }, {
    "tStartMs": 180000,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "기체만 천억이기 때문에"
    } ]
  }, {
    "tStartMs": 181960,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "한 대 어떻게 될 때마다"
    } ]
  }, {
    "tStartMs": 182980,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "가격은 더 눈덩이처럼 커지겠죠"
    } ]
  }, {
    "tStartMs": 185490,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "그래서 얼마 전에 트럼프 대통령이"
    } ]
  }, {
    "tStartMs": 187230,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "미 의회에"
    } ]
  }, {
    "tStartMs": 188220,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "이렇게 얘기를 했습니다"
    } ]
  }, {
    "tStartMs": 189820,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "우리는 즉시"
    } ]
  }, {
    "tStartMs": 190720,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "막대한 양의 타격이 필요하다"
    } ]
  }, {
    "tStartMs": 193310,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "돈 좀 달라는 거죠"
    } ]
  }, {
    "tStartMs": 194500,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "지금 이렇게 많이 써서"
    } ]
  }, {
    "tStartMs": 195470,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "탄약을 다 썼어"
    } ]
  }, {
    "tStartMs": 197050,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "돈이 좀 필요해 의회야, 돈 좀 줘라"
    } ]
  }, {
    "tStartMs": 199280,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "지금도 탄약이 많이 있긴 하지만"
    } ]
  }, {
    "tStartMs": 201630,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "내가 많이 써서가 아니라"
    } ]
  }, {
    "tStartMs": 203060,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "우크라이나 너희들이 너무 많은 원조를 해서"
    } ]
  }, {
    "tStartMs": 205180,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "탄핵이 줄어서 그래"
    } ]
  }, {
    "tStartMs": 206430,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "그러니까 의회야"
    } ]
  }, {
    "tStartMs": 207250,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "한약 좀 보충하게"
    } ]
  }, {
    "tStartMs": 208350,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "돈 좀 달라고 요청을 했고요"
    } ]
  }, {
    "tStartMs": 210000,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "의회가 그러면 얼마나 필요해요라고 물어보니까"
    } ]
  }, {
    "tStartMs": 212870,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "전쟁 부장과 헤드셋스가 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 215310,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "나쁜 놈들을 죽이려면"
    } ]
  }, {
    "tStartMs": 217090,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "돈이 드는 겁니다"
    } ]
  }, {
    "tStartMs": 218870,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "그러니까 돈을 주세요"
    } ]
  }, {
    "tStartMs": 220860,
    "dDurationMs": 340,
    "segs": [ {
      "utf8": "얼마?"
    } ]
  }, {
    "tStartMs": 221200,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "2천억 달러"
    } ]
  }, {
    "tStartMs": 222960,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "이게 오피셜 요구 금액입니다"
    } ]
  }, {
    "tStartMs": 224630,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "국방부는 이번에"
    } ]
  }, {
    "tStartMs": 225950,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "미 의회에 2천억 달러의"
    } ]
  }, {
    "tStartMs": 227330,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "추가 자금 지원을 요청했다"
    } ]
  }, {
    "tStartMs": 229100,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "300조입니다"
    } ]
  }, {
    "tStartMs": 230990,
    "dDurationMs": 3770,
    "segs": [ {
      "utf8": "참고로 미국이 우크라이나 전쟁에 지원한 자금이"
    } ]
  }, {
    "tStartMs": 234760,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "약 1,100억 달러로"
    } ]
  }, {
    "tStartMs": 235810,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "알려지고 있어요"
    } ]
  }, {
    "tStartMs": 237250,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "165조"
    } ]
  }, {
    "tStartMs": 238150,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "그런데 지금 300조를 요구한 거죠"
    } ]
  }, {
    "tStartMs": 241890,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "물론 300조를 다 쓴 건 아니죠"
    } ]
  }, {
    "tStartMs": 243560,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "우크라이나는 쓴 거고"
    } ]
  }, {
    "tStartMs": 244770,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "저건 이제 예산을 요청을 한 건데"
    } ]
  }, {
    "tStartMs": 246800,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "만약에 저 돈을 다 쓴다"
    } ]
  }, {
    "tStartMs": 248540,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "장기화가 됐어요"
    } ]
  }, {
    "tStartMs": 249230,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "이런 전쟁이"
    } ]
  }, {
    "tStartMs": 250130,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "그러면 우크라이나 전쟁보다"
    } ]
  }, {
    "tStartMs": 251400,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "더 큰 비용이 들 수도 있습니다"
    } ]
  }, {
    "tStartMs": 253690,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "사실은 그럴 가능성이 꽤 있어 보이는 게"
    } ]
  }, {
    "tStartMs": 256290,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "우크라이나 전쟁은"
    } ]
  }, {
    "tStartMs": 257190,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "어쨌건 미국이"
    } ]
  }, {
    "tStartMs": 258200,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "직접 뛰어드는 전쟁은 아니었고"
    } ]
  }, {
    "tStartMs": 259830,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "우크라이나와 러시아의 전쟁이었다면"
    } ]
  }, {
    "tStartMs": 261830,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "거기에 무기만 지원을 해준 건데"
    } ]
  }, {
    "tStartMs": 263330,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "이번엔 미국이 직접 뛰어드는 전쟁이죠"
    } ]
  }, {
    "tStartMs": 265170,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "당연히 비용이 더 크게 들 수도 있죠"
    } ]
  }, {
    "tStartMs": 267600,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "그런데 생각을 해보면"
    } ]
  }, {
    "tStartMs": 268830,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "예전 공화당에서"
    } ]
  }, {
    "tStartMs": 270320,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "바이든이 우크라이나 지원에"
    } ]
  }, {
    "tStartMs": 271640,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "100조를 넘게 해줬다"
    } ]
  }, {
    "tStartMs": 273040,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "160조를 넘게 해줬다"
    } ]
  }, {
    "tStartMs": 274330,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "그러더니 돈 낭비라고 삿대질을 했거든요"
    } ]
  }, {
    "tStartMs": 277540,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "미국의 부를 우크라이나 지원에"
    } ]
  }, {
    "tStartMs": 279660,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "이렇게 막 쏟아부으면"
    } ]
  }, {
    "tStartMs": 280470,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "어떻게 되냐?"
    } ]
  }, {
    "tStartMs": 281390,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "라고 반대했었는데"
    } ]
  }, {
    "tStartMs": 282670,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "이번에 300조 달라는 거거든요"
    } ]
  }, {
    "tStartMs": 284670,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "그래서 미 의회의"
    } ]
  }, {
    "tStartMs": 286030,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "마이크 존슨 하원의장이"
    } ]
  }, {
    "tStartMs": 287230,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 288520,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "그 옛날 돈은"
    } ]
  }, {
    "tStartMs": 290020,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "좀 쓸모없는데 들어갔지만"
    } ]
  }, {
    "tStartMs": 291380,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "이번 2천억 달러 요구는"
    } ]
  }, {
    "tStartMs": 292730,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "임의로 제시된 숫자가 아니다"
    } ]
  }, {
    "tStartMs": 294720,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "아주 정교하게 계산한 숫자고요"
    } ]
  }, {
    "tStartMs": 296890,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "지금 세계는 대단히 위험한 시기고"
    } ]
  }, {
    "tStartMs": 299030,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "우리는 국방에 충분한 자금을 지원할 의무가 있다"
    } ]
  }, {
    "tStartMs": 301970,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "그때랑은 달라"
    } ]
  }, {
    "tStartMs": 303020,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "다르기 때문에"
    } ]
  }, {
    "tStartMs": 304130,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "300조를 빠르게 지원해야 되지 않냐라고 생각한다는 거고요"
    } ]
  }, {
    "tStartMs": 307450,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "왜 이렇게 갑자기 돈이 많이 필요합니까?"
    } ]
  }, {
    "tStartMs": 309070,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "그랬더니 트럼프 대통령이 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 310600,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "아 그거?"
    } ]
  }, {
    "tStartMs": 311310,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "그거는 바이든 때문이다"
    } ]
  }, {
    "tStartMs": 314370,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "왜냐하면 옛날에"
    } ]
  }, {
    "tStartMs": 316190,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "슬리피 바이든, 졸린 바이든이 말이야"
    } ]
  }, {
    "tStartMs": 318550,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "우리나라에 있던 돈을"
    } ]
  }, {
    "tStartMs": 319570,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "우크라이나에 갖다 줬잖아"
    } ]
  }, {
    "tStartMs": 321500,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "수천억 달러를 주고"
    } ]
  }, {
    "tStartMs": 322440,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "있던 무기"
    } ]
  }, {
    "tStartMs": 323000,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "옛날에 재고 많았는데"
    } ]
  }, {
    "tStartMs": 324850,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "그거 다 우크라이나에 갖다 주고 하니까"
    } ]
  }, {
    "tStartMs": 327080,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "지금 재고가 없어요"
    } ]
  }, {
    "tStartMs": 328830,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "아니 그렇게 많은 무기를"
    } ]
  }, {
    "tStartMs": 330060,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "공짜로 다 줬으면 채워 넣어야지"
    } ]
  }, {
    "tStartMs": 333150,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "채워놓지 않고 내가 받으니까"
    } ]
  }, {
    "tStartMs": 334560,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "난 요만큼밖에 안 썼는데"
    } ]
  }, {
    "tStartMs": 335690,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "지금 무기가 없는 거 아니겠습니까?"
    } ]
  }, {
    "tStartMs": 337940,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "그래서 내가 지금 바이든이 쓴 거 채워놓느라고"
    } ]
  }, {
    "tStartMs": 340110,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "지금 달라는 거죠"
    } ]
  }, {
    "tStartMs": 340770,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "그래서 이 전쟁자금 요청은 누구 때문입니까?"
    } ]
  }, {
    "tStartMs": 343140,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "바이든 때문이죠"
    } ]
  }, {
    "tStartMs": 344820,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "논리 정연하잖아요, 정연해"
    } ]
  }, {
    "tStartMs": 346500,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "원래 그 많았던 거"
    } ]
  }, {
    "tStartMs": 347350,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "가만 말이야, 가만히 뒀어야지"
    } ]
  }, {
    "tStartMs": 349230,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "썼으면 채워놓든가"
    } ]
  }, {
    "tStartMs": 350970,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "해서 이제 어쩔 수 없이"
    } ]
  }, {
    "tStartMs": 352400,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "킹쩔 수 없이"
    } ]
  }, {
    "tStartMs": 353590,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "바이든 때문에"
    } ]
  }, {
    "tStartMs": 354340,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "돈을 좀 달라고 하는 거다라고"
    } ]
  }, {
    "tStartMs": 355850,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "요청을 했고요"
    } ]
  }, {
    "tStartMs": 357260,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "예전에 낭비되는 세금을 막겠다며"
    } ]
  }, {
    "tStartMs": 360040,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "전기톱을 휘둘러대던"
    } ]
  }, {
    "tStartMs": 361330,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "도지라고 있습니다"
    } ]
  }, {
    "tStartMs": 362760,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "벌써 기억에 가물가물하시죠?"
    } ]
  }, {
    "tStartMs": 364480,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "정부 효율 부서"
    } ]
  }, {
    "tStartMs": 365710,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "머스크 아저씨가 톱을 막 휘두르면서"
    } ]
  }, {
    "tStartMs": 367510,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "여기 자르고, 저기 자르고 다 잘랐죠"
    } ]
  }, {
    "tStartMs": 369680,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "이때 절감한 비용이"
    } ]
  }, {
    "tStartMs": 371020,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "1750억 달러로"
    } ]
  }, {
    "tStartMs": 372480,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "계산이 되고 있어요"
    } ]
  }, {
    "tStartMs": 373520,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "해외 원조 줄이고"
    } ]
  }, {
    "tStartMs": 374710,
    "dDurationMs": 630,
    "segs": [ {
      "utf8": "누구 자르고"
    } ]
  }, {
    "tStartMs": 375340,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "나사 뭐 자르고"
    } ]
  }, {
    "tStartMs": 376000,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "막 잘랐잖아요"
    } ]
  }, {
    "tStartMs": 376960,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "이번에 요청한 전쟁 비용이"
    } ]
  }, {
    "tStartMs": 378280,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "2000억 달러입니다"
    } ]
  }, {
    "tStartMs": 379870,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "이게 좀 더 큽니다"
    } ]
  }, {
    "tStartMs": 380860,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "그래서"
    } ]
  }, {
    "tStartMs": 382680,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "이란 전쟁 안 했으면"
    } ]
  }, {
    "tStartMs": 384160,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "여기 자르고 저기 자르고 안 해도 됐는데"
    } ]
  }, {
    "tStartMs": 386200,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "하여튼 그렇게 됐고요"
    } ]
  }, {
    "tStartMs": 387420,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "게다가 트럼프 행정부는"
    } ]
  }, {
    "tStartMs": 389160,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "작은 정부를 추구하고"
    } ]
  }, {
    "tStartMs": 390750,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "미국의 빚을, 부채를 줄이겠다는 목표가 있었죠"
    } ]
  }, {
    "tStartMs": 393710,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "그러니까 정부효율부서 도지 같은 것들을 만들었는데"
    } ]
  }, {
    "tStartMs": 396460,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "지금 미국 국가 부채가 어떻게 됐냐"
    } ]
  }, {
    "tStartMs": 398720,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "이란 전쟁 이후에"
    } ]
  }, {
    "tStartMs": 399790,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "미국 국가 부채가"
    } ]
  }, {
    "tStartMs": 400700,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "39조 달러를 돌파했습니다"
    } ]
  }, {
    "tStartMs": 403090,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "물론 이란 전쟁 때문에"
    } ]
  }, {
    "tStartMs": 404280,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "이렇게 늘어난 건 아니에요"
    } ]
  }, {
    "tStartMs": 405800,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "이란 전쟁 때문에"
    } ]
  }, {
    "tStartMs": 406670,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "앞으로 더 빨리 늘겠죠"
    } ]
  }, {
    "tStartMs": 408540,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "하지만 꼭 그것 때문은 아닌데"
    } ]
  }, {
    "tStartMs": 410230,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "7개월 전에 37조 달러"
    } ]
  }, {
    "tStartMs": 412480,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "5개월 전에 38조 달러"
    } ]
  }, {
    "tStartMs": 414490,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "지금 39조 달러"
    } ]
  }, {
    "tStartMs": 416130,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "이게 도대체 뭐 몇 달만에"
    } ]
  }, {
    "tStartMs": 417500,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "거의 5달마다 1조 달러가 늡니다"
    } ]
  }, {
    "tStartMs": 420320,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "1조 달러는 얼마입니까?"
    } ]
  }, {
    "tStartMs": 421730,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "1,500조"
    } ]
  }, {
    "tStartMs": 423110,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "지금 5경 8천조인데"
    } ]
  }, {
    "tStartMs": 425260,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "가을 선거 오기 전에"
    } ]
  }, {
    "tStartMs": 426840,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "40조 달러"
    } ]
  }, {
    "tStartMs": 427930,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "6경 예상됩니다, 6경"
    } ]
  }, {
    "tStartMs": 430100,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "한마디로 이제 국가 부채가"
    } ]
  }, {
    "tStartMs": 431380,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "늘어난 속도가 브레이크가 없죠?"
    } ]
  }, {
    "tStartMs": 433360,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "브레이크가 없어요"
    } ]
  }, {
    "tStartMs": 434330,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "지금 이렇게 되면서"
    } ]
  }, {
    "tStartMs": 435830,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "안 그래도 국가 부채를 줄인다고 했는데"
    } ]
  }, {
    "tStartMs": 437780,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "전쟁까지 터지면"
    } ]
  }, {
    "tStartMs": 438960,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "국가 부채가 줄어들게 만무하기 때문에"
    } ]
  }, {
    "tStartMs": 441260,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "미국 국가 부채가 늘어나는 속도는"
    } ]
  }, {
    "tStartMs": 442720,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "더 빨라지지 않을까?"
    } ]
  }, {
    "tStartMs": 444130,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "이런 우려가 많이 있죠"
    } ]
  }, {
    "tStartMs": 446080,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "게다가 미국으로 돌아오면"
    } ]
  }, {
    "tStartMs": 447970,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "지금 돈을 쓴 게"
    } ]
  }, {
    "tStartMs": 448840,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "이 정도지만"
    } ]
  }, {
    "tStartMs": 449760,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "직접적으로 쓴 거 외에"
    } ]
  }, {
    "tStartMs": 451070,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "또 다른 전쟁 비용이 청구되고 있습니다"
    } ]
  }, {
    "tStartMs": 453070,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "가장 대표적으로"
    } ]
  }, {
    "tStartMs": 454170,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "유가도 전쟁 비용이죠"
    } ]
  }, {
    "tStartMs": 456060,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "미국 이란 전쟁으로"
    } ]
  }, {
    "tStartMs": 457240,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "유가가 110달러를 돌파했습니다"
    } ]
  }, {
    "tStartMs": 459240,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "112달러인데"
    } ]
  }, {
    "tStartMs": 460120,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "지금 왔다 갔다 하고 있죠"
    } ]
  }, {
    "tStartMs": 461370,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "만약 지금처럼 전쟁이 계속 오래되면"
    } ]
  }, {
    "tStartMs": 463310,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "더 올라갈 수도 있죠"
    } ]
  }, {
    "tStartMs": 464630,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "물론 이렇게 생각할 수 있습니다"
    } ]
  }, {
    "tStartMs": 465890,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "아니 미국은 세계 최대 산유국인데"
    } ]
  }, {
    "tStartMs": 468430,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "유가가 안정적이지 않겠냐"
    } ]
  }, {
    "tStartMs": 470690,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "휘발유 가격 오른다고"
    } ]
  }, {
    "tStartMs": 471730,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "미국이 꿈쩍이나 할까요?"
    } ]
  }, {
    "tStartMs": 472790,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "세계 최대 산유국인데?"
    } ]
  }, {
    "tStartMs": 474150,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "라고 생각하는 분들이 계실 것 같은데"
    } ]
  }, {
    "tStartMs": 476500,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "여러분이 기업이라고 생각해보세요"
    } ]
  }, {
    "tStartMs": 478500,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "글로벌 유가가 오르는데"
    } ]
  }, {
    "tStartMs": 480320,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "미국이라고 싸게 팔겠냐?"
    } ]
  }, {
    "tStartMs": 483880,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "세계 최대 산유국은 맞아요"
    } ]
  }, {
    "tStartMs": 485470,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "그리고 본인들은"
    } ]
  }, {
    "tStartMs": 486150,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "별로 타격을 안 받을 수도 있지"
    } ]
  }, {
    "tStartMs": 487940,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "하지만 석유 가격이 안 오르겠냐?"
    } ]
  }, {
    "tStartMs": 489580,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "기업 입장에서"
    } ]
  }, {
    "tStartMs": 491690,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "연말에 팔면 40%, 50% 올랐는데"
    } ]
  }, {
    "tStartMs": 494090,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "미국이니까 50% 싸게 해줄까?"
    } ]
  }, {
    "tStartMs": 496450,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "라는 걸 생각해보면"
    } ]
  }, {
    "tStartMs": 497920,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "그렇지 않다는 걸 알 수 있죠"
    } ]
  }, {
    "tStartMs": 499380,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "지금 현재 미국 휘발유 가격이"
    } ]
  }, {
    "tStartMs": 500830,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "약 40%가 올랐습니다"
    } ]
  }, {
    "tStartMs": 502950,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "평균이 지금 갤런당 4달러를"
    } ]
  }, {
    "tStartMs": 505160,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "넘어가려고 하고 있는데"
    } ]
  }, {
    "tStartMs": 506570,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "미국 서부주들 기준으로는"
    } ]
  }, {
    "tStartMs": 508400,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "갤런당 5달러를 넘어갔고"
    } ]
  }, {
    "tStartMs": 510370,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "미국 서부가 제일 비쌉니다"
    } ]
  }, {
    "tStartMs": 511810,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "캘리포니아에서는 평균 갤런당"
    } ]
  }, {
    "tStartMs": 513790,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "5.79달러라고 해요"
    } ]
  }, {
    "tStartMs": 515970,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "물론 저 미국이란 나라는"
    } ]
  }, {
    "tStartMs": 518640,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "죄송한 표현인데"
    } ]
  }, {
    "tStartMs": 519390,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "막대 먹은 도량형을 쓰기 때문에"
    } ]
  }, {
    "tStartMs": 521750,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "이렇게만 들으면"
    } ]
  }, {
    "tStartMs": 522640,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "도대체 알기가 힘들어요"
    } ]
  }, {
    "tStartMs": 524190,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "리터로 하자!"
    } ]
  }, {
    "tStartMs": 525920,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "아니 무슨 뭐 야드 피트에"
    } ]
  }, {
    "tStartMs": 527670,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "무슨 뭐 갤런에 아주"
    } ]
  }, {
    "tStartMs": 529920,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "파인트에 하프 갤런"
    } ]
  }, {
    "tStartMs": 531830,
    "dDurationMs": 650,
    "segs": [ {
      "utf8": "아 하프 갤런이라"
    } ]
  }, {
    "tStartMs": 532480,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "그러면 대충 감이 옵니다"
    } ]
  }, {
    "tStartMs": 533700,
    "dDurationMs": 390,
    "segs": [ {
      "utf8": "그러네"
    } ]
  }, {
    "tStartMs": 534090,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "베스킨라빈스 생각하십시오"
    } ]
  }, {
    "tStartMs": 535750,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "어, 갑자기 감이 확 와"
    } ]
  }, {
    "tStartMs": 537650,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "그거? 파인트?"
    } ]
  }, {
    "tStartMs": 539360,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "어, 하프?"
    } ]
  }, {
    "tStartMs": 540670,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "그래요 그거"
    } ]
  }, {
    "tStartMs": 541730,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "그거 생각하시면 됩니다"
    } ]
  }, {
    "tStartMs": 543020,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "아, 바로 느낌 온다 그러네"
    } ]
  }, {
    "tStartMs": 545050,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "우리도 조금 쓰니까"
    } ]
  }, {
    "tStartMs": 545880,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "바로 알겠네"
    } ]
  }, {
    "tStartMs": 547140,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "되게 익숙한 거일 수도 있습니다"
    } ]
  }, {
    "tStartMs": 549210,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "베스킨라빈스 받는 그 컵으로"
    } ]
  }, {
    "tStartMs": 550600,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "좀 생각하시면은"
    } ]
  }, {
    "tStartMs": 551780,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "딱 그 와닿을 수 있어요"
    } ]
  }, {
    "tStartMs": 552780,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "자, 그거가 이제 2배 되면은"
    } ]
  }, {
    "tStartMs": 555100,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "5.79달러를 겁니다"
    } ]
  }, {
    "tStartMs": 556500,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "5.79달러"
    } ]
  }, {
    "tStartMs": 557570,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "넘어가고 있죠"
    } ]
  }, {
    "tStartMs": 559010,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "미국인들의 고통도 점점 심해지고 있는데"
    } ]
  }, {
    "tStartMs": 561680,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "JD벤슨 미국 부통령이"
    } ]
  }, {
    "tStartMs": 563380,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "바로 며칠 전에 인터뷰를 했습니다"
    } ]
  }, {
    "tStartMs": 564880,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 565660,
    "dDurationMs": 580,
    "segs": [ {
      "utf8": "앞으로 미국은"
    } ]
  }, {
    "tStartMs": 566240,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "휘발유 가격 안정관리를 위해서"
    } ]
  }, {
    "tStartMs": 567250,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "곧 대책 발표를 하겠습니다"
    } ]
  }, {
    "tStartMs": 568930,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "우리는 휘발유 가격을 낮추기 위해서"
    } ]
  }, {
    "tStartMs": 570140,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "모든 노력을 다 하고 있습니다"
    } ]
  }, {
    "tStartMs": 571600,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "24시간, 48시간 내에"
    } ]
  }, {
    "tStartMs": 573540,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "몇 가지 발표를 할 예정입니다"
    } ]
  }, {
    "tStartMs": 575100,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "하지만 그럼에도 불구하고"
    } ]
  }, {
    "tStartMs": 577910,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "좀 참으십시오"
    } ]
  }, {
    "tStartMs": 580320,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "지금 우리가 말이야"
    } ]
  }, {
    "tStartMs": 581420,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "핵무기 개발한"
    } ]
  }, {
    "tStartMs": 582310,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "세계 악의 축의 국가를"
    } ]
  }, {
    "tStartMs": 583840,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "떼찌 떼찌 하고 있는데"
    } ]
  }, {
    "tStartMs": 585660,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "휘발유 조금 올랐다고"
    } ]
  }, {
    "tStartMs": 586850,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "징징대는 거, 좀 참아"
    } ]
  }, {
    "tStartMs": 589360,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "몇 주 동안은 험난한 시기가 될 거야"
    } ]
  }, {
    "tStartMs": 591850,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "우리는 정의의 사도인데"
    } ]
  }, {
    "tStartMs": 593580,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "정의가 이게 되지 않겠습니까?"
    } ]
  }, {
    "tStartMs": 595070,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "그리고 좀만 참아"
    } ]
  }, {
    "tStartMs": 596140,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "왜냐하면"
    } ]
  }, {
    "tStartMs": 597100,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "일시적이기 때문이야"
    } ]
  }, {
    "tStartMs": 599290,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "템퍼러리"
    } ]
  }, {
    "tStartMs": 600390,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "그게 영구적이 아니야"
    } ]
  }, {
    "tStartMs": 601630,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "일시적이니까 전쟁 끝나면 내려오겠지"
    } ]
  }, {
    "tStartMs": 604320,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "그럼 참으면 되지"
    } ]
  }, {
    "tStartMs": 605440,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "그거 말이야"
    } ]
  }, {
    "tStartMs": 606300,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "조금만 참으십시오"
    } ]
  }, {
    "tStartMs": 607800,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "라고 얘기를 했고요"
    } ]
  }, {
    "tStartMs": 608730,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "그리고 아 근데 가격이 오르고"
    } ]
  }, {
    "tStartMs": 610230,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "그런데 힘들어서 어떻게 참아요?"
    } ]
  }, {
    "tStartMs": 611770,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "아, 그거?"
    } ]
  }, {
    "tStartMs": 612800,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "그렇다면"
    } ]
  }, {
    "tStartMs": 614220,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "옆 동맹국들을 보면서 참으세요"
    } ]
  }, {
    "tStartMs": 616810,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "실제로 한 얘기입니다"
    } ]
  }, {
    "tStartMs": 617540,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "여기 아래는"
    } ]
  }, {
    "tStartMs": 618500,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "무슨 말입니까?"
    } ]
  }, {
    "tStartMs": 619260,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "솔직히 말해서"
    } ]
  }, {
    "tStartMs": 620460,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "동맹국들은 우리보다 더 큰 고통을 겪고 있습니다"
    } ]
  }, {
    "tStartMs": 623850,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "여러분들은 행복한지 아셔야 돼요"
    } ]
  }, {
    "tStartMs": 625730,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "우리는 파라다이스야"
    } ]
  }, {
    "tStartMs": 627280,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "난리 났어"
    } ]
  }, {
    "tStartMs": 628090,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "저기 태평양 건너"
    } ]
  }, {
    "tStartMs": 630440,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "꼬레* 동맹국가"
    } ]
  }, {
    "tStartMs": 632540,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "재* 동맹국들은 난리 났고"
    } ]
  }, {
    "tStartMs": 634740,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "지금 호르무즈 해협 막아서"
    } ]
  }, {
    "tStartMs": 636080,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "아시안 난리 났다"
    } ]
  }, {
    "tStartMs": 637860,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "여러분들은 지금 이 정도면은 참을 수 있지"
    } ]
  }, {
    "tStartMs": 641060,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "옆에 동맹국들을 보면서"
    } ]
  }, {
    "tStartMs": 642410,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "조금 참아도 된지 않나 생각합니다"
    } ]
  }, {
    "tStartMs": 643940,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "그들은 훨씬 더 큰 고통을 겪고 있거든요"
    } ]
  }, {
    "tStartMs": 646710,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "게다가 미국은"
    } ]
  }, {
    "tStartMs": 647830,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "트럼프 대통령의 영도 안에서"
    } ]
  }, {
    "tStartMs": 649540,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "녹색 에너지"
    } ]
  }, {
    "tStartMs": 651070,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "이런 거 안 했죠?"
    } ]
  }, {
    "tStartMs": 651870,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "그린 스캠"
    } ]
  }, {
    "tStartMs": 652850,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "이런 거에 속지 않았어"
    } ]
  }, {
    "tStartMs": 653980,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "우리는 석유 캐고 다 이렇게 했기 때문에"
    } ]
  }, {
    "tStartMs": 656540,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "화석연료 올인"
    } ]
  }, {
    "tStartMs": 657860,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "뭐 그런 거를 해서"
    } ]
  }, {
    "tStartMs": 658740,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "훨씬 낫지 않느냐"
    } ]
  }, {
    "tStartMs": 660060,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "저 녹색 에너지 그런 거"
    } ]
  }, {
    "tStartMs": 661340,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "투자했던 유럽 애들 봐라"
    } ]
  }, {
    "tStartMs": 662770,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "지금 갔다"
    } ]
  }, {
    "tStartMs": 663710,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "지금 걔들"
    } ]
  }, {
    "tStartMs": 664760,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "굿바이 마이 프렌드 중이야 그쵸?"
    } ]
  }, {
    "tStartMs": 666610,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "그러다 보니까"
    } ]
  }, {
    "tStartMs": 667600,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "미국인들은 훨씬 더"
    } ]
  }, {
    "tStartMs": 668770,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "행복하지 않냐"
    } ]
  }, {
    "tStartMs": 669600,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "조금만 참으십시오라고 얘기를 했어요"
    } ]
  }, {
    "tStartMs": 671890,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "이 인터뷰를 한 다음에"
    } ]
  }, {
    "tStartMs": 673560,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "조금 죄송한 표현인데"
    } ]
  }, {
    "tStartMs": 675300,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "정말 욕을 많이 드셨습니다"
    } ]
  }, {
    "tStartMs": 677160,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "이 인터뷰를 한 다음에"
    } ]
  }, {
    "tStartMs": 678710,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "솔직히 우리 입장에서는 좀 그렇잖아"
    } ]
  }, {
    "tStartMs": 681010,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "옆이 더 큰 고통을 겪고 있으니까"
    } ]
  }, {
    "tStartMs": 683060,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "어디 템포러리한 거 좀 참아라"
    } ]
  }, {
    "tStartMs": 684550,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "이런 말이니까"
    } ]
  }, {
    "tStartMs": 685170,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "이 얘기한 다음에"
    } ]
  }, {
    "tStartMs": 686130,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "비판을 엄청 받긴 했어요"
    } ]
  }, {
    "tStartMs": 687550,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "하지만 미국이"
    } ]
  }, {
    "tStartMs": 688870,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "누가 비판한다고 듣지도 않죠"
    } ]
  }, {
    "tStartMs": 690510,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "듣지도 않기 때문에"
    } ]
  }, {
    "tStartMs": 691660,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "별 문제 없이"
    } ]
  }, {
    "tStartMs": 692590,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "넘어갔다는 생각이 되고"
    } ]
  }, {
    "tStartMs": 693890,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "그리고 벤스 부통령의 말처럼"
    } ]
  }, {
    "tStartMs": 695560,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "지금 미국은 아직은"
    } ]
  }, {
    "tStartMs": 697060,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "낮은 물가 수준을 유지하고 있어요"
    } ]
  }, {
    "tStartMs": 698560,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "물론 전쟁으로 인한 물가가"
    } ]
  }, {
    "tStartMs": 700660,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "아직 반영이 되지 않았죠"
    } ]
  }, {
    "tStartMs": 702270,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "3월 물가, 4월 물가 나중에 나와봐야겠죠"
    } ]
  }, {
    "tStartMs": 704050,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "지금 당장은"
    } ]
  }, {
    "tStartMs": 704980,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "물가 수준이 낮은데"
    } ]
  }, {
    "tStartMs": 706090,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "고민이 하나 있습니다 미국도"
    } ]
  }, {
    "tStartMs": 707400,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "우리나라도 마찬가지로 고민이에요"
    } ]
  }, {
    "tStartMs": 709550,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "금리는 내려야 합니까?"
    } ]
  }, {
    "tStartMs": 711250,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "올려야 합니까?"
    } ]
  }, {
    "tStartMs": 712440,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "지금 상황에서"
    } ]
  }, {
    "tStartMs": 714080,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "지금까지 기준 금리는"
    } ]
  }, {
    "tStartMs": 715940,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "동결이거나 인하였어요"
    } ]
  }, {
    "tStartMs": 718530,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "그런데 지금 보세요"
    } ]
  }, {
    "tStartMs": 720340,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "물가가 오를 수 있다며"
    } ]
  }, {
    "tStartMs": 721790,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "원유 가격이 급격하게 오를 수 있잖아요"
    } ]
  }, {
    "tStartMs": 723990,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "경기가 위축될 수 있습니다"
    } ]
  }, {
    "tStartMs": 725450,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "원유가 없으면"
    } ]
  }, {
    "tStartMs": 726300,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "농사도 어렵고"
    } ]
  }, {
    "tStartMs": 727560,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "제조업도 어렵고 다 어렵잖아요"
    } ]
  }, {
    "tStartMs": 729120,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "결론적으로 물가도 상승하고"
    } ]
  }, {
    "tStartMs": 730880,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "경기도 위축되는"
    } ]
  }, {
    "tStartMs": 732160,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "이런 일이 일어날 수 있습니다"
    } ]
  }, {
    "tStartMs": 733510,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "보통은 경기가 좋으면"
    } ]
  }, {
    "tStartMs": 734490,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "물가가 오르거나 경기가 위축되면"
    } ]
  }, {
    "tStartMs": 736270,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "물가가 내려가요"
    } ]
  }, {
    "tStartMs": 737380,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "근데 그런 상황에 깨지고"
    } ]
  }, {
    "tStartMs": 739060,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "물가가 상승하고 경기가 위축되면"
    } ]
  }, {
    "tStartMs": 740430,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "이게 뭡니까?"
    } ]
  }, {
    "tStartMs": 741700,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "예전에 많이 나왔던 스태그플레이션이죠"
    } ]
  }, {
    "tStartMs": 744260,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "유가 공급으로 인한 거기 때문에"
    } ]
  }, {
    "tStartMs": 745590,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "소위 공급발 스태그플레이션입니다"
    } ]
  }, {
    "tStartMs": 747660,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "그러면 물가가 올라요"
    } ]
  }, {
    "tStartMs": 749580,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "금리를 올려야 되나요?"
    } ]
  }, {
    "tStartMs": 750940,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "그럼 경기가 안 좋아질 거 아니야"
    } ]
  }, {
    "tStartMs": 752400,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "가뜩이나 경기가 위축되는데"
    } ]
  }, {
    "tStartMs": 753560,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "경기가 더 안 좋아져요"
    } ]
  }, {
    "tStartMs": 754630,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "그럼 경기가 위축되니까"
    } ]
  }, {
    "tStartMs": 755680,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "금리를 내려야 되나?"
    } ]
  }, {
    "tStartMs": 756740,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "근데 물가가 오르는데"
    } ]
  }, {
    "tStartMs": 758440,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "금리를 내리면"
    } ]
  }, {
    "tStartMs": 759300,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "물가가 더 올라요"
    } ]
  }, {
    "tStartMs": 760190,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "자, 이거 어떻게 해야 됩니까? 자,"
    } ]
  }, {
    "tStartMs": 762060,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "이 문제가"
    } ]
  }, {
    "tStartMs": 763670,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "최근에 거의 모든 나라에서"
    } ]
  }, {
    "tStartMs": 765600,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "동시다발적으로 생기고 있는데"
    } ]
  }, {
    "tStartMs": 767620,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "금리를 내려야 되냐, 올려야 되냐"
    } ]
  }, {
    "tStartMs": 770180,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "물론 트럼프 대통령은"
    } ]
  }, {
    "tStartMs": 771980,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "금리를 내려야 된다고 얘기하고 있습니다"
    } ]
  }, {
    "tStartMs": 774640,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 775680,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "제롬 파월 연준 의장"
    } ]
  }, {
    "tStartMs": 776980,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "항상 너무 늦는데"
    } ]
  }, {
    "tStartMs": 778430,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "오늘 어디에 있습니까?"
    } ]
  }, {
    "tStartMs": 780420,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "다음 회의까지 기다릴 것이 아니라"
    } ]
  }, {
    "tStartMs": 781990,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "지금 당장 금리를 인하해야 된다"
    } ]
  }, {
    "tStartMs": 785100,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "라고 얘기를 했죠"
    } ]
  }, {
    "tStartMs": 786200,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "물론 미 연준은"
    } ]
  }, {
    "tStartMs": 787550,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "지난주에"
    } ]
  }, {
    "tStartMs": 788240,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "3월 금리를 동결했습니다"
    } ]
  }, {
    "tStartMs": 790930,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "요즘 사이가 안 좋죠"
    } ]
  }, {
    "tStartMs": 791890,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "연준과 트럼프 대통령은"
    } ]
  }, {
    "tStartMs": 793070,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "원래 사이가 별로 안 좋았기 때문에"
    } ]
  }, {
    "tStartMs": 794820,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "FOMC는 찬성 11표"
    } ]
  }, {
    "tStartMs": 796110,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "반대 1표로 기준금리를 동결했습니다"
    } ]
  }, {
    "tStartMs": 799340,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "대신에 올해 인플레이션 전망치는"
    } ]
  }, {
    "tStartMs": 801310,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "2.4에서 2.7로 꽤 많이 올렸어요"
    } ]
  }, {
    "tStartMs": 803900,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "불안하죠"
    } ]
  }, {
    "tStartMs": 804900,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "유가도 그렇고 관세도 그렇고"
    } ]
  }, {
    "tStartMs": 806610,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "불안하기 때문에"
    } ]
  }, {
    "tStartMs": 807270,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "인플레이션 전망치는 꽤 많이 올렸는데"
    } ]
  }, {
    "tStartMs": 809500,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "만장일치 동결이 안 나온 거는"
    } ]
  }, {
    "tStartMs": 811280,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "다 이유가 있습니다"
    } ]
  }, {
    "tStartMs": 812240,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "인하가 한 명이 나왔다는 건데"
    } ]
  }, {
    "tStartMs": 814030,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "누가 인하냐"
    } ]
  }, {
    "tStartMs": 815280,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "옛날 트럼프 대통령의"
    } ]
  }, {
    "tStartMs": 816380,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "오른팔로 불렸던"
    } ]
  }, {
    "tStartMs": 817750,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "스티브 마이런 이사"
    } ]
  }, {
    "tStartMs": 819480,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "인하를 요구하며 반대표를 던졌는데"
    } ]
  }, {
    "tStartMs": 821340,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "그러니까 인하표를 던졌는데"
    } ]
  }, {
    "tStartMs": 823900,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "개인적으로는 이런 상황에서"
    } ]
  }, {
    "tStartMs": 825440,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "인하의 표를 던진 걸 보면"
    } ]
  }, {
    "tStartMs": 827930,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "음... 약간 오른팔이어도"
    } ]
  }, {
    "tStartMs": 830470,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "너무 오른팔이 아닌 게 아닌가"
    } ]
  }, {
    "tStartMs": 832270,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "라는 생각을 잠깐 개인적으로 하긴 하는데"
    } ]
  }, {
    "tStartMs": 834730,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "파월 의장은 이번에 FOMC에서"
    } ]
  }, {
    "tStartMs": 836110,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 837410,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "경제에 미칠 영향의 범위와"
    } ]
  }, {
    "tStartMs": 839720,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "지속기간을 파악하기 너무 이르다"
    } ]
  }, {
    "tStartMs": 841730,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "아무도 모른다"
    } ]
  }, {
    "tStartMs": 843010,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "제가 정말 강조하고 싶은 점은"
    } ]
  }, {
    "tStartMs": 844440,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "앞으로 어떻게 흘러갈지"
    } ]
  }, {
    "tStartMs": 845910,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "아무도 모른다는 거고"
    } ]
  }, {
    "tStartMs": 847620,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "특히 공급발 인플레이션"
    } ]
  }, {
    "tStartMs": 849580,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "이런 게 발생할 때"
    } ]
  }, {
    "tStartMs": 850930,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "중앙은행이 뭐를 할 수 있냐"
    } ]
  }, {
    "tStartMs": 853460,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "이게 아까 말한"
    } ]
  }, {
    "tStartMs": 854930,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "공급발 스태그플레이션이 발생할 때"
    } ]
  }, {
    "tStartMs": 857410,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "중앙은행이 할 수 있는 역할은"
    } ]
  }, {
    "tStartMs": 859010,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "제가 배우기에 굉장히 제한적입니다"
    } ]
  }, {
    "tStartMs": 861320,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "아니 뭐 중앙은행이 금리를 올린다고 해서"
    } ]
  }, {
    "tStartMs": 863140,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "유가 공급이 늘어나지는 않을 거예요"
    } ]
  }, {
    "tStartMs": 865340,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "그렇다고 금리를 올리면"
    } ]
  }, {
    "tStartMs": 866480,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "경기가 더 나빠지고"
    } ]
  }, {
    "tStartMs": 867740,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "금리하고는 사실"
    } ]
  }, {
    "tStartMs": 869060,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "크게 관계가 없을 수 있으니까"
    } ]
  }, {
    "tStartMs": 870390,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "이게 수요의 원인이 아니잖아요"
    } ]
  }, {
    "tStartMs": 872190,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "그러니까 할 게 굉장히"
    } ]
  }, {
    "tStartMs": 873510,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "막혀있는 상황이고"
    } ]
  }, {
    "tStartMs": 875100,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "이번에 파월 의장이 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 877530,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "만약에 어떤 이란 전쟁이나"
    } ]
  }, {
    "tStartMs": 879150,
    "dDurationMs": 370,
    "segs": [ {
      "utf8": "이런 데서"
    } ]
  }, {
    "tStartMs": 879520,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "물가에 대한 진전이 보이지 않는다면"
    } ]
  }, {
    "tStartMs": 881540,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "금리 인하는 없을 것이다"
    } ]
  }, {
    "tStartMs": 883170,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "이제 곧 은퇴하십니다"
    } ]
  }, {
    "tStartMs": 886010,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "의장에서 내려오시죠"
    } ]
  }, {
    "tStartMs": 886990,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "퇴임을 하시는데"
    } ]
  }, {
    "tStartMs": 888250,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "지금 대통령이고, 누구고"
    } ]
  }, {
    "tStartMs": 889810,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "눈치 볼 게 아니지"
    } ]
  }, {
    "tStartMs": 890510,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "어차피 나갈 분이야"
    } ]
  }, {
    "tStartMs": 892180,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "세계에서 가장 무서운 분이"
    } ]
  }, {
    "tStartMs": 894080,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "곧 나가시는 분입니다"
    } ]
  }, {
    "tStartMs": 895420,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "뭐 어쩌라고? 누구야?"
    } ]
  }, {
    "tStartMs": 897090,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "뭐 누군데? 어쩌라고?"
    } ]
  }, {
    "tStartMs": 898370,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "뭐 이런 거기 때문에"
    } ]
  }, {
    "tStartMs": 899720,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "지금 뭐 바꾸 없는 모습을 보이고 계시고요"
    } ]
  }, {
    "tStartMs": 901740,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "그리고 물가 우려가 생기니까"
    } ]
  }, {
    "tStartMs": 903520,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "미국 국채금리가 최근에 급등하고 있습니다"
    } ]
  }, {
    "tStartMs": 906970,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "미국 국채금리가"
    } ]
  }, {
    "tStartMs": 907870,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "기준금리가 쭉 인하되고"
    } ]
  }, {
    "tStartMs": 909140,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "기준금리 인하 기대감이 있었기 때문에"
    } ]
  }, {
    "tStartMs": 911320,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "그동안 쭉 국채금리가 내려왔어요"
    } ]
  }, {
    "tStartMs": 913920,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "근데 최근에 물가 우려가 생기잖아요"
    } ]
  }, {
    "tStartMs": 915880,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "뭐 원유, 유가 올라가고"
    } ]
  }, {
    "tStartMs": 917700,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "뭐 이것저것 다 스태그플레이즈 우려되고"
    } ]
  }, {
    "tStartMs": 919830,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "당연히 기준금리 인하감이 무너지죠"
    } ]
  }, {
    "tStartMs": 922110,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "그럼 미국 국채금리가 급등합니다"
    } ]
  }, {
    "tStartMs": 923950,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "이게 단기불인데"
    } ]
  }, {
    "tStartMs": 924780,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "3년짜리인데"
    } ]
  }, {
    "tStartMs": 925780,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "3.4% 하던 게"
    } ]
  }, {
    "tStartMs": 926800,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "3.94%까지 찍었어요"
    } ]
  }, {
    "tStartMs": 929520,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "미국 단기채가"
    } ]
  }, {
    "tStartMs": 930650,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "60%p 가까이가 단기간에"
    } ]
  }, {
    "tStartMs": 932660,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "금리가 급등했다는 거고"
    } ]
  }, {
    "tStartMs": 934420,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "당장 다음번 FOMC에서"
    } ]
  }, {
    "tStartMs": 936600,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "인하 기대감은 아예"
    } ]
  }, {
    "tStartMs": 938300,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "표에 없습니다"
    } ]
  }, {
    "tStartMs": 939090,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "이 왼쪽에 있는 게 뭐냐면"
    } ]
  }, {
    "tStartMs": 940080,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "우리가 패드워치라고 부르죠"
    } ]
  }, {
    "tStartMs": 941690,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "다음번 FOMC에서"
    } ]
  }, {
    "tStartMs": 943070,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "동결할 거냐 인상할 거냐"
    } ]
  }, {
    "tStartMs": 944930,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "인하할 거냐 하는 거를"
    } ]
  }, {
    "tStartMs": 945890,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "가능성을 정확히 말하면"
    } ]
  }, {
    "tStartMs": 947700,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "금리 선물에 있는 커브를 계산해서"
    } ]
  }, {
    "tStartMs": 950050,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "퍼센트를 표시해주는 건데"
    } ]
  }, {
    "tStartMs": 951770,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "인하를 기대하는 건 없습니다"
    } ]
  }, {
    "tStartMs": 954430,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "시장에서"
    } ]
  }, {
    "tStartMs": 955390,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "인상이 등장을 했어요"
    } ]
  }, {
    "tStartMs": 957220,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "한마디로 기존에는"
    } ]
  }, {
    "tStartMs": 958870,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "기준금리가 동결이냐 인하냐에서 결정을 했는데"
    } ]
  }, {
    "tStartMs": 961530,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "이제는 동결이냐 인상이냐로 바뀌었다는 거죠"
    } ]
  }, {
    "tStartMs": 965650,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "그래서 이걸 다른 말로 하면"
    } ]
  }, {
    "tStartMs": 967240,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "기준금리 인하 기대가"
    } ]
  }, {
    "tStartMs": 968610,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "소멸이 됐단 말이고"
    } ]
  }, {
    "tStartMs": 970120,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "결론적으로 제가 드리고 싶은 말은"
    } ]
  }, {
    "tStartMs": 972670,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "그래서 그런지 몰라도"
    } ]
  }, {
    "tStartMs": 974210,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "순식간에 미국 주식시장이..."
    } ]
  }, {
    "tStartMs": 978190,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "자, 여기서부터 중요합니다"
    } ]
  }, {
    "tStartMs": 980100,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "남 얘기가 아니에요"
    } ]
  }, {
    "tStartMs": 981030,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "남 얘기가"
    } ]
  }, {
    "tStartMs": 983080,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "이게 느낌이..."
    } ]
  }, {
    "tStartMs": 985260,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "왠지 이렇게..."
    } ]
  }, {
    "tStartMs": 986690,
    "dDurationMs": 3610,
    "segs": [ {
      "utf8": "느낌이 안 좋아, 느낌이"
    } ]
  }, {
    "tStartMs": 990300,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "전쟁과 물가에 이어서"
    } ]
  }, {
    "tStartMs": 992920,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "금리 인하 기대감도 소멸되고 있는 상황이죠"
    } ]
  }, {
    "tStartMs": 995230,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "물론 파월 의장의 임기가"
    } ]
  }, {
    "tStartMs": 997120,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "얼마 안 남았고"
    } ]
  }, {
    "tStartMs": 998240,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "새롭게 트럼프가 임명한"
    } ]
  }, {
    "tStartMs": 1000510,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "워시가 의장이 되면은"
    } ]
  }, {
    "tStartMs": 1002240,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "기준금리 인하를 갑자기 할지는 모르겠는데"
    } ]
  }, {
    "tStartMs": 1004670,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "마치 저 마이런 이사처럼"
    } ]
  }, {
    "tStartMs": 1006410,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "뭐 그런게 아니라면"
    } ]
  }, {
    "tStartMs": 1007290,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "금리 인하 기대감이 소멸하고"
    } ]
  }, {
    "tStartMs": 1008660,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "미국채 금리가"
    } ]
  }, {
    "tStartMs": 1009820,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "오르고 있고"
    } ]
  }, {
    "tStartMs": 1010320,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "이란전쟁이 만약에 장기화되면은"
    } ]
  }, {
    "tStartMs": 1012880,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "야 이 나스.. 아... 대단히 중요한 문제입니다"
    } ]
  }, {
    "tStartMs": 1017220,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "왜냐하면은 제가 급하기 때문에"
    } ]
  }, {
    "tStartMs": 1019600,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "대단히 중요한 문제예요"
    } ]
  }, {
    "tStartMs": 1020860,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "남 얘기가 아니라"
    } ]
  }, {
    "tStartMs": 1021890,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "제 얘기이기 때문에"
    } ]
  }, {
    "tStartMs": 1022930,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "야, 니가 이러면 안되지"
    } ]
  }, {
    "tStartMs": 1025300,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "제가 이 자료 만들면서"
    } ]
  }, {
    "tStartMs": 1026780,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "아..."
    } ]
  }, {
    "tStartMs": 1029830,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "여기를 지지선으로 하겠습니다"
    } ]
  }, {
    "tStartMs": 1031760,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "제가 방금 봤는데"
    } ]
  }, {
    "tStartMs": 1032980,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "여기를 지지선으로 하죠"
    } ]
  }, {
    "tStartMs": 1034880,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "아 이게 이렇게 보면"
    } ]
  }, {
    "tStartMs": 1037520,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "안 되죠 안 되고"
    } ]
  }, {
    "tStartMs": 1038310,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "여기를 딱 지지선으로 하고"
    } ]
  }, {
    "tStartMs": 1039940,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "여기서부터 이제 반등해야 되지 않나"
    } ]
  }, {
    "tStartMs": 1042060,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "생각하고 있죠"
    } ]
  }, {
    "tStartMs": 1043080,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "게다가 이렇게 또"
    } ]
  }, {
    "tStartMs": 1044050,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "열심히 보는 이유는"
    } ]
  }, {
    "tStartMs": 1045430,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "지금 우리의 문제는"
    } ]
  }, {
    "tStartMs": 1046600,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "나스닥이 아니죠"
    } ]
  }, {
    "tStartMs": 1048470,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "코스피가 좀 많이"
    } ]
  }, {
    "tStartMs": 1050650,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "진작 많이 밀려 놨으면"
    } ]
  }, {
    "tStartMs": 1052030,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "걱정이 좀 덜한데"
    } ]
  }, {
    "tStartMs": 1053230,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "지금 5,700-5,800 그래요"
    } ]
  }, {
    "tStartMs": 1056740,
    "dDurationMs": 3790,
    "segs": [ {
      "utf8": "어, 이게 당장 내일이죠"
    } ]
  }, {
    "tStartMs": 1060530,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "당장 내일 저게"
    } ]
  }, {
    "tStartMs": 1061630,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "얼마에 갈지가"
    } ]
  }, {
    "tStartMs": 1062470,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "일단 후덜덜 후덜덜 하고 있거든요"
    } ]
  }, {
    "tStartMs": 1064770,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "자꾸 말씀드리지만"
    } ]
  }, {
    "tStartMs": 1066370,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "제 얘기여서 그래요"
    } ]
  }, {
    "tStartMs": 1067600,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "음 실적은 좋아"
    } ]
  }, {
    "tStartMs": 1069690,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "실적은 좋기 때문에"
    } ]
  }, {
    "tStartMs": 1070790,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "실적 위주로"
    } ]
  }, {
    "tStartMs": 1071790,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "든든하게 어깨 걸고"
    } ]
  }, {
    "tStartMs": 1072790,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "버티면 되지 않을까 생각하는데"
    } ]
  }, {
    "tStartMs": 1074520,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "말은 이렇게 해도 문제 생기면"
    } ]
  }, {
    "tStartMs": 1075850,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "바로 어깨를 풀기 때문에"
    } ]
  }, {
    "tStartMs": 1077360,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "굉장히 가슴 떨리는 순간이라고 할 수 있고"
    } ]
  }, {
    "tStartMs": 1079740,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "게다가 더 큰 문제가"
    } ]
  }, {
    "tStartMs": 1081450,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "몇 번 보여드렸지만"
    } ]
  }, {
    "tStartMs": 1082880,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "2월 20일"
    } ]
  }, {
    "tStartMs": 1084190,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "전쟁 시작 직전과 지금까지"
    } ]
  }, {
    "tStartMs": 1086680,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "한 달 정도 지났죠?"
    } ]
  }, {
    "tStartMs": 1088100,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "투자자별 코스피 순매수를 보면"
    } ]
  }, {
    "tStartMs": 1090150,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "개인이 무려"
    } ]
  }, {
    "tStartMs": 1091200,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "32조를 담았습니다"
    } ]
  }, {
    "tStartMs": 1093190,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "강심장이야, 강심장"
    } ]
  }, {
    "tStartMs": 1095240,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "외국인은 28조를 팔았어요"
    } ]
  }, {
    "tStartMs": 1097740,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "기간은 뭐 있으나 마나 하고"
    } ]
  }, {
    "tStartMs": 1099470,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "개인과 외국인의 싸움인데"
    } ]
  }, {
    "tStartMs": 1102020,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "이게 느낌을 보니까"
    } ]
  }, {
    "tStartMs": 1104460,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "한마디로 2월 20일 언저리니까"
    } ]
  }, {
    "tStartMs": 1106930,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "여기 언저리부터"
    } ]
  }, {
    "tStartMs": 1108170,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "오르고 빠질 때"
    } ]
  }, {
    "tStartMs": 1109150,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "개인이 집중적으로"
    } ]
  }, {
    "tStartMs": 1110380,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "저가 매수를 했습니다"
    } ]
  }, {
    "tStartMs": 1112340,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "얼마를?"
    } ]
  }, {
    "tStartMs": 1113380,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "32조"
    } ]
  }, {
    "tStartMs": 1116700,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "지금 이런 상황이야, 이런 상황"
    } ]
  }, {
    "tStartMs": 1118400,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "이런 상황이고"
    } ]
  }, {
    "tStartMs": 1119130,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "특히 우리는 뭐를 많이 샀냐"
    } ]
  }, {
    "tStartMs": 1121010,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "삼성전자, sk하이닉스를"
    } ]
  }, {
    "tStartMs": 1123150,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "개인이 20조를 순매수 했습니다"
    } ]
  }, {
    "tStartMs": 1126590,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "어, 이거는 굉장히 중요한 문제인데요"
    } ]
  }, {
    "tStartMs": 1129130,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "그 왜냐면은 저희 슈카 친구들"
    } ]
  }, {
    "tStartMs": 1130910,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "몇몇 직원분들이"
    } ]
  }, {
    "tStartMs": 1132300,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "저기에 엊그제 뭐 인생을 걸었다"
    } ]
  }, {
    "tStartMs": 1134870,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "저한테 이런 얘기를 하던데"
    } ]
  }, {
    "tStartMs": 1137600,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "그 인생을 5만원에 걸.."
    } ]
  }, {
    "tStartMs": 1138840,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "아 죄송합니다"
    } ]
  }, {
    "tStartMs": 1141500,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "아주 중요한 문제예요"
    } ]
  }, {
    "tStartMs": 1142350,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "지금 20만원대에서"
    } ]
  }, {
    "tStartMs": 1143340,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "인생을 걸었기 때문에"
    } ]
  }, {
    "tStartMs": 1145060,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "30만원, 40만원 갈 거라고 생각을 하는데"
    } ]
  }, {
    "tStartMs": 1147530,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "만에 하나"
    } ]
  }, {
    "tStartMs": 1149450,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "밀렸다가 갈 때"
    } ]
  }, {
    "tStartMs": 1150430,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "밀릴 때 손절이 안 나갈 수 있냐에"
    } ]
  }, {
    "tStartMs": 1152840,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "아주 큰 걱정이 생기죠"
    } ]
  }, {
    "tStartMs": 1154630,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "외국인은 25조 순매도"
    } ]
  }, {
    "tStartMs": 1156230,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "개인은 20조 순매수"
    } ]
  }, {
    "tStartMs": 1158220,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "전쟁 이전과 지금까지인데"
    } ]
  }, {
    "tStartMs": 1160740,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "굉장히 중요한 순간이라고 할 수 있고"
    } ]
  }, {
    "tStartMs": 1162540,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "이걸 차트로 한번 보여드리면"
    } ]
  }, {
    "tStartMs": 1164600,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "특히 우리는"
    } ]
  }, {
    "tStartMs": 1165700,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "언제 많이 샀냐"
    } ]
  }, {
    "tStartMs": 1166640,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "고점 찍고 전쟁으로 쭉"
    } ]
  }, {
    "tStartMs": 1168990,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "밀릴 때 개인이 많이 담았어요"
    } ]
  }, {
    "tStartMs": 1170940,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "삼성전자, SK하이닉스"
    } ]
  }, {
    "tStartMs": 1171980,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "거의 20조를 담았습니다"
    } ]
  }, {
    "tStartMs": 1173710,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "그리고 최근에 이렇게 조금 반등할 때"
    } ]
  }, {
    "tStartMs": 1176360,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "많이 안 줄였어요"
    } ]
  }, {
    "tStartMs": 1177880,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "아직도 2월 20일부터"
    } ]
  }, {
    "tStartMs": 1179200,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "지금까지 한 달 동안"
    } ]
  }, {
    "tStartMs": 1180260,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "개인의 삼성전자, SK하이닉스"
    } ]
  }, {
    "tStartMs": 1181940,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "누적 순매수가 20조입니다, 20조"
    } ]
  }, {
    "tStartMs": 1184350,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "간당간당한 상황이라고 할 수 있고"
    } ]
  }, {
    "tStartMs": 1187610,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "물론 우리"
    } ]
  }, {
    "tStartMs": 1189630,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "반도체 추정 실적은"
    } ]
  }, {
    "tStartMs": 1191020,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "나날이 올라가고 있습니다"
    } ]
  }, {
    "tStartMs": 1195070,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "제 얘기여서 그래요"
    } ]
  }, {
    "tStartMs": 1196780,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "강하게 올라가고 있고요"
    } ]
  }, {
    "tStartMs": 1198970,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "게다가 4월 초에"
    } ]
  }, {
    "tStartMs": 1200180,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "1분기 실적 발표가 예정되어 있습니다"
    } ]
  }, {
    "tStartMs": 1202160,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "여러분 실적 발표는"
    } ]
  }, {
    "tStartMs": 1204100,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "봐야 되지 않을까 하는 생각이 있기 때문에"
    } ]
  }, {
    "tStartMs": 1206300,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "아마 어깨를 푸는 분이"
    } ]
  }, {
    "tStartMs": 1207520,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "많이 없을 거라고 생각을 하는데"
    } ]
  }, {
    "tStartMs": 1209580,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "4월 초까지, 4월 초가"
    } ]
  }, {
    "tStartMs": 1212000,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "아직 열흘이나 남았잖아요"
    } ]
  }, {
    "tStartMs": 1213620,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "2주 가까이 남았기 때문에"
    } ]
  }, {
    "tStartMs": 1215070,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "그 사이에 변동성이"
    } ]
  }, {
    "tStartMs": 1216600,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "좀 걱정이 많이 되죠"
    } ]
  }, {
    "tStartMs": 1218000,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "물론 우리 이런 한국 개미들을 위해서"
    } ]
  }, {
    "tStartMs": 1220630,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "3월 17일 날"
    } ]
  }, {
    "tStartMs": 1221900,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "GTC"
    } ]
  }, {
    "tStartMs": 1222720,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "엔비디아의 연례 개발자 회의에서"
    } ]
  }, {
    "tStartMs": 1225120,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "우리 젠슨 황 선생님이"
    } ]
  }, {
    "tStartMs": 1226520,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "굉장히 응원을 해주셨어요"
    } ]
  }, {
    "tStartMs": 1228100,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "대한민국을 샤라웃 해주셨습니다"
    } ]
  }, {
    "tStartMs": 1230100,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "이 GTC라는 거는"
    } ]
  }, {
    "tStartMs": 1231140,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "엔비디아 방금 말씀드렸지만"
    } ]
  }, {
    "tStartMs": 1232280,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "연례 개발자회의인데"
    } ]
  }, {
    "tStartMs": 1233270,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "엔비디아의 신제품,"
    } ]
  }, {
    "tStartMs": 1234230,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "개발, 협력, 그리고 앞으로의 실적"
    } ]
  }, {
    "tStartMs": 1236130,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "이런 거에 대해서"
    } ]
  }, {
    "tStartMs": 1236960,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "발표하는 그런 자리입니다"
    } ]
  }, {
    "tStartMs": 1239140,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "시작부터 꼬레아에 대한 사랑을"
    } ]
  }, {
    "tStartMs": 1241290,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "아주 많이 보이셨어요"
    } ]
  }, {
    "tStartMs": 1243360,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "뒤에 보이는 게"
    } ]
  }, {
    "tStartMs": 1244140,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "엔비디아하고 같이 힘을 합쳐서 한다는"
    } ]
  }, {
    "tStartMs": 1246430,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "그런 기관들이나"
    } ]
  }, {
    "tStartMs": 1247650,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "아니면 기업들을 보여주셨는데"
    } ]
  }, {
    "tStartMs": 1248890,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "카이스트, 현대차, 서울대"
    } ]
  }, {
    "tStartMs": 1250780,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "삼성, SK하이닉스"
    } ]
  }, {
    "tStartMs": 1252760,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "좋습니다"
    } ]
  }, {
    "tStartMs": 1254070,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "꼬레아 사랑해요를 크게 외쳐주셨고요"
    } ]
  }, {
    "tStartMs": 1256400,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "엔비디아의 GTC 발표를 조금만 보면"
    } ]
  }, {
    "tStartMs": 1258260,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "이런 얘기들이 나와요"
    } ]
  }, {
    "tStartMs": 1259790,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "이제 엔비디아는 추론으로 가겠습니다"
    } ]
  }, {
    "tStartMs": 1262670,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "그동안은 학습 위주의 반도체를 팔아서"
    } ]
  }, {
    "tStartMs": 1264680,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "대박이 났잖아요"
    } ]
  }, {
    "tStartMs": 1265340,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "GPU 같은 거"
    } ]
  }, {
    "tStartMs": 1266390,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "AI가 학습을 많이 했어"
    } ]
  }, {
    "tStartMs": 1267940,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "AI가 이제 생각을 해야 돼"
    } ]
  }, {
    "tStartMs": 1269670,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "추론이라는 게"
    } ]
  }, {
    "tStartMs": 1270390,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "우리 말 그대로 생각이죠"
    } ]
  }, {
    "tStartMs": 1271610,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "추론 기술의 변곡점이 도래하고 있습니다"
    } ]
  }, {
    "tStartMs": 1274170,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "학습에서 추론으로 갑니다"
    } ]
  }, {
    "tStartMs": 1275490,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "그래서 앞으로 결론적으로"
    } ]
  }, {
    "tStartMs": 1277730,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "반도체 수요는 더 증가할 겁니다"
    } ]
  }, {
    "tStartMs": 1280390,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "학습 많이 했으니까"
    } ]
  }, {
    "tStartMs": 1281400,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "이제 반도체 수요 끝난 게 아닙니까?"
    } ]
  }, {
    "tStartMs": 1282810,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "이랬더니 에헤이!"
    } ]
  }, {
    "tStartMs": 1283670,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "새로운 거 해야지"
    } ]
  }, {
    "tStartMs": 1285060,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "2페이지 해야지, 2페이지"
    } ]
  }, {
    "tStartMs": 1286560,
    "dDurationMs": 630,
    "segs": [ {
      "utf8": "지금 너희들은"
    } ]
  }, {
    "tStartMs": 1287190,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "1페이지밖에 안 했어"
    } ]
  }, {
    "tStartMs": 1288350,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "자, 레벨 2 학습 갑니다"
    } ]
  }, {
    "tStartMs": 1290450,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "추론을 해야 되기 때문에"
    } ]
  }, {
    "tStartMs": 1291620,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "반도체 수요는"
    } ]
  }, {
    "tStartMs": 1292760,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "더 늘어날 수밖에 없다"
    } ]
  }, {
    "tStartMs": 1294940,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "AI는 이제 생각해야 되고"
    } ]
  }, {
    "tStartMs": 1296290,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "생각하기 위해서는 추론을 해야죠"
    } ]
  }, {
    "tStartMs": 1298190,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "학습의 단계를 넘어섰고"
    } ]
  }, {
    "tStartMs": 1299460,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "AI 에이전트가 등장을 하니까"
    } ]
  }, {
    "tStartMs": 1300840,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "필요한 추론의 양도"
    } ]
  }, {
    "tStartMs": 1302010,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "만 배 증가했다고"
    } ]
  }, {
    "tStartMs": 1303280,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "걱정하지 마라"
    } ]
  }, {
    "tStartMs": 1304380,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "라고 얘기를 해주시긴 했는데"
    } ]
  }, {
    "tStartMs": 1306660,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "약간 불안하긴 하고요"
    } ]
  }, {
    "tStartMs": 1308040,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1309340,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "앞으로 엔비디아는"
    } ]
  }, {
    "tStartMs": 1310300,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "GPU만 잘하는 집이 아닙니다"
    } ]
  }, {
    "tStartMs": 1312250,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "이제 추론 반도체"
    } ]
  }, {
    "tStartMs": 1313720,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "추론 CPU도 맛집으로 거듭나겠습니다"
    } ]
  }, {
    "tStartMs": 1316590,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "베라 CPU 이번에 공개했고요"
    } ]
  }, {
    "tStartMs": 1319160,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "추론 반도체도 양산을 하겠다"
    } ]
  }, {
    "tStartMs": 1321920,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "AI 추론 전용 가속기"
    } ]
  }, {
    "tStartMs": 1323700,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "그록3도 공개했습니다"
    } ]
  }, {
    "tStartMs": 1325660,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "이쪽으로 이제 대박이 나야겠죠"
    } ]
  }, {
    "tStartMs": 1328120,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "참고로 그록3 같은 경우에"
    } ]
  }, {
    "tStartMs": 1330210,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "나오죠, 아래?"
    } ]
  }, {
    "tStartMs": 1331000,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "GPU는 루빈이고"
    } ]
  }, {
    "tStartMs": 1332090,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "LPU가 그록3라고 하는데"
    } ]
  }, {
    "tStartMs": 1333780,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "저게 아주 중요한 의미를 갖고 있어요"
    } ]
  }, {
    "tStartMs": 1335600,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "왜냐하면 그 발주를 넣은 곳이"
    } ]
  }, {
    "tStartMs": 1337980,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "현재까지 삼성 파운드리다라는 말이 있습니다"
    } ]
  }, {
    "tStartMs": 1342140,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "특별히 삼성에 감사를 전하고 싶습니다"
    } ]
  }, {
    "tStartMs": 1344260,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "이런 말을 했거든요"
    } ]
  }, {
    "tStartMs": 1345380,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "이 얘기를 또 드리는 이유는"
    } ]
  }, {
    "tStartMs": 1348450,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "저 젠슨황 선생님의"
    } ]
  }, {
    "tStartMs": 1349800,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "땡큐, 땡큐 덕분에"
    } ]
  }, {
    "tStartMs": 1352110,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "우리나라가 코스피가"
    } ]
  }, {
    "tStartMs": 1353300,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "그날 5%"
    } ]
  }, {
    "tStartMs": 1354090,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "삼전이 7%"
    } ]
  }, {
    "tStartMs": 1355270,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "하이닉스가 8%를 오르면서"
    } ]
  }, {
    "tStartMs": 1357440,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "또 많은"
    } ]
  }, {
    "tStartMs": 1359140,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "붕어, 잉어, 향어, 쏘가리들이"
    } ]
  }, {
    "tStartMs": 1361570,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "이걸 지금 우리가 물었거든요"

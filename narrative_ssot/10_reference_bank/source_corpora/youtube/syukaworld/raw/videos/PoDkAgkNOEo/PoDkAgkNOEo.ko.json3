  }, {
    "tStartMs": 1364470,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "여기서 물었다면"
    } ]
  }, {
    "tStartMs": 1365250,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "근데 이걸 어떻게 참아"
    } ]
  }, {
    "tStartMs": 1367330,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "이거 어떻게 참아 솔직히"
    } ]
  }, {
    "tStartMs": 1368610,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "이거 누가 봐도 팍 터는데"

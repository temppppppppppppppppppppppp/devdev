  }, {
    "tStartMs": 1392660,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "같은 회사 아닙니다"
    } ]
  }, {
    "tStartMs": 1394230,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "방금 전에 말했던 무슨 CPU에"
    } ]
  }, {
    "tStartMs": 1396630,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "그록3를 공개했다"
    } ]
  }, {
    "tStartMs": 1397680,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "그거 머스크의"

  }, {
    "tStartMs": 1398770,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "생성형 AI 기업하고는"
    } ]
  }, {
    "tStartMs": 1400520,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "스펠링이 달라요"
    } ]
  }, {
    "tStartMs": 1402110,
    "dDurationMs": 340,
    "segs": [ {
      "utf8": "다르죠"
    } ]
  }, {
    "tStartMs": 1402450,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "여긴 Q 여긴 K"
    } ]
  }, {
    "tStartMs": 1403670,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "다른 회사입니다"
    } ]
  }, {
    "tStartMs": 1405010,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "삼성과 삼정이 같냐"
    } ]
  }, {
    "tStartMs": 1407060,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "다른 회사입니다"
    } ]
  }, {
    "tStartMs": 1407900,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "다른 회사예요"
    } ]
  }, {
    "tStartMs": 1409330,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "완전히 다르죠, 완전히 관계없고"
    } ]
  }, {
    "tStartMs": 1411320,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "저 그록 앞에 있는"
    } ]
  }, {
    "tStartMs": 1412580,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "AI 반도체 회사 그록은"
    } ]
  }, {
    "tStartMs": 1414400,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "작년 12월에 엔비디아가"
    } ]
  }, {
    "tStartMs": 1416070,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "200억 달러에 인수한 회사입니다"

  }, {
    "tStartMs": 1455420,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "앞으로 2027년까지"
    } ]
  }, {
    "tStartMs": 1456860,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "AI 매출이 1조 달러로 예상된다"

  }, {
    "tStartMs": 1418160,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "지금 이것 때문에"
    } ]
  }, {
    "tStartMs": 1418780,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "독점에 걸리냐 안 걸리냐"
    } ]
  }, {
    "tStartMs": 1420400,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "그걸로 지금 왈가왈부하고 있는데"
    } ]
  }, {
    "tStartMs": 1422710,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "저 그록이라는 회사가"
    } ]
  }, {
    "tStartMs": 1424150,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "이번에 엔비디아가 사기"

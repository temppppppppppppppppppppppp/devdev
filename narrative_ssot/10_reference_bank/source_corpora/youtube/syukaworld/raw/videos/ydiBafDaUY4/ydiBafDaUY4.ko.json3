{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 7850,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "자 여러분 안녕하세요"
    } ]
  }, {
    "tStartMs": 9020,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "자 오늘의 주제는"
    } ]
  }, {
    "tStartMs": 10340,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "무려 스페인 바르셀로나 MWC 여정기를 갖고 왔습니다"
    } ]
  }, {
    "tStartMs": 14320,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "와 자 놀랍게도"
    } ]
  }, {
    "tStartMs": 16070,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "제가 스페인 바르셀로나를 직접 갔다 왔습니다"
    } ]
  }, {
    "tStartMs": 19110,
    "dDurationMs": 3790,
    "segs": [ {
      "utf8": "이 뒤에 있는 이 성당 가우디가 만들었다는 이 성당 봤냐?"
    } ]
  }, {
    "tStartMs": 23900,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "아 그건 못 봤고요"
    } ]
  }, {
    "tStartMs": 24840,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "못 봤고요"
    } ]
  }, {
    "tStartMs": 26190,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "안타깝게 못 봤습니다"
    } ]
  }, {
    "tStartMs": 27600,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "제가 간 이유는"
    } ]
  }, {
    "tStartMs": 28480,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "3월 2일에 3월 5일까지"
    } ]
  }, {
    "tStartMs": 29980,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "스페인 바르셀로나에서 2026 MWC가 개최됩니다"
    } ]
  }, {
    "tStartMs": 34060,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "자 MWC가 뭐냐면은"
    } ]
  }, {
    "tStartMs": 35410,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "세계 최대 이동통신 전시회인"
    } ]
  }, {
    "tStartMs": 37310,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "모바일 월드 콩그레스 2026이에요"
    } ]
  }, {
    "tStartMs": 39750,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "한마디로 CES 아시죠?"
    } ]
  }, {
    "tStartMs": 41760,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "라스베가스에서 열리는 CES가"
    } ]
  }, {
    "tStartMs": 43850,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "전자기기 IT기업들의 박람회라고 그런다면"
    } ]
  }, {
    "tStartMs": 46680,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "이 MWC는 이동통신회사들 빅테크들도 옵니다"
    } ]
  }, {
    "tStartMs": 49930,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "마이크로소프트도 오고 퀄컴도 오고"
    } ]
  }, {
    "tStartMs": 52180,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "빅테크들도 다 오는데"
    } ]
  }, {
    "tStartMs": 53450,
    "dDurationMs": 4630,
    "segs": [ {
      "utf8": "이동통신회사들이 중심이 된 세계 최대 박람회라고 보실 수 있습니다"
    } ]
  }, {
    "tStartMs": 58080,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "자 그래서 사실 이 뒤에 있는"
    } ]
  }, {
    "tStartMs": 59420,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "이 가우디가 만들었다는 파밀리아 대성당에서"
    } ]
  }, {
    "tStartMs": 62350,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "그리 멀지 않은 곳에서 저 MWC가 열렸어요"
    } ]
  }, {
    "tStartMs": 65720,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "조금만 시간 있었으면 보러 갈 수 있었는데"
    } ]
  }, {
    "tStartMs": 67950,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "안타깝게도 저는 거의 당일치기로"
    } ]
  }, {
    "tStartMs": 70380,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "스페인에 갔다 왔기 때문에 가서 보지는 못했습니다"
    } ]
  }, {
    "tStartMs": 73180,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "제 일정이 15시간 걸려서"
    } ]
  }, {
    "tStartMs": 75580,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "스페인에 가서 내려서 자고 일어나서"
    } ]
  }, {
    "tStartMs": 78470,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "8시간 동안 MWC를 보고"
    } ]
  }, {
    "tStartMs": 80980,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "그날 오후에 비행기를 타고"
    } ]
  }, {
    "tStartMs": 83070,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "12시간 동안 다시 한국에 오는 스케줄이었습니다"
    } ]
  }, {
    "tStartMs": 86500,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "사실상 스페인에 8시간 숨을 쉬어 봤다"
    } ]
  }, {
    "tStartMs": 90910,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "찍먹이라고 그러죠"
    } ]
  }, {
    "tStartMs": 92000,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "8시간 찍먹을 해서"
    } ]
  }, {
    "tStartMs": 94740,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "스페인에 간 건지 정확히는 모르겠습니다"
    } ]
  }, {
    "tStartMs": 97310,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "정확히는 모르겠지만"
    } ]
  }, {
    "tStartMs": 98430,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "MWC는 굉장히 아주 주의 깊게 보고 왔습니다"
    } ]
  }, {
    "tStartMs": 102020,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "물론 MWC 얘기하기 전에"
    } ]
  }, {
    "tStartMs": 104260,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "약간 가슴 아픈 일도 있었어요"
    } ]
  }, {
    "tStartMs": 106450,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "제가 15시간 동안 비행한 다음에"
    } ]
  }, {
    "tStartMs": 109090,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "스페인에 도착하자마자 그날 저녁에 저를 초대해 주신 분들이"
    } ]
  }, {
    "tStartMs": 112830,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "우리 스페인 왔으니까 와인 한잔해야지"
    } ]
  }, {
    "tStartMs": 114670,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "그래서 저 술 잘 못하거든요"
    } ]
  }, {
    "tStartMs": 116510,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "와인 딱 한 잔 먹고 뻗었는데"
    } ]
  }, {
    "tStartMs": 118660,
    "dDurationMs": 3830,
    "segs": [ {
      "utf8": "눈 뜨자마자 코스피가 마이너스 10%더라고요"
    } ]
  }, {
    "tStartMs": 124790,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "그리고 제가 MWC를 보고 바로 출발했는데"
    } ]
  }, {
    "tStartMs": 127330,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "출발하고 돌아오는 비행기에서"
    } ]
  }, {
    "tStartMs": 130470,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "마이너스 12%더라고요"
    } ]
  }, {
    "tStartMs": 134050,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "제가 이 오른 내내 한국에 있었고"
    } ]
  }, {
    "tStartMs": 137560,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "딱 한국에 사실상 이틀 없었는데"
    } ]
  }, {
    "tStartMs": 139880,
    "dDurationMs": 3770,
    "segs": [ {
      "utf8": "없던 첫날, 없던 둘째"
    } ]
  }, {
    "tStartMs": 143650,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "날"
    } ]
  }, {
    "tStartMs": 144970,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "그래서 아 참"
    } ]
  }, {
    "tStartMs": 147840,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "그래요"
    } ]
  }, {
    "tStartMs": 148340,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "뭐 뭐 뭐 주식 빠져서 슬프긴 하지만"
    } ]
  }, {
    "tStartMs": 150610,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "제가 또 MWC를 열심히 살펴봤습니다"
    } ]
  }, {
    "tStartMs": 153470,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "MWC 얘기를 이제 본격적으로 드릴 텐데"
    } ]
  }, {
    "tStartMs": 156000,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "제가 있는 이곳이"
    } ]
  }, {
    "tStartMs": 156980,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "스페인 바르셀로나 MWC 입구입니다"
    } ]
  }, {
    "tStartMs": 159460,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "이 앞에 표를 확인하고 들어가는 입장문 같은 게 있어요"
    } ]
  }, {
    "tStartMs": 162310,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "그래서 거기서 표를 받고 들어가는데"
    } ]
  }, {
    "tStartMs": 164010,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "제가 지금 약간 외곽으로 빠졌는데"
    } ]
  }, {
    "tStartMs": 165670,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "이 앞쪽이 메인이거든요"
    } ]
  }, {
    "tStartMs": 167520,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "거기 사람들이 바글바글합니다"
    } ]
  }, {
    "tStartMs": 169110,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "저기 사람들 많을까 봐"
    } ]
  }, {
    "tStartMs": 170110,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "거의 새벽같이 왔는데도"
    } ]
  }, {
    "tStartMs": 171740,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "벌써 사람들이 있었고"
    } ]
  }, {
    "tStartMs": 173060,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "MWC가 전시회라고는 하지만"
    } ]
  }, {
    "tStartMs": 174890,
    "dDurationMs": 3530,
    "segs": [ {
      "utf8": "사실은 계약을 맺기 위한 바이어들끼리 만나는 데잖아요"
    } ]
  }, {
    "tStartMs": 178420,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "기업들이 와서 우리 이런 신기술이 있습니다"
    } ]
  }, {
    "tStartMs": 180350,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "그럼 이제 여기 와서"
    } ]
  }, {
    "tStartMs": 181690,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "계약을 체결하고 싶은 사람들하고"
    } ]
  }, {
    "tStartMs": 183090,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "계약을 체결하는 거기 때문에"
    } ]
  }, {
    "tStartMs": 184670,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "다들 양복 차림이었어요"
    } ]
  }, {
    "tStartMs": 186060,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "한마디로 비즈니스를 하는 데"
    } ]
  }, {
    "tStartMs": 187850,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "저는 저처럼 유튜버들이 많이 올 줄 알고"
    } ]
  }, {
    "tStartMs": 190450,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "굉장히 유튜버스럽게 나름 차려입고 갔는데"
    } ]
  }, {
    "tStartMs": 194200,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "다들 양복 입고 비즈니스 하고 계시더라고요"
    } ]
  }, {
    "tStartMs": 196000,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "그래서 그 틈바귀에서 찍느라고 쉽지는 않았습니다"
    } ]
  }, {
    "tStartMs": 199140,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "몇몇 사진들을 보여드리면"
    } ]
  }, {
    "tStartMs": 200940,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "영상도 보여드릴 거예요"
    } ]
  }, {
    "tStartMs": 202370,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "이게 아까 말씀드린"
    } ]
  }, {
    "tStartMs": 203840,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "MWC 입구라고 할 수 있고"
    } ]
  }, {
    "tStartMs": 205540,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "와 실제 들어가는 입구는 이렇습니다"
    } ]
  }, {
    "tStartMs": 207900,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "들어가면 들어와서 전시되어 있는 거거든요"
    } ]
  }, {
    "tStartMs": 210900,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "사람들이 바글바글해요"
    } ]
  }, {
    "tStartMs": 212880,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "게다가 정말 전 세계에서 다 와서"
    } ]
  }, {
    "tStartMs": 215260,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "인종들이 정말 다양합니다"
    } ]
  }, {
    "tStartMs": 217240,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "북유럽에서 오실 것 같은"
    } ]
  }, {
    "tStartMs": 218890,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "완전히 키 큰 백인 아저씨에서부터"
    } ]
  }, {
    "tStartMs": 221100,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "정말 스페인스러운 그런 분들 정말 많았고"
    } ]
  }, {
    "tStartMs": 223540,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "아시아 사람들도 정말 많았고 중국 분들, 일본 분들"
    } ]
  }, {
    "tStartMs": 226520,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "한국 분들, 아프리카 분들, 중동 분들"
    } ]
  }, {
    "tStartMs": 229360,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "정말 인종의 도가니탕 그 자체를 볼 수 있었습니다"
    } ]
  }, {
    "tStartMs": 232680,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "그리고 전시장 입구 들어갈 때"
    } ]
  }, {
    "tStartMs": 234190,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "특히 눈에 띄었던 건 입구부터"
    } ]
  }, {
    "tStartMs": 236380,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "삼성전자가 돈을 많이 쓴 것 같더라고요"
    } ]
  }, {
    "tStartMs": 238560,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "갤럭시 저 깃발이 앞을 쫙 도배하고 있어요"
    } ]
  }, {
    "tStartMs": 242050,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "그래서 거의 메인 스폰서급으로 도배한 게 아닌가 생각이 되고"
    } ]
  }, {
    "tStartMs": 246030,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "실제로 그 안에 삼성 갤럭시 전시실도 굉장히 많았습니다"
    } ]
  }, {
    "tStartMs": 249290,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "3번 접는다는 갤럭시 트라이폴드 이런 거에서부터"
    } ]
  }, {
    "tStartMs": 252450,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "AR기기 이런 것도 많이 전시가 돼 있었고요"
    } ]
  }, {
    "tStartMs": 254980,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "그리고 제가 인상 깊었던"
    } ]
  }, {
    "tStartMs": 256700,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "저를 초대해 준 곳은 SKT였습니다"
    } ]
  }, {
    "tStartMs": 259200,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "그래서 SK텔레콤과는 제가 뒤에 자세하게 소개시켜 드릴 텐데"
    } ]
  }, {
    "tStartMs": 262330,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "또 눈을 약간 가게 했던 전시관이 있는데"
    } ]
  }, {
    "tStartMs": 264840,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "이 소위 온디바이스 AI 칩이라는 걸 전시한 퀄컴이었습니다"
    } ]
  }, {
    "tStartMs": 268340,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "퀄컴 전시관에 가시면"
    } ]
  }, {
    "tStartMs": 269700,
    "dDurationMs": 4450,
    "segs": [ {
      "utf8": "앞에 커다란, 사람 얼굴 같은 동그란 게 이렇게 있어요"
    } ]
  }, {
    "tStartMs": 274150,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "이렇게 움직이면서 이렇게"
    } ]
  }, {
    "tStartMs": 275490,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "그래서 앞에 가면"
    } ]
  }, {
    "tStartMs": 276620,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "얘가 나를 이렇게 고개를 돌려서 쳐다봐요"
    } ]
  }, {
    "tStartMs": 279200,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "그래서 대화를 하면 답을 해 줍니다"
    } ]
  }, {
    "tStartMs": 281170,
    "dDurationMs": 4830,
    "segs": [ {
      "utf8": "그런데 놀랍게도 막 얼굴 움직이는 것 같은 그 기계가 AI 기계인데"
    } ]
  }, {
    "tStartMs": 286000,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "소위 말해 온디바이스 AI라고 그러죠"
    } ]
  }, {
    "tStartMs": 288350,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "인터넷 연결이 안 되어 있는 기계라는 겁니다"
    } ]
  }, {
    "tStartMs": 291210,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "그걸 앞에 전시해 놨어요"
    } ]
  }, {
    "tStartMs": 292810,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "그래서 그 옆에 딱 가니까"
    } ]
  }, {
    "tStartMs": 294500,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "걔가 나한테 뭐라고 얘기를 해요"
    } ]
  }, {
    "tStartMs": 295770,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "고객님 무엇을 원하십니까?"
    } ]
  }, {
    "tStartMs": 297010,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "그럼 당연히 영어로 대답해야 되는 줄 알고 떠듬떠듬"
    } ]
  }, {
    "tStartMs": 299780,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "어 뭐 Do you know 슈카월드?"
    } ]
  }, {
    "tStartMs": 301730,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "이런 거 하고 있는데"
    } ]
  }, {
    "tStartMs": 303120,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "옆에 직원이 알려 주시더라고요"
    } ]
  }, {
    "tStartMs": 304370,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "한국말로 된다고"
    } ]
  }, {
    "tStartMs": 306140,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "어 정말 놀라운 기계였습니다"
    } ]
  }, {
    "tStartMs": 307760,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "인터넷이 연결이 안 돼 있는데"
    } ]
  }, {
    "tStartMs": 309890,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "한국말을 포함해서 6개 언어가 된다고 하더라고요"
    } ]
  }, {
    "tStartMs": 312460,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "스페인어, 영어, 한국말, 중국어 등등등"
    } ]
  }, {
    "tStartMs": 315390,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "6개 언어를 다 할 수 있는"
    } ]
  }, {
    "tStartMs": 317090,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "온디바이스 AI 기계도 같이 볼 수 있었습니다"
    } ]
  }, {
    "tStartMs": 320510,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "그래서 이번 MWC 제가 느낀 거는"
    } ]
  }, {
    "tStartMs": 323240,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "물론 SK텔레콤관에서 AI에 대한 얘기를 드릴 텐데"
    } ]
  }, {
    "tStartMs": 326910,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "제가 여기에 가기 위해서 영어 특훈을 했거든요"
    } ]
  }, {
    "tStartMs": 329780,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "정말 영어를 배우고 싶죠"
    } ]
  }, {
    "tStartMs": 331490,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "영어를 두 번 배우고 싶죠"
    } ]
  }, {
    "tStartMs": 332550,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "그래서 가서 굉장히 이야기할 일이 많고"
    } ]
  }, {
    "tStartMs": 336270,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "또 저랑 같이 갔던 친구는"
    } ]
  }, {
    "tStartMs": 338080,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "옆에 앉았던 분이 자기를 또 다른 컨퍼런스에 초대도 해주셨어요"
    } ]
  }, {
    "tStartMs": 341680,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "오늘 저녁에 바르셀로나 어디에서 뭐가 오니까"
    } ]
  }, {
    "tStartMs": 344420,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "야 너도 한번 와봐라"
    } ]
  }, {
    "tStartMs": 345720,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "거기 가면 이제 뭐 VC분들, 투자하는 분들도 있고"
    } ]
  }, {
    "tStartMs": 348600,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "많은 분들이 모여서"
    } ]
  }, {
    "tStartMs": 349880,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "서로 명함 나누면서 비즈니스 하는 곳이죠"
    } ]
  }, {
    "tStartMs": 352060,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "영어 모르면 못 갑니다"
    } ]
  }, {
    "tStartMs": 353510,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "구글 앱으로 할 수도 있지 않냐?"
    } ]
  }, {
    "tStartMs": 355930,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "그렇게 할 수도 있는데"
    } ]
  }, {
    "tStartMs": 356910,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "사실 되면, 되면 너무 좋으니까"
    } ]
  }, {
    "tStartMs": 358970,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "꼭 두 번 배우십시오"
    } ]
  }, {
    "tStartMs": 360910,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "자 그러면 이제 본격적으로"
    } ]
  }, {
    "tStartMs": 362090,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "MWC 얘기를 드릴 텐데"
    } ]
  }, {
    "tStartMs": 363190,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "일단 2026 MWC 슬로건은 IQ의 시대입니다"
    } ]
  }, {
    "tStartMs": 366240,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "왜 이동통신사들의 전시회에 IQ가 나오냐?"
    } ]
  }, {
    "tStartMs": 369080,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "이제 통신은 빠른 것을 넘어서"
    } ]
  }, {
    "tStartMs": 371010,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "네트워크가 지능을 가져야 된다"
    } ]
  }, {
    "tStartMs": 373780,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "뭐 6G, 7G, 8G"
    } ]
  }, {
    "tStartMs": 376090,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "물론 그것도 있었죠 5G, 6G"
    } ]
  }, {
    "tStartMs": 377740,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "주요 주제이긴 한데"
    } ]
  }, {
    "tStartMs": 379250,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "뭐니 뭐니 해도"
    } ]
  }, {
    "tStartMs": 380080,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "이번 2026 MWC의 주제는"
    } ]
  }, {
    "tStartMs": 382100,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "역시 AI, AI, AI였습니다"
    } ]
  }, {
    "tStartMs": 385210,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "통신사들도 다 같이 AI를 하겠다"
    } ]
  }, {
    "tStartMs": 388220,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "AI가 승부다"
    } ]
  }, {
    "tStartMs": 390120,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "이 MWC는 매년 합니다"
    } ]
  }, {
    "tStartMs": 391780,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "지금 과거의 주제들을 보면"
    } ]
  }, {
    "tStartMs": 393600,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "2012년부터 2018년까지 주제는 대부분 5G, 속도"
    } ]
  }, {
    "tStartMs": 397960,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "차세대 모바일 이런 거였어요"
    } ]
  }, {
    "tStartMs": 399660,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "얼마나 빠르고 얼마나 안정적이냐가"
    } ]
  }, {
    "tStartMs": 401850,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "통신사들의 관심이었다고 보시면 되는데"
    } ]
  }, {
    "tStartMs": 404100,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "2019년부터 완전히 바뀝니다"
    } ]
  }, {
    "tStartMs": 405910,
    "dDurationMs": 4550,
    "segs": [ {
      "utf8": "그때부터 지능, 영향력, 미래 이런 말들이 나와요"
    } ]
  }, {
    "tStartMs": 410460,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "아마도 2019년 이후에"
    } ]
  }, {
    "tStartMs": 411770,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "통신사들도 완전한 IQ의 시대"
    } ]
  }, {
    "tStartMs": 414310,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "AI의 시대에 관심이 쏠렸다는 것을 알 수가 있죠"
    } ]
  }, {
    "tStartMs": 417450,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "그러면 본격적으로 MWC 영상을 보여드리기 전에"
    } ]
  }, {
    "tStartMs": 420680,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "일단 이 궁금증을 해결하고 가야 됩니다"
    } ]
  }, {
    "tStartMs": 422880,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "왜 통신기업이 AI에 올인하나?"
    } ]
  }, {
    "tStartMs": 425830,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "왜 그럴까요?"
    } ]
  }, {
    "tStartMs": 427100,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "옛날에 슈카월드에 한번 나왔습니다"
    } ]
  }, {
    "tStartMs": 428930,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "덤 파이프라는 비판을 예전 통신기업이 많이 들었어요"
    } ]
  }, {
    "tStartMs": 432450,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "덤 파이프가 뭐냐?"
    } ]
  }, {
    "tStartMs": 433650,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "우리나라 말로 하면"
    } ]
  }, {
    "tStartMs": 435330,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "속된 표현이긴 하지만"
    } ]
  }, {
    "tStartMs": 436790,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "멍청한 파이프"
    } ]
  }, {
    "tStartMs": 438230,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "어리석은 파이프죠"
    } ]
  }, {
    "tStartMs": 439630,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "우리나라 말로 하자면 어리석은 파이프"
    } ]
  }, {
    "tStartMs": 442030,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "어리석은 연결"
    } ]
  }, {
    "tStartMs": 443330,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "이런 걸 뜻합니다"
    } ]
  }, {
    "tStartMs": 444560,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "무슨 소리냐면"
    } ]
  }, {
    "tStartMs": 445550,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "이동통신 사업자가 1990년대부터 2000년대 초반에"
    } ]
  }, {
    "tStartMs": 448640,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "엄청난 돈을 들여서 망을 다 깔았죠"
    } ]
  }, {
    "tStartMs": 450720,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "그래서 PC통신 시대가 되고"
    } ]
  }, {
    "tStartMs": 452130,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "3G, 4G가 되는데"
    } ]
  }, {
    "tStartMs": 453730,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "막상 돈은 누가 벌었습니까?"
    } ]
  }, {
    "tStartMs": 455630,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "그 망을 활용한 빅테크들이 다 벌어가더라"
    } ]
  }, {
    "tStartMs": 458810,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "망을 깐 이동통신 사업자들은"
    } ]
  }, {
    "tStartMs": 460880,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "돈을 별로 못 벌고"
    } ]
  }, {
    "tStartMs": 461970,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "그 망 위에서 놀고 춤추던 빅테크들이 다 벌어가더라"
    } ]
  }, {
    "tStartMs": 465890,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "한마디로 금광으로 가는 길은 통신사들이 만들었는데"
    } ]
  }, {
    "tStartMs": 469180,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "돈은 그 길을 활용해서"
    } ]
  }, {
    "tStartMs": 470980,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "황금을 찾은 기업들이"
    } ]
  }, {
    "tStartMs": 472460,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "다 벌어갔던 쓰라린 기억이 있었죠"
    } ]
  }, {
    "tStartMs": 474670,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "그래서 통신기업을 덤 파이프"
    } ]
  }, {
    "tStartMs": 476660,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "정말 어리석은 연결을 했구나"
    } ]
  }, {
    "tStartMs": 478580,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "이런 비판을 많이 들었습니다"
    } ]
  }, {
    "tStartMs": 480880,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "그래서 통신사들이 그때부터"
    } ]
  }, {
    "tStartMs": 482060,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "아 이러면 안 되겠다"
    } ]
  }, {
    "tStartMs": 483320,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "AI 시대에는 달라야겠다"
    } ]
  }, {
    "tStartMs": 485120,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "잘 생각해보면"
    } ]
  }, {
    "tStartMs": 486200,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "통신사들은 이미 데이터센터와 네트워크를 이미 보유한 기업입니다"
    } ]
  }, {
    "tStartMs": 490540,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "AI 시대의 핵심은"
    } ]
  }, {
    "tStartMs": 491470,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "또 AI 데이터센터잖아요"
    } ]
  }, {
    "tStartMs": 493090,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "프로그램이기도 하지만"
    } ]
  }, {
    "tStartMs": 494390,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "통신사들이 생각하기에"
    } ]
  }, {
    "tStartMs": 495410,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "야 내가 유리하겠구나"
    } ]
  }, {
    "tStartMs": 497220,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "나는 이미 데이터센터가 있어"
    } ]
  }, {
    "tStartMs": 498960,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "이걸 AI 데이터센터로 확장하면 되겠구나"
    } ]
  }, {
    "tStartMs": 500970,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "나는 이미 망이 있어"
    } ]
  }, {
    "tStartMs": 502260,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "그럼 이걸 잘 활용하면"
    } ]
  }, {
    "tStartMs": 503620,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "내가 AI의 승자가 될 수 있지 않을까?"
    } ]
  }, {
    "tStartMs": 505950,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "이런 생각도 굉장히 많이 하는 거죠"
    } ]
  }, {
    "tStartMs": 507620,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "그리고 옛날과 다르게"
    } ]
  }, {
    "tStartMs": 508370,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "굉장히 수익성 있는 사업을 할 수 있겠다"
    } ]
  }, {
    "tStartMs": 511700,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "그렇다 보니까"
    } ]
  }, {
    "tStartMs": 512410,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "통신사들의 관심도 AI, AI, AI로 들어가게 된 겁니다"
    } ]
  }, {
    "tStartMs": 516160,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "그리고 우리가 또 생각해야 될 게 있는 게"
    } ]
  }, {
    "tStartMs": 518460,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "이런 궁금증이 들죠"
    } ]
  }, {
    "tStartMs": 519870,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "만약에 AI가 수익 모델을 확보하기 시작하면 어떻게 될까?"
    } ]
  }, {
    "tStartMs": 525330,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "저는 항상 주식시장을 볼 때 이 생각을 합니다"
    } ]
  }, {
    "tStartMs": 527980,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "왜냐하면 지금 우리가 반도체도 잘 되고"
    } ]
  }, {
    "tStartMs": 529720,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "전력도 잘 되고 원자력도 잘 되고"
    } ]
  }, {
    "tStartMs": 532260,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "전선 기업도 잘 되고"
    } ]
  }, {
    "tStartMs": 533450,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "우리는 소위 말해"
    } ]
  }, {
    "tStartMs": 534530,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "AI로 가는 그 길을 만드는"
    } ]
  }, {
    "tStartMs": 536100,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "뭐 곡괭이 팔고 삽 팔고 청바지 팔고 이런 걸 팔면서"
    } ]
  }, {
    "tStartMs": 539650,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "우리가 나름 대박이 났잖아요"
    } ]
  }, {
    "tStartMs": 541060,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "하지만 진짜로 만약에 AI가 금광을 발견하기 시작하면"
    } ]
  }, {
    "tStartMs": 545170,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "그때부터는 어떻게 될까?"
    } ]
  }, {
    "tStartMs": 546420,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "실제로 AI가 소프트 기업들을 대체하기 시작하고"
    } ]
  }, {
    "tStartMs": 548990,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "AI 로봇들이 인간들을 만약에 대체하기 시작하면은"
    } ]
  }, {
    "tStartMs": 551900,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "그럼 그때는 누가 돈을 벌까?"
    } ]
  }, {
    "tStartMs": 553870,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "지금처럼 곡괭이 파는 기업들만 벌까?"
    } ]
  }, {
    "tStartMs": 556500,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "그런 궁금증이 들죠"
    } ]
  }, {
    "tStartMs": 558400,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "특히 이 생각들 많이 해보셨을 겁니다"
    } ]
  }, {
    "tStartMs": 560380,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "만약 그때가 오면"
    } ]
  }, {
    "tStartMs": 561790,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "기존 기업들의 빈자리는 누가 채울까?"
    } ]
  }, {
    "tStartMs": 564820,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "기존 기업들이 AI 때문에 어려워진다며요"
    } ]
  }, {
    "tStartMs": 566780,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "그들이 없어진다고"
    } ]
  }, {
    "tStartMs": 567760,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "그들이 누리던 효용이 없어지는 건 아니죠"
    } ]
  }, {
    "tStartMs": 570110,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "그럼 누군가가 그 빈자리를 채울 텐데"
    } ]
  }, {
    "tStartMs": 571990,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "그게 누가 될까?"
    } ]
  }, {
    "tStartMs": 572760,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "소위 AI의 승자들이 될 거 아니에요"
    } ]
  }, {
    "tStartMs": 574970,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "그렇다 보니까 빅테크들이 미쳤죠"
    } ]
  }, {
    "tStartMs": 577250,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "올해 AI 인프라 투자에 투자한다는 돈이 1000조 원"
    } ]
  }, {
    "tStartMs": 580420,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "뭐 이런 소리를 하잖아요"
    } ]
  }, {
    "tStartMs": 581510,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "돈을 말 그대로 밑 빠진 독에 물 붓기처럼 쏟아 붓고 있는데"
    } ]
  }, {
    "tStartMs": 585050,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "본인들이 승자가 되면"
    } ]
  }, {
    "tStartMs": 586290,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "이 투자 끝에 승리자가 되고 싶다고 생각을 하는 거죠"
    } ]
  }, {
    "tStartMs": 589920,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "그리고 천문학적인 돈을 투자하는 빅테크들이"
    } ]
  }, {
    "tStartMs": 592750,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "사실은 AI 전에 있었던"
    } ]
  }, {
    "tStartMs": 594840,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "인터넷 혁명에서 금광을 찾은 기업들이죠"
    } ]
  }, {
    "tStartMs": 598070,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "인터넷 혁명과 스마트폰 혁명에서 승자가 됐던"
    } ]
  }, {
    "tStartMs": 601360,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "엄청난 돈을 쏟아부어서"
    } ]
  }, {
    "tStartMs": 602950,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "기존 오프라인 기업들을 죽이고 승리했던 디지털 기업이"
    } ]
  }, {
    "tStartMs": 606520,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "지금 우리가 보는 소위 빅테크들이죠"
    } ]
  }, {
    "tStartMs": 609160,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "알파벳, 메타, 아마존, 마이크로소프트"
    } ]
  }, {
    "tStartMs": 612420,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "애플 말할 필요도 없이"
    } ]
  }, {
    "tStartMs": 614220,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "그런데 이제는 디지털 기업도"
    } ]
  }, {
    "tStartMs": 616540,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "AI 시대에 가면 AI 밀린다고 하니까"
    } ]
  }, {
    "tStartMs": 619140,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "기존의 승자였던 빅테크들이"
    } ]
  }, {
    "tStartMs": 620890,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "AI 시대에도 승자가 되겠다고"
    } ]
  }, {
    "tStartMs": 622840,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "또 엄청난 돈을 쏟아붓고 있는 거죠"
    } ]
  }, {
    "tStartMs": 626070,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "자 그래서 저는 이렇게 생각합니다"
    } ]
  }, {
    "tStartMs": 628040,
    "dDurationMs": 3830,
    "segs": [ {
      "utf8": "우리도 AI 기업들을 가져야 된다"
    } ]
  }, {
    "tStartMs": 631870,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "욕심이라고 하시는 분도 있는데 가져야 됩니다"
    } ]
  }, {
    "tStartMs": 634200,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "제 생각에 가져야 돼요"
    } ]
  }, {
    "tStartMs": 635280,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "언제까지 곡괭이와 삽 기업들의 시간은 아닐 거잖아요"
    } ]
  }, {
    "tStartMs": 638730,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "이들의 시간이 지나고"
    } ]
  }, {
    "tStartMs": 640160,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "진짜 황금이 나오면 어떡해"
    } ]
  }, {
    "tStartMs": 641880,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "곧 진짜 AI 기업들의 시간이 올 텐데"
    } ]
  }, {
    "tStartMs": 645060,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "우리 코스피 지금 조금 밀렸지만"
    } ]
  }, {
    "tStartMs": 647300,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "1만 가고, 1만 오천 가고, 2만 가고"
    } ]
  }, {
    "tStartMs": 649250,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "우리 20년, 30년 먹거리"
    } ]
  }, {
    "tStartMs": 650670,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "국민소득 4만 달러, 5만 달러, 6만 달러 가려면"
    } ]
  }, {
    "tStartMs": 653870,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "우리도 AI 기업들에서"
    } ]
  }, {
    "tStartMs": 655630,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "완전히 세계를 다 가지지 못하겠지만"
    } ]
  }, {
    "tStartMs": 658240,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "우리의 몫을 챙기는 AI 기업은 있어야 되지 않을까?"
    } ]
  }, {
    "tStartMs": 661020,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "이 생각을 굉장히 많이 하고"
    } ]
  }, {
    "tStartMs": 662400,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "그래서 사실 우리나라는 작년부터"
    } ]
  }, {
    "tStartMs": 665350,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "한국형 독자 AI 파운데이션 모델이라는 걸 추진하고 있습니다"
    } ]
  }, {
    "tStartMs": 669290,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "소위 말해 국가대표 AI 기업 빅테크들이 하는"
    } ]
  }, {
    "tStartMs": 672550,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "그 AI LLM 모델, 라지 랭귀지, 우리가 치는 거"
    } ]
  }, {
    "tStartMs": 675810,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "그런 거 한국형으로 만들어보자"
    } ]
  }, {
    "tStartMs": 677680,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "이런 거의 경진대회 비슷한 거 기업을 대상으로 하고 있죠"
    } ]
  }, {
    "tStartMs": 680790,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "물론 이걸 바라보는 분들 중에서 그렇게 생각하는 분들이 많더라고요"
    } ]
  }, {
    "tStartMs": 684180,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "그게 되겠냐?"
    } ]
  }, {
    "tStartMs": 685520,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "빅테크들이 지금 얼마를 넣는데 그게 되겠냐?"
    } ]
  }, {
    "tStartMs": 688180,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "우리가 한국형 독자 AI 모델이 가능하겠냐?"
    } ]
  }, {
    "tStartMs": 691870,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "오픈AI 같은"
    } ]
  }, {
    "tStartMs": 693000,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "아니면 제미나이 같은 그런 AI 모델이 필요한데"
    } ]
  }, {
    "tStartMs": 696320,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "과연 그게 가능하겠냐라는 얘기를 많이 하시죠"
    } ]
  }, {
    "tStartMs": 698820,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "그래서 제가 이번에 실제로 바르셀로나 가서"
    } ]
  }, {
    "tStartMs": 701150,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "SKT 사장님한테 한번 물어봤습니다"
    } ]
  }, {
    "tStartMs": 703260,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "글로벌 빅테크들이 수백조 원 쏟아붓는데"
    } ]
  }, {
    "tStartMs": 705940,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "우리나라가 해서 되겠습니까?"
    } ]
  }, {
    "tStartMs": 707550,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "왜냐하면 SKT 지금 한국형 AI 모델을 개발하고 있거든요"
    } ]
  }, {
    "tStartMs": 711060,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "그랬더니 뭐라고 답을 해주셨냐?"
    } ]
  }, {
    "tStartMs": 713540,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "뒤에 영상에 좀 더 길게 말씀드릴 텐데"
    } ]
  }, {
    "tStartMs": 716840,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "저는 이게 굉장히 인상적이었습니다"
    } ]
  }, {
    "tStartMs": 718560,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "뭐라고 하셨냐?"
    } ]
  }, {
    "tStartMs": 719200,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "이렇게 말씀하셨어요"
    } ]
  }, {
    "tStartMs": 720320,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "그럼 그렇다고 안 할 거냐?"
    } ]
  }, {
    "tStartMs": 723830,
    "dDurationMs": 4090,
    "segs": [ {
      "utf8": "우리나라 그 누구도 AI 모델을 안 만들 거냐?"
    } ]
  }, {
    "tStartMs": 727920,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "글로벌 빅테크 모델만을 사용을 할 거냐?"
    } ]
  }, {
    "tStartMs": 731200,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "물론 우리가 글로벌 빅테크들하고 싸워서"
    } ]
  }, {
    "tStartMs": 732810,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "완전히 승리하지 못할지라도"
    } ]
  }, {
    "tStartMs": 734960,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "그들의 틈을 노려서"
    } ]
  }, {
    "tStartMs": 735920,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "우리가 잘할 수 있는 영역을 해야 되지 않겠냐"
    } ]
  }, {
    "tStartMs": 739020,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "어려울지라도"
    } ]
  }, {
    "tStartMs": 739980,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "누군가는 투자금을 많이 넣어서"
    } ]
  }, {
    "tStartMs": 742220,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "그래도 우리 몫을 챙겨야 되지 않겠냐"
    } ]
  }, {
    "tStartMs": 744770,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "이렇게 말씀하시더라고요"
    } ]
  }, {
    "tStartMs": 746600,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "실제로 지금 우리나라에서는"
    } ]
  }, {
    "tStartMs": 748860,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "많은 기업들이 한국형 AI 모델 만드는데"
    } ]
  }, {
    "tStartMs": 751570,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "도전을 하고 있습니다"
    } ]
  }, {
    "tStartMs": 752620,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "얼마 전에 정부 주도로 뽑았던"
    } ]
  }, {
    "tStartMs": 754450,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "우리나라 독자 AI 파운데이션 모델에 5개 기업이 도전했었죠"
    } ]
  }, {
    "tStartMs": 758510,
    "dDurationMs": 630,
    "segs": [ {
      "utf8": "SK텔레콤"
    } ]
  }, {
    "tStartMs": 759140,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "LG AI, 업스테이지, 네이버 클라우드, NC AI"
    } ]
  }, {
    "tStartMs": 762320,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "물론 1차 선정이 끝나서"
    } ]
  }, {
    "tStartMs": 763560,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "현재 앞에 있는 세 기업"
    } ]
  }, {
    "tStartMs": 764640,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "SK텔레콤, LG, 업스테이지가 올라갔지만"
    } ]
  }, {
    "tStartMs": 767080,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "어쨌건 이들 중에서 누군가는"
    } ]
  }, {
    "tStartMs": 768770,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "우리나라 AI의 몫을 찾아주기를 기대해야겠죠"
    } ]
  }, {
    "tStartMs": 771770,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "물론 어려울 수도 있는데"
    } ]
  }, {
    "tStartMs": 772820,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "그렇게 생각하면 우리나라가 예전에 반도체 처음 한다고 그래서"
    } ]
  }, {
    "tStartMs": 775800,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "삼성전자가 반도체 처음 한다고 했을 때"
    } ]
  }, {
    "tStartMs": 778480,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "그거 다 비웃었잖아요"
    } ]
  }, {
    "tStartMs": 780140,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "그때 누가 된다고 했습니까?"
    } ]
  }, {
    "tStartMs": 781570,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "일본에서 심지어 한국이 되겠냐"
    } ]
  }, {
    "tStartMs": 783830,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "20년, 30년 걸려도 못 만들 거다"
    } ]
  }, {
    "tStartMs": 785780,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "이런 말도 나왔었는데"
    } ]
  }, {
    "tStartMs": 787170,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "불과 몇 년 안 있어서"
    } ]
  }, {
    "tStartMs": 788360,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "우리나라가 반도체 강국으로 나서지 않습니까?"
    } ]
  }, {
    "tStartMs": 790920,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "그 다음에 수십 년 뒤에는"
    } ]
  }, {
    "tStartMs": 792190,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "우리가 그것 때문에 굉장히 큰 돈을 벌고 있고"
    } ]
  }, {
    "tStartMs": 794730,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "지금은 어려워 보이지만"
    } ]
  }, {
    "tStartMs": 795700,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "이 AI 경쟁에서"
    } ]
  }, {
    "tStartMs": 797110,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "누군가는 이 AI 경쟁에서"
    } ]
  }, {
    "tStartMs": 798470,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "승리자가 되어야 되지 않나 생각을 합니다"
    } ]
  }, {
    "tStartMs": 801540,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "이번에 2026 MWC에서는 SK텔레콤이 저를 초대해줬거든요"
    } ]
  }, {
    "tStartMs": 805420,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "그래서 간신히 가볼 수 있었습니다"
    } ]
  }, {
    "tStartMs": 807620,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "또 이번에도 못 갈 뻔했는데"
    } ]
  }, {
    "tStartMs": 808990,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "다행히 간신히 갔다 와서"
    } ]
  }, {
    "tStartMs": 810330,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "정말 다시 한 번 감사의 말씀을 드립니다"
    } ]
  }, {
    "tStartMs": 812610,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "SK텔레콤이 이렇게 얘기하더라고요"
    } ]
  }, {
    "tStartMs": 814180,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "일단 SK텔레콤이 SK라는 그룹 안에 있다"
    } ]
  }, {
    "tStartMs": 816900,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "근데 하이닉스가 반도체 만들고"
    } ]
  }, {
    "tStartMs": 818700,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "또 SK가 에너지 기업이죠 원래"
    } ]
  }, {
    "tStartMs": 820290,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "에너지와 반도체를 같이 하는 그룹 안에 있으면"
    } ]
  }, {
    "tStartMs": 823420,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "AI를 얼마나 잘하겠냐"
    } ]
  }, {
    "tStartMs": 825640,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "게다가 본인은 통신사죠"
    } ]
  }, {
    "tStartMs": 827580,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "에너지, 반도체, 통신"
    } ]
  }, {
    "tStartMs": 830140,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "이걸 다 함께 할 수 있는 그룹이니까"
    } ]
  }, {
    "tStartMs": 832150,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "SK텔레콤이 국가대표 AI 사업자로 성장할 수 있지 않겠냐"
    } ]
  }, {
    "tStartMs": 835540,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "한마디로 풀스택으로 준비되어 있는 사업자다"
    } ]
  }, {
    "tStartMs": 837530,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "우리가 한번 이겨보겠다라고 말씀을 하셨습니다"
    } ]
  }, {
    "tStartMs": 841020,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "그러면서 SKT가 얼마 전에 AI 모델을 공개했죠"
    } ]
  }, {
    "tStartMs": 843900,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "A.X K1이라고 하는데"
    } ]
  }, {
    "tStartMs": 845540,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "이게 Chat GPT나 제미나이와는 다른"
    } ]
  }, {
    "tStartMs": 847300,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "순수 우리 기술로 만든 라지 랭기지 모델 AI라고 합니다"
    } ]
  }, {
    "tStartMs": 851050,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "대부분 AI 기업이라고 그러면"
    } ]
  }, {
    "tStartMs": 853100,
    "dDurationMs": 3610,
    "segs": [ {
      "utf8": "빅테크들이 만든 LLM 모델을 뒤에 백그라운드에 두고"
    } ]
  }, {
    "tStartMs": 856710,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "우리 거를 씌우는 기업들이 굉장히 많은데"
    } ]
  }, {
    "tStartMs": 858430,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "물론 그것도 굉장히 좋은 사업 모델이지만"
    } ]
  }, {
    "tStartMs": 860820,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "순수 우리 기술로 만든 LLM 모델 AI라고 합니다"
    } ]
  }, {
    "tStartMs": 864110,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "그리고 이번에 SK가 만든 AI 모델 정도의 규모라면"
    } ]
  }, {
    "tStartMs": 867580,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "세계에서 이 정도를 만들 수 있는 국가들이 많이 없다"
    } ]
  }, {
    "tStartMs": 870580,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "미국, 중국, 그리고 프랑스"
    } ]
  }, {
    "tStartMs": 873440,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "그리고 우리나라 이 정도로 꼽더라고요"
    } ]
  }, {
    "tStartMs": 874920,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "실제로 그래서 이 정도 되는 수준의 AI를 만드는 나라가 몇 개 없기 때문에"
    } ]
  }, {
    "tStartMs": 878670,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "우리가 빨리 좀 참여하면"
    } ]
  }, {
    "tStartMs": 879930,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "진짜 우리의 몫을 찾을 수 있지 않을까 생각합니다"
    } ]
  }, {
    "tStartMs": 882900,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "또 SK텔레콤 한 뉴스에서 보셨을 겁니다"
    } ]
  }, {
    "tStartMs": 885010,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "아마존웹서비스 하고 손잡고"
    } ]
  }, {
    "tStartMs": 886870,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "또 오픈AI 하고도 손잡았죠"
    } ]
  }, {
    "tStartMs": 888220,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "AI 데이터센터를 크게 한번 만들어보겠다"
    } ]
  }, {
    "tStartMs": 890910,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "우리나라에도 AI 데이터센터가 있어야"
    } ]
  }, {
    "tStartMs": 893320,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "그걸 활용해서 AI 기업들이 또 발전을 할 수 있지 않겠습니까?"
    } ]
  }, {
    "tStartMs": 897220,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "반도체도 파운드리 기업"
    } ]
  }, {
    "tStartMs": 898420,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "만드는 기업이 있어야"
    } ]
  }, {
    "tStartMs": 899630,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "반도체 설계하는 팹리스 기업이 있듯이"
    } ]
  }, {
    "tStartMs": 901660,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "생태계를 이룰 수 있는데"
    } ]
  }, {
    "tStartMs": 903070,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "돈이 많이 들죠"
    } ]
  }, {
    "tStartMs": 903940,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "데이터센터 만드는데 돈이 많이 드는데"
    } ]
  }, {
    "tStartMs": 905860,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "일단 우선적으로 AI 데이터센터를 유치해서"
    } ]
  }, {
    "tStartMs": 908320,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "투자를 하겠다고 발표한 그런 상황입니다"
    } ]
  }, {
    "tStartMs": 910750,
    "dDurationMs": 3910,
    "segs": [ {
      "utf8": "그래서 결국에 AI를 위한 우리가 삽과 곡괭이 팔면서"
    } ]
  }, {
    "tStartMs": 914660,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "에너지 팔고 반도체 팔고"
    } ]
  }, {
    "tStartMs": 916490,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "코스피가 5천, 6천 넘겼잖아요"
    } ]
  }, {
    "tStartMs": 918520,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "AI 기업들이 나타나서 1만, 1만 5천 가기를 기원하면서"
    } ]
  }, {
    "tStartMs": 922100,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "저와 같이 스페인 바르셀로나에서 열리는"
    } ]
  }, {
    "tStartMs": 924590,
    "dDurationMs": 3890,
    "segs": [ {
      "utf8": "MWC 2026 어떤 기술들이 있는지 한번 보러 가시죠"
    } ]
  } ]
}

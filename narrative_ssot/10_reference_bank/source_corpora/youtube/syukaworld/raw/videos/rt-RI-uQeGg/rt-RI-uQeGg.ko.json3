  }, {
    "tStartMs": 278140,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "상승 추세라는 거니까"
    } ]
  }, {
    "tStartMs": 279890,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "당연히 개인도 순매수로 쭉 따라가고"

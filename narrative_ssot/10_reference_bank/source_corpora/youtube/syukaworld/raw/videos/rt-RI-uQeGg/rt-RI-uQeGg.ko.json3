  }, {
    "tStartMs": 316300,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "시장이 상승을 하면"
    } ]
  }, {
    "tStartMs": 317810,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "매도 베팅이 줄어들 것 같은데"
    } ]
  }, {
    "tStartMs": 319550,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "아니라는 거죠"
    } ]
  }, {
    "tStartMs": 320240,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "오히려 늘어난다는 거고"
    } ]
  }, {
    "tStartMs": 321620,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "인버스 2배 ETF를 보면"

  }, {
    "tStartMs": 228500,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "역추세 추종을 하더라!"
    } ]
  }, {
    "tStartMs": 230360,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "라는 내용의 레포트입니다"
    } ]
  }, {
    "tStartMs": 231960,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "물론 이 레포트는"
    } ]
  }, {
    "tStartMs": 232790,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "레버리지나 인버스에 대한"
    } ]
  }, {
    "tStartMs": 233940,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "조사를 한 레포트인데"
    } ]
  }, {
    "tStartMs": 235270,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "제가 보기에는 일반적으로도"
    } ]
  }, {
    "tStartMs": 236390,
    "dDurationMs": 630,
    "segs": [ {
      "utf8": "어느 정도"
    } ]
  }, {
    "tStartMs": 237020,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "설득력이 있는 내용 같아요"
    } ]
  }, {
    "tStartMs": 238490,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "내용은 이렇습니다"
    } ]
  }, {
    "tStartMs": 239600,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "개인 투자자들은"
    } ]
  }, {
    "tStartMs": 240660,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "ETF 가격이 오르면"
    } ]
  }, {
    "tStartMs": 242410,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "순매도 하고"
    } ]
  }, {
    "tStartMs": 243410,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "가격이 내리면"
    } ]
  }, {
    "tStartMs": 244480,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "순매수하는 경향이 있다"
    } ]
  }, {
    "tStartMs": 246720,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "그렇게 생각하십니까?"
    } ]
  }, {
    "tStartMs": 247640,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "아래쪽에 있는 차트를 보면"
    } ]
  }, {
    "tStartMs": 249220,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "파란색이 ETF 가격입니다"
    } ]
  }, {
    "tStartMs": 251210,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "ETF 가격이 올라가니까"
    } ]
  }, {
    "tStartMs": 252610,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "이 빨간색"
    } ]
  }, {
    "tStartMs": 253970,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "개인의 순매수가 감소합니다"
    } ]
  }, {
    "tStartMs": 256400,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "순매도를 해요"
    } ]
  }, {
    "tStartMs": 257640,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "그러니까 한마디로 주가가 올라가면"
    } ]
  }, {
    "tStartMs": 259530,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "개인은 판다는 거죠"
    } ]
  }, {
    "tStartMs": 261680,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "ETF 기준으로"
    } ]
  }, {
    "tStartMs": 262860,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "이게 코덱스 레버리지 ETF입니다"
    } ]
  }, {
    "tStartMs": 264780,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "옆에는 코스닥 150 레버리지 ETF인데"
    } ]
  }, {
    "tStartMs": 267500,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "역시 보면"
    } ]
  }, {
    "tStartMs": 268140,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "이 가격과 개인의 순매수가"
    } ]
  }, {
    "tStartMs": 270570,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "굉장히 데칼코마니를 이루고 있다는 걸 볼 수 있습니다"

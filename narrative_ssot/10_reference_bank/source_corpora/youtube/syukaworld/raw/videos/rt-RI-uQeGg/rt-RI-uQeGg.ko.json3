  }, {
    "tStartMs": 283890,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "이게 하락 추세라는 거니까"
    } ]
  }, {
    "tStartMs": 285560,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "개인들이 당연히 순매도로"
    } ]
  }, {
    "tStartMs": 287110,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "이렇게"
    } ]
  }, {
    "tStartMs": 287800,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "대응을 할 것 같았는데"
    } ]
  }, {
    "tStartMs": 289680,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "자, 그런데 이 개인투자자들"
    } ]
  }, {
    "tStartMs": 290830,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "물론 레버리지나 인버스 ETF이긴 하지만"
    } ]
  }, {
    "tStartMs": 292780,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "개인투자자들의 모습은 그렇지 않고"

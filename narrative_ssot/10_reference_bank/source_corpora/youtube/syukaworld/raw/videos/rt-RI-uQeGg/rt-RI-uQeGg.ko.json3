{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 7590,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "자, 여러분 안녕하세요"
    } ]
  }, {
    "tStartMs": 8700,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "자, 요즘 주식시장이 너무나 정신이 없습니다"
    } ]
  }, {
    "tStartMs": 11470,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "아주 위아래로 현란하게 움직이고 있는데"
    } ]
  }, {
    "tStartMs": 13940,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "그래서 오늘은 제가 특별히"
    } ]
  }, {
    "tStartMs": 15580,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "주제를 한번 만들어봤습니다"
    } ]
  }, {
    "tStartMs": 17030,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "지금은 어떤 투자를 해야 되나?"
    } ]
  }, {
    "tStartMs": 18960,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "라는 주제로 갖고 왔습니다"
    } ]
  }, {
    "tStartMs": 21120,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "자, 제가 이 주제를 갖고 온 거는"
    } ]
  }, {
    "tStartMs": 22840,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "또 이유가 있습니다"
    } ]
  }, {
    "tStartMs": 24210,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "요즘에 저희 직원들이"
    } ]
  }, {
    "tStartMs": 26680,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "밤만 되면 주식 문의를"
    } ]
  }, {
    "tStartMs": 28680,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "예전보다 훨씬 더 많이 하는 것 같아요"
    } ]
  }, {
    "tStartMs": 30120,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "정말 부쩍 늘어났는데"
    } ]
  }, {
    "tStartMs": 31890,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "왼쪽에 보면"
    } ]
  }, {
    "tStartMs": 32570,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "요즘에 골방 슈카쌤"
    } ]
  }, {
    "tStartMs": 33850,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "그래서 저희 서브 채널"
    } ]
  }, {
    "tStartMs": 35220,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "머니코믹스에서"
    } ]
  }, {
    "tStartMs": 36250,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "이런 거 몰래 몰래 찍어서"
    } ]
  }, {
    "tStartMs": 37940,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "올리고 있습니다"
    } ]
  }, {
    "tStartMs": 38980,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "제가 뭐 사실 저거 찍으려고 말하는 건 아닌데"
    } ]
  }, {
    "tStartMs": 40760,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "요즘에 너무"
    } ]
  }, {
    "tStartMs": 41640,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "주식 문의가 많아 가지고"
    } ]
  }, {
    "tStartMs": 43190,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "얘기를 자주 하고 있죠"
    } ]
  }, {
    "tStartMs": 44470,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "직원들의 주식 문의는"
    } ]
  }, {
    "tStartMs": 45640,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "대부분 이래요"
    } ]
  }, {
    "tStartMs": 46770,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "지금 이렇게 흔들리는 시장에서"
    } ]
  }, {
    "tStartMs": 49140,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "많이 들고 있다는 거죠"
    } ]
  }, {
    "tStartMs": 50020,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "본인은 많이 들고 있고"
    } ]
  }, {
    "tStartMs": 51060,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "인생에 베팅을 했어요"
    } ]
  }, {
    "tStartMs": 52440,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "자, 그래서"
    } ]
  }, {
    "tStartMs": 53510,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "손절해야 됩니까?"
    } ]
  }, {
    "tStartMs": 55130,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "아니면 더 삽니까?"
    } ]
  }, {
    "tStartMs": 56550,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "이 질문이 지난 일주일간"
    } ]
  }, {
    "tStartMs": 58740,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "여러 명의 직원분한테서"
    } ]
  }, {
    "tStartMs": 60810,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "정말 많이 왔는데"
    } ]
  }, {
    "tStartMs": 62020,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "사실은 이게 우리 개미의 모습이라고 생각합니다"
    } ]
  }, {
    "tStartMs": 64630,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "지금 워낙 흔들리고 있기 때문에"
    } ]
  }, {
    "tStartMs": 66350,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "저가 매수를 해야 되냐?"
    } ]
  }, {
    "tStartMs": 68110,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "인생 베팅을 해야 되냐?"
    } ]
  }, {
    "tStartMs": 69250,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "여기서 놓치면 못 살 것 같지 않냐?"
    } ]
  }, {
    "tStartMs": 71210,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "이런 문제 굉장히 많이 늘어났죠"
    } ]
  }, {
    "tStartMs": 73430,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "게다가 우리 친구들은"
    } ]
  }, {
    "tStartMs": 75140,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "대부분 20대 후반에서"
    } ]
  }, {
    "tStartMs": 76250,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "30대 초반이다 보니까"
    } ]
  }, {
    "tStartMs": 77930,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "또 투자 목적도 연금처럼"
    } ]
  }, {
    "tStartMs": 79780,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "아니면 퇴직연금처럼"
    } ]
  }, {
    "tStartMs": 80890,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "10년, 20년 뒤에 보겠다"
    } ]
  }, {
    "tStartMs": 82190,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "이런 장기 투자가 아니라"
    } ]
  }, {
    "tStartMs": 83610,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "대부분 제가 보기에는"
    } ]
  }, {
    "tStartMs": 85270,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "굉장히 단타 목적의"
    } ]
  }, {
    "tStartMs": 86550,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "짧으면 2, 3일도 될 수 있고"
    } ]
  }, {
    "tStartMs": 88110,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "하루도 될 수 있고"
    } ]
  }, {
    "tStartMs": 89300,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "길게 봐도 몇 달 정도 보는"
    } ]
  }, {
    "tStartMs": 91130,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "그런 목적을 가진 투자자들이죠"
    } ]
  }, {
    "tStartMs": 92940,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "자 그러면 지금같이 혼란한 시장에서"
    } ]
  }, {
    "tStartMs": 95450,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "어떻게 투자를 해야 될까요?"
    } ]
  }, {
    "tStartMs": 98080,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "물론 저도 정답은 모르는데"
    } ]
  }, {
    "tStartMs": 99370,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "일단 제 생각만"
    } ]
  }, {
    "tStartMs": 100270,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "살짝 말씀드리도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 101800,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "우리 친구들은 주로 이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 103660,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "아니 작년에 상승장인데"
    } ]
  }, {
    "tStartMs": 105460,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "왜 그동안 안 담고"
    } ]
  }, {
    "tStartMs": 106580,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "여기서 이렇게 고민하세요?"
    } ]
  }, {
    "tStartMs": 107590,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "라고 제가 물어보니까"
    } ]
  }, {
    "tStartMs": 108810,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "대부분 답이 이겁니다"
    } ]
  }, {
    "tStartMs": 109900,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "작년 상승장에서"
    } ]
  }, {
    "tStartMs": 111370,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "제대로 못 담았다"
    } ]
  }, {
    "tStartMs": 113240,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "이게 너무 가파르게 올라가다 보니까"
    } ]
  }, {
    "tStartMs": 115410,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "무서워서"
    } ]
  }, {
    "tStartMs": 116520,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "타이밍을 못 잡고"
    } ]
  }, {
    "tStartMs": 117730,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "이때에 충분한 소득을 거두지 못했다"
    } ]
  }, {
    "tStartMs": 120120,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "그래서 소위 포모가 왔다는 거죠"
    } ]
  }, {
    "tStartMs": 122390,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "야 나 없이 가는 게"
    } ]
  }, {
    "tStartMs": 123280,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "너무나 불안했는데"
    } ]
  }, {
    "tStartMs": 125150,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "마침 조정이 왔으니까"
    } ]
  }, {
    "tStartMs": 127060,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "여기서 한번 인생 베팅을 하는 게 어떻습니까?"
    } ]
  }, {
    "tStartMs": 129900,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "어떻게 생각하십니까?"
    } ]
  }, {
    "tStartMs": 130980,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "라고 저한테 한 분이 아니라"
    } ]
  }, {
    "tStartMs": 133040,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "진짜 여러 분이 물어봤습니다"
    } ]
  }, {
    "tStartMs": 135390,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "자 어떻게 생각하십니까 여러분?"
    } ]
  }, {
    "tStartMs": 136850,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "물론 답은 없어요"
    } ]
  }, {
    "tStartMs": 137830,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "답이 없는 문제인데"
    } ]
  }, {
    "tStartMs": 139000,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "어느 정도 조정이 왔잖아요"
    } ]
  }, {
    "tStartMs": 140070,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "한 6,300 정도 하다가"
    } ]
  }, {
    "tStartMs": 141850,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "한 5,300?"
    } ]
  }, {
    "tStartMs": 142570,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "한 5,500 정도가 왔단 말이에요"
    } ]
  }, {
    "tStartMs": 144370,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "지금 밀려갔고 그러면"
    } ]
  }, {
    "tStartMs": 146150,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "어쨌건 500포인트에서"
    } ]
  }, {
    "tStartMs": 147360,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "1,000포인트 정도 조정이 왔으니까"
    } ]
  }, {
    "tStartMs": 148850,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "한 10에서 15%"
    } ]
  }, {
    "tStartMs": 149710,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "정도 조정이 온 거죠"
    } ]
  }, {
    "tStartMs": 151050,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "자, 풀로 담고"
    } ]
  }, {
    "tStartMs": 152520,
    "dDurationMs": 5430,
    "segs": [ {
      "utf8": "인생 베팅을 가야 할까요?"
    } ]
  }, {
    "tStartMs": 157950,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "이렇게도 물어봤어요"
    } ]
  }, {
    "tStartMs": 158970,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "작년에서 올해까지는 내내 상승장이었는데"
    } ]
  }, {
    "tStartMs": 162170,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "아니 그때"
    } ]
  }, {
    "tStartMs": 162910,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "사라 그럴 때는 그렇게 안 사더니"
    } ]
  }, {
    "tStartMs": 164870,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "지금은 누가 봐도 횡보나 하락장인데"
    } ]
  }, {
    "tStartMs": 167760,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "갑자기 왜 지금이냐?"
    } ]
  }, {
    "tStartMs": 168800,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "그때 이렇게 대답하더라고요"
    } ]
  }, {
    "tStartMs": 170290,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "조정이 오기를 기다린 겁니다"
    } ]
  }, {
    "tStartMs": 172050,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "아니 이렇게 무섭게 올라오는 걸"
    } ]
  }, {
    "tStartMs": 173450,
    "dDurationMs": 320,
    "segs": [ {
      "utf8": "어떻게"
    } ]
  }, {
    "tStartMs": 173770,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "조정이 왔으니까"
    } ]
  }, {
    "tStartMs": 174790,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "지금 인생 베팅을"
    } ]
  }, {
    "tStartMs": 176040,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "하냐 안하냐 물어보는 거잖아요"
    } ]
  }, {
    "tStartMs": 177770,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "라고 이야기를 하시더라고요"
    } ]
  }, {
    "tStartMs": 180650,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "자, 이 상황에서 어떻게 해야 될까요"
    } ]
  }, {
    "tStartMs": 182600,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "제가 사실 이 주제는"
    } ]
  }, {
    "tStartMs": 183460,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "라이브 때 하려고 그랬어요"
    } ]
  }, {
    "tStartMs": 184580,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "라이브 때 하려고 그랬는데"
    } ]
  }, {
    "tStartMs": 185870,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "마침 저희 회의할 때"
    } ]
  }, {
    "tStartMs": 187060,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "이 주제를 말하니까"
    } ]
  }, {
    "tStartMs": 187840,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "저희 마케터가"
    } ]
  }, {
    "tStartMs": 188660,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "카카오페이 증권에서"
    } ]
  }, {
    "tStartMs": 189960,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "굉장히 비슷한 얘기를 하시던데"
    } ]
  }, {
    "tStartMs": 191960,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "이걸 광고 영상 할 때"
    } ]
  }, {
    "tStartMs": 193010,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "같이 말씀하시면 어떻겠습니까"
    } ]
  }, {
    "tStartMs": 194490,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "이런 얘기를 하더라고요"
    } ]
  }, {
    "tStartMs": 195500,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "제가 미리 말씀드리겠습니다"
    } ]
  }, {
    "tStartMs": 197130,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "저 뒷부분에"
    } ]
  }, {
    "tStartMs": 198200,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "카카오페이 증권의 주식 모으기라는 서비스를"
    } ]
  }, {
    "tStartMs": 200850,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "한번 소개해드릴 겁니다"
    } ]
  }, {
    "tStartMs": 202390,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "이 내용은 그런 거예요"
    } ]
  }, {
    "tStartMs": 203610,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "언제 집중 매수를 해야 되고"
    } ]
  }, {
    "tStartMs": 205020,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "언제 분할 매수"
    } ]
  }, {
    "tStartMs": 206470,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "적립식 매수를 해야 되는가"
    } ]
  }, {
    "tStartMs": 208120,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "여기에 대한 이야기를 한번"
    } ]
  }, {
    "tStartMs": 209810,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "말씀드리도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 211890,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "우선 작년에 삼성증권에서"
    } ]
  }, {
    "tStartMs": 214620,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "개인 투자자를 분석한"
    } ]
  }, {
    "tStartMs": 215720,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "레포트가 하나 나왔었습니다"
    } ]
  }, {
    "tStartMs": 217170,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "아마 보신 분도 있을 텐데"
    } ]
  }, {
    "tStartMs": 218570,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "굉장히 인상적인 레포트였어요"
    } ]
  }, {
    "tStartMs": 220520,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "여러분도 누구나 보실 수 있습니다"
    } ]
  }, {
    "tStartMs": 221970,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "제목은 개인 투자자의"

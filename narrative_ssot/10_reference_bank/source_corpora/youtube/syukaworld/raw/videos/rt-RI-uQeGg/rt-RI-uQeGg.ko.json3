    } ]
  }, {
    "tStartMs": 361910,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "QQQ 3배 레버리지 ETF도 똑같아요"
    } ]
  }, {
    "tStartMs": 364280,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "가격이 올라가면"
    } ]
  }, {
    "tStartMs": 365480,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "사람들은 팔고 가격이 내려가면"
    } ]
  }, {
    "tStartMs": 367620,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "사람들은 산다는 거죠"
    } ]
  }, {
    "tStartMs": 371120,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "개인 투자자들 같은 경우에는"
    } ]
  }, {
    "tStartMs": 372650,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "추세 추종보다는"
    } ]
  }, {
    "tStartMs": 373560,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "역추세를 추종하는 분들이"

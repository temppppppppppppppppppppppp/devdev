  }, {
    "tStartMs": 308720,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "시장이 상승하니까"
    } ]
  }, {
    "tStartMs": 310340,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "개인들은 인버스, 숏이죠"
    } ]
  }, {
    "tStartMs": 312120,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "오히려 매도 베팅이 늘어난다는 걸 의미합니다"

  }, {
    "tStartMs": 300880,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "그 모습이 더 강렬하게 나오는데"
    } ]
  }, {
    "tStartMs": 303250,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "아래에 있는 차트는"
    } ]
  }, {
    "tStartMs": 304240,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "인버스 ETF입니다"
    } ]
  }, {
    "tStartMs": 305750,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "파란색이 내려가면"
    } ]
  }, {
    "tStartMs": 307130,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "시장이 상승한다는 뜻이죠"

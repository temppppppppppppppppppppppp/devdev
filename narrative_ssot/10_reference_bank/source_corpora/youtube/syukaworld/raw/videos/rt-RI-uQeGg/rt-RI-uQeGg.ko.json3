  }, {
    "tStartMs": 343600,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "국내 투자자들이 해외 ETF에서도"
    } ]
  }, {
    "tStartMs": 345810,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "굉장히 동일한 매매 패턴을 보였습니다"
    } ]
  }, {
    "tStartMs": 348400,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "왼쪽에 있는 건"
    } ]
  }, {
    "tStartMs": 349010,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "반도체 3배 레버리지 ETF인데"
    } ]
  }, {
    "tStartMs": 351240,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "역시 시장이 내려가면"
    } ]
  }, {
    "tStartMs": 352980,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "개인의 순매수는 늘었고요"
    } ]
  }, {
    "tStartMs": 354300,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "시장이 올라가면"
    } ]
  }, {
    "tStartMs": 355400,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "개인의 순매수는 줄었습니다"
    } ]
  }, {
    "tStartMs": 356860,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "와"
    } ]
  }, {
    "tStartMs": 357740,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "이렇게 데칼코마니로"
    } ]
  }, {
    "tStartMs": 359860,
    "dDurationMs": 440,
    "segs": [ {

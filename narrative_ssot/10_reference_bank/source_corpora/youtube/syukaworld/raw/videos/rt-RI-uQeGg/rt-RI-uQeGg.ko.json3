  }, {
    "tStartMs": 297070,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "가는 경향이 있다라는 겁니다"
    } ]
  }, {
    "tStartMs": 299250,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "이게 보면 인버스에서는 특히"

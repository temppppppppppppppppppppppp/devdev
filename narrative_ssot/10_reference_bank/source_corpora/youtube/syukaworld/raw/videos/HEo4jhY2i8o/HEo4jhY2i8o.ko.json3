  }, {
    "tStartMs": 455270,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "시간이 남아있으니까"
    } ]
  }, {
    "tStartMs": 456170,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "거기서 이제 돌려갖고"

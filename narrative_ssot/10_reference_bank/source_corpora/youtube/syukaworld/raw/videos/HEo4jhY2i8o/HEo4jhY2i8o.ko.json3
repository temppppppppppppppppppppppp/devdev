    } ]
  }, {
    "tStartMs": 58310,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "물론 Y축이 조금"
    } ]
  }, {
    "tStartMs": 59940,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "이상하다고 생각하시는 분들이 있을 텐데"

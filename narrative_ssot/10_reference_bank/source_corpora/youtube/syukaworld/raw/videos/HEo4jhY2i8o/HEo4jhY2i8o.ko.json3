  }, {
    "tStartMs": 496200,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "통계 작성이래 최고 수치입니다"
    } ]
  }, {
    "tStartMs": 498910,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "아직도 올라가고 있어요 아직도"

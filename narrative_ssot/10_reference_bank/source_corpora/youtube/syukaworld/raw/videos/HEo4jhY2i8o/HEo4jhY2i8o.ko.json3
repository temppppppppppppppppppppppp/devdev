  }, {
    "tStartMs": 458600,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "쫙 올려주면은 좋습니다"
    } ]
  }, {
    "tStartMs": 461010,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "OECD 평균 한 1.4까지는"
    } ]
  }, {
    "tStartMs": 462610,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "그냥 가지 않을까 생각이 되고"

  }, {
    "tStartMs": 468270,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "되지 않을까 생각을 합니다"
    } ]
  }, {
    "tStartMs": 471090,
    "dDurationMs": 350,
    "segs": [ {
      "utf8": "좋아요"
    } ]
  }, {
    "tStartMs": 471440,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "계획은 다 짰으니까"
    } ]
  }, {
    "tStartMs": 472640,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "아마 이렇게 갈 수 있지 않을까 생각을 하고요"
    } ]
  }, {
    "tStartMs": 475300,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "충분하지 않을까 생각합니다"
    } ]
  }, {
    "tStartMs": 476770,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "다만!"

  }, {
    "tStartMs": 570540,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "뭐 이해할 수 있어요"
    } ]
  }, {
    "tStartMs": 571270,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "25년 전이니까"
    } ]
  }, {
    "tStartMs": 572490,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "근데 5년 전에 비해서도"
    } ]
  }, {
    "tStartMs": 574580,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "20대 엄마의 수가"
    } ]
  }, {
    "tStartMs": 575890,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "37%"
    } ]
  }, {
    "tStartMs": 576700,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "굉장히 많이 감소했다는 거는"
    } ]
  }, {
    "tStartMs": 578730,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "여전히 그 추세가 지속되고 있다"
    } ]
  }, {
    "tStartMs": 580930,
    "dDurationMs": 3390,
    "segs": [ {

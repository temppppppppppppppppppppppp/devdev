  }, {
    "tStartMs": 559060,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "2020년 대비 2025년을 보니까"
    } ]
  }, {
    "tStartMs": 563200,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "20대 엄마가"
    } ]
  }, {
    "tStartMs": 564390,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "2020년 대비 2025년에"
    } ]
  }, {
    "tStartMs": 565950,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "무려 37%가 줄었습니다"
    } ]
  }, {
    "tStartMs": 568830,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "2000년 대비 90% 줄어든 거는"

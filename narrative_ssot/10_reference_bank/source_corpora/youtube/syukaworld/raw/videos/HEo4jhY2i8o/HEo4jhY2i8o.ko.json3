  }, {
    "tStartMs": 527370,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "10대는 의미가 없죠"
    } ]
  }, {
    "tStartMs": 528120,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "10대 뭐 요즘 잘 없으니까"
    } ]
  }, {
    "tStartMs": 530500,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "20대 산모가 여전히"

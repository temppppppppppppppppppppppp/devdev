  }, {
    "tStartMs": 531760,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "91% 감소해 있습니다"
    } ]
  }, {
    "tStartMs": 533760,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "2000년에는 20대 엄마가"
    } ]
  }, {
    "tStartMs": 535580,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "40만 4,592명을 낳았는데"
    } ]
  }, {
    "tStartMs": 538240,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "2025년에는 3만 7,900으로 줄었어요"
    } ]
  }, {
    "tStartMs": 541040,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "여전히 -91%다"
    } ]
  }, {
    "tStartMs": 543300,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "30대 산모는 한 10%밖에 안 줄었고"
    } ]
  }, {
    "tStartMs": 545920,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "40대 산모는 185%가 늘었죠"
    } ]
  }, {
    "tStartMs": 547850,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "그러니까 결론적으로"
    } ]
  }, {
    "tStartMs": 549240,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "완전히 20대 엄마가 90%"
    } ]
  }, {
    "tStartMs": 550950,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "줄어있는 상황이고요"
    } ]
  }, {
    "tStartMs": 552800,
    "dDurationMs": 1290,
    "segs": [ {

  }, {
    "tStartMs": 451990,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "인식 변화가 바뀌면서"
    } ]
  }, {
    "tStartMs": 453770,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "그 아래 아직 45만까지"

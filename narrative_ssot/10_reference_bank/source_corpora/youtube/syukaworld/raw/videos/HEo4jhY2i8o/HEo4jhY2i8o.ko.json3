  }, {
    "tStartMs": 500900,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "한마디로 이른 시기에 아직 결혼을 하거나"
    } ]
  }, {
    "tStartMs": 503660,
    "dDurationMs": 670,
    "segs": [ {
      "utf8": "아이를 낳을 만큼"
    } ]
  }, {
    "tStartMs": 504330,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "사회적 준비가"
    } ]
  }, {
    "tStartMs": 505470,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "아직 잘 안 된다는 거죠"
    } ]
  }, {
    "tStartMs": 506990,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "이번 출산율 반등도 내용을 보면"
    } ]
  }, {
    "tStartMs": 509350,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "녹색 35에서 39세"
    } ]
  }, {
    "tStartMs": 512160,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "이 엄마들이 힘써주는 게 큽니다"
    } ]
  }, {
    "tStartMs": 514400,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "반면에 20대 산모는"
    } ]
  }, {
    "tStartMs": 516010,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "여전히 바닥이야"
    } ]
  }, {
    "tStartMs": 517120,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "오히려 내려갔다"
    } ]
  }, {
    "tStartMs": 519360,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "예전에 한번 보여드렸던 거"
    } ]
  }, {
    "tStartMs": 520450,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "다시 한번 최신 자료 한번 만들어봤는데"

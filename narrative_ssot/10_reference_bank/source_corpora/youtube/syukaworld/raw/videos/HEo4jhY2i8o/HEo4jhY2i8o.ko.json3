    } ]
  }, {
    "tStartMs": 554090,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "저건 2000년이니까 너무 멀잖아요"
    } ]
  }, {
    "tStartMs": 555670,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "그래요 너무 멀어요"
    } ]
  }, {
    "tStartMs": 556740,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "그래서 2020년이고, 엊그제잖아요"

      "utf8": "4자를 찍을 수 있으니까"
    } ]
  }, {
    "tStartMs": 195330,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "그렇게 어려운 문제는 아니라고"
    } ]
  }, {
    "tStartMs": 196990,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "생각이 되죠 좋습니다"
    } ]
  }, {
    "tStartMs": 198430,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "좋습니다"
    } ]
  }, {
    "tStartMs": 199040,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "작년 출산율 증가의 이유는 뭐냐?"
    } ]
  }, {
    "tStartMs": 201460,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "세 가지를 이유로 많이 얘기를 해요"
    } ]
  }, {
    "tStartMs": 202700,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "코로나 이후에 멈췄던 혼인들이"
    } ]
  }, {
    "tStartMs": 204930,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "코로나 때 못했으니까"
    } ]
  }, {
    "tStartMs": 205860,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "2022년, 23년, 24년에 많이 결혼했잖아요"
    } ]
  }, {
    "tStartMs": 208290,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "그분들이 아이를 낳기 시작했죠"
    } ]
  }, {
    "tStartMs": 210450,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "그래서 혼인 증가하고"
    } ]
  }, {
    "tStartMs": 212020,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "1, 2년 뒤에 아이가 태어나니까"
    } ]
  }, {
    "tStartMs": 213970,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "그리고 주 출산 연령대인"
    } ]
  }, {
    "tStartMs": 215130,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "30대 초반의 인구가"
    } ]
  }, {
    "tStartMs": 216130,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "많이 증가했어요"
    } ]
  }, {
    "tStartMs": 216990,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "보여드릴게요"
    } ]
  }, {
    "tStartMs": 217850,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "그리고 가장 중요한 거"
    } ]
  }, {
    "tStartMs": 218850,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "오늘의 하이라이트이자"
    } ]
  }, {
    "tStartMs": 220190,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "별 3개짜리"
    } ]
  }, {
    "tStartMs": 221290,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "출산에 대한 인식이"
    } ]
  }, {
    "tStartMs": 222820,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "긍정적으로 바뀌는 모습이 보이고 있습니다"
    } ]
  }, {
    "tStartMs": 225630,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "하나씩 말씀드릴게요"
    } ]
  }, {
    "tStartMs": 226780,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "혼인증가는 옛날에 한번 보여드렸으니까"
    } ]
  }, {
    "tStartMs": 228150,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "왼쪽에 있는 영상을 보시고"
    } ]
  }, {
    "tStartMs": 229560,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "그 아래에 있는 30대 초반 인구 증가는 뭐냐"
    } ]
  }, {
    "tStartMs": 231540,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "이것도 옛날에 한번 했어요"
    } ]
  }, {
    "tStartMs": 232780,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "지금이 황금 시기다"
    } ]
  }, {
    "tStartMs": 235390,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "황금 시기"
    } ]
  }, {
    "tStartMs": 236290,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "1991년부터 1995년생이"
    } ]
  }, {
    "tStartMs": 238630,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "만 31에서 34세"
    } ]
  }, {
    "tStartMs": 241180,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "여기입니다, 여기"
    } ]
  }, {
    "tStartMs": 242380,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "우리나라 근래 생년들 중에서"
    } ]
  }, {
    "tStartMs": 245210,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "가장 인구가 많은 5년이에요"
    } ]
  }, {
    "tStartMs": 247440,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "70만을 넘어요 여기는"
    } ]
  }, {
    "tStartMs": 248790,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "70 몇 만, 71만, 72만"
    } ]
  }, {
    "tStartMs": 250350,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "74만 그 정도인데"
    } ]
  }, {
    "tStartMs": 251250,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "여기가 마지막 승부입니다"
    } ]
  }, {
    "tStartMs": 254190,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "여러분들이!"
    } ]
  }, {
    "tStartMs": 255650,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "힘을 내줘야 돼"
    } ]
  }, {
    "tStartMs": 256730,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "힘을"
    } ]
  }, {
    "tStartMs": 257490,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "뒤는 힘이 좀 없어"
    } ]
  }, {
    "tStartMs": 258910,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "지금 여기 있어요 여기"
    } ]
  }, {
    "tStartMs": 260180,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "가장 황금시대 골든에이지"
    } ]
  }, {
    "tStartMs": 261990,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "골든에이지"
    } ]
  }, {
    "tStartMs": 264200,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "지금 91에서 95년생들이니까"
    } ]
  }, {
    "tStartMs": 266040,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "가장 이제 또"
    } ]
  }, {
    "tStartMs": 266910,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "아이를 많이 낳을 수 있는 연령대잖아요"
    } ]
  }, {
    "tStartMs": 268560,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "만 31~34"
    } ]
  }, {
    "tStartMs": 269590,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "여기에서 출산율을 최대한 많이 올려야"
    } ]
  }, {
    "tStartMs": 272350,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "승부가 걸려있다"
    } ]
  }, {
    "tStartMs": 273340,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "빠라바바바바 빠라바바"
    } ]
  }, {
    "tStartMs": 275140,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "마지막 승부라고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 276780,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "앞으로 10년이 중요한데"
    } ]
  }, {
    "tStartMs": 278650,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "왜냐하면 옛날에 말씀드렸지만"
    } ]
  }, {
    "tStartMs": 280160,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "10년이"
    } ]
  }, {
    "tStartMs": 281020,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "여기예요 여기"
    } ]
  }, {
    "tStartMs": 282330,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "70만에서 60만 달러"
    } ]
  }, {
    "tStartMs": 283970,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "여기 인구가 많이 낮아야 돼요"
    } ]
  }, {
    "tStartMs": 286050,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "여러분들에게 달려있습니다"
    } ]
  }, {
    "tStartMs": 287300,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "여러분들의 두 어깨!"
    } ]
  }, {
    "tStartMs": 288350,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "우리나라 미래가 달려있죠?"
    } ]
  }, {
    "tStartMs": 289560,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "만약에 10년이 지나면"
    } ]
  }, {
    "tStartMs": 291110,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "2002에서 2006년생들이"
    } ]
  }, {
    "tStartMs": 293270,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "이제 30초로 들어가거든요"
    } ]
  }, {
    "tStartMs": 294700,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "여기는 인구가 65%밖에 안 돼요"
    } ]
  }, {
    "tStartMs": 298130,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "굉장히 많이 인구 확 줍니다"
    } ]
  }, {
    "tStartMs": 299730,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "여기가 확 들어가는데요"
    } ]
  }, {
    "tStartMs": 300890,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "여기 때가 되면"
    } ]
  }, {
    "tStartMs": 302070,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "아마 어려움을 많이 겪을 거예요"
    } ]
  }, {
    "tStartMs": 303360,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "그래서 지금 미리미리"
    } ]
  }, {
    "tStartMs": 304770,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "이때는 아마 출생아   수가"
    } ]
  }, {
    "tStartMs": 306330,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "현 출산율이 유지되면"
    } ]
  }, {
    "tStartMs": 307670,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "16만 명 밖에 안 될 수 있어요"
    } ]
  }, {
    "tStartMs": 309290,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "물론 그땐 출산율이"
    } ]
  }, {
    "tStartMs": 310320,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "아마 제 생각에"
    } ]
  }, {
    "tStartMs": 311070,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "2가 됐을 테니까"
    } ]
  }, {
    "tStartMs": 312580,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "30만 넘어갈 것 같은데"
    } ]
  }, {
    "tStartMs": 313960,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "이가 못 된다면"
    } ]
  }, {
    "tStartMs": 315210,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "좀 내려갈 것 같아서"
    } ]
  }, {
    "tStartMs": 316260,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "지금 이제 10년이 여러분들께 걸렸다"
    } ]
  }, {
    "tStartMs": 318640,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "옛날에 보여드렸던 거"
    } ]
  }, {
    "tStartMs": 319390,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "한번 다시 보여드리면"
    } ]
  }, {
    "tStartMs": 320540,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "30년 뒤에는"
    } ]
  }, {
    "tStartMs": 321540,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "산모가 65% 없어집니다"
    } ]
  }, {
    "tStartMs": 323170,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "30년 뒤"
    } ]
  }, {
    "tStartMs": 324350,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "무서운 시기인데 보릿고개 있어요"
    } ]
  }, {
    "tStartMs": 328470,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "여러분들 20년대 때 낳은"
    } ]
  }, {
    "tStartMs": 329920,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "얘들이 이제 30초 되면"
    } ]
  }, {
    "tStartMs": 332610,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "그 전에 많이 해줘야 돼"
    } ]
  }, {
    "tStartMs": 334640,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "여기는 한 자릿대 떨어질 수 있어"
    } ]
  }, {
    "tStartMs": 335970,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "잘못하면"
    } ]
  }, {
    "tStartMs": 337160,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "얘들이 오기 전에"
    } ]
  }, {
    "tStartMs": 338200,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "지금 형님, 누나"
    } ]
  }, {
    "tStartMs": 339220,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "엄마, 아빠들이 노력을 많이..."
    } ]
  }, {
    "tStartMs": 341440,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "해주셔야 되는"
    } ]
  }, {
    "tStartMs": 342270,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "많은 사랑을 하셔야 되는"
    } ]
  }, {
    "tStartMs": 343320,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "그런 시기라고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 345310,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "그리고 아까 말씀드렸지만"
    } ]
  }, {
    "tStartMs": 346740,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "이건 인구 증가만으로"
    } ]
  }, {
    "tStartMs": 347650,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "설명되지 않는 부분도 있어요"
    } ]
  }, {
    "tStartMs": 349450,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "단순히 출산 가능"
    } ]
  }, {
    "tStartMs": 350440,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "인구 증가만으로 설명하기 어렵다"
    } ]
  }, {
    "tStartMs": 352370,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "30대 후반 인구는 좀 줄었는데"
    } ]
  }, {
    "tStartMs": 354310,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "거기도 출산율 자체가"
    } ]
  }, {
    "tStartMs": 356600,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "올라갔기 때문이다"
    } ]
  }, {
    "tStartMs": 357530,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "또 무슨 말이냐?"
    } ]
  }, {
    "tStartMs": 358780,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "실제로 요즘에 설문조사"
    } ]
  }, {
    "tStartMs": 360240,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "여론조사 내용들을 보면"
    } ]
  }, {
    "tStartMs": 361910,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "이렇게 나와요"
    } ]
  }, {
    "tStartMs": 362920,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "결혼 및 자녀에 대한 인식 변화가"
    } ]
  }, {
    "tStartMs": 365220,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "약해"
    } ]
  }, {
    "tStartMs": 365940,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "아직 약하지만"
    } ]
  }, {
    "tStartMs": 366880,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "서서히 보이고 있다"
    } ]
  }, {
    "tStartMs": 368640,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "꾸준하게 하락하던 쭉 하락하던"
    } ]
  }, {
    "tStartMs": 371020,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "결혼 의사가 약간"
    } ]
  }, {
    "tStartMs": 373400,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "결혼하면 자녀를 가져야 된다라는"
    } ]
  }, {
    "tStartMs": 375810,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "인식이 쭉 빠져갖고"
    } ]
  }, {
    "tStartMs": 377420,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "2022년의 저점이었거든요"
    } ]
  }, {
    "tStartMs": 379560,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "완전히 뭐"
    } ]
  }, {
    "tStartMs": 380780,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "누가 결혼하냐"
    } ]
  }, {
    "tStartMs": 381440,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "막 이런"
    } ]
  }, {
    "tStartMs": 382130,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "굉장히 암울한"
    } ]
  }, {
    "tStartMs": 383150,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "그런 내용 0.72 찍을 때"
    } ]
  }, {
    "tStartMs": 384910,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "그런 거에서 반등하고 있어요"
    } ]
  }, {
    "tStartMs": 387640,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "모든 건 사이클이죠"
    } ]
  }, {
    "tStartMs": 388610,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "모든 건 사이클"
    } ]
  }, {
    "tStartMs": 389230,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "그런 거를 많이 하다 보니까"
    } ]
  }, {
    "tStartMs": 391210,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "거기에다 이제 반론"
    } ]
  }, {
    "tStartMs": 392760,
    "dDurationMs": 480,
    "segs": [ {
      "utf8": "아니다"
    } ]
  }, {
    "tStartMs": 393240,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "실제 그게 아니었구나"
    } ]
  }, {
    "tStartMs": 394150,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "뭐 이런 걸 아는 분도"
    } ]
  }, {
    "tStartMs": 395100,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "뭐 늘어나는 거고"
    } ]
  }, {
    "tStartMs": 396530,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "이게 반등 중이다"
    } ]
  }, {
    "tStartMs": 398010,
    "dDurationMs": 430,
    "segs": [ {
      "utf8": "그러다 보니까"
    } ]
  }, {
    "tStartMs": 398440,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "출산율 우리나라 저점이 2023년을 찍었고"
    } ]
  }, {
    "tStartMs": 401240,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "4년, 5년에 지금 반등하고 있는 중인데"
    } ]
  }, {
    "tStartMs": 403360,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "자녀에 대한 인식 변화도"
    } ]
  }, {
    "tStartMs": 404620,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "최근에 미약하지만 보이고 있습니다"
    } ]
  }, {
    "tStartMs": 407260,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "이게 저출산고령화 위원회 자료인데"
    } ]
  }, {
    "tStartMs": 409250,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "2024년에 자녀가 필요하다는 응답이 61%였는데"
    } ]
  }, {
    "tStartMs": 411730,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "2020년에 68%까지 올라갔어요"
    } ]
  }, {
    "tStartMs": 413700,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "결혼에 긍정적이라는 것도"
    } ]
  }, {
    "tStartMs": 414970,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "이렇게 올라가고 있습니다"
    } ]
  }, {
    "tStartMs": 416300,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "자녀가 필요하다는 것도"
    } ]
  }, {
    "tStartMs": 417360,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "이렇게 올라가고 있어요"
    } ]
  }, {
    "tStartMs": 418930,
    "dDurationMs": 3950,
    "segs": [ {
      "utf8": "그동안 그렇지 않았던 분들이 겪어보니까"
    } ]
  }, {
    "tStartMs": 422880,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "바뀌는 것도 있을 테고"
    } ]
  }, {
    "tStartMs": 424070,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "아니면 모든 건 아까 얘기했지만"
    } ]
  }, {
    "tStartMs": 425260,
    "dDurationMs": 300,
    "segs": [ {
      "utf8": "사이클이죠"
    } ]
  }, {
    "tStartMs": 425560,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "한쪽으로 쏠리면 뒤쪽으로 가고"
    } ]
  }, {
    "tStartMs": 427220,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "이렇게 왔다 갔다 하다 보니까"
    } ]
  }, {
    "tStartMs": 428480,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "자녀에 대한 인식 변화가"
    } ]
  }, {
    "tStartMs": 430250,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "좀 생기고 있는 지금"
    } ]
  }, {
    "tStartMs": 431580,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "딱 지금이 아까 말씀드린"
    } ]
  }, {
    "tStartMs": 433900,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "이 70만 대"
    } ]
  }, {
    "tStartMs": 434540,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "딱 겹쳤죠"
    } ]
  }, {
    "tStartMs": 435650,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "인식 변화와 인구 구조적으로"
    } ]
  }, {
    "tStartMs": 438310,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "가장 높은 시기가 겹친 시기가"
    } ]
  }, {
    "tStartMs": 440660,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "딱 지금이고"
    } ]
  }, {
    "tStartMs": 441460,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "그래서 지금 앞으로 10년이"
    } ]
  }, {
    "tStartMs": 444130,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "기회다"
    } ]
  }, {
    "tStartMs": 444960,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "제 결론입니다"
    } ]
  }, {
    "tStartMs": 446050,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "제 결론입니다"
    } ]
  }, {
    "tStartMs": 447290,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "기가 막히게 70만명대의 인구가"
    } ]
  }, {
    "tStartMs": 450090,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "아직 유지되고 있는 상황에서"

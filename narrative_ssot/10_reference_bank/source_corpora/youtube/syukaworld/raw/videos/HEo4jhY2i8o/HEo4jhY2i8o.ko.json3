  }, {
    "tStartMs": 584320,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "이제 사랑을 하고"
    } ]
  }, {
    "tStartMs": 585170,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "결혼을 하고"
    } ]
  }, {
    "tStartMs": 585810,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "아이를 낳는 거에 대해서"
    } ]
  }, {
    "tStartMs": 586890,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "아직도 지원을 잘 못하고 있다"
    } ]
  }, {
    "tStartMs": 589300,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "아직도 그쪽으로 갈 수 있도록"
    } ]
  }, {
    "tStartMs": 591670,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "뭔가를 만들어야 되는데"
    } ]
  }, {
    "tStartMs": 593040,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "그게 잘 안 되고 있는 거죠"
    } ]
  }, {
    "tStartMs": 595610,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "반면에 30대 40대들이"
    } ]
  }, {
    "tStartMs": 596960,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "요즘 늘고 있기 때문에"
    } ]
  }, {
    "tStartMs": 598480,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "20대 엄마 감소 현상을"
    } ]
  }, {
    "tStartMs": 600090,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "어떻게 해결을 해야 될까를"
    } ]
  }, {
    "tStartMs": 603310,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "좀 고민을 해야 되지 않나 생각을 하고"
    } ]
  }, {
    "tStartMs": 606050,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "구체적으로 조금만 더 보여 드리면"
    } ]
  }, {
    "tStartMs": 607740,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "2025년 기준으로"
    } ]
  }, {
    "tStartMs": 609190,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "엄마의 나이별 출생아 수를 보면"
    } ]
  }, {
    "tStartMs": 611340,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "20에서 24세는 사실상"
    } ]
  }, {
    "tStartMs": 614660,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "너무 적어, 4700"
    } ]
  }, {
    "tStartMs": 616030,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "30대에 비하면 거의 1% 정도의"
    } ]
  }, {
    "tStartMs": 618700,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "비중밖에 안 되고"
    } ]
  }, {
    "tStartMs": 619900,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "20에서 24세가"
    } ]
  }, {
    "tStartMs": 621320,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "보다 40에서 44세가"
    } ]
  }, {
    "tStartMs": 623160,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "우리나라 3배 많습니다"
    } ]
  }, {
    "tStartMs": 624860,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "20년 뒤에 아이를 낳는 분들이 훨씬 많다는 거고"
    } ]
  }, {
    "tStartMs": 627290,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "25에서 29세보다"
    } ]
  }, {
    "tStartMs": 629220,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "35에서 39세가"
    } ]
  }, {
    "tStartMs": 630450,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "역시 2.4배가 많아요"
    } ]
  }, {
    "tStartMs": 632430,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "이 뒤로 갈수록"
    } ]
  }, {
    "tStartMs": 634340,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "이 아이를 많이 낳으신다는 건데"
    } ]
  }, {
    "tStartMs": 635900,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "그렇게밖에 될 수 없는"
    } ]
  }, {
    "tStartMs": 636810,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "이유 같은 거를 좀 잘"
    } ]
  }, {
    "tStartMs": 638370,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "따져봐야 되지 않을까"
    } ]
  }, {
    "tStartMs": 639370,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "생각이 들고"
    } ]
  }, {
    "tStartMs": 640510,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "그래프로 보여드리면"
    } ]
  }, {
    "tStartMs": 641780,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "연도별 출생아 엄마의 나이별 비중을 보면은"
    } ]
  }, {
    "tStartMs": 644770,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "20대 엄마가"
    } ]
  }, {
    "tStartMs": 645470,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "2000년에는 63%였는데"
    } ]
  }, {
    "tStartMs": 647900,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "2025년에 14%까지 줄어듭니다"
    } ]
  }, {
    "tStartMs": 650530,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "2005년에 크로스가 났고요"
    } ]
  }, {
    "tStartMs": 651820,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "지금은 30대 엄마 비중이"
    } ]
  }, {
    "tStartMs": 653330,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "79%, 엄청나게 높은"
    } ]
  }, {
    "tStartMs": 655300,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "80%를 차지하고 있고"
    } ]
  }, {
    "tStartMs": 657650,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "20대 산모의 압도적인 감소가"
    } ]
  }, {
    "tStartMs": 659380,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "출산율 하락의 주 원인 중의"
    } ]
  }, {
    "tStartMs": 661080,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "하나가 아닐까 생각이 되고"
    } ]
  }, {
    "tStartMs": 662910,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "그렇다 보니까"
    } ]
  }, {
    "tStartMs": 663790,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "출생아 수 반등도"
    } ]
  }, {
    "tStartMs": 664940,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "첫째에 집중이 됩니다"
    } ]
  }, {
    "tStartMs": 666690,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "첫째의 비중이 계속 올라가고"
    } ]
  }, {
    "tStartMs": 668050,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "둘째나 셋째의 비중이"
    } ]
  }, {
    "tStartMs": 669080,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "꾸준히 내려가고 있습니다"
    } ]
  }, {
    "tStartMs": 670820,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "아무래도 조금 빨리 낳아야"
    } ]
  }, {
    "tStartMs": 672810,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "둘째, 셋째도 생각할 수 있는데"
    } ]
  }, {
    "tStartMs": 674590,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "나중에 낳다 보면"
    } ]
  }, {
    "tStartMs": 675720,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "이거 생각하기 굉장히 힘들어지죠"
    } ]
  }, {
    "tStartMs": 677450,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "그래서 출생아 중에"
    } ]
  }, {
    "tStartMs": 678620,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "첫째와 둘째의 비중을 보면"
    } ]
  }, {
    "tStartMs": 680860,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "첫째의 비중이 지금 우리나라"
    } ]
  }, {
    "tStartMs": 683140,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "통계 역사상 가장 높습니다"
    } ]
  }, {
    "tStartMs": 684420,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "62%"
    } ]
  }, {
    "tStartMs": 685280,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "모든 아이들 중에"
    } ]
  }, {
    "tStartMs": 686630,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "62%가 첫째예요"
    } ]
  }, {
    "tStartMs": 687870,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "둘째, 셋째, 넷째, 다섯째"
    } ]
  }, {
    "tStartMs": 688910,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "다 합쳐도 38%밖에 안 됩니다"
    } ]
  }, {
    "tStartMs": 691040,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "형제, 자매, 남매의 비중이"
    } ]
  }, {
    "tStartMs": 693410,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "굉장히 내려가고 있는 게"
    } ]
  }, {
    "tStartMs": 694790,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "우리의 현재라고 할 수 있죠"
    } ]
  }, {
    "tStartMs": 696260,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "저는 답은 모르겠어요"
    } ]
  }, {
    "tStartMs": 697490,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "왜 그렇게 20대 때"
    } ]
  }, {
    "tStartMs": 699280,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "사랑과 연애, 결혼, 출산"
    } ]
  }, {
    "tStartMs": 700880,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "이런 걸 잘 못하냐"
    } ]
  }, {
    "tStartMs": 701960,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "개인적인 생각에 이것도 약간 있는 것 같아"
    } ]
  }, {
    "tStartMs": 703520,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "우리나라는 모든 것을 갖추고"
    } ]
  }, {
    "tStartMs": 705870,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "결혼을 해야 되는데"
    } ]
  }, {
    "tStartMs": 707460,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "좋건 싫건"
    } ]
  }, {
    "tStartMs": 708280,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "모든 것을 갖추는 데"
    } ]
  }, {
    "tStartMs": 709410,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "들어가는 시간이 점점 길어지죠"
    } ]
  }, {
    "tStartMs": 711820,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "누구나 아는 내용이니까"
    } ]
  }, {
    "tStartMs": 712750,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "초등학생적으로 얘기하자면"
    } ]
  }, {
    "tStartMs": 714600,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "이 갖추는데 들어가는 시간이"
    } ]
  }, {
    "tStartMs": 716090,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "점점점점 길어져요"
    } ]
  }, {
    "tStartMs": 717400,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "취업도 점점점점점 늦게 하고"
    } ]
  }, {
    "tStartMs": 719200,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "뭐도 점점점점 늦게 하고"
    } ]
  }, {
    "tStartMs": 720090,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "돈도 점점 늦게 벌고"
    } ]
  }, {
    "tStartMs": 721320,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "집값도 점점점점 올라가고 있어요"
    } ]
  }, {
    "tStartMs": 723710,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "그러다 보니까 이 모든 걸 갖추는데"
    } ]
  }, {
    "tStartMs": 725710,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "준비하는 데 걸리는 시간이"
    } ]
  }, {
    "tStartMs": 726960,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "점점점점 뒤로 가다 보니까"
    } ]
  }, {
    "tStartMs": 729490,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "그런 게 아닌가 생각이 되고"
    } ]
  }, {
    "tStartMs": 730910,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "그럼 너무 많이 들면"
    } ]
  }, {
    "tStartMs": 731920,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "둘째 같은 경우에"
    } ]
  }, {
    "tStartMs": 732680,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "출산이 더 어려울 수도 있고"
    } ]
  }, {
    "tStartMs": 733660,
    "dDurationMs": 580,
    "segs": [ {
      "utf8": "포기할 수도 있고"
    } ]
  }, {
    "tStartMs": 734240,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "이렇게 되죠"
    } ]
  }, {
    "tStartMs": 735240,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "그러면 두 가지 중에"
    } ]
  }, {
    "tStartMs": 736570,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "하나를 바꿔야 되죠"
    } ]
  }, {
    "tStartMs": 737560,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "모든 것을 갖추기 전에도"
    } ]
  }, {
    "tStartMs": 738800,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "결혼할 수 있는 문화를"
    } ]
  }, {
    "tStartMs": 740230,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "사회 분위기를 만들어주던가"
    } ]
  }, {
    "tStartMs": 741940,
    "dDurationMs": 4570,
    "segs": [ {
      "utf8": "아니면 갖추는 데 들어가는 시간을 줄여주던가"
    } ]
  }, {
    "tStartMs": 746510,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "이 두 가지 중에 하나를 해야 되는데"
    } ]
  }, {
    "tStartMs": 748580,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "정말 쉽지 않죠"
    } ]
  }, {
    "tStartMs": 749560,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "하지만 어쨌거나 해야 되는"
    } ]
  }, {
    "tStartMs": 751130,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "문제가 아닐까 생각을 합니다"
    } ]
  }, {
    "tStartMs": 752520,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "그래서 여기까지 다 아는 내용이니까"
    } ]
  }, {
    "tStartMs": 754290,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "제가 이번에 자료를 만들다가"
    } ]
  }, {
    "tStartMs": 756110,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "우리 20대 친구들"
    } ]
  }, {
    "tStartMs": 756940,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "아니면 대학생 친구들이"
    } ]
  }, {
    "tStartMs": 758390,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "연애를 좀 많이 하는 방법이 없을까?"
    } ]
  }, {
    "tStartMs": 760320,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "해외를 막 찾아봤어요"
    } ]
  }, {
    "tStartMs": 761310,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "쟤들은 뭘 연애를 하고"
    } ]
  }, {
    "tStartMs": 762670,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "뭐 없냐 그랬더니"
    } ]
  }, {
    "tStartMs": 763600,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "눈에 띄는 게 하나 있었는데"
    } ]
  }, {
    "tStartMs": 765060,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "지금 약간 딴 얘기입니다"
    } ]
  }, {
    "tStartMs": 766750,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "20대의 연애를 위한"
    } ]
  }, {
    "tStartMs": 768110,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "최고의 앱이 있다"
    } ]
  }, {
    "tStartMs": 769380,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "라는 기사가 있어서"
    } ]
  }, {
    "tStartMs": 770100,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "제가"
    } ]
  }, {
    "tStartMs": 771580,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "가서 봤어요"
    } ]
  }, {
    "tStartMs": 772570,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "최근 미국을 뜨겁게 달구고 있다"
    } ]
  }, {
    "tStartMs": 774130,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "그래서 가서 봤냐 했더니"
    } ]
  }, {
    "tStartMs": 775760,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "미국을 뜨겁게 달구진 않았고"
    } ]
  }, {
    "tStartMs": 777980,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "몇몇 대학을 뜨겁게 달구는 앱입니다"
    } ]
  }, {
    "tStartMs": 779940,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "미국까지는 아니고"
    } ]
  }, {
    "tStartMs": 781450,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "이게 무슨 내용이냐"
    } ]
  }, {
    "tStartMs": 783010,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "대학교에서 연애를 좀 이렇게 뭐 붐업시키는"
    } ]
  }, {
    "tStartMs": 785470,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "그런 앱이라고 하는데"
    } ]
  }, {
    "tStartMs": 786550,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "새학기 기분 좋은 봄바람에"
    } ]
  }, {
    "tStartMs": 787990,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "전국에서 모인 20대의 청춘들이 있어요"
    } ]
  }, {
    "tStartMs": 790660,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "자 이들한테서 뭔가 연애도 좀 잘하고"
    } ]
  }, {
    "tStartMs": 793000,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "많은 사람들을 만나게 하는 연결이죠 연결"
    } ]
  }, {
    "tStartMs": 795600,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "자기가 원하는 사람들끼리"
    } ]
  }, {
    "tStartMs": 796610,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "이렇게 연결을 잘하게 하는 게 뭐가 있냐"
    } ]
  }, {
    "tStartMs": 798700,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "그래서 요즘에 뜨고 있다는"
    } ]
  }, {
    "tStartMs": 800560,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "연애 상대 매칭"
    } ]
  }, {
    "tStartMs": 801900,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "광고 아닙니다 광고 아닙니다"
    } ]
  }, {
    "tStartMs": 803240,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "광고 아니에요"
    } ]
  }, {
    "tStartMs": 804290,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "매칭 플랫폼이라는"
    } ]
  }, {
    "tStartMs": 805320,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "'데이트 드롭'이라는 게 뜨고 있다고 합니다"
    } ]
  }, {
    "tStartMs": 807450,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "스탠퍼드 대학교에서"
    } ]
  }, {
    "tStartMs": 808410,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "지금 이게 굉장히 유명하다고 하는데"
    } ]
  }, {
    "tStartMs": 810430,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "5천명의 싱글을 짝 지어보자"
    } ]
  }, {
    "tStartMs": 811960,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "데이트드롭"
    } ]
  }, {
    "tStartMs": 812760,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "근데 소개팅 앱이 이거 많잖아"
    } ]
  }, {
    "tStartMs": 814740,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "뭐 뭐 이거 소개팅 앱은 많은데"
    } ]
  }, {
    "tStartMs": 816670,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "이걸 뭐 하려고"
    } ]
  }, {
    "tStartMs": 817330,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "또 소개를 하냐"
    } ]
  }, {
    "tStartMs": 819100,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "이 만든 사람은 이렇게 얘기해요"
    } ]
  }, {
    "tStartMs": 820810,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "많은 대학생들이"
    } ]
  }, {
    "tStartMs": 821690,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "현실의 구애를 부담스러워하고"
    } ]
  }, {
    "tStartMs": 823320,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "끝없이 스크롤 해야하는 데이팅 앱에 치쳐있다"
    } ]
  }, {
    "tStartMs": 825790,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "진지한 만남이 어렵고"
    } ]
  }, {
    "tStartMs": 826950,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "안전한 만남에 대한 욕구가 강하다"
    } ]
  }, {
    "tStartMs": 828950,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "그럼 뭐"
    } ]
  }, {
    "tStartMs": 829800,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "우리나라 듀오"
    } ]
  }, {
    "tStartMs": 832470,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "그런 거 하시면 되는데"
    } ]
  }, {
    "tStartMs": 833460,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "그거 잘 모르셔서 그런가"
    } ]
  }, {
    "tStartMs": 834820,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "이 앱을 만든 사람은"
    } ]
  }, {
    "tStartMs": 836100,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "이렇게 얘기를 합니다"
    } ]
  }, {
    "tStartMs": 837320,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "대학원생이 만들었대요"
    } ]
  }, {
    "tStartMs": 838500,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "역시 대학원생은 만능이죠"
    } ]
  }, {
    "tStartMs": 840200,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "모든 게 다 할 수 있는데"
    } ]
  }, {
    "tStartMs": 841360,
    "dDurationMs": 4010,
    "segs": [ {
      "utf8": "학생들에게 가치관, 생활방식, 정치적 견해 등"
    } ]
  }, {
    "tStartMs": 845370,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "66개 질문에 답을 하게 만들었다"
    } ]
  }, {
    "tStartMs": 847890,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "그게 무슨 소리냐면"
    } ]
  }, {
    "tStartMs": 849000,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "나한테 맞는 사람 찾기 위해서"
    } ]
  }, {
    "tStartMs": 850440,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "학생들한테 굉장히 자세한 질문을 던졌다고 합니다"
    } ]
  }, {
    "tStartMs": 853890,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "그래서 매칭 앱에 들어가면"
    } ]
  }, {
    "tStartMs": 854850,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "무려 66개 질문에 답을 해야 돼요"
    } ]
  }, {
    "tStartMs": 857580,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "가서 보시면"
    } ]
  }, {
    "tStartMs": 858550,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "질문이 상당히 깊이가 있습니다"
    } ]
  }, {
    "tStartMs": 860360,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "아이를 갖는 건"
    } ]
  }, {
    "tStartMs": 861330,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "만족스러운 삶에 꼭 필요하냐?"
    } ]
  }, {
    "tStartMs": 863200,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "1~7점"
    } ]
  }, {
    "tStartMs": 864360,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "가장 필요한 사람들은"
    } ]
  }, {
    "tStartMs": 865490,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "필요한 사람들끼리 만나게 하고"
    } ]
  }, {
    "tStartMs": 867200,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "가장 안 필요한 사람들은"
    } ]
  }, {
    "tStartMs": 868300,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "안 필요한 사람들끼리 만나게 하고"
    } ]
  }, {
    "tStartMs": 869950,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "이런 질문이 60개가 넘는다고 하는데"
    } ]
  }, {
    "tStartMs": 871660,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "그 질문을 보면"
    } ]
  }, {
    "tStartMs": 873330,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "나는 도널드 트럼프 대통령을 지지한다"
    } ]
  }, {
    "tStartMs": 876770,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "1~7"
    } ]
  }, {
    "tStartMs": 878170,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "나는 슈카월드를 자주 본다"
    } ]
  }, {
    "tStartMs": 880640,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "1~7"
    } ]
  }, {
    "tStartMs": 881780,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "뭐 이런 거 한다는 거죠"
    } ]
  }, {
    "tStartMs": 882830,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "아니면 전통적인 성 역할에 동의한다"
    } ]
  }, {
    "tStartMs": 885180,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "1~7"
    } ]
  }, {
    "tStartMs": 886280,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "뭐 이렇게 앞에서 면전에서"
    } ]
  }, {
    "tStartMs": 888610,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "보고 묻기는 어렵잖아요"
    } ]
  }, {
    "tStartMs": 889950,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "그런 어려운 거를"
    } ]
  }, {
    "tStartMs": 891190,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "다 질문을 한다는 거죠"
    } ]
  }, {
    "tStartMs": 892530,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "근데 이거는 비밀 유지 잘해야겠다"
    } ]
  }, {
    "tStartMs": 894720,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "비밀 유지 잘해야겠어"
    } ]
  }, {
    "tStartMs": 896350,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "약간 잘못 답했다가"
    } ]
  }, {
    "tStartMs": 897640,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "이거 퍼지기 시작하면"
    } ]
  }, {
    "tStartMs": 898700,
    "dDurationMs": 3410,
    "segs": [ {
      "utf8": "하여튼 질문 비밀 유지를 잘 한다는 과정 하에"
    } ]
  }, {
    "tStartMs": 902110,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "이런 걸 질문을 한 다음에"
    } ]
  }, {
    "tStartMs": 903800,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "이 앱의 특징이 뭐냐"
    } ]
  }, {
    "tStartMs": 904830,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "가장 큰 특징"
    } ]
  }, {
    "tStartMs": 905890,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "이렇게 매칭해주는 거냐"
    } ]
  }, {
    "tStartMs": 906750,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "매칭을 해주는데"
    } ]
  }, {
    "tStartMs": 907610,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "재미를 줘야 될 거 아니에요"
    } ]
  }, {
    "tStartMs": 908460,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "사람들한테 그래서 매주 화요일이 되면"
    } ]
  }, {
    "tStartMs": 911190,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "상대를 드랍해주거나"
    } ]
  }, {
    "tStartMs": 912830,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "추천해준다"
    } ]
  }, {
    "tStartMs": 914750,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "그러니까 무슨 장원 급제요 하듯이"
    } ]
  }, {
    "tStartMs": 916980,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "매주 화요일 날 빠바밤 하고"
    } ]
  }, {
    "tStartMs": 919180,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "스 탠퍼드 대학교 5천 명한테 쫙 뿌려준다는 거죠"
    } ]
  }, {
    "tStartMs": 922350,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "당신과 가장 어울리는 사람은 누굽니다?"
    } ]
  }, {
    "tStartMs": 924510,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "어서 대화를 나눠주세요"
    } ]
  }, {
    "tStartMs": 925410,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "그럼 모두가 다 이거 들면서"
    } ]
  }, {
    "tStartMs": 926570,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "야 누구여?"
    } ]
  }, {
    "tStartMs": 927400,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "야 누구여?"
    } ]
  }, {
    "tStartMs": 928420,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "넌 누구 나왔냐?"
    } ]
  }, {
    "tStartMs": 929450,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "이거 모두 몰려서"
    } ]
  }, {
    "tStartMs": 930560,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "이거 하느라고 정신이 없다는 건데"
    } ]
  }, {
    "tStartMs": 933020,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "야 5000명이면 2500대 2500명의"
    } ]
  }, {
    "tStartMs": 936620,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "사랑의 짝대기 하고 있는 거죠"
    } ]
  }, {
    "tStartMs": 938430,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "사랑의 짝대기지"
    } ]
  }, {
    "tStartMs": 939500,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "이게 뭐 이렇게"
    } ]
  }, {
    "tStartMs": 940490,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "사랑의 짝대기지"
    } ]
  }, {
    "tStartMs": 941650,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "어렵게 썼지만"
    } ]
  }, {
    "tStartMs": 942500,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "결국 2500명이"
    } ]
  }, {
    "tStartMs": 944030,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "야 누군지 한 명만 가리킬 텐데"
    } ]
  }, {
    "tStartMs": 946150,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "하여튼 사랑의 짝대기를 하면"
    } ]
  }, {
    "tStartMs": 947800,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "그 결과를 매주 화요일 날 뿌려준다는 겁니다"
    } ]
  }, {
    "tStartMs": 951240,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "그래서 스탠포드 대학교는"
    } ]
  }, {
    "tStartMs": 952800,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "매주 화요일 밤이 되면"
    } ]
  }, {
    "tStartMs": 954250,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "시끌벅적해 준대요"
    } ]
  }, {
    "tStartMs": 955790,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "알고리즘이 과연 나에게 누구를 골라줬냐"
    } ]
  }, {
    "tStartMs": 958560,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "기숙사 방 도서관에 모여갖고"
    } ]
  }, {
    "tStartMs": 961380,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "이렇게 본다는 거죠"
    } ]
  }, {
    "tStartMs": 962770,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "야, 너 누구냐?"
    } ]
  }, {
    "tStartMs": 963460,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "어?"
    } ]
  }, {
    "tStartMs": 965970,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "너도 걔냐?"
    } ]
  }, {
    "tStartMs": 966470,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "야 이러면 경쟁자가 되는 건가?"
    } ]
  }, {
    "tStartMs": 968920,
    "dDurationMs": 520,
    "segs": [ {
      "utf8": "모르겠네"
    } ]
  }, {
    "tStartMs": 969440,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "한 사람을 두 명한테 해줄 수 있는지"
    } ]
  }, {
    "tStartMs": 971220,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "하여튼 이래갖고"
    } ]
  }, {
    "tStartMs": 972080,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "이게 화제가 되면서"
    } ]
  }, {
    "tStartMs": 973660,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "시끌벅적해주면 되고요"
    } ]
  }, {
    "tStartMs": 975540,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "물론 약간 제 개인 생각에"
    } ]
  }, {
    "tStartMs": 977380,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "약간 부작용도 있을 것 같아요"
    } ]
  }, {
    "tStartMs": 979650,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "잘못하면 그 뭐 그런 건 없겠죠?"
    } ]
  }, {
    "tStartMs": 982580,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "AI가 잘하겠지 이게..."
    } ]
  }, {
    "tStartMs": 983850,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "이게 그쵸 이게 텅 비어오거나"
    } ]
  }, {
    "tStartMs": 988620,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "잘 없어야 되는데"
    } ]
  }, {
    "tStartMs": 989710,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "얘가 또 오류가 날 수 있잖아요"
    } ]
  }, {
    "tStartMs": 991110,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "오류가 날 수 있어서"
    } ]
  }, {
    "tStartMs": 992430,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "뭐 없다, 다음 주를 기다려주세요"
    } ]
  }, {
    "tStartMs": 994490,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "See you next week"
    } ]
  }, {
    "tStartMs": 995680,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "뭐 여러 가지"
    } ]
  }, {
    "tStartMs": 997720,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "이유가 있기 때문에"
    } ]
  }, {
    "tStartMs": 998950,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "걱정이 좀 있긴 한데"
    } ]
  }, {
    "tStartMs": 1000210,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "이 데이트드롭은"
    } ]
  }, {
    "tStartMs": 1001770,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "매주 나한테 매칭 상대"
    } ]
  }, {
    "tStartMs": 1003520,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "그리고 또 그 이유까지 보여준다고 합니다"
    } ]
  }, {
    "tStartMs": 1005170,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "당신의 파트너는 알렉스입니다"
    } ]
  }, {
    "tStartMs": 1007030,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "예상 궁합은 99.3%고요"
    } ]
  }, {
    "tStartMs": 1009330,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "궁합이 맞는 이유는"
    } ]
  }, {
    "tStartMs": 1010620,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "당신 자꾸 숏을 때려서 그래요"
    } ]
  }, {
    "tStartMs": 1012760,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "자꾸 매사에 롱하지 않고"
    } ]
  }, {
    "tStartMs": 1015370,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "숏하면 궁합이 99.3%고요"
    } ]
  }, {
    "tStartMs": 1018000,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "MBTI 우리로 이렇게 되겠죠?"
    } ]
  }, {
    "tStartMs": 1019810,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "잘 어울릴 걸로 보고 있습니다"
    } ]
  }, {
    "tStartMs": 1021750,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "그리고 둘한테 메시지가 따닥 갔으니까"
    } ]
  }, {
    "tStartMs": 1024270,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "화요일 밤 나머지는 여러분들이 해결하시면 됩니다"
    } ]
  }, {
    "tStartMs": 1027590,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "이제 데이트를 떠나세요"
    } ]
  }, {
    "tStartMs": 1029530,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "연락처 쫙 주고"
    } ]
  }, {
    "tStartMs": 1030530,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "메시지 쫙 주고 만나서"
    } ]
  }, {
    "tStartMs": 1032130,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "커피라도 마셔보세요"
    } ]
  }, {
    "tStartMs": 1033440,
    "dDurationMs": 580,
    "segs": [ {
      "utf8": "뭐 이렇게 온다"
    } ]
  }, {
    "tStartMs": 1034020,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "그러고 실제로"
    } ]
  }, {
    "tStartMs": 1035060,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "데이트 드랍 앱을 타깃으로 한"
    } ]
  }, {
    "tStartMs": 1037320,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "그런 카페도 운영한다고 합니다"
    } ]
  }, {
    "tStartMs": 1039330,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "샘포즈 대학교 내에 있는지 모르겠는데"
    } ]
  }, {
    "tStartMs": 1041110,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "내에 있겠죠 근처에 있겠죠"
    } ]
  }, {
    "tStartMs": 1042130,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "학생들이 \"여기에요\" 하면서"
    } ]
  }, {
    "tStartMs": 1045300,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "그래서 데이트드롭을 한 사람들은"
    } ]
  }, {
    "tStartMs": 1046840,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "이 카페로 가서"
    } ]
  }, {
    "tStartMs": 1047820,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "이렇게 좋은 시간을 보내는"
    } ]
  }, {
    "tStartMs": 1050260,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "물론 모두가 만족하는 건 아니라고 합니다"
    } ]
  }, {
    "tStartMs": 1052330,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "왜냐면 찍어준 상대가 좀"
    } ]
  }, {
    "tStartMs": 1054970,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "꽝일 수도 있잖아요"
    } ]
  }, {
    "tStartMs": 1056020,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "맘에 안 들 수도 있어"
    } ]
  }, {
    "tStartMs": 1057160,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "데이트드롭으로 너하고 어울려요 그랬는데"
    } ]
  }, {
    "tStartMs": 1059340,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "아잇 야 좀 아잇"
    } ]
  }, {
    "tStartMs": 1060610,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "야 이럴 수가 있어"
    } ]
  }, {
    "tStartMs": 1062170,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "아잇 흉하네 뭐 이럴 수 있잖아요"
    } ]
  }, {
    "tStartMs": 1063870,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "좋은 거구나"
    } ]
  }, {
    "tStartMs": 1064630,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "뭐 하여튼 그럴 수가 있으니까"
    } ]
  }, {
    "tStartMs": 1066720,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "그럼 다음주 기다리면 되는 거죠"
    } ]
  }, {
    "tStartMs": 1067740,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "모두가 만족하는건 아니지만"
    } ]
  }, {
    "tStartMs": 1069790,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "그리고 이 서비스는 특징이 있다 그럽니다"
    } ]
  }, {
    "tStartMs": 1071880,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "뭐가 있냐"
    } ]
  }, {
    "tStartMs": 1073100,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "추천 서비스가 있어"
    } ]
  }, {
    "tStartMs": 1075620,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "야 추천 서비스 너무한거 아니냐?"
    } ]
  }, {
    "tStartMs": 1077150,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "이거 무슨 소리냐면"
    } ]
  }, {
    "tStartMs": 1078410,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "사람들이 얘하고"
    } ]
  }, {
    "tStartMs": 1079220,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "얘 어울릴 것 같아요"
    } ]
  }, {
    "tStartMs": 1080250,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "라고 커플 후보"
    } ]
  }, {
    "tStartMs": 1081710,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "뭐 이런게 있대요"
    } ]
  }, {
    "tStartMs": 1082890,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "저도 안해봐서 모르겠는데"
    } ]
  }, {
    "tStartMs": 1084340,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "어 보고 있다가"
    } ]
  }, {
    "tStartMs": 1085230,
    "dDurationMs": 8120,
    "segs": [ {
      "utf8": "어?견우와 직녀는 좀 될 거 같은데"
    } ]
  }, {
    "tStartMs": 1093350,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "오"
    } ]
  }, {
    "tStartMs": 1094240,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "얼래리 꼴래리 윌슨은 그녀네 라고 하면은"
    } ]
  }, {
    "tStartMs": 1097290,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "이제 이렇게 사람들끼리"
    } ]
  }, {
    "tStartMs": 1099300,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "이렇게 잘 이렇게 해준다는 거죠"
    } ]
  }, {
    "tStartMs": 1102120,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "옆에 막 밥 사주면서"
    } ]
  }, {
    "tStartMs": 1103110,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "야 나 나 나 나"
    } ]
  }, {
    "tStartMs": 1104330,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "내가, 내가 윌슨 너"
    } ]
  }, {
    "tStartMs": 1105810,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "너 너 너가 윌슨이니 하면서"
    } ]
  }, {
    "tStartMs": 1106990,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "이렇게 막 이렇게 하면은"
    } ]
  }, {
    "tStartMs": 1108240,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "막 많은 모아서 이렇게 해주려고"
    } ]
  }, {
    "tStartMs": 1109690,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "이렇게 가고"
    } ]
  }, {
    "tStartMs": 1110930,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "뭐 그런 걸"
    } ]
  }, {
    "tStartMs": 1111490,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "야 이건 근데 약간 좀 문제가 있겠는데"
    } ]
  }, {
    "tStartMs": 1113220,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "한 10명 20명 모아갖고"
    } ]
  }, {
    "tStartMs": 1115690,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "제외 그러면은 이렇게"
    } ]
  }, {
    "tStartMs": 1117250,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "할 수 있기 때문에"
    } ]
  }, {
    "tStartMs": 1118140,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "하여튼 이게 확률이 얼마나 들어가는지 모르겠지만"
    } ]
  }, {
    "tStartMs": 1120230,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "이런 게 있다고 하고요"
    } ]
  }, {
    "tStartMs": 1121770,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "그래서 실제로 이 윌슨이"
    } ]
  }, {
    "tStartMs": 1124170,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "친구들한테 거시기 거시기 했더니"
    } ]
  }, {
    "tStartMs": 1126100,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "궁합점수 99.7%로 매칭이 되더라"
    } ]
  }, {
    "tStartMs": 1129260,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "나는 마음은 있었는데"
    } ]
  }, {
    "tStartMs": 1130310,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "말하지 못했는데"
    } ]
  }, {
    "tStartMs": 1131490,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "아유 뭐 궁합이 좋다"
    } ]
  }, {
    "tStartMs": 1132940,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "그러니까 누구야"
    } ]
  }, {
    "tStartMs": 1134400,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "내가 이렇게 매칭이 됐네"
    } ]
  }, {
    "tStartMs": 1136180,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "아 뭐 어때, 너는 괜찮아?"
    } ]
  }, {
    "tStartMs": 1137890,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "라고 물어볼 수 있는 핑계"
    } ]
  }, {
    "tStartMs": 1139520,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "아유 뭐 사귈래요?"
    } ]
  }, {
    "tStartMs": 1140930,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "이건 좀 어려우니까"
    } ]
  }, {
    "tStartMs": 1142980,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "데이트 드롭 때문에 잠깐 연락해봤어"
    } ]
  }, {
    "tStartMs": 1145060,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "어때 우리 커피 다 마실까?"
    } ]
  }, {
    "tStartMs": 1146380,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "하면서 자연스럽게 된다는 거고요"
    } ]
  }, {
    "tStartMs": 1148870,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "실제로 놀랍게도"
    } ]
  }, {
    "tStartMs": 1149810,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "이 윌슨이란 분이"
    } ]
  }, {
    "tStartMs": 1151200,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "월스트리트 저널에다가"
    } ]
  }, {
    "tStartMs": 1152420,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "본인의 사진을 올려서"
    } ]
  }, {
    "tStartMs": 1154720,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "그래 윌슨아 잘했다 잘했어 잘했어"
    } ]
  }, {
    "tStartMs": 1156880,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "얼굴 딱 보니까"
    } ]
  }, {
    "tStartMs": 1158490,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "친구들한테 잘할 것 같네"
    } ]
  }, {
    "tStartMs": 1159660,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "그래 잘했어 잘했어"
    } ]
  }, {
    "tStartMs": 1160300,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "굿잡 굿잡"
    } ]
  }, {
    "tStartMs": 1161070,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "오케이"
    } ]
  }, {
    "tStartMs": 1162020,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "친구가 이렇게 인터뷰했습니다"
    } ]
  }, {
    "tStartMs": 1163750,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "마치 내가 짜고"
    } ]
  }, {
    "tStartMs": 1165010,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "일을 억지로 성사시키려고 한 것처럼 보이게 됐는데"
    } ]
  }, {
    "tStartMs": 1167640,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "그런 건 아니었다"
    } ]
  }, {
    "tStartMs": 1168970,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "그런 건 아니었다 잘됐다"
    } ]
  }, {
    "tStartMs": 1170340,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "이렇게 인터뷰를 했고요"
    } ]
  }, {
    "tStartMs": 1172600,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "물론 좀 가슴 아픈 내용도 있었어요"
    } ]
  }, {
    "tStartMs": 1174620,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "저 기사를 읽어보면"
    } ]
  }, {
    "tStartMs": 1176270,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "고학번은 조금 별로 마음에 안 드신 것 같아요"
    } ]
  }, {
    "tStartMs": 1179490,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "기숙사 조교인 4학년 학생이 이렇게 썼습니다"
    } ]
  }, {
    "tStartMs": 1182860,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "학생들은 늘 누구와 매칭 되고 싶은지"
    } ]
  }, {
    "tStartMs": 1185190,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "매칭 되는지"
    } ]
  }, {
    "tStartMs": 1185800,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "자꾸 그런 얘기만 하는데"
    } ]
  }, {
    "tStartMs": 1187440,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "아휴 자꾸 공부를 해야지 말이야"
    } ]
  }, {
    "tStartMs": 1189240,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "학생들이 무슨 자꾸 매칭 얘기나 하고"
    } ]
  }, {
    "tStartMs": 1191670,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "공부를 해야지"
    } ]
  }, {
    "tStartMs": 1192410,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "공부를 안 하고"
    } ]
  }, {
    "tStartMs": 1193240,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "하여튼 뭐"
    } ]
  }, {
    "tStartMs": 1194630,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "이렇게 좀 뭐 안 좋은 것도 있고"
    } ]
  }, {
    "tStartMs": 1196520,
    "dDurationMs": 440,
    "segs": [ {
      "utf8": "좋은 것도 있고"
    } ]
  }, {
    "tStartMs": 1196960,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "안 좋은 것도 있지만"
    } ]
  }, {
    "tStartMs": 1198110,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "결론적으로 이 앱은"
    } ]
  }, {
    "tStartMs": 1199420,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "스탠포드 학생이 학부생이 7,500명이라는데"
    } ]
  }, {
    "tStartMs": 1202180,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "5,000명이 사용을 한답니다"
    } ]
  }, {
    "tStartMs": 1203410,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "5,000명이"
    } ]
  }, {
    "tStartMs": 1204700,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "이거 뭐야 5,000명은"
    } ]
  }, {
    "tStartMs": 1205940,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "커플들도 다 쓰는 거 아니야?"
    } ]
  }, {
    "tStartMs": 1208160,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "나는 커플이 있지만"
    } ]
  }, {
    "tStartMs": 1209390,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "데이트 드롭을 쓰겠다 할 거 아닌가"
    } ]
  }, {
    "tStartMs": 1211300,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "야 이거 뭐 7500명인데"
    } ]
  }, {
    "tStartMs": 1212540,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "5000명 있으면 어떡해"
    } ]
  }, {
    "tStartMs": 1214990,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "정글도 아니고"
    } ]
  }, {
    "tStartMs": 1215760,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "커플들은 빠져야지"
    } ]
  }, {
    "tStartMs": 1217140,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "하여튼 이렇게 해요"
    } ]
  }, {
    "tStartMs": 1218270,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "입소문을 많이 탔다고 그러고요"
    } ]
  }, {
    "tStartMs": 1219800,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "그래서 스탠포드에서 대박난 다음에"
    } ]
  }, {
    "tStartMs": 1221860,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "지금 콜롬비아대"
    } ]
  }, {
    "tStartMs": 1222890,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "프린스턴대, MIT"
    } ]
  }, {
    "tStartMs": 1224240,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "뭐 이렇게 10개 학교에 퍼지면서"
    } ]
  }, {
    "tStartMs": 1226030,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "지금 자금까지 유치해갖고"
    } ]
  }, {
    "tStartMs": 1227680,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "이 앱을 만든"
    } ]
  }, {
    "tStartMs": 1228920,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "우리 대학원생이 굉장히 잘 나가고 계시다"
    } ]
  }, {
    "tStartMs": 1231710,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "3주 만에 이 앱을 만들었다고 그럽니다"
    } ]
  }, {
    "tStartMs": 1233990,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "창업자로 지금 돌아섰다고 합니다"
    } ]
  }, {
    "tStartMs": 1236970,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "사실은 이 앱이 비슷한 앱이 있었죠"
    } ]
  }, {
    "tStartMs": 1238890,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "그게 뭡니까 원래는?"
    } ]
  }, {
    "tStartMs": 1240220,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "페이스북"
    } ]
  }, {
    "tStartMs": 1241440,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "페이스북도 처음 생긴 게"
    } ]
  }, {
    "tStartMs": 1243080,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "하버드 대학교 학생용 인맥 사이트였어요"
    } ]
  }, {
    "tStartMs": 1245990,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "하버드 학생들끼리 뭐 얘기를 해보자"
    } ]
  }, {
    "tStartMs": 1247870,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "그리고 저커버가 나중에 인터뷰하기를"
    } ]
  }, {
    "tStartMs": 1251180,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "물론 모든 학생이 한 곳에서 교류할 수 있는"
    } ]
  }, {
    "tStartMs": 1254300,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "온라인 공간들을 만들고 싶었다라고 얘기를 했지만"
    } ]
  }, {
    "tStartMs": 1257470,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "저 페이스북을 만든 이유 중에"
    } ]
  }, {
    "tStartMs": 1261750,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "데이트 용도로"
    } ]
  }, {
    "tStartMs": 1263300,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "데이트 용도로 만들었다는 걸"
    } ]
  }, {
    "tStartMs": 1264680,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "굳이 숨기지 않았다"
    } ]
  }, {
    "tStartMs": 1265960,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "제 친구들이 마음에 드는"
    } ]
  }, {
    "tStartMs": 1268290,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "하고 이렇게"
    } ]
  }, {
    "tStartMs": 1269550,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "연결하고 싶었는데"
    } ]
  }, {
    "tStartMs": 1270470,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "그게 어려워서 얘기를 했고"
    } ]
  }, {
    "tStartMs": 1272230,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "그래서 자기는 페이스북에 그 기능을 좀 해줬는데"
    } ]
  }, {
    "tStartMs": 1274720,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "본인은 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1276250,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "나는 인기가 좋아서"
    } ]
  }, {
    "tStartMs": 1277410,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "그럴 필요가 없었어요"
    } ]
  }, {
    "tStartMs": 1278560,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "저커버그..."
    } ]
  }, {
    "tStartMs": 1281170,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "...자신감이죠 자신감"
    } ]
  }, {
    "tStartMs": 1284330,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "그런 자신감 때문에"
    } ]
  }, {
    "tStartMs": 1285790,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "페이스북과 메타를 만들 수 있는"
    } ]
  }, {
    "tStartMs": 1287480,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "그런 빅테크의 창업자가"
    } ]
  }, {
    "tStartMs": 1289270,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "됐을 수 있지 않았을까 생각합니다"
    } ]
  }, {
    "tStartMs": 1290570,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "역시 형님의 그 자신감은 대단하지 않나?"
    } ]
  }, {
    "tStartMs": 1293510,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "저도 그렇게 생각해요"
    } ]
  }, {
    "tStartMs": 1294240,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "인기가 좋으셔서"
    } ]
  }, {
    "tStartMs": 1295370,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "아마 그러실 필요 없지 않았을까"
    } ]
  }, {
    "tStartMs": 1296900,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "생각을 합니다"
    } ]
  }, {
    "tStartMs": 1298910,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "그리고 이거 우리 자료 만드는 친구가 찾아왔는데"
    } ]
  }, {
    "tStartMs": 1301330,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "우리나라에도 비슷한 서비스가 있었대요"
    } ]
  }, {
    "tStartMs": 1303420,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "2025년 12월"
    } ]
  }, {
    "tStartMs": 1304930,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "연애담당관이라는 앱이 출시됐다"
    } ]
  }, {
    "tStartMs": 1307200,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "부산의 한 공무원분께서 만든"
    } ]
  }, {
    "tStartMs": 1308970,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "공직자 무료 소개팅 플랫폼"
    } ]
  }, {
    "tStartMs": 1311490,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "공무원과 공공기관 직원들이"
    } ]
  }, {
    "tStartMs": 1313920,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "가입 가능하고"
    } ]
  }, {
    "tStartMs": 1315210,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "가입하면 사랑의 짝대기를 날려서"
    } ]
  }, {
    "tStartMs": 1318050,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "성별, 거주지역, MBTI, 취미,"
    } ]
  }, {
    "tStartMs": 1320150,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "선호조건 등에서"
    } ]
  }, {
    "tStartMs": 1320940,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "사랑의 화살을 날려서"
    } ]
  }, {
    "tStartMs": 1323530,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "온라인 소개팅을 한다 그럽니다"
    } ]
  }, {
    "tStartMs": 1325230,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "전국 공무원, 공공기관, 공직자"
    } ]
  }, {
    "tStartMs": 1327680,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "7,000명이 가입이 돼 있다"
    } ]
  }, {
    "tStartMs": 1329250,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "뜨겁더라"
    } ]
  }, {
    "tStartMs": 1330360,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "왜냐하면 공무원분들이 자꾸"
    } ]
  }, {
    "tStartMs": 1332300,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "이동을 하잖아요"
    } ]
  }, {
    "tStartMs": 1333080,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "야근도 많이 하고"
    } ]
  }, {
    "tStartMs": 1333990,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "이동을 많이 하시니까"
    } ]
  }, {
    "tStartMs": 1335020,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "그 이동에 따라서"
    } ]
  }, {
    "tStartMs": 1336290,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "연애하기 쉽지 않은 분들이 있는데"
    } ]
  }, {
    "tStartMs": 1338090,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "그런 분들이 많이 사용하신다고 합니다"
    } ]
  }, {
    "tStartMs": 1340290,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "요즘에 지자체도 많이 하시죠"
    } ]
  }, {
    "tStartMs": 1341570,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "성남시 커넥터스"
    } ]
  }, {
    "tStartMs": 1343600,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "저도 이벤트 처음 봤는데"
    } ]
  }, {
    "tStartMs": 1344900,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "취향 기반"
    } ]
  }, {
    "tStartMs": 1345740,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "지역 청년 연결 프로그램"
    } ]
  }, {
    "tStartMs": 1347200,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "성남에 거주하는"
    } ]
  }, {
    "tStartMs": 1348770,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "미혼 남녀 150명"
    } ]
  }, {
    "tStartMs": 1349800,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "재직 거주"
    } ]
  }, {
    "tStartMs": 1350780,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "82년생에서 98년생"
    } ]
  }, {
    "tStartMs": 1352110,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "자영업 ・ 프리랜서 오케이"
    } ]
  }, {
    "tStartMs": 1353480,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "3월 13일까지"
    } ]
  }, {
    "tStartMs": 1355010,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "성남시에 계시는"
    } ]
  }, {
    "tStartMs": 1356610,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "우리 재직 미혼남녀분들"
    } ]
  }, {
    "tStartMs": 1358500,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "거주 ・ 재직하는 미혼남녀분들"
    } ]
  }, {
    "tStartMs": 1360300,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "커넥터스 가시면  또"
    } ]

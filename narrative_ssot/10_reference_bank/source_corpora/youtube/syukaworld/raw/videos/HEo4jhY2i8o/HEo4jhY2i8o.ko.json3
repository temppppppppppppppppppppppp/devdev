  }, {
    "tStartMs": 522400,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "2000년 대비"
    } ]
  }, {
    "tStartMs": 523650,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "엄마의 나이별 출생한 수를 보면"
    } ]
  }, {
    "tStartMs": 525960,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "10대는 92% 줄었고"

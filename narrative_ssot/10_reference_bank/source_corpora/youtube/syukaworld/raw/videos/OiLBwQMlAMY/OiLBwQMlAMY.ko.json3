  } ],
  "events": [ {
    "tStartMs": 7840,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "높은 유가에 흔들리는"
    } ]
  }, {
    "tStartMs": 9240,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "국가들 얘기를 한번 해보도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 11160,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "놀랍게도 오늘은"
    } ]
  }, {
    "tStartMs": 12260,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "산유국들이 최근에 높은 유가 때문에"
    } ]
  }, {
    "tStartMs": 14380,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "고생을 하고 있다라는"
    } ]
  }, {
    "tStartMs": 15610,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "내용을 드릴 거예요"
    } ]
  }, {
    "tStartMs": 16470,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "그게 무슨 말이냐?"
    } ]
  }, {
    "tStartMs": 17580,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "보시면 압니다"
    } ]
  }, {
    "tStartMs": 18500,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "영상을 보시면 압니다"
    } ]
  }, {
    "tStartMs": 19740,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "자, 한번 힘차게 시작을 해보죠"
    } ]
  }, {
    "tStartMs": 21570,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "자 일단 전쟁 전에"
    } ]
  }, {
    "tStartMs": 23240,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "우리가 우려했던 대로"
    } ]
  }, {
    "tStartMs": 24070,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "여러분들 모두 다 아시겠지만"
    } ]
  }, {
    "tStartMs": 25340,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "이란의 호르무즈해협이 사실상 봉쇄되었죠"
    } ]
  }, {
    "tStartMs": 28010,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "이젠 뭐 다 알고 있습니다"
    } ]
  }, {
    "tStartMs": 29700,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "봉쇄될지 안 될지가"
    } ]
  }, {
    "tStartMs": 31230,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "전쟁 전에는 이슈였는데"
    } ]
  }, {
    "tStartMs": 33130,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "막상 전쟁을 해보니까"
    } ]
  }, {
    "tStartMs": 34520,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "실제로 봉쇄가 되었죠"
    } ]
  }, {
    "tStartMs": 36810,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "전쟁 전에는 미국과 이란이 전쟁을 해도"
    } ]
  }, {
    "tStartMs": 39330,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "호르무즈 해협이 봉쇄가 안 될 수도 있지 않을까라는"
    } ]
  }, {
    "tStartMs": 42010,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "기대를 했었어요"
    } ]
  }, {
    "tStartMs": 43040,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "지금은 다 잊어먹으셨겠지만"
    } ]
  }, {
    "tStartMs": 44780,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "그게 봉쇄가 되냐 안 되냐가 이슈였는데"
    } ]
  }, {
    "tStartMs": 47900,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "지금은 봉쇄가 됐습니다"
    } ]
  }, {
    "tStartMs": 49440,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "자 그럼 이제 어떤 일이 펼쳐질지"
    } ]
  }, {
    "tStartMs": 51330,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "말씀드리도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 52800,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "자 일단 전 세계"
    } ]
  }, {
    "tStartMs": 53630,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "해상석유 교육량의"
    } ]
  }, {
    "tStartMs": 55090,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "4분의 1, 25%가 막혔다"
    } ]
  }, {
    "tStartMs": 57360,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "이건 다 알고 있죠"
    } ]
  }, {
    "tStartMs": 58530,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "지금 유가가 얼마냐?"
    } ]
  }, {
    "tStartMs": 59890,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "브랜트유 기준으로 112달러까지 올라갔어요"
    } ]
  }, {
    "tStartMs": 63330,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "마지막 봤을 때 112달러였습니다"
    } ]
  }, {
    "tStartMs": 65780,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "109에서 110이 왔다 갔다 하던데"
    } ]
  }, {
    "tStartMs": 67980,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "110달러를 넘었어요"
    } ]
  }, {
    "tStartMs": 69830,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "브랜트유가 얼마 전에 60달러여서"
    } ]
  }, {
    "tStartMs": 71440,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "연초에 60달러였거든요"
    } ]
  }, {
    "tStartMs": 72870,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "대충 70%가 올랐습니다"
    } ]
  }, {
    "tStartMs": 76350,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "이거 많이 오른다 많이 올라"
    } ]
  }, {
    "tStartMs": 77360,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "70%가 올랐는데"
    } ]
  }, {
    "tStartMs": 79450,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "게다가 유가가 오르니까"
    } ]
  }, {
    "tStartMs": 80690,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "또 문제가 되는 게 있어요"
    } ]
  }, {
    "tStartMs": 82380,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "그건 뭐냐? 항공유입니다"
    } ]
  }, {
    "tStartMs": 84900,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "여러분들 해외여행 가격이"
    } ]
  }, {
    "tStartMs": 86560,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "실시간으로 올라가고 있다고 보시면 됩니다"
    } ]
  }, {
    "tStartMs": 89600,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "이미 최소 10만 단위 때가 올라갔을 거예요"
    } ]
  }, {
    "tStartMs": 92780,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "여러분들이 사고자 하는"
    } ]
  }, {
    "tStartMs": 94190,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "비행기 표 가격이"
    } ]
  }, {
    "tStartMs": 95720,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "최소 10만 단위 이상 올라갔습니다"
    } ]
  }, {
    "tStartMs": 97860,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "가서 이제 보십시오"
    } ]
  }, {
    "tStartMs": 99210,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "항공유 가격이 지금"
    } ]
  }, {
    "tStartMs": 100280,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "배럴당 200달러를 돌파했거든요"
    } ]
  }, {
    "tStartMs": 102460,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "따블이라는 소리입니다 따블"
    } ]
  }, {
    "tStartMs": 103690,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "여기가 100이었어요"
    } ]
  }, {
    "tStartMs": 104960,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "사상 최고 가격을 경신하는 중입니다"
    } ]
  }, {
    "tStartMs": 108010,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "물론 지역에 따라 다르지만"
    } ]
  }, {
    "tStartMs": 109850,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "게다가 저런 휘발유나 등유"
    } ]
  }, {
    "tStartMs": 111950,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "이런 석화제품을 수출하는 국가들이"
    } ]
  }, {
    "tStartMs": 114560,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "수출량을 또 제한을 합니다"
    } ]
  }, {
    "tStartMs": 116600,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "대표적인 나라가 중국과 한국이 있어요"
    } ]
  }, {
    "tStartMs": 119940,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "근데 이 두 나라는 사실 할 말은 있어"
    } ]
  }, {
    "tStartMs": 123150,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "아니 원유가 수입을 해서"
    } ]
  }, {
    "tStartMs": 124790,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "그 원유에서 석화제품을 만드는데"
    } ]
  }, {
    "tStartMs": 127420,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "원유가 수입이 안 되는데"
    } ]
  }, {
    "tStartMs": 128510,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "어떻게 해?"
    } ]
  }, {
    "tStartMs": 129260,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "중국 같은 경우에는"
    } ]
  }, {
    "tStartMs": 130590,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "전쟁 직후에 항공유로 포함한"
    } ]
  }, {
    "tStartMs": 132210,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "정제 석유 수출 제품을 제한했습니다"
    } ]
  }, {
    "tStartMs": 135270,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "그리고 대한민국도 내수 수요를 우선하기 위해서"
    } ]
  }, {
    "tStartMs": 137650,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "일부 휘발유와 경유 제품의 수출을 제한했어요"
    } ]
  }, {
    "tStartMs": 141340,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "예를 들면"
    } ]
  }, {
    "tStartMs": 142120,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "우리나라 정부는 얼마 전에"
    } ]
  }, {
    "tStartMs": 143580,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "국내 공급 우선을 위해서"
    } ]
  }, {
    "tStartMs": 144870,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "수출 자재를 촉구했습니다"
    } ]
  }, {
    "tStartMs": 147160,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "그래서 국내 주요 기업들이"
    } ]
  }, {
    "tStartMs": 148490,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "수출 물량을 줄이고"
    } ]
  }, {
    "tStartMs": 149800,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "국내 공급 비중을"
    } ]
  }, {
    "tStartMs": 150770,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "최대 2배로 늘리겠다고 밝혔어요"
    } ]
  }, {
    "tStartMs": 153140,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "아까도 말씀드렸지만"
    } ]
  }, {
    "tStartMs": 153980,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "원유가 수입되지 않는데"
    } ]
  }, {
    "tStartMs": 155300,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "이 석화제품을 어떻게 만들어서"
    } ]
  }, {
    "tStartMs": 156860,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "어떻게 수출을 해?"
    } ]
  }, {
    "tStartMs": 158340,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "일단 우리나라가 먼저 쓰겠다"
    } ]
  }, {
    "tStartMs": 160120,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "뭐 이런 거죠"
    } ]
  }, {
    "tStartMs": 160760,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "국내 내수에 먼저 쓰겠다"
    } ]
  }, {
    "tStartMs": 162120,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "우리 코가 석자다"
    } ]
  }, {
    "tStartMs": 163520,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "다 좋긴 좋아요"
    } ]
  }, {
    "tStartMs": 164970,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "우리는 나쁘지 않은데"
    } ]
  }, {
    "tStartMs": 166330,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "이것 때문에 충격을 받는 나라들이 있다가"
    } ]
  }, {
    "tStartMs": 169030,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "오늘의 주제입니다"
    } ]
  }, {
    "tStartMs": 170360,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "잘 생각해보면"
    } ]
  }, {
    "tStartMs": 171490,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "수출 물량을 줄였잖아요"
    } ]
  }, {
    "tStartMs": 173160,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "중국과 대한민국이"
    } ]
  }, {
    "tStartMs": 174620,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "대표적인 석화 대국입니다"
    } ]
  }, {
    "tStartMs": 176720,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "석유화 대국이에요"
    } ]
  }, {
    "tStartMs": 178490,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "그런 나라들이 수출을 줄인 거잖아요"
    } ]
  }, {
    "tStartMs": 181200,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "자, 예를 들면"
    } ]
  }, {
    "tStartMs": 182240,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "이렇게 생각할 수 있어요"
    } ]
  }, {
    "tStartMs": 183090,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "우리나라는 원유 생산국도 아닌데"
    } ]
  }, {
    "tStartMs": 184900,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "우리나라가 뭐 석유화학 제품 수출 줄인다고"
    } ]
  }, {
    "tStartMs": 187390,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "무슨 일이 일어나겠습니까?"
    } ]
  }, {
    "tStartMs": 189630,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "방금 말씀드렸지만"
    } ]
  }, {
    "tStartMs": 191070,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "대한민국은"
    } ]
  }, {
    "tStartMs": 191890,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "주요 화학 제품 수출"
    } ]
  }, {
    "tStartMs": 193380,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "세계 TOP5에 들어간 나라입니다"
    } ]
  }, {
    "tStartMs": 195840,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "TOP4급이에요"
    } ]
  }, {
    "tStartMs": 197440,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "물론 중국도 수출을 많이 하지만"
    } ]
  }, {
    "tStartMs": 198880,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "아까 전에 중국이 수출 제한을 걸었죠"
    } ]
  }, {
    "tStartMs": 200840,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "1등과 4등도 수출 제한을 걸었죠"
    } ]
  }, {
    "tStartMs": 203810,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "독일은 당연히 유럽, EU 근처에 있는 데를"
    } ]
  }, {
    "tStartMs": 206260,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "커버하는 나라고"
    } ]
  }, {
    "tStartMs": 207310,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "미국도 뭐 당연히 서방구하고"
    } ]
  }, {
    "tStartMs": 209390,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "유럽 쪽 왔다 갔다 하는 나라죠"
    } ]
  }, {
    "tStartMs": 210820,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "아시아 쪽은 중국과 주로"
    } ]
  }, {
    "tStartMs": 213610,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "우리나라가 커버를 많이 합니다"
    } ]
  }, {
    "tStartMs": 214990,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "물론 일본도 좀 있지만"
    } ]
  }, {
    "tStartMs": 216330,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "세계 탑 1과 탑 4 국가들이"
    } ]
  }, {
    "tStartMs": 218810,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "석화 제품을 수출 제한을 건 거죠"
    } ]
  }, {
    "tStartMs": 220990,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "물론 원료가 안 들어와서 그렇긴 하지만"
    } ]
  }, {
    "tStartMs": 222850,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "게다가 우리나라는"
    } ]
  }, {
    "tStartMs": 224190,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "세계 항공유 수출에서"
    } ]
  }, {
    "tStartMs": 225560,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "몇 위인지 아십니까?"
    } ]
  }, {
    "tStartMs": 227550,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "1위 국가입니다"
    } ]
  }, {
    "tStartMs": 229600,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "우리나라가 항공유 수출 1위 국가예요"
    } ]
  }, {
    "tStartMs": 232450,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "그것도 꽤 큰 차이로 1위 국가예요"
    } ]
  }, {
    "tStartMs": 235000,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "우리나라가 항공유가 나냐?"
    } ]
  }, {
    "tStartMs": 236240,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "안 나지 안 나지"
    } ]
  }, {
    "tStartMs": 238160,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "당연히 기름 한 방울이 안 나는데"
    } ]
  }, {
    "tStartMs": 241300,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "저기 동해바다에서 쬐끔은 나는구나"
    } ]
  }, {
    "tStartMs": 242810,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "거의 안 나는데"
    } ]
  }, {
    "tStartMs": 243840,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "어떻게 항공유 수출 1위 국가냐?"
    } ]
  }, {
    "tStartMs": 245430,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "당연히 원유를 갖고 와서"
    } ]
  }, {
    "tStartMs": 247560,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "우리가 석화 정제한 다음에 파는 거죠"
    } ]
  }, {
    "tStartMs": 249540,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "우리나라 항공유가 품질이 좋기로 유명합니다"
    } ]
  }, {
    "tStartMs": 252440,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "게다가 요즘에 또 뭡니까?"
    } ]
  }, {
    "tStartMs": 253790,
    "dDurationMs": 470,
    "segs": [ {
      "utf8": "뭐라 그러죠?"
    } ]
  }, {
    "tStartMs": 254260,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "아 NAF인가?"
    } ]
  }, {
    "tStartMs": 254950,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "제가 갑자기 용어는 기억이 안 나는데"
    } ]
  }, {
    "tStartMs": 256910,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "환경오염을 줄이는 항공유?"
    } ]
  }, {
    "tStartMs": 258700,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "이런 거 수출이 대세이기 때문에"
    } ]
  }, {
    "tStartMs": 260710,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "대한민국이 수출 1위 국가예요"
    } ]
  }, {
    "tStartMs": 262150,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "그 말인즉슨 한국이 셔터문을 내리면"
    } ]
  }, {
    "tStartMs": 265330,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "세계 항공유 가격은"
    } ]
  }, {
    "tStartMs": 266860,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "춤출 수밖에 없어요"
    } ]
  }, {
    "tStartMs": 268900,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "아니 1위는 내가 문을 닫았단 말이야"
    } ]
  }, {
    "tStartMs": 271100,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "문을 닫은 건 아니지"
    } ]
  }, {
    "tStartMs": 272500,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "줄이겠다라고 해야 하는 거죠"
    } ]
  }, {
    "tStartMs": 274110,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "우리 비행기 먼저 좀 쓰고"
    } ]
  }, {
    "tStartMs": 275380,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "예를 들면 그런 겁니다"
    } ]
  }, {
    "tStartMs": 276510,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "자, 그러니까 이제 춤을 추는데"
    } ]
  }, {
    "tStartMs": 278620,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "그렇기 때문에 전세계 항공사들은"
    } ]
  }, {
    "tStartMs": 280810,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "일제히 지금 가격 인상을 선언을 했고"
    } ]
  }, {
    "tStartMs": 283540,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "비행편 축소를 발표하고 있습니다"
    } ]
  }, {
    "tStartMs": 285730,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "가격 인상의 문제가 아니라"
    } ]
  }, {
    "tStartMs": 287290,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "비행편 축소가 더 문제죠"
    } ]
  }, {
    "tStartMs": 288920,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "전쟁이 길어질 경우에"
    } ]
  }, {
    "tStartMs": 290040,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "항공유가 부족해서"
    } ]
  }, {
    "tStartMs": 291420,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "비행편이 급격하게 감소할 수 있다"
    } ]
  }, {
    "tStartMs": 294320,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "가장 대표적인 나라가 어디냐? 어디겠습니까?"
    } ]
  }, {
    "tStartMs": 297880,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "아까 전에 우리나라하고"
    } ]
  }, {
    "tStartMs": 298900,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "중국이 보통 어디를 커버한다고요?"
    } ]
  }, {
    "tStartMs": 300540,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "아시아 쪽을 많이 커버하잖아요"
    } ]
  }, {
    "tStartMs": 302060,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "아시아 중에서도"
    } ]
  }, {
    "tStartMs": 303190,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "일단 호주는 발등에 불이 떨어졌습니다"
    } ]
  }, {
    "tStartMs": 306460,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "호주가 아시아냐?"
    } ]
  }, {
    "tStartMs": 307810,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "아시아죠 아시아죠 어쨌건"
    } ]
  }, {
    "tStartMs": 309640,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "어쨌건 저 적도 아래에 있지만"
    } ]
  }, {
    "tStartMs": 310750,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "어쨌건 아시아잖아요"
    } ]
  }, {
    "tStartMs": 312140,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "아니, 아니 한국아"
    } ]
  }, {
    "tStartMs": 313650,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "석유 제품 수출을 너희가 막으면 어떡해"
    } ]
  }, {
    "tStartMs": 316260,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "호주는 항공유의 90%를 수입합니다"
    } ]
  }, {
    "tStartMs": 319150,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "지금 재고량이 32일치야"
    } ]
  }, {
    "tStartMs": 321530,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "거의 대부분을 당연하겠지만"
    } ]
  }, {
    "tStartMs": 323110,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "아시아에서 수입해요"
    } ]
  }, {
    "tStartMs": 324300,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "우리나라나 일본 그런 데서 수입합니다"
    } ]
  }, {
    "tStartMs": 326460,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "게다가 호주는 선진국 중에서 그동안"
    } ]
  }, {
    "tStartMs": 329200,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "석유 비축일수가 낮은 나라에 속합니다"
    } ]
  }, {
    "tStartMs": 332030,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "아주 낮아요"
    } ]
  }, {
    "tStartMs": 333330,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "저도 이번에 알았는데"
    } ]
  }, {
    "tStartMs": 334710,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "방심했던 것 같아요"
    } ]
  }, {
    "tStartMs": 336190,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "우리나라가 200일 비축하고 있다"
    } ]
  }, {
    "tStartMs": 337960,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "이런 표현 쓰잖아요"
    } ]
  }, {
    "tStartMs": 338980,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "일본도 한 200일 언저리다"
    } ]
  }, {
    "tStartMs": 340930,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "호주는 32일이래"
    } ]
  }, {
    "tStartMs": 342620,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "32일"
    } ]
  }, {
    "tStartMs": 344100,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "비축일도 낮아"
    } ]
  }, {
    "tStartMs": 345250,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "안 그래도 그런데"
    } ]
  }, {
    "tStartMs": 346940,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "석화제품 수출하는 국가들은"
    } ]
  }, {
    "tStartMs": 348490,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "또 수출도 막는다 그러고"
    } ]
  }, {
    "tStartMs": 350260,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "물론 여러분들이 생각하기에"
    } ]
  }, {
    "tStartMs": 351590,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "호주 같은 경우에"
    } ]
  }, {
    "tStartMs": 352890,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "세계적인 에너지 생산 대국이"
    } ]
  }, {
    "tStartMs": 354620,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "아니냐라고 생각하는 분들이 있어요"
    } ]
  }, {
    "tStartMs": 356940,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "당연히 호주는 석탄, 구리"
    } ]
  }, {
    "tStartMs": 359460,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "말이 필요 없죠"
    } ]
  }, {
    "tStartMs": 360250,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "세계적인 에너지와 자원 생산 대국이긴 한데"
    } ]
  }, {
    "tStartMs": 362830,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "뭐가 없습니까?"
    } ]
  }, {
    "tStartMs": 364320,
    "dDurationMs": 490,
    "segs": [ {
      "utf8": "뭐가 없어요?"
    } ]
  }, {
    "tStartMs": 364810,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "이거 오늘의 주제입니다"
    } ]
  }, {
    "tStartMs": 365950,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "정유시설이 잘 없어요"
    } ]
  }, {
    "tStartMs": 367910,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "그러니까 우리로 치면"
    } ]
  }, {
    "tStartMs": 368940,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "대규모 NCC들"
    } ]
  }, {
    "tStartMs": 371010,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "여천 NCC 우리 그런 데 있죠?"
    } ]
  }, {
    "tStartMs": 372620,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "대규모 석유화학시설이 잘 없습니다"
    } ]
  }, {
    "tStartMs": 375570,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "모든 나라마다 있을 것 같죠?"
    } ]
  }, {
    "tStartMs": 377230,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "그렇지 않습니다"
    } ]
  }, {
    "tStartMs": 378150,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "대규모 석유화학시설을 가지고 있는"
    } ]
  }, {
    "tStartMs": 380210,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "나라가 많지 않고"
    } ]
  }, {
    "tStartMs": 381450,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "가지고 있다 그래도 자국 생산량도"
    } ]
  }, {
    "tStartMs": 384330,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "제대로 커버하지 못하는 나라가 대부분입니다"
    } ]
  }, {
    "tStartMs": 386780,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "호주에는 지금 정유시설이 단 두 곳 남아있는데"
    } ]
  }, {
    "tStartMs": 389440,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "이 호주 전체가 사용하는"
    } ]
  }, {
    "tStartMs": 391060,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "국가 수요의 20% 미만만"
    } ]
  }, {
    "tStartMs": 393180,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "해결할 수 있다라고"
    } ]
  }, {
    "tStartMs": 393990,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "얘기하고 있어요"
    } ]
  }, {
    "tStartMs": 394880,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "한 자리 퍼센트 얘기하는 곳도 많습니다"
    } ]
  }, {
    "tStartMs": 397020,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "거의 90%를 모두 다"
    } ]
  }, {
    "tStartMs": 399770,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "한국과 일본에서 수입해야 되는 거예요"
    } ]
  }, {
    "tStartMs": 402000,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "근데 우리나라는 어쩔 수 없지만"
    } ]
  }, {
    "tStartMs": 403900,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "셔터 내리고 있잖아요"
    } ]
  }, {
    "tStartMs": 405120,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "셔터를 내리고 있단 말이에요"
    } ]
  }, {
    "tStartMs": 406720,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "그래서 호주 총리가 이렇게 얘기를 했습니다"
    } ]
  }, {
    "tStartMs": 409880,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "호주는 지금부터"
    } ]
  }, {
    "tStartMs": 411190,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "만반의 대비가 필요한 시점이다"
    } ]
  }, {
    "tStartMs": 414180,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "우리도 도와드리고 싶은데"
    } ]
  }, {
    "tStartMs": 415410,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "뭐 별 수 없어요"
    } ]
  }, {
    "tStartMs": 416140,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "뭐 어떻게 해"
    } ]
  }, {
    "tStartMs": 416830,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "원료가 들어와야 뭘 만들던지"
    } ]
  }, {
    "tStartMs": 418820,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "호주 총리가 뭘 하고 있냐"
    } ]
  }, {
    "tStartMs": 420010,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "우리는 너무나 잘 알 수 있습니다"
    } ]
  }, {
    "tStartMs": 421600,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "호주가 뭘 할지"
    } ]
  }, {
    "tStartMs": 422360,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "이런 거 하고 있습니다"
    } ]
  }, {
    "tStartMs": 423690,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "아직 공급 부족이 현실화된 것도 아닌데"
    } ]
  }, {
    "tStartMs": 426080,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "벌써 이 동네 주유소에서"
    } ]
  }, {
    "tStartMs": 427470,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "중동발 연료로"
    } ]
  }, {
    "tStartMs": 428830,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "가격을 올리고 있어"
    } ]
  }, {
    "tStartMs": 430020,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "아직 도착도 안 하고 있는데"
    } ]
  }, {
    "tStartMs": 431610,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "라고 지금 호주 총리께서"
    } ]
  }, {
    "tStartMs": 433370,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "화를 내시고 있는데"
    } ]
  }, {
    "tStartMs": 435020,
    "dDurationMs": 570,
    "segs": [ {
      "utf8": "되게"
    } ]
  }, {
    "tStartMs": 435590,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "뭐 우린 충분히 잘 알 수 있고요"
    } ]
  }, {
    "tStartMs": 437950,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "그리고 말이야"
    } ]
  }, {
    "tStartMs": 438850,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "지금 갑자기 수요가 굉장히 급등을 했다"
    } ]
  }, {
    "tStartMs": 441880,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "아니 수요가 급증할 이유는 없잖아"
    } ]
  }, {
    "tStartMs": 443630,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "평상시처럼 사용해야지"
    } ]
  }, {
    "tStartMs": 445090,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "왜 급증을 하냐"
    } ]
  }, {
    "tStartMs": 446390,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "한마디로 이건 뭐다?"
    } ]
  }, {
    "tStartMs": 448380,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "사재기 아니야?"
    } ]
  }, {
    "tStartMs": 449790,
    "dDurationMs": 630,
    "segs": [ {
      "utf8": "사재기"
    } ]
  }, {
    "tStartMs": 450420,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "국민 여러분"
    } ]
  }, {
    "tStartMs": 451520,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "필요한 양보다 많이 사지 마십시오"
    } ]
  }, {
    "tStartMs": 453720,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "이것이 여러분들이 도울 수 있는 방법입니다"
    } ]
  }, {
    "tStartMs": 455870,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "다른 사람들을 생각하세요"
    } ]
  }, {
    "tStartMs": 457490,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "주유소 하는 분들"
    } ]
  }, {
    "tStartMs": 458590,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "과도하게 사재기하고"
    } ]
  }, {
    "tStartMs": 460060,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "과도하게 가격 올리지 마세요"
    } ]
  }, {
    "tStartMs": 461690,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "호주 소비자 보호원"
    } ]
  }, {
    "tStartMs": 463460,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "ACCC가"
    } ]
  }, {
    "tStartMs": 464790,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "여러분들한테 떼찌 떼찌 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 467220,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "라고 얘기하고 있는 게"
    } ]
  }, {
    "tStartMs": 468610,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "지금 이제 호주라고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 471460,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "게다가 호주만 그러냐"
    } ]
  }, {
    "tStartMs": 473600,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "아시아 국가들은 대부분 비슷한데요"
    } ]
  }, {
    "tStartMs": 475620,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "여러분들 아마 이런 뉴스 보셨을 거예요"
    } ]
  }, {
    "tStartMs": 478300,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "베트남이 한국과 일본에"
    } ]
  }, {
    "tStartMs": 480100,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "석유 공급을 요청했다"
    } ]
  }, {
    "tStartMs": 482230,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "뉴스 보셨을 겁니다"
    } ]
  }, {
    "tStartMs": 483460,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "한국과 일본은"
    } ]
  }, {
    "tStartMs": 484900,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "석유가 안 나는 나라예요"
    } ]
  }, {
    "tStartMs": 486420,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "나더라도 찔끔 나잖아"
    } ]
  }, {
    "tStartMs": 488100,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "근데 갑자기 우리나라에 와서"
    } ]
  }, {
    "tStartMs": 489760,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "석유 공급을 달라는 거예요"
    } ]
  }, {
    "tStartMs": 492030,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "남는 석유 좀 없습니까?"
    } ]
  }, {
    "tStartMs": 493470,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "뭐 이러고 왔다는 거죠"
    } ]
  }, {
    "tStartMs": 494950,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "참고로 여러분 다 아시겠지만"
    } ]
  }, {
    "tStartMs": 496570,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "베트남은 동남아 3대 산유국입니다"
    } ]
  }, {
    "tStartMs": 500450,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "동남아 3대 산유국"
    } ]
  }, {
    "tStartMs": 501520,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "석유가 많이 나는 나라야"
    } ]
  }, {
    "tStartMs": 503180,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "수출도 해, 수출도"
    } ]
  }, {
    "tStartMs": 504800,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "근데 기름 한 방울 안 나오는"
    } ]
  }, {
    "tStartMs": 506550,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "우리나라나 일본에 와서"
    } ]
  }, {
    "tStartMs": 507980,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "죄송한데"
    } ]
  }, {
    "tStartMs": 510040,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "석유 한 대만 좀 주세요"
    } ]
  }, {
    "tStartMs": 511080,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "이런 얘기를 하는 거잖아요"
    } ]
  }, {
    "tStartMs": 512350,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "왜 그러느냐?"
    } ]
  }, {
    "tStartMs": 513580,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "당연히 이유는 있습니다"
    } ]
  }, {
    "tStartMs": 514850,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "베트남은 자국에서 나오는"
    } ]
  }, {
    "tStartMs": 516900,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "고품질 원유는 수출해요"
    } ]
  }, {
    "tStartMs": 519710,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "쏠쏠하죠?"
    } ]
  }, {
    "tStartMs": 520540,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "그리고 중질유를 중동에서 수입해 쓰고"
    } ]
  }, {
    "tStartMs": 523000,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "경유나 휘발유"
    } ]
  }, {
    "tStartMs": 524020,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "이런 석유 제품들 있잖아요"
    } ]
  }, {
    "tStartMs": 525330,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "항공유 이런 거는"
    } ]
  }, {
    "tStartMs": 526800,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "한국에서 주로 수입해 사용합니다"
    } ]
  }, {
    "tStartMs": 529090,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "돈 되는 고품질 원유는 수출하고"
    } ]
  }, {
    "tStartMs": 531620,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "한 번 이렇게 정제한 거는 수입을 해"
    } ]
  }, {
    "tStartMs": 534530,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "게다가 중질유를 중동에서 수입한다고 그랬죠"
    } ]
  }, {
    "tStartMs": 537060,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "당연히 87%가"
    } ]
  }, {
    "tStartMs": 539060,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "호르무즈 해협을 통해서 나옵니다"
    } ]
  }, {
    "tStartMs": 541060,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "게다가 베트남은 수입 원유의"
    } ]
  }, {
    "tStartMs": 542500,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "80%를 쿠웨이트에서 받아요"
    } ]
  }, {
    "tStartMs": 544700,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "요기가 막혔네"
    } ]
  }, {
    "tStartMs": 546660,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "아 웃을 게 아니지"
    } ]
  }, {
    "tStartMs": 547710,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "우리나라도 그렇잖아"
    } ]
  }, {
    "tStartMs": 549220,
    "dDurationMs": 570,
    "segs": [ {
      "utf8": "웃을 일이 아닌데"
    } ]
  }, {
    "tStartMs": 549790,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "요기가 막혔어요"
    } ]
  }, {
    "tStartMs": 551770,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "게다가 석유화학 제품을"
    } ]
  }, {
    "tStartMs": 553430,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "우리나라에서 주로 수입한다고 그랬잖아요"
    } ]
  }, {
    "tStartMs": 555490,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "몇 퍼센트를 수입하냐"
    } ]
  }, {
    "tStartMs": 556480,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "경유 등 석유화학 제품의 41%를"
    } ]
  }, {
    "tStartMs": 560260,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "한국에서 수입합니다"
    } ]
  }, {
    "tStartMs": 562260,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "한국이 셔터 내리네?"
    } ]
  }, {
    "tStartMs": 564230,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "한국이 셔터 내리고"
    } ]
  }, {
    "tStartMs": 565320,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "세 번째로 수입하는 나라가 중국인데"
    } ]
  }, {
    "tStartMs": 567570,
    "dDurationMs": 530,
    "segs": [ {
      "utf8": "14.3%"
    } ]
  }, {
    "tStartMs": 568100,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "중국도 셔터내리죠"
    } ]
  }, {
    "tStartMs": 569630,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "싱가포르라고 그러지 말라는 법이 없으니까"
    } ]
  }, {
    "tStartMs": 572240,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "41%를 차지하는 나라가"
    } ]
  }, {
    "tStartMs": 574410,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "일단 내수 먼저를 외치고 있는 상황이기 때문에"
    } ]
  }, {
    "tStartMs": 577380,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "굉장히 심각하다고 할 수 있고"
    } ]
  }, {
    "tStartMs": 579110,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "우리나라에 와서 석유 좀 주세요라고"
    } ]
  }, {
    "tStartMs": 581200,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "얘기하는 게 다 이유가 있어요"
    } ]
  }, {
    "tStartMs": 582930,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "41%인데 이게 문을 닫으면"
    } ]
  }, {
    "tStartMs": 586130,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "어떻게 되는 거냐"
    } ]
  }, {
    "tStartMs": 587350,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "게다가 베트남 같은 경우에"
    } ]
  }, {
    "tStartMs": 589250,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "이 베트남도 발전을 요즘 많이 하고 있거든요"
    } ]
  }, {
    "tStartMs": 591080,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "발전을 많이 하니까"
    } ]
  }, {
    "tStartMs": 592380,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "원유 소비량도 증가하지만"
    } ]
  }, {
    "tStartMs": 593570,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "그것보다 더 증가하는 게"
    } ]
  }, {
    "tStartMs": 595440,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "당연히 정제 연료입니다"
    } ]
  }, {
    "tStartMs": 596900,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "우리나라 석유화학 제품들"
    } ]
  }, {
    "tStartMs": 598730,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "작년에 베트남은"
    } ]
  }, {
    "tStartMs": 599730,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "원유 같은 경우에는"
    } ]
  }, {
    "tStartMs": 600870,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "물량이 10%, 금액은 25%"
    } ]
  }, {
    "tStartMs": 603060,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "수입이 줄었는데"
    } ]
  }, {
    "tStartMs": 604320,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "석유 정제 제품 수입은"
    } ]
  }, {
    "tStartMs": 605710,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "올해 2월달까지 기준으로"
    } ]
  }, {
    "tStartMs": 607330,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "거의 40%가 늘었어요"
    } ]
  }, {
    "tStartMs": 609240,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "그러니까 오히려 수요는 급증하고 있는데"
    } ]
  }, {
    "tStartMs": 611450,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "호르무즈 해협이 빵 막히면서"
    } ]
  }, {
    "tStartMs": 612930,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "한국이나 중국이"
    } ]
  }, {
    "tStartMs": 614300,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "석화제품 가동률도 낮추죠"
    } ]
  }, {
    "tStartMs": 616040,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "가동률도 거의 60% 이하로 낮춘다"
    } ]
  }, {
    "tStartMs": 617460,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "그러고 자국 수요 우선한다 그러니까"
    } ]
  }, {
    "tStartMs": 619810,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "불똥이 튀는 거죠"
    } ]
  }, {
    "tStartMs": 621370,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "한마디로 베트남 입장에서"
    } ]
  }, {
    "tStartMs": 622620,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "놀랍게도"
    } ]
  }, {
    "tStartMs": 623430,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "한국은 에너지 공급처입니다"
    } ]
  }, {
    "tStartMs": 625840,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "물론 우리가 나서 그러는 건 아니고"
    } ]
  }, {
    "tStartMs": 627870,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "나서 그러는 건 아니고"
    } ]
  }, {
    "tStartMs": 629000,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "받아서 주는 거긴 하지만"
    } ]
  }, {
    "tStartMs": 630550,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "하던 수출을 계속해야지"
    } ]
  }, {
    "tStartMs": 632120,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "그걸 막으면 어떡하냐"
    } ]
  }, {
    "tStartMs": 633810,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "얘기를 하는 거죠"
    } ]
  }, {
    "tStartMs": 634670,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "그래서 베트남 같은 경우에는"
    } ]
  }, {
    "tStartMs": 636060,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "지금 산유국인데"
    } ]
  }, {
    "tStartMs": 637450,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "가솔린 가격이 얼마가 올랐냐"
    } ]
  }, {
    "tStartMs": 639280,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "50% 올랐습니다"
    } ]
  }, {
    "tStartMs": 641090,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "이게 전세계 모든 나라의"
    } ]
  }, {
    "tStartMs": 642370,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "가솔린 가격 상승률을 집계하는 사이트거든요"
    } ]
  }, {
    "tStartMs": 645640,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "지금 베트남이 1위"
    } ]
  }, {
    "tStartMs": 647100,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "좋은 걸로 1위는 아니라"
    } ]
  }, {
    "tStartMs": 648500,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "가솔린 가격이"
    } ]
  }, {
    "tStartMs": 649520,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "가장 많이 상승한 걸로"
    } ]
  }, {
    "tStartMs": 651040,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "1위를 달리고 있는 나라가"
    } ]
  }, {
    "tStartMs": 652350,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "동남아시아 3대 산유국"
    } ]
  }, {
    "tStartMs": 653920,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "베트남이라고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 655610,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "베트남 같은 경우에는"
    } ]
  }, {
    "tStartMs": 656740,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "전쟁 직전에 대비해서"
    } ]
  }, {
    "tStartMs": 658340,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "휘발유 가격이 52%"
    } ]
  }, {
    "tStartMs": 660000,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "경유 가격이 73%"
    } ]
  }, {
    "tStartMs": 661680,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "등유 가격이 84%가 올랐습니다"
    } ]
  }, {
    "tStartMs": 664020,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "와 84%, 미쳤다"
    } ]
  }, {
    "tStartMs": 665890,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "휘발유도 우리 옛날에"
    } ]
  }, {
    "tStartMs": 668940,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "1,600원, 1,700원 하던 게"
    } ]
  }, {
    "tStartMs": 670530,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "52%면 얼마 오른 거야?"
    } ]
  }, {
    "tStartMs": 671950,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "2,500원"
    } ]
  }, {
    "tStartMs": 672960,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "등유 가격은 따불친 거잖아요"
    } ]
  }, {
    "tStartMs": 674630,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "84%면"
    } ]
  }, {
    "tStartMs": 675650,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "굉장히 힘들다는 거죠"
    } ]
  }, {
    "tStartMs": 677510,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "굉장히 힘들고"
    } ]
  }, {
    "tStartMs": 678810,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "지금 베트남 같은 경우에 게다가"
    } ]
  }, {
    "tStartMs": 680420,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "운송  수단도 오토바이가 많은데"
    } ]
  }, {
    "tStartMs": 682710,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "이 오토바이 같은 경우에"
    } ]
  }, {
    "tStartMs": 683610,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "지금 기름을 넣으려고"
    } ]
  }, {
    "tStartMs": 684820,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "굉장히 대란이라고 합니다"
    } ]
  }, {
    "tStartMs": 686370,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "만약에 가격의 문제가 아니라"
    } ]
  }, {
    "tStartMs": 687930,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "연료가 부족해서"
    } ]
  }, {
    "tStartMs": 689120,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "수급이 제대로 안 되면"
    } ]
  }, {
    "tStartMs": 690310,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "정말 공황이 올 수도 있죠"
    } ]
  }, {
    "tStartMs": 691660,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "베트남의 국가 비축량은"
    } ]
  }, {
    "tStartMs": 692890,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "순수입량 대비 불과 9일치로 알려져 있습니다"
    } ]
  }, {
    "tStartMs": 696190,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "셔터를 완전히 내리면"
    } ]
  }, {
    "tStartMs": 698210,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "2주도 버티기 힘들 수 있죠"
    } ]
  }, {
    "tStartMs": 700430,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "석화 설비가 있는 것도 아니고"
    } ]
  }, {
    "tStartMs": 701930,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "대단히 어려워진다는 거고요"
    } ]
  }, {
    "tStartMs": 703420,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "그리고 잠깐 지나갔는데"
    } ]
  }, {
    "tStartMs": 705500,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "가솔린 가격이 2등으로"
    } ]
  }, {
    "tStartMs": 707060,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "많이 오른 나라가 있습니다"
    } ]
  }, {
    "tStartMs": 707980,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "이건 나이지리아예요"
    } ]
  }, {
    "tStartMs": 709500,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "나이지리아도 세계적인 산유국입니다"
    } ]
  }, {
    "tStartMs": 712420,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "세계 10대 산유국이에요"
    } ]
  }, {
    "tStartMs": 714370,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "글로벌 8위 석유 수출 국가입니다"
    } ]
  }, {
    "tStartMs": 716860,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "근데 지금 휘발유 가격이"
    } ]
  }, {
    "tStartMs": 718020,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "40%가 오른 거예요"
    } ]
  }, {
    "tStartMs": 719540,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "역시 세계 최고 수준의 상승률인데요"
    } ]
  }, {
    "tStartMs": 722140,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "나이지리아 같은 경우에는"
    } ]
  }, {
    "tStartMs": 723380,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "아프리카 최대 산유국입니다"
    } ]
  }, {
    "tStartMs": 726230,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "아프리카에서 가장"
    } ]
  }, {
    "tStartMs": 727440,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "많이 석유를 수출하는 나라라고 보시면 됩니다"
    } ]
  }, {
    "tStartMs": 730020,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "다만, 역시 뭐가 없다?"
    } ]
  }, {
    "tStartMs": 731810,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "제대로 된 정유시설이 없어요"
    } ]
  }, {
    "tStartMs": 734180,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "있었는데 지금 제대로 관리되지도 않고"
    } ]
  }, {
    "tStartMs": 737270,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "대부분 방치되어 있고"
    } ]
  }, {
    "tStartMs": 738750,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "게다가 나이지리아 같은 경우에"
    } ]
  }, {
    "tStartMs": 739970,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "또 문제가"
    } ]
  }, {
    "tStartMs": 741020,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "소위 말해 부정부패가 있죠"
    } ]
  }, {
    "tStartMs": 742780,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "석유 마피아라고 불리는"
    } ]
  }, {
    "tStartMs": 744200,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "그런 엘리트 계층들이 있기 때문에"
    } ]
  }, {
    "tStartMs": 746320,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "석유를 나눠먹는 것만"
    } ]
  }, {
    "tStartMs": 748200,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "혈안이 되어 있지"
    } ]
  }, {
    "tStartMs": 749040,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "기반시설은 방치하고"
    } ]
  }, {
    "tStartMs": 750820,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "그동안 어떤 석유, 석화산업이라든지"
    } ]
  }, {
    "tStartMs": 753330,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "이런 것에 대한 발전을"
    } ]
  }, {
    "tStartMs": 754400,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "투자를 안 했던 거죠"
    } ]
  }, {
    "tStartMs": 755810,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "내용을 보면 이렇게 나옵니다"
    } ]
  }, {
    "tStartMs": 757390,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "아프리카에서 지난 거의 10년 동안"
    } ]
  }, {
    "tStartMs": 759820,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "100건이 넘는 정유공장"
    } ]
  }, {
    "tStartMs": 761290,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "건설 프로젝트가 발표되었지만"
    } ]
  }, {
    "tStartMs": 763050,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "실제로 건설된 것은"
    } ]
  }, {
    "tStartMs": 764440,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "단 한 건 뿐이었다"
    } ]
  }, {
    "tStartMs": 766220,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "석유 팔아서 돈을 버는 것에만"
    } ]
  }, {
    "tStartMs": 768190,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "너무 집중을 하고"
    } ]
  }, {
    "tStartMs": 769340,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "저런 기반시설에 투자를 안 했다는 거죠"
    } ]
  }, {
    "tStartMs": 771820,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "그런데 얘기는 뭐"
    } ]
  }, {
    "tStartMs": 773070,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "지금 현재 이 산유국들이"
    } ]
  }, {
    "tStartMs": 774520,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "어려움을 겪는 얘기는 했는데"
    } ]
  }, {
    "tStartMs": 775790,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "또 오늘의 추가적인 주제 하나"
    } ]
  }, {
    "tStartMs": 777310,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "얘기해 드리겠습니다"
    } ]
  }, {
    "tStartMs": 778520,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "이런 상황에서 2007년에"
    } ]
  }, {
    "tStartMs": 780700,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "나이지리아에서"
    } ]
  }, {
    "tStartMs": 781480,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "자체 정유시설 건설을 결정한"
    } ]
  }, {
    "tStartMs": 784260,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "사업가가 한 명 있습니다"
    } ]
  }, {
    "tStartMs": 786160,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "나이지리아에서는 대부분"
    } ]
  }, {
    "tStartMs": 787750,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "국민 거의 모두가 안다고 얘기를 하던데"
    } ]
  }, {
    "tStartMs": 790120,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "알리코 단고테라는 인물입니다"
    } ]
  }, {
    "tStartMs": 792520,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "나이지리아 대부분 지역에서"
    } ]
  }, {
    "tStartMs": 793720,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "그는 영웅으로 여겨진다"
    } ]
  }, {
    "tStartMs": 795800,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "무언가를 건설하는 진정한 기업가다"
    } ]
  }, {
    "tStartMs": 798180,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "이 인물이 있는데"
    } ]
  }, {
    "tStartMs": 799230,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "저 단고테라는 인물은"
    } ]
  }, {
    "tStartMs": 800660,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "나이지리아의 석유 마피아를 경고한 인물입니다"
    } ]
  }, {
    "tStartMs": 803510,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "석유 마피아는 마약 마피아보다"
    } ]
  }, {
    "tStartMs": 805440,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "훨씬 더 위험하다"
    } ]
  }, {
    "tStartMs": 806620,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "왜냐하면 훨씬 더 많은 사람들이"
    } ]
  }, {
    "tStartMs": 808320,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "연루되어 있기 때문이다"
    } ]
  }, {
    "tStartMs": 809750,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "그래서 저 단고테라는 사람이"
    } ]
  }, {
    "tStartMs": 811580,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "2007년에"
    } ]
  }, {
    "tStartMs": 812760,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "정부의 정유시설 안 쓰는 녹슬은"
    } ]
  }, {
    "tStartMs": 815110,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "그 정유시설을 매입해서"
    } ]
  }, {
    "tStartMs": 816060,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "자기가 고쳐 쓰려고 그러는데 실패해요"
    } ]
  }, {
    "tStartMs": 818570,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "정치권하고 연이 잘 안 닿았나 봐요"
    } ]
  }, {
    "tStartMs": 820070,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "실패하고"
    } ]
  }, {
    "tStartMs": 821010,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "자체의 정유시설을"
    } ]
  }, {
    "tStartMs": 822320,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "나이지리아에 건설하기로 결정을 합니다"
    } ]
  }, {
    "tStartMs": 824670,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "왜냐하면"
    } ]
  }, {
    "tStartMs": 825570,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "지금까지 쭉 얘기 드렸지만"
    } ]
  }, {
    "tStartMs": 827150,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "나이지리아에서 싼 석유가 나는데"
    } ]
  }, {
    "tStartMs": 828840,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "그걸 외국에 수출을 하고"
    } ]
  }, {
    "tStartMs": 830620,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "외국에서 다시 그걸 가공한"
    } ]
  }, {
    "tStartMs": 832310,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "정유를 다시 수입하니까"
    } ]
  }, {
    "tStartMs": 833780,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "그걸 바꿔서"
    } ]
  }, {
    "tStartMs": 834510,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "나이지리아 내에서"
    } ]
  }, {
    "tStartMs": 835510,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "한 번 정유시설, 석화시설을 만들어보겠다"
    } ]
  }, {
    "tStartMs": 838340,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "석유화학의 붐을 만들어보겠다"
    } ]
  }, {
    "tStartMs": 840210,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "뭐 이런 꿈을 꾼 거죠"
    } ]
  }, {
    "tStartMs": 841740,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "그래서 저 인물이"
    } ]
  }, {
    "tStartMs": 843270,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "무려 11년이라는 시간"
    } ]
  }, {
    "tStartMs": 845060,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "그리고 230억 달러"
    } ]
  }, {
    "tStartMs": 845870,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "25조 정도를 투자합니다"
    } ]
  }, {
    "tStartMs": 848400,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "그래서 지금 현재"
    } ]
  }, {
    "tStartMs": 849480,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "작년에, 2024년에"
    } ]
  }, {
    "tStartMs": 851010,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "단고테  정유공장이라는"
    } ]
  }, {
    "tStartMs": 852960,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "공장을 만들어서 가동을 시작합니다"
    } ]
  }, {
    "tStartMs": 855050,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "참고로 이 얘기를 왜 이렇게 길게 드리냐"
    } ]
  }, {
    "tStartMs": 856840,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "저 정유공장이 지금"
    } ]
  }, {
    "tStartMs": 858770,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "아프리카 최대의 규모의 정유공장이 됐습니다"
    } ]
  }, {
    "tStartMs": 862550,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "생산량 세계 7위"
    } ]
  }, {
    "tStartMs": 864510,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "아프리카 최대 규모의 정유공장"
    } ]
  }, {
    "tStartMs": 866710,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "단고테 아저씨가 이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 868850,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "제 인생에서 가장 큰 위험이었고"
    } ]
  }, {
    "tStartMs": 870840,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "만약 이 일이 실패했다면"
    } ]
  }, {
    "tStartMs": 872170,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "나는 죽었을 것이다"
    } ]
  }, {
    "tStartMs": 874110,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "나이지리아 내부에서"
    } ]
  }, {
    "tStartMs": 875910,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "뭔가 암투가 굉장히 많았던 것 같아요"
    } ]
  }, {
    "tStartMs": 878380,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "인터뷰를 하는 내용만 보더라도"
    } ]
  }, {
    "tStartMs": 880430,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "그리고 저 정유공장이"
    } ]
  }, {
    "tStartMs": 881520,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "딱 2024년에 문을 열었는데"
    } ]
  }, {
    "tStartMs": 883000,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "뭐가 터진 겁니까?"
    } ]
  }, {
    "tStartMs": 884710,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "이란 전쟁이 터졌어요"
    } ]
  }, {
    "tStartMs": 886630,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "모두가 새로운 정유 공급망을 찾고 있어요"
    } ]
  }, {
    "tStartMs": 889700,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "한국이 셧다운하고"
    } ]
  }, {
    "tStartMs": 891200,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "중국이 문을 닫고"
    } ]
  }, {
    "tStartMs": 892520,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "각국이 자기 거 먼저 하겠다라고 하고 있는데"
    } ]
  }, {
    "tStartMs": 895110,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "나이지리아의 세계 7위급의"
    } ]
  }, {
    "tStartMs": 897290,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "정유공장이 생긴 거예요"
    } ]
  }, {
    "tStartMs": 898960,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "나이지리아는 아까 얘기했지만"
    } ]
  }, {
    "tStartMs": 900100,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "탑10 원유 생산 국가입니다"
    } ]
  }, {
    "tStartMs": 902510,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "저 단고테 회장 아저씨가"
    } ]
  }, {
    "tStartMs": 904550,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "얼마 전에 인터뷰를 했는데"
    } ]
  }, {
    "tStartMs": 905640,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 906620,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "지금 제 전화에 불이 나고 있습니다"
    } ]
  }, {
    "tStartMs": 908670,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "사람들은 가격이 문제가 아니다"
    } ]
  }, {
    "tStartMs": 912110,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "무엇이든지 지불할 준비가 되어 있다"
    } ]
  }, {
    "tStartMs": 914790,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "라고 내 전화에 계속 불이 나고 있습니다"
    } ]
  }, {
    "tStartMs": 918240,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "산유국에 지은 석유시설이잖아요"
    } ]
  }, {
    "tStartMs": 920700,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "사우디아라비아가"
    } ]
  }, {
    "tStartMs": 921420,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "요즘에 저런 걸 많이 하려고 하는 게"
    } ]
  }, {
    "tStartMs": 923340,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "다 이유가 있다고 보이고"
    } ]
  }, {
    "tStartMs": 924870,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "저희 현재도 단고테 정유공장이"
    } ]
  }, {
    "tStartMs": 926930,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "나이지리아에서는 절대적입니다"
    } ]
  }, {
    "tStartMs": 928630,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "국내 소비량의 70%를"
    } ]
  }, {
    "tStartMs": 930460,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "단 한 공장에서 생산합니다"
    } ]
  }, {
    "tStartMs": 932710,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "그래서 글로벌 휘발유 가격 상승을"
    } ]
  }, {
    "tStartMs": 934850,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "어느 정도 방어할 수 있었다라고"
    } ]
  }, {
    "tStartMs": 936550,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "자평을 하고 있어요"
    } ]
  }, {
    "tStartMs": 938090,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "물론 완전히 방어는 안 되죠"
    } ]
  }, {
    "tStartMs": 940580,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "왜냐하면 저 단고테 정유공장이란 곳도"
    } ]
  }, {
    "tStartMs": 943000,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "값싼 원유를 자국에서 조달 받지만"
    } ]
  }, {
    "tStartMs": 945280,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "생산된 석유화학 제품은"
    } ]
  }, {
    "tStartMs": 946680,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "글로벌 가격으로 받습니다"
    } ]
  }, {
    "tStartMs": 948700,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "물론 정치에서 떼찌 떼찌하면"
    } ]
  }, {
    "tStartMs": 950730,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "조금 깎아주긴 하겠지만"
    } ]
  }, {
    "tStartMs": 952350,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "아니 뭐 옆나라에 팔면 10달러인데"
    } ]
  }, {
    "tStartMs": 954030,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "뭐 나이지리아라고"
    } ]
  }, {
    "tStartMs": 954810,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "7, 8달러에 팔 필요 없지 않냐?"
    } ]
  }, {
    "tStartMs": 956430,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "라고 해서 달러 기준으로 받기 때문에"
    } ]
  }, {
    "tStartMs": 958590,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "그래서 비판하는 사람들은"
    } ]
  }, {
    "tStartMs": 960840,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "그래서 이걸 비판해요"
    } ]
  }, {
    "tStartMs": 962030,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "여전히 나이지리아는 높은 휘발유 가격 아니냐?"
    } ]
  }, {
    "tStartMs": 964100,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "뭐야 이거?"
    } ]
  }, {
    "tStartMs": 964950,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "만들어놓고 비싸게 팔면 어떡해?"
    } ]
  }, {
    "tStartMs": 966590,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "라고 하고 있는 게"
    } ]
  }, {
    "tStartMs": 967720,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "나이지리아에서 펼쳐지고 있는 일입니다"
    } ]
  }, {
    "tStartMs": 969340,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "참고로 단고트 회장이 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 971840,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "3년 후에 다시 오시면"
    } ]
  }, {
    "tStartMs": 973540,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "오늘 보신 것보다"
    } ]
  }, {
    "tStartMs": 974600,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "규모를 3배로 만들겠습니다"
    } ]
  }, {
    "tStartMs": 977250,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "지금도 세계 7위입니다"
    } ]
  }, {
    "tStartMs": 978450,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "아프리카 최대 정유시설인데"
    } ]
  }, {
    "tStartMs": 980460,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "지금보다 3배로 공장을 키울 예정입니다"
    } ]
  }, {
    "tStartMs": 984000,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "이 단고테 아저씨가 어떤 사람이냐?"
    } ]
  }, {
    "tStartMs": 986900,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "포브스 기준으로"
    } ]
  }, {
    "tStartMs": 988250,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "세계에서 가장 부유한 흑인입니다"
    } ]
  }, {
    "tStartMs": 991260,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "세계에서 가장 돈 많은 흑인이 이분이에요"
    } ]
  }, {
    "tStartMs": 994380,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "물론 아프리카에서도 TOP1"
    } ]
  }, {
    "tStartMs": 996320,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "아프리카에서 가장 부유한 인물이자"
    } ]
  }, {
    "tStartMs": 998360,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "세계에서 가장 돈 많은 흑인입니다"
    } ]
  }, {
    "tStartMs": 1000900,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "마이클 조던 뭐 이런 분들 있지 않냐"
    } ]
  }, {
    "tStartMs": 1002520,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "미국에 있는 분들"
    } ]
  }, {
    "tStartMs": 1003570,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "그분들보다 돈이 더 많아"
    } ]
  }, {
    "tStartMs": 1005540,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "포브스 선정"
    } ]
  }, {
    "tStartMs": 1006180,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "세계 100대 부호 명단에 오른 인물이고요"
    } ]
  }, {
    "tStartMs": 1009180,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "참고로 우리나라에서도"
    } ]
  }, {
    "tStartMs": 1010770,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "이분보다 돈 많은 분이"
    } ]
  }, {
    "tStartMs": 1012020,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "아마 없을 것 같아요"
    } ]
  }, {
    "tStartMs": 1013710,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "왜냐하면 현재 세계 66등 부자인데"
    } ]
  }, {
    "tStartMs": 1016770,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "포브스 기준으로 49조입니다"
    } ]
  }, {
    "tStartMs": 1018640,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "대충 재산이 50조야"
    } ]
  }, {
    "tStartMs": 1020410,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "우리나라 이재용 회장님이"
    } ]
  }, {
    "tStartMs": 1022110,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "공식 기준으로 250억 달러입니다"
    } ]
  }, {
    "tStartMs": 1024570,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "그러니까 20% 이상 더 부자인"
    } ]
  }, {
    "tStartMs": 1026610,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "세계 66위 부자가 됐습니다"
    } ]
  }, {
    "tStartMs": 1029090,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "결론적으로 정유공장을 만들었는데"
    } ]
  }, {
    "tStartMs": 1031090,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "타이밍이 굉장히 받쳐주면서"
    } ]
  }, {
    "tStartMs": 1033160,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "성공적인 사례로 지금 떠오르고 있다는 거죠"
    } ]
  }, {
    "tStartMs": 1035390,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "자 이렇게 얘기를 하면"
    } ]
  }, {
    "tStartMs": 1036500,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "얘기는 다 끝났는데"
    } ]
  }, {
    "tStartMs": 1037770,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "저 단고테라는 아저씨가"
    } ]
  }, {
    "tStartMs": 1039560,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "굉장히 자수성가한 것 같잖아요"
    } ]
  }, {
    "tStartMs": 1041180,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "느낌상"
    } ]
  }, {
    "tStartMs": 1041910,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "오, 이렇게 내 힘으로 이렇게"
    } ]
  }, {
    "tStartMs": 1044740,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "제가 좀 더 알아보니까"
    } ]
  }, {
    "tStartMs": 1046810,
    "dDurationMs": 5130,
    "segs": [ {
      "utf8": "본래 나이지리아 최고 부자셨다고 합니다"
    } ]
  }, {
    "tStartMs": 1051940,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "나도 할 수 있겠다"
    } ]
  }, {
    "tStartMs": 1053040,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "라고 생각하시는 분들은"
    } ]
  }, {
    "tStartMs": 1054600,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "다시 생각하실 필요도 있어요"
    } ]
  }, {
    "tStartMs": 1056210,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "증조부 때부터 나이지리아 최고 부자였다"
    } ]
  }, {
    "tStartMs": 1059330,
    "dDurationMs": 670,
    "segs": [ {
      "utf8": "나이지리아에서"
    } ]
  }, {
    "tStartMs": 1060000,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "땅콩 시장을 독점한 집안이라고 하는데"
    } ]
  }, {
    "tStartMs": 1063460,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "1900년대 초부터 엄청난 부자였다고 합니다"
    } ]
  }, {
    "tStartMs": 1066210,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "다른 나이지라인들은"
    } ]
  }, {
    "tStartMs": 1067260,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "식민 통치에 불만을 품을 때"
    } ]
  }, {
    "tStartMs": 1069410,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "단타타, 증조부"
    } ]
  }, {
    "tStartMs": 1071560,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "증조부는 유럽에 늘어나는 땅콩 수요를 수출하기 위해서"
    } ]
  }, {
    "tStartMs": 1074670,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "나이지리아에서 땅콩을 만들어서"
    } ]
  }, {
    "tStartMs": 1076400,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "엄청난 땅콩을 수출했고"
    } ]
  }, {
    "tStartMs": 1078370,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "당시 나이지리아 산업을 상징했던 게"
    } ]
  }, {
    "tStartMs": 1081000,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "땅콩 피라미드였다고 합니다"
    } ]
  }, {
    "tStartMs": 1083130,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "유럽으로 수출하기 위해서"
    } ]
  }, {
    "tStartMs": 1084380,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "땅콩을 하도 높게 쌓아서"
    } ]
  }, {
    "tStartMs": 1086360,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "땅콩이 피라미드처럼 되어있다"
    } ]
  }, {
    "tStartMs": 1087940,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "우리나라로 치면"
    } ]
  }, {
    "tStartMs": 1089180,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "옛날에 우리나라 뭐 팔았죠?"
    } ]
  }, {
    "tStartMs": 1090330,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "1960년대? 저거 가발!"
    } ]
  }, {
    "tStartMs": 1093320,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "가발 많이 팔았습니다"
    } ]
  }, {
    "tStartMs": 1094580,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "섬유나 가발 같은 거 많이 팔았는데"
    } ]
  }, {
    "tStartMs": 1096670,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "그거하고 비슷하게"
    } ]
  }, {
    "tStartMs": 1097530,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "나이지리아에서는 땅콩이었다는 거죠"
    } ]
  }, {
    "tStartMs": 1099370,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "땅콩 자루로 저 피라미드를 쌓은 게"
    } ]
  }, {
    "tStartMs": 1101620,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "나이지리아 사람들에게는"
    } ]
  }, {
    "tStartMs": 1102580,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "자부심의 원천이었는데"
    } ]
  }, {
    "tStartMs": 1104220,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "증조부 때부터 부자였다고 하고요"
    } ]
  }, {
    "tStartMs": 1106550,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "나이지리아 같은 경우는"
    } ]
  }, {
    "tStartMs": 1107580,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "석유가 발견되기 전까지"
    } ]
  }, {
    "tStartMs": 1108860,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "세계적인 땅콩 생산국이었다고 합니다"
    } ]
  }, {
    "tStartMs": 1111260,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "세계 최대 땅콩 생산국이었고"
    } ]
  }, {
    "tStartMs": 1113350,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "현대도 세계 3위라고 해요"
    } ]
  }, {
    "tStartMs": 1115040,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "1960-70년대에는 땅콩이"
    } ]
  }, {
    "tStartMs": 1116920,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "나이지리아 전체 수출의 70%를 차지했다"
    } ]
  }, {
    "tStartMs": 1119740,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "근데 이걸 독점했다는 거죠"
    } ]
  }, {
    "tStartMs": 1122080,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "거의 증조부께서"
    } ]
  }, {
    "tStartMs": 1124270,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "엄청난 부자였지 않을까라고"
    } ]
  }, {
    "tStartMs": 1126550,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "생각을 하고"
    } ]
  }, {
    "tStartMs": 1127640,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "그래서 아까 말한"
    } ]
  }, {
    "tStartMs": 1128630,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "저 단고테 아저씨가 사업을 할 때"
    } ]
  }, {
    "tStartMs": 1130620,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "삼촌 저 사업하게 돈 좀 주세요 했더니"
    } ]
  }, {
    "tStartMs": 1133310,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "50만 달러를 빌려줬다"
    } ]
  }, {
    "tStartMs": 1135310,
    "dDurationMs": 450,
    "segs": [ {
      "utf8": "7억"
    } ]
  }, {
    "tStartMs": 1135760,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "아유 삼촌이 되게 청렴결백 하시네"
    } ]
  }, {
    "tStartMs": 1138850,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "삼촌이 되게 짠돌이신가 봐요"
    } ]
  }, {
    "tStartMs": 1140850,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "조카한테 7억 가지고 사업하라고 했으니까"
    } ]
  }, {
    "tStartMs": 1143010,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "얼마나 힘드셨을까"
    } ]
  }, {
    "tStartMs": 1144260,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "참 걱정이 되고"
    } ]
  }, {
    "tStartMs": 1145250,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "저거만 줘서 어떡합니까 했더니"
    } ]
  }, {
    "tStartMs": 1146650,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "그게 아니라"
    } ]
  }, {
    "tStartMs": 1147530,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "단고테 삼촌이 그에게 정부 발행"
    } ]
  }, {
    "tStartMs": 1149480,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "시멘트 수입 허가증을 줬대요"
    } ]
  }, {
    "tStartMs": 1151340,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "근데 이게 대박이었다고 합니다"
    } ]
  }, {
    "tStartMs": 1153200,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "왜냐하면 나이지리아에서"
    } ]
  }, {
    "tStartMs": 1153970,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "막 발전하고 집 지었던 때니까"
    } ]
  }, {
    "tStartMs": 1155890,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "시멘트 수입 허가증"
    } ]
  }, {
    "tStartMs": 1157010,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "저거를 받아갖고"
    } ]
  }, {
    "tStartMs": 1158400,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "엄청난 이미 나이지리아에서 거의"
    } ]
  }, {
    "tStartMs": 1160140,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "최고의 부자로 떠오르게 됩니다"
    } ]
  }, {
    "tStartMs": 1162160,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "뭐 우리도 뭐 그랬죠 옛날에"
    } ]
  }, {
    "tStartMs": 1163220,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "대한민국 생각하면 똑같죠"
    } ]
  }, {
    "tStartMs": 1164830,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "그럼 뭐 섬유 팔고 가발 팔고 하다가"
    } ]
  }, {
    "tStartMs": 1167630,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "시멘트 팔고 이렇게 넘어오니까"
    } ]
  }, {
    "tStartMs": 1169410,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "시멘트 사업이 매년 수익률이 60%가 넘었다"
    } ]
  }, {
    "tStartMs": 1172370,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "엄청난 돈을 벌면서"
    } ]
  }, {
    "tStartMs": 1173890,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "엄청나게 큰 성공을 거뒀고"
    } ]
  }, {
    "tStartMs": 1175870,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "그런 부자가 이번엔 정유시설까지"
    } ]
  }, {
    "tStartMs": 1178320,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "나이지리아 하면 석유니까"
    } ]
  }, {
    "tStartMs": 1179570,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "석유에서 내가 뭐를 가져올 수 있을까?"
    } ]
  }, {
    "tStartMs": 1181650,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "정유시설을 지으면"
    } ]
  }, {
    "tStartMs": 1182510,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "엄청난 부가 있겠구나"
    } ]
  }, {
    "tStartMs": 1183870,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "20조가 넘는 돈을"
    } ]
  }, {
    "tStartMs": 1185630,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "정유시설에 쏟아부어서"
    } ]
  }, {
    "tStartMs": 1187220,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "우리 치면 울산이나 포항이나"
    } ]
  }, {
    "tStartMs": 1189750,
    "dDurationMs": 510,
    "segs": [ {
      "utf8": "이런 것처럼"
    } ]
  }, {
    "tStartMs": 1190260,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "중화학 공업에 쏟아부은 거랑 똑같죠"
    } ]
  }, {
    "tStartMs": 1192220,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "그렇게 해서 지금 자산이"
    } ]
  }, {
    "tStartMs": 1193500,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "두 배가 됐다는 겁니다"
    } ]
  }, {
    "tStartMs": 1196150,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "이런 내용인데 저 단고테라는 사람이"
    } ]
  }, {
    "tStartMs": 1198440,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "나이지리아에서 평가가 나뉜다 그래요"
    } ]
  }, {
    "tStartMs": 1200490,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "우리나라의 생각을 해보면"
    } ]
  }, {
    "tStartMs": 1202480,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "충분히 이해할 수 있습니다"
    } ]
  }, {
    "tStartMs": 1203690,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "나이지리아 산업화를 이끈 존경받는 기업인"
    } ]
  }, {
    "tStartMs": 1206490,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "우리나라는 대부분 기업인분들이"
    } ]
  }, {
    "tStartMs": 1207820,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "이런 위치에 있는데"
    } ]
  }, {
    "tStartMs": 1209130,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "지금 나이지리아는 아직도"
    } ]
  }, {
    "tStartMs": 1210070,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "정치가 안정이 안 됐으니까"
    } ]
  }, {
    "tStartMs": 1211790,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "정부의 특혜를 받아"
    } ]
  }, {
    "tStartMs": 1212820,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "독점 사업을 하는 기업인"
    } ]
  }, {
    "tStartMs": 1214380,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "이걸로 의견이 나뉜다 그러는데"
    } ]
  }, {
    "tStartMs": 1216540,
    "dDurationMs": 1940,
    "segs": [ {

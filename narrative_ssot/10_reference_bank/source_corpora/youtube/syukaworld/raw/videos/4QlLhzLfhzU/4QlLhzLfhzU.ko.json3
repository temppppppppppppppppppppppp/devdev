  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 7780,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "자 세 번째 주제 이번 주제도 재밌습니다"
    } ]
  }, {
    "tStartMs": 10100,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "자 이번 주제는 뭐냐"
    } ]
  }, {
    "tStartMs": 10740,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "여러분도 한번 생각해보시죠"
    } ]
  }, {
    "tStartMs": 12530,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "영화관을 살릴 수 있는"
    } ]
  }, {
    "tStartMs": 13980,
    "dDurationMs": 4250,
    "segs": [ {
      "utf8": "국내 한국영화 살릴 수 있는 묘수는 무엇일 것이냐"
    } ]
  }, {
    "tStartMs": 18230,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "빠밤"
    } ]
  }, {
    "tStartMs": 19390,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "좋습니다"
    } ]
  }, {
    "tStartMs": 20490,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "자 묘수 한번 생각해보시고요"
    } ]
  }, {
    "tStartMs": 22110,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "어떻게 하면 한국영화 살려야겠죠"
    } ]
  }, {
    "tStartMs": 24450,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "우리 문화 그 자체 또 영화관 어떻게 하면 살릴 수 있냐"
    } ]
  }, {
    "tStartMs": 29090,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "이거에 대한 얘기를 한번 해보도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 31300,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "여러분들 아마 다 보셨겠지만"
    } ]
  }, {
    "tStartMs": 33020,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "얼마 전에 단종의 비극적인 이야기를 다룬 영화가 개봉을 했죠"
    } ]
  }, {
    "tStartMs": 38340,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "왕과 사는 남자"
    } ]
  }, {
    "tStartMs": 40380,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "2월 4일 날 개봉을 했는데"
    } ]
  }, {
    "tStartMs": 42000,
    "dDurationMs": 3770,
    "segs": [ {
      "utf8": "2월 19일까지 누적 관객 수가 440만을 넘었습니다"
    } ]
  }, {
    "tStartMs": 45770,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "지금 주말이기 때문에"
    } ]
  }, {
    "tStartMs": 46810,
    "dDurationMs": 650,
    "segs": [ {
      "utf8": "주말을 지나면"
    } ]
  }, {
    "tStartMs": 47460,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "아마 500만을 돌파할 걸로 예상이 되고 있어요"
    } ]
  }, {
    "tStartMs": 50910,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "많이들 보셨겠지만"
    } ]
  }, {
    "tStartMs": 51800,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "이게 단종과 수양대군 세조에 관련된"
    } ]
  }, {
    "tStartMs": 55050,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "단종의 그 유배가서"
    } ]
  }, {
    "tStartMs": 56530,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "거기서 이제 유해진 씨를 촌장으로 만나서"
    } ]
  }, {
    "tStartMs": 59050,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "이제 거기서 나중에 단종이 당연히 역사적 사실이니까"
    } ]
  }, {
    "tStartMs": 62330,
    "dDurationMs": 550,
    "segs": [ {
      "utf8": "죽게 되는"
    } ]
  }, {
    "tStartMs": 62880,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "그 슬픈 내용을 그린 그 영화인데"
    } ]
  }, {
    "tStartMs": 65660,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "이 영화가 인기가 끄니까"
    } ]
  }, {
    "tStartMs": 67050,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "현재 세조에는 광릉이죠 광릉"
    } ]
  }, {
    "tStartMs": 69760,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "별점 테러를 한다고 그럽니다"
    } ]
  }, {
    "tStartMs": 71050,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "보고 세조한테 열받는 거죠"
    } ]
  }, {
    "tStartMs": 72470,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "수양대군한테 네가 단종을 말이야"
    } ]
  }, {
    "tStartMs": 74750,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "이래갖고 별점이 1.5점으로 내려가서"
    } ]
  }, {
    "tStartMs": 78290,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "지금 이거 뭐 별점을 뭐 내렸다라는 말도 있어요"
    } ]
  }, {
    "tStartMs": 80380,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "내렸다는 말도 있는데"
    } ]
  }, {
    "tStartMs": 81950,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "우리가 태정태제문단세 할 때 단세입니다"
    } ]
  }, {
    "tStartMs": 83850,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "소위 계유정난"
    } ]
  }, {
    "tStartMs": 85220,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "계유정난 자체가 아니라"
    } ]
  }, {
    "tStartMs": 86780,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "단종이 내려가서 죽을 때까지 사약을 받을 때까지의"
    } ]
  }, {
    "tStartMs": 90650,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "그린 영화라고 할 수 있는데"
    } ]
  }, {
    "tStartMs": 92020,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "이 왕과 사는 남자가"
    } ]
  }, {
    "tStartMs": 93900,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "현재 초반 페이스가 나쁘지 않아요"
    } ]
  }, {
    "tStartMs": 96030,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "천만 사극 얘기도 나오고 있습니다"
    } ]
  }, {
    "tStartMs": 98410,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "아직은 좀 설레발이긴 한데"
    } ]
  }, {
    "tStartMs": 100320,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "한번 기대해 보겠습니다"
    } ]
  }, {
    "tStartMs": 101560,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "참고로 우리나라 사극 영화 중에"
    } ]
  }, {
    "tStartMs": 103050,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "천만이 달성한 영화가"
    } ]
  }, {
    "tStartMs": 104760,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "지금 4개 정도 있는데"
    } ]
  }, {
    "tStartMs": 106190,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "가장 빠른 게 명량이에요"
    } ]
  }, {
    "tStartMs": 108290,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "12일 미쳤다"
    } ]
  }, {
    "tStartMs": 109760,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "이때가 2014년, 15년"
    } ]
  }, {
    "tStartMs": 111950,
    "dDurationMs": 3730,
    "segs": [ {
      "utf8": "이때가 우리나라 영화계의 최전성기"
    } ]
  }, {
    "tStartMs": 115680,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "2010년대 중반 명량이 12일"
    } ]
  }, {
    "tStartMs": 118400,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "이거 뭐 엄청났죠"
    } ]
  }, {
    "tStartMs": 119990,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "광해, 왕이 된 남자 38일"
    } ]
  }, {
    "tStartMs": 123140,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "왕의 남자가 제일 길었는데 66일"
    } ]
  }, {
    "tStartMs": 125770,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "그리고 지금 왕과 사는 남자가 이 정도입니다"
    } ]
  }, {
    "tStartMs": 127910,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "아마 이렇게 가고 있지 않을까 생각이 돼요"
    } ]
  }, {
    "tStartMs": 130800,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "그래서 이 기세를 한 20일 정도를 이어갈 수 있다면"
    } ]
  }, {
    "tStartMs": 134730,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "아니면 조금 더 길게 이어갈 수 있다면은"
    } ]
  }, {
    "tStartMs": 136800,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "와 천만까지도 기대해볼 수 있지 않을까 생각하는데"
    } ]
  }, {
    "tStartMs": 139740,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "좀 더 힘을 내줘야겠죠"
    } ]
  }, {
    "tStartMs": 141020,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "지금 그런 상황이 왕과 사는 남자라고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 144390,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "우리가 이렇게 천만 영화에 대해서"
    } ]
  }, {
    "tStartMs": 145740,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "기대를 많이 하는 건"
    } ]
  }, {
    "tStartMs": 147080,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "작년에 천만 영화가"
    } ]
  }, {
    "tStartMs": 149650,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "하나도 없었습니다"
    } ]
  }, {
    "tStartMs": 151600,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "작년에 누적 매출액 기준 흥행 순위를 보면"
    } ]
  }, {
    "tStartMs": 154050,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "1위가 주토피아 2였어요"
    } ]
  }, {
    "tStartMs": 155590,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "771만 명"
    } ]
  }, {
    "tStartMs": 156650,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "와 대단한데?"
    } ]
  }, {
    "tStartMs": 157700,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "주토피아 장난 아니었구나"
    } ]
  }, {
    "tStartMs": 159500,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "770만 명이 봤네"
    } ]
  }, {
    "tStartMs": 161100,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "귀칼이 569만 명"
    } ]
  }, {
    "tStartMs": 162510,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "F1 더 무비가 521만 명"
    } ]
  }, {
    "tStartMs": 164090,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "좀비딸이 564만 명"
    } ]
  }, {
    "tStartMs": 165660,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "아 이거는 매출액 순위구나"
    } ]
  }, {
    "tStartMs": 167200,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "좀비딸이 본 사람 순으로는 3위네요 3위"
    } ]
  }, {
    "tStartMs": 170190,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "매출액은 F1 더 무비가 위였고"
    } ]
  }, {
    "tStartMs": 172930,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "작년 흥행작 탑 10을 보면"
    } ]
  }, {
    "tStartMs": 175250,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "매출액 순위로 본 겁니다"
    } ]
  }, {
    "tStartMs": 176740,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "한국영화가 3개밖에 없어요"
    } ]
  }, {
    "tStartMs": 178530,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "탑 10"
    } ]
  }, {
    "tStartMs": 179270,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "주토피아 2 1위"
    } ]
  }, {
    "tStartMs": 180210,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "규멸 2위"
    } ]
  }, {
    "tStartMs": 181140,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "F1 더 무비 3위"
    } ]
  }, {
    "tStartMs": 182320,
    "dDurationMs": 590,
    "segs": [ {
      "utf8": "좀비딸 4위"
    } ]
  }, {
    "tStartMs": 182910,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "아바타 5위"
    } ]
  }, {
    "tStartMs": 183760,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "체인소 맨 6위"
    } ]
  }, {
    "tStartMs": 184940,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "미션 임파서블 7위"
    } ]
  }, {
    "tStartMs": 185910,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "이렇게 쭉 있는데"
    } ]
  }, {
    "tStartMs": 187100,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "한국영화 단 3편이고"
    } ]
  }, {
    "tStartMs": 188920,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "작년 한국영화 흥행 1위는 뭐냐?"
    } ]
  }, {
    "tStartMs": 191630,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "당연히 방금 얘기한 좀비딸이 1위였어요"
    } ]
  }, {
    "tStartMs": 194560,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "누적 관객 수 564만 명"
    } ]
  }, {
    "tStartMs": 197180,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "2025년 한국영화 1위"
    } ]
  }, {
    "tStartMs": 198970,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "이 좀비딸이 웹툰 기반 영화죠"
    } ]
  }, {
    "tStartMs": 200760,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "딸이 좀비가 돼서"
    } ]
  }, {
    "tStartMs": 201780,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "딸을 지키기 위한 휴먼 드라마인데"
    } ]
  }, {
    "tStartMs": 204190,
    "dDurationMs": 3830,
    "segs": [ {
      "utf8": "약간 눈물도 나는 코믹, 휴먼, 눈물"
    } ]
  }, {
    "tStartMs": 208020,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "이런 영화라고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 209570,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "근데 564만 명이니까"
    } ]
  }, {
    "tStartMs": 211270,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "좀비딸은 대단한 흥행을 했지만"
    } ]
  }, {
    "tStartMs": 213220,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "천만 영화는 작년에 없었다고 보시면 되고요"
    } ]
  }, {
    "tStartMs": 216510,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "그리고 2025년 전체 영화관을 찾은 관객 수는 얼마냐"
    } ]
  }, {
    "tStartMs": 220320,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "늘었냐"
    } ]
  }, {
    "tStartMs": 220820,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "2024년 대비"
    } ]
  }, {
    "tStartMs": 222940,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "줄었습니다"
    } ]
  }, {
    "tStartMs": 224160,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "13%가 줄었어요"
    } ]
  }, {
    "tStartMs": 226130,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "그러니까 이게 코로나 때 내려간 다음에 회복을 해서"
    } ]
  }, {
    "tStartMs": 229390,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "옛날 코로나 이전 시기로 돌아갈 줄 알았는데"
    } ]
  }, {
    "tStartMs": 231820,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "오르다가 내려가고 있어요"
    } ]
  }, {
    "tStartMs": 233650,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "이게 우리나라 영화관 관객 수의 모습입니다"
    } ]
  }, {
    "tStartMs": 236790,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "이런 나라가 그렇게 많지는 않거든요"
    } ]
  }, {
    "tStartMs": 238250,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "제가 모든 나라를 보지는 않았지만"
    } ]
  }, {
    "tStartMs": 240010,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "대부분 예전 숫자로 거의 다 이렇게 올라가는 모습을 보이는데"
    } ]
  }, {
    "tStartMs": 243630,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "우리는 올라가다가 내려가고 있다는 거죠"
    } ]
  }, {
    "tStartMs": 245930,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "누적 관객 수 1억 명을 간신히 넘겼어요"
    } ]
  }, {
    "tStartMs": 248560,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "만약에 올해도 10%대로 하락을 한다면"
    } ]
  }, {
    "tStartMs": 250770,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "1억 명이 깨질 수가 있습니다"
    } ]
  }, {
    "tStartMs": 252780,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "이런 상황이고요"
    } ]
  }, {
    "tStartMs": 253730,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "특히 어느 영화가 안 좋았냐?"
    } ]
  }, {
    "tStartMs": 255430,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "작년은 제 생각인데"
    } ]
  }, {
    "tStartMs": 257800,
    "dDurationMs": 3710,
    "segs": [ {
      "utf8": "한국영화 무덤의 해였다고 해도 과언이 아닙니다"
    } ]
  }, {
    "tStartMs": 261510,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "2024년만 해도 7천만 명이 봤거든요"
    } ]
  }, {
    "tStartMs": 263720,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "우리나라 영화를"
    } ]
  }, {
    "tStartMs": 264500,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "2025년에는 4,300만 명이 봤어요"
    } ]
  }, {
    "tStartMs": 266860,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "마이너스 39%"
    } ]
  }, {
    "tStartMs": 268520,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "거의 40%가 날라갔어요"
    } ]
  }, {
    "tStartMs": 270340,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "물론 2025년에 흥행 대작이 좀 없었다"
    } ]
  }, {
    "tStartMs": 273460,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "흥행 대작이 한 번 빡 터뜨려주면"
    } ]
  }, {
    "tStartMs": 275900,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "천만 영화 나오면서 숫자가 올라가는데"
    } ]
  }, {
    "tStartMs": 277940,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "흥행 대작이 좀 없다 보니까"
    } ]
  }, {
    "tStartMs": 279650,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "또 흥행이 좀 실패했다 보니까"
    } ]
  }, {
    "tStartMs": 281070,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "40% 가까이 줄었고"
    } ]
  }, {
    "tStartMs": 282550,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "반면에 외국 영화는 크게 늘었습니다"
    } ]
  }, {
    "tStartMs": 284990,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "천만 가까이 늘었어요"
    } ]
  }, {
    "tStartMs": 286080,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "20% 가까이 늘어서"
    } ]
  }, {
    "tStartMs": 287700,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "한국영화의 비중이 훨씬 내려갔고"
    } ]
  }, {
    "tStartMs": 289770,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "그리고 12월, 작년 말에"
    } ]
  }, {
    "tStartMs": 292470,
    "dDurationMs": 4090,
    "segs": [ {
      "utf8": "전년 2024년 12월 대비 2025년 12월에"
    } ]
  }, {
    "tStartMs": 296560,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "한국영화 관객 수가 76%가 없어졌습니다"
    } ]
  }, {
    "tStartMs": 299810,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "12월 영화들이"
    } ]
  }, {
    "tStartMs": 301300,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "우리나라 영화들이 흥행을 잘 못했고"
    } ]
  }, {
    "tStartMs": 302850,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "작년 12월이 사실 대박이었고"
    } ]
  }, {
    "tStartMs": 305060,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "대작들이 끌면서 끌고 간 게 있었는데"
    } ]
  }, {
    "tStartMs": 307130,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "올해는 끌고 가지 못했기 때문에"
    } ]
  }, {
    "tStartMs": 309450,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "2005년 이후 최저 관객 수다"
    } ]
  }, {
    "tStartMs": 311510,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "코로나 시기를 빼면"
    } ]
  }, {
    "tStartMs": 312700,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "176만 명밖에 한국영화의 관객 수가 오지 않았죠"
    } ]
  }, {
    "tStartMs": 316300,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "작년 12월을 그려보면 이렇게 됩니다"
    } ]
  }, {
    "tStartMs": 318500,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "외국 영화, 디즈니 영화"
    } ]
  }, {
    "tStartMs": 319820,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "주토피아와 아바타 같은 게 쌍끌이를 했고"
    } ]
  }, {
    "tStartMs": 322890,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "전체적으로 그래서 12월에 영화관에 온 사람의 숫자는 더 늘었어요"
    } ]
  }, {
    "tStartMs": 326200,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "하지만 한국영화를 보러 온 사람들의 숫자는"
    } ]
  }, {
    "tStartMs": 328480,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "굉장히 크게 감소한 게"
    } ]
  }, {
    "tStartMs": 329850,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "작년 그리고 작년 12월이라고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 332480,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "게다가 작년에 영화관에 오신 분들"
    } ]
  }, {
    "tStartMs": 334250,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "많은 분들은"
    } ]
  }, {
    "tStartMs": 335260,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "정부가 배포한 할인권"
    } ]
  }, {
    "tStartMs": 336760,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "이거 몇 번 소개시켜 드렸죠"
    } ]
  }, {
    "tStartMs": 338330,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "할인권 배포 시기에 6,000원 할인 막 이런"
    } ]
  }, {
    "tStartMs": 340170,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "할인권을 받고 온 사람들이 많았기 때문에"
    } ]
  }, {
    "tStartMs": 342000,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "이런 할인권이 만약에 없어지게 되면"
    } ]
  }, {
    "tStartMs": 344470,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "이제 그만하게 되면은"
    } ]
  }, {
    "tStartMs": 345600,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "1억 명 아래로 내려갈 수도 있지 않냐?"
    } ]
  }, {
    "tStartMs": 347090,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "이런 위기감이 굉장히 큰 게"
    } ]
  }, {
    "tStartMs": 348800,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "요즘  우리나라 영화 시장이라고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 350430,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "자 그래서 여기까지는 다 알죠?"
    } ]
  }, {
    "tStartMs": 352420,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "여기까지 다 알기 때문에"
    } ]
  }, {
    "tStartMs": 353500,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "묘수를 찾아야 돼요"
    } ]
  }, {
    "tStartMs": 355440,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "어떻게 하면은 영화 시장에도 활력을 불어넣고"
    } ]
  }, {
    "tStartMs": 357890,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "어떻게 하면은 더 영화관으로 사람을 끌 수 있을까?"
    } ]
  }, {
    "tStartMs": 360500,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "자 여러분들이"
    } ]
  }, {
    "tStartMs": 361470,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "컨설팅 주제를 받았다고 생각하시고"
    } ]
  }, {
    "tStartMs": 362850,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "묘수를 한번 내보십시오"
    } ]
  }, {
    "tStartMs": 364640,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "몇몇 묘수들을 보여드릴 거예요"
    } ]
  }, {
    "tStartMs": 366780,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "일단 우리나라 정부도"
    } ]
  }, {
    "tStartMs": 367970,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "한국영화의 위기를 당연히 인지하고 있습니다"
    } ]
  }, {
    "tStartMs": 370770,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "얼마 전에 문화체육관광부가 업무 보고를 했는데"
    } ]
  }, {
    "tStartMs": 373110,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "이렇게 얘기를 했어요"
    } ]
  }, {
    "tStartMs": 374350,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "우리나라 영화 산업은 지금 긴급 처방을 받아야 되고"
    } ]
  }, {
    "tStartMs": 377030,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "놀랍게도 심폐소생이 필요하다"
    } ]
  }, {
    "tStartMs": 379550,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "여기 써있죠?"
    } ]
  }, {
    "tStartMs": 380480,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "심폐소생을 해야 된다"
    } ]
  }, {
    "tStartMs": 381960,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "그래서 심폐소생을 이걸 해야 되는데"
    } ]
  }, {
    "tStartMs": 385250,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "긴급 처방전으로 된 게"
    } ]
  }, {
    "tStartMs": 387120,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "가장 위에 된 게"
    } ]
  }, {
    "tStartMs": 388430,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "투자 펀드 제도 개편입니다"
    } ]
  }, {
    "tStartMs": 390270,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "영화계로 돈이 돌도록"
    } ]
  }, {
    "tStartMs": 391610,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "영화 산업에 투자를 할 수 있도록"
    } ]
  }, {
    "tStartMs": 393410,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "그리고 두 번째가"
    } ]
  }, {
    "tStartMs": 394090,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "OTT 영화도 법적 영화를 인정한다는 건데"
    } ]
  }, {
    "tStartMs": 396040,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "뒤에 하나씩 보여드릴게요"
    } ]
  }, {
    "tStartMs": 397310,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "일단 영화계로 돈이 돌고"
    } ]
  }, {
    "tStartMs": 398860,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "투자 펀드 제도를 왜 개편하냐"
    } ]
  }, {
    "tStartMs": 400860,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "얼마 전에 상징적인 사건이 하나 있었는데"
    } ]
  }, {
    "tStartMs": 403640,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "거장이시죠"
    } ]
  }, {
    "tStartMs": 404360,
    "dDurationMs": 3530,
    "segs": [ {
      "utf8": "영화감독 이창동 감독님의 신작"
    } ]
  }, {
    "tStartMs": 407890,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "가능한 사랑이라는 영화가"
    } ]
  }, {
    "tStartMs": 409830,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "투자사를 구하지 못해서"
    } ]
  }, {
    "tStartMs": 411340,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "영화관을 포기하는 일이 있었습니다"
    } ]
  }, {
    "tStartMs": 413750,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "결국 넷플릭스 오픈이 결정됐어요"
    } ]
  }, {
    "tStartMs": 416900,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "올해 아마 상반기 말?"
    } ]
  }, {
    "tStartMs": 419040,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "그 정도면 나오지 않을까 생각하는데"
    } ]
  }, {
    "tStartMs": 420530,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "이건 언제 개봉인지 저도 봐야 될 것 같습니다"
    } ]
  }, {
    "tStartMs": 422830,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "그런데 이창동 감독님이라고 하면"
    } ]
  }, {
    "tStartMs": 425620,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "대표작은 말할 필요도 없고"
    } ]
  }, {
    "tStartMs": 427080,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "상이란 상은 다 받으신"
    } ]
  }, {
    "tStartMs": 428600,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "소위 우리나라 대표적인 거장인데"
    } ]
  }, {
    "tStartMs": 430920,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "국내 투자처를 구하지 못했다"
    } ]
  }, {
    "tStartMs": 433090,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "그리고 저 가능한 사랑이란 영화는"
    } ]
  }, {
    "tStartMs": 434990,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "이창동 감독의 7년 만의 신작이자 출연진이"
    } ]
  }, {
    "tStartMs": 438120,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "전도연, 설경구, 조인성, 조여정이야"
    } ]
  }, {
    "tStartMs": 441840,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "우리나라에 내로라 하는 스타들이 다 출연하는 영화인데도"
    } ]
  }, {
    "tStartMs": 445830,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "국내 투자처를 구하지 못했고"
    } ]
  }, {
    "tStartMs": 447490,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "그래서 영화진흥위원회에서 중저, 대작"
    } ]
  }, {
    "tStartMs": 451420,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "영화 규모마다 지원하는 금액이 있습니다"
    } ]
  }, {
    "tStartMs": 453950,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "한국 영화 제작 지원금 60억에서 80억 정도 지원해줄게"
    } ]
  }, {
    "tStartMs": 456910,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "라고 얘기를 했는데"
    } ]
  }, {
    "tStartMs": 458010,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "이것보단 넷플릭스행의 조건이 더 좋았기 때문에"
    } ]
  }, {
    "tStartMs": 460250,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "결국에 영화관을 건너뛰고"
    } ]
  }, {
    "tStartMs": 462260,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "넷플릭스에서 풀리는 걸로"
    } ]
  }, {
    "tStartMs": 463600,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "그렇게 결정이 됐죠"
    } ]
  }, {
    "tStartMs": 464880,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "한마디로 이거를 딱 들어보면"
    } ]
  }, {
    "tStartMs": 466950,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "영화계에서는 신문에서 나온 것 제가 그대로 가져오면"
    } ]
  }, {
    "tStartMs": 469450,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "경향신문에서 나온 그대로 가져오면"
    } ]
  }, {
    "tStartMs": 471320,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "영화계에서는 올 것이 왔다라고 생각한다고 합니다"
    } ]
  }, {
    "tStartMs": 474530,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "이제는 돈이 안 되는 영화는 어려워졌기 때문에"
    } ]
  }, {
    "tStartMs": 477220,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "보러 오는 분도 없고"
    } ]
  }, {
    "tStartMs": 478590,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "적자가 날게 너무나 명확한 상황에서"
    } ]
  }, {
    "tStartMs": 481000,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "돈이 안 되는 영화는"
    } ]
  }, {
    "tStartMs": 481900,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "이제 개봉하기 어려운 거 아니냐"
    } ]
  }, {
    "tStartMs": 483050,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "상업성과 작품성까지 다 고려해서"
    } ]
  }, {
    "tStartMs": 485560,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "적절하게 포트폴리오를 짤 수 있는 여력이 있는 투자 배급사가"
    } ]
  }, {
    "tStartMs": 488690,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "이제 거의 없어졌다"
    } ]
  }, {
    "tStartMs": 490020,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "그렇게 했다가"
    } ]
  }, {
    "tStartMs": 491010,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "요 몇 년간의 엄청난 타격을 입었다는 거죠"
    } ]
  }, {
    "tStartMs": 492990,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "코로나 때 엄청난 타격을 입었고"
    } ]
  }, {
    "tStartMs": 494790,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "최근에도 한국영화가 굉장히 어려움을 겪으면서"
    } ]
  }, {
    "tStartMs": 497050,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "투자사, 배급사들의 자금이다 말라 버려서"
    } ]
  }, {
    "tStartMs": 499240,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "이제 그런 자금을 집행할 수 있는 곳이 거의 없어졌고"
    } ]
  }, {
    "tStartMs": 502270,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "심지어 넷플릭스는 더 세게 부르기 때문에"
    } ]
  }, {
    "tStartMs": 504410,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "넷플릭스와 경쟁에서 밀리고 있다"
    } ]
  }, {
    "tStartMs": 506210,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "그런 말이 되겠습니다"
    } ]
  }, {
    "tStartMs": 507300,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "저는 이걸 보면서"
    } ]
  }, {
    "tStartMs": 508400,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "격세지감을 많이 느낀 게"
    } ]
  }, {
    "tStartMs": 510260,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "2017년에 국내 영화관들이"
    } ]
  }, {
    "tStartMs": 512750,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "넷플릭스와 동시 개봉한다 그러니까"
    } ]
  }, {
    "tStartMs": 515200,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "동시 공개한다 그러니까"
    } ]
  }, {
    "tStartMs": 516610,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "거기에 반발해서"
    } ]
  }, {
    "tStartMs": 518160,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "그 영화 상영을 보이콧한 일이 있었습니다"
    } ]
  }, {
    "tStartMs": 520970,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "불과는 아니네"
    } ]
  }, {
    "tStartMs": 521570,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "거의 10년 전이네"
    } ]
  }, {
    "tStartMs": 522410,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "9년 전에"
    } ]
  }, {
    "tStartMs": 523470,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "봉준호 감독님의 옥자"
    } ]
  }, {
    "tStartMs": 525920,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "이 옥자를 넷플릭스 하고"
    } ]
  }, {
    "tStartMs": 528250,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "전 세계에 동시 공개하겠다 영화관까지"
    } ]
  }, {
    "tStartMs": 530780,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "그랬더니 그때 대형 업체들이"
    } ]
  }, {
    "tStartMs": 532310,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "그때 관행이 선 극장 후 OTT 개봉이었어요"
    } ]
  }, {
    "tStartMs": 536420,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "선 극장 개봉을 안 하고"
    } ]
  }, {
    "tStartMs": 537630,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "동시에 한다 그러니까"
    } ]
  }, {
    "tStartMs": 538840,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "못해"
    } ]
  }, {
    "tStartMs": 539550,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "우리도 그런 거 못해"
    } ]
  }, {
    "tStartMs": 540930,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "관행을 지켜"
    } ]
  }, {
    "tStartMs": 541870,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "자존심이 있지 말이야"
    } ]
  }, {
    "tStartMs": 542700,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "그거 안 돼"
    } ]
  }, {
    "tStartMs": 543520,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "그래서 상영을 못하겠다고"
    } ]
  }, {
    "tStartMs": 544510,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "보이콧한 일이 있었습니다"
    } ]
  }, {
    "tStartMs": 546290,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "그게 그렇게 오래되지 않았는데"
    } ]
  }, {
    "tStartMs": 548250,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "10년이 안 지났죠"
    } ]
  }, {
    "tStartMs": 549210,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "불과 10년이 안 지났지만"
    } ]
  }, {
    "tStartMs": 550440,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "이제 2026년에 분위기가 완전히 바뀌었죠"
    } ]
  }, {
    "tStartMs": 554440,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "이제는 대작들이 극장을 건너뛰고"
    } ]
  }, {
    "tStartMs": 556580,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "OTT를 가는 게 낯설지 않습니다"
    } ]
  }, {
    "tStartMs": 558240,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "OTT에서 만들어지는 그런 콘텐츠의 가격이 더 비싸지는"
    } ]
  }, {
    "tStartMs": 561960,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "제작비가 더 높아지는 게"
    } ]
  }, {
    "tStartMs": 563930,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "이제 어색하지 않죠"
    } ]
  }, {
    "tStartMs": 565090,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "이제 어색하지 않고"
    } ]
  }, {
    "tStartMs": 566220,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "대작을 OTT에서 봐라 그랬을 때"
    } ]
  }, {
    "tStartMs": 567880,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "너무나 당연하게 여기는 게 지금이 됐으니까"
    } ]
  }, {
    "tStartMs": 570880,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "진짜 10년 만에 뭔가 많이 바뀌었다라는 걸 알 수 있고요"
    } ]
  }, {
    "tStartMs": 574170,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "저는 이걸 보면서 약간 이 생각도 들었어요"
    } ]
  }, {
    "tStartMs": 576040,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "2010년대 초반, 중반에"
    } ]
  }, {
    "tStartMs": 578000,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "이건 지금 영화잖아요"
    } ]
  }, {
    "tStartMs": 579550,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "유튜브와 방송사 간에도"
    } ]
  }, {
    "tStartMs": 581010,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "비슷한 다툼이 있었습니다"
    } ]
  }, {
    "tStartMs": 583240,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "저는 아주 잘 알고 있죠"
    } ]
  }, {
    "tStartMs": 584380,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "알고 있어요"
    } ]
  }, {
    "tStartMs": 585670,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "왜냐면 그때는 2015년 때쯤에 하여튼 중반"
    } ]
  }, {
    "tStartMs": 589900,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "뭐라고 생각했냐"
    } ]
  }, {
    "tStartMs": 590910,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "당시 방송사들이 자사 콘텐츠 유튜브 공개에"
    } ]
  }, {
    "tStartMs": 593730,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "강한 거부감이 있었습니다"
    } ]
  }, {
    "tStartMs": 596180,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "내 뉴스, 내 드라마, 내 예능"
    } ]
  }, {
    "tStartMs": 598240,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "그거 왜 짤로 잘라가지고 올려?"
    } ]
  }, {
    "tStartMs": 600530,
    "dDurationMs": 670,
    "segs": [ {
      "utf8": "안 돼"
    } ]
  }, {
    "tStartMs": 601200,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "우리가 자존심이 있지 말이야"
    } ]
  }, {
    "tStartMs": 602650,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "우리 지상파 3사가"
    } ]
  }, {
    "tStartMs": 603840,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "유튜브 따위에 지금 우리 거 올려야 돼?"
    } ]
  }, {
    "tStartMs": 605930,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "안 돼"
    } ]
  }, {
    "tStartMs": 606490,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "옛날 거라도 올리자"
    } ]
  }, {
    "tStartMs": 607460,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "옛날 거 뭘 올려"
    } ]
  }, {
    "tStartMs": 608350,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "안 돼! 라고 해서 놀랍게도 그랬어요"
    } ]
  }, {
    "tStartMs": 611560,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "십 몇 년 전에"
    } ]
  }, {
    "tStartMs": 612440,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "야 이거는 말이야"
    } ]
  }, {
    "tStartMs": 613340,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "그럴 수 없다"
    } ]
  }, {
    "tStartMs": 615700,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "지금은 어떻게 됐냐"
    } ]
  }, {
    "tStartMs": 617150,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "지금은 우리나라 방송사들이"
    } ]
  }, {
    "tStartMs": 619310,
    "dDurationMs": 5740,
    "segs": [ {
      "utf8": "세계적으로도 압도적으로까지 얘기되는 유튜버입니다"
    } ]
  }, {
    "tStartMs": 625050,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "제가 그래서 밥 벌어먹고 살기 힘들어요"
    } ]
  }, {
    "tStartMs": 626710,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "기존 스탠스를 좀 지켜주셨으면 좋겠어"
    } ]
  }, {
    "tStartMs": 629430,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "기존 스탠스대로 가시지"
    } ]
  }, {
    "tStartMs": 630690,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "왜 여기서 뭐"
    } ]
  }, {
    "tStartMs": 632630,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "아니 그리고 채널도 하나로 해요 하나"
    } ]
  }, {
    "tStartMs": 634560,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "반칙이야"
    } ]
  }, {
    "tStartMs": 635610,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "예능 하나 만들면 채널 하나 파고"
    } ]
  }, {
    "tStartMs": 637430,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "드라마 하나 만들면 채널 하나 파고"
    } ]
  }, {
    "tStartMs": 639230,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "아니 뭐 예능, 스포츠, 뉴스부 다 파고 있고"
    } ]
  }, {
    "tStartMs": 641830,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "너무 많으신 거 아닙니까 너무?"
    } ]
  }, {
    "tStartMs": 644220,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "전 세계적으로도 우리나라 방송사만큼"
    } ]
  }, {
    "tStartMs": 646780,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "유튜브를 잘 활용하는 곳이 없다라는 평가를 받았죠"
    } ]
  }, {
    "tStartMs": 649730,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "KBS가 2025년 한 해 동안"
    } ]
  }, {
    "tStartMs": 651200,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "유튜브 누적 조회수 180억 회를 기록했다"
    } ]
  }, {
    "tStartMs": 653760,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "아니 뭐 조회수, 콘텐츠 숫자"
    } ]
  }, {
    "tStartMs": 656980,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "아니 계속 좀 그쵸?"
    } ]
  }, {
    "tStartMs": 659380,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "이걸 좀 지키시고"
    } ]
  }, {
    "tStartMs": 660690,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "체면을 지키시고 계속해 주셨으면 좋겠는데"
    } ]
  }, {
    "tStartMs": 663130,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "거기에 또 우리..."
    } ]
  }, {
    "tStartMs": 664770,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "불쌍한 저 같은 사람들이"
    } ]
  }, {
    "tStartMs": 666150,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "한 땀 한 땀 수공예로 하는 거 라서"
    } ]
  }, {
    "tStartMs": 668040,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "가내 공장으로 막 해서 힘듭니다"
    } ]
  }, {
    "tStartMs": 671670,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "제 생각에 우리나라 최고의 유튜버는 방송사들이다"
    } ]
  }, {
    "tStartMs": 675040,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "방송사들"
    } ]
  }, {
    "tStartMs": 676080,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "거의 수백 명, 수천 명이 저걸 하고 있기 때문에"
    } ]
  }, {
    "tStartMs": 678880,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "전혀 또 완전히 세상이 달라졌죠"
    } ]
  }, {
    "tStartMs": 680930,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "그리고 이걸로 통해서"
    } ]
  }, {
    "tStartMs": 682080,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "새로운 파이프 라인"
    } ]
  }, {
    "tStartMs": 683230,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "새로운 수익 모델로 만들어서"
    } ]
  }, {
    "tStartMs": 685280,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "그게 또 수익이 대박이야"
    } ]
  }, {
    "tStartMs": 688100,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "그런 시대가 왔습니다"
    } ]
  }, {
    "tStartMs": 689920,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "한마디로 과거에는 영화 패싱하고"
    } ]
  }, {
    "tStartMs": 693020,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "넷플릭스로 가냐 그런 것들이 많았지만"
    } ]
  }, {
    "tStartMs": 694690,
    "dDurationMs": 4130,
    "segs": [ {
      "utf8": "이제는 반대로 넷플릭스로 다 뛰어들어가니까"
    } ]
  }, {
    "tStartMs": 698820,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "한국영화, 영화 시장에 또 침체가 오는 거 아니냐"
    } ]
  }, {
    "tStartMs": 701860,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "다 OTT로 가면"
    } ]
  }, {
    "tStartMs": 702780,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "영화관에는 누가 와"
    } ]
  }, {
    "tStartMs": 703700,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "영화관에는 뭘 올려"
    } ]
  }, {
    "tStartMs": 704890,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "그리고 영화라는 게"
    } ]
  }, {
    "tStartMs": 706520,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "조금 관객 수가 적더라도"
    } ]
  }, {
    "tStartMs": 708650,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "다양한 얘기가 돼야 되는데"
    } ]
  }, {
    "tStartMs": 709890,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "대작 아니면 투자를 안 한다 그러니까"
    } ]
  }, {
    "tStartMs": 712130,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "어떻게 다 대작만 합니까"
    } ]
  }, {
    "tStartMs": 713530,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "그 아래에 있는 영화가 고사하는 거 아니냐"
    } ]
  }, {
    "tStartMs": 715990,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "이런 걱정들을 많이 하신다는 거죠"
    } ]
  }, {
    "tStartMs": 718080,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "그래서 이번에 영화 산업 위기 극복을 위해서"
    } ]
  }, {
    "tStartMs": 720540,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "818억 원의 펀드를 긴급하게 결성해서 추진하겠다"
    } ]
  }, {
    "tStartMs": 723990,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "이런 내용이 있고요"
    } ]
  }, {
    "tStartMs": 725110,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "정부가 60% 이상 출자를 하고"
    } ]
  }, {
    "tStartMs": 727530,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "민간 투자자의 참여를 확대하기 위해서"
    } ]
  }, {
    "tStartMs": 729330,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "우선 손실충당"
    } ]
  }, {
    "tStartMs": 730520,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "정부가 먼저 우선 손실을 하고요"
    } ]
  }, {
    "tStartMs": 732070,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "수익 비율 높여주고"
    } ]
  }, {
    "tStartMs": 733130,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "콜옵션 같은 걸 해주는 인센티브를 제공하는 것을"
    } ]
  }, {
    "tStartMs": 735730,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "또 추진하고 있다고 합니다"
    } ]
  }, {
    "tStartMs": 737120,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "그리고 이런 아이디어도 있대"
    } ]
  }, {
    "tStartMs": 739410,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "아예 그러면 극장 개봉 영화를"
    } ]
  }, {
    "tStartMs": 742220,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "OTT 늦게 보내게 하는 걸 법으로 만들면 어떨까?"
    } ]
  }, {
    "tStartMs": 747360,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "전 이 얘기를 처음 듣고 깜짝 놀랐습니다"
    } ]
  }, {
    "tStartMs": 749380,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "야 진짜로?"
    } ]
  }, {
    "tStartMs": 750620,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "아 극장에 일단 개봉하면"
    } ]
  }, {
    "tStartMs": 753080,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "최대 6개월 동안은"
    } ]
  }, {
    "tStartMs": 754340,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "OTT로 못 가게 막자"
    } ]
  }, {
    "tStartMs": 756960,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "아 영화계도 싫어하실 것 같은데?"
    } ]
  }, {
    "tStartMs": 759130,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "영화가 잘 안 되면"
    } ]
  }, {
    "tStartMs": 759960,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "빨리 OTT 보내서"
    } ]
  }, {
    "tStartMs": 761660,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "돈을 벌어야 되는 거 아닌가?"
    } ]
  }, {
    "tStartMs": 763360,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "홀드백 법제화라 그러는데"
    } ]
  }, {
    "tStartMs": 764740,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "아 이걸 좋아하시려는지"
    } ]
  }, {
    "tStartMs": 765840,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "저도 잘 모르겠습니다"
    } ]
  }, {
    "tStartMs": 767120,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "영화가 영화관 개봉 후에는"
    } ]
  }, {
    "tStartMs": 768760,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "다른 플랫폼에 공개되기까지"
    } ]
  }, {
    "tStartMs": 770430,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "무조건 6개월 간에 홀드해라"
    } ]
  }, {
    "tStartMs": 772990,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "라는 법안이 발의됐다는데"
    } ]
  }, {
    "tStartMs": 774200,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "한마디로 아유 모르겠다"
    } ]
  }, {
    "tStartMs": 775430,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "나중에 넷플릭스에서 보면 되지 뭐"
    } ]
  }, {
    "tStartMs": 777270,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "라는 생각 방지하자는 거죠"
    } ]
  }, {
    "tStartMs": 779330,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "6개월 간을 못 보니까"
    } ]
  }, {
    "tStartMs": 780800,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "어서 극장 가서 보세요"
    } ]
  }, {
    "tStartMs": 782370,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "법이 되겠는데"
    } ]
  }, {
    "tStartMs": 783970,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "아..."
    } ]
  }, {
    "tStartMs": 785100,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "이건 좀..."
    } ]
  }, {
    "tStartMs": 786580,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "그럼 아예 영화관을 건너뛰는 영화들이 더 늘어나지 않을까?"
    } ]
  }, {
    "tStartMs": 789430,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "6개월 내에"
    } ]
  }, {
    "tStartMs": 790400,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "이거를 법안으로 막아야 될 일인가라는"
    } ]
  }, {
    "tStartMs": 792660,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "개인적인 생각이 들긴 합니다"
    } ]
  }, {
    "tStartMs": 794120,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "근데 영화계에서는 이걸 좋아하시는지 싫어하는지"
    } ]
  }, {
    "tStartMs": 795800,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "저도 정확히 모르겠어요"
    } ]
  }, {
    "tStartMs": 796960,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "하여튼 이런 법안도"
    } ]
  }, {
    "tStartMs": 797910,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "이제 여러 가지 아이디어를 생각해보니까"
    } ]
  }, {
    "tStartMs": 799610,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "통과됐다는 건 아니니까"
    } ]
  }, {
    "tStartMs": 801250,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "그리고 개인적으로 갑자기 떠오르는 거는"
    } ]
  }, {
    "tStartMs": 803520,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "대한민국의 스크린 쿼터제가 갑자기 비슷하게 떠오르는데"
    } ]
  }, {
    "tStartMs": 806600,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "2006년에 한국영화 의무 상영제도 다 아시죠?"
    } ]
  }, {
    "tStartMs": 809460,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "스크린 쿼터제도"
    } ]
  }, {
    "tStartMs": 810750,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "그때 당시에는 1년 중에"
    } ]
  }, {
    "tStartMs": 812240,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "146일은 한국영화를 상영해야 된다는 쿼터가 있었습니다"
    } ]
  }, {
    "tStartMs": 814850,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "한미 FTA로 이게 절반이 났어요"
    } ]
  }, {
    "tStartMs": 817370,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "146일에서 73일로"
    } ]
  }, {
    "tStartMs": 818950,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "대단히 큰 반발이 있었죠"
    } ]
  }, {
    "tStartMs": 820860,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "한미 FTA가 워낙 큰 국가적 사안이니까"
    } ]
  }, {
    "tStartMs": 823500,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "73일로 축소가 되고"
    } ]
  }, {
    "tStartMs": 824830,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "지금도 73일로 운영이 되고 있습니다"
    } ]
  }, {
    "tStartMs": 827550,
    "dDurationMs": 420,
    "segs": [ {
      "utf8": "제가 알기에"
    } ]
  }, {
    "tStartMs": 827970,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "지금도 스크린 쿼터제가 73일이 있는데"
    } ]
  }, {
    "tStartMs": 830510,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "물론 이제는 한국영화가"
    } ]
  }, {
    "tStartMs": 831630,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "워낙에 경쟁력이 좋아져서"
    } ]
  }, {
    "tStartMs": 832830,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "73일이 문제가 아니라"
    } ]
  }, {
    "tStartMs": 834220,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "훨씬 더 많이 했죠"
    } ]
  }, {
    "tStartMs": 835540,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "천만 영화가 쏟아지고 했으니까"
    } ]
  }, {
    "tStartMs": 838390,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "그런데 잘 생각해보면"
    } ]
  }, {
    "tStartMs": 840600,
    "dDurationMs": 3710,
    "segs": [ {
      "utf8": "OTT에는 스크린 쿼터제도가 있을 자리가 없습니다"
    } ]
  }, {
    "tStartMs": 844310,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "OTT에 스크린 쿼터제도라는 게 있기 힘들잖아"
    } ]
  }, {
    "tStartMs": 847580,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "뭐 찾으면 있는 거지"
    } ]
  }, {
    "tStartMs": 848660,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "OTT가 극장 개봉 같은 그런 게 있는 건 아니니까"
    } ]
  }, {
    "tStartMs": 851620,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "언제든지 가서 볼 수 있는 거여서"
    } ]
  }, {
    "tStartMs": 853800,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "그러면 한국영화들이"
    } ]
  }, {
    "tStartMs": 855730,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "더 위기를 느낀다는 건데"
    } ]
  }, {
    "tStartMs": 856900,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "물론 지금은 한국 콘텐츠가 OTT의 짱이기 때문에"
    } ]
  }, {
    "tStartMs": 859280,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "오징어 게임도 있고 뭐도 있고"
    } ]
  }, {
    "tStartMs": 860500,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "우리나라 콘텐츠를 하면"
    } ]
  }, {
    "tStartMs": 861320,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "오히려 글로벌로 더 잘 돼서"
    } ]
  }, {
    "tStartMs": 863310,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "스크린 쿼터제라는 건 이제 필요가 전혀 없긴 한데"
    } ]
  }, {
    "tStartMs": 866440,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "오히려 글로벌 다른 나라들이"
    } ]
  }, {
    "tStartMs": 867930,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "한국 거 그만 틀어라 라고 해야 되는 상황이긴 하지만"
    } ]
  }, {
    "tStartMs": 871160,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "뭐 앞으로는 알 수 없죠"
    } ]
  }, {
    "tStartMs": 872350,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "자 그리고 이 아이디어는 정말 깜짝 놀랐는데"
    } ]
  }, {
    "tStartMs": 875910,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "아예 OTT 공개 작품도"
    } ]
  }, {
    "tStartMs": 878380,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "영화로 정의하면 어떨까?"
    } ]
  }, {
    "tStartMs": 880540,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "그럼 문제 해결 아닐까?"
    } ]
  }, {
    "tStartMs": 882420,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "무슨 말입니까?"
    } ]
  }, {
    "tStartMs": 883520,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "영화의 위기라고 하는데"
    } ]
  }, {
    "tStartMs": 884960,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "그건 영화관이나 극장 개봉 영화를 얘기하잖아"
    } ]
  }, {
    "tStartMs": 887380,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "OTT 공개 작품도 영화로 정의하면"
    } ]
  }, {
    "tStartMs": 889520,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "OTT 공개 작품 잘 되고 있네"
    } ]
  }, {
    "tStartMs": 891340,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "그럼 문제는 해결된 거 아닐까?"
    } ]
  }, {
    "tStartMs": 893630,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "라는 생각을 한다는 거죠"
    } ]
  }, {
    "tStartMs": 895240,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "이야 천재인데?"
    } ]
  }, {
    "tStartMs": 896830,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "넷플릭스에 올라가는 것도"
    } ]
  }, {
    "tStartMs": 898190,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "다 영화로 만들면 누가 드라마라 그래?"
    } ]
  }, {
    "tStartMs": 900330,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "영화"
    } ]
  }, {
    "tStartMs": 901290,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "그럼 영화가 잘 되는 거죠"
    } ]
  }, {
    "tStartMs": 902400,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "OTT 요즘 엄청 잘 돼요"
    } ]
  }, {
    "tStartMs": 903930,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "그럼 영화 잘 되는 거죠"
    } ]
  }, {
    "tStartMs": 905390,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "이거는 영화관"
    } ]
  }, {
    "tStartMs": 907360,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "극장의 위기일 뿐이지"
    } ]
  }, {
    "tStartMs": 908900,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "영화의 위기는 아니지 않냐"
    } ]
  }, {
    "tStartMs": 911510,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "영화의 정의를 넓히면 넓히면"
    } ]
  }, {
    "tStartMs": 914620,
    "dDurationMs": 630,
    "segs": [ {
      "utf8": "자 좋습니다"
    } ]
  }, {
    "tStartMs": 915250,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "잘하면 유튜브 숏 드라마도"
    } ]
  }, {
    "tStartMs": 916440,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "영화가 될 수 있어요"
    } ]
  }, {
    "tStartMs": 917530,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "유튜브 숏 드라마 영화가 될 수 있기 때문에"
    } ]
  }, {
    "tStartMs": 919360,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "뭐 그러면 잘 되고 있는 게 아니냐라는"
    } ]
  }, {
    "tStartMs": 921970,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "이런 놀라운 믿거나 말거나 의견이 있는데"
    } ]
  }, {
    "tStartMs": 924760,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "실제 있는 의견입니다"
    } ]
  }, {
    "tStartMs": 926260,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "지금 현재 OTT 공개 작품도"
    } ]
  }, {
    "tStartMs": 928580,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "법적 영화로 보자는 법안도 발의됐습니다"
    } ]
  }, {
    "tStartMs": 931410,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "물론 여기는 그런 뜻보다는"
    } ]
  }, {
    "tStartMs": 933790,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "영화 진흥 기금들이나 영화 진흥 법안들을"
    } ]
  }, {
    "tStartMs": 937090,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "OTT 공개 작품에도 적용을 하자"
    } ]
  }, {
    "tStartMs": 939700,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "지금은 극장 개봉 작품만 지원할 수 있으니까 법들이"
    } ]
  }, {
    "tStartMs": 944060,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "영화의 정의가 그렇게 돼 있어서"
    } ]
  }, {
    "tStartMs": 945610,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "OTT 공개 작품이 지원이 제대로 안 되는데"
    } ]
  }, {
    "tStartMs": 947920,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "조그마한 단편 영화도 OTT로 공개하면 되지"
    } ]
  }, {
    "tStartMs": 950130,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "뭐 이런 생각들을 하다 보니까"
    } ]
  }, {
    "tStartMs": 951760,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "이제는 OTT 공개 작품도"
    } ]
  }, {
    "tStartMs": 952990,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "법적 영화로 하면 되는 게 아니냐라는 법안도 나와 있다고 합니다"
    } ]
  }, {
    "tStartMs": 956750,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "실제로 이게 작은 일이 아니라"
    } ]
  }, {
    "tStartMs": 958130,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "문체부 기자회견에서도"
    } ]
  }, {
    "tStartMs": 959900,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "아까 업무 보고할 때"
    } ]
  }, {
    "tStartMs": 961120,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "영화에 대한 질문이 여럿 올라왔는데"
    } ]
  }, {
    "tStartMs": 962880,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "이때 문체부 장관님이 이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 964780,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "OTT 영화도 법상 영화로 포섭하면 어떤 영향이 있습니까?"
    } ]
  }, {
    "tStartMs": 967580,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "그랬더니 극장에 개봉해야 영화라는 생각은 낡은 규정이다"
    } ]
  }, {
    "tStartMs": 971580,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "현재는 과도기 상태라 하나씩 풀어야 되는데"
    } ]
  }, {
    "tStartMs": 973330,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "아까 전에 나온 이창동 감독님의 가능한 사랑"
    } ]
  }, {
    "tStartMs": 975200,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "이게 영화잖아"
    } ]
  }, {
    "tStartMs": 976100,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "OTT에 나온다고 영화 아니냐"
    } ]
  }, {
    "tStartMs": 977950,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "영화로 되는 게 맞다"
    } ]
  }, {
    "tStartMs": 979260,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "그러면 관객 수로 지금까지 영화의 흥행을 매겼는데"
    } ]
  }, {
    "tStartMs": 983400,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "이제는 아닐 수도 있어요"
    } ]
  }, {
    "tStartMs": 985020,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "이제는 수익으로 매길 수도 있습니다"
    } ]
  }, {
    "tStartMs": 986980,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "천만 영화 이게 아니라"
    } ]
  }, {
    "tStartMs": 988130,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "천억 영화 이렇게 될 수도 있습니다"
    } ]
  }, {
    "tStartMs": 989750,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "이 천억 영화"
    } ]
  }, {
    "tStartMs": 990590,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "돈을 얼마나 벌었는지에 따라서"
    } ]
  }, {
    "tStartMs": 992330,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "매출에 따라서"
    } ]
  }, {
    "tStartMs": 993570,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "아마 그럴 수 있지 않을까 생각이 됩니다"
    } ]
  }, {
    "tStartMs": 995840,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "그리고 제가 보기에 나름 괜찮은 묘수"
    } ]
  }, {
    "tStartMs": 999380,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "지금까지 나온 것 중에"
    } ]
  }, {
    "tStartMs": 1000130,
    "dDurationMs": 3610,
    "segs": [ {
      "utf8": "가장 뛰어난 아이디어 중에 하나가 이번에 나왔는데"
    } ]
  }, {
    "tStartMs": 1003740,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "현재 정부는 구독형 영화패스 제도를 발표했습니다"
    } ]
  }, {
    "tStartMs": 1007900,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "소위 영화관 구독제"
    } ]
  }, {
    "tStartMs": 1010870,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "이거를 진행하겠다"
    } ]
  }, {
    "tStartMs": 1012890,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "아직 결정은 안 됐어요"
    } ]
  }, {
    "tStartMs": 1014200,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "앞으로 청사진 같은 게 나온 겁니다"
    } ]
  }, {
    "tStartMs": 1016350,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "일정한 금액을 내면"
    } ]
  }, {
    "tStartMs": 1017610,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "극장에서 일정한 기간 동안"
    } ]
  }, {
    "tStartMs": 1019100,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "마치 넷플릭스처럼 한 달, 1년 이렇게 내면"
    } ]
  }, {
    "tStartMs": 1021910,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "이제 영화를 가서 마음대로 볼 수 있는"
    } ]
  }, {
    "tStartMs": 1023360,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "프리패스, 무한패스 제도를 만들겠다"
    } ]
  }, {
    "tStartMs": 1025960,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "지금 구체화하는 작업을 하고 있습니다"
    } ]
  }, {
    "tStartMs": 1028420,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "물론, 장관님의 말씀인데"
    } ]
  }, {
    "tStartMs": 1030160,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "구체화된 모습이 어떤 모습일지"
    } ]
  }, {
    "tStartMs": 1031490,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "국가가 지원을 어떻게 할지"
    } ]
  }, {
    "tStartMs": 1033040,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "아직 정해진 바는 없다"
    } ]
  }, {
    "tStartMs": 1034460,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "하지만 올해 상반기 안에는"
    } ]
  }, {
    "tStartMs": 1037050,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "구체적인 모습을 선보일 수 있을 거다"
    } ]
  }, {
    "tStartMs": 1039020,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "곧 나올 것 같습니다 곧"
    } ]
  }, {
    "tStartMs": 1041090,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "얼마일지 모르겠지만"
    } ]
  }, {
    "tStartMs": 1042390,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "지금 영화 극장 산업을 살리는 게 매우 중요하기 때문에"
    } ]
  }, {
    "tStartMs": 1045100,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "상반기 안에는 좀 더 구체적인 모습이 나올 것 같다"
    } ]
  }, {
    "tStartMs": 1047770,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "실행은 하반기거나 내년 초가 될 가능성이 높은데"
    } ]
  }, {
    "tStartMs": 1050730,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "더 땡길 수도 있겠죠"
    } ]
  }, {
    "tStartMs": 1051830,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "하여튼 그런 계획들이 지금 가시화되기 직전이다"
    } ]
  }, {
    "tStartMs": 1054880,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "라고 얘기를 하셨죠"
    } ]
  }, {
    "tStartMs": 1056500,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "그런데 소위 영화관 구독제는"
    } ]
  }, {
    "tStartMs": 1058560,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "아주 새로운 시도가 아닙니다"
    } ]
  }, {
    "tStartMs": 1060270,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "옛날에도 비슷한 게 있었어요"
    } ]
  }, {
    "tStartMs": 1061500,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "문제는 옛날에는 좀 약했어"
    } ]
  }, {
    "tStartMs": 1063170,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "제가 보기에"
    } ]
  }, {
    "tStartMs": 1063960,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "이번에도 이렇게 약하게 나오면 안 돼요"
    } ]
  }, {
    "tStartMs": 1066100,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "옛날에 어떤 게 있었냐"
    } ]
  }, {
    "tStartMs": 1067040,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "2022년에 CGV 월 구독 서비스 있었습니다"
    } ]
  }, {
    "tStartMs": 1070180,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "내용은 이런 거였어요"
    } ]
  }, {
    "tStartMs": 1071240,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "CGV 영화 관람과 TV 이용권을 합쳐서 구독할 수 있습니다"
    } ]
  }, {
    "tStartMs": 1075680,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "근데 문제는 예시가 있습니다"
    } ]
  }, {
    "tStartMs": 1077600,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "예시가 가장 기본적인 게"
    } ]
  }, {
    "tStartMs": 1079230,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "2D 영화 관람 1회, 팝콘 콤보 3,000원 할인 1회"
    } ]
  }, {
    "tStartMs": 1083410,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "티빙 베이직 1개월 합쳐서 15,000원"
    } ]
  }, {
    "tStartMs": 1086590,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "이게 월 구독 서비스라기보다는"
    } ]
  }, {
    "tStartMs": 1088510,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "제가 느끼기엔 영화 한 회에 팝콘 조금 깎아주고"
    } ]
  }, {
    "tStartMs": 1091870,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "티빙 넣어준 거"
    } ]
  }, {
    "tStartMs": 1093800,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "그거 15,000원이라고 하니까"
    } ]
  }, {
    "tStartMs": 1095190,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "우리가 생각하는 무제한 구독제하고는 상당히 차이가 있었죠"
    } ]
  }, {
    "tStartMs": 1099300,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "그리고 당시에 소비자들의 반응이 좀 미적지근했고요"
    } ]
  }, {
    "tStartMs": 1102300,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "왜냐하면 이게 최선이냐"
    } ]
  }, {
    "tStartMs": 1103640,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "월 1회 15,000원"
    } ]
  }, {
    "tStartMs": 1105040,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "월 2회 30,000원"
    } ]
  }, {
    "tStartMs": 1106570,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "뭐야, 별로 안 깎아준 것 같은데"
    } ]
  }, {
    "tStartMs": 1107690,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "아, 팝콘 깎아주고"
    } ]
  }, {
    "tStartMs": 1108470,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "티빙 껴줘"
    } ]
  }, {
    "tStartMs": 1109310,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "그냥 이러다 보니까"
    } ]
  }, {
    "tStartMs": 1110500,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "게다가 2D 영화야"
    } ]
  }, {
    "tStartMs": 1111610,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "3D나 뭐 아니면 4D 이런 거는 추가 뭘 해야 돼"
    } ]
  }, {
    "tStartMs": 1114690,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "할인권 수준 아니냐?"
    } ]
  }, {
    "tStartMs": 1116270,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "뭐 이런 얘기들이 많이 있었고"
    } ]
  }, {
    "tStartMs": 1117660,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "만약에 영화관을 가끔 가는 사람이라면 두 번"
    } ]
  }, {
    "tStartMs": 1120270,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "아니 뭐 굳이"
    } ]
  }, {
    "tStartMs": 1121250,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "심지어 구독료 냈는데"
    } ]
  }, {
    "tStartMs": 1122440,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "못 볼 수도 있는데 이번 달에"
    } ]
  }, {
    "tStartMs": 1124240,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "뭐 얼마 깎아주지도 않는데"
    } ]
  }, {
    "tStartMs": 1125260,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "내가 그걸 해야 되나?"
    } ]
  }, {
    "tStartMs": 1126460,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "라는 반응이 굉장히 많았죠"
    } ]
  }, {
    "tStartMs": 1127950,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "그래서 그 당시 서비스는"
    } ]
  }, {
    "tStartMs": 1129830,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "1년 뒤에 금방 사라졌습니다"
    } ]
  }, {
    "tStartMs": 1131740,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "2023년 10월에 금방 사라졌고"
    } ]
  }, {
    "tStartMs": 1133620,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "롯데시네마도 롯시 클럽"
    } ]
  }, {
    "tStartMs": 1134990,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "뭐 이런 게 있었죠"
    } ]
  }, {
    "tStartMs": 1135830,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "하지만 잘 정착이 안 됐죠"
    } ]
  }, {
    "tStartMs": 1138180,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "이 정착이 어떤 모습으로 될지"
    } ]
  }, {
    "tStartMs": 1140700,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "제가 다른 나라의 사례를 들고 왔는데"
    } ]
  }, {
    "tStartMs": 1143030,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "영화관 구독제가 가장 활성화된 나라는 프랑스라고 합니다"
    } ]
  }, {
    "tStartMs": 1147510,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "열심히 조사해 갖고 왔는데"
    } ]
  }, {
    "tStartMs": 1149080,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "영화 무제한 관람 카드가 있어요"
    } ]
  }, {
    "tStartMs": 1151360,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "영화 극장 체인마다 있습니다"
    } ]
  }, {
    "tStartMs": 1153060,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "이게 2000년대부터 등장한 서비스라고 하는데"
    } ]
  }, {
    "tStartMs": 1155650,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "무제한 구독 서비스예요"
    } ]
  }, {
    "tStartMs": 1157260,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "대형 영화 체인 대부분이 있고"
    } ]
  }, {
    "tStartMs": 1158710,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "가격은 한 달 가격은"
    } ]
  }, {
    "tStartMs": 1160300,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "일반 관람료의 1.5배 수준입니다"
    } ]
  }, {
    "tStartMs": 1162980,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "구체적으로 얼마냐?"
    } ]
  }, {
    "tStartMs": 1164740,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "프랑스 최대 영화 체인이"
    } ]
  }, {
    "tStartMs": 1166360,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "위에 있는 뭐라고 읽죠?"
    } ]
  }, {
    "tStartMs": 1167660,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "제가 옛날에 불어반이었는데"
    } ]
  }, {
    "tStartMs": 1169090,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "모르겠다"
    } ]
  }, {
    "tStartMs": 1170140,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "빠데랑 빠세 빠세? 시네빠스?"
    } ]
  }, {
    "tStartMs": 1172560,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "하여튼 뭐 이게 있는데"
    } ]
  }, {
    "tStartMs": 1173640,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "프랑스 최대 영화 체인의 무제한 패스는"
    } ]
  }, {
    "tStartMs": 1176240,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "한 달에 3만 천 원"
    } ]
  }, {
    "tStartMs": 1178140,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "26세 미만"
    } ]
  }, {
    "tStartMs": 1179230,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "일반은 3만 9천 원"
    } ]
  }, {
    "tStartMs": 1181380,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "4D까지 다 포함하는 골드옵션으로 간다?"
    } ]
  }, {
    "tStartMs": 1183920,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "그러면 6만 7천 원"
    } ]
  }, {
    "tStartMs": 1185050,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "아이맥스, 돌비시네마, 공연중계"
    } ]
  }, {
    "tStartMs": 1186740,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "전부 다 포함한 가격이라고 합니다"
    } ]
  }, {
    "tStartMs": 1188160,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "그러니까 30,000원에서 39,000원"
    } ]
  }, {
    "tStartMs": 1190930,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "UGC 영화체인 역시 리미트가 있는데 무제한"
    } ]
  }, {
    "tStartMs": 1193570,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "26세 미만 33,000원, 기본은 40,000원"
    } ]
  }, {
    "tStartMs": 1196800,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "그러니까 33,000원에서 40,000원 사이"
    } ]
  }, {
    "tStartMs": 1198540,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "어디라는 거죠"
    } ]
  }, {
    "tStartMs": 1199580,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "물론 프랑스가 영화 한 편이 얼마길래 저 가격인가요?"
    } ]
  }, {
    "tStartMs": 1202440,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "프랑스에서 영화 한 편 보는 비용은"
    } ]
  }, {
    "tStartMs": 1204110,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "13에서 16유로 정도 된다고 합니다"
    } ]
  }, {
    "tStartMs": 1206520,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "한 23,000원에서 25,000원"
    } ]
  }, {
    "tStartMs": 1208760,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "우리나라보다 물가가 비싸죠?"
    } ]
  }, {
    "tStartMs": 1210140,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "우리나라보다 국민소득이 높은 나라니까"
    } ]
  }, {
    "tStartMs": 1212290,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "그러면 아까 전에 3만 원에서 4만 원 사이다"
    } ]
  }, {
    "tStartMs": 1215950,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "그러면 두 편이 좀 안 되는 비용입니다"
    } ]
  }, {
    "tStartMs": 1218780,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "3만 3천"
    } ]
  }, {
    "tStartMs": 1219630,
    "dDurationMs": 590,
    "segs": [ {
      "utf8": "3만 5천"
    } ]
  }, {
    "tStartMs": 1220220,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "4만 원 정도니까"
    } ]
  }, {
    "tStartMs": 1221480,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "영화 두 편이 안 되는 비용이"
    } ]
  }, {
    "tStartMs": 1223250,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "한 달 구독료"
    } ]
  }, {
    "tStartMs": 1224900,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "그러니까 두 편 이상 보면 남아"
    } ]
  }, {
    "tStartMs": 1226910,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "한 편 보면 안 돼"
    } ]
  }, {
    "tStartMs": 1228320,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "딱 그 정도로 해놨어요"
    } ]
  }, {
    "tStartMs": 1229820,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "그럼 한 달 무제한입니다"
    } ]
  }, {
    "tStartMs": 1231650,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "우리로 치면"
    } ]
  }, {
    "tStartMs": 1232770,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "우리나라 영화가 1만 4천 원, 1만 5천 원 이 정도 하죠"
    } ]
  }, {
    "tStartMs": 1236670,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "주말을 뭐 그런 거 빼고 보통이라고 치면"
    } ]
  }, {
    "tStartMs": 1239070,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "그러면 두 편을 남게 만들려면"
    } ]
  }, {
    "tStartMs": 1241660,
    "dDurationMs": 530,
    "segs": [ {
      "utf8": "25,000원"
    } ]
  }, {
    "tStartMs": 1242190,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "14,000원 기준으로는 한 22,000원"
    } ]
  }, {
    "tStartMs": 1245540,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "청소년은 아마 22,000원일 것 같고"
    } ]
  }, {
    "tStartMs": 1248130,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "어른은 25,000원"
    } ]
  }, {
    "tStartMs": 1249470,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "이 정도로 무제한 패스가 되면"
    } ]
  }, {
    "tStartMs": 1252220,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "프랑스급인 거죠"
    } ]
  }, {
    "tStartMs": 1253660,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "물론 이 정도 비용으로 나올지 모르겠어요"
    } ]
  }, {
    "tStartMs": 1255780,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "제 생각에는 아마 조금 더 높게 나오지 않을까 생각하는데"
    } ]
  }, {
    "tStartMs": 1258630,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "왜냐면 우리나라 극장들 어려우니까 그렇지 않을까 생각하는데"
    } ]
  }, {
    "tStartMs": 1260630,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "하여튼 프랑스에서는 그 정도입니다"
    } ]
  }, {
    "tStartMs": 1262350,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "두 편 보면 남는 수준"
    } ]
  }, {
    "tStartMs": 1263690,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "참고로 프랑스에서는 저 시네 패스가 있으면"
    } ]
  }, {
    "tStartMs": 1266910,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "추가 약정 없이 무제한 영화를 볼 수 있습니다"
    } ]
  }, {
    "tStartMs": 1269940,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "이 아래 있는 거는"
    } ]
  }, {
    "tStartMs": 1270960,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "저 시네 패스를 파는"
    } ]
  }, {
    "tStartMs": 1272380,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "거기서 프랑스 말로 된 걸 한글로 제가 그대로 갖고 온 건데"
    } ]
  }, {
    "tStartMs": 1275000,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "73개 영화관과 제휴된 50개 이상의 영화관"
    } ]
  }, {
    "tStartMs": 1277950,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "123개 이상의 영화관에서"
    } ]
  }, {
    "tStartMs": 1279810,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "연간 1,000편 이상의 영화를 볼 수 있습니다"
    } ]
  }, {
    "tStartMs": 1282780,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "이건 뭐 물리적으로 불가능하죠"
    } ]
  }, {
    "tStartMs": 1284430,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "365일 하루에 3개씩 보라는 소리예요"
    } ]
  }, {
    "tStartMs": 1286000,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "그러니까 무제한 볼 수 있습니다란 말이에요"
    } ]
  }, {
    "tStartMs": 1287920,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "무제한 볼 수 있습니다"
    } ]
  }, {
    "tStartMs": 1288910,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "그리고 시네 패스 듀오가 있어요"
    } ]
  }, {
    "tStartMs": 1290520,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "듀오를 하면 가격을 깎아 줍니다"
    } ]
  }, {
    "tStartMs": 1292230,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "연인하고 같이 저 패스를 끊으면"
    } ]
  }, {
    "tStartMs": 1294750,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "가격이 할인돼요"
    } ]
  }, {
    "tStartMs": 1295460,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "꽤 많이 할인돼요"
    } ]
  }, {
    "tStartMs": 1296780,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "물론 제약도 있어요"
    } ]
  }, {
    "tStartMs": 1298080,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "어떤 제약이 있냐?"
    } ]
  }, {
    "tStartMs": 1299470,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "제도를 좋게 만들어도"
    } ]
  }, {
    "tStartMs": 1300680,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "꼼수를 쓰는 사람도 있기 때문에"
    } ]
  }, {
    "tStartMs": 1302320,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "상영 시간 중복 예약 불가합니다"
    } ]
  }, {
    "tStartMs": 1305230,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "공짜니까 마구 예약해야지"
    } ]
  }, {
    "tStartMs": 1307100,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "상영 시간 때 여기도 예약하고 저기도 예약하고"
    } ]
  }, {
    "tStartMs": 1309210,
    "dDurationMs": 540,
    "segs": [ {
      "utf8": "저기도 예약하고"
    } ]
  }, {
    "tStartMs": 1309750,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "동일한 시간대에"
    } ]
  }, {
    "tStartMs": 1310730,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "2시에서 4시 영화 본다 예약하면서"
    } ]
  }, {
    "tStartMs": 1312490,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "여기도 2시 여기도 3시"
    } ]
  }, {
    "tStartMs": 1313580,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "이런 거 안 돼요"
    } ]
  }, {
    "tStartMs": 1314840,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "여러 명이 하나로 돌려 써야지 무제한이니까"
    } ]
  }, {
    "tStartMs": 1317500,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "실물 카드에 얼굴 박혀 있습니다"
    } ]
  }, {
    "tStartMs": 1319660,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "현장 대조합니다"
    } ]
  }, {
    "tStartMs": 1321590,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "아닌데?"
    } ]
  }, {
    "tStartMs": 1322210,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "살을 뺐어요"
    } ]
  }, {
    "tStartMs": 1323020,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "살을 뺐어요"
    } ]
  }, {
    "tStartMs": 1323870,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "아 위고비 맞았어"
    } ]
  }, {
    "tStartMs": 1325020,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "아 위고비 맞았어"
    } ]
  }, {
    "tStartMs": 1327480,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "그래서 신분증 제시 요구가 가능하다고 합니다"
    } ]
  }, {
    "tStartMs": 1330210,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "신분증 제시를"
    } ]
  }, {
    "tStartMs": 1331680,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "이렇게 하면 안 돼요"
    } ]
  }, {
    "tStartMs": 1332740,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "여러 명이 돌려 쓰기 불가하고요"
    } ]
  }, {
    "tStartMs": 1334170,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "걸리면 즉시 정지됩니다"
    } ]
  }, {
    "tStartMs": 1336250,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "그리고 노쇼 페널티가 엄격해요"
    } ]
  }, {
    "tStartMs": 1338120,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "노쇼가 문제가 돼"
    } ]
  }, {
    "tStartMs": 1339970,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "공짜니까 마구 예약해"
    } ]
  }, {
    "tStartMs": 1340950,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "그리고 안 가"
    } ]
  }, {
    "tStartMs": 1342090,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "노쇼가 2회"
    } ]
  }, {
    "tStartMs": 1343300,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "2회 되면 페널티가 생기고요"
    } ]
  }, {
    "tStartMs": 1344980,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "3회 반복되면 계정이 즉시 정지됩니다"
    } ]
  }, {
    "tStartMs": 1347370,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "노쇼 페널티가 되게 세요"
    } ]
  }, {
    "tStartMs": 1348900,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "당연히 그래야 영화관들이"
    } ]
  }, {
    "tStartMs": 1350360,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "손해를 안 볼 테니까"
    } ]
  }, {
    "tStartMs": 1351280,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "이런 제약이 당연히 있고요"
    } ]
  }, {
    "tStartMs": 1352700,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "그리고 제가 물어보니까"
    } ]
  }, {
    "tStartMs": 1353810,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "프랑스에서는 저 시네 패스를 단순히 할인권으로 생각을 안 한대"
    } ]
  }, {
    "tStartMs": 1358450,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "문화적 자부심을 얘기하더라고요"
    } ]
  }, {
    "tStartMs": 1360960,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "그러니까 이게 나 무제한 카드 보유자"
    } ]
  }, {
    "tStartMs": 1363250,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "이게 약간 있대요"
    } ]
  }, {
    "tStartMs": 1363870,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "이게 무슨 소리인지 모르겠는데"
    } ]
  }, {
    "tStartMs": 1366140,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "나는 영화를 무제한 카드 보유한 사람이야 라는 이"
    } ]
  }, {
    "tStartMs": 1368980,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "그 영화를 선호하는"
    } ]
  }, {
    "tStartMs": 1370850,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "문화를 사랑하는 사람이야"
    } ]
  }, {
    "tStartMs": 1372420,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "나는 이렇게 문화를 즐기는 사람이야"
    } ]
  }, {
    "tStartMs": 1374490,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "라는 이 느낌이 약간 있다 그러고"
    } ]
  }, {
    "tStartMs": 1376310,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "문화생활을 즐기는 사람이야"
    } ]
  }, {
    "tStartMs": 1377660,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "제 생각에는 약간 연회비 높은 신용카드 느낌 약간 있는 것 같은데"
    } ]
  }, {
    "tStartMs": 1380740,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "그런 사람이라는 그 의미"
    } ]
  }, {
    "tStartMs": 1382840,
    "dDurationMs": 520,
    "segs": [ {
      "utf8": "그리고"
    } ]
  }, {
    "tStartMs": 1383360,
    "dDurationMs": 650,
    "segs": [ {
      "utf8": "어? 야 영화 보러 가자"
    } ]
  }, {
    "tStartMs": 1384010,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "어? 너 무제한 카드 없어?"
    } ]
  }, {
    "tStartMs": 1385910,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "아..."
    } ]
  }, {
    "tStartMs": 1387460,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "좀 문화를 좀 싫어하나 보구나"
    } ]
  }, {
    "tStartMs": 1390160,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "뭐 이런 느낌"
    } ]
  }, {
    "tStartMs": 1391030,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "아 자기 카드 없어?"
    } ]
  }, {
    "tStartMs": 1392960,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "약간 이런 거 그게 좀 있나 봐요"
    } ]
  }, {
    "tStartMs": 1394710,
    "dDurationMs": 440,
    "segs": [ {
      "utf8": "좀 있나 봐"
    } ]
  }, {
    "tStartMs": 1395150,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "프랑스에서는 이제 그런 걸 좋아하니까"
    } ]
  }, {
    "tStartMs": 1396750,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "그래서 시간이 비면"
    } ]
  }, {
    "tStartMs": 1398440,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "카페에 들어가듯이 영화관에 들어가서 휴식하는 게"
    } ]
  }, {
    "tStartMs": 1400690,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "굉장히 자연스럽다"
    } ]
  }, {
    "tStartMs": 1402560,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "프랑스에서 길거리에 뭐 작은 영화관들이 많이 있다고 합니다"
    } ]
  }, {
    "tStartMs": 1405090,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "저도 정확히는 모르겠는데"
    } ]
  }, {
    "tStartMs": 1406340,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "그래서 카페를 안 가고"
    } ]
  }, {
    "tStartMs": 1407260,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "그냥 지나가다가 영화 하네? 영화관 들어가서 이걸 마시면서"
    } ]
  }, {
    "tStartMs": 1410950,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "휴식하는 경우가"
    } ]
  }, {
    "tStartMs": 1411940,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "그렇게 막 적은 경우가 아니라고 하니까"
    } ]
  }, {
    "tStartMs": 1413790,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "그렇게 좀 잘 활용하고 있다고 하고요"
    } ]
  }, {
    "tStartMs": 1416510,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "물론 이 구독제를 도입하면"
    } ]
  }, {
    "tStartMs": 1418030,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "영화 수익은 어떻게 나누냐"
    } ]
  }, {
    "tStartMs": 1418960,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "이런 걱정은 할 필요가 없죠 사실"
    } ]
  }, {
    "tStartMs": 1420940,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "뭐 그렇게 치면 넷플릭스는 어떻게 나누고"
    } ]
  }, {
    "tStartMs": 1422480,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "유튜브는 수익을 어떻게 나눠"
    } ]
  }, {
    "tStartMs": 1423830,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "그건 다 구독자가 보면은"
    } ]
  }, {
    "tStartMs": 1425740,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "거기에 따른 비율에 따라서 나누던지 하겠죠"
    } ]
  }, {
    "tStartMs": 1428570,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "그거는 뭐 걱정할 필요가 없는 것 같고요"
    } ]
  }, {
    "tStartMs": 1430340,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "프랑스 말고 할리우드 미국에도 있습니다"
    } ]
  }, {
    "tStartMs": 1433220,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "영화 구독제는 할리우드 고장 미국에서도 인기가 많다고 그러는데"
    } ]
  }, {
    "tStartMs": 1436530,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "AMC A 리스트 회원이라는 게 있다고 합니다"
    } ]
  }, {
    "tStartMs": 1439650,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "AMC는 세계 최대 영화 체인입니다"
    } ]
  }, {
    "tStartMs": 1441690,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "미국 최대 영화 체인인데"
    } ]
  }, {
    "tStartMs": 1443230,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "월 회비가 20에서 28달러"
    } ]
  }, {
    "tStartMs": 1445540,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "A 클래스 회원"
    } ]
  }, {
    "tStartMs": 1446940,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "한마디로 퍼스트"
    } ]
  }, {
    "tStartMs": 1448300,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "비즈니스 말고"
    } ]
  }, {
    "tStartMs": 1449440,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "야 너는 영화 일반에서 보냐?"
    } ]
  }, {
    "tStartMs": 1451740,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "아 이코노미에서 봐?"
    } ]
  }, {
    "tStartMs": 1453010,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "나는 퍼스트에서 보는데"
    } ]
  }, {
    "tStartMs": 1454070,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "약간 이 느낌이 있나 봐요"
    } ]
  }, {
    "tStartMs": 1455000,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "A 리스트"
    } ]
  }, {
    "tStartMs": 1456120,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "A 클래스 회원에 가입할 수 있다고 하는데"
    } ]
  }, {
    "tStartMs": 1458600,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "이 회원의 조건은"
    } ]
  }, {
    "tStartMs": 1460020,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "월 4만 원 정도면"
    } ]
  }, {
    "tStartMs": 1461690,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "주에 4편 영화를 볼 수 있다고 합니다"
    } ]
  }, {
    "tStartMs": 1464110,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "월 4만 원은 미국의 국민소득을 생각하세요"
    } ]
  }, {
    "tStartMs": 1466570,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "8만 5천 달러가 넘는 나라입니다"
    } ]
  }, {
    "tStartMs": 1468240,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "우리나라의 2배가 넘는 나라에요"
    } ]
  }, {
    "tStartMs": 1469540,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "2배가 넘는 나라"
    } ]
  }, {
    "tStartMs": 1470710,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "주 4편의 영화를 볼 수 있다"
    } ]
  }, {
    "tStartMs": 1472180,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "여기는 주간으로 리셋한대"
    } ]
  }, {
    "tStartMs": 1474290,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "매주 금요일"
    } ]
  }, {
    "tStartMs": 1475410,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "일주일에 4편"
    } ]
  }, {
    "tStartMs": 1476130,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "일주일에 4편이면 됐지"
    } ]
  }, {
    "tStartMs": 1477630,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "일주일에 4편 이상을 보면"
    } ]
  }, {
    "tStartMs": 1479360,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "아주 영화광인거죠"
    } ]
  }, {
    "tStartMs": 1480610,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "한달에 16편을 보는 분은 많지 않으니까"
    } ]
  }, {
    "tStartMs": 1483800,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "일주일에 4편까지"
    } ]
  }, {
    "tStartMs": 1485070,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "한달에 거의 16편이 월 4만 원 됐다 그러고"
    } ]
  }, {
    "tStartMs": 1488500,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "그리고 저 패스를 끊으면"
    } ]
  }, {
    "tStartMs": 1490360,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "저 A 클래스 A 리스트에 올라가면"
    } ]
  }, {
    "tStartMs": 1493060,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "아무리 비싼 프리미어엄 형식의 영화도 추가 요금이 없다고 합니다"
    } ]
  }, {
    "tStartMs": 1495880,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "3D, 4D, 아이맥스 뭐 다 있지만"
    } ]
  }, {
    "tStartMs": 1498620,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "요즘 돌비는 다 있지만"
    } ]
  }, {
    "tStartMs": 1499630,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "뭐 어떤 상영 방식이라도"
    } ]
  }, {
    "tStartMs": 1501660,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "무조건 추가 요금이 없다"
    } ]
  }, {
    "tStartMs": 1503260,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "그리고 중요하죠 팝콘, 탄산음료 사이즈 무료 업그레이드"
    } ]
  }, {
    "tStartMs": 1506500,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "중요합니다"
    } ]
  }, {
    "tStartMs": 1507110,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "팝콘, 탄산음료"
    } ]
  }, {
    "tStartMs": 1508610,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "어떤 팝콘을 고를 수 있는지도 굉장히 중요하기 때문에"
    } ]
  }, {
    "tStartMs": 1510700,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "그리고 제일 중요한 거"
    } ]
  }, {
    "tStartMs": 1512230,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "전용 입장로를 통한 우선 입장 서비스가 제공된다"
    } ]
  }, {
    "tStartMs": 1515580,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "극장마다 다르다고 하는데"
    } ]
  }, {
    "tStartMs": 1516750,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "어? A 클래스십니까?"
    } ]
  }, {
    "tStartMs": 1518610,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "어 이리 오시죠 Sir?"
    } ]
  }, {
    "tStartMs": 1521120,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "어? A 클래스 없으세요?"
    } ]
  }, {
    "tStartMs": 1521970,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "줄 서세요"
    } ]
  }, {
    "tStartMs": 1522590,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "이렇게 되는 거죠"
    } ]
  }, {
    "tStartMs": 1523390,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "허허허 그러면은 이런 사람입니다"
    } ]
  }, {
    "tStartMs": 1526340,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "이렇게 앞으로"
    } ]
  }, {
    "tStartMs": 1527420,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "우선 입장"
    } ]
  }, {
    "tStartMs": 1528200,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "한 10분이나 비행기도 먼저 타잖아요"
    } ]
  }, {
    "tStartMs": 1530330,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "비행기도 왜 비즈니스나 퍼스트 되면은 먼저 타잖아요"
    } ]
  }, {
    "tStartMs": 1533330,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "앞에 줄도 따로 있고"
    } ]
  }, {
    "tStartMs": 1534750,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "자 먼저 퍼스트 클래스 승객 여러분 들어오세요 그러면"
    } ]
  }, {
    "tStartMs": 1537460,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "먼저 가잖아요"
    } ]
  }, {
    "tStartMs": 1538100,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "이것도 영화도 잠깐만요"
    } ]
  }, {
    "tStartMs": 1539510,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "A 클래스 먼저 가십시오"
    } ]
  }, {
    "tStartMs": 1541090,
    "dDurationMs": 410,
    "segs": [ {
      "utf8": "이렇게 하면"
    } ]
  }, {
    "tStartMs": 1541500,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "이렇게 가서 먼저 편안하게 자리 잡고"
    } ]
  }, {
    "tStartMs": 1544420,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "앉을 수 있는 이런 서비스가 있다고 그러고요"
    } ]
  }, {
    "tStartMs": 1545960,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "그리고 제가 가장 맘에 드는 서비스는"
    } ]
  }, {
    "tStartMs": 1548220,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "물론 극장마다 다르다고도 하는데"
    } ]
  }, {
    "tStartMs": 1550010,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "매점 팝콘 구매 시 VIP 줄로 먼저 받을 수 있다"
    } ]
  }, {
    "tStartMs": 1553290,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "어우 개쩐다"
    } ]
  }, {
    "tStartMs": 1554660,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "이거 요즘 물론 요즘엔 저 키오스크여서 많이 줄이 없어졌는데"
    } ]
  }, {
    "tStartMs": 1557820,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "옛날에 이거 오래 기다렸거든"
    } ]
  }, {
    "tStartMs": 1559150,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "오 이제 매점 팝콘 할 때 고른 다음에"
    } ]
  }, {
    "tStartMs": 1562500,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "저 이런 사람이에요"
    } ]
  }, {
    "tStartMs": 1563500,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "A 클래스"
    } ]
  }, {
    "tStartMs": 1564240,
    "dDurationMs": 270,
    "segs": [ {
      "utf8": "주세요"
    } ]
  }, {
    "tStartMs": 1564510,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "그럼 이제 팝콘도 먼저 VIP 줄로 촤악"
    } ]
  }, {
    "tStartMs": 1566910,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "먼저 준다는 거죠"
    } ]
  }, {
    "tStartMs": 1568190,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "역시 자본주의 나라 미국답다"
    } ]
  }, {
    "tStartMs": 1569770,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "우리나라에 이런 거 문제가 있을 수 있는, 뭐 어때?"
    } ]
  }, {
    "tStartMs": 1572380,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "A 클래스라는데"
    } ]
  }, {
    "tStartMs": 1573180,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "영화를 가장 즐기는 A 클래스라고 하니까"
    } ]
  }, {
    "tStartMs": 1574760,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "먼저 VIP 줄로 딱 가서"
    } ]
  }, {
    "tStartMs": 1577520,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "난 저는 팝콘 먼저 받는 남자예요"
    } ]
  }, {
    "tStartMs": 1579570,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "자기야 무슨 팝콘 먹을래? 골라"
    } ]
  }, {
    "tStartMs": 1582260,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "바로 나와"
    } ]
  }, {
    "tStartMs": 1583930,
    "dDurationMs": 670,
    "segs": [ {
      "utf8": "좋습니다"
    } ]
  }, {
    "tStartMs": 1584600,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "원래 이것도 블랙카드"
    } ]
  }, {
    "tStartMs": 1586720,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "무슨 카드도 내미는 맛이 있으니까"
    } ]
  }, {
    "tStartMs": 1588840,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "A 클래스도 이렇게 내미는 맛이 있는 거 아니겠습니까?"
    } ]
  }, {
    "tStartMs": 1590920,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "자동차도 하차감인데"
    } ]
  }, {
    "tStartMs": 1592410,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "내미는 맛으로 하면 되지 않을까 생각하고요"
    } ]
  }, {
    "tStartMs": 1595580,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "그래서 저런 맛이 있기 때문에"
    } ]
  }, {
    "tStartMs": 1597430,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "놀랍게도 회원이 거의 100만 명에 달한다고 합니다"
    } ]
  }, {
    "tStartMs": 1601150,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "회원들은 이 영화 구독 서비스 A 리스트 서비스를"
    } ]
  }, {
    "tStartMs": 1604730,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "마치 항공사 최상위 등급 소속인 것처럼 자랑한다"
    } ]
  }, {
    "tStartMs": 1607900,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "그래서 앞으로 여러분들도"
    } ]
  }, {
    "tStartMs": 1609910,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "슈카월드 A 클래스 회원으로"
    } ]
  }, {
    "tStartMs": 1611940,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "뭘 좀 만들어야 되나"
    } ]
  }, {
    "tStartMs": 1613960,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "가입 버튼인가요?"
    } ]
  }, {
    "tStartMs": 1614700,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "그걸 좀 연 다음에"
    } ]
  }, {
    "tStartMs": 1615780,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "슈카월드 A 클래스 회원 같은 경우에는"
    } ]
  }, {
    "tStartMs": 1617240,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "카드 같은 걸 이렇게"
    } ]
  }, {
    "tStartMs": 1618880,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "내밀면은 뭐 좀 되는"
    } ]
  }, {
    "tStartMs": 1620930,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "아 슈카월드 안 보세요?"
    } ]
  }, {
    "tStartMs": 1623260,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "하하하하 하면서"
    } ]
  }, {
    "tStartMs": 1624120,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "이렇게 쓰윽"
    } ]
  }, {
    "tStartMs": 1625260,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "아 보신다고요?"
    } ]
  }, {
    "tStartMs": 1626060,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "아 저는 A 클래스입니다"
    } ]
  }, {
    "tStartMs": 1628190,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "괜찮아요x2"
    } ]
  }, {
    "tStartMs": 1629160,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "아 사진 안 찍으셔도 돼요"
    } ]
  }, {
    "tStartMs": 1630690,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "어떻게 따셨습니까?"
    } ]
  }, {
    "tStartMs": 1632100,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "아 이런 사람이에요"
    } ]
  }, {
    "tStartMs": 1633550,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "하고 딱 보여드릴 수 있는 거죠"
    } ]
  }, {
    "tStartMs": 1635450,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "그래서 이제 만들 수는 있는데"
    } ]
  }, {
    "tStartMs": 1637600,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "어디에 내밀게 해야 되는지 잘 모르겠습니다"
    } ]
  }, {
    "tStartMs": 1639210,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "아 그 아이디어만 있으면 기가 막힌데"
    } ]
  }, {
    "tStartMs": 1641310,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "아 이렇게 내미는"
    } ]
  }, {
    "tStartMs": 1642660,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "죄송합니다"
    } ]
  }, {
    "tStartMs": 1643780,
    "dDurationMs": 450,
    "segs": [ {
      "utf8": "죄송합니다"
    } ]
  }, {
    "tStartMs": 1644230,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "하여튼 그런 거를 한다는 거죠"
    } ]
  }, {
    "tStartMs": 1645530,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "영화관은 이렇게 한다는 거고"
    } ]
  }, {
    "tStartMs": 1647120,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "그래서 이 A 리스트를 딴 사람들이"
    } ]
  }, {
    "tStartMs": 1649410,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "SNS에 되게 자주 올리고"
    } ]
  }, {
    "tStartMs": 1650880,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "자기 정체성의 핵심처럼 얘기한다"
    } ]
  }, {
    "tStartMs": 1653850,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "나 비즈니스 탄 사람이야"
    } ]
  }, {
    "tStartMs": 1655850,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "많이 얘기하죠"
    } ]
  }, {
    "tStartMs": 1657470,
    "dDurationMs": 290,
    "segs": [ {
      "utf8": "그래요"
    } ]
  }, {
    "tStartMs": 1657760,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "나 OO차 모는 사람이야"
    } ]
  }, {
    "tStartMs": 1660020,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "나 챌린저야"
    } ]
  }, {
    "tStartMs": 1661630,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "나 마스터야"
    } ]
  }, {
    "tStartMs": 1662310,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "너 아직도 골드 실버냐?"
    } ]
  }, {
    "tStartMs": 1665080,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "뭐 이런 얘기한다는 거죠"
    } ]
  }, {
    "tStartMs": 1666410,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "자기 정체성의 핵심처럼"
    } ]
  }, {
    "tStartMs": 1668800,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "알 것 같아요x2"
    } ]
  }, {
    "tStartMs": 1670690,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "나아가 친구 가족들도 같이 끌어들이는 힘이 굉장히 강하다는 거고"
    } ]
  }, {
    "tStartMs": 1675070,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "영화 체인점들이 이걸 다 알기 때문에"
    } ]
  }, {
    "tStartMs": 1677570,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "저 A 리스트 회원들을"
    } ]
  }, {
    "tStartMs": 1678540,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "진짜 VIP 고객으로 엄청나게 잘해준다고 합니다"
    } ]
  }, {
    "tStartMs": 1681930,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "그럴 수밖에 없죠"
    } ]
  }, {
    "tStartMs": 1682640,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "이거 목숨 걸어야지"
    } ]
  }, {
    "tStartMs": 1684040,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "모든 서비스를 여기에 집중을 해야지"
    } ]
  }, {
    "tStartMs": 1686170,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "그들만을 위한 길, 그들만을 위한 화장실"
    } ]
  }, {
    "tStartMs": 1688870,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "놀랍게도 화장실 얘기도 있었습니다"
    } ]
  }, {
    "tStartMs": 1690310,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "깨끗한 화장실"
    } ]
  }, {
    "tStartMs": 1692090,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "그들만을 위한"
    } ]
  }, {
    "tStartMs": 1693200,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "심지어 빨간 로드를 쫙"
    } ]
  }, {
    "tStartMs": 1695550,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "영화 배우처럼 쫙 가는"
    } ]
  }, {
    "tStartMs": 1697330,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "아니면 영화 배우들이 와서 인사하거나 할 때"
    } ]
  }, {
    "tStartMs": 1699270,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "무조건 A 리스트 회원들을 먼저 넣어준다든지"
    } ]
  }, {
    "tStartMs": 1702780,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "무조건 해야죠, 무조건"
    } ]
  }, {
    "tStartMs": 1704220,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "이 고객들을 유치하게 해서"
    } ]
  }, {
    "tStartMs": 1705470,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "엄청난 노력을 기울이고 있다고 하고요"
    } ]
  }, {
    "tStartMs": 1707520,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "그래서 이 영화 구독 서비스가"
    } ]
  }, {
    "tStartMs": 1709490,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "굉장히 컬트적인 인기다"
    } ]
  }, {
    "tStartMs": 1711450,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "광신적인 팬들을 만들어 냈다"
    } ]
  }, {
    "tStartMs": 1713160,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "월스트리트저널의 기사입니다"
    } ]
  }, {
    "tStartMs": 1714680,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "이 회원들은 서로 모여 갖고"
    } ]
  }, {
    "tStartMs": 1716540,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "서로 슈카월드 A 클래스세요?"
    } ]
  }, {
    "tStartMs": 1718850,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "아, 전 아직 B밖에 못 땄는데"
    } ]
  }, {
    "tStartMs": 1721310,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "좀 노력하세요"
    } ]
  }, {
    "tStartMs": 1722350,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "내민다는 거죠?"
    } ]
  }, {
    "tStartMs": 1723680,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "지난주 슈카월드 5번밖에 안 보셨어요?"
    } ]
  }, {
    "tStartMs": 1725920,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "아, A 클래스 타려면 한 10번은 봐야 되는데"
    } ]
  }, {
    "tStartMs": 1729850,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "삶이 좀, 현생이 좀 어려워서"
    } ]
  }, {
    "tStartMs": 1732160,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "그러지 마시고 도전하세요"
    } ]
  }, {
    "tStartMs": 1733790,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "이렇게 얘기를 하면서"
    } ]
  }, {
    "tStartMs": 1734910,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "이 얘기를 멈추지를 않는다고 하고요"
    } ]
  }, {
    "tStartMs": 1737870,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "그래서 옆에서 다 그렇게 얘기하니까"
    } ]
  }, {
    "tStartMs": 1739670,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "너도 슈카월드 10번씩 봤니?"
    } ]
  }, {
    "tStartMs": 1741270,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "나도 10번씩 봤는데"
    } ]
  }, {
    "tStartMs": 1742860,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "그래서 어쩔 수 없이 가입한 사람들이 많다"
    } ]
  }, {
    "tStartMs": 1745890,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "그래서 자기들끼리는 피라미드 사기라고 농담한다고 합니다"
    } ]
  }, {
    "tStartMs": 1749200,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "나는 영화 별로 안 좋아하고 볼 영화 그렇게 많이 안 보는데"
    } ]
  }, {
    "tStartMs": 1752350,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "주위 사람들이 다 슈카월드x3 하니까"
    } ]
  }, {
    "tStartMs": 1754940,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "왠지 안 보면 안 되는 것 같고"
    } ]
  }, {
    "tStartMs": 1756220,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "본부장님이 너 아직도 슈카월드 A 클래스 안 되냐?"
    } ]
  }, {
    "tStartMs": 1758570,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "하도 구박을 해서 어쩔 수 없이"
    } ]
  }, {
    "tStartMs": 1760490,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "마치 피라미드 사기처럼"
    } ]
  }, {
    "tStartMs": 1761980,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "슈카 저 놈 얼굴 보기 싫은데"
    } ]
  }, {
    "tStartMs": 1763610,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "어쩔 수 없이 가서 구독하게 되더라"
    } ]
  }, {
    "tStartMs": 1766070,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "그래서 더 잘 나간다고 합니다"
    } ]
  }, {
    "tStartMs": 1768790,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "그래서 이런 영화 구독 서비스가 있는데"
    } ]
  }, {
    "tStartMs": 1771650,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "저는 개인적으로"
    } ]
  }, {
    "tStartMs": 1773000,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "이거는 좀 나쁘지 않다라고 생각하는 게"
    } ]
  }, {
    "tStartMs": 1776260,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "이 비싼 영화표라고 사람들이 생각을 하면"
    } ]
  }, {
    "tStartMs": 1778550,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "꼭 볼 영화가 있어야 그래야만 가는데"
    } ]
  }, {
    "tStartMs": 1781650,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "구독 서비스 같은 거는 부담 없이"
    } ]
  }, {
    "tStartMs": 1783530,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "물론 가격이 문제겠죠"
    } ]
  }, {
    "tStartMs": 1784580,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "우리나라는 언제나 가격이"
    } ]
  }, {
    "tStartMs": 1785800,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "구독 서비스"
    } ]
  }, {
    "tStartMs": 1787470,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "7만 원? 그러면 누가 가겠어"
    } ]
  }, {
    "tStartMs": 1789310,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "7만 원이면 예를 들면 다섯 번 봐야 되잖아"
    } ]
  }, {
    "tStartMs": 1791820,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "여섯 번 봐야 한다고"
    } ]
  }, {
    "tStartMs": 1792560,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "이러면 진짜 영화를 너무 사랑하는 분 아니면 안 가니까"
    } ]
  }, {
    "tStartMs": 1795710,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "적당히 가격을 좀 낮춰서"
    } ]
  }, {
    "tStartMs": 1797430,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "프랑스나 미국처럼 한 두 편?"
    } ]
  }, {
    "tStartMs": 1799680,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "그렇게 나올 수 있을지 모르겠네요"
    } ]
  }, {
    "tStartMs": 1800590,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "두 편 정도에"
    } ]
  }, {
    "tStartMs": 1801650,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "한 달에 두 편이면 됐지 않나?"
    } ]
  }, {
    "tStartMs": 1803170,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "1인당 3만 원 가까운 돈을 받을 수 있다면"
    } ]
  }, {
    "tStartMs": 1805970,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "2만 8천 원 구독으로"
    } ]
  }, {
    "tStartMs": 1807930,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "그러면 나쁘지 않은 수익 모델이 될 것 같은데"
    } ]
  }, {
    "tStartMs": 1810790,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "그러면 굉장히 부담 없이"
    } ]
  }, {
    "tStartMs": 1812180,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "마치 커피숍 가듯이"
    } ]
  }, {
    "tStartMs": 1813700,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "가다가 지나가다가 영화 하나 볼까?"
    } ]
  }, {
    "tStartMs": 1815030,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "쓱 들어갈 수 있잖아요"
    } ]
  }, {
    "tStartMs": 1816160,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "그런 곳이 되지 않을까?"
    } ]
  }, {
    "tStartMs": 1817350,
    "dDurationMs": 630,
    "segs": [ {
      "utf8": "그렇게 들어가면"
    } ]
  }, {
    "tStartMs": 1817980,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "또 사실 팝콘 팔아서 돈 많이 버는 건데"
    } ]
  }, {
    "tStartMs": 1820330,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "팝콘 팔고 음료 팔면서"
    } ]
  }, {
    "tStartMs": 1822210,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "매출을 올릴 수 있지 않을까 생각을 하고요"
    } ]
  }, {
    "tStartMs": 1824600,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "그리고 추가적으로 몇 개 말씀드리면"
    } ]
  }, {
    "tStartMs": 1826710,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "정부는 얼마 전에 문화가 있는 날의 확대 지정도 예고했습니다"
    } ]
  }, {
    "tStartMs": 1830410,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "문화가 있는 날은 뭐냐?"
    } ]
  }, {
    "tStartMs": 1831670,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "매달 마지막 수요일은 문화가 있는 날로 지정을 해요"
    } ]
  }, {
    "tStartMs": 1835000,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "그러면 여기서 궁궐 입장이 무료라든지"
    } ]
  }, {
    "tStartMs": 1836910,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "영화관을 할인해준다든지"
    } ]
  }, {
    "tStartMs": 1838170,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "공연 무료, 스포츠 할인"
    } ]
  }, {
    "tStartMs": 1839740,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "이런 걸 많이 합니다"
    } ]
  }, {
    "tStartMs": 1840670,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "매달 마지막 수요일"
    } ]
  }, {
    "tStartMs": 1841590,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "근데 이걸 한 주에 한 번 하겠다"
    } ]
  }, {
    "tStartMs": 1843970,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "영화관 같은 게 위기니까"
    } ]
  }, {
    "tStartMs": 1845570,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "한 주에 한 번 사람들이 더 많이 영화를 볼 수 있게"
    } ]
  }, {
    "tStartMs": 1848300,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "문화가 있는 날로 만들겠다"
    } ]
  }, {
    "tStartMs": 1850270,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "전국 문화시설의 문턱을 낮추겠다"
    } ]
  }, {
    "tStartMs": 1852570,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "공연, 스포츠, 문화재 관람료 할인"
    } ]
  }, {
    "tStartMs": 1854550,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "영화는 보통 문화가 있는 날에"
    } ]
  }, {
    "tStartMs": 1855940,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "15,000원이 아니라 7천 원으로 할인합니다"
    } ]
  }, {
    "tStartMs": 1858500,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "한 달에 한 번이었는데"
    } ]
  }, {
    "tStartMs": 1859560,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "매주 1회 수요일마다"
    } ]
  }, {
    "tStartMs": 1860680,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "7,000원으로 만들겠다는 말과 비슷하죠"
    } ]
  }, {
    "tStartMs": 1862810,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "그걸 영화인들이 좋아하냐?"
    } ]
  }, {
    "tStartMs": 1864880,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "뉴스에 따르면"
    } ]
  }, {
    "tStartMs": 1866110,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "영화관과 영화 배급사가 난색을 표하고 있다"
    } ]
  }, {
    "tStartMs": 1869310,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "한 달에 한 번 정도면"
    } ]
  }, {
    "tStartMs": 1870750,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "절반 가격으로 할 수 있는데"
    } ]
  }, {
    "tStartMs": 1872320,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "매주 수요일마다 그렇다고 하면"
    } ]
  }, {
    "tStartMs": 1874100,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "왜냐면 이 할인은 전부 다 민간이"
    } ]
  }, {
    "tStartMs": 1875630,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "당연히 민간이 할인 부담을 져야 됩니다"
    } ]
  }, {
    "tStartMs": 1877960,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "매출에도 영향이 있을 것 같고"
    } ]
  }, {
    "tStartMs": 1879020,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "그리고 결정적으로 문화가 있는 날을 매주하면"
    } ]
  }, {
    "tStartMs": 1881650,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "티켓값이 비싼 주말에"
    } ]
  }, {
    "tStartMs": 1883420,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "정가를 누가 보겠냐?"
    } ]
  }, {
    "tStartMs": 1885310,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "50% 할인을 기다리지"
    } ]
  }, {
    "tStartMs": 1886620,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "뭐 이런 걱정을 하고 있다고 하고요"
    } ]
  }, {
    "tStartMs": 1889790,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "그래도 하는 게 낫지 않을까라고 개인적으로 생각하는데"
    } ]
  }, {
    "tStartMs": 1892430,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "또 영화계에서는 이런 걱정을 한대요"
    } ]
  }, {
    "tStartMs": 1894330,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "영화의 문제가 가격에만 초점이 가는 게 부담스럽다"
    } ]
  }, {
    "tStartMs": 1898910,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "왜냐하면 뭐 주토피아 2나 잘 된 영화들을 보면"
    } ]
  }, {
    "tStartMs": 1903030,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "보러 많이 오더라"
    } ]
  }, {
    "tStartMs": 1904070,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "그래서 꼭 티켓값이 비싸서 관객들이 극장에 오지 않는 거냐?"
    } ]
  }, {
    "tStartMs": 1907730,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "거긴 의문이 있다"
    } ]
  }, {
    "tStartMs": 1909220,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "요즘에 영화가 잘 못 만들어서"
    } ]
  }, {
    "tStartMs": 1911070,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "영화 재미없어서 안 오는 걸 수도 있어"
    } ]
  }, {
    "tStartMs": 1913290,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "아니면 OTT나 유튜브 많이 봐서 안 오는 걸 수도 있어"
    } ]
  }, {
    "tStartMs": 1915810,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "티켓값을 낮추더라도"
    } ]
  }, {
    "tStartMs": 1917460,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "영화관에 사람들이 많이 안 올 수 있어"
    } ]
  }, {
    "tStartMs": 1919280,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "그런 문제가 아니라 구조적인 문제니까"
    } ]
  }, {
    "tStartMs": 1921150,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "작품만 훌륭하면"
    } ]
  }, {
    "tStartMs": 1922550,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "현재 가격 수준으로도 얼마든지 관객은 올 수도 있고"
    } ]
  }, {
    "tStartMs": 1925440,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "그래서 굳이"
    } ]
  }, {
    "tStartMs": 1926560,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "영화에 초점을 맞춰야지"
    } ]
  }, {
    "tStartMs": 1928040,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "가격에만 초점을 맞추는 게 좀 부담스럽다"
    } ]
  }, {
    "tStartMs": 1931000,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "정부 정책도 가격 쪽"
    } ]
  }, {
    "tStartMs": 1932770,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "문화가 있는 날"
    } ]
  }, {
    "tStartMs": 1933900,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "그렇게 깎아준다거나"
    } ]
  }, {
    "tStartMs": 1935160,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "구독제 이렇게 해서 가격에만 초점을 가지 말고"
    } ]
  }, {
    "tStartMs": 1937610,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "좋은 영화가 나오도록"
    } ]
  }, {
    "tStartMs": 1939030,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "영화 제작 지원 쪽에 초점을 맞춰서 돈을 이쪽에 몰아 달라"
    } ]
  }, {
    "tStartMs": 1942570,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "이쪽에 좀 지원해달라"
    } ]
  }, {
    "tStartMs": 1943980,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "라는 입장들이 좀 있다는 거죠"
    } ]
  }, {
    "tStartMs": 1947790,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "그런 입장도 있긴 한데"
    } ]
  }, {
    "tStartMs": 1949070,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "사실 요즘 또 가격 얘기도 많이 하다 보니까"
    } ]
  }, {
    "tStartMs": 1951030,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "구독제 같은 경우는"
    } ]
  }, {
    "tStartMs": 1952580,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "개인적으로는 좋은 아이디어가 아닐까"
    } ]
  }, {
    "tStartMs": 1954260,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "극장에도 꾸준한 수익 모델이 창출이 되고"
    } ]
  }, {
    "tStartMs": 1957140,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "그래서 영화 문화 애호가들을"
    } ]
  }, {
    "tStartMs": 1958800,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "또 팬덤화시킬 필요도 있잖아요"
    } ]
  }, {
    "tStartMs": 1960350,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "아까 얘기했지만"
    } ]
  }, {
    "tStartMs": 1961260,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "무슨 시네 패스라든지"
    } ]
  }, {
    "tStartMs": 1962340,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "아니면 무제한 패스 영화를 사랑하는 사람"
    } ]
  }, {
    "tStartMs": 1964240,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "이게 나를 어떻게 보면 팬덤화시키고"
    } ]
  }, {
    "tStartMs": 1966230,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "나를 상징하는 표상이 될 수 있으니까"
    } ]
  }, {
    "tStartMs": 1967900,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "슈카월드 10번 보는 사람"
    } ]
  }, {
    "tStartMs": 1969020,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "일주일에 저는 20번은 봅니다"
    } ]
  }, {
    "tStartMs": 1970540,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "뭐 이런 것들 그런 장치가 되면"
    } ]
  }, {
    "tStartMs": 1972670,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "아마 또 팬덤을 위한 서비스"
    } ]
  }, {
    "tStartMs": 1974540,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "팬덤을 위한 좌석"
    } ]
  }, {
    "tStartMs": 1975710,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "또 저런 패스를 위한 이벤트"
    } ]
  }, {
    "tStartMs": 1977230,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "이런 것들을 하면은"
    } ]
  }, {
    "tStartMs": 1978330,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "더 많은 수익 모델이 생겨서"
    } ]
  }, {
    "tStartMs": 1980040,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "저는 좋다고 개인적으로 생각하는데"
    } ]
  }, {
    "tStartMs": 1982020,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "생각하는데"
    } ]
  }, {
    "tStartMs": 1983490,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "일단 어떻게 나오는지"
    } ]
  }, {
    "tStartMs": 1985230,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "상반기 중에 구체적인 모습이 나온다고 하니까"
    } ]
  }, {
    "tStartMs": 1987570,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "한번 기대해 보도록 하겠습니다"
    } ]
  } ]
}

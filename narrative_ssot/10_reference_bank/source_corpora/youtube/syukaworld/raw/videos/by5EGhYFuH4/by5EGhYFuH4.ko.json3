{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 7780,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "첫 번째 주제는 미국 이란 전쟁"
    } ]
  }, {
    "tStartMs": 10260,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "도대체 언제 끝날 것 같냐"
    } ]
  }, {
    "tStartMs": 13360,
    "dDurationMs": 410,
    "segs": [ {
      "utf8": "일주일?"
    } ]
  }, {
    "tStartMs": 13770,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "4, 5일?"
    } ]
  }, {
    "tStartMs": 15350,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "하메네이이 죽었으니까 금방?"
    } ]
  }, {
    "tStartMs": 17180,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "이야.. 아니면"
    } ]
  }, {
    "tStartMs": 18640,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "아니면 우크라이나 전쟁처럼 3년, 4년?"
    } ]
  }, {
    "tStartMs": 21350,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "거기에 대한 내용을 한번 얘기해 보도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 23940,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "어느덧 미국, 이스라엘, 이란 전쟁이 일주일째로 접어들었어요"
    } ]
  }, {
    "tStartMs": 28740,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "2월 28일 날 첫 공습을 했는데"
    } ]
  }, {
    "tStartMs": 31070,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "전쟁 시작하자마자 이란의 최고 지도자가 사망을 했기 때문에"
    } ]
  }, {
    "tStartMs": 34590,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "전쟁이 금방 끝날 수도 있겠다라고 생각을 했어요"
    } ]
  }, {
    "tStartMs": 36940,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "근데 전쟁은 아직 끝나지 않고 있죠"
    } ]
  }, {
    "tStartMs": 39810,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "트럼프 대통령한테 물어봤습니다"
    } ]
  }, {
    "tStartMs": 41240,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "전쟁은 어떻게 하면 끝나는 건가요?"
    } ]
  }, {
    "tStartMs": 42840,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "그랬더니 이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 44370,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "저는 하메네이 같은 인물이 다시 등장하는 걸 원하지 않습니다"
    } ]
  }, {
    "tStartMs": 48040,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "저는 이란 지도자 선출 과정에 참여하고 싶습니다"
    } ]
  }, {
    "tStartMs": 51370,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "물론 이란인들이 선택할 수 있지만"
    } ]
  }, {
    "tStartMs": 53260,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "그 인물은 미국 입장에서"
    } ]
  }, {
    "tStartMs": 55010,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "합리적인 인물이 되어야 됩니다"
    } ]
  }, {
    "tStartMs": 56730,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "한마디로 정권을 교체해야 된단 말이죠"
    } ]
  }, {
    "tStartMs": 59440,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "정권을 교체해야 이 전쟁이 끝날 수 있습니다"
    } ]
  }, {
    "tStartMs": 62900,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "혹시 이란과 협상을 잘해서"
    } ]
  }, {
    "tStartMs": 64810,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "정권 교체까지 아니더라도 핵을 포기하고"
    } ]
  }, {
    "tStartMs": 67460,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "저 미국이 하라는 대로 하고"
    } ]
  }, {
    "tStartMs": 68670,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "무슨 사찰도 받고"
    } ]
  }, {
    "tStartMs": 69760,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "다 그러면 전쟁이 끝날 수 있습니까?"
    } ]
  }, {
    "tStartMs": 71900,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "트럼프의 대통령이 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 73520,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "무조건 항복 외에는 어떤 협상도 없습니다"
    } ]
  }, {
    "tStartMs": 77620,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "협상을 하려면 전쟁 시작 전에 해야지"
    } ]
  }, {
    "tStartMs": 80160,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "지금 다 질 것 같으니까 협상하자는 게 말이 됩니까?"
    } ]
  }, {
    "tStartMs": 82850,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "Unconditional surrender"
    } ]
  }, {
    "tStartMs": 84320,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "무조건 항복을 해라"
    } ]
  }, {
    "tStartMs": 86020,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "아니면 협상은 없다"
    } ]
  }, {
    "tStartMs": 88070,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "그리고 무조건 항복을 하면"
    } ]
  }, {
    "tStartMs": 89390,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "그 다음에 이란은 밝은 미래를 맞이할 것입니다"
    } ]
  }, {
    "tStartMs": 92040,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "그래서 Make Iran Great Again도"
    } ]
  }, {
    "tStartMs": 94840,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "한번 외쳐주셨어요"
    } ]
  }, {
    "tStartMs": 96580,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "MIGA, 니가 아니고요"
    } ]
  }, {
    "tStartMs": 98420,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "MIGA"
    } ]
  }, {
    "tStartMs": 99080,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "Make Iran Great Again"
    } ]
  }, {
    "tStartMs": 101250,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "모든 게 붙이면 뭐 다 되네요"
    } ]
  }, {
    "tStartMs": 103260,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "이란을 다시 위대하게 만들겠습니다"
    } ]
  }, {
    "tStartMs": 105690,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "라고 얘기했고요"
    } ]
  }, {
    "tStartMs": 106680,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "자 그러면 이란이 무조건 항복"
    } ]
  }, {
    "tStartMs": 109090,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "지금 바로 하지 않을 것 같은데요?"
    } ]
  }, {
    "tStartMs": 111130,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 112130,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "저는 4에서 5주 안에는"
    } ]
  }, {
    "tStartMs": 114180,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "목표를 달성할 걸로 믿습니다"
    } ]
  }, {
    "tStartMs": 116260,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "한 달"
    } ]
  }, {
    "tStartMs": 117250,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "하지만 시간 제한은 없습니다"
    } ]
  }, {
    "tStartMs": 119830,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "무제한이야 무제한"
    } ]
  }, {
    "tStartMs": 121410,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "저는 이 일을 똑바로 마무리 짓고 싶습니다"
    } ]
  }, {
    "tStartMs": 124450,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "대충 어영부영 끝내지 않을 거예요"
    } ]
  }, {
    "tStartMs": 126270,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "한 달 정도면 될 거라고 믿지만"
    } ]
  }, {
    "tStartMs": 128160,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "시간 제한은 없습니다"
    } ]
  }, {
    "tStartMs": 129590,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "자 그리고 한 달 내에 해야 될 테니까"
    } ]
  }, {
    "tStartMs": 131520,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "어떻게 됩니까?"
    } ]
  }, {
    "tStartMs": 132580,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "어저께 얘기한 거예요"
    } ]
  }, {
    "tStartMs": 133870,
    "dDurationMs": 3910,
    "segs": [ {
      "utf8": "이제 이란은 강력한 공격을 받게 될 것입니다"
    } ]
  }, {
    "tStartMs": 137780,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "오늘 이란은 매우 강력한 공격을 받을 것입니다"
    } ]
  }, {
    "tStartMs": 140860,
    "dDurationMs": 3830,
    "segs": [ {
      "utf8": "지금까지 공격 대상이 아니었던 지역과 공격을 받지 않았던 집단들도"
    } ]
  }, {
    "tStartMs": 144690,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "확실한 죽음의 위협에 직면할 것입니다"
    } ]
  }, {
    "tStartMs": 148190,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "저 말을 하고"
    } ]
  }, {
    "tStartMs": 149440,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "지금도 이어지고 있는 거예요"
    } ]
  }, {
    "tStartMs": 150410,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "그 공습이"
    } ]
  }, {
    "tStartMs": 151230,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "실제로 이란 현재 매우 강력한 공습을 받고 있다고 알려지고 있어요"
    } ]
  }, {
    "tStartMs": 155550,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "저기가 인터넷이 안 되니까"
    } ]
  }, {
    "tStartMs": 156450,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "잘 나오진 않죠"
    } ]
  }, {
    "tStartMs": 157430,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "테헤란은 매우 심한 폭격을 받고 있다"
    } ]
  }, {
    "tStartMs": 159930,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "현재까지 무려 1,300명 이상이 폭격으로 사망한 것으로 알려지고 있습니다"
    } ]
  }, {
    "tStartMs": 164290,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "밤에 나오는 사진들 보면"
    } ]
  }, {
    "tStartMs": 165990,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "불바다가 될 정도로 폭격이 굉장히 심한 걸 알 수 있는데"
    } ]
  }, {
    "tStartMs": 169470,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "미국만 공격하냐"
    } ]
  }, {
    "tStartMs": 170890,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "이스라엘은 이란에 대해서"
    } ]
  }, {
    "tStartMs": 172500,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "전력을 다해 군사 작전을 계속할 거라고 얘기했어요"
    } ]
  }, {
    "tStartMs": 175340,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "전력을 다해 공격하겠다"
    } ]
  }, {
    "tStartMs": 176910,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "이스라엘 군도 미군하고 힘을 합쳐서"
    } ]
  }, {
    "tStartMs": 179490,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "대규모 전투기를 동원해서"
    } ]
  }, {
    "tStartMs": 181170,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "테헤란과 이란 곳곳을 폭격하고 있는 걸로 알려지고 있습니다"
    } ]
  }, {
    "tStartMs": 184320,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "지금 현재 지금의 가장 강력한 폭격이"
    } ]
  }, {
    "tStartMs": 186420,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "막 지금 일어나고 있겠죠"
    } ]
  }, {
    "tStartMs": 187960,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "대규모 공습을 시작했다"
    } ]
  }, {
    "tStartMs": 190030,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "자 그래서 여러분들도 이제 다 보셨겠지만"
    } ]
  }, {
    "tStartMs": 192330,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "이란을 무조건 항복시키기 위해서는"
    } ]
  }, {
    "tStartMs": 193940,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "이란 지도부의 암살이 필요하잖아요?"
    } ]
  }, {
    "tStartMs": 196320,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "굉장히 많은 이란 지도부들을 암살을 했습니다"
    } ]
  }, {
    "tStartMs": 199910,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "이란 지도부가 사실상 와해됐다라는 평가를 듣고 있고"
    } ]
  }, {
    "tStartMs": 202790,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "트럼프 대통령이 이런 얘기도 했어요"
    } ]
  }, {
    "tStartMs": 204190,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "내가 누구랑 이야기하면 좋을지 모르겠다"
    } ]
  }, {
    "tStartMs": 206760,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "이란은 지금 누가 다스려요?"
    } ]
  }, {
    "tStartMs": 207860,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "그랬더니 트럼프가 모르겠는데?"
    } ]
  }, {
    "tStartMs": 210310,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "아는 이름은 다 죽여서"
    } ]
  }, {
    "tStartMs": 211860,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "아는 이름이 없다"
    } ]
  }, {
    "tStartMs": 212990,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 214300,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "그리고 지금 이란은 현재 차기 최고 지도자 지명을 미루고 있는 상황입니다"
    } ]
  }, {
    "tStartMs": 217790,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "지명하면 아마 암살 당할 수도 있겠죠?"
    } ]
  }, {
    "tStartMs": 221350,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "라고 자료를 만들고 있었는데"
    } ]
  }, {
    "tStartMs": 223580,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "지금 자료를 만드는 마지막 순간에"
    } ]
  }, {
    "tStartMs": 225330,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "일요일 저녁 한 8시 정도에"
    } ]
  }, {
    "tStartMs": 227270,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "이란이 차기 최고 지도자 지명에 합의한 것으로 보인다라는 뉴스가 나왔어요"
    } ]
  }, {
    "tStartMs": 231610,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "지도자 임명 투표가 진행되었고"
    } ]
  }, {
    "tStartMs": 232830,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "새로운 지도자가 선출되었다"
    } ]
  }, {
    "tStartMs": 234680,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "아직 이름이 안 나왔어요"
    } ]
  }, {
    "tStartMs": 235680,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "지금은 나왔을 수도 있습니다"
    } ]
  }, {
    "tStartMs": 237120,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "두 시간 전에 이름이 안 나왔어요"
    } ]
  }, {
    "tStartMs": 238950,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "새로운 차기 지도자가 등장한 게"
    } ]
  }, {
    "tStartMs": 240720,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "이란의 현재인데"
    } ]
  }, {
    "tStartMs": 242300,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "언제까지일지 모르는 게"
    } ]
  }, {
    "tStartMs": 243450,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "이스라엘이 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 244910,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "이란의 후계자 선정에 참여하려는 자들에게 경고한다"
    } ]
  }, {
    "tStartMs": 247510,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "우리는 너희들을 표적으로 삼는 데 주저하지 않을 것이다"
    } ]
  }, {
    "tStartMs": 250110,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "암살하겠다는 말이죠"
    } ]
  }, {
    "tStartMs": 251390,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "이것은 경고다"
    } ]
  }, {
    "tStartMs": 253220,
    "dDurationMs": 480,
    "segs": [ {
      "utf8": "라고 얘기한 게"
    } ]
  }, {
    "tStartMs": 253700,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "이란의 지금이라고 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 255160,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "자 그러면 저렇게 이스라엘과 미국이 무섭게 하니까"
    } ]
  }, {
    "tStartMs": 258420,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "이란이 무조건 항복을 하면 어떠냐?"
    } ]
  }, {
    "tStartMs": 261150,
    "dDurationMs": 3970,
    "segs": [ {
      "utf8": "이란은 현재 무조건 항복 요구를 완전히 일축한 상황입니다"
    } ]
  }, {
    "tStartMs": 265120,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "물론 그럴 수는 없겠죠"
    } ]
  }, {
    "tStartMs": 266200,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "본인들이 나가라는 말인데"
    } ]
  }, {
    "tStartMs": 267870,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "목숨만 살려주세요"
    } ]
  }, {
    "tStartMs": 269300,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "라는 거잖아요"
    } ]
  }, {
    "tStartMs": 270660,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "현재 이란 대통령 페제시키안은 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 272860,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "이란의 적들이 꾸는 꿈"
    } ]
  }, {
    "tStartMs": 274250,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "이란 국민들이 무조건 항복할 것이란 바로 그 꿈"
    } ]
  }, {
    "tStartMs": 277190,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "그거는 무덤까지 가져가야 할 것이다"
    } ]
  }, {
    "tStartMs": 279650,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "그런 일은 일어나지 않는다"
    } ]
  }, {
    "tStartMs": 281340,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "이란의 혁명수비대는 현재 속도라면"
    } ]
  }, {
    "tStartMs": 284300,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "이란은 미국과 이스라엘 상대로"
    } ]
  }, {
    "tStartMs": 286100,
    "dDurationMs": 3610,
    "segs": [ {
      "utf8": "6개월 정도는 격렬한 전쟁을 벌일 수 있을 것으로 본다"
    } ]
  }, {
    "tStartMs": 289710,
    "dDurationMs": 590,
    "segs": [ {
      "utf8": "라고 얘기를 했어요"
    } ]
  }, {
    "tStartMs": 290300,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "물론 엄포고 위협일지는 몰라도"
    } ]
  }, {
    "tStartMs": 292820,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "6개월은 전쟁할 수 있다"
    } ]
  }, {
    "tStartMs": 294490,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "라고 큰 소리를 치고 있죠"
    } ]
  }, {
    "tStartMs": 296480,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "그런데 우리가 얼핏 생각하기에"
    } ]
  }, {
    "tStartMs": 298760,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "이런 생각이 들죠"
    } ]
  }, {
    "tStartMs": 300200,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "지금 지상군 없이 공습만으로"
    } ]
  }, {
    "tStartMs": 303160,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "이란을 무조건 항복시킬 수 있을까?"
    } ]
  }, {
    "tStartMs": 306260,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "그걸 해내겠다는 거죠"
    } ]
  }, {
    "tStartMs": 307360,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "어쨌건 간에"
    } ]
  }, {
    "tStartMs": 308340,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "지휘부를 다 날리는 것도"
    } ]
  }, {
    "tStartMs": 310180,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "지상군이 못 들어가니까"
    } ]
  }, {
    "tStartMs": 311340,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "공습만으로 이란 정권을 전복시키려면"
    } ]
  }, {
    "tStartMs": 314230,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "지도자들을 다 먼저 날리는 게 필요하겠죠"
    } ]
  }, {
    "tStartMs": 316510,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "근데 아무리 생각해도"
    } ]
  }, {
    "tStartMs": 317850,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "지상군이 들어가는 게"
    } ]
  }, {
    "tStartMs": 318900,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "가장 빠를 것 같은데"
    } ]
  }, {
    "tStartMs": 320390,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "이스라엘이 이란 테헤란에 쳐들어가서"
    } ]
  }, {
    "tStartMs": 322620,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "점령하는 건 어떠냐?"
    } ]
  }, {
    "tStartMs": 324240,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "참고로 이스라엘과 테헤란까지 거리는 1500km입니다"
    } ]
  }, {
    "tStartMs": 328950,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "중간에 지나가야 되는 나라가"
    } ]
  }, {
    "tStartMs": 330300,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "최소 2개국이에요"
    } ]
  }, {
    "tStartMs": 331610,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "시리아, 이라크"
    } ]
  }, {
    "tStartMs": 332730,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "이렇게 가면"
    } ]
  }, {
    "tStartMs": 333730,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "이리로 가면 3개일 수도 있어"
    } ]
  }, {
    "tStartMs": 335010,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "사우디, 이라크"
    } ]
  }, {
    "tStartMs": 335900,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "이렇게 가면 하여튼 2개국은 최소 지나가야 돼"
    } ]
  }, {
    "tStartMs": 338340,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "사실상 여기에 그렇다고 대규모 공수 작전에 펼쳐서"
    } ]
  }, {
    "tStartMs": 342380,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "병력을 떨어뜨려서 이란을 점령할 수 있냐"
    } ]
  }, {
    "tStartMs": 345020,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "그건 어렵겠죠"
    } ]
  }, {
    "tStartMs": 346020,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "이란이 아무리 허수아비처럼 보여도"
    } ]
  }, {
    "tStartMs": 348260,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "군사력이 막강할 텐데"
    } ]
  }, {
    "tStartMs": 349880,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "지상군은"
    } ]
  }, {
    "tStartMs": 350900,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "사실상 어려울 것 같고"
    } ]
  }, {
    "tStartMs": 352360,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "그러면 미국이 지상군을 투입하면 어떨까?"
    } ]
  }, {
    "tStartMs": 356020,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "마치 1991년 걸프전 때처럼"
    } ]
  }, {
    "tStartMs": 358880,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "걸프전 때 미국이 막 공습을 한 다음에"
    } ]
  }, {
    "tStartMs": 361180,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "한 달 정도 후에 지상군을 투입했어요"
    } ]
  }, {
    "tStartMs": 363330,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "그리고 지상군 투입한 다음에"
    } ]
  }, {
    "tStartMs": 364620,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "불과 4일 만에 종전을 선언했습니다"
    } ]
  }, {
    "tStartMs": 366660,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "4일 만에 싹 밀었어"
    } ]
  }, {
    "tStartMs": 368770,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "이라크를 싹 밀었죠"
    } ]
  }, {
    "tStartMs": 370000,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "물론 당시에는 무려 30개국의 약 70만 명의 병력이 집결되어 있었기 때문에"
    } ]
  }, {
    "tStartMs": 374720,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "다국적군이 동시에 들어갔긴 하지만"
    } ]
  }, {
    "tStartMs": 376920,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "어쨌건 미국 지상군이 들어가니까"
    } ]
  }, {
    "tStartMs": 378350,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "4일 만에 종전이 되더라"
    } ]
  }, {
    "tStartMs": 380890,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "근데 참고로 종전이 안 된 나라도 있죠"
    } ]
  }, {
    "tStartMs": 383490,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "2001년에 9.11 테러 이후에"
    } ]
  }, {
    "tStartMs": 385190,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "미국은 아프가니스탄에 지상군을 투입했습니다"
    } ]
  }, {
    "tStartMs": 388870,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "투입했습니다까지만 얘기한 거는"
    } ]
  }, {
    "tStartMs": 390620,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "그 후로 20년 동안"
    } ]
  }, {
    "tStartMs": 392200,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "아프가니스탄에 머물렀어요 2021년까지"
    } ]
  }, {
    "tStartMs": 395520,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "결국에 철수했죠"
    } ]
  }, {
    "tStartMs": 398040,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "사실상의 패배?"
    } ]
  }, {
    "tStartMs": 399170,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "왜냐하면 지금도 탈레반이"
    } ]
  }, {
    "tStartMs": 400360,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "아프가니스탄을 통치하고 있기 때문에"
    } ]
  }, {
    "tStartMs": 402170,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "결국에 20년간 얼마를 넣었다고요?"
    } ]
  }, {
    "tStartMs": 404000,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "여기 2천조 넘게 넣었어요"
    } ]
  }, {
    "tStartMs": 405320,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "2천 몇백조를 넣었지만"
    } ]
  }, {
    "tStartMs": 406960,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "결국에는 이기지 못하고"
    } ]
  }, {
    "tStartMs": 408440,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "아프가니스탄 철수를 했는데"
    } ]
  }, {
    "tStartMs": 410140,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "지형이 문제고 이런 얘기가 많이 나왔죠"
    } ]
  }, {
    "tStartMs": 412390,
    "dDurationMs": 3950,
    "segs": [ {
      "utf8": "그런데 이란은 왼쪽이 이란 지형도인데"
    } ]
  }, {
    "tStartMs": 416340,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "어떤 나라냐?"
    } ]
  }, {
    "tStartMs": 417790,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "북쪽에 있는 산악"
    } ]
  }, {
    "tStartMs": 419100,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "그리고 아래쪽에 있는 산"
    } ]
  }, {
    "tStartMs": 420590,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "이런 V자 형태로"
    } ]
  }, {
    "tStartMs": 422350,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "산맥이 나라를 감싸고 있는 형태를 취하고 있습니다"
    } ]
  }, {
    "tStartMs": 425060,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "한마디로 외적의 진입이 정말 쉽지 않은 나라인데"
    } ]
  }, {
    "tStartMs": 428290,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "왜냐하면 여기 있는 산들은"
    } ]
  }, {
    "tStartMs": 430260,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "높이가 미쳤어요"
    } ]
  }, {
    "tStartMs": 431640,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "최고 높이의 산이 5,610m입니다"
    } ]
  }, {
    "tStartMs": 434560,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "우리나라 백두산의 거의 80% 이상 높죠"
    } ]
  }, {
    "tStartMs": 437310,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "한라산 2배 가까운 높이니까"
    } ]
  }, {
    "tStartMs": 438940,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "그리고 이 두 산맥 사이에"
    } ]
  }, {
    "tStartMs": 440600,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "넓은 고원이 있잖아요"
    } ]
  }, {
    "tStartMs": 442340,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "이란 고원"
    } ]
  }, {
    "tStartMs": 443040,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "여기에 뭐 테헤란도 있고 막 있죠"
    } ]
  }, {
    "tStartMs": 444520,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "이 넓은 고원도"
    } ]
  }, {
    "tStartMs": 446170,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "평균 해발 고도가 1,000m야"
    } ]
  }, {
    "tStartMs": 449090,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "1,000m죠"
    } ]
  }, {
    "tStartMs": 450100,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "저도 이번에 알았는데"
    } ]
  }, {
    "tStartMs": 450820,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "테헤란의 평균 고도가 1,000m에서 1,200m라고 합니다"
    } ]
  }, {
    "tStartMs": 454460,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "엄청난 산악 지형이고"
    } ]
  }, {
    "tStartMs": 456690,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "저기를 뚫고 지상군을 들여보내서"
    } ]
  }, {
    "tStartMs": 460980,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "지상군의 싸움을 하는 게"
    } ]
  }, {
    "tStartMs": 462320,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "정말 쉽지 않을 것 같은데"
    } ]
  }, {
    "tStartMs": 464130,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "과연 미국이 이란에 지상군을 투입할 수 있을까?"
    } ]
  }, {
    "tStartMs": 467100,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "이길 수는 있을 것도 같은데"
    } ]
  }, {
    "tStartMs": 468480,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "엄청난 희생이 뒤따를 수도 있을 것 같죠"
    } ]
  }, {
    "tStartMs": 472120,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "그렇기 때문에 미국이"
    } ]
  }, {
    "tStartMs": 473130,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "그럼 지상군 말고"
    } ]
  }, {
    "tStartMs": 474730,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "정권을 전복시키는 가장 좋은 방법은"
    } ]
  }, {
    "tStartMs": 476720,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "역시 이란 내부에서 정권 교체겠죠"
    } ]
  }, {
    "tStartMs": 479750,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "그래서 맨날 말하는 게 뭡니까?"
    } ]
  }, {
    "tStartMs": 480900,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "트럼프 대통령이"
    } ]
  }, {
    "tStartMs": 481830,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "이란 국민들이여 봉기하라"
    } ]
  }, {
    "tStartMs": 484590,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "이란 국민들이여 자유의 시간이 왔다"
    } ]
  }, {
    "tStartMs": 486660,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "우리의 공습이 끝나면"
    } ]
  }, {
    "tStartMs": 487920,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "걔들은 이미 전투력을 잃었어"
    } ]
  }, {
    "tStartMs": 490210,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "그러니까 우리가 들어가기 전에"
    } ]
  }, {
    "tStartMs": 492540,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "너희들이 먼저 정부를 장악하라"
    } ]
  }, {
    "tStartMs": 494560,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "그러면 너희의 것이 될 거야"
    } ]
  }, {
    "tStartMs": 496270,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "미국이 들어가서 장악하면"
    } ]
  }, {
    "tStartMs": 497640,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "미국이 될 수도 있잖아"
    } ]
  }, {
    "tStartMs": 498500,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "안 가지겠지만"
    } ]
  }, {
    "tStartMs": 500570,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "너희들이 지금 스스로 일어나서"
    } ]
  }, {
    "tStartMs": 502260,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "정권을 교체하면"
    } ]
  }, {
    "tStartMs": 503380,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "이란은 너희들의 것이 될 것이다"
    } ]
  }, {
    "tStartMs": 505370,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "라고 얘기를 하고요"
    } ]
  }, {
    "tStartMs": 506470,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "요즘에 가끔 나오는 건데"
    } ]
  }, {
    "tStartMs": 508050,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "외부 세력을 이용한 정권 교체이기도 합니다"
    } ]
  }, {
    "tStartMs": 509960,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "내전 같은 거를 만들어서"
    } ]
  }, {
    "tStartMs": 512000,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "예를 들면 이라크의 쿠르드 민족주의 단체가"
    } ]
  }, {
    "tStartMs": 514210,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "이라크 북쪽에 있습니다"
    } ]
  }, {
    "tStartMs": 515750,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "쿠르드족 독립하겠다고"
    } ]
  }, {
    "tStartMs": 517140,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "얘네들을 찔러서"
    } ]
  }, {
    "tStartMs": 518460,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "얘네들이 국격을 넘어서"
    } ]
  }, {
    "tStartMs": 519590,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "이란으로 지상 작전을 감행해라"
    } ]
  }, {
    "tStartMs": 521600,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "우리가 너희들한테 공격하는 이란 애들 떼찌 떼찌 해줄게"
    } ]
  }, {
    "tStartMs": 524910,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "공중에서 다 날려줄 테니까"
    } ]
  }, {
    "tStartMs": 526530,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "니들이 들어가"
    } ]
  }, {
    "tStartMs": 527460,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "니들이 들어가서"
    } ]
  }, {
    "tStartMs": 528580,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "거기를 후루룩 후루룩 하다 보면은"
    } ]
  }, {
    "tStartMs": 531130,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "뭐가 되지 않을까?"
    } ]
  }, {
    "tStartMs": 532030,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "라는 내용이 많이 나오고 있습니다"
    } ]
  }, {
    "tStartMs": 534340,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "물론 처음에는 저 내용에 대해서"
    } ]
  }, {
    "tStartMs": 536160,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "트럼프 대통령이 쿠르드족이 지상군을 보낸다고 하니까"
    } ]
  }, {
    "tStartMs": 538730,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "어우 훌륭한 일이에요"
    } ]
  }, {
    "tStartMs": 540020,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "저는 전적으로 찬성합니다"
    } ]
  }, {
    "tStartMs": 541690,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "라고 했다가"
    } ]
  }, {
    "tStartMs": 542250,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "엊그제 너무 복잡하네 그만하자"
    } ]
  }, {
    "tStartMs": 544990,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "라고 번복했다고 하는데"
    } ]
  }, {
    "tStartMs": 546280,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "하여튼 이런 내용들이 나오고 있고요"
    } ]
  }, {
    "tStartMs": 548000,
    "dDurationMs": 3650,
    "segs": [ {
      "utf8": "그런데 지금 방금 전에 드린 얘기를 잘 생각해보면"
    } ]
  }, {
    "tStartMs": 551650,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "이라크는 이란 옆에 있는 나라입니다"
    } ]
  }, {
    "tStartMs": 553880,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "이라크 북부에 있는 쿠르드 반군이"
    } ]
  }, {
    "tStartMs": 556520,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "이란으로 지상군을 보낸다는 건"
    } ]
  }, {
    "tStartMs": 558940,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "물론 이라크의 뜻은 아니지만"
    } ]
  }, {
    "tStartMs": 560330,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "이라크 북부 자치구에 있어요"
    } ]
  }, {
    "tStartMs": 561980,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "이란이 이라크한테 싸워야 된단 말이죠"
    } ]
  }, {
    "tStartMs": 564930,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "그럼 잘못하면"
    } ]
  }, {
    "tStartMs": 565690,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "이란과 이라크가 전쟁에 휘말릴 가능성도 있고요"
    } ]
  }, {
    "tStartMs": 568640,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "그리고 지금 이라크보다 조금 더 심각한 얘기를 하고 있는 나라가 또 있으니"
    } ]
  }, {
    "tStartMs": 572480,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "이란 북쪽에 있는 아제르바이잔이라는 나라가 있습니다"
    } ]
  }, {
    "tStartMs": 575780,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "지금 언론에 많이 등장하는 거 알 수 있을 거예요"
    } ]
  }, {
    "tStartMs": 577700,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "여기가 이라크, 위가 아제르바이잔이에요"
    } ]
  }, {
    "tStartMs": 579680,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "그럼 아제르바이잔은 또 왜 험악해지냐?"
    } ]
  }, {
    "tStartMs": 582120,
    "dDurationMs": 5030,
    "segs": [ {
      "utf8": "아제르바이잔은 이란이 아제르바이잔을 드론으로 공격했다고 주장하고 있어요"
    } ]
  }, {
    "tStartMs": 587150,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "보복하겠다 이런 말을 얘기하고 있습니다"
    } ]
  }, {
    "tStartMs": 589260,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "아제르바이잔 대통령은 이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 591360,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "이란이 아제르바이잔을 공격한 건 추악하고 비겁하고 역겹다"
    } ]
  }, {
    "tStartMs": 595530,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "디스거스팅하다"
    } ]
  }, {
    "tStartMs": 596930,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "독립 아제르바이잔은 이란에 사는 아제르바이잔인들에게는 희망의 땅이다"
    } ]
  }, {
    "tStartMs": 601470,
    "dDurationMs": 550,
    "segs": [ {
      "utf8": "라고 얘기했는데"
    } ]
  }, {
    "tStartMs": 602020,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "마지막 이 줄은 사실은 이란과 아제르바이잔 사이에서는"
    } ]
  }, {
    "tStartMs": 605620,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "이야기하면 안 되는 금기시되는 내용이었어요"
    } ]
  }, {
    "tStartMs": 608400,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "무슨 소리냐?"
    } ]
  }, {
    "tStartMs": 609410,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "이란에는 아제르바이잔 계열의"
    } ]
  }, {
    "tStartMs": 611640,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "같은 아제르바이잔 민족의 사람들이"
    } ]
  }, {
    "tStartMs": 613920,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "거의 2천만 명이 삽니다"
    } ]
  }, {
    "tStartMs": 615870,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "독립 아제르바이잔보다 이란에 사는 아제르바이잔인들이 더 많아요"
    } ]
  }, {
    "tStartMs": 620100,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "그래서 아제르바이잔은 이란 북부를 남아제르바이잔이라고 부릅니다"
    } ]
  }, {
    "tStartMs": 624400,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "그러니까 이 말은 무슨 말입니까?"
    } ]
  }, {
    "tStartMs": 625730,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "이란에 사는 아제르바이잔들 보고 독립을 해서"
    } ]
  }, {
    "tStartMs": 629050,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "독립 아제르바이잔과 같이 할 수 있다며"
    } ]
  }, {
    "tStartMs": 632540,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "아제르바이잔은 지금 요만한데"
    } ]
  }, {
    "tStartMs": 633970,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "이렇게 될 수 있는 거죠"
    } ]
  }, {
    "tStartMs": 635410,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "물론 이란은 이 얘기를 하면"
    } ]
  }, {
    "tStartMs": 637110,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "극대노를 하겠죠 장난하냐고"
    } ]
  }, {
    "tStartMs": 639770,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "이 양나라 사이에는 그게 있는 거예요"
    } ]
  }, {
    "tStartMs": 641910,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "그리고 추가적으로 보여드리면"
    } ]
  }, {
    "tStartMs": 644320,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "아제르바이잔과 이란은 치명적인 국경 분쟁이 있습니다"
    } ]
  }, {
    "tStartMs": 647150,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "방금 전에 얘기했던 타브리즈라는 데가"
    } ]
  }, {
    "tStartMs": 649510,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "아제르바이잔인들이 많이 사는 도시인데"
    } ]
  }, {
    "tStartMs": 651390,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "여기를 보면"
    } ]
  }, {
    "tStartMs": 652200,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "아제르바이잔은 아르메니아라는 거의 화약고 같은"
    } ]
  }, {
    "tStartMs": 655570,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "옆 나라가 있습니다"
    } ]
  }, {
    "tStartMs": 656740,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "항상 전쟁하는 나라죠"
    } ]
  }, {
    "tStartMs": 657850,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "전쟁하는 나라"
    } ]
  }, {
    "tStartMs": 658900,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "그런데 이 옆에 있는 나흐츠반이라고 부르는"
    } ]
  }, {
    "tStartMs": 662170,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "여기가 아제르바이잔 땅이에요"
    } ]
  }, {
    "tStartMs": 664430,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "아제르바이잔은 이렇게 연결이 되지 않은"
    } ]
  }, {
    "tStartMs": 667450,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "또 다른 영토가 있어요"
    } ]
  }, {
    "tStartMs": 668740,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "격오지가 있어요"
    } ]
  }, {
    "tStartMs": 670080,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "그 가운데 이 아제르바이잔 영토가"
    } ]
  }, {
    "tStartMs": 672320,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "이렇게 있는 겁니다"
    } ]
  }, {
    "tStartMs": 674140,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "그러니까 이 아제르바이잔 입장에서는"
    } ]
  }, {
    "tStartMs": 676680,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "여기를 연결할 수 있다면"
    } ]
  }, {
    "tStartMs": 678240,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "자기네 땅을 남쪽을 자기들이 후루룩 짭짭해서"
    } ]
  }, {
    "tStartMs": 680610,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "아르메니아를 밀고"
    } ]
  }, {
    "tStartMs": 681820,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "그럼 이렇게 연결하면서"
    } ]
  }, {
    "tStartMs": 683320,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "왼쪽 나라가 터키거든요"
    } ]
  }, {
    "tStartMs": 684600,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "터키까지 연결할 수 있는"
    } ]
  }, {
    "tStartMs": 685800,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "이런 길을 만들 수 있겠죠"
    } ]
  }, {
    "tStartMs": 687180,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "이게 본인들의 희망이에요"
    } ]
  }, {
    "tStartMs": 689240,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "이걸 엄청나게 하고 싶어해"
    } ]
  }, {
    "tStartMs": 690650,
    "dDurationMs": 4010,
    "segs": [ {
      "utf8": "이 가운데 있는 아르메니아가 차지하고 있다는 이 회랑"
    } ]
  }, {
    "tStartMs": 694660,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "이게 장게주르 회랑이라고 불립니다"
    } ]
  }, {
    "tStartMs": 697500,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "이것 때문에 두 나라가 사이가 굉장히 안 좋고"
    } ]
  }, {
    "tStartMs": 699910,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "또 양국은 옛날에 보여드렸죠"
    } ]
  }, {
    "tStartMs": 701760,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "2020년에 이미 전쟁까지 한 적이 있었죠"
    } ]
  }, {
    "tStartMs": 704260,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "저기를 확대해서 보면은"
    } ]
  }, {
    "tStartMs": 705660,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "국경 분쟁의 심각성을 잘 알 수 있는데"
    } ]
  }, {
    "tStartMs": 707930,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "이렇게 돼 있어요"
    } ]
  }, {
    "tStartMs": 708910,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "여기가 회랑"
    } ]
  }, {
    "tStartMs": 709570,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "아까 말한 회랑"
    } ]
  }, {
    "tStartMs": 710460,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "그리고 양쪽이 아제르바이잔 땅입니다"
    } ]
  }, {
    "tStartMs": 713160,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "이거 얼마나 여기를 차지하고 싶겠어"
    } ]
  }, {
    "tStartMs": 715680,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "아래는 이란이에요"
    } ]
  }, {
    "tStartMs": 716980,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "이란은 참고로 아르메니아하고 동맹입니다"
    } ]
  }, {
    "tStartMs": 719500,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "아제르바이잔하고 웬수예요"
    } ]
  }, {
    "tStartMs": 721180,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "이 둘은 또 웬수고"
    } ]
  }, {
    "tStartMs": 722510,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "그럼 아르메니아가 이슬람이냐, 시아파냐"
    } ]
  }, {
    "tStartMs": 725250,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "아르메니아는 기독교 국가예요"
    } ]
  }, {
    "tStartMs": 727640,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "그럼 아제르바이잔도 기독교 국가냐"
    } ]
  }, {
    "tStartMs": 728920,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "여기는 시아파예요 이슬람"
    } ]
  }, {
    "tStartMs": 731230,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "여기도 이슬람"
    } ]
  }, {
    "tStartMs": 731910,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "여기도 이슬람이면"
    } ]
  }, {
    "tStartMs": 732880,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "이렇게 손을 잡아야지 왜 이렇게 잡냐"
    } ]
  }, {
    "tStartMs": 734970,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "방금 전에 제가 말씀드린 그게 있는 겁니다"
    } ]
  }, {
    "tStartMs": 737220,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "여기가 북아제르바이잔이라고 부르고"
    } ]
  }, {
    "tStartMs": 739750,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "여차하면 후루룩하겠다는 생각을 갖고 있고"
    } ]
  }, {
    "tStartMs": 742550,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "또 여기를 내놓으라고 지금 그러고 있는 상황이니까"
    } ]
  }, {
    "tStartMs": 744960,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "복잡하죠"
    } ]
  }, {
    "tStartMs": 745880,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "말만 들어도 이제 복잡한데"
    } ]
  }, {
    "tStartMs": 747740,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "두 나라는 툭하면 전쟁을 하고"
    } ]
  }, {
    "tStartMs": 749510,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "그런 상황에서 이란이 아제르바이잔에 드론을 날렸다는 거고"
    } ]
  }, {
    "tStartMs": 752510,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "아제르바이잔은 잘 생각하면"
    } ]
  }, {
    "tStartMs": 754950,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "지금이 기회일 수도 있습니다"
    } ]
  }, {
    "tStartMs": 756970,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "그러면 안 되겠지만"
    } ]
  }, {
    "tStartMs": 757990,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "지금이 기회라고 생각할 수도 있어요"
    } ]
  }, {
    "tStartMs": 759650,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "이걸 먹든가 남쪽을 먹든가"
    } ]
  }, {
    "tStartMs": 762770,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "아르메니아 땅을 안 먹어도"
    } ]
  }, {
    "tStartMs": 764780,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "이렇게 먹을 수 있으면"
    } ]
  }, {
    "tStartMs": 766220,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "연결이 될 수 있습니다"
    } ]
  }, {
    "tStartMs": 767700,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "물론 이란이 가만히 있진 않겠지만"
    } ]
  }, {
    "tStartMs": 770200,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "지금 이란은 제 코가 석자일 수도 있죠"
    } ]
  }, {
    "tStartMs": 772720,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "그리고 미국이 얘기할 수도 있어요"
    } ]
  }, {
    "tStartMs": 774330,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "내가 떼찌 떼찌 해줄게"
    } ]
  }, {
    "tStartMs": 776260,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "뭐 이렇게 할 수도 있는"
    } ]
  }, {
    "tStartMs": 777690,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "그런 상황이다 보니까"
    } ]
  }, {
    "tStartMs": 778610,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "아직 거기까지 가지 않았지만"
    } ]
  }, {
    "tStartMs": 780070,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "만약에 저기 분쟁까지 얽히게 된다면"
    } ]
  }, {
    "tStartMs": 782620,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "그건 늪이죠"
    } ]
  }, {
    "tStartMs": 784190,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "그걸로 가면 안 되죠"
    } ]
  }, {
    "tStartMs": 784900,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "그걸로 가면"
    } ]
  }, {
    "tStartMs": 785890,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "그때부터는 걷잡을 수가 없는데"
    } ]
  }, {
    "tStartMs": 787420,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "아마 안 가지 않을까 생각을 합니다"
    } ]
  }, {
    "tStartMs": 789510,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "그런 분쟁 지역이라는 거고"
    } ]
  }, {
    "tStartMs": 791420,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "게다가 옆 나라들은 가만히 있어야 되는데"
    } ]
  }, {
    "tStartMs": 793370,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "지금 아까 전에 이라크 북부에 있는 쿠르드족"
    } ]
  }, {
    "tStartMs": 796010,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "위에 있는 아제르바이잔"
    } ]
  }, {
    "tStartMs": 797530,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "게다가 이번에는 레바논 헤즈볼라도"
    } ]
  }, {
    "tStartMs": 799340,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "참전 성명을 발표했습니다"
    } ]
  }, {
    "tStartMs": 801550,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "너희는 또 왜?"
    } ]
  }, {
    "tStartMs": 802300,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "레바논은 여기 있어요"
    } ]
  }, {
    "tStartMs": 803090,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "이스라엘 위에"
    } ]
  }, {
    "tStartMs": 804170,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "헤즈볼라는 이스라엘을 향해서"
    } ]
  }, {
    "tStartMs": 805460,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "공격형 드론 편대를 발사했다"
    } ]
  }, {
    "tStartMs": 807390,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "우리가 공격한다"
    } ]
  }, {
    "tStartMs": 809150,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "참고로 레바논이 공격한다는 게 아니라"
    } ]
  }, {
    "tStartMs": 811300,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "레바논에 있는 정치 조직이자"
    } ]
  }, {
    "tStartMs": 813810,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "군대 조직인 헤즈볼라가 공격을 한다는 겁니다"
    } ]
  }, {
    "tStartMs": 816530,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "이들은 이렇게 얘기했어요"
    } ]
  }, {
    "tStartMs": 817600,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "인내의 시간은 끝났다"
    } ]
  }, {
    "tStartMs": 818870,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "우리는 저항으로 복귀하는 것 외에는"
    } ]
  }, {
    "tStartMs": 820230,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "선택의 여지가 없다"
    } ]
  }, {
    "tStartMs": 821470,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "이스라엘을 공격하겠다"
    } ]
  }, {
    "tStartMs": 822770,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "물론 그 말을 들은"
    } ]
  }, {
    "tStartMs": 823630,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "레바논 정부는 화들짝 놀랐죠"
    } ]
  }, {
    "tStartMs": 825740,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "그러지 마"
    } ]
  }, {
    "tStartMs": 827140,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "우리는 공격할 생각이 없어"
    } ]
  }, {
    "tStartMs": 828780,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "헤즈볼라의 공격은 레바논 국민 대다수의 의지를 무시하는 행위다"
    } ]
  }, {
    "tStartMs": 831950,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "지금 저기에 휩쓸려 들어가면"
    } ]
  }, {
    "tStartMs": 833760,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "어떤 일이 있을지 모르죠"
    } ]
  }, {
    "tStartMs": 835110,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "미국과 이스라엘이 이란을 때리고 있는데"
    } ]
  }, {
    "tStartMs": 837530,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "거기에서 이스라엘을 때린다는 건"
    } ]
  }, {
    "tStartMs": 839330,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "미국과 싸우겠다는 말이잖아"
    } ]
  }, {
    "tStartMs": 841860,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "아니, 우린 그런 생각이 없어"
    } ]
  }, {
    "tStartMs": 843420,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "쟤네가 하겠다는데"
    } ]
  }, {
    "tStartMs": 844300,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "쟤는 내가 아니야"
    } ]
  }, {
    "tStartMs": 845360,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "내가 막을 수도 없어"
    } ]
  }, {
    "tStartMs": 846390,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "내가 막는데 하겠다는 거 어떡해"
    } ]
  }, {
    "tStartMs": 848430,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "레바논은 분쟁에 휘말리는 것을 거부한다"
    } ]
  }, {
    "tStartMs": 851060,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "라고 했지만"
    } ]
  }, {
    "tStartMs": 851990,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "헤즈볼라는 듣지도 않죠"
    } ]
  }, {
    "tStartMs": 854080,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "이스라엘에게 미사일 발사를 멈추지 않았다"
    } ]
  }, {
    "tStartMs": 856720,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "그래서 이번에는 가뜩이나 고슴도치처럼"
    } ]
  }, {
    "tStartMs": 859950,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "바싹 써있는 이스라엘이 레바논을 공격합니다"
    } ]
  }, {
    "tStartMs": 864070,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "레바논 베이루트 지역을 공습해서"
    } ]
  }, {
    "tStartMs": 866260,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "수천 명이 피난길에 올랐고"
    } ]
  }, {
    "tStartMs": 867680,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "지금 베이루트 지역도"
    } ]
  }, {
    "tStartMs": 869090,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "강력한 공격을 받고 있다라고 얘기 되는데"
    } ]
  }, {
    "tStartMs": 871380,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "이렇게 나옵니다"
    } ]
  }, {
    "tStartMs": 872500,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "강력한 폭격을 받아서"
    } ]
  }, {
    "tStartMs": 873720,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "최소 200명 이상의 사망자가 발생했다"
    } ]
  }, {
    "tStartMs": 875940,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "이미"
    } ]
  }, {
    "tStartMs": 876950,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "지금은 실시간으로 늘어나고 있을 겁니다"
    } ]
  }, {
    "tStartMs": 879010,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "레바논까지 좋건 싫건"
    } ]
  }, {
    "tStartMs": 881120,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "지금 전쟁에 휘말릴 위기에 처해 있죠"
    } ]
  }, {
    "tStartMs": 883840,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "레바논 총리가 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 885630,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "우리나라는 원하지도 선택하지 않았던"
    } ]
  }, {
    "tStartMs": 887500,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "참혹한 전쟁에 휘말려 버렸다"
    } ]
  }, {
    "tStartMs": 889630,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "이건 아니야"
    } ]
  }, {
    "tStartMs": 890530,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "게다가 옛날에 보여드렸지만"
    } ]
  }, {
    "tStartMs": 892280,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "쿠웨이트에 위치한 미군 기지도 공격을 받았고요"
    } ]
  }, {
    "tStartMs": 896020,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "아랍에미리트도 공격을 받았습니다"
    } ]
  }, {
    "tStartMs": 898590,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "800건 이상의 드론이 날아왔다 이란에서"
    } ]
  }, {
    "tStartMs": 901780,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "사우디아라비아는 대규모 정유시설이"
    } ]
  }, {
    "tStartMs": 905110,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "드론 공격을 받았다"
    } ]
  }, {
    "tStartMs": 906690,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "잘 안 보이는데"
    } ]
  }, {
    "tStartMs": 907300,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "여기가 이란이고"
    } ]
  }, {
    "tStartMs": 908350,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "이 아래가 사우디입니다"
    } ]
  }, {
    "tStartMs": 909350,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "이렇게 공격이 왔다는 거죠 이렇게"
    } ]
  }, {
    "tStartMs": 911230,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "그런데 사우디가 공격을 받으니까"
    } ]
  }, {
    "tStartMs": 913540,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "이번에는 파키스탄이 성명을 발표합니다"
    } ]
  }, {
    "tStartMs": 916160,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "정리하기가 너무 어려워"
    } ]
  }, {
    "tStartMs": 917520,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "저 지역은 얽히고 설켜서"
    } ]
  }, {
    "tStartMs": 919160,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "파키스탄은 또 왜?"
    } ]
  }, {
    "tStartMs": 920200,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "너희들은 뭔데?"
    } ]
  }, {
    "tStartMs": 921640,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "파키스탄은 이란한테"
    } ]
  }, {
    "tStartMs": 923080,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "사우디아라비아를 공격하지 말라고"
    } ]
  }, {
    "tStartMs": 925040,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "경고 메시지를 날렸어요"
    } ]
  }, {
    "tStartMs": 927100,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "갑자기 니들이 사우디"
    } ]
  }, {
    "tStartMs": 928500,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "왜 그 편을 드나?"
    } ]
  }, {
    "tStartMs": 929950,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "이렇게 얘기합니다"
    } ]
  }, {
    "tStartMs": 931030,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "우리는 상호방위조약을 맺었다"
    } ]
  }, {
    "tStartMs": 934190,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "이란이 사우디를 공격하면"
    } ]
  }, {
    "tStartMs": 936450,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "파키스탄은 이란을 공격해야 돼"
    } ]
  }, {
    "tStartMs": 939210,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "그게 상호방위조약이잖아요"
    } ]
  }, {
    "tStartMs": 940800,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "어느 한 국가에 대한 공격은"
    } ]
  }, {
    "tStartMs": 942650,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "양국 모두에 대한 공격으로 간주한다"
    } ]
  }, {
    "tStartMs": 944970,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "네가 사우디를 때리면"
    } ]
  }, {
    "tStartMs": 946330,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "파키스탄을 때리는 거야"
    } ]
  }, {
    "tStartMs": 947870,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "참전해야 될 수도 있어"
    } ]
  }, {
    "tStartMs": 949250,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "그러니까 공격하지 마라"
    } ]
  }, {
    "tStartMs": 950380,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "라고 얘기를 했고요"
    } ]
  }, {
    "tStartMs": 951540,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "그 와중에 이분은 왜 거기에 나오는지 모르겠지만"
    } ]
  }, {
    "tStartMs": 954940,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "우크라이나는 아랍에미리트를 돕겠다고 나섰다"
    } ]
  }, {
    "tStartMs": 958320,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "미국에 잘 보이고 싶은 거라고 이해를 합니다"
    } ]
  }, {
    "tStartMs": 961070,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "생명 보호를 지원하는데"
    } ]
  }, {
    "tStartMs": 962070,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "우크라이나가 뭘 하겠다고 얘기했는데"
    } ]
  }, {
    "tStartMs": 963570,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "트럼프 대통령도 뭐 감사 감사 했으니까"
    } ]
  }, {
    "tStartMs": 965960,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "그런 용도가 있고요"
    } ]
  }, {
    "tStartMs": 966980,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "게다가 여기까지만 해도 복잡한데"
    } ]
  }, {
    "tStartMs": 969470,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "얼마 전에 키프로스 얘기도 나오고 있죠"
    } ]
  }, {
    "tStartMs": 971790,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "키프로스로 오던 드론 두 개를 요격했다"
    } ]
  }, {
    "tStartMs": 973910,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "그리고 일요일에는 키프로스가 드론 공경을 받았다"
    } ]
  }, {
    "tStartMs": 977660,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "키프로스는 또 어디 있는 나라냐?"
    } ]
  }, {
    "tStartMs": 980080,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "이스라엘, 레바논, 시리아, 요르단, 이라크, 이란 그렇잖아요"
    } ]
  }, {
    "tStartMs": 983460,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "그 왼쪽 위에 있는 섬나라입니다"
    } ]
  }, {
    "tStartMs": 987140,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "근데 키프로스는 여기에 끼면 안 돼요"
    } ]
  }, {
    "tStartMs": 990220,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "여긴 안 돼"
    } ]
  }, {
    "tStartMs": 990840,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "아제르바이잔과 비슷하게 끼면 안 돼"
    } ]
  }, {
    "tStartMs": 992380,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "왜냐?"
    } ]
  }, {
    "tStartMs": 993390,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "여긴 EU 회원국이야"
    } ]
  }, {
    "tStartMs": 995180,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "영국 기지가 있어"
    } ]
  }, {
    "tStartMs": 996320,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "이탈리아, 스페인, EU 군대가"
    } ]
  }, {
    "tStartMs": 997820,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "키프로스에 지금 집결하고 있다는 말이 나오고 있어요"
    } ]
  }, {
    "tStartMs": 1000590,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "위가 터키거든요"
    } ]
  }, {
    "tStartMs": 1001500,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "터키도 키프로스에 군대를 보내겠다는 얘기를 하고 있습니다"
    } ]
  }, {
    "tStartMs": 1005080,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "키프로스에 있는 군사가"
    } ]
  }, {
    "tStartMs": 1006950,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "여기로 어떻게 들어가면"
    } ]
  }, {
    "tStartMs": 1010340,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "유럽까지 얽히는 건데"
    } ]
  }, {
    "tStartMs": 1012100,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "이제 그러면은 안 되겠죠"
    } ]
  }, {
    "tStartMs": 1014450,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "영국은 자국 항공모함을"
    } ]
  }, {
    "tStartMs": 1016340,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "키프로스 근처에 투입하겠다고 밝혔습니다"
    } ]
  }, {
    "tStartMs": 1018880,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "F-35, 유로 타이푼"
    } ]
  }, {
    "tStartMs": 1020590,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "이런 전투기들과 함께"
    } ]
  }, {
    "tStartMs": 1021930,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "프린스 오브 웨일스함을 영국의 이익을 위해서"
    } ]
  }, {
    "tStartMs": 1024400,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "키프로스에 보내겠다"
    } ]
  }, {
    "tStartMs": 1025990,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "그랬더니 트럼프 대통령이 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1027360,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "뭐라고 얘기했겠어요?"
    } ]
  }, {
    "tStartMs": 1028260,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "영국의 항공모함을 너희를 위해 보내줄게"
    } ]
  }, {
    "tStartMs": 1030600,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "우리도 출격해서 이란 때려줄게 그랬더니"
    } ]
  }, {
    "tStartMs": 1033280,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "트럼프 대통령이 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1035410,
    "dDurationMs": 580,
    "segs": [ {
      "utf8": "아 됐어"
    } ]
  }, {
    "tStartMs": 1035990,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "됐어 필요 없어"
    } ]
  }, {
    "tStartMs": 1038020,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "이제서야"
    } ]
  }, {
    "tStartMs": 1038820,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "스타머 총리 이제는 괜찮습니다"
    } ]
  }, {
    "tStartMs": 1040920,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "우리는 필요하지 않아요"
    } ]
  }, {
    "tStartMs": 1042510,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "오라고 할 땐 안 오고"
    } ]
  }, {
    "tStartMs": 1043710,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "처음 공습 같이 하자고 할 때는"
    } ]
  }, {
    "tStartMs": 1045100,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "이래 싫고 저래 싫고 하더니"
    } ]
  }, {
    "tStartMs": 1046120,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "안 하더니 이긴 것 같으니까 숟가락으로 올려?"
    } ]
  }, {
    "tStartMs": 1048600,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "이미 승리한 전쟁에 끼어드는 사람은 필요 없어요"
    } ]
  }, {
    "tStartMs": 1050570,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "야 숟가락 치워, 야 숟가락 아 어디"
    } ]
  }, {
    "tStartMs": 1052740,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "야 숟가락 에헤이"
    } ]
  }, {
    "tStartMs": 1053430,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "한 입 안 된다 한 입"
    } ]
  }, {
    "tStartMs": 1054960,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "몇 대 그냥 발사해놓고"
    } ]
  }, {
    "tStartMs": 1056290,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "나중에 동맹 이런 소리 하려고 그러지"
    } ]
  }, {
    "tStartMs": 1058020,
    "dDurationMs": 540,
    "segs": [ {
      "utf8": "안 돼"
    } ]
  }, {
    "tStartMs": 1058560,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "필요 없어 들어가"
    } ]
  }, {
    "tStartMs": 1059970,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "라고 얘기를 했고요"
    } ]
  }, {
    "tStartMs": 1061180,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "방금 말씀드렸지만"
    } ]
  }, {
    "tStartMs": 1062500,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "영국은 미국의 이란 초기 공습에 참여하지 않았어요"
    } ]
  }, {
    "tStartMs": 1065590,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "미국이 요청을 했었는데"
    } ]
  }, {
    "tStartMs": 1067200,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "트럼프 대통령이 초기 공습을 하자고"
    } ]
  }, {
    "tStartMs": 1068650,
    "dDurationMs": 650,
    "segs": [ {
      "utf8": "같이 얘기를 했는데"
    } ]
  }, {
    "tStartMs": 1069300,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "영국이 참여를 안 했습니다"
    } ]
  }, {
    "tStartMs": 1070830,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "영국의 국익을 판단하는 것이 내 의무다"
    } ]
  }, {
    "tStartMs": 1073340,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "라고 얘기하면서 참여를 안 했어요"
    } ]
  }, {
    "tStartMs": 1075330,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "그리고 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1076540,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "미국이 이란 공격하는 거"
    } ]
  }, {
    "tStartMs": 1077710,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "그거 법적 근거 없잖아"
    } ]
  }, {
    "tStartMs": 1080270,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "합법적인 근거 없잖아"
    } ]
  }, {
    "tStartMs": 1082070,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "너희 의회 승인 받았어?"
    } ]
  }, {
    "tStartMs": 1083960,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "의회 승인 안 받았잖아"
    } ]
  }, {
    "tStartMs": 1085600,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "놀랍게도 이번 전쟁은 의회 승인을 안 받았습니다"
    } ]
  }, {
    "tStartMs": 1088170,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "그래서 미국이 뭐라고 얘기합니까?"
    } ]
  }, {
    "tStartMs": 1090130,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "전쟁이라고 처음에 얘기 안 했어요"
    } ]
  }, {
    "tStartMs": 1091410,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "뭐라고 얘기했습니까?"
    } ]
  }, {
    "tStartMs": 1092440,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "특수 군사 작전"
    } ]
  }, {
    "tStartMs": 1093540,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "특수 군사 작전"
    } ]
  }, {
    "tStartMs": 1095070,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "요즘에 특수 군사 작전을 되게 많이 보는 것 같아요"
    } ]
  }, {
    "tStartMs": 1097760,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "그러니까 니들 근거 없고"
    } ]
  }, {
    "tStartMs": 1098870,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "이라크 전쟁에서 실수를 우리가 기억하기 때문에"
    } ]
  }, {
    "tStartMs": 1101060,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "그 교훈을 배웠다"
    } ]
  }, {
    "tStartMs": 1101960,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "우리는 초기 공습에 참여하지 않겠다"
    } ]
  }, {
    "tStartMs": 1104350,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "대신에 영국 기지는 사용하게 해줄게"
    } ]
  }, {
    "tStartMs": 1106970,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "키프로스에 있는 그런 기지들"
    } ]
  }, {
    "tStartMs": 1108420,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "특정하고 제한적인 방어 목적으로만 라고 얘기를 하면서"
    } ]
  }, {
    "tStartMs": 1112040,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "미국과 선을 그었죠"
    } ]
  }, {
    "tStartMs": 1113980,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "그리고 아마 여러분들이"
    } ]
  }, {
    "tStartMs": 1114820,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "언론에서 많이 보셨을 텐데"
    } ]
  }, {
    "tStartMs": 1116400,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "영국은 그래도 군사 기지는 사용하게 해줄게"
    } ]
  }, {
    "tStartMs": 1118660,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "라고 얘기했는데"
    } ]
  }, {
    "tStartMs": 1119360,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "스페인은 군사 기지 사용까지 거부했습니다"
    } ]
  }, {
    "tStartMs": 1122570,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "여기는 거부가 아니라"
    } ]
  }, {
    "tStartMs": 1124300,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "규탄을 했어요"
    } ]
  }, {
    "tStartMs": 1126140,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "미국과 이스라엘의 일방적인 군사 행동을 규탄한다"
    } ]
  }, {
    "tStartMs": 1130180,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "매우 분명하게 말씀드리겠습니다"
    } ]
  }, {
    "tStartMs": 1132040,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "미군의 스페인 기지 사용을 결코 허용하지 않을 것입니다"
    } ]
  }, {
    "tStartMs": 1135900,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "이야 스페인 대단하다"
    } ]
  }, {
    "tStartMs": 1138190,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "스페인이 어떻게 이럴 수 있었냐"
    } ]
  }, {
    "tStartMs": 1139770,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "개인 생각인데"
    } ]
  }, {
    "tStartMs": 1141110,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "진짜 개인 생각인데"
    } ]
  }, {
    "tStartMs": 1142450,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "지도를 그리면"
    } ]
  }, {
    "tStartMs": 1143600,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "유럽이 이렇게 생겼잖아요"
    } ]
  }, {
    "tStartMs": 1145480,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "여기 아래 스페인 있고"
    } ]
  }, {
    "tStartMs": 1146960,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "이렇게 이탈리아 있고"
    } ]
  }, {
    "tStartMs": 1148290,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "이렇게 생겼죠"
    } ]
  }, {
    "tStartMs": 1149250,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "아프리카고 이쪽이 러시아고 영국이고"
    } ]
  }, {
    "tStartMs": 1151520,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "스페인은 어디 있습니까?"
    } ]
  }, {
    "tStartMs": 1153150,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "여기 있죠"
    } ]
  }, {
    "tStartMs": 1154940,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "여기가 러시아잖아"
    } ]
  }, {
    "tStartMs": 1155800,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "아이고 멀다"
    } ]
  }, {
    "tStartMs": 1157240,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "여기가 이란이잖아"
    } ]
  }, {
    "tStartMs": 1158010,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "여기가 이스라엘이고"
    } ]
  }, {
    "tStartMs": 1158970,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "아이고 멀다"
    } ]
  }, {
    "tStartMs": 1160390,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "사실은 국방력, 방위력"
    } ]
  }, {
    "tStartMs": 1163140,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "이런 거에 제일 관심이 없는 나라가 스페인이에요"
    } ]
  }, {
    "tStartMs": 1165720,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "뭐 어쩌라고?"
    } ]
  }, {
    "tStartMs": 1166760,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "저 먼데 여기서 일어나는 일을"
    } ]
  }, {
    "tStartMs": 1168440,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "나 갖고 그래?"
    } ]
  }, {
    "tStartMs": 1169340,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "뭐 어떻게 할 건데 니들이?"
    } ]
  }, {
    "tStartMs": 1170780,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "라는 생각을 좀 많이 갖고 있는 나라가 스페인이 아닌가 생각이 되고"
    } ]
  }, {
    "tStartMs": 1174760,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "저 얘기를 딱 들으니까"
    } ]
  }, {
    "tStartMs": 1175930,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "트럼프 대통령이 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1177790,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "스페인처럼 형편없는 유럽 국가들도 있습니다"
    } ]
  }, {
    "tStartMs": 1181130,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "저는 스콧에게 스페인과의 모든 거래를 끊으라고 했습니다"
    } ]
  }, {
    "tStartMs": 1185810,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "여기까지는 아는데"
    } ]
  }, {
    "tStartMs": 1187040,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "그래서 진짜 스페인과의 무역을 안 할 거냐"
    } ]
  }, {
    "tStartMs": 1189620,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "스페인은 EU 소속이잖아요"
    } ]
  }, {
    "tStartMs": 1191930,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "EU하고 거래 중에"
    } ]
  }, {
    "tStartMs": 1193340,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "스페인과만 끊을 수가 있냐"
    } ]
  }, {
    "tStartMs": 1195360,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "아니면 스페인 또 관세 100% 할 거냐"
    } ]
  }, {
    "tStartMs": 1197580,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "아니면 항상 그랬듯이 홧김에 얘기하고"
    } ]
  }, {
    "tStartMs": 1201400,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "유야 무야 넘어갈 거냐"
    } ]
  }, {
    "tStartMs": 1202680,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "라는 건 모르지만"
    } ]
  }, {
    "tStartMs": 1204050,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "여기까지 얘기가 된 상태고요"
    } ]
  }, {
    "tStartMs": 1205220,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "그리고 이렇게 말씀하셨습니다"
    } ]
  }, {
    "tStartMs": 1207200,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "스페인이 그들의 기지를 사용할 수 없다고 말했더군요"
    } ]
  }, {
    "tStartMs": 1210280,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "아, that's alright 좋아요"
    } ]
  }, {
    "tStartMs": 1211640,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "하지만 우리는 그냥 비행해서 사용할 수 있어요"
    } ]
  }, {
    "tStartMs": 1215620,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "우리 비행기가 스페인 기지에 내린다는데"
    } ]
  }, {
    "tStartMs": 1218700,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "네가 어쩔 건데?"
    } ]
  }, {
    "tStartMs": 1220340,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "뭐, 네가 쓰지 말란다고"
    } ]
  }, {
    "tStartMs": 1221640,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "내가 안 써야 되나?"
    } ]
  }, {
    "tStartMs": 1223130,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "뭐, 해보든가"
    } ]
  }, {
    "tStartMs": 1224580,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "아무도 우리에게 사용하지 말라고 말할 수 없습니다"
    } ]
  }, {
    "tStartMs": 1227790,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "우리 내리는 비행기에게"
    } ]
  }, {
    "tStartMs": 1228980,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "니들이 뭐, 쏠 거야?"
    } ]
  }, {
    "tStartMs": 1230820,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "쏠 거야?"
    } ]
  }, {
    "tStartMs": 1232140,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "그 쐈다가 지금 뭐 이란 꼴이 날 수도 있죠"
    } ]
  }, {
    "tStartMs": 1236100,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "아무도 우리에게 사용하지 말아달라고 말할 수 없다"
    } ]
  }, {
    "tStartMs": 1239060,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "그럴 필요가 없어요"
    } ]
  }, {
    "tStartMs": 1239980,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "우리는 허가를 맡을 필요가 없습니다"
    } ]
  }, {
    "tStartMs": 1242290,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "라고 얘기를 했는데"
    } ]
  }, {
    "tStartMs": 1243650,
    "dDurationMs": 170,
    "segs": [ {
      "utf8": "와..."
    } ]
  }, {
    "tStartMs": 1243820,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "그래도 주권국한테 주권국하고"
    } ]
  }, {
    "tStartMs": 1245890,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "스페인이면 EU고"
    } ]
  }, {
    "tStartMs": 1247490,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "그렇게 힘이 약한 나라도 아닌데"
    } ]
  }, {
    "tStartMs": 1249130,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "니들의 허락을 받고"
    } ]
  }, {
    "tStartMs": 1250220,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "내가 써야겠냐?"
    } ]
  }, {
    "tStartMs": 1251560,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "물론 화가 나셔서"
    } ]
  }, {
    "tStartMs": 1252670,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "말만 이렇게 하셨겠지만"
    } ]
  }, {
    "tStartMs": 1254500,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "강하게 말씀하셨고요"
    } ]
  }, {
    "tStartMs": 1256330,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "또 이렇게 이야기했습니다"
    } ]
  }, {
    "tStartMs": 1257770,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "스페인과 영국은 잘 생각해라"
    } ]
  }, {
    "tStartMs": 1260130,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "니들은 대단히 매우 비협조적인 나라들이다"
    } ]
  }, {
    "tStartMs": 1263650,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "영국과 이럴 날이 올 줄은 몰랐어요"
    } ]
  }, {
    "tStartMs": 1265830,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "아니 미국과 영국이 어떤 사이입니까?"
    } ]
  }, {
    "tStartMs": 1268440,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "사실상 뭐 인종이 겹친다고 해도"
    } ]
  }, {
    "tStartMs": 1272500,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "물론 독일 출신이긴 하지만 대통령은"
    } ]
  }, {
    "tStartMs": 1275870,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "영국과 미국의 관계"
    } ]
  }, {
    "tStartMs": 1278180,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "역사적인 관계들을 생각해봤을 때"
    } ]
  }, {
    "tStartMs": 1280620,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "이렇게 어긋나는 것도"
    } ]
  }, {
    "tStartMs": 1282320,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "최근에 있었나 싶을 정도고 비협조적이다"
    } ]
  }, {
    "tStartMs": 1284820,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "그리고 또 이렇게 있습니다"
    } ]
  }, {
    "tStartMs": 1285850,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "영국은 잘 생각해라"
    } ]
  }, {
    "tStartMs": 1287090,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "정말 충격적이야 왜냐?"
    } ]
  }, {
    "tStartMs": 1288550,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "지금은 처칠 시대가 아니다"
    } ]
  }, {
    "tStartMs": 1290980,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "처칠이 있을 때가"
    } ]
  }, {
    "tStartMs": 1291720,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "영국이 제일 셌던 때죠"
    } ]
  }, {
    "tStartMs": 1293220,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "물론 그때도 미국이 더 셌지만"
    } ]
  }, {
    "tStartMs": 1294770,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "지금은 처칠처럼 하면 안 될 거야"
    } ]
  }, {
    "tStartMs": 1297030,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "라고 얘기를 했죠"
    } ]
  }, {
    "tStartMs": 1298430,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "그리고 프랑스는 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1300880,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "국제법을 위반하는 군사 작전에 대해서 반대를 표명합니다"
    } ]
  }, {
    "tStartMs": 1304810,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "우리도 미국과 이스라엘이"
    } ]
  }, {
    "tStartMs": 1306690,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "국제법을 위반하는 군사 작전을 개시했다고 생각해요"
    } ]
  }, {
    "tStartMs": 1309410,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "우리는 이를 용납할 수 없어요"
    } ]
  }, {
    "tStartMs": 1310980,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "그럼 역시 반기를 드는 겁니까?"
    } ]
  }, {
    "tStartMs": 1312890,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "그건 아니고 왜냐?"
    } ]
  }, {
    "tStartMs": 1314560,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "원인 제공은 이란이 했잖아"
    } ]
  }, {
    "tStartMs": 1315710,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "그러니까 책임은 이란이 져야 됩니다"
    } ]
  }, {
    "tStartMs": 1318480,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "응?"
    } ]
  }, {
    "tStartMs": 1319650,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "1차적인 책임은 이란에 있다는 거죠"
    } ]
  }, {
    "tStartMs": 1322270,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "그거 왜 맞을 짓을 해?"
    } ]
  }, {
    "tStartMs": 1323360,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "맞을 짓을"
    } ]
  }, {
    "tStartMs": 1323920,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "그 위험한 핵 프로그램"
    } ]
  }, {
    "tStartMs": 1325460,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "지역 대리 세력 지원"
    } ]
  }, {
    "tStartMs": 1326760,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "지난 1월 시위 진압 과정에서 자국민 4만 명 학살"
    } ]
  }, {
    "tStartMs": 1329790,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "이런 것들 말이야"
    } ]
  }, {
    "tStartMs": 1330560,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "니들이 해서 이런 게 된 거야"
    } ]
  }, {
    "tStartMs": 1332790,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "물론 트럼프 대통령이 전쟁하고"
    } ]
  }, {
    "tStartMs": 1335540,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "이스라엘도 전쟁하는데"
    } ]
  }, {
    "tStartMs": 1336380,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "국제법을 좀 어기고"
    } ]
  }, {
    "tStartMs": 1337360,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "의회 승인 안 받고 이런 건 있지만"
    } ]
  }, {
    "tStartMs": 1338720,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "어쨌건 니들이 맞을 짓을 했구만"
    } ]
  }, {
    "tStartMs": 1340310,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "니들 책임 이란에 있다"
    } ]
  }, {
    "tStartMs": 1341660,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "라고 얘기하면서"
    } ]
  }, {
    "tStartMs": 1343040,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "그래서 어쩔 수 없이"
    } ]
  }, {
    "tStartMs": 1344690,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "우리는 어쩔 수 없이"
    } ]
  }, {
    "tStartMs": 1346660,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "군대를 보내겠다"
    } ]
  }, {
    "tStartMs": 1348540,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "3월 3일 화요일날 기준으로"
    } ]
  }, {
    "tStartMs": 1350310,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "프랑스의 군사 작전 참여를 공식 발표합니다"
    } ]
  }, {
    "tStartMs": 1353650,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "철저히 방어적인 차원에서 수행하겠다"
    } ]
  }, {
    "tStartMs": 1356380,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "전쟁에 참여할 수도 있지만"
    } ]
  }, {
    "tStartMs": 1358070,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "방어적으로 하겠다 라고 하고"
    } ]
  }, {
    "tStartMs": 1359520,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "아까 말씀드린 키프로스와 동지중해로"
    } ]
  }, {
    "tStartMs": 1361830,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "현재 프랑스 항공모함 샤를 드골호가"
    } ]
  }, {
    "tStartMs": 1364980,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "진주해 있죠"
    } ]
  }, {
    "tStartMs": 1366150,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "명령을 했기 때문에"
    } ]
  }, {
    "tStartMs": 1367110,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "아마 가있지 않나 생각이 되고"
    } ]
  }, {
    "tStartMs": 1368860,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "쭉 얘기를 들어보시면 알겠지만"
    } ]
  }, {
    "tStartMs": 1371130,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "자의 반 타의 반으로 유럽 국가들이 키프로스라는 데로 모이고 있습니다"
    } ]
  }, {
    "tStartMs": 1374730,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "혹시 모르니까"
    } ]
  }, {
    "tStartMs": 1375870,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "그리고 또 이유도 있어요"
    } ]
  }, {
    "tStartMs": 1377010,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "잘 생각해보면"
    } ]
  }, {
    "tStartMs": 1378090,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "중동에서 나오는 에너지가"
    } ]
  }, {
    "tStartMs": 1379330,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "우리는 물론 호르무즈 해협"
    } ]
  }, {
    "tStartMs": 1381430,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "아니면 홍해에서 아덴만을 통해서"
    } ]
  }, {
    "tStartMs": 1382750,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "이렇게 오잖아요"
    } ]
  }, {
    "tStartMs": 1383880,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "유럽은 어디로 옵니까?"
    } ]
  }, {
    "tStartMs": 1385630,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "여기로 옵니다 동지중해"
    } ]
  }, {
    "tStartMs": 1387360,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "수에즈 운하 통과해서 이렇게"
    } ]
  }, {
    "tStartMs": 1388830,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "그러니까 여기가 유럽 입장에서는"
    } ]
  }, {
    "tStartMs": 1390840,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "물류의 핵심"
    } ]
  }, {
    "tStartMs": 1392150,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "우리는 물론 여기죠"
    } ]
  }, {
    "tStartMs": 1393410,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "우리는 여기란 말이야"
    } ]
  }, {
    "tStartMs": 1394590,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "이 위쪽으로 가는 건"
    } ]
  }, {
    "tStartMs": 1395490,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "우리하고 별로 관심 없잖아요"
    } ]
  }, {
    "tStartMs": 1396660,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "이쪽에서 내려오는 건 있어도"
    } ]
  }, {
    "tStartMs": 1398240,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "중동에서 오는 거니까"
    } ]
  }, {
    "tStartMs": 1399480,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "그러니까 우리가 지금 모든 관심이"
    } ]
  }, {
    "tStartMs": 1401750,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "호르무즈 해협에 쏠려 있는 것처럼 이쪽하고"
    } ]
  }, {
    "tStartMs": 1404290,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "이 유럽의 모든 관심은"
    } ]
  }, {
    "tStartMs": 1405930,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "또 여기에 쏠려 있을 수밖에 없죠"
    } ]
  }, {
    "tStartMs": 1407520,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "위로 오는 게 막힐까 봐"
    } ]
  }, {
    "tStartMs": 1408890,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "물론 이란은 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1410420,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "지금까지 이제 확전 가능성이 있어 보이기 때문에"
    } ]
  }, {
    "tStartMs": 1413600,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "진흙탕 싸움 그 자체로 갈 수 있어 보이니까"
    } ]
  }, {
    "tStartMs": 1416510,
    "dDurationMs": 510,
    "segs": [ {
      "utf8": "얼마 전에"
    } ]
  }, {
    "tStartMs": 1417020,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "바로 직전에 확전을 막기 위해서"
    } ]
  }, {
    "tStartMs": 1418980,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "인접 국가에 대한 공격 중단을 선언했어요"
    } ]
  }, {
    "tStartMs": 1422340,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "비긴 걸로 하자는 거죠 여기까지"
    } ]
  }, {
    "tStartMs": 1424880,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "자, 우리가 200발 쐈는데"
    } ]
  }, {
    "tStartMs": 1426380,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "오케이, 콜 미안해 거기까지"
    } ]
  }, {
    "tStartMs": 1428570,
    "dDurationMs": 670,
    "segs": [ {
      "utf8": "오케이, 콜"
    } ]
  }, {
    "tStartMs": 1429240,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "잘했다, 잘했다"
    } ]
  }, {
    "tStartMs": 1430180,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "여기까지 하자"
    } ]
  }, {
    "tStartMs": 1431420,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "미안하다니까 미안하다니까 쏘지 말고"
    } ]
  }, {
    "tStartMs": 1433010,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "반격하지 말고"
    } ]
  }, {
    "tStartMs": 1434310,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "실제로 될지 모르겠지만"
    } ]
  }, {
    "tStartMs": 1435800,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "무승부로 할래요?를 시전했습니다"
    } ]
  }, {
    "tStartMs": 1437270,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "이란의 행동으로 인해"
    } ]
  }, {
    "tStartMs": 1438100,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "피해를 입은 인접 국가들에 대해서"
    } ]
  }, {
    "tStartMs": 1439930,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "개인적으로 퍼스널리하게"
    } ]
  }, {
    "tStartMs": 1441990,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "어폴로자이즈 할 테니까"
    } ]
  }, {
    "tStartMs": 1443400,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "그만하자라고 얘기를 해서"
    } ]
  }, {
    "tStartMs": 1445520,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "사실 그만해야겠죠"
    } ]
  }, {
    "tStartMs": 1446540,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "인접 국가에 대한 공격이 계속되면"
    } ]
  }, {
    "tStartMs": 1448110,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "진짜 확전으로 갈 수도 있고"
    } ]
  }, {
    "tStartMs": 1449510,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "중동 국가들이 들어가거나"
    } ]
  }, {
    "tStartMs": 1450650,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "아까 뭐 아제르바이잔"
    } ]
  }, {
    "tStartMs": 1451860,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "무슨 파키스탄에 유럽 국가들까지 다"
    } ]
  }, {
    "tStartMs": 1454400,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "만약에"
    } ]
  }, {
    "tStartMs": 1455410,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "이란으로 지상군이 들어가던가 하면 헬이죠 헬"
    } ]
  }, {
    "tStartMs": 1458960,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "그건 헬이기 때문에"
    } ]
  }, {
    "tStartMs": 1460220,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "그런 게 없이 지나가야 되지 않을까 생각을 합니다"
    } ]
  }, {
    "tStartMs": 1462520,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "또 우리한테 가장 관심 많은 거"
    } ]
  }, {
    "tStartMs": 1464940,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "이란의 호르무즈 해협 봉쇄는 어떻게 됐냐"
    } ]
  }, {
    "tStartMs": 1467930,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "이미 3월 2일자"
    } ]
  }, {
    "tStartMs": 1469020,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "좀 지난 거긴 한데"
    } ]
  }, {
    "tStartMs": 1470130,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "그때 한번 보여드렸죠"
    } ]
  }, {
    "tStartMs": 1471000,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "이란의 국영 매체가 해협을 폐쇄할 걸 선언을 했습니다"
    } ]
  }, {
    "tStartMs": 1474340,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "혁명수비대와 정규 해군의 영웅들이"
    } ]
  }, {
    "tStartMs": 1476320,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "선박을 불태워버릴 것이다"
    } ]
  }, {
    "tStartMs": 1478620,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "그러면서 실제로 단 한 방울의 석유도 빠져나가지 못하게 할 거고"
    } ]
  }, {
    "tStartMs": 1482700,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "유가를 며칠 안에 배럴당 200달러로 만들어버리겠다라고"
    } ]
  }, {
    "tStartMs": 1486130,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "협박을 했죠"
    } ]
  }, {
    "tStartMs": 1487620,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "왜 거기를 막냐?"
    } ]
  }, {
    "tStartMs": 1488360,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "그랬더니 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1489640,
    "dDurationMs": 3890,
    "segs": [ {
      "utf8": "미국이 중동 석유를 한 방울도 얻지 못하게 만들려고"
    } ]
  }, {
    "tStartMs": 1493530,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "미국은 부채가 엄청 커"
    } ]
  }, {
    "tStartMs": 1494820,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "그리고 중동 석유에 의존하고 있어"
    } ]
  }, {
    "tStartMs": 1496890,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "하지만 단 한 방울의 석유도"
    } ]
  }, {
    "tStartMs": 1498320,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "미국으로 가지 못할 것을 알아야 된다"
    } ]
  }, {
    "tStartMs": 1500320,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "라고 얘기를 했는데"
    } ]
  }, {
    "tStartMs": 1501860,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "숫자를 보면"
    } ]
  }, {
    "tStartMs": 1503020,
    "dDurationMs": 4010,
    "segs": [ {
      "utf8": "막상 미국은 중동 석유 의존도가 대단히 낮습니다"
    } ]
  }, {
    "tStartMs": 1507030,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "미국이 세계 최대의 석유 생산 국가고요"
    } ]
  }, {
    "tStartMs": 1509950,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "미국은 석유 대부분을 어디서 수입하냐?"
    } ]
  }, {
    "tStartMs": 1511750,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "물론 수입도 하죠"
    } ]
  }, {
    "tStartMs": 1513050,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "캐나다에서 해요"
    } ]
  }, {
    "tStartMs": 1514180,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "52%입니다"
    } ]
  }, {
    "tStartMs": 1515680,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "걸프에서 나오는 거는"
    } ]
  }, {
    "tStartMs": 1517380,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "10%가 안 돼"
    } ]
  }, {
    "tStartMs": 1518430,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "사실 거길 막으면"
    } ]
  }, {
    "tStartMs": 1519970,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "미국은 뭐 별... 뭐래?"
    } ]
  }, {
    "tStartMs": 1522260,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "별 그게 없어요"
    } ]
  }, {
    "tStartMs": 1524530,
    "dDurationMs": 540,
    "segs": [ {
      "utf8": "별 그게 없고"
    } ]
  }, {
    "tStartMs": 1525070,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "대신에 별 그게 있는 데도 있죠"
    } ]
  }, {
    "tStartMs": 1526690,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "그건 어디입니까?"
    } ]
  }, {
    "tStartMs": 1528000,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "첫 번째가 유럽"
    } ]
  }, {
    "tStartMs": 1530170,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "유럽은 왜냐?"
    } ]
  }, {
    "tStartMs": 1530730,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "거길 통해서 천연가스를 운송하고 해요"
    } ]
  }, {
    "tStartMs": 1532900,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "이렇게 해서 이렇게 유럽으로 돌아다녀요"
    } ]
  }, {
    "tStartMs": 1535000,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "또 자꾸 드론을 날리니까"
    } ]
  }, {
    "tStartMs": 1537050,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "천연가스 기업들이나"
    } ]
  }, {
    "tStartMs": 1538440,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "아니면 유전들이 가동을 정지하죠"
    } ]
  }, {
    "tStartMs": 1540940,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "지금 유럽의 천연가스 가격이 50%가 폭등했습니다"
    } ]
  }, {
    "tStartMs": 1544640,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "보여드리면 이래요"
    } ]
  }, {
    "tStartMs": 1545960,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "유럽 천연가스 가격인데"
    } ]
  }, {
    "tStartMs": 1547660,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "우크라이나 러시아 전쟁 당시에는 가격이 이렇게 갔습니다"
    } ]
  }, {
    "tStartMs": 1551000,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "아직 보이지도 않은 데까지 갔는데"
    } ]
  }, {
    "tStartMs": 1552720,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "아직은 여기까지만 왔어요 50%"
    } ]
  }, {
    "tStartMs": 1555490,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "당시에는 몇백 퍼센트가 올랐죠"
    } ]
  }, {
    "tStartMs": 1557550,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "그래서 에너지 가격의 악몽이"
    } ]
  }, {
    "tStartMs": 1559610,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "지금 유럽을 다시 덮치고 있기 때문에"
    } ]
  }, {
    "tStartMs": 1561030,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "유럽 국가들이 그쪽으로 항공모함을 보내고"
    } ]
  }, {
    "tStartMs": 1563880,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "뭔가 안전을 확보하려는 게"
    } ]
  }, {
    "tStartMs": 1565720,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "역시 본인들도 다 목적이 있다고 보시면 되고요"
    } ]
  }, {
    "tStartMs": 1568440,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "그리고 호르무즈 해협하면"
    } ]
  }, {
    "tStartMs": 1569510,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "역시 가장 관련 있는 건 아시아입니다 아시아"
    } ]
  }, {
    "tStartMs": 1572450,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "다 아시겠지만"
    } ]
  }, {
    "tStartMs": 1573500,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "이 전체 중에서 거의 80% 이상이 아시아로 와요"
    } ]
  }, {
    "tStartMs": 1577500,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "LNG의 80% 이상이 아시아로 오고"
    } ]
  }, {
    "tStartMs": 1580280,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "석유의 거의 90%가 아시아로 옵니다"
    } ]
  }, {
    "tStartMs": 1583340,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "아시아는 누굽니까?"
    } ]
  }, {
    "tStartMs": 1584650,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "일본, 한국, 그리고 중국"
    } ]
  }, {
    "tStartMs": 1587370,
    "dDurationMs": 3830,
    "segs": [ {
      "utf8": "일본과 한국은 원유 수입 60% 이상이 호르무즈를 통과한다"
    } ]
  }, {
    "tStartMs": 1591200,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "중국도 통과를 하는데"
    } ]
  }, {
    "tStartMs": 1592770,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "제가 갖고 오지는 않았는데"
    } ]
  }, {
    "tStartMs": 1593770,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "중국은 놀랍게도"
    } ]
  }, {
    "tStartMs": 1595810,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "이란한테 가서 이야기를 하고 있다는 뉴스가 나오고 있어요"
    } ]
  }, {
    "tStartMs": 1598410,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "우리 배는 봐달라고"
    } ]
  }, {
    "tStartMs": 1600300,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "근데 거기를..."
    } ]
  }, {
    "tStartMs": 1601540,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "미사일로 막는다 그러는데"
    } ]
  }, {
    "tStartMs": 1602720,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "우리 배 봐달라가 될까?"
    } ]
  }, {
    "tStartMs": 1604520,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "개인적으로는 될까 싶어요"
    } ]
  }, {
    "tStartMs": 1605640,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "거기를 아무리 봐준다 그래도 통과할 수 있을까?"
    } ]
  }, {
    "tStartMs": 1608980,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "거기 미사일과 장거리포로 막는다 그러는데"
    } ]
  }, {
    "tStartMs": 1612350,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "이거잖아요"
    } ]
  }, {
    "tStartMs": 1613260,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "중국 국기 크게 들고"
    } ]
  }, {
    "tStartMs": 1614730,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "우리는 중국이야 하면서"
    } ]
  }, {
    "tStartMs": 1615690,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "통과하는 그거"
    } ]
  }, {
    "tStartMs": 1616730,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "중국인은 건들지 마"
    } ]
  }, {
    "tStartMs": 1617710,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "이런 영화 있었잖아 옛날에 뭐였더라?"
    } ]
  }, {
    "tStartMs": 1619680,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "유엔 상임이사국 중국을 건들지 마라"
    } ]
  }, {
    "tStartMs": 1622140,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "이런 게 있었는데"
    } ]
  }, {
    "tStartMs": 1623290,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "그렇다고 거기를 그걸 받고"
    } ]
  }, {
    "tStartMs": 1625020,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "이걸 하고 통과한다고"
    } ]
  }, {
    "tStartMs": 1626230,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "그게 통과가 될지는 모르겠지만"
    } ]
  }, {
    "tStartMs": 1628190,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "하여튼 협상을 시도한다는 말이 나오고 있고"
    } ]
  }, {
    "tStartMs": 1630400,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "일본이나 한국, 우리나라나 일본은 원유 수입이 저기 통과하니까"
    } ]
  }, {
    "tStartMs": 1634330,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "그 덕분인지 몰라도"
    } ]
  }, {
    "tStartMs": 1635480,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "조금 이따가 나오겠지만"
    } ]
  }, {
    "tStartMs": 1636800,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "코스피가"
    } ]
  }, {
    "tStartMs": 1639620,
    "dDurationMs": 550,
    "segs": [ {
      "utf8": "농담이 아니라"
    } ]
  }, {
    "tStartMs": 1640170,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "처음 들었을 때 찍은 사진입니다"
    } ]
  }, {
    "tStartMs": 1641610,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "마이너스 10% 처음 들었을 때"
    } ]
  }, {
    "tStartMs": 1644260,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "자고 일어난 장면이거든요"
    } ]
  }, {
    "tStartMs": 1645570,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "자고 일어나서 옷 입고 나가려는데"
    } ]
  }, {
    "tStartMs": 1646820,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "잠깐 보니까"
    } ]
  }, {
    "tStartMs": 1647420,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "마이너스 10%"
    } ]
  }, {
    "tStartMs": 1648390,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "2일간 20%가 빠졌어요"
    } ]
  }, {
    "tStartMs": 1650180,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "아니 미국을 막는다더니"
    } ]
  }, {
    "tStartMs": 1652080,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "왜 우리를 막아서"
    } ]
  }, {
    "tStartMs": 1653800,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "조금 이따 얘기하겠습니다"
    } ]
  }, {
    "tStartMs": 1655040,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "미국은 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1656680,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "미국 에너지부 장관인데요"
    } ]
  }, {
    "tStartMs": 1658050,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "에너지 가격이 뛰면 곤란합니다"
    } ]
  }, {
    "tStartMs": 1659480,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "대책은 없나요? 그랬더니"
    } ]
  }, {
    "tStartMs": 1660800,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "뭐라고 말씀하셨냐?"
    } ]
  }, {
    "tStartMs": 1662210,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "크리스 라이트죠"
    } ]
  }, {
    "tStartMs": 1663060,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "폭스뉴스에서 일시적이다 템퍼러리하다"
    } ]
  }, {
    "tStartMs": 1667140,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "일시적이야 참아"
    } ]
  }, {
    "tStartMs": 1668420,
    "dDurationMs": 630,
    "segs": [ {
      "utf8": "금리도 일시적이야"
    } ]
  }, {
    "tStartMs": 1669050,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "물가 일시적이지"
    } ]
  }, {
    "tStartMs": 1669930,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "몇 달이면 돼"
    } ]
  }, {
    "tStartMs": 1671260,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "아까 4, 5주 얘기했잖아"
    } ]
  }, {
    "tStartMs": 1672330,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "일시적이야 일시적"
    } ]
  }, {
    "tStartMs": 1673440,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "그럼 영구히 가겠니?"
    } ]
  }, {
    "tStartMs": 1674690,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "잠깐 오르고 내려가고 하겠지"
    } ]
  }, {
    "tStartMs": 1676420,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "며칠일지 몇 주일지 모르지만"
    } ]
  }, {
    "tStartMs": 1678410,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "일시적이니까 괜찮아 괜찮아"
    } ]
  }, {
    "tStartMs": 1680050,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "일시적일 뿐이고요"
    } ]
  }, {
    "tStartMs": 1680860,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "영구적이 아니야"
    } ]
  }, {
    "tStartMs": 1681890,
    "dDurationMs": 3610,
    "segs": [ {
      "utf8": "그리고 전세계는 매우 원유의 충분한 공급을 받고 있고"
    } ]
  }, {
    "tStartMs": 1685500,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "세계 곳곳에는 원유가 풍부해"
    } ]
  }, {
    "tStartMs": 1687730,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "캐나다에도 많아"
    } ]
  }, {
    "tStartMs": 1688840,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "미국의 생산량도 많아"
    } ]
  }, {
    "tStartMs": 1690700,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "그러니까 우린 괜찮아"
    } ]
  }, {
    "tStartMs": 1692190,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "이거는 그냥 작은 범핑일 뿐이야"
    } ]
  }, {
    "tStartMs": 1694590,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "작은 충격일 뿐이야"
    } ]
  }, {
    "tStartMs": 1696030,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "그 정도 쭐렁쭐렁 할 수는 있지"
    } ]
  }, {
    "tStartMs": 1698080,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "우리는 괜찮아"
    } ]
  }, {
    "tStartMs": 1699750,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "너희들이 문제지"
    } ]
  }, {
    "tStartMs": 1700960,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "야, 우린 괜찮아"
    } ]
  }, {
    "tStartMs": 1701900,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "야, 우리는 우리는"
    } ]
  }, {
    "tStartMs": 1702840,
    "dDurationMs": 460,
    "segs": [ {
      "utf8": "문제 없어"
    } ]
  }, {
    "tStartMs": 1703300,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "10%도 안 돼"
    } ]
  }, {
    "tStartMs": 1704120,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "그 정도는 뭐"
    } ]
  }, {
    "tStartMs": 1704760,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "아, 한국, 일본은요?"
    } ]
  }, {
    "tStartMs": 1706060,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "아, 그건 뭐"
    } ]
  }, {
    "tStartMs": 1707330,
    "dDurationMs": 580,
    "segs": [ {
      "utf8": "문제가 너희들이죠"
    } ]
  }, {
    "tStartMs": 1707910,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "그럼 뭐 알아서 하고"
    } ]
  }, {
    "tStartMs": 1708880,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "문제가 없고요"
    } ]
  }, {
    "tStartMs": 1710380,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "자, 그리고 지난 20년 동안"
    } ]
  }, {
    "tStartMs": 1712480,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "지구상 그 어떤 나라보다도 더 많은 미국 병사를 죽인 이란"
    } ]
  }, {
    "tStartMs": 1716060,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "그런 데를 딱 제거하기 위해서"
    } ]
  }, {
    "tStartMs": 1717520,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "치른 대가치고는 매우 작아"
    } ]
  }, {
    "tStartMs": 1719930,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "스몰 프라이스야"
    } ]
  }, {
    "tStartMs": 1720810,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "그 정도 대가는 치를 수 있지"
    } ]
  }, {
    "tStartMs": 1722560,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "우리는 큰데요?"
    } ]
  }, {
    "tStartMs": 1723320,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "아, 니들은 크지"
    } ]
  }, {
    "tStartMs": 1724960,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "근데 미국은 작아"
    } ]
  }, {
    "tStartMs": 1725840,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "작은 대가니까 별 문제가 없다라고 말씀을 하셨고요"
    } ]
  }, {
    "tStartMs": 1729710,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "지금은 호르무즈 해협이 사실상 봉쇄가 됐기 때문에"
    } ]
  }, {
    "tStartMs": 1732570,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "선박 통행량이 거의 0으로 줄었습니다"
    } ]
  }, {
    "tStartMs": 1735660,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "지금 누가 통과하겠어요, 저기를"
    } ]
  }, {
    "tStartMs": 1737540,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "진짜 목숨 걸고 통과해야 되는 거 아니야"
    } ]
  }, {
    "tStartMs": 1739010,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "미사일 날아오면 어떡해"
    } ]
  }, {
    "tStartMs": 1740220,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "실제로 호르무즈 해협을 통과하는 유조선들이"
    } ]
  }, {
    "tStartMs": 1742310,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "공격을 받았다는 얘기들이 나오고 있어요"
    } ]
  }, {
    "tStartMs": 1744050,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "사실상 제로다"
    } ]
  }, {
    "tStartMs": 1745390,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "지금까지도 거의 제로로 유지하고 있죠"
    } ]
  }, {
    "tStartMs": 1747930,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "물론 이런 와중에 놀라운 배가 하나 있었죠"
    } ]
  }, {
    "tStartMs": 1750330,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "여기도 보셨죠?"
    } ]
  }, {
    "tStartMs": 1751410,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "재빠르게 해협을 통과한 일부 선박이 있다"
    } ]
  }, {
    "tStartMs": 1754170,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "토요일에 해협을 폐쇄했는데"
    } ]
  }, {
    "tStartMs": 1756280,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "미국과 이스라엘이 공격까지 했는데"
    } ]
  }, {
    "tStartMs": 1758040,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "일부 선박이 눈치를 보더니"
    } ]
  }, {
    "tStartMs": 1760150,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "에라이 하고 달렸다는 거죠"
    } ]
  }, {
    "tStartMs": 1761990,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "눈치 게임 장난 아닌데"
    } ]
  }, {
    "tStartMs": 1763450,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "눈치 슉슉슉 보더니"
    } ]
  }, {
    "tStartMs": 1764940,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "남들은 안 되겠다고"
    } ]
  }, {
    "tStartMs": 1766030,
    "dDurationMs": 510,
    "segs": [ {
      "utf8": "뒤로 가는데"
    } ]
  }, {
    "tStartMs": 1766540,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "마지막에 점프해서"
    } ]
  }, {
    "tStartMs": 1768870,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "왔다는 배가 있습니다"
    } ]
  }, {
    "tStartMs": 1771820,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "거기가 어딘가 봤더니"
    } ]
  }, {
    "tStartMs": 1774050,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "놀랍게도 한국 배더라"
    } ]
  }, {
    "tStartMs": 1776710,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "한국인들 대단합니다"
    } ]
  }, {
    "tStartMs": 1777950,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "그 와중에 달려왔고"
    } ]
  }, {
    "tStartMs": 1781950,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "인터뷰 나온 거 보면"
    } ]
  }, {
    "tStartMs": 1782840,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "이렇게 얘기합니다"
    } ]
  }, {
    "tStartMs": 1783980,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "어려운 항해 환경 속에서도 해당 위협을 통과해야겠다고 판단했다"
    } ]
  }, {
    "tStartMs": 1788270,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "판단력이"
    } ]
  }, {
    "tStartMs": 1789700,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "여기는 어? 어? 어? 그랬는데"
    } ]
  }, {
    "tStartMs": 1792100,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "달려갔고"
    } ]
  }, {
    "tStartMs": 1794700,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "통과했잖아 살았죠?"
    } ]
  }, {
    "tStartMs": 1796100,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "네 살았어요"
    } ]
  }, {
    "tStartMs": 1796830,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "뭐 괜찮잖아"
    } ]
  }, {
    "tStartMs": 1797450,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "침몰 안 당했죠?"
    } ]
  }, {
    "tStartMs": 1798260,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "네 안 당했어요"
    } ]
  }, {
    "tStartMs": 1799170,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "여기를 이렇게"
    } ]
  }, {
    "tStartMs": 1801490,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "살았어 살았어"
    } ]
  }, {
    "tStartMs": 1803210,
    "dDurationMs": 4630,
    "segs": [ {
      "utf8": "336m짜리 30만 톤급 대형 유조선인데 336m면"
    } ]
  }, {
    "tStartMs": 1807840,
    "dDurationMs": 4070,
    "segs": [ {
      "utf8": "그걸 그 등치로 위치를 보니까"
    } ]
  }, {
    "tStartMs": 1811910,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "이란에서 최대한 멀리 떨어져서"
    } ]
  }, {
    "tStartMs": 1813760,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "해안으로 붙어서 이렇게 온 거잖아요"
    } ]
  }, {
    "tStartMs": 1816290,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "대단하십니다"
    } ]
  }, {
    "tStartMs": 1818200,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "대단하세요"
    } ]
  }, {
    "tStartMs": 1819130,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "자동차 운전도 저렇게 하기 싶지 않은데"
    } ]
  }, {
    "tStartMs": 1821100,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "그걸 또 드리프트를 하셔서"
    } ]
  }, {
    "tStartMs": 1823050,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "빠르게 하여튼 통과를 했고요"
    } ]
  }, {
    "tStartMs": 1825730,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "참고로 그 트럼프 대통령은"
    } ]
  }, {
    "tStartMs": 1827880,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "필요시 유조선 호송을 시작하겠다 미 해군으로"
    } ]
  }, {
    "tStartMs": 1830630,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "이렇게 얘기를 했는데 쉽지 않죠"
    } ]
  }, {
    "tStartMs": 1832370,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "그래도"
    } ]
  }, {
    "tStartMs": 1833110,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "저기를 누가 무슨 배짱으로"
    } ]
  }, {
    "tStartMs": 1834510,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "물론 우리 한국인들은 있지만"
    } ]
  }, {
    "tStartMs": 1836250,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "통과를 할 거며"
    } ]
  }, {
    "tStartMs": 1837290,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "보험을 받아야 되는데"
    } ]
  }, {
    "tStartMs": 1838350,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "지금 보험을 줄 리가 없잖아요"
    } ]
  }, {
    "tStartMs": 1840100,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "3월 4일 기준으로도"
    } ]
  }, {
    "tStartMs": 1841200,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "보험료가 12배가 올랐다는 말이 있습니다"
    } ]
  }, {
    "tStartMs": 1843180,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "0.25%에서 3%까지 12배가 올랐는데"
    } ]
  }, {
    "tStartMs": 1845800,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "지금은 또 날짜가 더 지났기 때문에"
    } ]
  }, {
    "tStartMs": 1847260,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "얼마나 오를지"
    } ]
  }, {
    "tStartMs": 1848540,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "보험료가 저렇게 높은 상황에서"
    } ]
  }, {
    "tStartMs": 1849900,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "저기를 보험 없이 통과할 수도 없고"
    } ]
  }, {
    "tStartMs": 1852110,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "통과하려는 사람들이 거의 없지 않을까 생각이 되고"
    } ]
  }, {
    "tStartMs": 1854840,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "유가가 지금 어떻게 됐냐"
    } ]
  }, {
    "tStartMs": 1856410,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "90달러입니다 90달러"
    } ]
  }, {
    "tStartMs": 1857830,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "WTI 기준 90달러인데"
    } ]
  }, {
    "tStartMs": 1860600,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "전쟁이 길어지면"
    } ]
  }, {
    "tStartMs": 1861870,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "이게 진짜 100달러 갈 수도 있죠"
    } ]
  }, {
    "tStartMs": 1863770,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "60달러 선에서 지금 50% 가까이 뛰었습니다"
    } ]
  }, {
    "tStartMs": 1866530,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "내려와야죠"
    } ]
  }, {
    "tStartMs": 1867940,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "내려오지 않으면"
    } ]
  }, {
    "tStartMs": 1868960,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "원유 부족이 물론 시간이 있지만"
    } ]
  }, {
    "tStartMs": 1870850,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "현실화 되지 않게 빨리 해결해야 되지 않나 생각이 되고"
    } ]
  }, {
    "tStartMs": 1873470,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "아까 말씀드렸지만"
    } ]
  }, {
    "tStartMs": 1874330,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "놀랍게도 인도양 건너고"
    } ]
  }, {
    "tStartMs": 1875750,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "저기 아시아를 건너고"
    } ]
  }, {
    "tStartMs": 1876740,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "동쪽 끝에 있는 한 나라는"
    } ]
  }, {
    "tStartMs": 1878090,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "이 가격을 실시간으로 반영했죠"
    } ]
  }, {
    "tStartMs": 1880220,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "ㅎㅎㅎㅎ"
    } ]
  }, {
    "tStartMs": 1881660,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "현지 가격이 오르니까"
    } ]
  }, {
    "tStartMs": 1882460,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "바다 건너 저기 있는데"
    } ]
  }, {
    "tStartMs": 1883570,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "아직 그 원유가 도착은 못했지만"
    } ]
  }, {
    "tStartMs": 1885230,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "석유 가격은 6G 속도로"
    } ]
  }, {
    "tStartMs": 1887310,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "거의 뭐 인공위성을 통해서"
    } ]
  }, {
    "tStartMs": 1889090,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "스타링크를 통해서"
    } ]
  }, {
    "tStartMs": 1890730,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "원유 가격을 받은 다음에"
    } ]
  }, {
    "tStartMs": 1892100,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "바로 인상을 했습니다"
    } ]
  }, {
    "tStartMs": 1894330,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "오를 때"
    } ]
  }, {
    "tStartMs": 1894730,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "그 속도로 인상을 했으니까"
    } ]
  }, {
    "tStartMs": 1896180,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "내려가면 선물 가격이 내려가면"
    } ]
  }, {
    "tStartMs": 1897570,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "그 속도로 내려가야 되지 않나 생각을 합니다"
    } ]
  }, {
    "tStartMs": 1900620,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "아마 그렇게 되지 않을까 생각을 하고요"
    } ]
  }, {
    "tStartMs": 1903010,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "그런데 아까 제가 말씀드렸지만"
    } ]
  }, {
    "tStartMs": 1904830,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "이번 전쟁은 의회 승인을 안 받았죠"
    } ]
  }, {
    "tStartMs": 1907520,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "그래서 미국 국방부 대변인은 이렇게 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1910070,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "이거는 이스라엘의 작전이야"
    } ]
  }, {
    "tStartMs": 1912350,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "이스라엘의 군사 작전일 뿐이야"
    } ]
  }, {
    "tStartMs": 1914460,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "미국 행정부는 하메네이 죽인 사망 사건하고 무관해"
    } ]
  }, {
    "tStartMs": 1918120,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "특수 군사 작전이야"
    } ]
  }, {
    "tStartMs": 1919820,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "지금은 전쟁하잖아요?"
    } ]
  }, {
    "tStartMs": 1920700,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "아, 그거는 어쩔 수 없었지"
    } ]
  }, {
    "tStartMs": 1922790,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "왜냐하면 이스라엘이 단독으로 공격을 했는데"
    } ]
  }, {
    "tStartMs": 1926140,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "이란이 보복을 해서"
    } ]
  }, {
    "tStartMs": 1927360,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "미군을 겨냥해"
    } ]
  }, {
    "tStartMs": 1929130,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "그래서 어쩔 수 없이"
    } ]
  }, {
    "tStartMs": 1930200,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "미군이 행동에 나선 것일 뿐이야"
    } ]
  }, {
    "tStartMs": 1932580,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "아니, 이스라엘이 작전을 했어"
    } ]
  }, {
    "tStartMs": 1933750,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "그런데 이란이 쏴"
    } ]
  }, {
    "tStartMs": 1935040,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "그래서 어쩔 수 없이"
    } ]
  }, {
    "tStartMs": 1935900,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "미국이 개입했다는 거죠"
    } ]
  }, {
    "tStartMs": 1937460,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "그러기 때문에"
    } ]
  }, {
    "tStartMs": 1938360,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "미군이 먼저 이렇게 이렇게 한 건 아니어서"
    } ]
  }, {
    "tStartMs": 1940960,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "트럼프 대통령은 우리가 먼저했어라고 얘기하지만"
    } ]
  }, {
    "tStartMs": 1943490,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "하여튼 이론적으로는 그런 겁니다 논리적으로는"
    } ]
  }, {
    "tStartMs": 1946310,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "이론적으로는 그래서"
    } ]
  }, {
    "tStartMs": 1947680,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "우리는 어쩔 수 없이 개입하게 됐고요"
    } ]
  }, {
    "tStartMs": 1950740,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "그러면 미국 의회에서 전쟁을 막으면 되지 않냐"
    } ]
  }, {
    "tStartMs": 1953640,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "실제로 대통령의 전쟁 권한을 막아보자는 법안이 발의됐습니다"
    } ]
  }, {
    "tStartMs": 1956940,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "민주당을 중심으로"
    } ]
  }, {
    "tStartMs": 1958200,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "트럼프와 피터 헤그세스가"
    } ]
  }, {
    "tStartMs": 1959440,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "또다시 우리를 전쟁으로 몰아넣는 걸 용납하겠습니까?"
    } ]
  }, {
    "tStartMs": 1962300,
    "dDurationMs": 510,
    "segs": [ {
      "utf8": "이게 어떻게 됐냐"
    } ]
  }, {
    "tStartMs": 1962810,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "부결됐습니다"
    } ]
  }, {
    "tStartMs": 1965410,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "이란에 대한 전쟁을 멈추자는 초당적 결의안이"
    } ]
  }, {
    "tStartMs": 1968660,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "미국 상원에서 부결됐어요"
    } ]
  }, {
    "tStartMs": 1970180,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "와"
    } ]
  }, {
    "tStartMs": 1971970,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "이스라엘이 세지 않나 생각이 되고"
    } ]
  }, {
    "tStartMs": 1973600,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "그리고 미국은 현재 우리의 탄약은 무제한이라고 얘기하고 있습니다"
    } ]
  }, {
    "tStartMs": 1977100,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "우리의 전력은 압도적이며"
    } ]
  }, {
    "tStartMs": 1978460,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "파트너들도 하나하나 합류하고 있다"
    } ]
  }, {
    "tStartMs": 1980840,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "우리의 탄약은 무제한이다"
    } ]
  }, {
    "tStartMs": 1982750,
    "dDurationMs": 520,
    "segs": [ {
      "utf8": "아까 얘기했죠?"
    } ]
  }, {
    "tStartMs": 1983270,
    "dDurationMs": 4370,
    "segs": [ {
      "utf8": "트럼프 대통령은 작전이 4~5주 정도 걸릴 것으로 예상했다"
    } ]
  }, {
    "tStartMs": 1987640,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "이란 내에서 진짜 민중 봉기라든지"
    } ]
  }, {
    "tStartMs": 1989520,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "아니면 쿠데타 같은 게 일어나서"
    } ]
  }, {
    "tStartMs": 1990900,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "빠르게 정권이 바뀌지 않으면"
    } ]
  }, {
    "tStartMs": 1993150,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "한 달..."
    } ]
  }, {
    "tStartMs": 1994820,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "한 달 긴데?"
    } ]
  }, {
    "tStartMs": 1995980,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "한 달이 긴 이유는"
    } ]
  }, {
    "tStartMs": 1998010,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "원유 가격도 있고"
    } ]
  }, {
    "tStartMs": 1999320,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "당장 물려있는..."
    } ]
  }, {
    "tStartMs": 2000290,
    "dDurationMs": 480,
    "segs": [ {
      "utf8": "죄송합니다"
    } ]
  }, {
    "tStartMs": 2001540,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "신성한 얘기를 하는데"
    } ]
  }, {
    "tStartMs": 2002720,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "자꾸 주식 얘기를 해서 죄송하지만"
    } ]
  }, {
    "tStartMs": 2004660,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "여러 가지가 걸려있는데"
    } ]
  }, {
    "tStartMs": 2006140,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "그보다 훨씬 더 오래 걸릴 수 있다고 얘기했기 때문에"
    } ]
  }, {
    "tStartMs": 2008640,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "장기전이 되면 안 되겠는데"
    } ]
  }, {
    "tStartMs": 2010820,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "그럴 가능성도 살짝 보이지 않나 생각하고요"
    } ]
  }, {
    "tStartMs": 2013320,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "마지막으로 트럼프 대통령은"
    } ]
  }, {
    "tStartMs": 2014980,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "재선 이후에"
    } ]
  }, {
    "tStartMs": 2015930,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "현재까지 무려 8개국에 대한 공격을 승인했습니다"
    } ]
  }, {
    "tStartMs": 2019600,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "재선 이후에"
    } ]
  }, {
    "tStartMs": 2020620,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "재선 작년에 했어요"
    } ]
  }, {
    "tStartMs": 2021860,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "1년 조금 더 지났죠"
    } ]
  }, {
    "tStartMs": 2023130,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "그중에 3개 국가는"
    } ]
  }, {
    "tStartMs": 2024130,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "미국이 전에 직접 공격한 적이 없는 나라예요"
    } ]
  }, {
    "tStartMs": 2026230,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "이란, 이라크, 베네수엘라, 시리아, 예멘, 소말리아, 에콰도르"
    } ]
  }, {
    "tStartMs": 2029030,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "베네수엘라를 공격했는데"
    } ]
  }, {
    "tStartMs": 2030560,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "2025년 한 해 동안"
    } ]
  }, {
    "tStartMs": 2032450,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "미국의 공습 횟수는"
    } ]
  }, {
    "tStartMs": 2033770,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "바이든의 4년보다 많았어요"
    } ]
  }, {
    "tStartMs": 2035290,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "노벨 평화상..."
    } ]
  }, {
    "tStartMs": 2037700,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "트럼프 대통령이 보통 바이든이 협상 능력이 없어서"
    } ]
  }, {
    "tStartMs": 2041050,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "전쟁으로 문제를 해결하려고 한다라는 얘기를 많이 하셨거든요"
    } ]
  }, {
    "tStartMs": 2044430,
    "dDurationMs": 4250,
    "segs": [ {
      "utf8": "그런데 1년이 바이든의 4년보다 많았다"
    } ]
  }, {
    "tStartMs": 2048680,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "그리고 아직 끝나지 않아 보이는 게"
    } ]
  }, {
    "tStartMs": 2051100,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "여러분들 보셨겠지만"
    } ]
  }, {
    "tStartMs": 2052630,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "트럼프 대통령 얼마 전에 쿠바 얘기를 꺼냈습니다"
    } ]
  }, {
    "tStartMs": 2055920,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "쿠바가 곧 무너질 거다"
    } ]
  }, {
    "tStartMs": 2058330,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "쿠바는 협상을 간절히 원하고 있어"
    } ]
  }, {
    "tStartMs": 2061050,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "이란은 협상을 간절히 원하고 있어"
    } ]
  }, {
    "tStartMs": 2063180,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "하지만 협상이 안 돼서"
    } ]
  }, {
    "tStartMs": 2064270,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "이란을 쳤죠"
    } ]
  }, {
    "tStartMs": 2065230,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "쿠바는 곧 무너질 거야"
    } ]
  }, {
    "tStartMs": 2066500,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "쿠바는 간절히 협상을 원하고 있어"
    } ]
  }, {
    "tStartMs": 2068730,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "아 이제서야 쿠바 문제가"
    } ]
  }, {
    "tStartMs": 2070660,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "제 손에 들어올 수 있을 것 같습니다"
    } ]
  }, {
    "tStartMs": 2072430,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "우리는 아주 잘해내고 있습니다"
    } ]
  }, {
    "tStartMs": 2074620,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "라고 얘기를 했는데"
    } ]
  }, {
    "tStartMs": 2075500,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "쿠바는 서반구죠"
    } ]
  }, {
    "tStartMs": 2077700,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "그러면 본인들이 이제 혼낸다고 생각할 테니까"
    } ]
  }, {
    "tStartMs": 2080060,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "8개가 9개가 될 수도 있는"
    } ]
  }, {
    "tStartMs": 2082960,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "그런 상황에 있는 게 아닌가 생각되고"
    } ]
  }, {
    "tStartMs": 2084410,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "그냥 노벨 평화상을 생각하신다면"
    } ]
  }, {
    "tStartMs": 2086330,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "내년도에 받으셔야 될 거 아니에요?"
    } ]
  }, {
    "tStartMs": 2087880,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "노벨 평화상을 생각하신다면"
    } ]
  }, {
    "tStartMs": 2089540,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "빨리 전쟁 끝내고"
    } ]
  }, {
    "tStartMs": 2090800,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "평화가 와야 되지 않을까 생각을 합니다"
    } ]
  } ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audit_status.schema.json",
  "title": "Audit Status",
  "description": "Production audit record: tracks manual audit pass/fail per block.",
  "type": "object",
  "required": [
    "work_id",
    "last_audit_block",
    "audit_pass",
    "audit_date",
    "issues",
    "notes"
  ],
  "properties": {
    "work_id": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical work identifier."
    },
    "last_audit_block": {
      "type": "string",
      "description": "Block identifier of the last audited block."
    },
    "audit_pass": {
      "type": "boolean",
      "description": "True if the audit passed."
    },
    "audit_date": {
      "type": "string",
      "description": "ISO 8601 date of the audit (e.g. 2026-03-24)."
    },
    "issues": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of issues found during audit."
    },
    "notes": {
      "type": "string",
      "description": "Free-text audit notes."
    }
  },
  "additionalProperties": false
}
